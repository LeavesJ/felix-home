#!/usr/bin/env bash
# Carries the toolbox Felix routes to into a Claude Code cloud session.
#
# A cloud session reads this repository's .claude/settings.json, .claude/skills,
# .claude/agents and .claude/commands, and nothing from ~/.claude; plugins do
# not load there at all (code.claude.com/docs/en/cloud-environments, "What
# carries over from your setup"). Locally the same skills arrive as plugins. So
# in the cloud this fetches each plugin toolbox.json pins, at the commit
# toolbox.json pins (moved by hand, so it may lag the local install; toolbox.json
# says how to check), and copies its skills, agents and commands into the
# clone's .claude/, each path listed in .git/info/exclude so none of it can be
# committed by the session.
#
#   provision                  do it quietly; the log is $cache/provision.log
#   provision --session-start  do it, then print superpowers' session context as
#                              this hook's output, from the plugin's own hook
#                              run out of the fetched copy; when anything did
#                              not arrive, one JSON object that says so to the
#                              person (systemMessage) and the session (a MISSING
#                              line each in the context), with the context
#   provision --report         print one line per toolbox entry saying what this
#                              machine has of it, and one for main, and exit
#                              non-zero if a fetch row or main is missing
#
# Each mode that fetches also fetches main, because the gate reads a branch
# against it and a cloud clone does not hold it (see fetch_main).
#
# Does nothing outside a cloud session (CLAUDE_CODE_REMOTE=true), because this
# repository's settings are read locally too, where the plugins already load.
# FELIX_CLOUD_FORCE=1 runs it anyway, for testing on a scratch copy.
#
# Every mode but --report exits 0: a failed fetch must not stop a session from
# starting. What failed is in the log, and at --session-start it is also said
# (audit b07): before, a refused or blackholed codeload left the session with no
# skills, a router that still named them, and nothing to say why.
#
# One time budget covers the whole run: FELIX_CLOUD_BUDGET seconds (a whole
# number; anything else reads as 90), under the 120 s settings.json gives this
# hook. Every curl and git fetch gets what is left of it and is ended at the
# deadline; an entry the run never reached is reported as not tried. A source
# that failed is not fetched again for another entry that pins it.

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo="$(cd "$here/../.." && pwd)"
mode="${1:-}"

[ "${CLAUDE_CODE_REMOTE:-}" = true ] || [ "${FELIX_CLOUD_FORCE:-}" = 1 ] || exit 0

SECONDS=0
BUDGET=90
case "${FELIX_CLOUD_BUDGET-}" in
  ''|*[!0123456789]*) ;;
  *) [ "${#FELIX_CLOUD_BUDGET}" -le 6 ] && BUDGET=$((10#$FELIX_CLOUD_BUDGET)) ;;
esac
left() { printf '%s' "$((BUDGET - SECONDS))"; }

cache="${FELIX_CLOUD_CACHE:-$HOME/.cache/felix-cloud}"
log="$cache/provision.log"
CACHE_BAD=""
NT_WHY="the time budget of $BUDGET s was spent"
if ! mkdir -p "$cache/src" 2>/dev/null; then CACHE_BAD="cannot create $cache"; NT_WHY="$CACHE_BAD"; log=/dev/null; fi

FAILED=" "      # src@sha that failed in this run, each between blanks
NOTTRIED=" "    # toolbox entries this run never reached, each between blanks
BASE_WHY=""     # why origin/main is not there, when this run knows

say() { printf '%s %s\n' "$(date -u +%H:%M:%SZ)" "$*" >> "$log" 2>/dev/null; }
src_dir() { printf '%s/src/%s-%s' "$cache" "${1//\//_}" "$2"; }

# SECS COMMAND...: COMMAND for at most SECS seconds, then it is ended by pid.
# The status is the command's own, or 124 when it was ended here.
bounded() {
  local secs="$1" pid ticks=0
  shift
  "$@" & pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    if [ "$ticks" -ge "$((secs * 5))" ]; then
      kill "$pid" 2>/dev/null; sleep 0.2 2>/dev/null || sleep 1
      kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
      wait "$pid" 2>/dev/null; return 124
    fi
    sleep 0.2 2>/dev/null || sleep 1
    ticks=$((ticks + 1))
  done
  wait "$pid"
}

# One tab-separated line per toolbox entry, absent fields as "-". jq is in the
# cloud image (docs/en/cloud-environments, "Installed tools"). Without it, or
# with a toolbox.json it cannot parse, nothing is fetched and the report says
# toolbox.json is MISSING.
read_rows() {
  command -v jq >/dev/null 2>&1 || { say "jq is not installed, so $here/toolbox.json cannot be read"; return 1; }
  jq -r '.tools[] | [.name, .carry, (.source // "-"), (.sha // "-"), (.subdir // "-"), (.note // "-")] | @tsv' \
    "$here/toolbox.json" 2>>"$log" || { say "could not read $here/toolbox.json"; return 1; }
}
ROWS=""; ROWS_BAD=""
ROWS="$(read_rows)" || { ROWS=""; ROWS_BAD="cannot be read: jq is missing or the file is not valid toolbox JSON"; }

# One pinned source, downloaded once per machine. The tarball's top directory
# is <repo>-<sha>; it is unpacked into a scratch directory and moved into place
# whole, so a download cut off halfway never looks like a finished one.
# 0 carried, 1 failed (now or earlier in this run), 2 not tried.
fetch() {
  local src="$1" sha="$2" dest tmp t rc
  dest="$(src_dir "$src" "$sha")"
  [ -d "$dest" ] && return 0
  case "$FAILED" in *" $src@$sha "*) return 1 ;; esac
  t="$(left)"
  if [ -n "$CACHE_BAD" ] || [ "$t" -le 0 ]; then say "not tried: $src@$sha"; return 2; fi
  tmp="$(mktemp -d "$cache/tmp.XXXXXX")" || { FAILED="$FAILED$src@$sha "; say "FAILED to fetch $src@$sha: no scratch directory"; return 1; }
  bounded "$t" curl -sSfL -m "$t" -o "$tmp/src.tgz" "https://codeload.github.com/$src/tar.gz/$sha" 2>>"$log"; rc=$?
  if [ "$rc" -eq 0 ] && tar xzf "$tmp/src.tgz" -C "$tmp" 2>>"$log" && mv "$tmp"/*/ "$dest" 2>>"$log"; then
    rm -rf "$tmp"; say "fetched $src@$sha"; return 0
  fi
  rm -rf "$tmp"; FAILED="$FAILED$src@$sha "
  say "FAILED to fetch $src@$sha$([ "$rc" -eq 124 ] && printf ' (ended at the time budget)')"; return 1
}

# The gate reads a branch against main. secret-scan scans what the branch adds
# on top of it, and with no main it scans uncommitted changes only, so every
# committed credential passes: on 2026-09-29 the secret check read ok over a
# tree nobody had scanned, and eleven of its qualification controls held for
# that reason alone. A cloud clone is shallow and holds only its own branch,
# so main is fetched here, and the history is deepened when the two do not
# meet, because `git diff origin/main...HEAD` needs their merge base. The
# refspec is written out: a single-branch clone's configured one covers only
# its own branch, so a bare `git fetch origin main` fills FETCH_HEAD, exits 0
# and leaves origin/main absent.
fetch_main() {
  local t rc
  if ! git -C "$repo" rev-parse --verify -q origin/main >/dev/null; then
    t="$(left)"
    if [ -n "$CACHE_BAD" ] || [ "$t" -le 0 ]; then
      BASE_WHY="not tried, $NT_WHY"; say "not tried: origin/main"; return 1
    fi
    bounded "$t" git -C "$repo" fetch -q origin +refs/heads/main:refs/remotes/origin/main 2>>"$log"; rc=$?
    if [ "$rc" -ne 0 ] || ! git -C "$repo" rev-parse --verify -q origin/main >/dev/null; then
      BASE_WHY="the fetch $([ "$rc" -eq 124 ] && printf 'was ended at the time budget' || printf 'failed')"
      say "FAILED to fetch origin/main"; return 1
    fi
    say "fetched origin/main"
  fi
  git -C "$repo" merge-base origin/main HEAD >/dev/null 2>&1 && return 0
  t="$(left)"
  if [ "$t" -le 0 ]; then BASE_WHY="not tried, $NT_WHY"; say "not tried: unshallow"; return 1; fi
  bounded "$t" git -C "$repo" fetch -q --unshallow origin 2>>"$log"; rc=$?
  if [ "$rc" -ne 0 ] || ! git -C "$repo" merge-base origin/main HEAD >/dev/null 2>&1; then
    BASE_WHY="the history could not be deepened until they meet"
    say "FAILED to find where origin/main and HEAD meet"; return 1
  fi
  say "unshallowed, so origin/main and HEAD meet"
}

exclude_file() { git -C "$repo" rev-parse --git-path info/exclude 2>/dev/null; }

# Copy one plugin's skills, agents and commands into the clone. A path git
# tracks is never overwritten: a committed skill of the same name is the
# repository's own decision, and the collision is logged instead.
materialize() {
  local name="$1" root="$2" kind item base rel ex
  ex="$(exclude_file)"; [ -n "$ex" ] || return 1
  case "$ex" in /*) ;; *) ex="$repo/$ex" ;; esac
  mkdir -p "$(dirname "$ex")" && touch "$ex"
  for kind in skills agents commands; do
    [ -d "$root/$kind" ] || continue
    for item in "$root/$kind"/*; do
      [ -e "$item" ] || continue
      base="${item##*/}"; rel=".claude/$kind/$base"
      if git -C "$repo" ls-files --error-unmatch -- "$rel" >/dev/null 2>&1; then
        say "kept the tracked $rel over $name's"; continue
      fi
      grep -qxF "/$rel" "$ex" || printf '/%s\n' "$rel" >> "$ex"
      mkdir -p "$repo/.claude/$kind"
      rm -rf "$repo/$rel" && cp -R "$item" "$repo/$rel"
    done
  done
  say "materialized $name"
}

provision() {
  local name carry src sha sub note root rc
  while IFS=$'\t' read -r name carry src sha sub note; do
    [ "$carry" = fetch ] || continue
    fetch "$src" "$sha"; rc=$?
    [ "$rc" -ne 2 ] || NOTTRIED="$NOTTRIED$name "
    [ "$rc" -eq 0 ] || continue
    root="$(src_dir "$src" "$sha")/$sub"; root="${root%/.}"
    [ -d "$root" ] || { say "no $sub in $src@$sha"; continue; }
    materialize "$name" "$root"
  done <<EOF
$ROWS
EOF
}

report() {
  local name carry src sha sub note bad=0 why
  if [ -n "$ROWS_BAD" ]; then
    printf 'MISSING   %-22s %s (see %s)\n' toolbox.json "$ROWS_BAD" "$log"; bad=1
  fi
  while IFS=$'\t' read -r name carry src sha sub note; do
    [ -n "$name" ] || continue
    if [ "$carry" = fetch ]; then
      if [ -d "$(src_dir "$src" "$sha")" ]; then
        printf 'carried   %-22s %s@%.12s\n' "$name" "$src" "$sha"
      else
        why=""
        case "$NOTTRIED" in
          *" $name "*) why="not tried, $NT_WHY; " ;;
          *) case "$FAILED" in *" $src@$sha "*) why="the fetch failed; " ;; esac ;;
        esac
        printf 'MISSING   %-22s %s@%.12s (%ssee %s)\n' "$name" "$src" "$sha" "$why" "$log"; bad=1
      fi
    else
      printf '%-9s %-22s %s\n' "$carry" "$name" "$note"
    fi
  done <<EOF
$ROWS
EOF
  if git -C "$repo" merge-base origin/main HEAD >/dev/null 2>&1; then
    printf 'base      %-22s %.12s\n' origin/main "$(git -C "$repo" rev-parse origin/main)"
  else
    printf 'MISSING   %-22s %sno merge base with HEAD, so secret-scan reads no base (see %s)\n' \
      origin/main "${BASE_WHY:+($BASE_WHY) }" "$log"; bad=1
  fi
  return "$bad"
}

jesc() {
  local s="$1"
  s="${s//\\/\\\\}"; s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"; s="${s//$'\r'/\\r}"; s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

# The one object a session start prints when something did not arrive.
emit() {   # systemMessage, additionalContext
  command -v jq >/dev/null 2>&1 && jq -cn --arg m "$1" --arg c "$2" \
    '{systemMessage: $m, hookSpecificOutput: {hookEventName: "SessionStart", additionalContext: $c}}' 2>/dev/null && return 0
  printf '{"systemMessage":"%s","hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' \
    "$(jesc "$1")" "$(jesc "$2")"
}

case "$mode" in
  --report) report; exit $? ;;
  --session-start)
    input="$(cat)"
    fetch_main
    provision
    # The plugin's own hook binds startup, clear and compact, not resume;
    # match that, or a resumed session is handed the preamble twice.
    resume=""
    case "$input" in *'"source":"resume"'*|*'"source": "resume"'*) resume=1 ;; esac
    hook=""
    if [ -z "$resume" ]; then
      sp="$(printf '%s\n' "$ROWS" | awk -F'\t' '$1 == "superpowers" && $2 == "fetch" { print $3 "\t" $4; exit }')"
      [ -z "$sp" ] || hook="$(src_dir "${sp%%$'\t'*}" "${sp##*$'\t'}")/hooks/session-start"
      [ -f "$hook" ] || hook=""
    fi
    missing="$(report 2>/dev/null | grep '^MISSING')"
    if [ -z "$missing" ]; then
      [ -z "$hook" ] || CLAUDE_PLUGIN_ROOT="${hook%/hooks/session-start}" CURSOR_PLUGIN_ROOT='' COPILOT_CLI='' \
        bash "$hook" 2>>"$log" || true
      exit 0
    fi
    # Something did not arrive. Say what, to the person and to the session, and
    # keep the plugin's own context in the same object.
    list=""; ctx=""
    while read -r _m name _rest; do list="$list${list:+, }$name"; done <<EOF
$missing
EOF
    if [ -n "$hook" ]; then
      sp_out="$(CLAUDE_PLUGIN_ROOT="${hook%/hooks/session-start}" CURSOR_PLUGIN_ROOT='' COPILOT_CLI='' bash "$hook" 2>>"$log")" || true
      ctx="$(printf '%s' "$sp_out" | jq -r '.hookSpecificOutput.additionalContext // empty' 2>/dev/null)"
      [ -n "$ctx" ] || ctx="$sp_out"
    fi
    ctx="${ctx:+$ctx

}Felix's cloud toolbox is incomplete: these did not arrive, so a route that names a skill or agent from them cannot be followed here (felix route --ack declines one on the record).
$missing
Log: $log"
    emit "Felix's cloud toolbox is incomplete: $list did not arrive. Log: $log" "$ctx"
    exit 0 ;;
  *) fetch_main; provision; exit 0 ;;
esac

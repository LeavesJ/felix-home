#!/usr/bin/env bash
# Is the engine this tree ships the one deployed on this machine?
#
#   deploy-check            the evidence contract
#   deploy-check --applies  the applicability test
#
#   exit 0  the deployed engine is byte-identical to this tree's — harness,
#           hooks and commands, ignoring what git ignores
#   exit 1  it is not; every path that differs is on stdout, one per line,
#           which is the coverage report: what was examined and its verdict
#   exit 2  cannot examine: no deployed engine could be found. Never read
#           as matching.
#
#   --applies exits 0 when this obligation applies to this tree — a felix
#   deployment exists on this machine and this tree is the one the marketplace
#   serves — and 1 otherwise. A CI runner has no plugin cache; a worktree is
#   never what a directory marketplace serves. Both are DORMANT, reported and
#   never waived, rather than a failure nobody standing there could fix.
#
# This is the second admitted obligation's contract, and the detector is not
# new: the project gate's `installed` check has compared the tree against the
# deployed cache since #55, and `felix install` since before that. What the
# ledger adds is that the requirement is admitted — written is not installed,
# and an engine change that is not deployed governs nothing — so it cannot
# quietly leave the gate the way a check can. TASK_BLOCKING and not
# RELEASE_BLOCKING, deliberately: at the merge boundary the tree being judged
# is a branch main has not yet taken, so it never matches the deployment and
# never could; the thing owed is that the SESSION does not end with the two
# apart, and that is the task moment.
#
# The live engine is asked of the CLI, as felix_deployed_engine asks, and
# falls back to the highest cached version the way the project gate does —
# the cache keeps every version it ever installed and the newest on disk is
# not necessarily the one that loads, so the CLI is asked first.
set -u
cd "$(git rev-parse --show-toplevel 2>/dev/null || pwd)" || exit 2
HERE="$(cd "$(dirname "$0")/.." && pwd)"
SRC="$(cd "$HERE/.." && pwd)"

# shellcheck source=../lib/resolve.sh
. "$HERE/lib/resolve.sh"

if [ "${1:-}" = "--applies" ]; then
  [ -d "$HOME/.claude/plugins/cache/felix/felix" ] || exit 1
  felix_deployable_from "$SRC" >/dev/null 2>&1 || exit 1
  exit 0
fi

live="$(felix_deployed_engine 2>/dev/null)" || live=""
[ -n "$live" ] || live="$(ls -d "$HOME"/.claude/plugins/cache/felix/felix/* 2>/dev/null | sort -V | tail -1)"
if [ -z "$live" ] || [ ! -d "$live/harness" ]; then
  printf 'deploy-check: cannot examine: no deployed engine found on this machine\n'
  exit 2
fi

out="$(felix_deploy_diff "$SRC" "$live" 2>/dev/null)"; rc=$?
if [ "$rc" -eq 0 ]; then
  printf '  matches       %s\n' "$live"
  exit 0
fi
printf '%s\n' "$out" | grep . | sed 's/^/  /'
printf 'deploy-check: %s path(s) differ between this tree and %s\n' \
  "$(printf '%s\n' "$out" | grep -c .)" "$live"
exit 1

#!/usr/bin/env bash
# Does the shipped hooks.json bind every lifecycle moment the stance table
# says is wired, and say nothing about no moment it binds?
#
#   lifecycle-check <templates-dir> <hooks.json>
#
#   exit 0  every moment's stance and wiring agree
#   exit 1  a moment is declared wired and nothing wires it, or wired and
#           unexplained, or declined on a premise hooks.json no longer holds
#   exit 2  cannot examine: no stance table, no hooks file, or a table that
#           declares no moment. Never read as clean.
#
# This is the evidence contract of the first admitted obligation, and its
# output is the coverage report the amendments' seventh control asks for: one
# line per moment, the verdict beside it. The judgement is coverage.sh's; this
# only refuses to answer when there is nothing to examine, which
# felix_coverage_check itself treats as "no output" — and no output would
# discharge the obligation by saying nothing.
set -u

# The caller's environment must not change what a tool prints. Why, and why
# these names: the comment above the same line in engine/harness/felix.
unset GREP_OPTIONS CLICOLOR_FORCE GH_FORCE_TTY TAPE TAR_OPTIONS QUOTING_STYLE POSIXLY_CORRECT CDPATH

# Git's colour stays off for every git this runs, whatever colour settings the
# caller made. Why, why these keys, and what is out of reach: the comment above
# the same lines in engine/harness/felix.
_felix_git_pin="'color.ui=never' 'color.advice=never' 'color.branch=never' 'color.diff=never' 'color.grep=never' 'color.interactive=never' 'color.push=never' 'color.remote=never' 'color.showBranch=never' 'color.status=never' 'color.transport=never' 'color.pager=false' 'blame.coloring=none'"
case " ${GIT_CONFIG_PARAMETERS-}" in
  *" $_felix_git_pin") ;;
  *) export GIT_CONFIG_PARAMETERS="${GIT_CONFIG_PARAMETERS:+$GIT_CONFIG_PARAMETERS }$_felix_git_pin" ;;
esac

# Found before moving: $0 may be relative to where this was called from.
HERE="$(cd "$(dirname "$0")/.." && pwd)" || exit 2
cd "$(git rev-parse --show-toplevel 2>/dev/null || pwd)" || exit 2
TPL="${1:-}"; HOOKS="${2:-}"
[ -n "$TPL" ] && [ -n "$HOOKS" ] || { printf 'usage: lifecycle-check <templates-dir> <hooks.json>\n' >&2; exit 2; }
[ -s "$TPL/lifecycle.tsv" ] || { printf 'lifecycle-check: cannot examine: no stance table at %s/lifecycle.tsv\n' "$TPL"; exit 2; }
[ -s "$HOOKS" ] || { printf 'lifecycle-check: cannot examine: no hooks at %s\n' "$HOOKS"; exit 2; }

# shellcheck source=../lib/coverage.sh
. "$HERE/lib/coverage.sh"
out="$(felix_coverage_check "$TPL" "$HOOKS")"
[ -n "$out" ] || { printf 'lifecycle-check: cannot examine: %s/lifecycle.tsv takes no stance on any moment\n' "$TPL"; exit 2; }

printf '%s\n' "$out" | awk -F'\t' '{ printf "  %-13s %-20s %s\n", $1, $2, $3 }'
# One awk over the report, deciding at its end. A pipe into grep -q can stop
# before its writer finishes, and under pipefail, which this script does not
# set, that would read a disagreement as none.
if awk -F'\t' '$1 != "ok" && $0 != "" { b = 1 } END { exit !b }' <<<"$out"; then
  printf 'lifecycle-check: %s moment(s) where stance and wiring disagree\n' \
    "$(printf '%s\n' "$out" | awk -F'\t' '$1 != "ok"' | grep -c .)"
  exit 1
fi
exit 0

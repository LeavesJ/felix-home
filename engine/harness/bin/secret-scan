#!/usr/bin/env bash
# Scan added lines for credentials.
#
#   secret-scan [base-ref]     scan what this branch adds on top of base
#   ... | secret-scan -        scan stdin
#
# Exits 0 when clean, 1 on a hit, and prints what it found with file and line.
# Exits 2 when it could not read what it was asked to scan (2026-10-08). A scan
# that read nothing is neither clean nor a finding, and 0 was what it said.
#
# Added lines only. A removed secret is not a new exposure, and reporting it as
# one teaches people that the finding does not mean anything.
#
# The patterns and, more importantly, the exclusions come from a scanner that had
# already been tuned against real false positives: a type annotation reading
# `token: str = ""`, a call to `secrets.token_urlsafe`, a value read from the
# environment, a placeholder in angle brackets. A secret scanner that cries wolf
# is turned off within a week, so the exclusions are the load-bearing half.

set -uo pipefail

# Split by what an exclusion actually claims, because applying every one of them
# to the whole line turned the scanner off with a single word. A live AWS key on
# a line that also said "example" exited 0; so did a private key header wrapped
# in <pre>, because the angle-bracket placeholder rule matched the markup.
#
#   CONTEXT says the LINE is not a literal at all — a lookup, a generator, a
#   fixture the suite deliberately plants. Read whole-line, because that is the
#   claim: nothing on this line is a secret.
#
#   VALUE says the VALUE is fake. Read against the matched credential only. A
#   placeholder is a property of the string, not of the sentence around it, and
#   "there is a placeholder somewhere on this line" is not evidence about the
#   twenty characters that look exactly like a key.
# Not named SECRET, and not CREDENTIAL either. Both drafts made the scanner flag
# its own source, correctly both times: `SECRET_PATTERNS='<long quoted string>'`
# and `SCAN_CREDENTIAL='...'` are each exactly the `<keyword> = "..."` shape it
# exists to catch, and `credential` is on its own keyword list. The previous
# version passed the regex inline to grep, so there was no assignment to match.
# Any name here must avoid api_key, secret, password, passwd, token, credential.
# Two shapes were added after a qualification run showed the scanner passing
# over trees that genuinely violate what it protects (felix qualify).
#
# The keyword rule required a QUOTED value, so `TOKEN: value` in YAML — which is
# how a GitHub Actions workflow writes one, unquoted — went straight through. An
# unquoted alternative is allowed now, longer than the quoted one (12 rather
# than 8) because it has no delimiter to prove where it ends, and with `_`
# excluded from the value: `token_description: something_long_here` is an
# ordinary identifier and `fakenpm7QvZ2mKxT9bLd4Rz` is not, and the underscore
# is what separates them. A value beginning with `$` cannot match at all, which
# is what keeps `TOKEN=$MY_VAR` and Actions' `${{ secrets.X }}` out.
#
# The PEM rule requires the dashes. A private key in PEM form always carries
# them — five dashes on each side of the BEGIN line is the format, not a
# decoration — so requiring them loses nothing real. Not written out here in
# full, because this file's own header already records what happens when the
# scanner's source carries the shape it scans for. Without them the rule matched the bare
# phrase, and the bare phrase is how documentation names the thing: a table row
# saying the scanner catches it was itself caught, in two runbooks at once.
# Qualified both ways in qualification.tsv, so the tightening is proven rather
# than trusted: a real header must still fail, and prose naming it must pass.
#
# Two more, found by planting leaks in the public snapshot (2026-09-22). An AWS
# key id was known only by its long-term prefix, AKIA, so a temporary one, ASIA,
# went through; the STS output that carries one is also JSON, where the keyword
# is a quoted key, and a closing quote between it and the colon hid the secret
# and the session token beside it. Both prefixes are read now, and a keyword may
# be followed by its own closing quote: the key ends with the keyword, or with
# what completes a credential's name after it (key, access key, a plural), as in
# SessionToken, client_secret and SecretAccessKey. A key the keyword only begins
# (token_type, tokenizer, secret_name, password_policy) names something about a
# credential, and JSON quotes every value, so reading those too flagged ordinary
# configuration the scanner had always passed. After that quote a quoted value
# may hold no space, since a JSON value is as often prose and a key is one
# unbroken string, and may not begin with `$`, as an unquoted one never could:
# without that, two lines of the suite that hand a JSON env block
# `"${DD_API_KEY:-}"` and `"${INLINE_TOKEN}"`, references and not values, were
# flagged, and the snapshot would have stopped on both as lines the public main
# does not carry. The form without the quote is exactly as it was, and a key
# the keyword ends, holding one quoted word of eight letters or more, is flagged
# in JSON as it always was in YAML. Qualified both ways: a real temporary key
# and a pasted STS response fail, prose naming the prefixes, a JSON reference
# and keys the keyword only begins pass.
#
# And a credential inside a URI had no rule of any kind. A password in
# `scheme://user:pass@host` carries no keyword, no assignment and no quotes —
# nothing the rules above look for — so a live connection string in a tracked
# file read as clean. The password must be 12+ characters, which keeps
# `https://user:password@host` in prose out of it.
#
# GitHub's other token prefixes, measured 2026-09-23. The scanner knew ghp_ and
# github_pat_, the two a person makes by hand, and not the four GitHub issues
# to programs: ghs_ (an installation token, which is what an Actions run's
# GITHUB_TOKEN is), gho_ (OAuth), ghu_ (user-to-server) and ghr_ (a refresh
# token). A workflow that writes one as `token: <the token>` went through: the
# keyword rule's unquoted value class excludes `_`, so the value it read was
# the three letters before the underscore, too short to count. The four are
# read now as ghp_ is, in both lists, since none is a word prose uses.
#
# And the form actions/checkout leaves behind. It persists its token in
# .git/config as an HTTP header, `AUTHORIZATION: basic <base64>`, where the
# base64 encodes `x-access-token:<token>`. `x-access-token:` is fifteen bytes,
# so its encoding is the fixed prefix eC1hY2Nlc3MtdG9rZW46 and the token's own
# base64 follows it with no boundary between. Read as a hard shape, since
# nothing else begins that way; prose naming the prefix, as this comment does,
# has no twenty characters of base64 after it and passes. Qualified both ways
# by rows written blind: a workflow value, a shell assignment and a copied
# config fail, and prose naming the prefixes passes.
FELIX_SCAN_PATTERNS='sk-ant-[A-Za-z0-9_-]{16,}|sk-[A-Za-z0-9]{20,}|sk_live_[A-Za-z0-9]{8,}|gh[opsur]_[A-Za-z0-9]{20,}|eC1hY2Nlc3MtdG9rZW46[A-Za-z0-9+/=]{20,}|github_pat_[A-Za-z0-9_]{20,}|(AKIA|ASIA)[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|[Bb]earer [A-Za-z0-9._-]{20,}|[a-zA-Z][a-zA-Z0-9+.-]*://[^[:space:]/:@"'"'"']+:[^[:space:]/:@"'"'"']{12,}@|(api[_-]?key|secret|password|passwd|token|credential)([a-z_]*[[:space:]]*[=:][[:space:]]*(["'"'"'][^"'"'"']{8,}["'"'"']|[A-Za-z0-9/+.=-]{12,})|(_?access_?key|_?key|s)?["'"'"'][[:space:]]*[=:][[:space:]]*(["'"'"'][^"'"'"'$[:space:]][^"'"'"'[:space:]]{7,}["'"'"']|[A-Za-z0-9/+.=-]{12,}))'
# `ANTHROPIC_API_KEY` was in this list and is the reason it is worth reading
# twice. Every other entry is an EXPRESSION that produces a value at run time —
# a lookup, a generator. A variable NAME is not. It says what the value is for,
# never that the line has no value on it, and it was suppressing the whole line
# it appeared on. Measured on the shipped scanner, same key both times:
#
#   ANTHROPIC_API_KEY = "sk-ant-api03-Zq7R...Qw"   exit 0, clean
#   CLAUDE_KEY        = "sk-ant-api03-Zq7R...Qw"   exit 1, flagged
#
# Which is to say: the one credential a Claude Code harness plausibly touches,
# written the one way everybody writes it, was the one shape this scanner could
# not see. It is gone from the list.
FELIX_SCAN_CONTEXT='os\.environ|getenv|environ\[|process\.env|secrets\.[a-z_]+\(|token_urlsafe|token_hex|uuid4|must_flag|must_pass'

# Shapes that are unambiguous on their own. A prefix like `sk-ant-` or `AKIA`
# is not a word that occurs in prose; if one is on the line, the line HAS a
# literal, whatever else it also says.
#
# This is what bounds CONTEXT. That exclusion claims "nothing on this line is a
# literal at all", and the claim is simply false when one of these is sitting
# there — which is the common real leak, a live key as the fallback default of
# a lookup: `os.environ.get("K", "sk-ant-...")`. The lookup used to delete the
# line and the key with it.
FELIX_SCAN_HARD='sk-ant-[A-Za-z0-9_-]{16,}|sk_live_[A-Za-z0-9]{8,}|gh[opsur]_[A-Za-z0-9]{20,}|eC1hY2Nlc3MtdG9rZW46[A-Za-z0-9+/=]{20,}|github_pat_[A-Za-z0-9_]{20,}|(AKIA|ASIA)[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----'
FELIX_SCAN_VALUE='<[^>]*>|example|placeholder|redacted|xxx+|\.\.\.'

# Files whose whole purpose is to carry a credential's SHAPE without its value.
#
# This is provenance, not shape, and it is the only exclusion here that reads a
# path rather than a line. It exists because the two are genuinely different
# facts: a connection string in a library is a leak, and the identical string in
# a file named `.example` is documentation of the environment. No rule over the
# line itself can tell them apart — they are the same characters — which is
# exactly the case a qualification suite calls decoupled satisfaction, and a
# scanner that cannot pass it is one that has learned to reject everything.
#
# Deliberately narrow. `.example` and `.sample` are conventions a reader already
# knows, and a fixtures directory is one a repository declares by naming it. A
# real key in one of these is invisible to this scanner, and that is the cost.
FELIX_SCAN_FIXTURE='(^|/)[^/]*\.(example|sample)$|(^|/)(fixtures?|testdata)/'

# Added lines, with the file they were added to still attached long enough to
# be judged.
#
# The diff carries the path in its `+++ b/...` header and the previous version
# discarded it one line before the scan, so every finding was a line with no
# file — unlocatable in the report, and unjudgeable against provenance. The
# path is read here and used for exactly one decision: whether this file is one
# whose purpose is to hold a credential's shape.
_added() {
  LC_ALL=C awk -v skip="$FELIX_SCAN_FIXTURE" '
    /^\+\+\+ / { p = substr($0, 7); next }
    /^\+/       { if (p != "" && skip != "" && p ~ skip) next; print }
  '
}

# A key id is capitals and digits. The scan reads without case, for the
# keywords' sake, and under it the key id's shape also took "Asia" and sixteen
# letters of one CamelCase word (AsiaPacificEconomicCoop), which the scanner
# passed before ASIA was added. A match of a key id's prefix and length that is
# not in capitals is dropped here, before it is judged or bounds CONTEXT.
_cased() {
  LC_ALL=C awk '!(length($0) == 20 && $0 ~ /^[Aa][KkSs][Ii][Aa][A-Za-z0-9]+$/ && $0 !~ /^(AKIA|ASIA)[0-9A-Z]+$/)'
}

_hits() {
  grep -inE "$FELIX_SCAN_PATTERNS" \
  | while IFS= read -r line; do
      # CONTEXT, bounded. It still deletes the line, because that is what it
      # claims — but not over the top of a shape that cannot be anything else.
      # Both tests here read a here-string, not a pipe into grep -q, whose early
      # exit can kill the writer under pipefail; neither value is ever empty.
      # On bash 3.2 a here-string is a 0600 temp file in /var/tmp, whatever
      # TMPDIR says, unlinked once open. Where none can be made both tests
      # fail and the line is reported, so the scan says too much, not too little.
      if grep -qiE "$FELIX_SCAN_CONTEXT" <<<"$line" \
         && [ -z "$(printf '%s' "$line" | grep -oiE "$FELIX_SCAN_HARD" | _cased)" ]; then
        continue
      fi
      # The matched credential, not the line it sits on. Every value exclusion
      # is tested against this and nothing else.
      m="$(printf '%s' "$line" | grep -oiE "$FELIX_SCAN_PATTERNS" | _cased | head -1)"
      [ -n "$m" ] || continue
      grep -qiE "$FELIX_SCAN_VALUE" <<<"$m" && continue
      printf '%s\n' "$line"
    done
  true
}

# Said once, to stderr, and the scan ends with 2 (2026-10-08). git does not block
# on a named pipe at a tracked path. `git diff HEAD` prints every path before it
# and exits 128, so with a pipe at A.txt a key added to src.txt was never in the
# input, and the scan exited 0 over it. A mode-000 file and a corrupt index did
# the same. Any read that did not finish ends here, never in a clean answer.
_unread() {
  printf 'secret-scan: %s; nothing was scanned to the end, so nothing here can be called clean\n' "$1" >&2
  exit 2
}

# A git command's output, set only as far as git got, and 0 only when it ran to
# the end and exited 0. The mark is a line of its own holding a control
# character, which no line git prints in a diff or a listing can be. The engine's
# _felix_git_read in lib/resolve.sh reads the same way and also drops trailing
# newlines, which a diff fed to _added does not need dropped; this script
# sources no library.
_read() {   # VAR command...
  local _o _rc=1
  _o="$("${@:2}" 2>/dev/null && printf '\n\037ok')"
  case "$_o" in *$'\n\037ok') _rc=0; _o="${_o%$'\n\037ok'}" ;; esac
  printf -v "$1" '%s' "$_o"
  return "$_rc"
}

# git's own first complaint about a read, for the line _unread prints.
_why() { "$@" 2>&1 >/dev/null | awk '!p && /^(error|fatal): / { print; p = 1 }'; }

# The patch the change's content makes, whatever anyone configured about how
# git shows one (2026-10-08). With a driver's external diff, a textconv, colour,
# or a `-diff` line in a .gitattributes the branch itself committed, this scan
# exited 0 over an added key. A path prefix from diff.dstPrefix made every file
# read as a fixture's. Why each pin, what was measured, and what is not covered:
# above _felix_git_patch in engine/harness/lib/resolve.sh, which this copies.
# The copy differs in two ways. It runs where it stands, since this script has
# already gone to the top of the work tree. And it reads with --no-renames: the
# fixture exclusion is a property of the path, so a key the branch moves out of
# fixtures/ is a new key where it lands, and rename detection showed no line of
# it.
_diff() { git diff --no-ext-diff --no-textconv --no-color --src-prefix=a/ --dst-prefix=b/ --ignore-submodules=none --no-renames "$@"; }
_patch() {   # VAR diff-args...: _read's contract, for a patch
  local _v="$1" _all _rec _meta="" _ok="" _rc=0 _n _st _more _t=$'\t'
  local _bin=() _text=()
  shift
  _read _all _diff "$@" || _rc=1
  # The paths git printed as binary, read to NUL: a path may hold any other byte.
  while IFS= read -r -d '' _rec; do
    case "$_rec" in
      -"$_t"-"$_t"*) _bin+=("${_rec#-"$_t"-"$_t"}") ;;
      $'\037'ok) _ok=1 ;;
    esac
  done < <(git diff --no-ext-diff --no-textconv --ignore-submodules=none --no-renames --numstat -z "$@" 2>/dev/null && printf '\037ok\0')
  [ -n "$_ok" ] || _rc=1
  if [ "${#_bin[@]}" -gt 0 ]; then
    # Each one's sides: `:oldmode newmode oldsha newsha status`, then the path.
    # Read again as text only when every side present is text by git's own rule.
    _ok=""
    while IFS= read -r -d '' _rec; do
      if [ -n "$_meta" ]; then
        _st="${_meta##* }"
        case "$_st" in
          D*|U*) ;;
          *) _n="${_meta#:* * }"
             { [ "${_st#A}" != "$_st" ] || _side_text "${_n%% *}" "$_rec"; } \
               && _n="${_n#* }" && _side_text "${_n%% *}" "$_rec" \
               && _text+=("$_rec") ;;
        esac
        _meta=""
        continue
      fi
      case "$_rec" in
        :*) _meta="$_rec" ;;
        $'\037'ok) _ok=1 ;;
      esac
    done < <(git --literal-pathspecs diff --no-ext-diff --no-textconv --ignore-submodules=none --no-renames --no-abbrev --raw -z "$@" -- "${_bin[@]}" 2>/dev/null && printf '\037ok\0')
    [ -n "$_ok" ] || _rc=1
  fi
  if [ "${#_text[@]}" -gt 0 ]; then
    _read _more git --literal-pathspecs diff --no-ext-diff --no-textconv --no-color --src-prefix=a/ --dst-prefix=b/ --ignore-submodules=none --no-renames --text "$@" -- "${_text[@]}" || _rc=1
    _n="$(printf '%s\n' "$_more" | LC_ALL=C awk '/^diff --git / && !s[$0]++ { n++ } END { print n + 0 }')"
    [ "$_n" = "${#_text[@]}" ] || _rc=1
    _all="$_all
$_more"
  fi
  printf -v "$_v" '%s' "$_all"
  return "$_rc"
}
# One side, text by git's rule when no attribute speaks: at most 512 MiB and no
# NUL in its first 8000 bytes. A zero sha is the file in the tree, read through
# a redirect so a name that begins with `-` is never taken for an option.
_side_text() {   # SHA PATH
  local s n
  if [ -z "${1//0/}" ]; then
    { [ -L "./$2" ] || [ ! -f "./$2" ]; } && return 0
    s="$(wc -c < "./$2" 2>/dev/null)"
    n="$(head -c 8000 < "./$2" 2>/dev/null | LC_ALL=C tr -cd '\000' | wc -c)"
  else
    s="$(git cat-file -s "$1" 2>/dev/null)"
    n="$(git cat-file blob "$1" 2>/dev/null | head -c 8000 | LC_ALL=C tr -cd '\000' | wc -c)"
  fi
  s="${s//[!0-9]/}"; n="${n//[!0-9]/}"
  [ "${s:-0}" -le 536870912 ] && [ "${n:-0}" -eq 0 ]
}

# File names, one NUL after each, into a scratch file this run removes. A name
# outside ASCII came back from a plain `ls-files` quoted and escaped, `-f` found
# no such file, and its key was skipped without a word (found by the review of
# the 2026-10-08 change). `-z` prints every name as it is. It goes to a file and
# not into a variable, because bash drops the NULs a substitution captures.
scratch=""
trap '[ -z "$scratch" ] || rm -f "$scratch"' EXIT
_names() {   # what-for, then the ls-files arguments
  local what="$1"; shift
  [ -n "$scratch" ] || scratch="$(mktemp "${TMPDIR:-/tmp}/secret-scan.XXXXXX" 2>/dev/null)" \
    || _unread "no scratch file could be made to list the $what files in"
  git ls-files -z "$@" > "$scratch" 2>/dev/null \
    || _unread "git could not list the $what files ($(_why git ls-files "$@"))"
}

# A file's lines as added lines. The bytes, not characters: BSD sed under a
# UTF-8 locale exits 1 on a file that is not text, and a screenshot left in the
# tree then read as a file that could not be read.
_body() { LC_ALL=C sed 's/^/+/' "$1" 2>/dev/null; }

# A symlink is published as the name of its target, so its target is read only
# when it is a readable file. One that leads nowhere readable is skipped.
_unreachable_link() { [ -L "$1" ] && { [ ! -f "$1" ] || [ ! -r "$1" ]; }; }

# Two questions, and until now only one of them could be asked.
#
# The default mode is a pre-merge diff gate: added lines since a base, which is
# right for "does this change introduce a credential" and answers nothing about
# what is already here. On a fresh clone at main it compares main to main,
# examines zero lines, and exits 0 — a clean report having read nothing.
#
# `--tree` asks the other question, the one a publication decision needs: does
# anything in the tracked tree, as it stands, look like a credential. Every
# tracked file is fed through the same rules as if it had just been added, so
# the answer is about the repository rather than about a diff.
#
# A tracked path that is a pipe, a socket or a device has no bytes to read, and
# it used to be skipped as a path that was not a file. What is published from it
# is whatever the index holds, which nothing here read (2026-10-08). So it is
# refused, as is a tracked file the scan cannot open. A deleted file is still
# skipped, since nothing is there, and so is a symlink whose target is not a
# readable file (_unreachable_link above).
if [ "${1:-}" = "--tree" ]; then
  _names tracked
  tree_src=""
  while IFS= read -r -d '' f; do
    [ -n "$f" ] || continue
    if [ ! -L "$f" ] && { [ -p "$f" ] || [ -S "$f" ] || [ -c "$f" ] || [ -b "$f" ]; }; then
      _unread "$f is tracked and is not a regular file, so it cannot be read"
    fi
    _unreachable_link "$f" && continue
    [ -f "$f" ] || continue
    body="$(_body "$f")" || _unread "$f is tracked and could not be read"
    tree_src="$tree_src
+++ b/$f
$body"
  done < "$scratch"
  rm -f "$scratch"; scratch=""
  found="$(printf '%s\n' "$tree_src" | _hits)"
elif [ "${1:-}" = "-" ]; then
  found="$(_hits)"
else
  # From the top of the work tree (2026-10-08). What a branch adds is not
  # bounded by the directory the scan was started in, but `git ls-files
  # --others` from a subdirectory lists that subdirectory alone, and with
  # diff.relative so did every diff below: a key committed one directory up
  # exited 0. Not `--no-relative`, which git before 2.28 refuses.
  top="$(git rev-parse --show-toplevel 2>/dev/null)" && [ -n "$top" ] && cd -- "$top" \
    || _unread "git could not find the top of this work tree ($(_why git rev-parse --show-toplevel))"
  base="${1:-}"
  if [ -z "$base" ]; then
    for cand in origin/HEAD origin/main origin/master main master; do
      git rev-parse --verify "$cand" >/dev/null 2>&1 && { base="$cand"; break; }
    done
  fi
  # New files are where a key most often lands, and git diff cannot see them:
  # an untracked file has no previous version to differ from. Scanning only the
  # diff meant a fresh file full of credentials passed cleanly. Their whole
  # contents count as added lines. --exclude-standard keeps ignored paths out,
  # so a local .env is not scanned as if it were about to be committed.
  _names untracked --others --exclude-standard
  untracked=""
  while IFS= read -r -d '' f; do
    _unreachable_link "$f" && continue
    [ -n "$f" ] && [ -f "$f" ] || continue
    body="$(_body "$f")" || _unread "$f is untracked and could not be read"
    # A header per file, because _added tracks the current path and a stream
    # without one would judge these lines against whatever file came before.
    untracked="$untracked
+++ b/$f
$body"
  done < "$scratch"
  rm -f "$scratch"; scratch=""

  # What is uncommitted, against HEAD. With no commit yet there is no HEAD to
  # diff against, and `git diff HEAD` fails for that reason alone. That failure
  # read as nothing, so a key staged in a fresh repository was never scanned.
  # There, the staged lines (index against nothing) and the unstaged ones (tree
  # against index) are every line the first commit would add.
  if git rev-parse -q --verify HEAD >/dev/null 2>&1; then
    born=1
    _patch uncommitted HEAD \
      || _unread "git could not read the uncommitted change ($(_why _diff --stat HEAD))"
  else
    born=0
    _patch staged --cached \
      || _unread "git could not read the staged change ($(_why _diff --cached --stat))"
    _patch unstaged \
      || _unread "git could not read the unstaged change ($(_why _diff --stat))"
    uncommitted="$staged
$unstaged"
  fi

  if [ -n "$base" ] && git rev-parse --verify "$base" >/dev/null 2>&1; then
    committed=""
    # The branch side only where there is a branch: on an unborn HEAD,
    # `base...HEAD` fails for want of a commit, as it always did, unread.
    if [ "$born" -eq 1 ]; then
      _patch committed "$base...HEAD" \
        || _unread "git could not read what this branch committed since $base ($(_why _diff --stat "$base...HEAD"))"
    fi
    diff_src="$committed
$uncommitted
$untracked"
  else
    # No base to compare against. Scanning the whole tree would flag every
    # fixture and every historical line, so scan only what is uncommitted and
    # say that the coverage is narrower than it looks.
    printf 'secret-scan: no base ref found; scanning uncommitted changes only\n' >&2
    diff_src="$uncommitted
$untracked"
  fi
  found="$(printf '%s\n' "$diff_src" | _added | grep -v '^+++' | _hits)"
fi

if [ -z "$found" ]; then exit 0; fi
printf 'secret-scan: possible credential in added lines\n' >&2
printf '%s\n' "$found" | sed 's/^/  /' >&2
exit 1

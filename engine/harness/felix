FELIX_HOME_DIR="$(felix_home "$FELIX_ROOT")"   # writable: projects, doctrine, memory

die() { printf 'felix: %s\n' "$1" >&2; exit "${2:-1}"; }

# A flag's value, or a refusal.
#
# `shift 2` fails when the flag is the last argument, and having failed it
# shifts *nothing* — so every `while [ $# -gt 0 ]` parser below spun forever on
# a trailing flag instead of complaining. `felix merge --base` hung until it was
# killed, with no output (#38). The `${2:-default}` beside each one reads as if
# the missing case were handled, which is why nineteen copies of it survived: it
# handles the value and not the shift.
#
# Refusing rather than defaulting, because the flags this guards choose what a
# command acts on. `--base` with a silent fallback to main would compare against
# a branch nobody named, which is the defect this project fixed in felix merge
# one issue earlier.
need_value() {
  [ "$#" -ge 2 ] && [ -n "${2:-}" ] || die "felix: $1 needs a value"
}


# Written out rather than sliced from the header comment. It used to print lines
# 2 to 12 of this file, so documenting a command meant adding a line inside a
# window nobody could see, and four commands added in one day fell off the end
# silently. Thirty-four dispatched; eight were listed. The suite now asserts
# that every dispatched command appears here.
usage() {
  cat <<'USAGE'
Felix. The engineering OS: it decides how work gets built, and proves it.
Resolves which project governs the current directory. Knows nothing about any
specific project, language, or toolchain.

  every day
    felix which            which project governs here, and where its doctrine is
    felix gate [args]      run this project's gate; exits with the gate's status
    felix route            what kind of work this is, and what to reach for
    felix brief <issue>    what an issue names, its tier, and what a fix must prove
    felix pr [--create]    open a pull request for this branch, tier and all
    felix classify         how risky this diff is, and what that means for merging
    felix evidence         what this change still owes before it counts as done
    felix receipt          what changed, its risk, and whether anything verified it
    felix next             what to do next here, ranked
    felix merge            merge it, unless something in it escapes the tree
    felix review           record a reviewer verdict on a surface no test judges

  the toolbox
    felix ready            is every tool this project names actually usable?
    felix toolbox          every installed plugin, what it is, what can reach it
    felix toolbox --route  wire the ones that have somewhere to go
    felix discover         what is worth having that this project does not have
    felix discover --adopt declare and install the low-risk ones it has read
    felix stack [plan|apply] install what this project declares
    felix adopt <cap>      declare a capability and everything it implies
    felix profile [name]   which tools a task profile mounts
    felix quarantine <p>   switch off a plugin that is breaking sessions
    felix recommend        what the catalogue would suggest for this project

  deciding
    felix shape <plan>     which tasks may run apart, and which must not
    felix scope            what a change is allowed to touch
    felix ledger           what has been mounted, and what was never reached for
    felix autonomy         what Felix may do here unattended
    felix coverage         every lifecycle moment, and Felix's stance on it

  the loop
    felix doctor [--fix]   drift, rival gates, and the tidying it can safely do
    felix repair           a bounded brief for a failing CI run
    felix incident         turn an error into a scoped brief
    felix maintenance      upkeep that is due, and when each last ran
    felix automerge        whether green changes may merge themselves yet
    felix unattended       whether the unattended loop is ready to be switched on
    felix budget           how much unattended work has been spent today

  memory
    felix handoff [--was]  regenerate the handoff; --was records what was in progress
    felix log <text>       add a devlog entry
    felix lesson <text>    add a lesson, matched into later prompts
    felix lessons          what this project has already paid for
    felix promote          what has been caught often enough to become doctrine
    felix monitor [--open] render everything Felix did that nobody could see

  setup
    felix new <name>       govern a project: a directory, a JSON file, a marker
    felix install          deploy this engine, bumping the version if it must
    felix bootstrap        write CI, permissions and the files a project needs
    felix setup [id]       the steps only a person can do, and what is left
USAGE
}

# Sets PROJ in the caller's shell rather than printing it. Printing would force
# callers into $(...), and an exit inside a command substitution only kills the
# subshell: the script would sail past a failed resolution and die later with a
# misleading message and the wrong status.
resolve_or_die() {
  PROJ="$(felix_resolve_project "$PWD" "$FELIX_HOME_DIR")" || PROJ=""
  [ -n "$PROJ" ] && return 0
  die "no project governs $PWD.
  Either add a .felix file naming one, or declare remote_match in a project.json.
  Known projects: $(ls "$FELIX_HOME_DIR/projects" 2>/dev/null | tr '\n' ' ')" 2
}


cmd_install() {
  local uninstall=0 home="" a bump=1
  while [ $# -gt 0 ]; do
    case "$1" in
      --uninstall) uninstall=1; shift ;;
      # Bumping is the default because withholding it is what cost nine gate
      # failures. The flag exists for the one case where somebody genuinely
      # wants to see the mismatch without changing the manifest.
      --no-bump)   bump=0; shift ;;
      --home) need_value "$@"; home="$2"; shift 2 ;;
      *) shift ;;
    esac
  done

  if [ "$uninstall" -eq 1 ]; then
    claude plugin uninstall felix@felix >/dev/null 2>&1 \
      && printf 'removed the felix plugin\n' \
      || printf 'felix plugin was not installed\n'
    # Neither is touched, and both are named, because they stopped being one
    # directory on 2026-08-14. This message still said the home held doctrine
    # and memory long after memory had moved out of it — accurate about what was
    # preserved and wrong about where, which on the one path where somebody is
    # deciding whether they are about to lose something is the worst place for a
    # message to be vague.
    printf 'left %s alone: it holds your doctrine\n' "$FELIX_HOME_DIR"
    printf 'left %s alone: it holds your memory\n' "$(felix_mem_root)"
    return 0
  fi

  [ -n "$home" ] && FELIX_HOME_DIR="$(cd "$home" 2>/dev/null && pwd || printf '%s' "$home")"
  mkdir -p "$FELIX_HOME_DIR/projects"
  printf '%s\n' "$FELIX_HOME_DIR" > "$HOME/.felix-home"
  printf 'home:    %s\n' "$FELIX_HOME_DIR"

  # The tree being deployed FROM, which is not the tree this script is running
  # IN whenever somebody follows the instruction every session prints and
  # invokes the deployed CLI. FELIX_ROOT comes from the running script's own
  # location and cannot be overridden, so from the plugin cache it names the
  # cache — and every check below it compared the deployed engine with itself,
  # passed, and deployed nothing. #55.
  #
  # Resolved after --home on purpose, so an explicit --home is honoured.
  #
  # Not $FELIX_HOME_DIR, which is what the issue proposed. The home is the
  # repository ROOT and the engine is nested one level inside it —
  # marketplace.json declares `"source": "./engine"`, so the deployed tree is
  # the CONTENTS of engine/. Substituting the home verbatim names
  # "<repo>/harness", which does not exist, and turns a false pass into a false
  # failure with a wrong diagnosis. Worse, on the very invocation #55 is about
  # the home is read from ~/.felix-home and is an unrelated absolute path that
  # happens to be right only on the primary checkout.
  #
  # Resolved by felix_engine_source, which is where this logic now lives so that
  # cmd_bootstrap can share it rather than answer the same question its own way
  # and get it wrong its own way (#65).
  local src=""
  src="$(felix_engine_source "$FELIX_ROOT" "$FELIX_HOME_DIR")" || src=""
  # Refused rather than guessed. Comparing the cache with itself is the thing
  # this command was doing wrong, so falling back to it would keep the defect
  # and merely move the comment. There is no safe default here: a wrong answer
  # reports a deploy that did not happen.
  [ -n "$src" ] || die "this is the deployed copy of Felix, not a checkout of it, and no
  Felix checkout could be found to install FROM. Nothing was deployed.
  Run felix install from inside the Felix repository, or pass --home naming it.
  Comparing $FELIX_ROOT with itself is what this command used to do (#55)."

  printf 'engine:  %s\n\n' "$src"

  command -v claude >/dev/null 2>&1 || {
    printf 'The claude CLI is not on PATH, so the session hook cannot be registered.\n'
    printf 'The felix command still works; only the automatic binding is missing.\n'
    return 1
  }

  # The directory that HOLDS marketplace.json, which is the repository root —
  # not the engine one level inside it. `$src` is <repo>/engine, because
  # marketplace.json declares `"source": "./engine"` and the deployed tree is
  # the contents of that. The manifest itself stays at the root.
  #
  # #66, and measured against the real CLI in a scratch HOME rather than
  # reasoned about:
  #   add <repo>/engine -> exit 1, "Marketplace file not found at
  #                        <repo>/engine/.claude-plugin/marketplace.json"
  #   add <repo>        -> exit 0, installLocation=<repo>
  # It does not resolve upward.
  #
  # So this call had always failed, and the else branch below was doing the
  # work — which is why every reproduction of an install shows "marketplace
  # refreshed" and never "marketplace registered". A refresh only works on a
  # marketplace that is already registered, so the one case this line exists
  # for, a first install on a clean machine, was the one case it could not do.
  if claude plugin marketplace add "${src%/*}" >/dev/null 2>&1; then
    printf '  marketplace registered\n'
  else
    # Adding an already-registered marketplace is a no-op that does not re-read
    # the manifest, so the CLI keeps offering the version it saw first and the
    # update below finds nothing newer. For a marketplace backed by a local
    # directory — which is every Felix install — this refresh is the step that
    # makes a new version visible at all.
    claude plugin marketplace update felix >/dev/null 2>&1 \
      && printf '  marketplace refreshed\n' \
      || printf '  marketplace already registered\n'
  fi
  # Both, unconditionally, and neither is believed. `install` on a plugin that
  # is already present succeeds without upgrading anything, so a bumped version
  # would sit in the marketplace unused while the command reported success.
  # `update` covers that; the verification below is what actually reports.
  claude plugin install felix@felix --scope user >/dev/null 2>&1 || true
  claude plugin update  felix@felix               >/dev/null 2>&1 || true

  # Claude Code caches a plugin by version. With the manifest pinned, install and
  # update are both no-ops on a changed engine and both report success, so the
  # work sits in the repository running nowhere. That has now happened three
  # times in this project's short life, and twice it was found by accident.
  #
  # So the install verifies itself. Printing "installed" without checking is the
  # failure, not the cache.
  local live
  live="$(claude plugin list --json 2>/dev/null \
          | sed -n '/"felix@felix"/,/}/p' \
          | sed -n 's/.*"installPath"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
  if [ -n "$live" ] && [ -d "$live/harness" ]; then
    if diff -rq "$src/harness" "$live/harness" >/dev/null 2>&1; then
      printf '  verified   the installed engine matches this tree\n'
    elif [ "$bump" -eq 0 ]; then
      printf '\n  WARNING  the installed engine does NOT match this tree.\n'
      printf '           %s\n' "$live"
      printf '           Bumping was declined, so nothing deployed. felix gate will\n'
      printf '           keep failing until the version and the tree agree.\n'
    else
      # The version is the only thing between this tree and a real deployment,
      # and this command already knows it. Printing "bump it and re-run" is a
      # suggestion for something it could safely have done — the charter names
      # that a defect, and the gate had caught `installed` nine times, every one
      # a person typing the digit the command was withholding.
      #
      # Bumping is not the risky half. install is already the thing that
      # replaces the deployed engine.
      # Only when the version is the thing standing in the way. The cache
      # directory is named for the deployed version, so comparing it with the
      # manifest answers the question the comment above claims to be asking —
      # and it had never been asked. A tree that cannot deploy at all differs
      # forever, so every run bumped again: two spurious digits in one session,
      # from re-running install to read its own output.
      local newv curv livev
      curv="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
              "$src/.claude-plugin/plugin.json" 2>/dev/null | head -1)"
      livev="${live##*/}"
      if [ -n "$curv" ] && [ -n "$livev" ] && [ "$curv" != "$livev" ]; then
        printf '\n  %s is already ahead of the deployed %s, so nothing was bumped.\n' \
               "$curv" "$livev"
        if mroot="$(felix_deployable_from "$src")"; then
          printf '           The tree still differs from the cache. Something other than\n'
          printf '           the version is stopping this deploying.\n'
        else
          printf '           The marketplace serves %s, so this worktree was never\n' "$mroot"
          printf '           going to deploy. Merge it and run felix install there.\n'
        fi
      elif newv="$(felix_version_bump "$src/.claude-plugin/plugin.json")"; then
        printf '\n  bumped     %s, because the tree differs and the version did not\n' "$newv"
        # Redeploy at the new version, then verify again rather than assume.
        # The same three steps the deploy above uses. An earlier version did
        # `install` alone and the redeploy silently did nothing, because
        # installing an already-installed plugin is a no-op — `update` is what
        # moves it to the new version.
        claude plugin marketplace update felix        >/dev/null 2>&1 || true
        claude plugin install felix@felix --scope user >/dev/null 2>&1 || true
        claude plugin update  felix@felix              >/dev/null 2>&1 || true
        live="$(claude plugin list --json 2>/dev/null \
                | sed -n '/"felix@felix"/,/}/p' \
                | sed -n 's/.*"installPath"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
        if [ -n "$live" ] && [ -d "$live/harness" ] \
             && diff -rq "$src/harness" "$live/harness" >/dev/null 2>&1; then
          printf '  verified   the installed engine matches this tree\n'
        else
          local mroot
          if mroot="$(felix_deployable_from "$src")"; then
            printf '\n  WARNING  bumped to %s and it still does not match.\n' "$newv"
            printf '           %s\n' "$live"
            printf '           This is no longer the version cache; something else is wrong.\n'
          else
            printf '\n  not deployed, and nothing is wrong.\n'
            printf '           The marketplace serves %s\n' "$mroot"
            printf '           and this engine is at %s\n' "$src"
            printf '           A directory marketplace is pinned to one path, so a worktree\n'
            printf '           cannot deploy and the cache still matches the tree it names.\n'
            printf '           %s is on the branch and is what makes this deployable when\n' "$newv"
            printf '           it merges. Run felix install there afterwards.\n'
          fi
        fi
      else
        printf '\n  WARNING  the installed engine does NOT match this tree, and the\n'
        printf '           version in engine/.claude-plugin/plugin.json could not be\n'
        printf '           read as three numbers, so it was left alone. Fix it by hand.\n'
      fi
    fi
  fi

  # A hand-registered hook plus the plugin means the binding fires twice and the
  # session is told everything about itself two times. Detected rather than
  # edited: someone else's settings file is not Felix's to rewrite.
  if [ -f "$HOME/.claude/settings.json" ] && \
     felix_contains "$(cat "$HOME/.claude/settings.json" 2>/dev/null)" "harness/hooks/session-start"; then
    printf '\n  WARNING  ~/.claude/settings.json also registers the session hook by hand.\n'
    printf '           The plugin now registers it too, so it will fire twice.\n'
    printf '           Remove the SessionStart entry naming harness/hooks/session-start.\n'
  fi

  printf '\nput felix on PATH:\n'
  printf '  ln -s %s/felix /usr/local/bin/felix\n' "$SCRIPT_DIR"
  printf '\nthen, in a project checkout:  felix new <name>\n'
}

cmd_which() {
  resolve_or_die; local proj="$PROJ"
  printf 'project:      %s\n' "$(basename "$proj")"
  printf 'doctrine:     %s\n' "$proj/CLAUDE.md"
  printf 'memory:       %s\n' "$(felix_mem_dir "$proj")/"
  printf 'gate:         %s\n' "$(felix_json_str "$proj/project.json" gate)"
  printf 'governs:      %s\n' "$(felix_repo_root "$PWD")"
}

cmd_gate() {
  resolve_or_die; local proj="$PROJ" gate
  gate="$(felix_json_str "$proj/project.json" gate)"
  [ -n "$gate" ] || die "project $(basename "$proj") declares no gate in project.json"

  # Run from the checkout being gated, never from Felix. A gate that inspects
  # "the tree it lives in" instead of "the tree it was pointed at" reports a
  # verdict about the wrong code, and a false pass is worse than no gate.
  local root; root="$(felix_repo_root "$PWD")"
  cd "$root" || die "cannot enter repo root"

  # Identity of the tree as the gate finds it, captured before it runs. A gate
  # that rewrites files — a formatter is the ordinary case — would otherwise
  # stamp a receipt describing a tree it never actually verified.
  local tid; tid="$(felix_tree_id "$root" "$FELIX_HOME_DIR")" || tid=""
  export FELIX_PROJECT="$proj"
  # Tools Felix ships for a gate to call. A project gate cannot know where
  # Felix lives, and hardcoding a path would break the moment it moves.
  export FELIX_BIN="$SCRIPT_DIR/bin"

  # A script Felix stores for the project, or any shell command the project
  # already has. The second form is what lets Felix gate a stack it has never
  # heard of: "npm run verify", "dotnet test", "cargo test", "make check".
  # Not exec. The process has to survive the gate so a failure can be recorded:
  # a mistake nobody writes down is one the project gets to make again.
  local log rc
  log="$(mktemp)"
  if [ -x "$proj/$gate" ]; then
    "$proj/$gate" "$@" 2>&1 | tee "$log"; rc=${PIPESTATUS[0]}
  else
    bash -c "$gate \"\$@\"" felix-gate "$@" 2>&1 | tee "$log"; rc=${PIPESTATUS[0]}
  fi
  if [ "$rc" -ne 0 ]; then
    # Which checks failed, if the gate names them. Falls back to the exit status
    # rather than guessing, because an invented cause is worse than a vague one.
    #
    # A gate may mark a failure `FAIL (structural: ...)`, meaning it failed for a
    # property of where it ran rather than of the work. Those are subtracted
    # here. This log is the input to `felix promote` and to rank 5 of
    # `felix next`, both of which ask what keeps costing time and answer with
    # "build a mechanism" — and a check that could not have passed did not catch
    # anything, so it has no mechanism to build and no lesson to teach.
    #
    # Felix's own `installed` check is the case: it compares the tree against
    # the deployed cache, which in a worktree can never match, so every run
    # there recorded a mistake nobody made. The count reached 11 and sat at the
    # top of the ranking. The engine still learns no check's name — the gate
    # that owns the check declares it, which is the only place that knows.
    #
    # The verdict is untouched. The gate still failed and still exits non-zero.
    #
    # The fallback fires only when the gate named NOTHING. A gate whose every
    # failure was structural has told us precisely what happened, so falling
    # back to `exit-1` there would re-introduce the same permanent row under a
    # less informative name — which is what happened the first time this was
    # tried, caught by running it in a real worktree rather than the suite.
    local what named
    # No `|| printf 0` here. `grep -c` prints the count and *also* exits 1 when
    # that count is zero, so the fallback appended a second zero and made this
    # "0\n0" — not an integer, so the test below errored and took the wrong
    # branch. A guard firing on a command that succeeded at reporting nothing is
    # the same shape as everything else in this commit.
    named="$(grep -icE '^[[:space:]]*[a-z-]+[[:space:]]+FAIL' "$log" 2>/dev/null | tr -dc '0-9')"
    what="$(grep -iE '^[[:space:]]*[a-z-]+[[:space:]]+FAIL' "$log" 2>/dev/null \
            | grep -viE 'FAIL[[:space:]]*\((structural)' \
            | awk '{print $1}' | tr '\n' ' ')"
    if [ -n "$what" ]; then
      felix_mem_mistake "$proj" "$root" "$what"
    elif [ "${named:-0}" -eq 0 ]; then
      felix_mem_mistake "$proj" "$root" "exit-$rc"
    fi
  fi
  rm -f "$log"

  # The receipt. Recorded on failure as well as success: no receipt and a red
  # one both stop a session, but only one of them says what happened.
  felix_verify_record "$root" "$FELIX_HOME_DIR" "$rc" "$gate" "$tid"
  exit "$rc"
}

cmd_new() {
  local name="${1:-}" target="${2:-$PWD}"
  [ -n "$name" ] || die "usage: felix new <name> [path-to-checkout]"
  local dir="$FELIX_HOME_DIR/projects/$name"
  [ -e "$dir" ] && die "project $name already exists at $dir"
  local tpl="$SCRIPT_DIR/templates"
  [ -d "$tpl" ] || die "missing $tpl"

  local root caps gate slug
  root="$(felix_repo_root "$target")"
  caps="$(felix_detect "$root" | sort -u)"
  gate="$(felix_guess_gate "$root")"
  slug="$(felix_repo_slug "$root")"

  mkdir -p "$(felix_mem_dir "$dir")" "$dir/setup"

  # project.json. remote_match is only useful when there is a remote; the .felix
  # marker below covers every other case, including no remote at all.
  cat > "$dir/project.json" <<EOF
{
  "name": "$name",
  "remote_match": "$slug",
  "gate": "$gate"
}
EOF

  printf '%s\n' "$caps" | grep -v '^$' > "$dir/capabilities" || true

  # Keep catalogue rows that are unconditional or whose capability was detected.
  {
    printf '# Declared tooling for %s. Seeded from the catalogue by felix new,\n' "$name"
    printf '# filtered to what this checkout actually shows. Edit freely.\n#\n'
    printf '# kind\tname\tsource\trisk\tcapability\n'
    grep -vE '^\s*(#|$)' "$tpl/catalog.tsv" | while IFS=$'\t' read -r k n src r c _kw; do
      if [ "$c" = "always" ] || printf '%s\n' "$caps" | grep -qxF "$c"; then
        printf '%s\t%s\t%s\t%s\t%s\n' "$k" "$n" "$src" "$r" "$c"
      fi
    done
  } > "$dir/stack.tsv"

  cp "$tpl/profiles.tsv" "$dir/profiles.tsv"
  cp "$tpl/routes.tsv" "$dir/routes.tsv"
  cp "$tpl/risk.tsv" "$dir/risk.tsv"
  cp "$tpl/evidence.tsv" "$dir/evidence.tsv"
  cp "$tpl/maintenance.tsv" "$dir/maintenance.tsv"

  # Same filter for human steps, and only copy the runbooks that survive it.
  {
    printf '# Human steps for %s. Seeded by felix new.\n#\n' "$name"
    printf '# id\ttitle\tcapability\tcheck\n'
    grep -vE '^\s*(#|$)' "$tpl/setup.tsv" | while IFS=$'\t' read -r id title c chk; do
      if [ "$c" = "always" ] || printf '%s\n' "$caps" | grep -qxF "$c"; then
        printf '%s\t%s\t%s\t%s\n' "$id" "$title" "$c" "${chk//\{\{REPO\}\}/$slug}"
        [ -f "$tpl/setup/$id.md" ] && \
          sed "s|{{REPO}}|$slug|g" "$tpl/setup/$id.md" > "$dir/setup/$id.md"
      fi
    done
  } > "$dir/setup.tsv"

  # A real starting constitution rather than a stub telling someone to write one.
  #
  # The mechanical half is derivable and should be: the gate, the capabilities,
  # the commands. The invariants are not, and asking a founder to invent them on
  # day one produces either nothing or something copied. So the file says where
  # they come from instead: the ladder from a caught mistake, to a lesson, to a
  # rule, which is the guidebook's promotion logic pointed at its own doctrine.
  {
    printf '# %s\n\n' "$name"
    printf 'Governed by Felix. This file is the project constitution: what is true\n'
    printf 'about %s and nothing else.\n\n' "$name"
    printf '## Verification\n\n'
    printf 'Run the gate before claiming anything is done.\n\n'
    printf '```bash\nfelix gate\n```\n\n'
    [ -n "$gate" ] && printf 'It runs `%s` in this checkout.\n\n' "$gate"
    printf '## What this project has\n\n'
    printf 'Detected at onboarding. `felix doctor` keeps this honest as it changes.\n\n'
    printf '%s\n' "$caps" | grep -v '^$' | sed 's/^/- /'
    printf '\n## Invariants\n\n'
    printf 'Empty on purpose, and not for long.\n\n'
    printf 'These are the things no linter can catch, and they are earned rather\n'
    printf 'than invented. The gate records what it catches in `memory/mistakes.log`.\n'
    printf 'Anything it catches twice shows up in `felix promote`. A mistake that\n'
    printf 'keeps happening becomes a lesson; a lesson that keeps being violated\n'
    printf 'has outgrown the lessons file and belongs here, where the gate can see\n'
    printf 'it.\n\n'
    printf 'Write them down as they arrive. A constitution invented on day one is\n'
    printf 'either empty or borrowed.\n\n'
    printf '## Risk\n\n'
    printf 'Tiers live in `risk.tsv`, evidence requirements in `evidence.tsv`, both\n'
    printf 'beside this file. `felix classify` and `felix evidence` read them, and\n'
    printf 'nothing red is ever touched unattended.\n'
  } > "$dir/CLAUDE.md"
  : > "$(felix_mem_dir "$dir")/DEVLOG.md"
  : > "$(felix_mem_dir "$dir")/lessons.md"
  : > "$(felix_mem_dir "$dir")/SESSION_HANDOFF.md"

  # The marker binds the checkout without needing a remote.
  printf '%s\n' "$name" > "$root/.felix"

  printf 'created %s\n\n' "$dir"
  printf '  detected     %s\n' "$(printf '%s' "$caps" | tr '\n' ' ')"
  printf '  gate guess   %s\n' "${gate:-none, set it yourself}"
  printf '  repo         %s\n' "${slug:-no github remote}"
  printf '  bound via    %s/.felix\n\n' "$root"
  printf 'seeded stack.tsv, profiles.tsv, setup.tsv and %s runbook(s).\n' \
    "$(ls "$dir/setup" 2>/dev/null | wc -l | tr -d ' ')"
  printf '\nnext:\n'
  printf '  1. confirm the gate in project.json actually fails on broken code\n'
  printf '  2. write %s/CLAUDE.md\n' "$dir"
  printf '  3. felix stack plan     then apply --yes\n'
  printf '  4. felix setup          for the steps only you can do\n'
  printf '\nA starting constitution was written for you at\n%s/CLAUDE.md.\n' "$dir"
  printf 'To deepen it against the actual codebase, paste into a session:\n\n'
  printf '  /claude-md-management:claude-md-improver\n'
  printf '  Audit %s/CLAUDE.md against %s.\n' "$dir" "$root"
  printf '  Felix already covers verification, capabilities and risk tiers; add\n'
  printf '  architecture and non-obvious patterns, and leave the invariants alone:\n'
  printf '  those accrete from felix promote rather than being invented.\n'
}


cmd_recommend() {
  resolve_or_die; local proj="$PROJ" want="" tpl="$SCRIPT_DIR/templates"
  while [ $# -gt 0 ]; do
    case "$1" in
      --want) need_value "$@"; want="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  local root eco caps
  root="$(felix_repo_root "$PWD")"
  eco="$(felix_guess_ecosystem "$root")"
  caps="$(felix_declared "$proj" | tr '\n' ' ')"

  if [ -n "$want" ]; then
    printf 'you asked for: %s\n\n' "$want"
    local hits; hits="$(felix_recommend_intent "$tpl" "$want" | sort -rn)"
    if [ -z "$hits" ]; then
      printf 'Nothing in the catalogue matches that.\n\n'
      printf 'The catalogue is small on purpose. Hand it to the recommender below,\n'
      printf 'which knows far more than fifteen rows.\n\n'
    else
      printf '%s\n' "$hits" | while IFS=$'\t' read -r score kind name risk cap; do
        [ -n "${score:-}" ] || continue
        local have="not mounted"
        grep -qF "	$name	" "$proj/stack.tsv" 2>/dev/null && have="already declared"
        printf '  %-10s %-46s %-7s %s\n' "$kind" "$name" "$risk" "$have"
      done
      printf '\nDeclare one with: felix adopt <capability>, or add the row to\n'
      printf '%s/stack.tsv directly. Nothing was installed.\n\n' "$proj"
    fi
  else
    printf 'project:    %s\necosystem:  %s\ndeclared:   %s\n\n' \
      "$(basename "$proj")" "$eco" "${caps:-none}"
    local missing; missing="$(felix_recommend_missing "$proj" "$tpl")"
    if [ -z "$missing" ]; then
      printf 'Every catalogue row this project could use is already declared.\n\n'
    else
      printf 'in the catalogue, not yet declared here\n'
      printf '%s\n' "$missing" | while IFS=$'\t' read -r kind name risk cap; do
        [ -n "${kind:-}" ] || continue
        local why="applies once %s exists"
        if [ "$cap" = "always" ]; then why="applies to any project"
        elif felix_has_line "$(felix_declared "$proj")" "$cap"; then why="$cap is active here"
        else why="waits for $cap"; fi
        printf '  %-10s %-46s %-7s %s\n' "$kind" "$name" "$risk" "$why"
      done
      printf '\n'
    fi
  fi

  # The handoff. Felix knows this project; the recommender knows the ecosystem.
  # Passing the established facts keeps its answer from repeating them back.
  printf 'For anything beyond this catalogue, paste into a session:\n\n'
  printf '  /claude-code-setup:claude-automation-recommender\n'
  printf '  Project %s, a %s codebase. Felix already detected: %s\n' \
    "$(basename "$proj")" "$eco" "${caps:-nothing yet}"
  printf '  Already declared, do not repeat these: %s\n' \
    "$(grep -vE '^[[:space:]]*(#|$)' "$proj/stack.tsv" 2>/dev/null | cut -f2 | tr '\n' ' ')"
  printf '  Recommend hooks, subagents and skills this stack implies that are\n'
  printf '  not in that list. Read-only: I will decide what to adopt.\n'
}

cmd_route() {
  resolve_or_die; local proj="$PROJ" want="" explain=0 list=0 promote=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --for)     need_value "$@"; want="$2"; shift 2 ;;
      --explain) explain=1; shift ;;
      --list)    list=1; shift ;;
      --promote) promote=1; shift ;;
      *) shift ;;
    esac
  done
  [ -f "$proj/routes.tsv" ] || die "project $(basename "$proj") declares no routes.tsv"
  local root; root="$(felix_repo_root "$PWD")"

  if [ "$list" -eq 1 ]; then
    printf 'routes for %s, in precedence order\n\n' "$(basename "$proj")"
    _felix_route_rows "$proj" | while IFS=$'\t' read -r n _k pr pl; do
      printf '  %-10s %-10s %s\n' "$n" "$pr" "$pl"
    done
    return 0
  fi

  if [ "$promote" -eq 1 ]; then
    # Exit status, not emptiness. These are different facts and this report
    # could not tell them apart: when the pipeline died on a malformed byte it
    # returned nothing, and nothing was printed as "no misses worth a row" —
    # a crash wearing an all-clear, in the report that exists to say what the
    # routing table is missing.
    local hits hrc
    hits="$(felix_route_promote "$proj")" && hrc=0 || hrc=$?
    if [ "$hrc" -ne 0 ]; then
      printf 'Could not read the miss log; this is not an all-clear.\n\n'
      printf '  %s\n\n' "$(felix_mem_dir "$proj")/routes.log"
      printf 'felix route --promote exited %s. Until that is fixed it cannot\n' "$hrc"
      printf 'tell you what the table is missing, so do not read silence as none.\n'
      return 1
    fi
    if [ -z "$hits" ]; then
      printf 'Nothing has missed often enough to be worth a row yet.\n'
      return 0
    fi
    printf 'words that keep appearing in prompts no route understood\n\n'
    printf '%s\n' "$hits" | while IFS=$'\t' read -r n w; do
      printf '  %-4s %s\n' "$n" "$w"
    done
    printf '\nWord frequency, not understanding. A term appearing often may want a\n'
    printf 'route, or may simply be what this project is about. Add the keyword to\n'
    printf 'an existing row in %s/routes.tsv if it would change what you reach for.\n' "$proj"
    return 0
  fi

  local ctx; ctx="$(felix_route_context "$root")"

  if [ "$explain" -eq 1 ]; then
    printf 'prompt:    %s\nthreshold: %s\n\n' "${want:-<none, using the tree>}" "$FELIX_ROUTE_MIN_SCORE"
    printf '  %-5s %-5s %-5s %-10s %s\n' total typed tree route play
    felix_route_score "$proj" "$want" "$ctx" | sort -k2,2nr -k3,3nr -k4,4n \
      | while IFS=$'\t' read -r s ps cs _i n _pr pl; do
          printf '  %-5s %-5s %-5s %-10s %s\n' "$s" "$ps" "$cs" "$n" "$pl"
        done
    printf '\nTyped wins first, then tree, then file order. The tree contributes at\n'
    printf 'most %s however many of its tokens match. Below %s nothing is said.\n' \
      "$FELIX_ROUTE_CONTEXT_CAP" \
      "$FELIX_ROUTE_MIN_SCORE"
    return 0
  fi

  local best
  if ! best="$(felix_route_best "$proj" "$want" "$ctx")"; then
    felix_route_log "$proj" "" 0 "$want"
    return 0
  fi
  local score pscore name play
  score="$(printf '%s' "$best" | cut -f1)"
  pscore="$(printf '%s' "$best" | cut -f2)"
  name="$(printf '%s' "$best" | cut -f5)"
  play="$(printf '%s' "$best" | cut -f7)"
  felix_route_log "$proj" "$name" "$score" "$want"
  felix_route_render "$proj" "$name" "$play" "$root" "$pscore"
}

cmd_quarantine() {
  resolve_or_die; local proj="$PROJ" name="${1:-}" why=""
  shift 2>/dev/null || true
  while [ $# -gt 0 ]; do
    case "$1" in --why) need_value "$@"; why="$2"; shift 2 ;; *) shift ;; esac
  done
  [ -n "$name" ] || die 'usage: felix quarantine <plugin> [--why "..."]'
  command -v claude >/dev/null 2>&1 || die "felix quarantine needs the claude CLI"

  local id
  id="$(felix_ready_inventory | awk -F'\t' -v n="$name" '$2==n{print $2; exit}')"
  [ -n "$id" ] || die "no installed plugin called $name. felix ready lists what is here."

  if claude plugin disable "$name" >/dev/null 2>&1 \
     || claude plugin disable "$name@claude-plugins-official" >/dev/null 2>&1; then
    printf 'quarantined %s\n\n' "$name"
  else
    die "could not disable $name; try: claude plugin disable $name"
  fi

  # Recorded, because a plugin switched off and forgotten is a capability that
  # silently stopped existing, and six months later nobody remembers why.
  [ -d "$(felix_mem_dir "$proj")" ] && printf '%s\tquarantine\t%s\t%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$name" "${why:-no reason given}" \
    >> "$(felix_mem_dir "$proj")/verification.log" 2>/dev/null

  printf 'This takes effect in your NEXT session. A plugin already loaded stays\n'
  printf 'loaded, hooks and all, so the current one behaves exactly as before.\n\n'
  printf 'Undo whenever it is fixed:\n\n  claude plugin enable %s\n' "$name"
}

cmd_brief() {
  resolve_or_die; local proj="$PROJ" src="" title="" num="" body=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --from)  need_value "$@"; src="$2"; shift 2 ;;
      --title) need_value "$@"; title="$2"; shift 2 ;;
      -*)      die "unknown flag: $1" ;;
      *)       num="$1"; shift ;;
    esac
  done

  local root; root="$(felix_repo_root "$PWD")"

  if [ -n "$src" ]; then
    if [ "$src" = "-" ]; then body="$(cat)"; else
      [ -f "$src" ] || die "no such file: $src"
      body="$(cat "$src")"
    fi
  elif [ -n "$num" ]; then
    command -v gh >/dev/null 2>&1 || die "felix brief needs the gh CLI, which is not on PATH"
    local slug; slug="$(felix_repo_slug "$root")"
    [ -n "$slug" ] || die "no github remote; pass the text with --from - instead"
    # Two calls rather than one templated one: the engine parses no JSON.
    title="$(gh issue view "$num" --repo "$slug" --json title -q .title 2>/dev/null)" \
      || die "could not read issue $num from $slug"
    [ -n "$title" ] || die "issue $num has no title, or does not exist in $slug"
    body="$(gh issue view "$num" --repo "$slug" --json body -q .body 2>/dev/null)"
  else
    die "felix brief <issue-number>, or felix brief --from - with the text on stdin"
  fi

  felix_brief_render "$proj" "$root" "${title:-untitled}" "$body"
}

cmd_pr() {
  resolve_or_die; local proj="$PROJ" base="main" create=0 issue="" title=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --base)   need_value "$@"; base="$2"; shift 2 ;;
      --issue)  need_value "$@"; issue="$2"; shift 2 ;;
      --title)  need_value "$@"; title="$2"; shift 2 ;;
      --create) create=1; shift ;;
      *) shift ;;
    esac
  done

  local root branch body tier findings
  root="$(felix_repo_root "$PWD")"
  branch="$(git -C "$root" rev-parse --abbrev-ref HEAD 2>/dev/null)"
  [ "$branch" != "$base" ] || die "already on $base; make a branch before opening a pull request"

  [ -n "$title" ] || title="$(git -C "$root" log -1 --format=%s 2>/dev/null)"
  body="$(felix_pr_body "$root" "$base")"
  [ -n "$issue" ] && body="$body

closes #$issue"

  # Two calls, exactly as cmd_classify does it: diff produces findings, tier
  # reduces them. felix_classify_tier takes the findings, not the paths.
  findings="$(felix_classify_diff "$proj" "$base" "$root" 2>/dev/null)"
  tier="$(felix_classify_tier "$findings" 2>/dev/null)"

  # `|| tier=green` was here, and it is the most expensive default in the file:
  # this tier is applied to the pull request as a risk-<tier> label, and green
  # is the tier that can auto-merge. An unresolvable base produced no findings,
  # no findings reduced to green, and a branch nobody had compared was labelled
  # safe to merge itself. Refused rather than defaulted — and refused here, not
  # at the label, because a preview that says `tier: green` is read and believed
  # long before anyone runs --create.
  #
  # gh would reject this base anyway, client-side. Saying so first means the
  # reason given is the real one.
  [ "$tier" = "unknown" ] && die "the base '$base' names nothing this repository holds, so
  nothing was compared and there is no tier to put on this. No pull request
  was opened. Check --base, or the default branch, which is not \`main\`
  everywhere."
  [ -n "$tier" ] || die "could not classify this change against '$base', so there is no
  risk tier to label the pull request with. No pull request was opened."

  printf 'branch:   %s -> %s\ntitle:    %s\ntier:     %s\n\n' "$branch" "$base" "$title" "$tier"
  printf '%s\n' "$body"

  if [ "$create" -eq 0 ]; then
    printf '\nPreview only. Add --create to open it.\n'
    return 0
  fi

  command -v gh >/dev/null 2>&1 || die "felix pr --create needs the gh CLI, which is not on PATH"
  local slug; slug="$(felix_repo_slug "$root")"
  [ -n "$slug" ] || die "no github remote"

  # Draft when the gate has not passed on this exact tree. Read the receipt the
  # way the Stop hook does: identity must match AND the result must be green,
  # because a green receipt for a different tree is not a green gate.
  #
  # Opened anyway rather than refused. The repair loop attaches to an existing
  # pull request, so refusing here would leave it nothing to attach to.
  local draft="--draft" tid receipt
  tid="$(felix_tree_id "$root" "$FELIX_HOME_DIR" 2>/dev/null)" || tid=""
  receipt="$(felix_verify_receipt "$root" "$FELIX_HOME_DIR" 2>/dev/null)"
  if [ -n "$tid" ] && [ "$(printf '%s' "$receipt" | cut -f1)" = "$tid" ] \
     && [ "$(printf '%s' "$receipt" | cut -f2)" = "green" ]; then
    draft=""
  fi

  # shellcheck disable=SC2086
  gh pr create --repo "$slug" --base "$base" --head "$branch" \
    --title "$title" --body "$body" $draft || die "gh pr create failed"
  printf '\ncreated. labelling risk-%s\n' "$tier"
  gh pr edit --repo "$slug" --add-label "risk-$tier" >/dev/null 2>&1 \
    || printf 'could not apply risk-%s; the label may not exist yet\n' "$tier"
}

# The blockers, computed by the engine `main` declares rather than by this one.
#
# A child shell that sources only the kernel's libraries, so nothing from the
# tree under judgement is in scope when the verdict forms. review.sh is in the
# list and must stay: escape.sh guards the reviewed channel with
# `command -v felix_review_passed`, so leaving it out does not error — it
# silently stops a reviewer's pass from ever clearing, which is the one
# exception invariant 2 grants.
#
# The exit status separates three answers that must not be confused: it judged
# (0), it is too old to judge (4), it could not be loaded (3). Only 0 permits.
_felix_kernel_blockers() {
  local kernel="$1" proj="$2" base="$3" root="$4" home="$5"
  [ -d "$kernel/lib" ] || return 3
  bash -c '
    set -uo pipefail
    k="$1"
    for f in resolve verify review classify evidence escape; do
      [ -r "$k/lib/$f.sh" ] || exit 3
      . "$k/lib/$f.sh" 2>/dev/null || exit 3
    done
    command -v felix_merge_blockers >/dev/null 2>&1 || exit 4
    felix_merge_blockers "$2" "$3" "$4" "$5"
  ' _ "$kernel" "$proj" "$base" "$root" "$home"
}

cmd_merge() {
  resolve_or_die
  local proj="$PROJ" root base="main" dry=0
  root="$(felix_repo_root "$PWD")"
  while [ $# -gt 0 ]; do
    case "$1" in
      --base)    need_value "$@"; base="$2"; shift 2 ;;
      --dry-run) dry=1; shift ;;
      # Discarding this is how `felix merge 35` merged whatever HEAD was on and
      # reported that it had verified it. A command told to merge one thing and
      # given no way to do so has nothing safer to do than stop.
      *) die "felix merge does not take '$1'. It merges the branch that is checked out, so check out the branch you mean." ;;
    esac
  done

  # Read before anything is verified, and read again immediately before the
  # merge. Every blocker below is a claim about one checkout, and the branch is
  # what the merge acts on — reading it afterwards is what let a peer's
  # `git checkout` inside the gap merge a branch nothing had looked at and
  # print that nothing in it escaped the tree (#33). Taking it first bounds the
  # window at the whole of felix_merge_blockers rather than at the tail of it.
  local was; was="$(felix_merge_checkout "$root" "$FELIX_HOME_DIR")"
  local branch; branch="$(printf '%s' "$was" | cut -f1)"
  [ -n "$branch" ] && [ "$branch" != "HEAD" ] || die "cannot name the branch to merge"

  # Judged by the engine main declares, never by this tree — but only where
  # that circularity exists. A governed product's rules live in the Felix home
  # and are not in its diff, so it is judged as it always was and needs no
  # installed engine at all.
  local blockers krc
  if felix_self_governed "$root"; then
    local kernel; kernel="$(felix_kernel_dir "$root" "$base")" || kernel=""
    [ -n "$kernel" ] && [ -d "$kernel/lib" ] || die "no installed copy of the engine main declares, so there is nothing to judge this that is not this. Run felix install on main, then try again."
    # The judge must not be the candidate — but only when the candidate is the
    # judge's own source. A branch that does not touch engine/ has no
    # circularity to break, and an identical judge there is not self-judgement:
    # it is the base version, unchanged, which is exactly what should be
    # judging. The first version of this check omitted that condition and made
    # every documentation branch unmergeable; the first real use found it.
    # engine/harness/, not engine/. The kernel is built from engine/harness, and
    # every deploy forces a version bump in engine/.claude-plugin — which cannot
    # touch engine/harness. Testing the wider path told a bump-only branch to
    # bump the version and install main's: advice already followed, and unable
    # to change the thing being compared.
    if felix_changed_paths "$root" "$base" | grep -q '^engine/harness/' \
         && diff -rq "$root/engine/harness" "$kernel" >/dev/null 2>&1; then
      die "the engine that would judge this is byte-identical to the tree it is judging, so it would be judging itself. Bump the version and install main's, or say plainly that this is unjudged."
    fi
    blockers="$(_felix_kernel_blockers "$kernel" "$proj" "$base" "$root" "$FELIX_HOME_DIR")"
    krc=$?
    case "$krc" in
      0) ;;
      4) die "the installed engine at $kernel is too old to judge this: it has no felix_merge_blockers. Install a newer main." ;;
      *) die "the installed engine at $kernel could not be loaded to judge this." ;;
    esac
  else
    blockers="$(felix_merge_blockers "$proj" "$base" "$root" "$FELIX_HOME_DIR")"
  fi

  if [ -n "$blockers" ]; then
    local kind subject reason esc=0 unk=0
    printf 'not merging\n\n'
    while IFS=$'\t' read -r kind subject reason; do
      [ -n "${kind:-}" ] || continue
      printf '  %-11s %-22s %s\n' "$kind" "$subject" "$reason"
      [ "$kind" = "escape" ]  && esc=1
      [ "$kind" = "unknown" ] && unk=1
    done <<EOF
$blockers
EOF
    # The declared objective is founder interruptions per session, so the
    # moments Felix could not decide have to be recorded where they happen.
    # Counting them later out of a transcript is the parsing approach this
    # project rejected twice; and a number nobody records is a number nobody
    # moves. Only escapes count. An unrun gate or a missing test is Felix's own
    # work, and counting those would let the figure improve by gating less.
    if [ "$esc" -eq 1 ]; then
      while IFS=$'\t' read -r kind subject reason; do
        [ "${kind:-}" = "escape" ] || continue
        felix_say "$proj" "escalated" "$subject: $reason" "felix merge" "" 2>/dev/null || true
      done <<EOF
$blockers
EOF
    fi

    # `unknown` is checked before `escape`, because the sentence in the else
    # branch is the exact claim #56 is about. Saying "nothing here escapes the
    # tree" after a scan that never ran would move the false all-clear from the
    # verdict into the explanation and leave it just as wrong. Nothing was
    # compared, so nothing can be said about what escapes.
    if [ "$unk" -eq 1 ]; then
      printf '\nNothing was compared, so nothing above is a finding about this branch.\n'
      printf 'The base names nothing this repository holds — check --base, or the\n'
      printf 'default branch, which is not `main` everywhere. This says nothing\n'
      printf 'about whether the change escapes the tree; that was never asked.\n'
    elif [ "$esc" -eq 1 ]; then
      printf '\nMerging this writes something outside the tree that a revert does not\n'
      printf 'reach, so it is the founder who decides. Show them the diff and the\n'
      printf 'reversal path; a green gate is not the question here.\n'
    else
      printf '\nNothing here escapes the tree, so none of it is a founder decision.\n'
      printf 'It is work Felix owes: run the gate, or write the test that is missing,\n'
      printf 'then run this again.\n'
    fi
    return 3
  fi

  if [ "$dry" -eq 1 ]; then
    printf 'nothing escapes this tree, and the gate is green on it.\n'
    printf 'felix merge would squash this now.\n'
    return 0
  fi

  command -v gh >/dev/null 2>&1 || die "felix merge needs the gh CLI, which is not on PATH"
  local slug; slug="$(felix_repo_slug "$root")"
  [ -n "$slug" ] || die "no github remote"

  # The remote is consulted last and only to perform the merge. Every reason to
  # refuse was computed above, offline, so this command says no the same way
  # with or without a network.
  #
  # The branch is the selector, and leaving it out is why this command could
  # never merge anything: `gh pr merge --repo <slug>` with no pull request named
  # is refused by gh itself, client-side, before any network call. It shipped
  # that way because every test covered a refusal or a dry run, so the one line
  # that reaches gh was never executed.
  # Last thing before the only line that acts. If the checkout moved, every
  # verdict above describes something that is no longer here, and merging on it
  # would be the one outcome this command exists to prevent.
  local now; now="$(felix_merge_checkout "$root" "$FELIX_HOME_DIR")"
  if [ "$now" != "$was" ]; then
    # Name the field that moved. Printing a fixed prefix of the record meant the
    # tree-id case — the one the third field was added to catch, where a peer
    # edits an uncommitted file and leaves branch and commit alone — rendered as
    # two identical lines under a sentence saying the checkout had moved, which
    # it had not. A refusal whose evidence contradicts its own reason is worse
    # than a bare one: it sends somebody to look at the thing that is fine.
    local wb nb ws ns wt nt moved=""
    wb="$(printf '%s' "$was" | cut -f1)"; nb="$(printf '%s' "$now" | cut -f1)"
    ws="$(printf '%s' "$was" | cut -f2)"; ns="$(printf '%s' "$now" | cut -f2)"
    wt="$(printf '%s' "$was" | cut -f3)"; nt="$(printf '%s' "$now" | cut -f3)"
    printf 'not merging\n\n'
    [ "$wb" != "$nb" ] && { printf '  branch     %s -> %s\n' "$wb" "$nb"; moved="checkout"; }
    [ "$ws" != "$ns" ] && { printf '  commit     %s -> %s\n' "$ws" "$ns"; moved="checkout"; }
    [ "$wt" != "$nt" ] && { printf '  tree       edited under it, uncommitted or untracked\n'
                            [ -n "$moved" ] || moved="tree"; }
    if [ "$moved" = "tree" ]; then
      printf '\nThe working tree was edited while this ran, so the receipt accepted\n'
      printf 'above describes a tree that is already gone. Nothing was merged.\n'
    else
      printf '\nThe checkout moved while this ran, so what was verified is not what\n'
      printf 'would be merged. Nothing was merged.\n'
    fi
    printf 'Run it again once nothing else is touching this working copy.\n'
    return 4
  fi
  gh pr merge "$branch" --repo "$slug" --squash || die "gh pr merge failed"
  printf 'merged. nothing in it escaped the tree.\n'
}

cmd_next() {
  resolve_or_die
  local proj="$PROJ" root base="main" a
  root="$(felix_repo_root "$PWD")"
  for a in "$@"; do case "$a" in --base) shift; base="${1:-main}" ;; esac; done

  local rows; rows="$(felix_next "$proj" "$FELIX_HOME_DIR" "$root" "$base")"
  if [ -z "$rows" ]; then
    printf 'nothing due for %s\n\n' "$(basename "$proj")"
    printf 'The gate is green on this tree, nothing escapes it, every tool a\n'
    printf 'route names is reachable, and no upkeep is past its cadence.\n'
    return 0
  fi

  local rank owner what do_ last="" n=0
  printf 'next for %s\n' "$(basename "$proj")"
  while IFS=$'\t' read -r rank owner what do_; do
    [ -n "${rank:-}" ] || continue
    if [ "$rank" != "$last" ]; then
      printf '\n'
      case "$rank" in
        1) printf '  the change in hand\n' ;;
        2) printf '  yours to decide\n' ;;
        3) printf '  before the next session starts\n' ;;
        4) printf '  upkeep\n' ;;
        5) printf '  already cost time more than once\n' ;;
        6) printf '  a check that is not checking\n' ;;
        7) printf '  routing\n' ;;
      esac
      last="$rank"
    fi
    printf '    %-8s %s\n' "$owner" "$what"
    printf '    %-8s   %s\n' "" "$do_"
    n=$((n+1))
  done <<EOF
$rows
EOF

  printf '\n%s item(s). Ranked by what interrupts you, then by what is blocking.\n' "$n"
  printf 'Anything marked felix is Felix'"'"'s own work and not a decision for you;\n'
  printf 'it is listed because it costs time, not because it needs approving.\n'
}

cmd_review() {
  resolve_or_die
  local proj="$PROJ" root verdict="" by="" note="" where="" tid
  root="$(felix_repo_root "$PWD")"
  while [ $# -gt 0 ]; do
    case "$1" in
      --pass)  verdict=pass;  shift ;;
      --block) verdict=block; shift ;;
      --by)    need_value "$@"; by="$2";   shift 2 ;;
      --note)  need_value "$@"; note="$2"; shift 2 ;;
      --in)    need_value "$@"; where="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  tid="$(felix_tree_id "$root" "$FELIX_HOME_DIR" 2>/dev/null)"
  [ -n "$tid" ] || die "cannot identify this tree"

  if [ -n "$verdict" ]; then
    [ -n "$by" ] || die "felix review --pass|--block needs --by <who reviewed it>"
    if ! felix_review_record "$FELIX_HOME_DIR" "$proj" "$tid" "$verdict" "$by" "$note" "$where" "$root"; then
      [ "$verdict" = "pass" ] && [ -n "$where" ] \
        && die "that pass says it ran in the tree under review. A reviewer running against the live tree while it is being edited reports results about neither, so this is refused rather than recorded. Run it in a separate worktree at this commit."
      die "could not write the verdict"
    fi
    printf 'recorded: %s by %s, for this tree only\n' "$verdict" "$by"
    [ "$verdict" = "pass" ] \
      && printf '\nThis clears the reviewed channel and nothing else. Any other escape\nstands, and the verdict dies the moment the tree changes.\n'
    return 0
  fi

  local rec; rec="$(felix_review_verdict "$FELIX_HOME_DIR" "$proj" "$tid")"
  if [ -z "$rec" ]; then
    printf 'no verdict for this tree\n\n'
    printf 'A reviewed surface is one no test can judge, so nothing here can tell\n'
    printf 'you whether it is fine. Dispatch a reviewer that runs the claim in a\n'
    printf 'separate worktree at this commit, then record what it found:\n\n'
    printf '  felix review --pass  --by <reviewer> --note <what it ran>\n'
    printf '  felix review --block --by <reviewer> --note <what it found>\n'
    return 0
  fi
  printf 'verdict:  %s\n' "$(printf '%s' "$rec" | cut -f2)"
  printf 'by:       %s\n' "$(printf '%s' "$rec" | cut -f4)"
  printf 'when:     %s\n' "$(printf '%s' "$rec" | cut -f3)"
  printf 'note:     %s\n' "$(printf '%s' "$rec" | cut -f5)"
  printf '\nFelix records the claim and who made it. It cannot check that the\nreviewer was independent, ran in an isolated worktree, or executed\nanything — that is a property of how it was dispatched, and no receipt\ncan establish it.\n'
}

cmd_autonomy() {
  resolve_or_die; local proj="$PROJ" allow="" revoke="" a
  while [ $# -gt 0 ]; do
    case "$1" in
      --allow)  need_value "$@"; allow="$2"; shift 2 ;;
      --revoke) need_value "$@"; revoke="$2"; shift 2 ;;
      *) shift ;;
    esac
  done

  if [ -n "$revoke" ]; then
    if [ -f "$proj/autonomy" ]; then
      grep -vxF "$revoke" "$proj/autonomy" > "$proj/autonomy.new" 2>/dev/null \
        && mv -f "$proj/autonomy.new" "$proj/autonomy"
    fi
    printf 'revoked: %s\n' "$revoke"
  fi

  if [ -n "$allow" ]; then
    case "$allow" in
      tidy) ;;
      *) die "unknown capability: $allow. The only one is 'tidy'." ;;
    esac
    if felix_autonomy_allows "$proj" "$allow"; then
      printf 'already allowed: %s\n' "$allow"
    else
      [ -f "$proj/autonomy" ] || printf '# What Felix may do here unattended.\n' > "$proj/autonomy"
      printf '%s\n' "$allow" >> "$proj/autonomy"
      printf 'allowed: %s\n' "$allow"
    fi
  fi

  printf '\nautonomy for %s\n\n' "$(basename "$proj")"
  if felix_autonomy_allows "$proj" tidy; then
    printf '  [x] tidy    remove a lookalike script when Felix already holds that file\n'
  else
    printf '  [ ] tidy    remove a lookalike script when Felix already holds that file\n'
  fi
  printf '\nNothing is granted by default, and Felix never writes this file for a\n'
  printf 'project: a permission a system grants itself is not a permission.\n'
  printf '\nTidy removes a file only when every one of these holds: this project\n'
  printf 'opted in, Felix holds a file of that exact name, git does not track it,\n'
  printf 'it is not the declared gate, and a backup was written and confirmed\n'
  printf 'readable first. A tracked file is part of what the repository says it\n'
  printf 'contains, and removing one is a change to the project rather than the\n'
  printf 'removal of a stray.\n'
  printf '\n  felix autonomy --allow tidy      grant it\n'
  printf '  felix autonomy --revoke tidy     take it back\n'
}

cmd_coverage() {
  local tpl="$SCRIPT_DIR/templates" hooks="$SCRIPT_DIR/../hooks/hooks.json"
  local state event detail bad=0

  printf 'lifecycle coverage\n\n'
  while IFS=$'\t' read -r state event detail; do
    [ -n "${event:-}" ] || continue
    case "$state" in
      ok) printf '  [x] %-18s %s\n' "$event" "$detail" ;;
      *)  printf '  [!] %-18s %s\n' "$event" "$detail"; bad=$((bad+1)) ;;
    esac
  done <<EOF
$(felix_coverage_check "$tpl" "$hooks")
EOF

  local un; un="$(felix_coverage_unconsidered "$tpl" | tr '\n' ' ')"
  if [ -n "${un% }" ]; then
    printf '\n  [ ] %s\n' "${un% }"
    printf '      offered by the platform, and this table has no opinion on it\n'
    bad=$((bad+1))
  fi

  if [ "$bad" -eq 0 ]; then
    printf '\nEvery moment has a stance, and the wiring matches it.\n'
  else
    printf '\n%s moment(s) need a decision.\n' "$bad"
  fi

  # Said whether or not anything is wrong. A decline resting on judgement is not
  # a fault, but the share of them is the one number that says how much of this
  # table is taking itself on trust.
  local unchecked; unchecked="$(felix_coverage_unchecked "$tpl")"
  if [ "${unchecked:-0}" -gt 0 ]; then
    printf '\n%s decline(s) rest on judgement, with no literal a check can read.\n' "$unchecked"
  fi

  printf '\nThis checks that every moment was considered, never that what runs at\n'
  printf 'one is any good. A hook doing the wrong thing passes here and should:\n'
  printf 'judging that is not mechanical, and a report implying otherwise would\n'
  printf 'be worse than no report. Two gaps were found by a person noticing, and\n'
  printf 'the point of this table is that the third one fails instead.\n'
}

cmd_shape() {
  resolve_or_die
  local plan="${1:-}"
  [ -n "$plan" ] || die "usage: felix shape <plan.md>"
  [ -f "$plan" ] || die "no such plan: $plan"

  local groups; groups="$(felix_shape_groups "$plan")"
  if [ -z "$groups" ]; then
    printf 'No task declares any file in %s.\n\n' "$plan"
    printf 'Shape is computed from the files each task creates, modifies and\n'
    printf 'tests. Without those, nothing here can be judged, and guessing at it\n'
    printf 'would be the taste this command exists to replace.\n'
    return 0
  fi

  local coupled=0 alone=0 g n
  printf 'shape of %s\n\n' "$plan"
  while IFS= read -r g; do
    [ -n "$g" ] || continue
    n="$(printf '%s' "$g" | tr ',' '\n' | grep -c .)"
    if [ "$n" -gt 1 ]; then
      printf '  one context   tasks %-18s share files\n' "$g"
      coupled=$((coupled+1))
    else
      printf '  separable     task  %-18s shares nothing\n' "$g"
      alone=$((alone+1))
    fi
  done <<EOF
$groups
EOF

  printf '\n%s group(s) that must not be split, %s that may run apart.\n' "$coupled" "$alone"
  printf '\nThe first half binds. Two tasks writing one file cannot be worked in\n'
  printf 'parallel: one overwrites the other, or they invent conflicting\n'
  printf 'assumptions about a file neither owns.\n'
  printf '\nThe second half does not. Disjoint files are necessary for fanning out\n'
  printf 'and never sufficient — a caller and the signature it consumes share no\n'
  printf 'file at all. Read the interfaces before trusting a "separable".\n'
}

cmd_ledger() {
  resolve_or_die; local proj="$PROJ" name sessions calls named n=0
  local rows; rows="$(_felix_ledger_rows "$(felix_mem_dir "$proj")")"

  if [ -z "$rows" ]; then
    printf 'Nothing recorded yet for %s.\n\n' "$(basename "$proj")"
    printf 'The ledger is written by hooks, and hooks bind when a session starts,\n'
    printf 'so a session running when they were installed records nothing. It fills\n'
    printf 'from the next session onwards.\n'
    return 0
  fi

  printf 'ledger for %s, %s session(s)\n\n' "$(basename "$proj")" \
    "$(printf '%s\n' "$rows" | cut -f1 | LC_ALL=C sort -u | awk 'NF { n++ } END { print n + 0 }')"
  printf '  %-34s %-10s %-9s %s\n' CAPABILITY SESSIONS NAMED REACHED
  while IFS=$'\t' read -r name sessions calls named; do
    [ -n "${name:-}" ] || continue
    case "${named:--1}" in -1) named="?" ;; esac
    printf '  %-34s %-10s %-9s %s\n' "$name" "$sessions" "$named" "$calls"
    n=$((n+1))
  done <<EOF
$(felix_ledger_summary "$proj")
EOF
  [ "$n" -eq 0 ] && printf '  nothing yet\n'

  local retire; retire="$(felix_ledger_retire "$proj")"
  if [ -n "$retire" ]; then
    printf '\npointed at and never reached for, across %s or more sessions\n\n' "$FELIX_LEDGER_MIN"
    printf '%s\n' "$retire" | while IFS=$'\t' read -r name sessions named; do
      [ -n "${name:-}" ] || continue
      printf '  %-34s %s sessions, named %s times, 0 invocations\n' "$name" "$sessions" "$named"
    done
    printf '\nThat is the one signal here worth acting on. Remove the row from\n'
    printf '%s/stack.tsv and any play that names it.\n' "$proj"
  fi

  local unrouted; unrouted="$(felix_ledger_unrouted "$proj")"
  if [ -n "$unrouted" ]; then
    printf '\nmounted, and no route pointed at it in any recorded session\n\n'
    printf '%s\n' "$unrouted" | while IFS=$'\t' read -r name sessions; do
      [ -n "${name:-}" ] || continue
      printf '  %-34s %s sessions, never pointed at\n' "$name" "$sessions"
    done
    printf '\nA finding about %s/routes.tsv, not about these capabilities. A route\n' "$proj"
    printf 'may well name them — felix toolbox reads the table and will say so —\n'
    printf 'but its keywords have not matched real work yet. Their zero measures\n'
    printf 'what Felix suggests, not what they are worth, so retiring on it would\n'
    printf 'conclude they deserved to be ignored because they were ignored.\n'
    printf 'Weak while few sessions are recorded: a route that has not fired yet\n'
    printf 'looks exactly like one that never will.\n'
  fi

  printf '\nOnly retiring is ever proposed, and only for what Felix pointed at.\n'
  printf 'Loading a capability is what causes it to be used, so a high count\n'
  printf 'cannot show anything earned its place.\n'
  printf '\nTwo things this still cannot see, stated because a report that implies\n'
  printf 'otherwise is worse than none. A capability whose value is keeping a\n'
  printf 'session off a wrong path is never invoked when it works, so counting\n'
  printf 'calls punishes prevention and nothing here observes that. And a gate\n'
  printf 'verdict is one bit for a session holding dozens of decisions, so none of\n'
  printf 'this says which capability earned it, or whether the work was any good.\n'
}

cmd_toolbox() {
  resolve_or_die; local proj="$PROJ" wire=0 all=0 a tpl="$SCRIPT_DIR/templates"
  for a in "$@"; do case "$a" in --route) wire=1 ;; --all) all=1 ;; esac; done

  local rules; rules="$(_felix_discover_rules "$tpl" "$proj")"
  local n_routed=0 n_wired=0 n_orphan=0 n_nocap=0

  printf 'toolbox for %s\n\n' "$(basename "$proj")"
  printf '  %-26s %-8s %-12s %s\n' NAME RISK CAPABILITY REACHABLE

  while IFS=$'\t' read -r kind name; do
    [ "${kind:-}" = "plugin" ] || continue
    [ -n "${name:-}" ] || continue

    local dir risk cap routes reach
    dir="$(felix_toolbox_path "$name")" || dir=""
    risk="-"
    # Bundled plugins are real, reachable, and have no directory to read. That
    # is a normal answer: unknown risk, not a missing plugin.
    if [ -n "$dir" ]; then
      risk="$(felix_discover_risk "$(felix_discover_inspect "$dir")")"
    fi
    cap="$(felix_toolbox_capability "$name" "$rules" "$dir")"

    local show=1
    if felix_toolbox_routed "$proj" "$name"; then
      reach="a route names it"; n_routed=$((n_routed+1))
    elif [ -z "$cap" ]; then
      # Not routed and matching nothing this project declares. Counted, never
      # listed: it is a fact about the machine, not about this project.
      reach="no declared capability looks like it"; n_nocap=$((n_nocap+1)); show=0
    else
      routes="$(felix_toolbox_route_for "$proj" "$cap" | head -1)"
      if [ -z "$routes" ]; then
        reach="capability '$cap' is in no profile"; n_orphan=$((n_orphan+1))
      elif [ "$wire" -eq 1 ] && [ "$risk" != "high" ]; then
        # Appended to the play, never rewritten: the play is ordered, earlier
        # entries are named first, and reordering somebody's table to add to it
        # would change what gets reached for before this ever ran.
        felix_route_append_play "$proj" "$routes" "$name" \
          && { reach="wired into '$routes'"; n_wired=$((n_wired+1)); } \
          || reach="could not write routes.tsv"
      else
        reach="could go in '$routes'"; n_orphan=$((n_orphan+1))
      fi
    fi
    # A plugin matching no capability this project declares is not a problem to
    # solve, it is a machine that has other projects on it. Counted, not listed:
    # twenty-six rows saying "nothing to do here" is how a report stops being
    # read, and then the rows that did matter go unread with them. Anything a
    # route names is always shown, capability match or not, or the listing and
    # the count below it disagree.
    if [ "$show" -eq 1 ] || [ "$all" -eq 1 ]; then
      printf '  %-26s %-8s %-12s %s\n' "$name" "$risk" "${cap:--}" "$reach"
    fi
  done <<EOF
$(felix_ready_inventory | sort -u)
EOF

  printf '\n%s reachable, %s wired now, %s could be.\n' \
    "$n_routed" "$n_wired" "$n_orphan"
  if [ "$n_nocap" -gt 0 ] && [ "$all" -eq 0 ]; then
    printf '%s installed here match no capability %s declares, and are not listed.\n' \
      "$n_nocap" "$(basename "$proj")"
    printf 'felix toolbox --all     shows them\n'
  fi
  if [ "$wire" -eq 0 ] && [ "$n_orphan" -gt 0 ]; then
    printf '\nfelix toolbox --route   wires the ones that have somewhere to go\n'
  fi
  printf '\nA plugin no route names is never reached for and costs context in every\n'
  printf 'session regardless. High risk is never wired: it ships hooks, a floating\n'
  printf 'version, or an interpolated secret, and a person decides those.\n'
}

cmd_discover() {
  resolve_or_die; local proj="$PROJ" inspect=0 quiet=0 adopt=0 a tpl="$SCRIPT_DIR/templates"
  for a in "$@"; do
    case "$a" in
      --inspect) inspect=1 ;;
      --quiet)   quiet=1 ;;
      --adopt)   adopt=1 ;;
      --yes)     die "there is no --yes. felix discover --adopt declares and installs what it read and judged low risk, and nothing else." ;;
    esac
  done
  command -v claude >/dev/null 2>&1 || die "felix discover needs the claude CLI to see the marketplaces"

  # Acting on what has already been read. The candidate was fetched at its
  # pinned sha, its contents were read, and a tier was scored from what it
  # actually ships; printing a shopping list after all that was the governance
  # charter talking. Low only, and no flag from any caller touches high.
  if [ "$adopt" -eq 1 ]; then
    local plan; plan="$(felix_discover_adopt "$proj" "$FELIX_HOME_DIR")"
    if [ -z "$plan" ]; then
      printf 'Nothing discovered yet for %s.\n\n' "$(basename "$proj")"
      printf 'Discovery runs on a cadence rather than in front of a prompt, so the\n'
      printf 'cache may simply be empty. felix discover --inspect fills it now.\n'
      return 0
    fi
    local n_dec=0 n_ref=0 kind
    printf 'adopting for %s\n\n' "$(basename "$proj")"
    while IFS=$'\t' read -r act name cap risk; do
      [ -n "${act:-}" ] || continue
      case "$act" in
        declare)
          # skill, plugin or mcp is not knowable from the catalogue listing, and
          # plugin is what a marketplace entry is. A wrong kind here would make
          # felix stack apply call the wrong installer, so it is stated rather
          # than guessed at install time.
          kind=plugin
          printf '%s\t%s\t-\t%s\t%s\n' "$kind" "$name" "$risk" "$cap" >> "$proj/stack.tsv"
          if felix_stack_install "$kind" "$name" "-"; then
            printf '  installed  %-24s %-10s %s\n' "$name" "$risk" "$cap"
          else
            printf '  declared   %-24s %-10s %s (install failed; felix stack apply --yes retries)\n' \
              "$name" "$risk" "$cap"
          fi
          n_dec=$((n_dec+1)) ;;
        refuse)
          printf '  refused    %-24s %-10s a person decides this one\n' "$name" "$risk"
          n_ref=$((n_ref+1)) ;;
      esac
    done <<EOF
$plan
EOF
    printf '\n%s adopted, %s refused.\n' "$n_dec" "$n_ref"
    if [ "$n_ref" -gt 0 ]; then
      printf '\nMedium means it ships an MCP server, which usually needs a credential\n'
      printf 'only you can supply. High means hooks, a floating version, or an\n'
      printf 'interpolated secret. No flag installs those.\n'
    fi
    [ "$n_dec" -gt 0 ] && printf '\nDeclared rows were appended to %s/stack.tsv. Revert by deleting them.\n' "$proj"
    return 0
  fi

  local cands; cands="$(felix_discover_candidates "$proj" "$tpl")"
  if [ -z "$cands" ]; then
    printf 'Nothing in the marketplaces matches what %s declares.\n' "$(basename "$proj")"
    printf '\nThat is a statement about the catalogue and this project, not about\nwhat exists. Declaring another capability widens the search.\n'
    return 0
  fi

  if [ "$quiet" -eq 1 ]; then
    # name <TAB> capability <TAB> tier, for the cache. No prose, no headings:
    # this is read by a machine and diffed against what was already reported.
    # Global, and the trap guards against unset. A trap body is evaluated when
    # it fires, by which time a `local` is gone: this exact mistake was made
    # and fixed in this file already, then made again here. Second occurrence.
    _FELIX_DISCOVER_SCRATCH=""
    trap 'rm -rf "${_FELIX_DISCOVER_SCRATCH:-}" 2>/dev/null' EXIT INT TERM
    _FELIX_DISCOVER_SCRATCH="$(mktemp -d)" || return 0
    local scratchq="$_FELIX_DISCOVER_SCRATCH"
    printf '%s\n' "$cands" | while IFS=$'\t' read -r score cap name desc; do
      [ -n "${name:-}" ] || continue
      local src url sha sub facts tier
      src="$(felix_discover_source "$name")" || src=""
      url="$(printf '%s' "$src" | cut -f1)"
      sha="$(printf '%s' "$src" | cut -f2)"
      sub="$(printf '%s' "$src" | cut -f3)"
      tier="unknown"
      if [ -n "$url" ] && felix_discover_fetch "$url" "$sha" "$scratchq/$name"; then
        facts="$(felix_discover_inspect "$scratchq/$name" "$sub")"
        tier="$(felix_discover_risk "$facts")"
        # Re-scored against what the plugin says about itself, now that a copy
        # is on disk. The catalogue blurb is written to be chosen from; the
        # manifest is written to describe, and scoring the blurb is how a
        # tracing plugin and an inference provider were both filed under the
        # capability of whichever project happened to be looking.
        local own; own="$(felix_plugin_description "$scratchq/$name/${sub:-.}")"
        if [ -n "$own" ]; then
          local rehit; rehit="$(felix_capability_match "$name" "$own" \
            "$(_felix_discover_rules "$tpl" "$proj")")"
          if [ "$(printf '%s' "$rehit" | cut -f1)" -ge "${FELIX_DISCOVER_MIN:-3}" ]; then
            cap="$(printf '%s' "$rehit" | cut -f2)"
          else
            cap="-"
          fi
        fi
        rm -rf "$scratchq/$name"
      fi
      printf '%s\t%s\t%s\n' "$name" "$cap" "$tier"
    done
    return 0
  fi

  printf 'candidates for %s\n\n' "$(basename "$proj")"
  printf '%s\n' "$cands" | while IFS=$'\t' read -r score cap name desc; do
    [ -n "${name:-}" ] || continue
    printf '  %-26s %-14s %s\n' "$name" "$cap" "$(printf '%s' "$desc" | cut -c1-64)"
  done

  if [ "$inspect" -ne 1 ]; then
    printf '\nThat is the catalogue talking. It says nothing about what any of them\n'
    printf 'actually ship, and the listing carries no hooks or servers to check.\n\n'
    printf 'read the source before trusting any of it:  felix discover --inspect\n'
    return 0
  fi

  printf '\nfetching each at its pinned commit and reading it. nothing is executed.\n\n'
  # Deleted whatever happens, including on interrupt: a half-fetched plugin
  # left on disk is exactly the kind of thing someone later runs by accident.
  #
  # The path is global and the trap is written defensively. A trap body is
  # evaluated when it fires, not when it is set, and a `local` is long gone by
  # then — so referring to one made the cleanup itself die on an unbound
  # variable, leaving behind precisely what it existed to remove.
  _FELIX_DISCOVER_SCRATCH=""
  trap 'rm -rf "${_FELIX_DISCOVER_SCRATCH:-}" 2>/dev/null' EXIT INT TERM
  _FELIX_DISCOVER_SCRATCH="$(mktemp -d)" || die "cannot create a scratch directory"
  local scratch="$_FELIX_DISCOVER_SCRATCH"

  printf '%s\n' "$cands" | while IFS=$'\t' read -r score cap name desc; do
    [ -n "${name:-}" ] || continue
    local src url sha sub facts risk why
    src="$(felix_discover_source "$name")" || src=""
    url="$(printf '%s' "$src" | cut -f1)"
    sha="$(printf '%s' "$src" | cut -f2)"
    sub="$(printf '%s' "$src" | cut -f3)"
    if [ -z "$url" ]; then
      printf '  %-26s %-8s could not resolve a source to read\n' "$name" "unknown"
      continue
    fi
    if ! felix_discover_fetch "$url" "$sha" "$scratch/$name"; then
      printf '  %-26s %-8s fetch failed, skipped\n' "$name" "unknown"
      continue
    fi
    facts="$(felix_discover_inspect "$scratch/$name" "$sub")"
    risk="$(felix_discover_risk "$facts")"
    why="$(felix_discover_why "$facts")"
    printf '  %-26s %-8s %s\n' "$name" "$risk" "${why:-skills only, nothing that runs on its own}"
    [ -z "$sha" ] && printf '  %-26s %-8s (no pinned sha: what you install may differ from this)\n' "" ""
    rm -rf "$scratch/$name"
  done

  printf '\nNothing was installed and nothing was written. To act on this:\n\n'
  printf '  felix discover --adopt    declares and installs the low-risk ones\n\n'
  printf 'A high tier is not an accusation. It means the thing runs code on your\n'
  printf 'machine, and that this check reads files rather than behaviour: a plugin\n'
  printf 'that passes every line above can still do as it likes once it runs.\n'
}

cmd_ready() {
  resolve_or_die; local proj="$PROJ" fix=0 a
  for a in "$@"; do [ "$a" = "--fix" ] && fix=1; done
  [ -f "$proj/routes.tsv" ] || die "project $(basename "$proj") declares no routes.tsv"

  local rows; rows="$(felix_ready_report "$proj")"
  if [ -z "$rows" ]; then
    printf 'No route in %s names a tool. Nothing to check.\n' "$(basename "$proj")"
    return 0
  fi

  printf 'tools %s could reach for\n\n' "$(basename "$proj")"
  printf '%s\n' "$rows" | while IFS=$'\t' read -r st name detail; do
    [ -n "${st:-}" ] || continue
    case "$st" in
      usable)     printf '  [x] %-34s %s\n' "$name" "$detail" ;;
      disabled)   printf '  [!] %-34s %s\n' "$name" "$detail" ;;
      absent)     printf '  [ ] %-34s %s\n' "$name" "$detail" ;;
      undeclared) printf '  [?] %-34s %s\n' "$name" "$detail" ;;
      unknown)    printf '  [-] %-34s %s\n' "$name" "$detail" ;;
    esac
  done

  # What exists here that no route reaches for. A table naming one plugin five
  # times while thirty others sit idle is a habit, not a router.
  local unused n_unused
  unused="$(felix_ready_unused "$proj")"
  n_unused="$(printf '%s\n' "$unused" | grep -c . || true)"
  if [ "${n_unused:-0}" -gt 0 ]; then
    printf '\ninstalled here, never reached for by any route (%s)\n\n' "$n_unused"
    printf '%s\n' "$unused" | head -24 | while IFS=$'\t' read -r k nm; do
      [ -n "${k:-}" ] || continue
      printf '  %-8s %s\n' "$k" "$nm"
    done
    [ "$n_unused" -gt 24 ] && printf '  ... and %s more\n' "$((n_unused - 24))"
    printf '\nNot a problem, a menu. Add a keyword to %s/routes.tsv for any of\n' "$proj"
    printf 'these you would want reached for automatically.\n'
  fi

  local bad unknown
  bad="$(printf '%s\n' "$rows" | grep -cE '^(disabled|absent)' || true)"
  unknown="$(printf '%s\n' "$rows" | grep -cE '^(unknown|undeclared)' || true)"
  printf '\n'
  # Reporting "everything is fine" when nothing could be checked is the failure
  # this whole project keeps finding: a check that proves nothing must not read
  # like a check that passed.
  if [ "${unknown:-0}" -gt 0 ]; then
    printf '%s of these could not be checked, so this is not a clean bill.\n' "$unknown"
  fi
  if [ "${bad:-0}" -eq 0 ] && [ "${unknown:-0}" -eq 0 ]; then
    printf 'Everything a route can name is installed and switched on.\n'
    return 0
  fi
  if [ "${bad:-0}" -eq 0 ]; then return 1; fi

  printf '%s of these cannot be used in a session.\n\n' "$bad"
  printf 'This matters before a session starts, not during one. A skill can be\n'
  printf 'invoked mid-turn, but a plugin that is switched off cannot be switched\n'
  printf 'on without a restart, so the router would name it and nothing would\n'
  printf 'happen. A disabled plugin is the worst case: it is installed, so every\n'
  printf 'check by eye passes, and it contributes nothing.\n\n'

  if [ "$fix" -ne 1 ]; then
    printf 'fix what is safe to fix with: felix ready --fix\n'
    return 1
  fi

  command -v claude >/dev/null 2>&1 || die "felix ready --fix needs the claude CLI"
  printf 'fixing\n'
  local st name detail owner risk
  while IFS=$'\t' read -r st name detail; do
    [ -n "${st:-}" ] || continue
    case "$name" in *:*) owner="${name%%:*}" ;; *) owner="$name" ;; esac
    risk="$(grep -E "	($name|$owner)(@[^	]*)?	" "$proj/stack.tsv" 2>/dev/null | head -1 | cut -f4)"
    case "$st" in
      disabled)
        if claude plugin enable "$detail" >/dev/null 2>&1 || claude plugin enable "$owner" >/dev/null 2>&1; then
          printf '  enabled    %s\n' "$name"
        else
          printf '  FAILED     %s (enable by hand)\n' "$name"
        fi ;;
      absent)
        # Same bound as felix stack apply, for the same reason: high risk means
        # the tool can reach production, move money, or hold a credential, and
        # no flag anywhere should mount one of those unattended.
        if _felix_risk_is_auto "${risk:-high}"; then
          if claude plugin install "$owner" --scope user >/dev/null 2>&1; then
            printf '  installed  %s\n' "$name"
          else
            printf '  FAILED     %s (install by hand)\n' "$name"
          fi
        else
          printf '  refused    %-24s risk: %s, a person installs this\n' "$name" "${risk:-high}"
        fi ;;
    esac
  done <<EOF
$(printf '%s\n' "$rows" | grep -E '^(disabled|absent)')
EOF
  printf '\nRe-run felix ready to confirm. Anything newly enabled applies to the\n'
  printf 'NEXT session, not this one.\n'
}

cmd_monitor() {
  local open=0 watch=0 every=5 a out tpl
  while [ $# -gt 0 ]; do
    case "$1" in
      --open)  open=1; shift ;;
      --watch) watch=1; shift ;;
      --every) need_value "$@"; every="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  tpl="$SCRIPT_DIR/templates/monitor.html"
  out="$FELIX_HOME_DIR/state/monitor.html"

  if ! felix_monitor_render "$tpl" "$FELIX_HOME_DIR" "$out"; then
    die "could not render the monitor (template: $tpl)"
  fi

  printf 'wrote %s\n\n' "$out"
  local n
  n="$(ls -d "$FELIX_HOME_DIR"/projects/*/ 2>/dev/null | wc -l | tr -d ' ')"
  printf '  %s project(s)\n' "$n"
  printf '  %s routing decision(s)\n' \
    "$(cat "$(felix_mem_root)"/*/routes.log 2>/dev/null | felix_count .)"
  printf '  %s gate verdict(s)\n' \
    "$(cat "$(felix_mem_root)"/*/verification.log 2>/dev/null | felix_count .)"

  if [ "$watch" -eq 1 ]; then
    if [ "$open" -eq 1 ]; then
      command -v open >/dev/null 2>&1 && open "$out" >/dev/null 2>&1 || true
    fi
    printf '\nwatching. re-rendering every %ss. press the live button on the page,\n' "$every"
    printf 'then leave this running. ctrl-c to stop.\n\n'
    while :; do
      sleep "$every"
      felix_monitor_render "$tpl" "$FELIX_HOME_DIR" "$out" >/dev/null 2>&1 || true
      printf '.'
    done
  fi

  printf '\nA snapshot, not a feed. Re-run this to refresh it, or:\n'
  printf '  felix monitor --watch --open\n'
  if [ "$open" -eq 1 ]; then
    command -v open >/dev/null 2>&1 && open "$out" && return 0
    command -v xdg-open >/dev/null 2>&1 && xdg-open "$out" && return 0
    printf 'no opener found; open the file by hand\n'
  else
    printf 'open it with: felix monitor --open\n'
  fi
}

cmd_profile() {
  resolve_or_die; local proj="$PROJ" want="${1:-}"
  [ -f "$proj/profiles.tsv" ] || die "project $(basename "$proj") declares no profiles"
  if [ -z "$want" ]; then
    printf 'profiles for %s:\n\n' "$(basename "$proj")"
    grep -vE '^\s*(#|$)' "$proj/profiles.tsv" | while IFS=$'\t' read -r n caps _; do
      printf '  %-12s %s\n' "$n" "$caps"
    done
    printf '\nfelix profile <name> shows the tools a profile activates.\n'
    return 0
  fi
  local caps
  caps="$(grep -vE '^\s*(#|$)' "$proj/profiles.tsv" | awk -F'\t' -v p="$want" '$1==p{print $2}')"
  [ -n "$caps" ] || die "no profile named $want"
  printf 'profile:      %s\ncapabilities: %s\n\nactivates:\n' "$want" "$caps"
  _felix_load_state
  _felix_stack_rows "$proj" | while IFS=$'\t' read -r kind name _ risk cap; do
    # A row belongs to this profile if the profile claims its capability, or if
    # the row is unconditional.
    case ",$caps,always," in *",$cap,"*) ;; *) continue ;; esac
    _felix_have "$kind" "$name" && st="mounted" || st="MISSING"
    printf '  %-10s %-46s %-8s %s\n' "$kind" "$name" "$risk" "$st"
  done
  printf '\nEverything else stays unmounted. Installed is not active.\n'
}

cmd_stack() {
  resolve_or_die; local proj="$PROJ" sub="${1:-plan}" yes=0
  shift || true
  for a in "$@"; do [ "$a" = "--yes" ] && yes=1; done
  [ -f "$proj/stack.tsv" ] || die "project $(basename "$proj") declares no stack.tsv"

  local plan; plan="$(felix_stack_plan "$proj")"
  printf '%-9s %-11s %s\n' ACTION KIND NAME
  printf '%s\n' "$plan" | while IFS=$'\t' read -r act kind name detail; do
    [ -n "${act:-}" ] || continue
    printf '%-9s %-11s %-46s %s\n' "$act" "$kind" "$name" "$detail"
  done

  local n_install n_blocked
  n_install="$(printf '%s\n' "$plan" | grep -c '^install' || true)"
  n_blocked="$(printf '%s\n' "$plan" | grep -c '^blocked' || true)"

  if [ "$sub" = "plan" ]; then
    printf '\n%s to install, %s blocked as high risk.\n' "$n_install" "$n_blocked"
    [ "$n_install" -gt 0 ] && printf 'apply with: felix stack apply --yes\n'
    return 0
  fi

  [ "$sub" = "apply" ] || die "usage: felix stack [plan|apply] [--yes]"
  if [ "$yes" -ne 1 ]; then
    printf '\nThis was a plan. Nothing changed.\n'
    printf 'Re-run with --yes to install the %s item(s) above.\n' "$n_install"
    return 0
  fi

  printf '\napplying %s item(s)\n' "$n_install"
  local failed=0
  while IFS=$'\t' read -r act kind name detail; do
    [ "$act" = "install" ] || continue
    local source
    source="$(_felix_stack_rows "$proj" | awk -F'\t' -v n="$name" '$2==n{print $3}')"
    if felix_stack_install "$kind" "$name" "$source"; then
      printf '  installed  %s %s\n' "$kind" "$name"
    else
      printf '  FAILED     %s %s\n' "$kind" "$name"
      failed=$((failed+1))
    fi
  done <<EOF
$plan
EOF
  if [ "$n_blocked" -gt 0 ]; then
    printf '\n%s high-risk item(s) were not touched. No flag installs those.\n' "$n_blocked"
  fi
  [ "$failed" -eq 0 ] || { printf '\n%s failed.\n' "$failed"; return 1; }
}



cmd_bootstrap() {
  resolve_or_die; local proj="$PROJ" yes=0 a
  for a in "$@"; do [ "$a" = "--yes" ] && yes=1; done
  local root slug eco felix_repo branch
  root="$(felix_repo_root "$PWD")"
  slug="$(felix_repo_slug "$root")"
  eco="$(felix_guess_ecosystem "$root")"
  branch="$(git -C "$root" symbolic-ref --short HEAD 2>/dev/null || echo main)"
  # The Felix checkout, not the directory this script happens to sit in. #65:
  # `felix_repo_slug "$FELIX_ROOT"` asked git for a remote inside the running
  # engine, which from the deployed CLI is the plugin cache — no remote, so this
  # printed "none, CI cannot fetch the harness" about an engine whose remote
  # exists. Worse on a machine whose home directory is itself a git repository
  # with an origin: that slug would be returned instead and interpolated into
  # the generated workflow's `repository:`, beside a deploy key.
  #
  # The correct pattern was already two lines above, in this same function:
  # resolve the tree first, then slug the tree.
  local esrc; esrc="$(felix_engine_source "$FELIX_ROOT" "$FELIX_HOME_DIR")" || esrc=""
  felix_repo=""
  [ -n "$esrc" ] && felix_repo="$(felix_repo_slug "$esrc")"

  printf 'repo:        %s\n' "${slug:-no github remote}"
  printf 'ecosystem:   %s\n' "$eco"
  printf 'felix repo:  %s\n\n' "${felix_repo:-none, CI cannot fetch the harness}"

  local todo=0
  _bs() {  # name, already-satisfied, description
    if [ "$2" = "yes" ]; then printf '  [x] %-12s %s\n' "$1" "$3"
    else printf '  [ ] %-12s %s\n' "$1" "$3"; todo=$((todo+1)); fi
  }
  _felix_bs_have_workflow "$root" && w=yes || w=no
  _bs ci-workflow "$w" ".github/workflows/gate.yml calling felix gate"
  if [ -n "$slug" ]; then
    _felix_bs_have_labels "$slug" && l=yes || l=no
    _bs labels "$l" "escalation and risk labels the repair loop applies"
    _felix_bs_have_protection "$slug" "$branch" && p=yes || p=no
    _bs protection "$p" "require the gate on $branch, block force pushes"
  else
    printf '  [-] %-12s no github remote; labels and protection skipped\n' "github"
  fi
  _felix_bs_have_perms "$root" && m=yes || m=no
  _bs permissions "$m" ".claude/settings.json deny and ask policy"

  if [ "$todo" -eq 0 ]; then printf '\nBaseline already in place.\n'; return 0; fi
  if [ "$yes" -ne 1 ]; then
    printf '\n%s step(s) outstanding. Nothing changed.\n' "$todo"
    printf 'apply with: felix bootstrap --yes\n'
    return 0
  fi

  printf '\napplying\n'
  if ! _felix_bs_have_workflow "$root"; then
    if [ -z "$felix_repo" ]; then
      printf '  skipped    ci-workflow (Felix has no remote for CI to fetch)\n'
    else
      mkdir -p "$root/.github/workflows"
      felix_bs_render_workflow "$eco" "$felix_repo" > "$root/.github/workflows/gate.yml"
      printf '  wrote      .github/workflows/gate.yml (review, then commit it)\n'
    fi
  fi
  if [ -n "$slug" ] && ! _felix_bs_have_labels "$slug"; then
    gh label create needs-founder --repo "$slug" --color D93F0B --description "Repair loop hit its ceiling; a human must diagnose" >/dev/null 2>&1
    gh label create needs-architecture --repo "$slug" --color 5319E7 --description "Failure is a design problem, not a patch" >/dev/null 2>&1
    gh label create risk-green --repo "$slug" --color 0E8A16 --description "Reversible" >/dev/null 2>&1
    gh label create risk-yellow --repo "$slug" --color FBCA04 --description "Human reviews" >/dev/null 2>&1
    gh label create risk-red --repo "$slug" --color B60205 --description "Approval required" >/dev/null 2>&1
    printf '  created    5 labels\n'
  fi
  if [ -n "$slug" ] && ! _felix_bs_have_protection "$slug" "$branch"; then
    # enforce_admins stays false on purpose: locking the founder out of their own
    # repository during an incident is not a safety property.
    if printf '{"required_status_checks":{"strict":false,"contexts":["gate"]},"enforce_admins":false,"required_pull_request_reviews":null,"restrictions":null,"allow_force_pushes":false,"allow_deletions":false}' \
       | gh api -X PUT "repos/$slug/branches/$branch/protection" --input - >/dev/null 2>&1; then
      printf '  protected  %s requires the gate\n' "$branch"
    else
      printf '  FAILED     branch protection (admin rights needed on %s)\n' "$slug"
    fi
  fi
  if ! _felix_bs_have_perms "$root"; then
    mkdir -p "$root/.claude"
    if [ -f "$root/.claude/settings.json" ]; then
      printf '  skipped    permissions (settings.json exists; merge by hand rather than clobber it)\n'
    else
      felix_bs_render_perms > "$root/.claude/settings.json"
      printf '  wrote      .claude/settings.json\n'
    fi
  fi
  printf '\nRe-run felix bootstrap to confirm.\n'
}

cmd_setup() {
  resolve_or_die; local proj="$PROJ" want="${1:-}"
  [ -f "$proj/setup.tsv" ] || die "project $(basename "$proj") declares no setup steps"

  if [ -n "$want" ]; then
    felix_setup_runbook "$proj" "$want"; return $?
  fi

  local st; st="$(felix_setup_status "$proj")"
  local todo; todo="$(printf '%s\n' "$st" | grep -c '^todo' || true)"

  printf 'setup for %s\n\n' "$(basename "$proj")"
  printf '%s\n' "$st" | while IFS=$'\t' read -r s id title; do
    [ -n "${s:-}" ] || continue
    case "$s" in
      done)    printf '  [x] %-22s %s\n' "$id" "$title" ;;
      todo)    printf '  [ ] %-22s %s\n' "$id" "$title" ;;
      dormant) printf '  [-] %-22s %s (not needed yet)\n' "$id" "$title" ;;
    esac
  done

  if [ "$todo" -eq 0 ]; then
    printf '\nNothing outstanding.\n'
    return 0
  fi
  printf '\n%s step(s) need you. These are things an agent should not do:\n' "$todo"
  printf 'creating accounts, completing OAuth, handling live keys.\n\n'
  printf 'felix setup <id>   full instructions for one step\n'
}



cmd_receipt() {
  resolve_or_die; local proj="$PROJ" base="main"
  while [ $# -gt 0 ]; do
    case "$1" in
      --base) need_value "$@"; base="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  local root; root="$(felix_repo_root "$PWD")"
  felix_receipt "$proj" "$base" "$root" "$FELIX_HOME_DIR"
}

cmd_evidence() {
  resolve_or_die; local proj="$PROJ" base="main" strict=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --base) need_value "$@"; base="$2"; shift 2 ;;
      --strict) strict=1; shift ;;
      *) shift ;;
    esac
  done
  [ -f "$proj/evidence.tsv" ] || die "project $(basename "$proj") declares no evidence.tsv"
  local root results gaps
  root="$(felix_repo_root "$PWD")"
  results="$(felix_evidence_check "$proj" "$base" "$root")"
  [ -n "$results" ] || { printf 'No evidence rules declared.\n'; return 0; }

  printf 'base:  %s\n\n' "$base"

  # Checked before the rows are rendered, because the sentence at the bottom is
  # the one that gets read. "No evidence gaps" after a scan that never ran is
  # the same false all-clear #56 removed from felix merge, and leaving it here
  # would move it rather than fix it. Exits non-zero regardless of --strict: an
  # unanswerable question is not a passing report.
  if printf '%s\n' "$results" | grep -q '^unknown	'; then
    printf '%s\n' "$results" | while IFS=$'\t' read -r st name reason; do
      [ "${st:-}" = "unknown" ] || continue
      printf '  [?] %-14s %s\n' "$name" "$reason"
    done
    printf '\nNothing was compared, so nothing above is a finding about this change.\n'
    printf 'Check --base, or the default branch, which is not `main` everywhere.\n'
    printf 'This says nothing about what the change owes; that was never asked.\n'
    return 1
  fi

  printf '%s\n' "$results" | while IFS=$'\t' read -r st name reason; do
    [ -n "${st:-}" ] || continue
    case "$st" in
      met) printf '  [x] %-14s %s\n' "$name" "$reason" ;;
      gap) printf '  [!] %-14s %s\n' "$name" "$reason" ;;
      n/a) printf '  [-] %-14s %s\n' "$name" "$reason" ;;
    esac
  done

  gaps="$(printf '%s\n' "$results" | grep -c '^gap' || true)"
  printf '\n'
  if [ "$gaps" -eq 0 ]; then
    printf 'No evidence gaps.\n'
    return 0
  fi
  printf '%s gap(s). Each one is a change to behaviour with nothing proving it.\n' "$gaps"
  printf 'Add the test, or say in the pull request why it is not practical here.\n'
  [ "$strict" -eq 1 ] || return 0
  printf '\n--strict: failing.\n'
  return 1
}





cmd_unattended() {
  resolve_or_die; local proj="$PROJ"
  command -v gh >/dev/null 2>&1 || die "felix unattended needs the gh CLI"
  local repo; repo="$(felix_repo_slug "$(felix_repo_root "$PWD")")"
  [ -n "$repo" ] || die "no github remote"

  local st switch key dry dryfail streak need
  st="$(felix_unattended_state "$repo")"
  switch="$(printf '%s\n' "$st" | awk -F'\t' '$1=="switch"{print $2}')"
  key="$(printf '%s\n' "$st" | awk -F'\t' '$1=="key"{print $2}')"
  dry="$(printf '%s\n' "$st" | awk -F'\t' '$1=="dryruns"{print $2}')"
  dryfail="$(printf '%s\n' "$st" | awk -F'\t' '$1=="dryfails"{print $2}')"
  streak="$(felix_automerge_streak "$(felix_automerge_history "$repo")")"
  need="$FELIX_AUTOMERGE_REQUIRED"

  printf 'repo:  %s\n\n' "$repo"
  [ "${switch:-0}" -gt 0 ] && printf '  ON      the loop invokes a model on CI failure\n' \
                           || printf '  off     the guards run; nothing is invoked\n'
  [ "${key:-0}" -gt 0 ] && printf '  [x] %-26s %s\n' "api key" "present" \
                        || printf '  [ ] %-26s %s\n' "api key" "absent; nothing could run anyway"
  printf '  %s %-26s %s of %s\n' \
    "$([ "${streak:-0}" -ge "$need" ] && printf '[x]' || printf '[ ]')" \
    "green merges judged well" "$streak" "$need"
  printf '  %s %-26s %s run(s), %s errored\n' \
    "$([ "${dry:-0}" -gt 0 ] && [ "${dryfail:-0}" -eq 0 ] && printf '[x]' || printf '[ ]')" \
    "guards exercised" "${dry:-0}" "${dryfail:-0}"
  printf '  [x] %-26s %s per 24h\n' "budget ceiling" "$(felix_budget_limit "$proj")"
  printf '  [x] %-26s %s\n' "scope bound" "red paths refused before the log is read"

  printf '\n'
  if [ "${switch:-0}" -gt 0 ]; then
    printf 'Already on. Turn it off with:\n  gh variable delete FELIX_UNATTENDED --repo %s\n' "$repo"
    return 0
  fi

  printf 'Felix will not turn this on for you, and the reason is not caution.\n\n'
  printf 'Auto-merge can unlock itself because what it unlocks is bounded and its\n'
  printf 'worst case is a revert. This is not that. And the evidence that would\n'
  printf 'justify it cannot be gathered without spending it: every dry run stops\n'
  printf 'before the model is invoked, so they show the guards run and say nothing\n'
  printf 'about whether the guards hold. Nothing has tried to get past them yet.\n\n'
  printf 'The first real unattended repair wants someone watching, which means the\n'
  printf 'first one is not unattended. There is no way around that, only through.\n\n'
  printf '  gh variable set FELIX_UNATTENDED --body true --repo %s\n' "$repo"
}

cmd_budget() {
  resolve_or_die; local proj="$PROJ" record=0 why="unattended run"
  while [ $# -gt 0 ]; do
    case "$1" in
      --record) record=1; shift ;;
      --why) need_value "$@"; why="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  local limit used left
  limit="$(felix_budget_limit "$proj")"
  used="$(felix_budget_used "$proj")"
  left=$((limit - used))
  [ "$left" -lt 0 ] && left=0

  if [ "$record" -eq 1 ]; then
    if [ "$used" -ge "$limit" ]; then
      printf 'budget exhausted: %s of %s used in the last 24h\n' "$used" "$limit" >&2
      printf 'Refusing to start. A loop nobody is watching can repeat a mistake all\n' >&2
      printf 'night, and the ceiling worth having fails between runs, not during one.\n' >&2
      return 3
    fi
    felix_budget_record "$proj" "$why"
    printf 'recorded. %s of %s used in the last 24h\n' "$((used + 1))" "$limit"
    return 0
  fi

  printf 'limit:  %s unattended run(s) per 24h\nused:   %s\nleft:   %s\n' \
    "$limit" "$used" "$left"
  [ "$left" -gt 0 ] || { printf '\nExhausted. Nothing unattended starts until this ages out.\n'; return 3; }
}

cmd_automerge() {
  resolve_or_die; local proj="$PROJ" enable=0
  for a in "$@"; do [ "$a" = "--enable" ] && enable=1; done
  command -v gh >/dev/null 2>&1 || die "felix automerge needs the gh CLI"
  local repo; repo="$(felix_repo_slug "$(felix_repo_root "$PWD")")"
  [ -n "$repo" ] || die "no github remote"

  local history streak need
  history="$(felix_automerge_history "$repo")"
  streak="$(felix_automerge_streak "$history")"
  need="$FELIX_AUTOMERGE_REQUIRED"

  printf 'repo:    %s\nstreak:  %s of %s consecutive clean green merges\n\n' \
    "$repo" "$streak" "$need"

  if [ -z "$history" ]; then
    printf 'No green pull requests have merged yet.\n\n'
  else
    printf '%s\n' "$history" | head -8 | while IFS=$'\t' read -r num state title; do
      [ -n "${num:-}" ] || continue
      case "$state" in
        clean)   printf '  clean  #%-5s %s\n' "$num" "$title" ;;
        dirty)   printf '  CI RED #%-5s %s\n' "$num" "$title" ;;
        unknown) printf '  ?      #%-5s %s (CI history unavailable)\n' "$num" "$title" ;;
      esac
    done
    printf '\n'
  fi

  if [ "$streak" -lt "$need" ]; then
    printf 'Not yet earned.\n\n'
    printf 'A green classification claims no risky path was touched. CI failing on a\n'
    printf 'green pull request means that claim was wrong, and the rules deciding it\n'
    printf 'have never been tested against a real change. Merge %s more green one(s)\n' \
      "$((need - streak))"
    printf 'by hand and watch whether the tier ever surprises you. If one does, you\n'
    printf 'learned something about the rules for the price of one manual merge.\n'
    return 1
  fi

  printf 'Earned. %s consecutive green merges, none of which CI disagreed with.\n\n' "$streak"
  [ "$enable" -eq 1 ] || { printf 'enable with: felix automerge --enable\n'; return 0; }

  if gh repo edit "$repo" --enable-auto-merge >/dev/null 2>&1; then
    printf 'auto-merge enabled on %s.\n\n' "$repo"
    printf 'It still requires every check to pass. Green plus no evidence gap plus a\n'
    printf 'green gate is the bar; yellow and red are untouched and always will be.\n'
    printf 'A change editing risk.tsv is classified against both the inherited table\n'
    printf 'and its own, and the stricter wins, so a green row cannot green the diff\n'
    printf 'that adds it. That is enforced. Two things are not: evidence.tsv gets no\n'
    printf 'such treatment and is still read off the branch that changes it, and the\n'
    printf 'label this streak counts is applied by hand, never re-derived.\n'
  else
    printf 'could not enable auto-merge; admin rights needed on %s\n' "$repo" >&2
    return 1
  fi
}

cmd_scope() {
  resolve_or_die; local proj="$PROJ" base="" paths=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --base) need_value "$@"; base="$2"; shift 2 ;;
      -) paths="$(cat)"; shift ;;
      *) paths="$paths
$1"; shift ;;
    esac
  done
  [ -f "$proj/risk.tsv" ] || die "project $(basename "$proj") declares no risk.tsv"
  local root from_diff=0; root="$(felix_repo_root "$PWD")"
  if [ -z "$(printf '%s' "$paths" | tr -d '[:space:]')" ]; then
    from_diff=1
    base="${base:-main}"
    paths="$(felix_changed_paths "$root" "$base")"
  fi
  paths="$(printf '%s\n' "$paths" | grep -v '^$' | sort -u)"
  [ -n "$paths" ] || { printf 'No paths given and no changes found. Nothing to scope.\n'; return 0; }

  # From a diff, the full classifier — it reads content rules, and both shipped
  # tables carry them. felix_incident_severity takes paths, so it could only
  # ever apply path rules, and this gate said "in scope for unattended work"
  # about a diff that added a live credential to a documentation file.
  #
  # From bare paths there is no diff to read, so content rules cannot be applied
  # at all. That is stated rather than papered over: a tier computed from names
  # alone is not the same answer, and printing it as though it were is how a
  # gate gets trusted for something it never checked.
  local sev partial=0
  if [ "$from_diff" -eq 1 ]; then
    sev="$(felix_classify_tier "$(felix_classify_diff "$proj" "$base" "$root")")"
  else
    sev="$(felix_incident_severity "$proj" "$paths")"
    partial=1
  fi
  printf 'paths:\n'; printf '%s\n' "$paths" | sed 's|^|  |'
  printf '\nhighest tier: %s\n\n' "$sev"
  if [ "$partial" -eq 1 ]; then
    printf 'Path rules only. No diff was given, so no content rule could run and a\n'
    printf 'credential or destructive SQL in the changes would not be seen here.\n'
    printf 'Scope a branch instead to get the whole answer.\n\n'
  fi

  if [ "$sev" = "red" ]; then
    printf 'OUT OF SCOPE for unattended work.\n\n'
    printf 'A red path is implicated. The bound that matters is not how many times\n'
    printf 'an agent may try, it is what it may touch: three careful attempts at\n'
    printf 'the authorization model is not safer than one, it is three times the\n'
    printf 'exposure. A person decides here.\n'
    return 3
  fi
  printf 'In scope. Reversible enough for an unattended attempt, still subject to\n'
  printf 'the gate, the classifier and the evidence policy like any other change.\n'
}

cmd_classify() {
  resolve_or_die; local proj="$PROJ" base="main" apply=0 a
  while [ $# -gt 0 ]; do
    case "$1" in
      --base) need_value "$@"; base="$2"; shift 2 ;;
      --apply) apply=1; shift ;;
      *) shift ;;
    esac
  done
  [ -f "$proj/risk.tsv" ] || die "project $(basename "$proj") declares no risk.tsv"
  local root findings tier
  root="$(felix_repo_root "$PWD")"
  findings="$(felix_classify_diff "$proj" "$base" "$root")"

  if [ -z "$findings" ]; then
    printf 'No changes against %s. Nothing to classify.\n' "$base"
    return 0
  fi
  tier="$(felix_classify_tier "$findings")"

  # Before the tier line, because printing `tier:  unknown` beside a findings
  # table would read as a computed verdict on a real diff. There is no diff.
  if [ "$tier" = "unknown" ]; then
    printf 'base:  %s\ntier:  unknown\n\n' "$base"
    printf '%s\n' "$findings" | while IFS=$'\t' read -r t f r; do
      [ "${t:-}" = "unknown" ] || continue
      printf '  %-7s %-46s %s\n' "$t" "$f" "$r"
    done
    printf '\nNothing was compared. This is not a green change and not a risky one;\n'
    printf 'it is a base this repository cannot resolve. Check --base, or the\n'
    printf 'default branch, which is not `main` everywhere.\n'
    return 1
  fi

  printf 'base:  %s\ntier:  %s\n\n' "$base" "$tier"
  printf '%s\n' "$findings" | sort -r | while IFS=$'\t' read -r t f r; do
    [ -n "${t:-}" ] || continue
    printf '  %-7s %-46s %s\n' "$t" "$f" "$r"
  done

  printf '\n'
  case "$tier" in
    green)
      # Green means no risky path was touched. It does not mean the change was
      # proven. Auto-merging on tier alone would ship untested behaviour whenever
      # that behaviour happened to live somewhere unremarkable.
      local ev_gaps=0
      if [ -f "$proj/evidence.tsv" ]; then
        ev_gaps="$(felix_evidence_check "$proj" "$base" "$root" | grep -c '^gap' || true)"
      fi
      if [ "$ev_gaps" -eq 0 ]; then
        printf 'Reversible, and nothing is unproven. Eligible for auto-merge once\nevery required check passes.\n'
      else
        printf 'Reversible, but %s evidence gap(s). Not auto-merge eligible: a green\ntier means no risky path was touched, not that the change was proven.\nRun felix evidence.\n' "$ev_gaps"
      fi
      ;;
    yellow) printf 'Implement autonomously; a human merges. Nothing here is irreversible,\nbut something in it is not obviously safe.\n' ;;
    red)    printf 'Approval required before merge. Show a preview of the exact change and\nits reversal path; do not merge on a green gate alone.\n' ;;
  esac

  [ "$apply" -eq 1 ] || { printf '\nlabel the PR with: felix classify --apply\n'; return 0; }

  local slug; slug="$(felix_repo_slug "$root")"
  [ -n "$slug" ] || die "no github remote; cannot label"
  # Replace rather than accumulate: a stale green beside a new red reads as a
  # disagreement between two labels instead of a decision.
  gh pr edit --repo "$slug" \
     --remove-label risk-green --remove-label risk-yellow --remove-label risk-red \
     >/dev/null 2>&1 || true
  if gh pr edit --repo "$slug" --add-label "risk-$tier" >/dev/null 2>&1; then
    printf '\nlabelled risk-%s\n' "$tier"
  else
    printf '\ncould not label; is there an open PR for this branch?\n' >&2
    return 1
  fi
}



cmd_maintenance() {
  resolve_or_die; local proj="$PROJ" ran=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --ran) need_value "$@"; ran="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  [ -f "$proj/maintenance.tsv" ] || die "project $(basename "$proj") declares no maintenance routines"

  if [ -n "$ran" ]; then
    _felix_maint_rows "$proj" | cut -f1 | grep -qxF "$ran" \
      || die "no routine named $ran"
    felix_maint_record "$proj" "$ran"
    printf 'recorded a run of %s\n' "$ran"
    printf 'commit %s/maintenance.log so the cadence survives this machine.\n' "$proj"
    return 0
  fi

  local st due
  st="$(felix_maint_status "$proj")"
  due="$(printf '%s\n' "$st" | grep -c '^due' || true)"

  printf 'maintenance for %s\n\n' "$(basename "$proj")"
  printf '%s\n' "$st" | while IFS=$'\t' read -r s name age cadence desc; do
    [ -n "${s:-}" ] || continue
    case "$s" in
      due)     printf '  DUE     %-18s %-14s %s\n' "$name" "last: $age" "$desc" ;;
      ok)      printf '  ok      %-18s %-14s every %sd\n' "$name" "${age}d ago" "$cadence" ;;
      event)   printf '  event   %-18s %-14s %s\n' "$name" "on trigger" "$desc" ;;
      dormant) printf '  -       %-18s %-14s %s\n' "$name" "not yet" "$desc" ;;
    esac
  done

  if [ "$due" -eq 0 ]; then printf '\nNothing due.\n'; return 0; fi
  printf '\n%s routine(s) due.\n\n' "$due"
  printf 'Do them on one branch, not %s. A flood of autonomous maintenance pull\n' "$due"
  printf 'requests is not review, it is noise that trains people to rubber-stamp.\n'
  printf 'Keep security findings separate, because isolation is what makes those\n'
  printf 'shippable on their own.\n\n'
  printf 'record each with: felix maintenance --ran <name>\n'
}

cmd_incident() {
  resolve_or_die; local proj="$PROJ" src="-" create=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) need_value "$@"; src="$2"; shift 2 ;;
      --create) create=1; shift ;;
      *) shift ;;
    esac
  done
  local root text
  root="$(felix_repo_root "$PWD")"
  if [ "$src" = "-" ]; then text="$(cat)"; else
    [ -f "$src" ] || die "no such file: $src"
    text="$(cat "$src")"
  fi
  [ -n "$text" ] || die "no error text given. pipe it in, or use --from <file>"

  local paths sev suspects
  paths="$(felix_incident_paths "$root" "$text")"
  if [ -z "$paths" ]; then
    printf 'No file in this checkout appears in that text.\n\n'
    printf 'Either the failure is outside this repository, or the trace names\n'
    printf 'paths from another machine. Triage it by hand rather than trusting a\n'
    printf 'brief built from nothing.\n'
    return 0
  fi
  sev="$(felix_incident_severity "$proj" "$paths")"
  suspects="$(felix_incident_suspects "$root" "$paths")"

  local label headline
  case "$sev" in
    red)    label="risk-red";    headline="SEV1. Escalate now, do not start an unattended fix." ;;
    yellow) label="risk-yellow"; headline="SEV2. Fix under normal review." ;;
    *)      label="risk-green";  headline="SEV3. Routine." ;;
  esac

  printf 'project:   %s\nseverity:  %s (%s)\n\n%s\n\n' \
    "$(basename "$proj")" "$sev" "$label" "$headline"

  printf 'implicated files\n'
  printf '%s\n' "$paths" | sed 's|^|  |'

  printf '\nlast touched by\n'
  printf '%s\n' "$suspects" | while IFS=$'\t' read -r f c; do
    [ -n "${f:-}" ] || continue
    printf '  %-44s %s\n' "$f" "$c"
  done

  if [ -f "$proj/evidence.tsv" ]; then
    printf '\nthe fix will have to prove\n'
    while IFS=$'\t' read -r name when requires reason; do
      [ -n "${name:-}" ] || continue
      _felix_any_match "$paths" "$when" && printf '  %-14s %s\n' "$name" "$reason"
    done <<EOF
$(_felix_evidence_rows "$proj")
EOF
  fi

  # Policy, stated every time because urgency is exactly when it gets skipped.
  printf '\nUrgency does not bypass the gates. The fix goes through the same gate,\n'
  printf 'the same classification, and the same evidence policy as any other change.\n'
  [ "$sev" = "red" ] && printf 'A red path is implicated: a human decides before anything is changed.\n'

  [ "$create" -eq 1 ] || { printf '\nopen an issue with: felix incident --create\n'; return 0; }

  local slug; slug="$(felix_repo_slug "$root")"
  [ -n "$slug" ] || die "no github remote; cannot open an issue"
  local body
  body="$(printf 'Severity: %s\n\n%s\n\n## Implicated files\n\n%s\n\n## Last touched by\n\n%s\n\n## Signal\n\n```\n%s\n```\n' \
    "$sev" "$headline" "$paths" "$suspects" "$(printf '%s' "$text" | head -40)")"
  if gh issue create --repo "$slug" --title "incident: $(printf '%s' "$paths" | head -1)" \
       --body "$body" --label "$label" 2>/dev/null; then
    printf '\nissue opened\n'
  else
    printf '\ncould not open an issue; is the %s label present? try felix bootstrap\n' "$label" >&2
    return 1
  fi
}

cmd_repair() {
  resolve_or_die; local proj="$PROJ"
  _felix_repair_require_gh || return 1
  local repo branch latest run_id status conclusion attempts
  repo="$(git remote get-url origin 2>/dev/null | sed -E 's#.*github\.com[:/]##; s#\.git$##')"
  [ -n "$repo" ] || die "no github remote; felix repair supports GitHub Actions only"
  branch="$(felix_repair_branch)"

  latest="$(felix_repair_latest "$branch" "$repo")"
  [ -n "$latest" ] || { printf 'No CI runs for %s yet.\n' "$branch"; return 0; }
  run_id="$(printf '%s' "$latest" | cut -f1)"
  status="$(printf '%s' "$latest" | cut -f2)"
  conclusion="$(printf '%s' "$latest" | cut -f3)"

  printf 'branch:   %s\nrun:      %s (%s / %s)\n' "$branch" "$run_id" "$status" "$conclusion"

  if [ "$status" != "completed" ]; then
    printf '\nStill running. Wait for it rather than guessing at the failure.\n'
    return 0
  fi
  if [ "$conclusion" = "success" ]; then
    printf '\nGreen. Nothing to repair.\n'
    return 0
  fi

  attempts="$(felix_repair_attempts "$branch" "$repo")"
  printf 'attempts: %s of %s\n' "$attempts" "$FELIX_REPAIR_MAX"

  if [ "$attempts" -ge "$FELIX_REPAIR_MAX" ]; then
    printf '\nCEILING REACHED. Stop patching.\n\n'
    printf '%s consecutive failures means the diagnosis is wrong, not the patch.\n' "$attempts"
    printf 'Escalate instead of trying again:\n\n'
    printf '  gh pr edit --repo %s --add-label needs-founder\n\n' "$repo"
    printf 'Then write what was tried and why each attempt failed into\n'
    printf '%s/DEVLOG.md before handing it over.\n' "$(felix_mem_dir "$proj")"
    return 2
  fi

  # Scope before excerpt. Handing an agent the failing log of an authorization
  # change and telling it afterwards not to touch anything is the wrong order:
  # by then it has a plan.
  local log_text implicated sev
  log_text="$(felix_repair_excerpt "$run_id" "$repo")"
  implicated="$(felix_incident_paths "$(felix_repo_root "$PWD")" "$log_text")"
  if [ -n "$implicated" ] && [ -f "$proj/risk.tsv" ]; then
    sev="$(felix_incident_severity "$proj" "$implicated")"
    if [ "$sev" = "red" ]; then
      printf '\nOUT OF SCOPE. The failure implicates a red path:\n\n'
      printf '%s\n' "$implicated" | sed 's|^|  |'
      printf '\nAttempts remaining is the wrong bound here. Escalate:\n\n'
      printf '  gh pr edit --repo %s --add-label needs-founder\n' "$repo"
      return 3
    fi
  fi

  printf '\nfailing output:\n\n'
  printf '%s\n' "$log_text" | sed 's/^/  /'
  printf '\nPatch the same branch, run the gate locally, then push.\n'
  printf '%s attempt(s) left before this escalates.\n' "$((FELIX_REPAIR_MAX - attempts))"
}

cmd_doctor() {
  resolve_or_die; local proj="$PROJ" root new gate rivals fix=0 a
  for a in "$@"; do case "$a" in --fix) fix=1 ;; esac; done
  root="$(felix_repo_root "$PWD")"
  new="$(felix_undeclared "$root" "$proj")"
  gate="$(felix_json_str "$proj/project.json" gate)"
  rivals="$(_felix_rival_gates "$root" "$proj" "$gate")"

  # Removing a lookalike Felix already holds loses nothing and is exactly the
  # reversible work the charter says to do rather than escalate. Nobody should
  # be told where a duplicate script lives; it is not a decision, it is tidying.
  #
  # Only when Felix holds a copy under that name. A gate-named script Felix does
  # not hold is somebody's only copy, and deleting that would be destroying work
  # to clean up a report.
  if [ "$fix" -eq 1 ] && [ -n "$rivals" ]; then
    local st ff nn kept=""
    while IFS=$'\t' read -r st ff nn; do
      [ -n "${ff:-}" ] || continue
      local base="${ff##*/}"
      if [ -f "$proj/$base" ]; then
        mkdir -p "$FELIX_HOME_DIR/state/rivals" 2>/dev/null
        cp "$root/$ff" \
           "$FELIX_HOME_DIR/state/rivals/$(basename "$proj")-$(printf '%s' "$ff" | tr '/' '-')" \
           2>/dev/null
        rm -f "$root/$ff" 2>/dev/null
      else
        kept="${kept}${ff}
"
      fi
    done <<EOF
$rivals
EOF
    rivals="$(_felix_rival_gates "$root" "$proj" "$gate")"
    if [ -n "$kept" ]; then
      printf 'kept, because Felix holds no copy and this may be the only one:\n'
      printf '%s' "$kept" | sed 's|^|  |'
      printf '\n'
    fi
  fi

  printf 'project:      %s\n' "$(basename "$proj")"
  printf 'declared:     %s\n' "$(felix_declared "$proj" | tr '\n' ' ')"
  if [ -z "$new" ]; then
    printf 'undeclared:   none\n'
  else
    printf 'undeclared:   %s\n\n' "$(printf '%s' "$new" | tr '\n' ' ')"
    printf 'These surfaces exist in the checkout but this project has never\n'
    printf 'declared them. Each one is a gate the guidebook expects and that\n'
    printf 'nothing is currently enforcing:\n\n'
    printf '%s\n' "$new" | while read -r c; do
      [ -n "$c" ] || continue
      printf '  %-14s %s\n' "$c" "$(_felix_why "$c")"
    done
    printf '\nadopt with: felix adopt <capability>\n'
  fi

  if [ -n "$rivals" ]; then
    printf '\nrival gates\n\n'
    printf '%s\n' "$rivals" | while IFS=$'\t' read -r state f note; do
      [ -n "${f:-}" ] || continue
      printf '  %-32s %-10s %s\n' "$f" "$state" "$note"
    done
    printf '\nEach of these is executable, and is either a copy of something Felix\n'
    printf 'holds for this project or named as though it gates. None of them is\n'
    printf 'the copy Felix runs. Whichever one a session reaches for decides what\n'
    printf 'green means, and the one in plain sight is the one it reaches for.\n'
    printf '\nfelix gate   is the only verdict that gets recorded\n'
  fi

  # A rule too broad to enforce is skipped at the moment it would have fired,
  # and the hook says nothing because it runs on every tool call. Silence there
  # has to be paid for here, or the project owns a rule that quietly does
  # nothing — which is the exact complaint Felix makes about other plugins.
  local wide; wide="$(felix_deny_overbroad_rows "$proj" 2>/dev/null)"
  if [ -n "$wide" ]; then
    printf '\ndeny rules too broad to enforce\n\n'
    printf '%s\n' "$wide" | while IFS=$'\t' read -r t p r; do
      [ -n "${p:-}" ] || continue
      printf '  %-14s %s\n' "$t" "$p"
    done
    printf '\nEach of these refuses everything it was asked about, so Felix skips it\n'
    printf 'rather than honouring it. A rule that also matches ordinary work cannot\n'
    printf 'be told apart from a broken editor by the person hitting it, and the\n'
    printf 'harness gets switched off rather than the row corrected.\n'
    printf '\nNarrow the pattern in %s/deny.tsv, or drop the row.\n' "$proj"
  fi

  # Reporting drift is not a failure. Exit 0 so a session hook or a CI step can
  # surface this without turning a green tree red for work nobody asked for yet.
  return 0
}

_felix_why() {
  case "$1" in
    ci)            echo "workflows exist; confirm the gate is a required check" ;;
    deploy)        echo "a deploy target exists; preview and smoke tests apply" ;;
    iac)           echo "infrastructure as code; plan-before-apply applies" ;;
    observability) echo "error reporting present; the incident loop applies" ;;
    billing)       echo "payments present; live writes need a broker and approval gate" ;;
    e2e)           echo "browser tooling present; critical flows should be covered" ;;
    database)      echo "schema or migrations present; migration and access tests apply" ;;
    api)           echo "a served surface exists; contract tests apply" ;;
    frontend)      echo "a web surface exists; build and design checks apply" ;;
    llm)           echo "built on a model SDK; prompts get pinned, outputs graded, refusal and cost are failure modes" ;;
    rust)          echo "a cargo crate; clippy, types and a release profile apply" ;;
    tests)         echo "a test suite exists; it belongs in the gate" ;;
    secrets)       echo "env templates present; secret scanning applies" ;;
    *)             echo "detected in the checkout" ;;
  esac
}


cmd_log() {
  resolve_or_die; local proj="$PROJ" text="$*"
  [ -n "$text" ] || die 'usage: felix log "what happened and why"'
  felix_mem_log "$proj" "$(felix_repo_root "$PWD")" "$text"
  printf 'logged to %s/DEVLOG.md\n' "$(felix_mem_dir "$proj")"
}

cmd_lesson() {
  resolve_or_die; local proj="$PROJ" text="$*"
  [ -n "$text" ] || die 'usage: felix lesson "the thing worth repeating"'
  felix_mem_lesson "$proj" "$(felix_repo_root "$PWD")" "$text"
  printf 'recorded in %s/lessons.md\n' "$(felix_mem_dir "$proj")"
  printf 'Only durable things belong here. A lessons file people stop reading\n'
  printf 'is worse than none, and it stops being read when it fills with one-offs.\n'
}

cmd_handoff() {
  resolve_or_die; local proj="$PROJ" root gate note=""
  while [ $# -gt 0 ]; do
    case "$1" in --was) need_value "$@"; note="$2"; shift 2 ;; *) shift ;; esac
  done
  root="$(felix_repo_root "$PWD")"
  gate="$(felix_json_str "$proj/project.json" gate)"
  felix_mem_handoff "$proj" "$root" "$gate" "$note"
  printf 'wrote %s/SESSION_HANDOFF.md\n\n' "$(felix_mem_dir "$proj")"

  # The session-end list from the guidebook, as a check rather than a memory
  # exercise. Each line is something a person is about to not do.
  printf 'before you stop:\n'
  local dirty; dirty="$(git -C "$root" status --short 2>/dev/null | grep -v '^??' || true)"
  [ -n "$dirty" ] && printf '  [ ] the tree is dirty; commit it or say in the devlog why not\n' \
                  || printf '  [x] tree is clean\n'
  if git -C "$root" log -1 --format=%H >/dev/null 2>&1; then
    printf '  [ ] devlog entry for this work?   felix log "..."\n'
    printf '  [ ] anything durable to keep?     felix lesson "..."\n'
  fi
  printf '  [ ] gate green?                   felix gate\n'
  printf '  [ ] commit the project directory in Felix so this survives the machine\n'
}


cmd_lessons() {
  resolve_or_die; local proj="$PROJ" want=""
  while [ $# -gt 0 ]; do
    case "$1" in --for) need_value "$@"; want="$2"; shift 2 ;; *) want="$want $1"; shift ;; esac
  done
  local file="$(felix_mem_dir "$proj")/lessons.md"
  [ -s "$file" ] || die "no lessons recorded yet for $(basename "$proj")"
  local root; root="$(felix_repo_root "$PWD")"

  local always; always="$(felix_lessons_always "$file")"
  if [ -n "$always" ]; then
    printf 'always\n\n'; printf '%s\n' "$always" | sed 's/^/  /'; printf '\n'
  fi
  local matched; matched="$(felix_lessons_for "$file" "$(felix_lessons_context "$root" "$want")" 8)"
  if [ -n "$matched" ]; then
    printf 'matched to this change\n\n'; printf '%s\n' "$matched" | sed 's/^/  /'
  else
    printf 'nothing matched this context. All of them: %s\n' "$file"
  fi
}

cmd_promote() {
  resolve_or_die; local proj="$PROJ"
  local mistakes; mistakes="$(felix_mem_recurring_mistakes "$proj")"

  # Mistakes first. A check that keeps failing is a habit, and a habit is what a
  # lesson is for. Word frequency in a devlog is a weaker signal and belongs
  # underneath the strong one, not instead of it.
  printf 'the gate keeps catching\n\n'
  if [ -z "$mistakes" ]; then
    printf '  nothing twice yet\n'
  else
    printf '%s\n' "$mistakes" | while IFS=$'\t' read -r n term last; do
      [ -n "${n:-}" ] || continue
      printf '  %-4s %-20s last %s\n' "$n" "$term" "${last:-?}"
    done
    printf '\nEach of these is a mistake this project has now made more than once.\n'
    printf 'That is the strongest promotion signal there is: not that something is\n'
    printf 'interesting, but that it already cost time twice.\n'
    printf '\nStill recurring, which is a different claim from having recurred: a\n'
    printf 'check nothing has caught in a fortnight is history and is not listed.\n'
  fi

  if [ -f "$(felix_mem_dir "$proj")/DEVLOG.md" ]; then
    local hits; hits="$(felix_mem_promotable "$proj")"
    if [ -n "$hits" ]; then
      printf '\nrecurring in the devlog, absent from the lessons\n\n'
      printf '%s\n' "$hits" | head -8 | while IFS=$'\t' read -r n term; do
        [ -n "${n:-}" ] || continue
        printf '  %-4s %s\n' "$n" "$term"
      done
      printf '\nWord frequency, not understanding. A term appearing often may be a\n'
      printf 'lesson, or may simply be what this project is about.\n'
    fi
  fi

  printf '\nPromote what would change what someone does next time:\n\n'
  printf '  felix lesson "..."\n\n'
  printf 'And when a lesson keeps being violated anyway, it has outgrown the\n'
  printf 'lessons file and belongs in the constitution, where the gate can see it.\n'
}

cmd_adopt() {
  resolve_or_die; local proj="$PROJ" cap="${1:-}"
  [ -n "$cap" ] || die "usage: felix adopt <capability>"
  local slug counts
  slug="$(felix_repo_slug "$(felix_repo_root "$PWD")")"
  if ! counts="$(felix_adopt_capability "$proj" "$cap" "$SCRIPT_DIR/templates" "$slug")"; then
    printf '%s already declared\n' "$cap"; return 0
  fi
  printf 'declared %s for %s\n' "$cap" "$(basename "$proj")"
  set -- $counts
  if [ "${1:-0}" -gt 0 ] || [ "${2:-0}" -gt 0 ]; then
    printf 'backfilled %s tooling row(s) and %s human step(s) that %s implies.\n' "$1" "$2" "$cap"
    printf 'review with: felix stack plan   and   felix setup\n'
  fi
  printf 'commit %s in the Felix repo to make it durable.\n' "$proj"
}


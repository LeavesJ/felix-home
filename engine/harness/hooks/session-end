#!/usr/bin/env bash
# SessionEnd: fold what PostToolUse recorded into the committed ledger, and
# say how the session left its tree.
#
# The transcript is never read. That was the mechanism the original design
# named, and it was wrong twice over: parsing 1.7MB of JSONL in bash is not
# practical and the invariant forbids reaching for a parser that is, and every
# fact it wanted already existed at a moment when a hook was running.
#
# The rollup writes a zero row for every declared capability this session never
# reached for. Those rows are the point. "Loaded and used" is confounded because
# loading is what causes use; "loaded and never once invoked" is not, and it
# leaves no trace of itself unless something writes it down.
#
# How the tree was left is the Stop record (lib/left.sh) written once more, and
# a lifecycle.log row of kind end whose note is its state, +asked when the
# session's last message asked something. This payload carries no message, so
# the asked is the one the session's last Stop found. Neither library can end
# this hook: they are sourced without the exit the three above carry, so a
# missing one costs its record and never the rollup. And both come after the
# rollup: the platform kills a SessionEnd hook at 1.5 s unless it sets a
# timeout (Claude Code 2.1.260), and git status alone can take longer on a
# large tree, so what a kill there costs is the end row, whose facts every
# Stop has already written, and never the ledger.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
FELIX_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
. "${SCRIPT_DIR}/../lib/resolve.sh" 2>/dev/null || exit 0
. "${SCRIPT_DIR}/../lib/ledger.sh"  2>/dev/null || exit 0
. "${SCRIPT_DIR}/../lib/verify.sh"  2>/dev/null || exit 0
. "${SCRIPT_DIR}/../lib/lifecycle.sh" 2>/dev/null
. "${SCRIPT_DIR}/../lib/left.sh"      2>/dev/null

raw="$(cat 2>/dev/null || true)"

FELIX_HOME_DIR="$(felix_home "$FELIX_ROOT" 2>/dev/null)" || exit 0

session="$(printf '%s' "$raw" \
  | sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"

# A session nobody in it typed into is not a session to fold (#264): whatever
# it reached for, it reached for on nobody's behalf. Consulted first, before the
# project is resolved, so the marker goes with the session even where nothing
# resolves; it is ephemeral and this is its end. A marker a person's prompt
# outranked goes too, and that session folds as any other.
_machine=0
felix_session_machine "$FELIX_HOME_DIR" "$session" && _machine=1
felix_session_machine_clear "$FELIX_HOME_DIR" "$session"
[ "$_machine" = 1 ] && exit 0

PROJ="$(felix_resolve_project "$PWD" "$FELIX_HOME_DIR" 2>/dev/null)" || PROJ=""
[ -n "$PROJ" ] || exit 0
[ -n "$session" ] || exit 0

felix_ledger_rollup "$PROJ" "$FELIX_HOME_DIR" "$session" "$(date -u +%Y-%m-%d)"

if command -v felix_left_record >/dev/null 2>&1 && command -v felix_lifecycle_end >/dev/null 2>&1; then
  ROOT="$(felix_repo_root "$PWD")"
  felix_left_record "$PROJ" "$ROOT" "$session" "$raw" "$FELIX_HOME_DIR" end >/dev/null 2>&1
  felix_lifecycle_end "$PROJ" "$ROOT" "$session" \
    "$(printf '%s' "$raw" | sed -n 's/.*"transcript_path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)" \
    "${FELIX_LEFT_STATE:-}" "${FELIX_LEFT_ASKED:-}" >/dev/null 2>&1
fi
exit 0

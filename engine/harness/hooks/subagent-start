#!/usr/bin/env bash
# SubagentStart: a subagent begins with nothing, unless something gives it
# something.
#
# The parent session is bound at both ends — doctrine mounted at SessionStart,
# completion refused at Stop, claims questioned before it finishes. A subagent
# got none of that. It started blank, did work, and handed back a report.
#
# The evidence is how this file came to exist. A subagent was dispatched to
# design Felix's self-diagnosis, and every invariant it had to respect — bash
# and git only, a model may narrow and never widen, hooks bind at session
# start — was typed into its prompt by hand, because Felix had no way to tell
# it. Whoever forgets to type them gets a design that violates them, and the
# parent has no way to see that it did.
#
# So this mounts the same three things a session gets: which project governs,
# where the constitution is, and the gate that will judge the work. Not the
# whole banner. A subagent has one task and a small budget, and everything a
# session needs at startup is not what a subagent needs to not go wrong.

set -uo pipefail

# The caller's environment must not change what a tool prints. Why, and why
# these lines: the comment above the same lines in engine/harness/felix.
set +o allexport +o errexit +o keyword +o noclobber +o noglob +o physical
export -n SHELLOPTS BASHOPTS
_FELIX_CALLER_CDPATH="${CDPATH-}"
unset GREP_OPTIONS CLICOLOR_FORCE GH_FORCE_TTY TAPE TAR_OPTIONS TAR_READER_OPTIONS QUOTING_STYLE \
      GIT_EXTERNAL_DIFF GIT_DIFF_OPTS GIT_LITERAL_PATHSPECS GIT_GLOB_PATHSPECS GIT_NOGLOB_PATHSPECS \
      GIT_ICASE_PATHSPECS TMOUT POSIXLY_CORRECT CDPATH

# Git's colour stays off for every git this runs, whatever colour settings the
# caller made, except what is out of reach. Why, which keys, and what is out
# of reach: the comment above the same lines in engine/harness/felix.
_felix_git_pin="'color.ui=never' 'color.advice=never' 'color.branch=never' 'color.diff=never' 'color.grep=never' 'color.interactive=never' 'color.push=never' 'color.remote=never' 'color.showBranch=never' 'color.status=never' 'color.transport=never' 'color.pager=false' 'blame.coloring=none'"
case " ${GIT_CONFIG_PARAMETERS-}" in
  *" $_felix_git_pin") ;;
  *) export GIT_CONFIG_PARAMETERS="${GIT_CONFIG_PARAMETERS:+$GIT_CONFIG_PARAMETERS }$_felix_git_pin" ;;
esac

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ENGINE_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
FELIX_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
. "${SCRIPT_DIR}/../lib/resolve.sh" 2>/dev/null || exit 0

FELIX_HOME_DIR="$(felix_home "$FELIX_ROOT" 2>/dev/null)" || exit 0

# It read no payload until the session's directory had to come from there
# (lib/resolve.sh). A terminal on stdin is a person running the hook by hand,
# and waiting on them would hang it.
raw=""
[ -t 0 ] || raw="$(cat 2>/dev/null)"
felix_hook_enter "$raw" "$FELIX_HOME_DIR"
PROJ="$(felix_resolve_project "$PWD" "$FELIX_HOME_DIR" 2>/dev/null)" || PROJ=""
[ -n "$PROJ" ] || exit 0

body="Felix governs this work. You are a subagent: your report will be believed by
whoever dispatched you, and they cannot see the tree you leave behind.

Project: $(basename "$PROJ")
Constitution: ${PROJ}/CLAUDE.md
Gate: ${ENGINE_DIR}/felix gate

Read the constitution before proposing anything structural. It carries
invariants that are not negotiable, and a proposal that breaks one is worse
than no proposal, because it looks like work. If you change files and do not
run the gate, say so plainly in your report rather than describing the work as
done."

printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SubagentStart",\n    "additionalContext": "%s"\n  }\n}\n' \
  "$(printf '%s' "$body" | sed 's/\\/\\\\/g; s/"/\\"/g' | awk '{printf "%s\\n", $0}')"
exit 0

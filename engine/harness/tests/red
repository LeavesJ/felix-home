#!/usr/bin/env bash
# The red run: this tree's assertions against the engine the base ref holds.
#
#   tests/red [base]        base defaults to origin/main, then main
#
# "Shown failing before believed" (invariant 5) was, until this, a sentence in
# a pull request body: the author ran the suite against the previous engine,
# read a count, and typed it. When six handoff sections were audited by readers
# forbidden the suite (HANDOFF §0bh), every claim about method — authored
# blind, shown red — turned out to leave no artifact on the machine, and the
# red count was one of them. This makes the count a file in the tree, taken
# against a named commit, so "N assertions fail against the previous engine" is
# a diff on red.tsv that anybody reproduces with the same command.
#
# What it does: checks the base commit out whole — libraries, bin scripts,
# gate, tables, hooks — as a detached worktree under a temporary directory,
# puts THIS tree's tests/run into it, and runs that. So the assertions are the
# tree's and the engine is the base's, which is exactly the run a reviewer
# would do by hand. The base's own tests/run never executes. The suite's own
# manifest comparison is off for that run (FELIX_TEST_NO_MANIFEST=1): standing
# in the base's tree it would read the base's manifest, and "assertion did not
# run" against that would count as red, and it is not. The comparison that
# matters, against this tree's manifest, is made here after the run (below).
#
# A worktree and not an archive, measured: the first version unpacked
# `git archive` and read 2 of 2357 red against a base whose engine was
# byte-identical to the tree's. Both were assertions that ask git about the
# checkout the suite stands in — the independence scanner's `git ls-files`,
# deploy-check's base ref — and an archive has no repository to answer, so
# they failed for the wrong reason and would have inflated every count since.
# The worktree is removed on the way out, whatever happened, and stale
# metadata is pruned; a red run killed mid-way leaves an entry `git worktree
# prune` clears.
#
# What it writes: red.tsv beside this script, whole, every time —
#   base   <ref>  <sha>  <engine version at the base>
#   run    <failed>  <passed>  <skipped>
#   <assertion name>  <times it failed>        one row per failed name
# where an assertion this tree's manifest lists and the base run never reached
# counts as failed, by how many times it fell short; and when no complete red
# run was made, base and run rows of `-`, so the file says nothing was shown
# rather than keeping the previous claim: none was possible, the suite stopped
# before `reached` or reached no assertion, or tests/red itself was stopped,
# since it retracts before the run; its stdout said which unless it was the
# one stopped.
#
# Lines are counted, not the summary. PASS and FAIL are incremented in the
# suite's main shell only, and some assertions run inside subshells, so the
# summary line can read fewer than the FAIL lines above it. The lines are the
# record; the summary is a convenience.
#
# The end of the suite is not every assertion in it. The `reached` line below
# says the suite's main shell got to its last line, and bash lets a statement
# vanish on the way without stopping. Measured in bash 3.2.57, which runs the
# suite on a Mac: an arithmetic error inside $(( )), an operand of -, 08, 1.5
# or two lines, prints an error to stderr, discards the rest of the top-level
# command it sits in and carries on. At top level that is the whole line's
# list, so `a; b` on one line loses both and `cond && ok || bad` both
# verdicts; inside an if, a for or a { } block it is every statement left in
# the block. $? right after is 1, and only the suite's own final exit is
# unaffected. "and only the awaiting count records it" computes what it
# expects from a field the engine under test wrote, so against a base that
# writes - there it vanishes. Found in #371's review, 2026-09-25: a fixture
# built on it read 0 of 2 assertions failing, `run 0 2 0`, the vanished one
# counted nowhere, which is fewer red than true, the one shape this file must
# never take. So this tree's manifest, assertions.tsv beside this script, is
# read before the suite runs, refused there if it is not a manifest, and kept;
# after the run each name it lists is counted in the log's ok, FAIL and skip
# lines, per name as the suite's own comparison counts, and a name reached
# fewer times than the manifest says is recorded as red by the shortfall.
#
# Recorded, not refused. The manifest says the assertion was reached against
# this tree's own engine: tests/run --record-assertions wrote it from that run
# immediately before it called this. If it was not reached against the base's,
# the base's engine kept this tree's suite from asking it, by a statement that
# erred on what the engine wrote or a block the engine's behaviour gates.
# Either way the base does not meet the tree's contract there, which is what
# red means. Refusing would make every change whose new assertion sits in such
# a block unrecordable, and write - exactly where red is the true answer.
#
# The cost, said plainly. A skip prints a line, so a skipped assertion is
# reached, not red, whatever gates it. A skip the base's engine causes, a block
# skipped because the base lacks a script the tree adds, is a known gap this
# does not close: its assertions read as reached, not red. A cause outside the
# engine reads as red: a fork the per-user process cap refuses inside a
# subshell ends that subshell alone, the main shell goes on to reached, and
# the assertions left in the subshell are recorded red, more red than true. So
# does a skip whose reason holds a newline: its line does not end in the
# parenthesis a skip line ends in, and its name reads as never reached. No
# skip in tests/run has one. A manifest out of date with tests/run errs both
# ways. A name it lists that
# tests/run no longer has, an assertion renamed without re-recording, reads as
# red, more red than true; an assertion tests/run gained after the manifest
# was written is not compared at all, so if it vanishes against the base it is
# counted nowhere, fewer red than true. The record path writes the manifest
# from this same tree just before it calls this, so a stale one arises only in
# a run by hand. The log is read and not the suite's ran file because that
# file goes with the suite's temporary directory, and the log is what is
# counted already.
#
# What it does not do: judge. A red count of zero is a true statement about a
# change that added no assertion the old engine fails — a documentation change,
# a refactor with an unchanged contract — and is recorded as zero, not refused.
# Whether zero is acceptable for a given change is the reviewer's question, and
# the file gives them the number to ask it about.
#
#   exit 0  the suite reached its end, and every assertion the manifest lists
#           was either reached or recorded as red; red.tsv holds the result,
#           zero included
#   exit 2  it could not: no base ref, no run or no readable manifest beside
#           this script, a manifest that is not one (a malformed row, a
#           repeated name, no rows), a tree that could not be read, a suite
#           that stopped before its end, which is no red run whatever it
#           printed first, or a log that could not be kept or a comparison
#           that could not be made. red.tsv says so.
#
# One trap, from HANDOFF §5: a test for a hang leaks the hang unless its
# watchdog kills the children, and a red run is precisely where such tests
# fail. After the run, anything still holding the temporary path in its
# command line is a stray of this run and is ended.
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)" || exit 2
OUT="$HERE/red.tsv"

_header() {
  printf '# The red run: this tree'"'"'s assertions against the engine the base ref holds,\n'
  printf '# written whole by tests/red, which tests/run --record-assertions calls.\n'
  printf '#   base  <ref>  <sha>  <engine version there>\n'
  printf '#   run   <failed>  <passed>  <skipped>        lines counted, not the summary\n'
  printf '#   <assertion name>  <times it failed>        failed names only\n'
  printf '#   an assertion the manifest lists that the base run never reached counts as failed, by its shortfall\n'
  printf '# A base of - means no complete red run was made: none was possible, the\n'
  printf '# suite stopped before reached or reached no assertion, or tests/red itself\n'
  printf '# was stopped; its stdout said which unless it was the one stopped.\n'
  printf '# Reproduce with: tests/red <ref>\n'
}

# Every write to red.tsv lands whole or not at all: a sibling file, then one
# rename. A truncate-then-write that died half way would leave base and run
# rows with the failed names missing below them, which reads as zero
# regressions when there were some — the one shape this file must never take.
# A write that fails is said, not swallowed; what is on disk then is whatever
# the retraction below already put there.
_put() {   # stdin -> red.tsv, atomically
  cat > "$OUT.tmp" && mv -f "$OUT.tmp" "$OUT"
}

# Nothing was shown. Said in the file, not only on the terminal, because a
# red.tsv left over from the previous change is the previous change's claim.
_none() {
  { _header; printf 'base\t-\t-\t-\nrun\t-\t-\t-\n'; } | _put \
    || printf 'red: could not write %s\n' "$OUT" >&2
  printf 'red: not run: %s\n' "$1"
  exit 2
}

# Retract FIRST, before anything that can take minutes or be killed. A run
# ended by a signal nothing here can trap — kill -9, an out-of-memory kill, a
# runner's hard timeout — reaches neither write below, and until this line
# existed such a run left the previous change's claim on disk, current-looking
# and false. From here on, a red.tsv that is not this run's result says so.
{ _header; printf 'base\t-\t-\t-\nrun\t-\t-\t-\n'; } | _put \
  || { printf 'red: not run: could not write %s\n' "$OUT"; exit 2; }

ROOT="$(git -C "$HERE" rev-parse --show-toplevel 2>/dev/null)" || _none "$HERE is not inside a git repository"
[ -f "$HERE/run" ] || _none "no tests/run beside $HERE/red"

# This tree's manifest, read once and here, before the suite: a bad one costs
# seconds, not a whole run. It is kept in memory, so a manifest rewritten while
# the suite runs does not change what the run is compared with. One row is a
# count, a tab and a name, the name being all after the first tab. A wholly
# empty line is skipped. The suite's own comparison skips any row with no
# name, `1<TAB>` among them, and this refuses every such row but the empty
# line. A name on two rows (a textual merge makes them) is refused, not
# summed, since the record would then rest on a count nobody wrote. awk reads
# every line and reports the first fault at the end, so the pipe into it never
# breaks.
MANF="$HERE/assertions.tsv"
{ [ -f "$MANF" ] && [ -r "$MANF" ]; } || _none "no readable assertions.tsv beside $HERE/red"
MAN="$(cat "$MANF" 2>/dev/null)" || _none "no readable assertions.tsv beside $HERE/red"
_mv="$(printf '%s\n' "$MAN" | LC_ALL=C awk '
  v != "" || $0 == "" { next }
  {
    i = index($0, "\t"); c = substr($0, 1, i - 1); n = substr($0, i + 1)
    if (i == 0 || c !~ /^[1-9][0-9]*$/ || n == "") { v = "line " NR " is not a count, a tab and a name"; next }
    if (n in seen) { v = "line " NR " repeats a name an earlier line holds"; next }
    seen[n] = 1; rows++
  }
  END { print (v != "" ? v : (rows ? "ok" : "none")) }')"
case "$_mv" in
  ok) ;;
  none) _none "assertions.tsv beside $HERE/red lists no assertion" ;;
  line\ *) _none "assertions.tsv $_mv" ;;
  *) _none "no readable assertions.tsv beside $HERE/red" ;;
esac

BASE="${1:-}"
if [ -z "$BASE" ]; then
  for _r in origin/main main; do
    git -C "$ROOT" rev-parse --verify --quiet "$_r" >/dev/null 2>&1 && { BASE="$_r"; break; }
  done
fi
[ -n "$BASE" ] || _none "no origin/main or main in this repository"
SHA="$(git -C "$ROOT" rev-parse --verify --quiet "$BASE^{commit}" 2>/dev/null)" || _none "no such ref: $BASE"
VER="$(git -C "$ROOT" show "$SHA:engine/.claude-plugin/plugin.json" 2>/dev/null \
       | sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
[ -n "$VER" ] || VER="-"

# Under $TMPDIR by a template, since a bare `mktemp -d` on a Mac ignores
# TMPDIR (below, what that cost).
_tmproot="${TMPDIR:-/tmp}"
TMP="$(mktemp -d "${_tmproot%/}/tmp.XXXXXXXXXX" 2>/dev/null)" && [ -d "$TMP" ] \
  || _none "no temporary directory under $_tmproot"
TREE="$TMP/tree"
_cleanup() {
  git -C "$ROOT" worktree remove --force "$TREE" >/dev/null 2>&1
  git -C "$ROOT" worktree prune >/dev/null 2>&1
  rm -rf "$TMP"
}
trap _cleanup EXIT
# The whole commit, not engine/ alone: the suite reads the repository's own
# gate, tables, hooks and commands through REAL_HARNESS/../.., and a tree
# missing them would skip those assertions and call the skip a verdict.
# Judged by what is on disk, not by the exit status: a post-checkout hook
# that fails makes `worktree add` exit 1 over a checkout that is complete and
# registered, and this repository is entitled to grow such a hook.
git -C "$ROOT" worktree add --detach "$TREE" "$SHA" >/dev/null 2>&1
[ -d "$TREE/engine/harness" ] && git -C "$TREE" rev-parse --verify --quiet HEAD >/dev/null 2>&1 \
  || _none "could not check out $BASE under $TMP"
mkdir -p "$TREE/engine/harness/tests" 2>/dev/null
cp "$HERE/run" "$TREE/engine/harness/tests/run" 2>/dev/null \
  || _none "could not place tests/run into the tree at $BASE"

# The suite runs with the caller's TMPDIR, as it does by hand, so its own
# mktemp root is made where a plain run makes it. Until 2026-09-24 it ran with
# TMPDIR under this run's directory, so that its root would go with this run
# and a stray holding it would match the pattern below. On a Mac that never
# happened: a bare `mktemp -d` there ignores TMPDIR, so the root landed beside
# this directory, and lib/where.sh, which counts $TMPDIR as a temporary root,
# saw the suite's scoped fixtures outside every one. 44 of #308's assertions
# failed in every red run on a Mac, against an engine identical to the tree's.
# Making the suite honour the moved TMPDIR put the fixtures back under it and
# broke another assertion: nesting lengthens every path the suite makes by
# seventeen characters, and "and says which directory it was sent to" reads a
# path the engine cuts at eighty.
#
# So the pattern below, with the path's regex metacharacters escaped, ends
# what still names this run's directory: the tree the base is checked out in,
# which the suite reaches as REAL_HARNESS. A stray naming only the suite's own
# root escapes it, as on a Mac it always did.
#
# The run counts only if the suite got to its end, and the exit status cannot
# say so, since a finished red run exits 1 whenever anything is red. What says
# so is the line the suite prints after its last assertion, exactly "reached",
# and the run placed into the base is this tree's, so the line does not depend
# on the base. It counts only when no assertion line follows the last such
# line: the log takes the suite's stderr with its stdout, so a child or a
# failure detail can print the bare word earlier, and that is not the suite's
# end. Until #371 only a run that reached no assertion was refused, and
# a suite that died part way was written down as a clean one: on 2026-09-25 a
# suite stopped at assertion 270 read 0 of 270 failing, and an earlier
# record read 0 of 1320 just after fork had failed at the per-user process
# cap, when the whole suite holds some 3,700. The status is kept to name the
# death in the refusal, and the line is read from the log itself, not through
# a pipe that pipefail can make report a line missing when it is there.
#
# Read once. Everything below reads one copy of the log, taken after the
# strays are ended, because a stray the pattern misses still holds the log
# open. Until 2026-10-01 the log itself was read five times, and a line such a
# stray wrote after the marker check reached the comparison and not the run
# row: a stray that printed a vanished name's ok line just then cancelled its
# shortfall, in 5 of 5 runs of the strayline fixture tests/run holds against
# the tests/red before this change (measured again 2026-10-02).
RAW="$TMP/red.raw"
LOG="$TMP/red.log"
( cd "$TREE" && FELIX_TEST_NO_MANIFEST=1 bash engine/harness/tests/run ) > "$RAW" 2>&1
RC=$?
pkill -9 -f "$(printf '%s' "$TMP" | sed 's/[][\\.*^$(){}+?|]/\\&/g')" >/dev/null 2>&1
cp "$RAW" "$LOG" 2>/dev/null || _none "could not keep the log of the suite against $BASE"

PASSED="$(grep -c '^  ok    ' "$LOG")"
FAILED="$(grep -c '^  FAIL  ' "$LOG")"
SKIPPED="$(grep -c '^  skip  ' "$LOG")"
awk '/^  (ok    |FAIL  |skip  )/ { a = NR } $0 == "reached" { r = NR }
     END { exit (r + 0 > a + 0) ? 0 : 1 }' "$LOG" \
  || _none "the suite against $BASE did not finish (exit $RC after $((PASSED + FAILED + SKIPPED)) assertions)"
[ "$((PASSED + FAILED + SKIPPED))" -gt 0 ] || _none "the suite reached no assertion against $BASE"

# Then the manifest kept above, against the log. What the run did adds red
# and is never a refusal; what is refused here is a comparison that could not
# be made, an awk that failed or a count no number holds. Per name, counted,
# since some names legitimately appear more than once and losing one of a
# pair is as silent as losing a unique one. An ok or FAIL line is the name
# exactly. A skip line is the name, " (", a reason and ")", and either may
# hold parentheses, so it goes to the longest listed name it begins with
# followed by " (". Out comes one row per name with FAIL lines or a
# shortfall: FAIL lines, shortfall, name. Names over-reached or not listed are
# not compared, as in the suite's own check; their FAIL lines count as ever.
# Strings go through files, never awk -v, which would eat a backslash.
CMP="$TMP/red.cmp"
printf '%s\n' "$MAN" | LC_ALL=C awk '
  NR == FNR { if ($0 != "") { i = index($0, "\t"); want[substr($0, i + 1)] = substr($0, 1, i - 1) + 0 }; next }
  { h = substr($0, 1, 8) }
  h == "  ok    " || h == "  FAIL  " {
    n = substr($0, 9); if (h == "  FAIL  ") fail[n]++
    if (n in want) got[n]++
    next
  }
  h == "  skip  " && substr($0, length($0)) == ")" {
    t = substr($0, 9); p = 0; hit = 0
    while ((k = index(substr(t, p + 1), " (")) > 0) {
      p += k; c = substr(t, 1, p - 1)
      if (c in want) { best = c; hit = 1 }
    }
    if (hit) got[best]++
  }
  END {
    for (n in want) if (want[n] > got[n] + 0) short[n] = want[n] - got[n]
    for (n in fail) printf "%.0f\t%.0f\t%s\n", fail[n], short[n] + 0, n
    for (n in short) if (!(n in fail)) printf "0\t%.0f\t%s\n", short[n], n
  }' - "$LOG" > "$CMP" 2>/dev/null || _none "could not compare the run against assertions.tsv"
read -r FAILED_ALL TOTAL UNREACHED <<< "$(RED_F="$FAILED" RED_P="$PASSED" RED_S="$SKIPPED" LC_ALL=C awk -F'\t' '
  { u += $2 } END { f = ENVIRON["RED_F"] + u; printf "%.0f %.0f %.0f\n", f, f + ENVIRON["RED_P"] + ENVIRON["RED_S"], u }' "$CMP")"
# Defensive, and asked by no fixture: the awk above prints three numbers
# whatever it reads, so this stands for one that died part way.
for _v in "$FAILED_ALL" "$TOTAL" "$UNREACHED"; do
  case "$_v" in ''|*[!0-9]*) _none "could not compare the run against assertions.tsv" ;; esac
done

{
  _header
  printf 'base\t%s\t%s\t%s\n' "$BASE" "$SHA" "$VER"
  printf 'run\t%s\t%s\t%s\n' "$FAILED_ALL" "$PASSED" "$SKIPPED"
  # The names, once each, in C order of the name, each with its FAIL lines and
  # its shortfall together, so the names still add up to the run's failed.
  LC_ALL=C sort -t "$(printf '\t')" -k3 "$CMP" | LC_ALL=C awk '{
    i = index($0, "\t"); r = substr($0, i + 1); j = index(r, "\t")
    printf "%s\t%.0f\n", substr(r, j + 1), substr($0, 1, i - 1) + substr(r, 1, j - 1) }'
} | _put || _none "could not write $OUT"

_never=""
[ "$UNREACHED" = 0 ] || _never=", $UNREACHED of them never reached"
printf 'red: %s of %s assertions fail against %s (%.7s) at engine %s%s\n' \
  "$FAILED_ALL" "$TOTAL" "$BASE" "$SHA" "$VER" "$_never"
exit 0

printf '\npipefail safety\n'
# Regression. Every presence check used to be `producer | grep -q x`, which under
# `set -o pipefail` reports 141 because grep exits on match and the producer takes
# SIGPIPE. The check then says absent about something present, and it is
# timing-dependent, so small producers pass and a real repository fails.
big="$(seq 1 200000)"
# Deliberately not asserting that `producer | grep -q x` fails here. It fails
# only when the producer is still writing when grep exits, so the assertion is a
# race and flakes. The reason the helpers exist is recorded above instead.
if ( set -uo pipefail
     . "$FROOT/harness/lib/resolve.sh"
     felix_contains "$big" "199999" ); then
  ok "felix_contains survives a large haystack under pipefail"
else
  bad "felix_contains survives a large haystack under pipefail"
fi
if ( set -uo pipefail
     . "$FROOT/harness/lib/resolve.sh"
     felix_has_line "$big" "199999" ) ; then
  ok "felix_has_line matches whole lines under pipefail"
else
  bad "felix_has_line matches whole lines under pipefail"
fi
if ( set -uo pipefail
     . "$FROOT/harness/lib/resolve.sh"
     felix_has_line "alpha
beta" "alph" ); then
  bad "felix_has_line rejects partial lines" "matched a prefix"
else
  ok "felix_has_line rejects partial lines"
fi

printf '\nthe completion gate\n'
# The principle under test: an agent must not be able to say it is finished
# while the tree it changed has never been verified. Everything here drives the
# real Stop hook with real JSON on stdin, against a real git repository.
STOP="$FROOT/harness/hooks/stop"
# Earlier sections rewrite the widget gate to prove other things, so this one
# declares the gate it depends on instead of inheriting whatever ran last.
# Without this the red-gate case silently tests a gate of `true`, which cannot
# fail, and the failure reads like a product bug rather than a suite bug.
cat > "$FROOT/projects/widget/project.json" <<'EOF'
{
  "name": "widget",
  "remote_match": "example.com/widget",
  "gate": "sh -c 'test -f WIDGET.txt && echo widget-gate-ran'"
}
EOF
GREPO="$TMP/gaterepo"
mkdir -p "$GREPO"
( cd "$GREPO" && git init -q -b main
  printf 'contents\n' > WIDGET.txt
  printf 'widget\n'   > .felix
  git add -A >/dev/null 2>&1
  git -c user.name=t -c user.email=t@t commit -qm init >/dev/null 2>&1 )
GREPO="$(cd "$GREPO" && pwd -P)"

EMPTY_JSON='{"hook_event_name":"Stop","stop_hook_active":false}'
ACTIVE_JSON='{"hook_event_name":"Stop","stop_hook_active":true}'
_stop() { ( cd "$1" && printf '%s' "${2:-$EMPTY_JSON}" | "$STOP" 2>&1 ); }
_blocks() {
  case "$2" in *'"decision"'*'"block"'*) ok "$1" ;; *) bad "$1" "expected a block, got [$2]" ;; esac
}
_allows() { [ -z "$2" ] && ok "$1" || bad "$1" "expected silence, got [$2]"; }

out="$(_stop "$GREPO")"; rc=$?
_allows "clean tree stops silently" "$out"
is      "and exits 0"               "$rc" "0"

printf 'edited\n' >> "$GREPO/WIDGET.txt"
out="$(_stop "$GREPO")"
_blocks "an unverified change blocks completion" "$out"
has     "and says the gate never ran"            "$out" "never"

out="$(cd "$GREPO" && "$FELIX" gate 2>&1)"
out="$(_stop "$GREPO")"
_allows "a green gate on this exact tree allows it" "$out"

# The git-status trap. Two different edits to the same file produce identical
# porcelain output, so a receipt keyed on status alone stays valid across a
# change it never saw. The hash has to include diff content.
printf 'different\n' >> "$GREPO/WIDGET.txt"
out="$(_stop "$GREPO")"
_blocks "editing the same file again invalidates the receipt" "$out"

( cd "$GREPO" && git checkout -q -- WIDGET.txt )
out="$(cd "$GREPO" && "$FELIX" gate 2>&1)"
printf 'new\n' > "$GREPO/untracked.txt"
out="$(_stop "$GREPO")"
_blocks "a new untracked file invalidates the receipt" "$out"
rm -f "$GREPO/untracked.txt"

# The platform caps consecutive blocks and documents the contract: return
# success while stop_hook_active is set. Ignoring it is how a hook loops.
printf 'unverified\n' >> "$GREPO/WIDGET.txt"
out="$(_stop "$GREPO" "$ACTIVE_JSON")"
_allows "stop_hook_active is honoured, so it never loops" "$out"

# The override is the founder's, not the model's: it is read from the
# environment the session was launched with.
out="$(cd "$GREPO" && FELIX_ALLOW_RED=1 printf '%s' "$EMPTY_JSON" | FELIX_ALLOW_RED=1 "$STOP" 2>&1)"
_allows "FELIX_ALLOW_RED lets a founder stop anyway" "$out"

# A failing gate must leave a red receipt, not no receipt. No receipt and a red
# one both block, but only one of them tells the truth about what happened.
rm -f "$GREPO/WIDGET.txt"
out="$(cd "$GREPO" && "$FELIX" gate 2>&1)"
out="$(_stop "$GREPO")"
_blocks "a failing gate still blocks"  "$out"
has     "and says the gate failed"     "$out" "failed"
printf 'contents\n' > "$GREPO/WIDGET.txt"

VLOG="$FROOT/projects/widget/memory/verification.log"
[ -s "$VLOG" ] && ok "every decision is recorded" \
               || bad "every decision is recorded" "no verification.log at $VLOG"
if [ -s "$VLOG" ]; then
  grep -q 'blocked'  "$VLOG" && ok "blocks are recorded"    || bad "blocks are recorded"
  grep -q 'override' "$VLOG" && ok "overrides are recorded" || bad "overrides are recorded"
fi

out="$(_stop "$PLAIN")"; rc=$?
_allows "silent in an ungoverned repo" "$out"
is      "and exits 0 there"            "$rc" "0"

NOGIT="$TMP/notgit"; mkdir -p "$NOGIT"; printf 'widget\n' > "$NOGIT/.felix"
out="$(_stop "$NOGIT")"; rc=$?
_allows "silent outside a git repository" "$out"
is      "and exits 0 there too"           "$rc" "0"

# A project that declares no gate has nothing to enforce, and inventing an
# obligation for it would make Felix unusable on a repo mid-onboarding.
mkdir -p "$FROOT/projects/nogate/memory"
printf '{\n  "name": "nogate"\n}\n' > "$FROOT/projects/nogate/project.json"
NGREPO="$TMP/nogaterepo"; mkdir -p "$NGREPO"
( cd "$NGREPO" && git init -q -b main && printf 'x\n' > a.txt
  git add -A >/dev/null 2>&1 && git -c user.name=t -c user.email=t@t commit -qm i >/dev/null 2>&1 )
printf 'nogate\n' > "$NGREPO/.felix"; printf 'dirty\n' >> "$NGREPO/a.txt"
out="$(_stop "$NGREPO")"
_allows "a project with no declared gate is left alone" "$out"

# Felix governs projects in languages it does not know, and one of their
# untracked directories may be a virtualenv or a model artifact. Metadata only.
mkdir -p "$GREPO/bigdir"
i=0; while [ "$i" -lt 60 ]; do printf 'x\n' > "$GREPO/bigdir/f$i"; i=$((i+1)); done
t0=$(date +%s); out="$(_stop "$GREPO")"; t1=$(date +%s)
[ $((t1-t0)) -le 3 ] && ok "stays fast with many untracked files ($((t1-t0))s)" \
                     || bad "stays fast with many untracked files" "$((t1-t0))s"
rm -rf "$GREPO/bigdir"

# The gate and the hook compute tree identity independently. If they ever
# disagree the gate silently stops counting, so they must share one function.
tid_lib="$( . "$FROOT/harness/lib/verify.sh"; felix_tree_id "$GREPO" )"
[ -n "$tid_lib" ] && ok "tree identity is computable" \
                  || bad "tree identity is computable" "empty"
printf 'moved\n' >> "$GREPO/WIDGET.txt"
tid2="$( . "$FROOT/harness/lib/verify.sh"; felix_tree_id "$GREPO" )"
[ "$tid_lib" != "$tid2" ] && ok "and changes when the tree changes" \
                          || bad "and changes when the tree changes" "$tid_lib == $tid2"
( cd "$GREPO" && git checkout -q -- WIDGET.txt )

# A repository with no commits at all. HEAD is unborn, and every naive
# implementation of this dies there. The suite's own fixture is in that state.
UNBORN="$TMP/unborn"; mkdir -p "$UNBORN"
( cd "$UNBORN" && git init -q -b main )
printf 'widget\n' > "$UNBORN/.felix"; printf 'x\n' > "$UNBORN/new.txt"
tid3="$( . "$FROOT/harness/lib/verify.sh"; felix_tree_id "$UNBORN" )"
[ -n "$tid3" ] && ok "tree identity survives an unborn HEAD" \
               || bad "tree identity survives an unborn HEAD" "empty"
out="$(_stop "$UNBORN")"; rc=$?
is "and the hook still exits 0 there" "$rc" "0"

# Felix governing itself: the home lives INSIDE the tree being gated, so every
# receipt, verification line and route line lands in the repo it describes.
# Writing a receipt then changes the tree, which invalidates the receipt just
# written, and no gate run can ever produce a valid one. The fixture above hides
# this entirely because there the home sits outside the governed repo — which is
# why this reproduces the real layout instead.
SELF="$TMP/selfgoverned"
mkdir -p "$SELF/projects/self/memory" "$SELF/harness"
cp -R "$REAL_HARNESS/." "$SELF/harness/"
cat > "$SELF/projects/self/project.json" <<'EOF'
{ "name": "self", "gate": "true" }
EOF
printf '# self\n' > "$SELF/projects/self/CLAUDE.md"
( cd "$SELF" && git init -q -b main && printf 'x\n' > code.txt && printf 'self\n' > .felix
  git add -A >/dev/null 2>&1
  git -c user.name=t -c user.email=t@t commit -qm i >/dev/null 2>&1 )
SELF="$(cd "$SELF" && pwd -P)"
printf 'real work\n' >> "$SELF/code.txt"
( cd "$SELF" && FELIX_HOME="$SELF" "$SELF/harness/felix" gate >/dev/null 2>&1 )
out="$(cd "$SELF" && FELIX_HOME="$SELF" printf '%s' "$EMPTY_JSON" \
        | FELIX_HOME="$SELF" "$SELF/harness/hooks/stop" 2>&1)"
_allows "a receipt survives being written inside the tree it describes" "$out"
# And a second stop, which appends another verification line, must also pass.
out="$(cd "$SELF" && FELIX_HOME="$SELF" printf '%s' "$EMPTY_JSON" \
        | FELIX_HOME="$SELF" "$SELF/harness/hooks/stop" 2>&1)"
_allows "and keeps surviving as its own log grows" "$out"
# Real work still has to be verified, bookkeeping exemption or not.
printf 'more real work\n' >> "$SELF/code.txt"
out="$(cd "$SELF" && FELIX_HOME="$SELF" printf '%s' "$EMPTY_JSON" \
        | FELIX_HOME="$SELF" "$SELF/harness/hooks/stop" 2>&1)"
_blocks "but a real edit still blocks" "$out"

printf '\nthe intent router\n'
# Say what you are doing and get the right kit, without naming it. The chain is
# routes.tsv -> profiles.tsv -> stack.tsv, and only the first link is new.
cp "$REAL_HARNESS/templates/routes.tsv"   "$FROOT/projects/widget/routes.tsv"
cp "$REAL_HARNESS/templates/profiles.tsv" "$FROOT/projects/widget/profiles.tsv"
cat > "$FROOT/projects/widget/stack.tsv" <<'EOF'
plugin	frontend-design@claude-plugins-official	-	low	frontend
plugin	playwright@claude-plugins-official	-	low	e2e
skill	impeccable	-	low	frontend
EOF
printf 'frontend\ne2e\n' > "$FROOT/projects/widget/capabilities"

_route() { ( cd "${2:-$REPO}" && "$FELIX" route --for "$1" 2>&1 ); }

out="$(_route "let us build the results page")"
has "a frontend prompt routes to frontend" "$out" "frontend"
has "and names the play in order"          "$out" "frontend-design"
has "with the critique step after it"      "$out" "impeccable"

# The prompt is what you just said; the tree is only where you are standing.
# Without weighting, a dirty frontend tree drags every question toward frontend.
mkdir -p "$REPO/ui"; printf 'x\n' > "$REPO/ui/page.css"
out="$(_route "add a migration for the endpoint schema")"
has "the prompt outweighs the working tree" "$out" "backend"
rm -rf "$REPO/ui"

# Below the threshold nothing is said at all. One stray path token must not be
# enough to decide what you meant.
out="$(_route "ok")"
is "a prompt with no signal says nothing" "${#out}" "0"

# Two corroborating tree tokens do meet the threshold, on purpose. But a route
# the tree chose is a different claim from one you asked for, and presenting the
# second as the first is quietly lying about why.
mkdir -p "$REPO/ui"; printf 'x\n' > "$REPO/ui/page.css"; printf 'x\n' > "$REPO/ui/component.js"
out="$(_route "ok")"
has "the working tree alone can route"       "$out" "frontend"
has "and says so rather than implying I did" "$out" "working tree"
out="$(_route "render the modal component")"
case "$out" in
  *"working tree"*) bad "a typed intent is not labelled a guess" "$out" ;;
  *) ok "a typed intent is not labelled a guess" ;;
esac
rm -rf "$REPO/ui"

out="$(cd "$REPO" && "$FELIX" route --for "let us build the results page" --explain 2>&1)"
has "explain shows the losing routes too" "$out" "build"

# A play entry the project never declared is named, not hidden. It is the seam
# to the discovery slice, and silently dropping it would hide the gap.
cat >> "$FROOT/projects/widget/routes.tsv" <<'EOF'
ghost	nonesuch	frontend	not-declared-anywhere
EOF
out="$(_route "nonesuch")"
has "an undeclared tool is reported, not hidden" "$out" "not declared"

# A malformed row must not take the file down with it.
printf 'broken-row-with-no-tabs\n' >> "$FROOT/projects/widget/routes.tsv"
out="$(_route "let us build the results page")"
has "a malformed row is skipped, others still match" "$out" "frontend"

# The hook is handed the whole payload, so the envelope's own field names are in
# the token stream. A route keyed on one of them scored on every single turn
# whatever was typed, which is invisible until a project's subject matter
# happens to be prompts. Found by running the hook against a real repository.
cat >> "$FROOT/projects/widget/routes.tsv" <<'EOF'
envelope	prompt session transcript permission	frontend	-
EOF
out="$(cd "$REPO" && printf '{"session_id":"s","prompt":"the migration schema needs an index"}' | "$FROOT/harness/hooks/user-prompt" 2>&1)"
case "$out" in
  *envelope*) bad "the payload envelope does not decide the route" "$out" ;;
  *) ok "the payload envelope does not decide the route" ;;
esac
# ...but the words themselves must survive. Banning them was the first fix and
# was worse than the bug: asking about a hook matched nothing at all, because
# the word had been blacklisted to silence a field name of the same name.
toks="$( . "$FROOT/harness/lib/route.sh"
         felix_route_tokens '{"session_id":"s","prompt":"the stop hook is blocking"}' | tr '\n' ' ' )"
has  "a word shared with a field name still counts" "$toks" "hook"
case "$toks" in
  *session_id*|*" session "*) bad "but the field names themselves are gone" "$toks" ;;
  *) ok "but the field names themselves are gone" ;;
esac

# The keys were the half that got fixed. The VALUES are still in the stream, and
# they are worse: transcript_path and cwd carry the whole checkout path, so a
# home directory called Documents or a worktree branch named ...-review-... puts
# those words in as if they had been typed — at double weight, which is the
# score reserved for what you actually said. Found by watching `continue` route
# to a document skill.
out="$(cd "$REPO" && printf '{"session_id":"s","transcript_path":"/home/u/migration-schema-endpoint/a.jsonl","cwd":"/home/u/queue-worker","prompt":"the button layout is wrong"}' \
       | "$FROOT/harness/hooks/user-prompt" 2>&1)"
case "$out" in
  *backend*) bad "a path in the envelope does not decide the route" "$out" ;;
  *) ok "a path in the envelope does not decide the route" ;;
esac
# Asserted on tokens, not on the hook's output: the hook announces only when the
# route changes, so a presence check there passes or fails on prior state rather
# than on the thing being tested.
toks="$( . "$FROOT/harness/lib/route.sh"
         felix_route_tokens '{"transcript_path":"/home/u/migration-schema-endpoint/a.jsonl","prompt":"the button layout is wrong"}' | tr '\n' ' ' )"
has "and what was typed still counts" "$toks" "layout"
case "$toks" in
  *migration*|*endpoint*) bad "while the path around it does not" "$toks" ;;
  *) ok "while the path around it does not" ;;
esac

toks="$( . "$FROOT/harness/lib/route.sh"
         felix_route_tokens '{"transcript_path":"/home/u/documents-felix/a.jsonl","prompt":"continue"}' | tr '\n' ' ' )"
case "$toks" in
  *documents*|*jsonl*) bad "envelope path values are gone from the tokens" "$toks" ;;
  *) ok "envelope path values are gone from the tokens" ;;
esac
# A path the person actually typed is theirs, and must still route.
toks="$( . "$FROOT/harness/lib/route.sh"
         felix_route_tokens '{"prompt":"fix src/queue/worker.py"}' | tr '\n' ' ' )"
has "a path you typed yourself still counts" "$toks" "worker"

# The tree may corroborate, never outvote. Without a cap, a checkout carrying a
# few hundred untracked path tokens drowns out the four words you typed.
mkdir -p "$REPO/noise"
i=0; while [ "$i" -lt 40 ]; do printf 'x\n' > "$REPO/noise/component-layout-styling-$i.css"; i=$((i+1)); done
out="$(_route "add a migration for the endpoint schema")"
has "a wall of tree tokens cannot outvote the prompt" "$out" "backend"
rm -rf "$REPO/noise"

RHK="$FROOT/harness/hooks/user-prompt"
S1='{"session_id":"sess-aaa","prompt":"let us build the results page"}'
S2='{"session_id":"sess-aaa","prompt":"let us build the results page again"}'
S3='{"session_id":"sess-aaa","prompt":"add a migration for the endpoint schema"}'
_hook() { ( cd "$REPO" && printf '%s' "$1" | "$RHK" 2>&1 ); }
_ctx() { printf '%s' "$1" | python3 -c 'import json,sys;print(json.load(sys.stdin)["hookSpecificOutput"]["additionalContext"])' 2>/dev/null; }

rm -rf "$FROOT/state/route"
out="$(_hook "$S1")"; ctx="$(_ctx "$out")"
has "the hook routes on the first prompt" "$ctx" "frontend"
# One block, not two. Two injections fight for the same attention.
n="$(printf '%s' "$out" | grep -c 'hookSpecificOutput')"
is "route and lessons arrive as one block" "$n" "1"

# A prompt where both genuinely apply. Two injections competing for the same
# attention is how both get skimmed, so they must arrive as one.
rm -rf "$FROOT/state/route"
out="$(_hook '{"session_id":"sess-bbb","prompt":"add a migration for the endpoint schema rollback"}')"
ctx="$(_ctx "$out")"
has "the route is there when both apply" "$ctx" "backend"
has "and the lesson is in the same block" "$ctx" "L-1"
n="$(printf '%s' "$out" | grep -c 'hookSpecificOutput')"
is "still exactly one block"              "$n" "1"
rm -rf "$FROOT/state/route"
out="$(_hook "$S1")" >/dev/null 2>&1

out="$(_hook "$S2")"; ctx="$(_ctx "$out")"
case "$ctx" in
  *"routed this to"*) bad "the same route does not repeat itself" "$ctx" ;;
  *) ok "the same route does not repeat itself" ;;
esac

out="$(_hook "$S3")"; ctx="$(_ctx "$out")"
has "a change of route speaks again" "$ctx" "backend"

# State is a convenience. Losing it must cost a repeated block, never a session.
chmod 000 "$FROOT/state/route" 2>/dev/null
out="$(cd "$REPO" && printf '%s' "$S1" | "$RHK" 2>&1)"; rc=$?
is "an unwritable state directory still exits 0" "$rc" "0"
chmod 755 "$FROOT/state/route" 2>/dev/null

RLOG="$FROOT/projects/widget/memory/routes.log"
[ -s "$RLOG" ] && ok "every decision is logged" || bad "every decision is logged" "no $RLOG"
grep -q 'frontend' "$RLOG" 2>/dev/null && ok "hits are logged" || bad "hits are logged"
out="$(_route "zzzquux flibbertigibbet")" >/dev/null 2>&1
out="$(_route "zzzquux flibbertigibbet")" >/dev/null 2>&1
out="$(_route "zzzquux wobblethorpe")"    >/dev/null 2>&1
grep -q '	-	' "$RLOG" 2>/dev/null && ok "misses are logged too" || bad "misses are logged too"

out="$(cd "$REPO" && "$FELIX" route --promote 2>&1)"
has "promote surfaces a word that keeps missing" "$out" "zzzquux"

out="$(cd "$PLAIN" && "$FELIX" route --for "build the results page" 2>&1)"; rc=$?
[ "$rc" -ne 0 ] && ok "route refuses outside a governed repo" \
                || bad "route refuses outside a governed repo" "$out"

# `felix install` tells you to put the CLI on PATH with a symlink. Following
# that instruction resolved SCRIPT_DIR to the directory the link sits in, so
# every library source missed and the command died on its first line. The
# documented way to make Felix convenient was the one way to break it.
printf '\non PATH via a symlink\n'
mkdir -p "$TMP/bin"
ln -sf "$FELIX" "$TMP/bin/felix"
out="$(cd "$REPO" && "$TMP/bin/felix" which 2>&1)"
has "resolves its libraries through a symlink" "$out" "project:      widget"
out="$(cd "$REPO" && "$TMP/bin/felix" gate 2>&1)"; rc=$?
is "and the gate still runs through it" "$rc" "0"

printf '\njust in time, not all at once\n'
# Naming a whole play at the first prompt tells an agent to critique and
# browser-test something that does not exist yet, and spends context saying so.
# A play is a sequence: only the step that is actually due gets named.
TR="$TMP/transcript.jsonl"
: > "$TR"
J1="{\"session_id\":\"jit-1\",\"transcript_path\":\"$TR\",\"prompt\":\"the results page layout needs work\"}"
rm -rf "$FROOT/state/route"
out="$(cd "$REPO" && printf '%s' "$J1" | "$RHK" 2>&1)"; ctx="$(_ctx "$out")"
has "names the first step"        "$ctx" "frontend-design"
case "$ctx" in
  *"Use this now: impeccable"*) bad "does not demand the later steps yet" "$ctx" ;;
  *) ok "does not demand the later steps yet" ;;
esac
has "but says what may come later" "$ctx" "Later, only if"

# Once the transcript shows step one was used, step two becomes the due one.
printf '{"type":"assistant","attributionSkill":"frontend-design:frontend-design"}\n' >> "$TR"
J2="{\"session_id\":\"jit-1\",\"transcript_path\":\"$TR\",\"prompt\":\"the results page layout still needs work\"}"
out="$(cd "$REPO" && printf '%s' "$J2" | "$RHK" 2>&1)"; ctx="$(_ctx "$out")"
has "advances to the next step once the first is used" "$ctx" "Use this now: impeccable"

# A plugin that ships an MCP server is used by calling its tools, not a skill.
printf '{"type":"assistant","attributionSkill":"impeccable"}\n' >> "$TR"
printf '{"name":"mcp__plugin_playwright_playwright__browser_navigate"}\n' >> "$TR"
out="$(cd "$REPO" && printf '%s' "$J2" | "$RHK" 2>&1)"; ctx="$(_ctx "$out")"
case "$ctx" in
  *"Use this now:"*) bad "stops naming tools once the play is done" "$ctx" ;;
  *) ok "stops naming tools once the play is done" ;;
esac

# And at the finish line, a step the session never used is worth one sentence.
: > "$TR"
printf 'edit\n' >> "$REPO/WIDGET.txt"
( cd "$REPO" && "$FELIX" gate >/dev/null 2>&1 )
mkdir -p "$FROOT/state/route"; printf 'frontend:frontend-design' > "$FROOT/state/route/jit-2"
SJ="{\"hook_event_name\":\"Stop\",\"stop_hook_active\":false,\"session_id\":\"jit-2\",\"transcript_path\":\"$TR\"}"
out="$(cd "$REPO" && printf '%s' "$SJ" | "$STOP" 2>&1)"
has "says what was skipped at the finish"  "$out" "never used"
case "$out" in
  *'"decision"'*'"block"'*) bad "but does not hold the session for it" "$out" ;;
  *) ok "but does not hold the session for it" ;;
esac
( cd "$REPO" && git checkout -q -- WIDGET.txt 2>/dev/null || printf 'contents\n' > "$REPO/WIDGET.txt" )

printf '\nvisible at all\n'
# Felix ships no skills and no commands and costs a session nothing, which is
# the point and also why somebody looked for it, found nothing anywhere, and
# reasonably concluded it was not installed. additionalContext reaches the
# model; systemMessage reaches the person.
out="$(cd "$REPO" && CLAUDE_PLUGIN_ROOT="$FROOT" "$FROOT/harness/hooks/session-start" 2>&1)"
case "$out" in
  *'"systemMessage"'*) ok "says something to the founder, not only the model" ;;
  *) bad "says something to the founder, not only the model" "$out" ;;
esac
line="$(printf '%s' "$out" | python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("systemMessage",""))
except Exception: print("")' 2>/dev/null)"
has "and names the project"  "$line" "widget"
# One line. A briefing repeated every session is one people stop reading.
n="$(printf '%s' "$line" | wc -l | tr -d ' ')"
[ "${n:-0}" -le 1 ] && ok "and stays to one line" || bad "and stays to one line" "$line"
# The model still gets the full briefing.
case "$out" in *'"additionalContext"'*) ok "the model still gets the whole thing" ;;
  *) bad "the model still gets the whole thing" "$out" ;; esac

# The one entry point, for somebody who has never seen Felix.
[ -f "$FROOT/../engine/commands/felix.md" ] || [ -f "$REAL_HARNESS/../commands/felix.md" ] \
  && ok "ships a slash command to be found by" \
  || bad "ships a slash command to be found by" "no commands/felix.md"

printf '\na failure nobody wrote down\n'
# Felix has had `felix lesson` from the beginning, and a mechanism nobody uses
# is half a mechanism. This fires only when the gate actually caught something
# and nothing was written since — most sessions teach nothing, and a prompt
# that fires every time is one people learn to dismiss.
GP="$FROOT/projects/guarded"; mkdir -p "$GP/memory"
: > "$GP/memory/lessons.md"; : > "$GP/memory/DEVLOG.md"
out="$( . "$FROOT/harness/lib/guard.sh"; felix_guard_unrecorded "$GP" )"
is "silent when the gate has caught nothing" "${#out}" "0"

printf '2026-01-01\tmain\tabc123\tlint\n' > "$GP/memory/mistakes.log"
out="$( . "$FROOT/harness/lib/guard.sh"; felix_guard_unrecorded "$GP" )"
has "speaks when a catch went unexplained" "$out" "nothing has been written down"
has "and names what was caught"            "$out" "lint"

# Writing a lesson settles the debt; it must then go quiet.
sleep 1; printf -- '- **something learned**\n' > "$GP/memory/lessons.md"
out="$( . "$FROOT/harness/lib/guard.sh"; felix_guard_unrecorded "$GP" )"
is "and stops once something is written" "${#out}" "0"

# An old debt is history, not something this session can explain.
printf '2020-01-01\tmain\tabc\told\n' > "$GP/memory/mistakes.log"
touch -t 202001010000 "$GP/memory/mistakes.log" 2>/dev/null
out="$( . "$FROOT/harness/lib/guard.sh"; felix_guard_unrecorded "$GP" )"
is "and does not nag about ancient history" "${#out}" "0"
rm -rf "$GP"

printf '\nnoticing when another plugin breaks the session\n'
# A plugin that ships hooks is a dependency on that plugin working. When one
# refuses, the error lands on the tool rather than on the plugin that caused
# it, so it reads as the editor being broken. Claude Code records these
# properly, which is what makes noticing them cheap.
GT="$TMP/guard.jsonl"
cat > "$GT" <<'JSONL'
{"type":"attachment","attachment":{"type":"hook_blocking_error","hookName":"PostToolUse:Write","hookEvent":"PostToolUse","blockingError":{"blockingError":"Not logged into Semgrep Guardian. Ask the guardian mcp to login.","command":"bash x"}}}
{"type":"attachment","attachment":{"type":"hook_blocking_error","hookName":"PostToolUse:Write","hookEvent":"PostToolUse","blockingError":{"blockingError":"Not logged into Semgrep Guardian. Ask the guardian mcp to login.","command":"bash x"}}}
{"type":"assistant","message":{"content":[]}}
JSONL
rows="$( . "$FROOT/harness/lib/guard.sh"; felix_guard_blocks "$GT" )"
has "counts what was blocked"     "$rows" "2"
has "and names the hook"          "$rows" "PostToolUse:Write"
has "and quotes what it said"     "$rows" "Not logged into Semgrep"
# A transcript with no blocks must say nothing at all.
printf '{"type":"assistant"}\n' > "$TMP/clean.jsonl"
q="$( . "$FROOT/harness/lib/guard.sh"; felix_guard_blocks "$TMP/clean.jsonl" )"
is "silent when nothing was blocked" "${#q}" "0"
# A missing transcript is a fact, not a crash.
q="$( . "$FROOT/harness/lib/guard.sh"; felix_guard_blocks "$TMP/nope.jsonl" )"; rc=$?
is "survives a transcript that is not there" "$rc" "0"

out="$(cd "$REPO" && "$FELIX" quarantine definitely-not-installed 2>&1)"; rc=$?
[ "$rc" -ne 0 ] && ok "quarantine refuses a plugin that is not here" \
                || bad "quarantine refuses a plugin that is not here" "$out"

printf '\ndiscovery runs on a cadence, not in front of a prompt\n'
DH="$TMP/dhome"; mkdir -p "$DH/state/discover"
DP="$FROOT/projects/widget"
# Never refreshed is stale; that is what makes the first run happen at all.
( . "$FROOT/harness/lib/discover.sh"; felix_discover_stale "$DP" "$DH" ) \
  && ok "a cache that never existed is stale" || bad "a cache that never existed is stale"
printf 'deepeval\tllm\tlow\nlangfuse\tllm\tlow\n' > "$DH/state/discover/widget.tsv"
( . "$FROOT/harness/lib/discover.sh"; felix_discover_stale "$DP" "$DH" ) \
  && bad "a fresh cache is not stale" || ok "a fresh cache is not stale"
new="$( . "$FROOT/harness/lib/discover.sh"; felix_discover_unseen "$DP" "$DH" | tr '\n' ' ' )"
has "reports findings the first time" "$new" "deepeval"
( . "$FROOT/harness/lib/discover.sh"; felix_discover_mark_seen "$DP" "$DH" )
new="$( . "$FROOT/harness/lib/discover.sh"; felix_discover_unseen "$DP" "$DH" )"
is "and never mentions the same one twice" "${#new}" "0"
# Something genuinely new must still get through.
printf 'sonarqube\tsecrets\thigh\n' >> "$DH/state/discover/widget.tsv"
new="$( . "$FROOT/harness/lib/discover.sh"; felix_discover_unseen "$DP" "$DH" | tr '\n' ' ' )"
has "but a new one does get through" "$new" "sonarqube"

printf '\ndiscovery reads before it recommends\n'
# The plugin format has no permission declaration and `claude plugin validate`
# checks schema only, so the only way to know what something does is to read it.
# Fixtures throughout: this must never touch the network to be tested.
DF="$TMP/discover-fixtures"
mkdir -p "$DF/skillsonly/skills/a" "$DF/hooky/hooks" "$DF/mcplocal" "$DF/floaty" "$DF/creds"
printf '{"mcpServers":{"x":{"command":"/usr/local/bin/x","args":["run"]}}}\n' > "$DF/mcplocal/.mcp.json"
printf '{"hooks":{"PreToolUse":[{"hooks":[{"command":"bash s.sh"}]}]}}\n'     > "$DF/hooky/hooks/hooks.json"
printf '{"mcpServers":{"x":{"command":"npx","args":["pkg@latest"]}}}\n'       > "$DF/floaty/.mcp.json"
printf '{"mcpServers":{"x":{"type":"http","url":"https://e.example","headers":{"Authorization":"${SECRET_TOKEN}"}}}}\n' > "$DF/creds/.mcp.json"

_tier() { ( . "$FROOT/harness/lib/discover.sh"
            felix_discover_risk "$(felix_discover_inspect "$1")" ); }
is "skills only is low"                  "$(_tier "$DF/skillsonly")" "low"
is "a pinned local server is medium"     "$(_tier "$DF/mcplocal")"   "medium"
is "anything shipping hooks is high"     "$(_tier "$DF/hooky")"      "high"
is "an unpinned version is high"         "$(_tier "$DF/floaty")"     "high"
is "interpolating a credential is high"  "$(_tier "$DF/creds")"      "high"

printf '\nthe ledger: recorded as it happens, never parsed after\n'
# The slice stayed unbuilt because its own spec contradicted itself: the body
# said transcript parsing breaks the bash-and-git invariant, and the Records
# section described a hook that parses a transcript. Recording needs no parser.
_sig() { ( . "$FROOT/harness/lib/ledger.sh"; felix_ledger_signal "$1" ); }
is "a plain tool is recorded by name" \
   "$(_sig '{"tool_name":"Bash"}')" "tool	Bash"
is "an mcp call is recorded by server" \
   "$(_sig '{"tool_name":"mcp__github__create_issue"}')" "mcp	github"
is "a skill is recorded by which skill" \
   "$(_sig '{"tool_name":"Skill","tool_input":{"skill":"superpowers:brainstorming"}}')" \
   "skill	superpowers:brainstorming"
is "an unparseable payload records nothing" "$(_sig 'not json')" ""

LH="$TMP/ledgerhome"; LP="$LH/projects/widget"; mkdir -p "$LP/memory"
printf 'plugin\tsuperpowers@x\t-\tlow\talways\nplugin\tplaywright@x\t-\tlow\te2e\n' > "$LP/stack.tsv"
( . "$FROOT/harness/lib/ledger.sh"
  felix_ledger_record "$LH" sess1 "tool	Bash"
  felix_ledger_record "$LH" sess1 "tool	Bash"
  felix_ledger_record "$LH" sess1 "skill	superpowers:brainstorming" )
n="$( . "$FROOT/harness/lib/ledger.sh"; wc -l < "$LH/state/ledger/sess1.tsv" | tr -d ' ' )"
is "every call is appended" "$n" "3"

( . "$FROOT/harness/lib/ledger.sh"; felix_ledger_rollup "$LP" "$LH" sess1 2026-08-11 )
led="$(cat "$LP/memory/ledger.tsv" 2>/dev/null)"
has "counts repeated calls once with a total" "$led" "tool	Bash	2"
has "and a skill that was invoked"            "$led" "skill	superpowers:brainstorming	1"
# The zero rows are the whole point. Presence without use is the only
# unconfounded signal in the design and it does not exist unless it is written.
has "writes a zero row for a declared tool nobody reached for" "$led" "playwright@x	0"
case "$led" in
  *"superpowers@x	0"*) bad "and no zero row for one that was used" "$led" ;;
  *)                     ok  "and no zero row for one that was used" ;;
esac
( . "$FROOT/harness/lib/ledger.sh"; felix_ledger_rollup "$LP" "$LH" sess1 2026-08-11 )
n="$(grep -c '^sess1' "$LP/memory/ledger.tsv")"
is "rolling the same session twice does not double it" "$n" "3"

printf '\nreading the ledger, in the one direction that is honest\n'
# Written rows nothing reads is the same half-built shape as installing a tool
# no route can reach. Aggregation reduces to the owner, because a package is
# declared as superpowers@marketplace and invoked as superpowers:brainstorming.
LR="$TMP/ledgerread"; mkdir -p "$LR/memory"
cat > "$LR/memory/ledger.tsv" <<'EOF'
s1	2026-08-01	skill	superpowers:brainstorming	3
s1	2026-08-01	plugin	playwright@x	0
s1	2026-08-01	plugin	context7@x	0
s2	2026-08-02	plugin	superpowers@x	0
s2	2026-08-02	plugin	playwright@x	0
s2	2026-08-02	mcp	context7	2
EOF
sum="$( . "$FROOT/harness/lib/ledger.sh"; felix_ledger_summary "$LR" )"
has "counts a package and its skill as one thing" "$sum" "superpowers	2	3"
has "sums invocations across sessions"            "$sum" "context7	2	2"
has "and keeps a never-invoked one at zero"       "$sum" "playwright	2	0"

# The asymmetry: only absence of use given presence is unconfounded, so only
# retirement is ever proposed and never the reverse.
p="$( . "$FROOT/harness/lib/ledger.sh"; FELIX_LEDGER_MIN=2 felix_ledger_retire "$LR" | tr '\n' ' ' )"
has "proposes retiring what was mounted and never reached for" "$p" "playwright"
case "$p" in
  *superpowers*) bad "never proposes retiring something that was used" "$p" ;;
  *context7*)    bad "never proposes retiring something that was used" "$p" ;;
  *)             ok  "never proposes retiring something that was used" ;;
esac
# Two sessions is not evidence. The window is sessions, not time, and a capability
# unused across two of them may simply not have come up yet.
p="$( . "$FROOT/harness/lib/ledger.sh"; FELIX_LEDGER_MIN=5 felix_ledger_retire "$LR" | tr -d '\n ' )"
is "and says nothing below the session threshold" "$p" ""

printf '\none rule for what a thing looks like\n'
# There were two matchers and they drifted. One scored a marketplace blurb, the
# other scored the name alone, nothing said they had to agree, and a plugin got
# installed under a capability the other matcher would not have given it.
CR="$(printf 'llm\tllm prompt eval evaluation\nfrontend\tpage component styling')"
_cm() { ( . "$FROOT/harness/lib/discover.sh"; felix_capability_match "$1" "$2" "$CR" ); }
is "a name counts triple"            "$(_cm evaltool '' | cut -f1)" "3"
is "and prose counts single"         "$(_cm zzz 'about prompt things' | cut -f1)" "1"
is "prose alone can still add up"    "$(_cm zzz 'an llm platform for prompt management and evaluation' | cut -f1)" "4"
is "the best capability wins"        "$(_cm zzz 'page component styling' | cut -f2)" "frontend"
is "and nothing matching scores nil" "$(_cm zzz 'a database migration tool' | cut -f1)" "0"

# The manifest, not the listing. A catalogue blurb is written to be chosen from;
# a manifest is written to describe.
DD="$TMP/desc/.claude-plugin"; mkdir -p "$DD"
printf '{"name":"x","description":"an llm evaluation harness"}\n' > "$DD/plugin.json"
d="$( . "$FROOT/harness/lib/discover.sh"; felix_plugin_description "$TMP/desc" )"
has "reads a plugin's own description" "$d" "llm evaluation harness"
d="$( . "$FROOT/harness/lib/discover.sh"; felix_plugin_description "$TMP/nosuchdir" )"
is "and is silent when there is none" "$d" ""

printf '\ndoctor fixes what it can instead of reporting it\n'
# A founder should never be told where a duplicate script lives. Felix holds the
# authoritative copy, so removing the lookalike loses nothing and is exactly the
# reversible work the charter says to do rather than escalate.
mkdir -p "$REPO/scripts"
printf '#!/bin/sh\necho felix copy\n' > "$FROOT/projects/widget/prepush.sh"
printf '#!/bin/sh\necho stale repo copy\n' > "$REPO/scripts/prepush.sh"
chmod +x "$FROOT/projects/widget/prepush.sh" "$REPO/scripts/prepush.sh"
# A gate-named script Felix does NOT hold. Removing this would destroy the only
# copy, so it stays and is reported.
printf '#!/bin/sh\necho mine\n' > "$REPO/scripts/gate-extra.sh"; chmod +x "$REPO/scripts/gate-extra.sh"

out="$(cd "$REPO" && "$FELIX" doctor --fix 2>&1)"
[ -f "$REPO/scripts/prepush.sh" ] && bad "removes a copy of a file Felix holds" \
                                  || ok  "removes a copy of a file Felix holds"
[ -f "$REPO/scripts/gate-extra.sh" ] && ok  "and keeps one Felix does not hold" \
                                     || bad "and keeps one Felix does not hold"
has "saying why it kept it" "$out" "gate-extra.sh"
# Nothing is destroyed. The copy is recoverable even though git never tracked it.
ls "$FROOT/state/rivals"/*prepush* >/dev/null 2>&1 \
  && ok "backs the removed copy up first" || bad "backs the removed copy up first"
out="$(cd "$REPO" && "$FELIX" doctor --fix 2>&1)"
case "$out" in
  *"prepush.sh"*) bad "and says nothing about it afterwards" "$out" ;;
  *)              ok  "and says nothing about it afterwards" ;;
esac
rm -rf "$REPO/scripts" "$FROOT/projects/widget/prepush.sh"

printf '\nthe toolbox: reach, analyse, and whether anything can route it\n'
# Felix could read a plugin it had fetched from a marketplace and could not read
# one already installed, which is the one it will actually be asked about. The
# shape is identical, so this is a path resolver rather than a second analyser.
TB="$TMP/plugincache"
mkdir -p "$TB/mkt/alpha/1.9.0/skills/one" "$TB/mkt/alpha/1.10.0/skills/one" \
         "$TB/mkt/alpha/1.10.0/skills/two" "$TB/mkt/hooky/0.1.0/hooks"
printf '{"hooks":{}}\n' > "$TB/mkt/hooky/0.1.0/hooks/hooks.json"

p="$( . "$FROOT/harness/lib/toolbox.sh"; FELIX_PLUGIN_CACHE="$TB" felix_toolbox_path alpha )"
is "resolves an installed plugin to its newest version" "$(basename "$p")" "1.10.0"
# 1.10.0 beats 1.9.0 only under -V. The gate's installed check was once wrong
# for exactly this reason, picking a directory nothing loads.
p="$( . "$FROOT/harness/lib/toolbox.sh"; FELIX_PLUGIN_CACHE="$TB" felix_toolbox_path nosuch )" || true
is "and reports nothing for one it does not have" "$p" ""

sk="$( . "$FROOT/harness/lib/toolbox.sh"
       FELIX_PLUGIN_CACHE="$TB" felix_toolbox_skills "$(FELIX_PLUGIN_CACHE="$TB" felix_toolbox_path alpha)" | tr '\n' ' ' )"
has "lists the skills a plugin ships" "$sk" "one"
has "all of them"                    "$sk" "two"

# The last column is the point. A tool no route names is never reached for and
# costs context in every session anyway.
TP="$TMP/tbproj"; mkdir -p "$TP"
printf 'core\talways\nbackend\tapi,database\n'                        > "$TP/profiles.tsv"
printf 'web\tendpoint handler\tbackend\tplaywright\n'                 > "$TP/routes.tsv"
r="$( . "$FROOT/harness/lib/toolbox.sh"; felix_toolbox_routed "$TP" playwright && echo yes || echo no )"
is "sees a plugin a route already names" "$r" "yes"
r="$( . "$FROOT/harness/lib/toolbox.sh"; felix_toolbox_routed "$TP" deepeval && echo yes || echo no )"
is "and one no route names"              "$r" "no"

r="$( . "$FROOT/harness/lib/toolbox.sh"; felix_toolbox_route_for "$TP" database | tr '\n' ' ' )"
has "finds the route a capability belongs to" "$r" "web"
# The empty answer is the useful one: Elenchus declares llm, no profile covers
# it, and that is exactly why three tools adopted for llm can never be reached.
r="$( . "$FROOT/harness/lib/toolbox.sh"; felix_toolbox_route_for "$TP" llm | tr -d '\n ' )"
is "and says so plainly when none does" "$r" ""
# `always` must not act as a wildcard, or every capability routes to core and
# the report succeeds at everything and reports nothing.
r="$( . "$FROOT/harness/lib/toolbox.sh"; felix_toolbox_route_for "$TP" frontend | tr -d '\n ' )"
is "always is a profile, not a wildcard" "$r" ""

# Wiring a tool in. Appended, never reordered: a play is ordered and the router
# names the first unused entry, so inserting would change what gets reached for
# first, which is not what "also make this reachable" means.
printf '# a comment that explains why the row is here\n' >  "$TP/routes.tsv"
printf 'web\tendpoint handler\tbackend\tplaywright\n'     >> "$TP/routes.tsv"
printf 'bare\tthing\tbackend\t-\n'                        >> "$TP/routes.tsv"
( . "$FROOT/harness/lib/route.sh"; felix_route_append_play "$TP" web deepeval ) \
  && ok "wires a tool into a route" || bad "wires a tool into a route"
has "appended after what was there" "$(grep '^web' "$TP/routes.tsv")" "playwright deepeval"
has "and the comment survives"      "$(head -1 "$TP/routes.tsv")"     "explains why"
( . "$FROOT/harness/lib/route.sh"; felix_route_append_play "$TP" web deepeval ) \
  && bad "wiring the same tool twice is refused" || ok "wiring the same tool twice is refused"
( . "$FROOT/harness/lib/route.sh"; felix_route_append_play "$TP" nosuch deepeval ) \
  && bad "wiring into a route that does not exist is refused" \
  || ok "wiring into a route that does not exist is refused"
# `-` means no play. Appending to it would name a tool called "-".
( . "$FROOT/harness/lib/route.sh"; felix_route_append_play "$TP" bare semgrep ) >/dev/null
is "an empty play is replaced, not appended to" "$(grep '^bare' "$TP/routes.tsv" | cut -f4)" "semgrep"

printf '\ndiscovery declares what it has read and judged safe\n'
# Felix already read the candidate at its pinned sha and already scored the
# risk. Stopping there and handing the founder a shopping list was the
# governance charter talking: if the founder is thinking about tooling, Felix
# has failed. Declaring is a manifest edit, which detection was always allowed
# to do unattended.
AH="$TMP/adopthome"; mkdir -p "$AH/state/discover"
AP="$AH/projects/widget"; mkdir -p "$AP"
printf 'plugin\tlangfuse@x\t-\tlow\tllm\n' > "$AP/stack.tsv"
# A real cache: three tiers, one already declared, and — from the actual felix
# cache — prose where rows were expected. A parser that adopts a sentence is
# worse than one that adopts nothing.
cat > "$AH/state/discover/widget.tsv" <<'EOF'
deepeval	llm	low
langfuse	llm	low
figma	frontend	medium
outputai	llm	high
Nothing in the marketplaces matches what widget declares.
EOF
out="$( . "$FROOT/harness/lib/discover.sh"; felix_discover_adopt "$AP" "$AH" )"
has "a low-risk candidate is declared"        "$out" "declare	deepeval"
has "a medium one is refused"                 "$out" "refuse	figma"
has "and a high one is refused"               "$out" "refuse	outputai"
has "one already declared is left alone"      "$out" "already	langfuse"
case "$out" in
  *Nothing*|*marketplaces*) bad "prose in the cache is not adopted" "$out" ;;
  *)                        ok  "prose in the cache is not adopted" ;;
esac
n="$(printf '%s\n' "$out" | grep -c '^declare' || true)"
is "exactly one declaration from that cache" "$n" "1"

why="$( . "$FROOT/harness/lib/discover.sh"; felix_discover_why "$(felix_discover_inspect "$DF/creds")" )"
has "and says which variable it sends" "$why" "environment variable"

# The whole safety argument is that fetched source is read and never run. A
# fixture whose hook would create a sentinel proves it: if the file appears,
# this stage has stopped being static analysis.
mkdir -p "$DF/hostile/hooks"
printf '{"hooks":{"SessionStart":[{"hooks":[{"command":"touch %s/PWNED"}]}]}}\n' "$DF" > "$DF/hostile/hooks/hooks.json"
( . "$FROOT/harness/lib/discover.sh"; felix_discover_inspect "$DF/hostile" >/dev/null 2>&1 )
[ -e "$DF/PWNED" ] && bad "inspecting a plugin never runs it" "sentinel was created" \
                   || ok "inspecting a plugin never runs it"

# It recommends. It must never acquire.
before="$(cksum < "$FROOT/projects/widget/stack.tsv")"
out="$(cd "$REPO" && "$FELIX" discover 2>&1)"; rc=$?
after="$(cksum < "$FROOT/projects/widget/stack.tsv")"
is "discovery writes nothing" "$after" "$before"
out="$(cd "$REPO" && "$FELIX" discover --yes 2>&1)"; rc=$?
[ "$rc" -ne 0 ] && ok "there is no --yes" || bad "there is no --yes" "$out"

printf '\nseeing the whole toolbox\n'
# No single source knows every plugin. The CLI misses everything bundled into
# the binary; the on-disk registry misses it too; only the config records it.
# Felix has to work on somebody else's laptop, laid out however they left it,
# so the inventory unions every source and each one is optional.
INV="$( . "$FROOT/harness/lib/ready.sh"; felix_ready_inventory 2>/dev/null )"
if has_claude; then
  n_plug="$(printf '%s\n' "$INV" | grep -c '^plugin' || true)"
  [ "${n_plug:-0}" -gt 0 ] && ok "finds plugins ($n_plug)" || bad "finds plugins" "none"
else
  skip "finds plugins" "no claude CLI"
fi
# Nothing may appear twice however many sources reported it.
dupes="$(printf '%s\n' "$INV" | sort | uniq -d | grep -c . || true)"
is "no entry is listed twice" "${dupes:-0}" "0"
# A version string is not a plugin. The @inline scan picks them up otherwise.
case "$INV" in
  *"	1.0.0"*|*"	2.0.0"*) bad "version strings are not mistaken for plugins" "$INV" ;;
  *) ok "version strings are not mistaken for plugins" ;;
esac
# With no config and no CLI it must still answer from disk rather than die.
out="$( . "$FROOT/harness/lib/ready.sh"; HOME="$TMP/empty-home" felix_ready_inventory 2>&1 )"; rc=$?
is "survives a machine laid out differently" "$rc" "0"

printf '\ndetection reads what a project depends on\n'
DREPO="$TMP/detectrepo"; mkdir -p "$DREPO/src/web/static"
printf '[project]\ndependencies = ["anthropic>=0.40", "fastapi"]\n' > "$DREPO/pyproject.toml"
for i in 1 2 3; do printf 'x\n' > "$DREPO/src/web/static/a$i.js"; done
caps="$( . "$FROOT/harness/lib/detect.sh"; felix_detect "$DREPO" | sort -u | tr '\n' ' ' )"
has "an SDK dependency makes it an llm project" "$caps" "llm"
# package.json was the entire frontend test, which misses every web surface
# served by a backend.
has "a web surface counts without package.json" "$caps" "frontend"
printf '[package]\nname = "x"\n' > "$DREPO/Cargo.toml"
caps="$( . "$FROOT/harness/lib/detect.sh"; felix_detect "$DREPO" | sort -u | tr '\n' ' ' )"
has "a cargo crate is a rust project" "$caps" "rust"

printf '\nthe pre-flight\n'
# A skill can be invoked mid-turn; a plugin that is switched off cannot be
# switched on without a restart. So whether the router's picks will actually
# work is decided before a session starts, and it differs per project.
mkdir -p "$HOME/.claude/skills" 2>/dev/null || true
cat >> "$FROOT/projects/widget/stack.tsv" <<'EOF'
skill	widget-only-skill	-	low	always
EOF
cat >> "$FROOT/projects/widget/routes.tsv" <<'EOF'
preflight	preflightword	frontend	widget-only-skill never-declared-tool
EOF
out="$(cd "$REPO" && "$FELIX" ready 2>&1)"
has "reports a tool no manifest declares" "$out" "never-declared-tool"
has "and says why"                        "$out" "absent from stack.tsv"
# A standalone skill is a directory, not a package. Looking for it in the
# plugin list reported a working skill as missing, which is how a pre-flight
# check earns being ignored.
has "knows a standalone skill is not a plugin" "$out" "widget-only-skill"
case "$out" in
  *"widget-only-skill"*"not installed"*) bad "a skill is not looked up as a plugin" "$out" ;;
  *) ok "a skill is not looked up as a plugin" ;;
esac
# Reporting a clean bill when nothing could be checked is the failure this
# project keeps re-finding.
case "$out" in
  *"could not be checked"*|*"cannot be used"*|*"switched on."*) ok "the summary matches what was actually checked" ;;
  *) bad "the summary matches what was actually checked" "$out" ;;
esac
# Felix has to know the whole inventory, not just its own list. A table naming
# one plugin five times while thirty others sit idle is a habit, not a router.
# This section also guards a bash-3.2 trap: a `case` pattern's closing paren
# inside $( ) ends the substitution, which parses fine under zsh and dies the
# moment the real CLI runs it. Only running the CLI catches that.
if has_claude; then
  case "$out" in
    *"never reached for"*) ok "reports what is installed but unused" ;;
    *) bad "reports what is installed but unused" "$out" ;;
  esac
else
  skip "reports what is installed but unused" "no claude CLI"
fi
case "$out" in
  *"syntax error"*|*"unbound variable"*) bad "the pre-flight runs clean under bash" "$out" ;;
  *) ok "the pre-flight runs clean under bash" ;;
esac

printf '\nkeeping what Felix said\n'
# Everything Felix tells a session goes out as additionalContext, which reaches
# the model and never the terminal. The logs recorded which route fired and
# what it scored; they did not record the words, so "why did Claude suddenly
# start using that skill" was unanswerable from anything Felix kept.
SP="$FROOT/projects/widget"
rm -f "$SP/memory/says.log"
( . "$FROOT/harness/lib/say.sh"
  felix_say "$SP" "brief" "line one
line two" "why I asked" "sess-42" )
[ -s "$SP/memory/says.log" ] && ok "records what it said" || bad "records what it said"
n="$(wc -l < "$SP/memory/says.log" | tr -d ' ')"
is "a multi-line utterance stays one greppable line" "$n" "1"
has "and keeps the session it was said in" "$(cut -f3 "$SP/memory/says.log")" "sess-42"
has "and keeps the prompt that caused it"   "$(cut -f4 "$SP/memory/says.log")" "why I asked"
has "with the newlines escaped, not lost"   "$(cut -f5 "$SP/memory/says.log")" 'line one\nline two'

# The hook must record the same words it sends, or the page is fiction.
rm -f "$SP/memory/says.log"
out="$(cd "$REPO" && printf '{"session_id":"sayer","prompt":"the migration schema needs an index"}' | "$RHK" 2>&1)"
sent="$(_ctx "$out" | head -1)"
kept="$(cut -f5 "$SP/memory/says.log" 2>/dev/null | head -1 | sed 's/\\n.*//')"
is "what it kept is what it sent" "$kept" "$sent"
has "and the cause is the prompt, not the envelope" \
    "$(cut -f4 "$SP/memory/says.log" 2>/dev/null)" "migration schema"
case "$(cut -f4 "$SP/memory/says.log" 2>/dev/null)" in
  *session_id*) bad "the cause is not the raw payload" "carried the envelope" ;;
  *) ok "the cause is not the raw payload" ;;
esac

# ...and the page shows it verbatim.
out="$(cd "$REPO" && "$FELIX" monitor 2>&1)"
MON2="$FROOT/state/monitor.html"
grep -q '"says"' "$MON2" && ok "the page carries the speech" || bad "the page carries the speech"
grep -q 'migration schema needs an index' "$MON2" \
  && ok "including what prompted each utterance" || bad "including what prompted each utterance"

  # A column was inserted into the middle of this record once. Read as the new
  # shape, an old line puts its text where the cause belongs, and the page
  # attributes a gate verdict to a prompt nobody typed. Both shapes must read.
  printf '%s\told-shape\tno session here\tthe words\n' "2020-01-01T00:00:00Z" >> "$SP/memory/says.log"
  ( cd "$REPO" && "$FELIX" monitor >/dev/null 2>&1 )
  if grep -q '"kind":"old-shape","session":"","cause":"no session here","text":"the words"' "$MON2"; then
    ok "a record from before the session column still reads"
  else
    bad "a record from before the session column still reads" \
        "$(grep -o '"kind":"old-shape"[^}]*' "$MON2" | head -1)"
  fi

printf '\nthe monitor\n'
# A hook's additionalContext reaches the model and never the terminal, so every
# routing decision and every gate verdict happens behind glass. The monitor is
# the only surface where a person can see what Felix actually did.
out="$(cd "$REPO" && "$FELIX" monitor 2>&1)"
MON="$FROOT/state/monitor.html"
[ -s "$MON" ] && ok "renders a page" || bad "renders a page" "$out"
if [ -s "$MON" ]; then
  grep -q '"name":"widget"' "$MON" \
    && ok "carries the governed project" || bad "carries the governed project"
  # A page shipped with its placeholder intact looks fine and shows nothing.
  grep -q 'FELIX_DATA' "$MON" \
    && bad "the data marker is substituted" "marker still present" \
    || ok "the data marker is substituted"
  # No server and no network. A governance page that phones out is not one.
  if grep -qiE 'src="https?:|href="https?:|@import[[:space:]]+url\(http' "$MON"; then
    bad "self-contained, no external references"
  else
    ok "self-contained, no external references"
  fi

  # The route log records whatever was typed, and the data is embedded inside a
  # <script> element. An HTML parser looks for the literal characters closing
  # that tag without caring that they sit inside a string, so a prompt is a way
  # to end the script early and put markup on the page.
  printf '%s\thostile\t9\t{"prompt":"</script\076<img src=x onerror=alert(1)\076"}\n' \
    "2026-01-01T00:00:00Z" >> "$FROOT/projects/widget/memory/routes.log"
  ( cd "$REPO" && "$FELIX" monitor >/dev/null 2>&1 )
  # The payload survives as inert text — that is fine and even desirable, since
  # the page is for reading what happened. What must not survive is a bracket.
  if grep -q 'u003c/script' "$MON"; then
    ok "a hostile prompt is neutralised, not dropped"
  else
    bad "a hostile prompt is neutralised, not dropped" "escaped form absent"
  fi
  grep -q '<img' "$MON" && bad "no markup from a prompt reaches the page" \
                        || ok "no markup from a prompt reaches the page"
  # ...and the page must still be one script element, not two.
  n="$(grep -c '</script>' "$MON")"
  is "the page still closes exactly one script" "$n" "1"
fi

printf '\ndenial\n'
# The first thing Felix can actually stop. Every other hook injects text a
# session may ignore; PreToolUse decides. Verified against two working
# implementations on this machine rather than assumed: exit 2 blocks and the
# reason goes to stderr, exit 0 allows.
#
# Scoped to Bash by the matcher in hooks.json, so a mistake here cannot deny an
# edit. A deny hook that gets this wrong is indistinguishable from a broken
# editor, which is the failure guard.sh exists to describe.
cat > "$FROOT/projects/widget/deny.tsv" <<'EOF'
# tool	pattern	reason
Bash	git add (-A|--all|\.)$	stage explicit paths; -A stages what you did not read
Bash	(^|[;&| ])\./scripts/gate\.sh	that is not the gate Felix runs
EOF

_pre() { printf '%s' "$1" | "$FROOT/harness/hooks/pre-tool" 2>"$FROOT/.deny-err"; }

( cd "$REPO" && _pre '{"tool_name":"Bash","tool_input":{"command":"git add -A"}}' ); rc=$?
is "a denied command exits 2" "$rc" "2"
has "and says why" "$(cat "$FROOT/.deny-err")" "stage explicit paths"

( cd "$REPO" && _pre '{"tool_name":"Bash","tool_input":{"command":"git add src/widget.py"}}' ); rc=$?
is "an explicit path is allowed" "$rc" "0"

( cd "$REPO" && _pre '{"tool_name":"Bash","tool_input":{"command":"./scripts/gate.sh --quick"}}' ); rc=$?
is "running a rival gate is denied" "$rc" "2"

# The reason a project would ever turn this off is a false deny, so the failure
# mode has to be allow. Anything unparseable, any missing table, any error.
( cd "$REPO" && _pre 'not json at all' ); rc=$?
is "an unparseable payload is allowed" "$rc" "0"
( cd "$PLAIN" && _pre '{"tool_name":"Bash","tool_input":{"command":"git add -A"}}' ); rc=$?
is "an ungoverned repo is allowed" "$rc" "0"

# A malformed row must not take the whole table down with it, the same way a
# malformed routes.tsv row is skipped rather than fatal.
printf 'Bash\n' >> "$FROOT/projects/widget/deny.tsv"
( cd "$REPO" && _pre '{"tool_name":"Bash","tool_input":{"command":"git add -A"}}' ); rc=$?
is "a malformed row is skipped, others still deny" "$rc" "2"
rm -f "$FROOT/projects/widget/deny.tsv" "$FROOT/.deny-err"

( cd "$REPO" && _pre '{"tool_name":"Bash","tool_input":{"command":"git add -A"}}' ); rc=$?
is "no deny.tsv means nothing is denied" "$rc" "0"

printf '\nindependence\n'
# Scoped to code that runs in production. This suite names Elenchus in its own
# comments on purpose, since explaining what it refuses to depend on is the point.
runtime=("$FROOT/harness/felix" "$FROOT/harness/lib" "$FROOT/harness/hooks")
if grep -rniq "elenchus" "${runtime[@]}" 2>/dev/null; then
  bad "runtime harness names no specific project" \
      "$(grep -rni 'elenchus' "${runtime[@]}" | head -3)"
else
  ok "runtime harness names no specific project"
fi

printf '\n%d passed, %d failed' "$PASS" "$FAIL"
[ "$SKIP" -gt 0 ] && printf ', %d skipped' "$SKIP"
printf '\n'
[ "$FAIL" -eq 0 ] || exit 1

# The model still gets the full briefing.
case "$out" in *'"additionalContext"'*) ok "the model still gets the whole thing" ;;
  *) bad "the model still gets the whole thing" "$out" ;; esac

# The one entry point, for somebody who has never seen Felix.
[ -f "$FROOT/../engine/commands/felix.md" ] || [ -f "$REAL_HARNESS/../commands/felix.md" ] \
  && ok "ships a slash command to be found by" \
  || bad "ships a slash command to be found by" "no commands/felix.md"

printf '\na failure nobody wrote down\n'
# Felix has had `felix lesson` from the beginning, and a mechanism nobody uses
# is half a mechanism. This fires only when the gate actually caught something
# and nothing was written since — most sessions teach nothing, and a prompt
# that fires every time is one people learn to dismiss.
GP="$FROOT/projects/guarded"; mkdir -p "$GP" "$MEM/guarded"
: > "$MEM/guarded/lessons.md"; : > "$MEM/guarded/DEVLOG.md"
out="$( . "$FROOT/harness/lib/guard.sh"; felix_guard_unrecorded "$GP" )"
is "silent when the gate has caught nothing" "${#out}" "0"

# `felix_guard_unrecorded` asks whether the catch is newer than the lesson, so
# these two files must have an order and not merely a sequence of writes. They
# were written milliseconds apart and the assertion relied on the filesystem
# resolving that — true on a laptop, and on the CI runner a coin toss that both
# assertions lost the moment anything upstream shifted the timing. Adding tests
# elsewhere in this file turned it red. The `sleep 1` below was the same problem
# noticed once and paid for in wall-clock rather than fixed.
#
# So the order is stated. Every case sets the mtimes it depends on, which also
# means the run is a second faster and neither case can be won by luck.
GYDAY="$(date -v-1d +%Y%m%d%H%M 2>/dev/null || date -d '1 day ago' +%Y%m%d%H%M)"
printf '2026-01-01\tmain\tabc123\tlint\n' > "$MEM/guarded/mistakes.log"
touch -t "$GYDAY" "$MEM/guarded/lessons.md" "$MEM/guarded/DEVLOG.md" 2>/dev/null
# Asserted here, where the ordering is load-bearing. This is the case that went
# red on CI, and the guard reads exactly this comparison. The first version of
# this assertion sat after the *second* case, where the ordering is reversed and
# the fixture sets it explicitly anyway — so it guarded the mtime that never
# mattered, and deleting the touch that did would have left the suite green.
[ -n "$(find "$MEM/guarded/mistakes.log" -newer "$MEM/guarded/lessons.md" 2>/dev/null)" ] \
  && ok  "the fixture puts the catch after the lesson" \
  || bad "the fixture puts the catch after the lesson" "lesson is not older than the catch"
out="$( . "$FROOT/harness/lib/guard.sh"; felix_guard_unrecorded "$GP" )"
has "speaks when a catch went unexplained" "$out" "nothing has been written down"
has "and names what was caught"            "$out" "lint"

# Writing a lesson settles the debt; it must then go quiet. The catch is aged a
# day rather than the lesson being written a second later: still well inside the
# seven days that keep it from being ancient history, and no longer a race.
printf -- '- **something learned**\n' > "$MEM/guarded/lessons.md"
touch -t "$GYDAY" "$MEM/guarded/mistakes.log" 2>/dev/null
out="$( . "$FROOT/harness/lib/guard.sh"; felix_guard_unrecorded "$GP" )"
is "and stops once something is written" "${#out}" "0"

# A devlog entry settles the debt too, and that half had no coverage at all: the
# fixture left DEVLOG.md empty, the guard skips the clause unless the file is
# non-empty, so the entire branch could be deleted with the suite still green.
# Both directions asserted, or the quiet one proves nothing.
printf '2026-01-01\tmain\tabc123\tlint\n' > "$MEM/guarded/mistakes.log"
touch -t "$GYDAY" "$MEM/guarded/lessons.md" 2>/dev/null
printf '## 2026-01-01 what happened and why\n' > "$MEM/guarded/DEVLOG.md"
out="$( . "$FROOT/harness/lib/guard.sh"; felix_guard_unrecorded "$GP" )"
is "a devlog entry newer than the catch settles it too" "${#out}" "0"
touch -t "$GYDAY" "$MEM/guarded/DEVLOG.md" 2>/dev/null
out="$( . "$FROOT/harness/lib/guard.sh"; felix_guard_unrecorded "$GP" )"
has "and an older one does not" "$out" "nothing has been written down"

# An old debt is history, not something this session can explain.
printf '2020-01-01\tmain\tabc\told\n' > "$MEM/guarded/mistakes.log"
touch -t 202001010000 "$MEM/guarded/mistakes.log" 2>/dev/null
out="$( . "$FROOT/harness/lib/guard.sh"; felix_guard_unrecorded "$GP" )"
is "and does not nag about ancient history" "${#out}" "0"
rm -rf "$GP"

printf '\nnoticing when another plugin breaks the session\n'
# A plugin that ships hooks is a dependency on that plugin working. When one
# refuses, the error lands on the tool rather than on the plugin that caused
# it, so it reads as the editor being broken. Claude Code records these
# properly, which is what makes noticing them cheap.
GT="$TMP/guard.jsonl"
cat > "$GT" <<'JSONL'
{"type":"attachment","attachment":{"type":"hook_blocking_error","hookName":"PostToolUse:Write","hookEvent":"PostToolUse","blockingError":{"blockingError":"Not logged into Semgrep Guardian. Ask the guardian mcp to login.","command":"bash x"}}}
{"type":"attachment","attachment":{"type":"hook_blocking_error","hookName":"PostToolUse:Write","hookEvent":"PostToolUse","blockingError":{"blockingError":"Not logged into Semgrep Guardian. Ask the guardian mcp to login.","command":"bash x"}}}
{"type":"assistant","message":{"content":[]}}
JSONL
rows="$( . "$FROOT/harness/lib/guard.sh"; felix_guard_blocks "$GT" )"
has "counts what was blocked"     "$rows" "2"
has "and names the hook"          "$rows" "PostToolUse:Write"
has "and quotes what it said"     "$rows" "Not logged into Semgrep"
# A transcript with no blocks must say nothing at all.
printf '{"type":"assistant"}\n' > "$TMP/clean.jsonl"
q="$( . "$FROOT/harness/lib/guard.sh"; felix_guard_blocks "$TMP/clean.jsonl" )"
is "silent when nothing was blocked" "${#q}" "0"
# A missing transcript is a fact, not a crash.
q="$( . "$FROOT/harness/lib/guard.sh"; felix_guard_blocks "$TMP/nope.jsonl" )"; rc=$?
is "survives a transcript that is not there" "$rc" "0"

out="$(cd "$REPO" && "$FELIX" quarantine definitely-not-installed 2>&1)"; rc=$?
[ "$rc" -ne 0 ] && ok "quarantine refuses a plugin that is not here" \
                || bad "quarantine refuses a plugin that is not here" "$out"

# The report exists for ANOTHER plugin's hook, and it never checked. Felix's own
# Stop hook holds a chain until the gate has seen the tree — working exactly as
# designed — and that block came back to the founder under the headline "and it
# was not Felix", attributed to the felix plugin two lines below, with the
# remedy `felix quarantine felix`. A report that contradicts itself inside four
# lines and then recommends switching off the system that produced it. Observed
# live, not constructed: it fired twice in the session that fixed it.
_isown() { ( . "$FROOT/harness/lib/guard.sh"; . "$FROOT/harness/lib/ready.sh"
             felix_guard_is_own "$1" ) && printf yes || printf no; }
is "Felix's own gate refusal is recognised as its own" \
   "$(_isown 'The gate last ran at 2026-08-13T09:30:36Z, on a different tree. Run felix gate. Or set FELIX_ALLOW_RED=1.')" "yes"
is "and so is a deny from its own PreToolUse" \
   "$(_isown 'felix: this project forbids that command. See felix which.')" "yes"
is "another plugin's refusal is not"  \
   "$(_isown 'Not logged into Semgrep Guardian. Ask the guardian mcp to login.')" "no"
is "and neither is an empty message"  "$(_isown '')" "no"

printf '\ndiscovery runs on a cadence, not in front of a prompt\n'
DH="$TMP/dhome"; mkdir -p "$DH/state/discover"
DP="$FROOT/projects/widget"
# Never refreshed is stale; that is what makes the first run happen at all.
( . "$FROOT/harness/lib/discover.sh"; felix_discover_stale "$DP" "$DH" ) \
  && ok "a cache that never existed is stale" || bad "a cache that never existed is stale"
printf 'deepeval\tllm\tlow\nlangfuse\tllm\tlow\n' > "$DH/state/discover/widget.tsv"
( . "$FROOT/harness/lib/discover.sh"; felix_discover_stale "$DP" "$DH" ) \
  && bad "a fresh cache is not stale" || ok "a fresh cache is not stale"
new="$( . "$FROOT/harness/lib/discover.sh"; felix_discover_unseen "$DP" "$DH" | tr '\n' ' ' )"
has "reports findings the first time" "$new" "deepeval"
( . "$FROOT/harness/lib/discover.sh"; felix_discover_mark_seen "$DP" "$DH" )
new="$( . "$FROOT/harness/lib/discover.sh"; felix_discover_unseen "$DP" "$DH" )"
is "and never mentions the same one twice" "${#new}" "0"
# Something genuinely new must still get through.
printf 'sonarqube\tsecrets\thigh\n' >> "$DH/state/discover/widget.tsv"
new="$( . "$FROOT/harness/lib/discover.sh"; felix_discover_unseen "$DP" "$DH" | tr '\n' ' ' )"
has "but a new one does get through" "$new" "sonarqube"

printf '\ndiscovery reads before it recommends\n'
# The plugin format has no permission declaration and `claude plugin validate`
# checks schema only, so the only way to know what something does is to read it.
# Fixtures throughout: this must never touch the network to be tested.
DF="$TMP/discover-fixtures"
mkdir -p "$DF/skillsonly/skills/a" "$DF/hooky/hooks" "$DF/mcplocal" "$DF/floaty" "$DF/creds"
printf '{"mcpServers":{"x":{"command":"/usr/local/bin/x","args":["run"]}}}\n' > "$DF/mcplocal/.mcp.json"
printf '{"hooks":{"PreToolUse":[{"hooks":[{"command":"bash s.sh"}]}]}}\n'     > "$DF/hooky/hooks/hooks.json"
printf '{"mcpServers":{"x":{"command":"npx","args":["pkg@latest"]}}}\n'       > "$DF/floaty/.mcp.json"
printf '{"mcpServers":{"x":{"type":"http","url":"https://e.example","headers":{"Authorization":"${SECRET_TOKEN}"}}}}\n' > "$DF/creds/.mcp.json"

_tier() { ( . "$FROOT/harness/lib/discover.sh"
            felix_discover_risk "$(felix_discover_inspect "$1")" ); }
is "skills only is low"                  "$(_tier "$DF/skillsonly")" "low"
is "a pinned local server is medium"     "$(_tier "$DF/mcplocal")"   "medium"
is "anything shipping hooks is high"     "$(_tier "$DF/hooky")"      "high"
is "an unpinned version is high"         "$(_tier "$DF/floaty")"     "high"
is "interpolating a credential is high"  "$(_tier "$DF/creds")"      "high"

printf '\nmore than one session at a time\n'
# People keep several terminals open on one checkout, so every key Felix writes
# under has to survive that. Two of these are safe by construction and one was
# not.
#
# The one that was not: user-prompt falls back to a repo-derived session key
# when the payload carries no session_id, and `named` was hung on that variable
# because it was in scope. The fallback belongs to announce-on-change dedup,
# where a shared key costs one missed suggestion. For ledger data it is wrong
# twice over — post-tool and session-end both exit rather than invent a key, so
# the calls half would go to a real session while the named half went to a
# repo-shaped one that nothing ever rolls up. Concurrent sessions would then
# pile named rows into one file with no calls beside them, and a capability
# would read as "pointed at and ignored" on its way to being retired.
PROMPT='the build is broken and the stacktrace shows a crash on reproduce'
rm -rf "$FROOT/state/ledger"
( cd "$REPO" && printf '{"prompt":"%s"}' "$PROMPT" \
    | "$FROOT/harness/hooks/user-prompt" >/dev/null 2>&1 )
n="$(ls -1 "$FROOT/state/ledger" 2>/dev/null | wc -l | tr -d ' ')"
is "a prompt with no session id records no ledger state" "$n" "0"

( cd "$REPO" && printf '{"session_id":"real-sess","prompt":"%s"}' "$PROMPT" \
    | "$FROOT/harness/hooks/user-prompt" >/dev/null 2>&1 )
has "and one with a session id records under exactly that id" \
    "$(cat "$FROOT/state/ledger/real-sess.tsv" 2>/dev/null)" "named	superpowers:"
rm -rf "$FROOT/state/ledger"

# Safe by construction, asserted so it stays that way. A verdict is keyed on the
# tree, and the tree id covers every uncommitted byte — so a second session
# editing the same checkout cannot inherit the first one's review.
T1="$( . "$FROOT/harness/lib/verify.sh"; felix_tree_id "$REPO" "$FROOT" )"
printf 'a concurrent edit\n' > "$REPO/other-session.txt"
T2="$( . "$FROOT/harness/lib/verify.sh"; felix_tree_id "$REPO" "$FROOT" )"
[ "$T1" != "$T2" ] \
  && ok "another session's edit changes the tree identity" \
  || bad "another session's edit changes the tree identity" "both were $T1"
rm -f "$REPO/other-session.txt"

printf '\nthe ledger: recorded as it happens, never parsed after\n'
# The slice stayed unbuilt because its own spec contradicted itself: the body
# said transcript parsing breaks the bash-and-git invariant, and the Records
# section described a hook that parses a transcript. Recording needs no parser.
_sig() { ( . "$FROOT/harness/lib/ledger.sh"; felix_ledger_signal "$1" ); }
is "a plain tool is recorded by name" \
   "$(_sig '{"tool_name":"Bash"}')" "tool	Bash"
is "an mcp call is recorded by server" \
   "$(_sig '{"tool_name":"mcp__github__create_issue"}')" "mcp	github"
is "a skill is recorded by which skill" \
   "$(_sig '{"tool_name":"Skill","tool_input":{"skill":"superpowers:brainstorming"}}')" \
   "skill	superpowers:brainstorming"
is "an unparseable payload records nothing" "$(_sig 'not json')" ""

LH="$TMP/ledgerhome"; LP="$LH/projects/widgetledger"; mkdir -p "$LP" "$MEM/widgetledger"
printf 'plugin\tsuperpowers@x\t-\tlow\talways\nplugin\tplaywright@x\t-\tlow\te2e\n' > "$LP/stack.tsv"
( . "$FROOT/harness/lib/ledger.sh"
  felix_ledger_record "$LH" sess1 "tool	Bash"
  felix_ledger_record "$LH" sess1 "tool	Bash"
  felix_ledger_record "$LH" sess1 "skill	superpowers:brainstorming" )
n="$( . "$FROOT/harness/lib/ledger.sh"; wc -l < "$LH/state/ledger/sess1.tsv" | tr -d ' ' )"
is "every call is appended" "$n" "3"

( . "$FROOT/harness/lib/ledger.sh"; felix_ledger_rollup "$LP" "$LH" sess1 2026-08-11 )
led="$(cat "$MEM/widgetledger/ledger.tsv" 2>/dev/null)"
has "counts repeated calls once with a total" "$led" "tool	Bash	2"
has "and a skill that was invoked"            "$led" "skill	superpowers:brainstorming	1"
# The zero rows are the whole point. Presence without use is the only
# unconfounded signal in the design and it does not exist unless it is written.
has "writes a zero row for a declared tool nobody reached for" "$led" "playwright@x	0"
case "$led" in
  *"superpowers@x	0"*) bad "and no zero row for one that was used" "$led" ;;
  *)                     ok  "and no zero row for one that was used" ;;
esac
( . "$FROOT/harness/lib/ledger.sh"; felix_ledger_rollup "$LP" "$LH" sess1 2026-08-11 )
n="$(grep -c '^sess1' "$MEM/widgetledger/ledger.tsv")"
is "rolling the same session twice does not double it" "$n" "3"

printf '\nreading the ledger, in the one direction that is honest\n'
# Written rows nothing reads is the same half-built shape as installing a tool
# no route can reach. Aggregation reduces to the owner, because a package is
# declared as superpowers@marketplace and invoked as superpowers:brainstorming.
LR="$TMP/ledgerread"; mkdir -p "$LR" "$MEM/ledgerread"
cat > "$MEM/ledgerread/ledger.tsv" <<'EOF'
s1	2026-08-01	skill	superpowers:brainstorming	3	1
s1	2026-08-01	plugin	playwright@x	0	1
s1	2026-08-01	plugin	context7@x	0	0
s2	2026-08-02	plugin	superpowers@x	0	1
s2	2026-08-02	plugin	playwright@x	0	1
s2	2026-08-02	mcp	context7	2	0
EOF
sum="$( . "$FROOT/harness/lib/ledger.sh"; felix_ledger_summary "$LR" )"
has "counts a package and its skill as one thing" "$sum" "superpowers	2	3"
has "sums invocations across sessions"            "$sum" "context7	2	2"
has "and keeps a never-invoked one at zero"       "$sum" "playwright	2	0"

# The asymmetry: only absence of use given presence is unconfounded, so only
# retirement is ever proposed and never the reverse.
p="$( . "$FROOT/harness/lib/ledger.sh"; FELIX_LEDGER_MIN=2 felix_ledger_retire "$LR" | tr '\n' ' ' )"
has "proposes retiring what was mounted and never reached for" "$p" "playwright"
case "$p" in
  *superpowers*) bad "never proposes retiring something that was used" "$p" ;;
  *context7*)    bad "never proposes retiring something that was used" "$p" ;;
  *)             ok  "never proposes retiring something that was used" ;;
esac
# Two sessions is not evidence. The window is sessions, not time, and a capability
# unused across two of them may simply not have come up yet.
p="$( . "$FROOT/harness/lib/ledger.sh"; FELIX_LEDGER_MIN=5 felix_ledger_retire "$LR" | tr -d '\n ' )"
is "and says nothing below the session threshold" "$p" ""

printf '\nzero is not one number\n'
# The design said a zero "has no alternative explanation: it was mounted, it was
# in scope, and it was ignored every time." That is false, and the false half is
# the half Felix controls. Felix decides what routes name. A capability no route
# ever named was never in scope in any sense the session could act on, so its
# zero measures Felix's own priors and retiring on it is a loop closing on
# itself — the recommender-bias shape, where logged data confounded by the
# logging policy looks like evidence for a year and is not.
#
# So the policy's decision is recorded next to the outcome. `named` is how many
# times a route pointed at a capability; `calls` is how often it was reached
# for. Two different zeros, and only one of them is about the capability.
LN="$TMP/ledgernamed"; mkdir -p "$LN" "$MEM/ledgernamed"
cat > "$MEM/ledgernamed/ledger.tsv" <<'EOF'
s1	2026-08-01	plugin	pointed-at@x	0	4
s1	2026-08-01	plugin	never-named@x	0	0
s2	2026-08-02	plugin	pointed-at@x	0	3
s2	2026-08-02	plugin	never-named@x	0	0
EOF
p="$( . "$FROOT/harness/lib/ledger.sh"; FELIX_LEDGER_MIN=2 felix_ledger_retire "$LN" | tr '\n' ' ' )"
has "retires what Felix pointed at and nobody reached for" "$p" "pointed-at"
case "$p" in
  *never-named*) bad "never retires what no route ever named" "$p" ;;
  *)             ok  "never retires what no route ever named" ;;
esac
u="$( . "$FROOT/harness/lib/ledger.sh"; felix_ledger_unrouted "$LN" | tr '\n' ' ' )"
has "reports it as a routing gap instead" "$u" "never-named"
case "$u" in
  *pointed-at*) bad "and not the one that was pointed at" "$u" ;;
  *)            ok  "and not the one that was pointed at" ;;
esac

# Rows written before the column existed say nothing either way. Reading a
# missing field as "named" would resurrect the overclaim in the one place
# nobody would look for it: the data already on disk.
LG="$TMP/ledgerlegacy"; mkdir -p "$LG" "$MEM/ledgerlegacy"
printf 's1\t2026-08-01\tplugin\told-shape@x\t0\ns2\t2026-08-02\tplugin\told-shape@x\t0\n' \
  > "$MEM/ledgerlegacy/ledger.tsv"
p="$( . "$FROOT/harness/lib/ledger.sh"; FELIX_LEDGER_MIN=2 felix_ledger_retire "$LG" | tr -d '\n ' )"
is "a row from before the column proposes nothing" "$p" ""
u="$( . "$FROOT/harness/lib/ledger.sh"; felix_ledger_unrouted "$LG" | tr -d '\n ' )"
is "and is not a routing gap either; it is unknown" "$u" ""

# And the recording end: what a route names is written down as it is named.
LH2="$TMP/ledgernote"; mkdir -p "$LH2/projects/widgetnote" "$MEM/widgetnote"
( . "$FROOT/harness/lib/ledger.sh"
  felix_ledger_record "$LH2" sn "tool	Bash"
  felix_ledger_note_named "$LH2" sn "superpowers:brainstorming code-review"
  felix_ledger_note_named "$LH2" sn "code-review" )
( . "$FROOT/harness/lib/ledger.sh"; felix_ledger_rollup "$LH2/projects/widgetnote" "$LH2" sn 2026-08-12 )
led="$(cat "$MEM/widgetnote/ledger.tsv")"
has "a named capability carries its count"      "$led" "code-review	0	2"
has "and one named once carries one"            "$led" "superpowers:brainstorming	0	1"
has "while a tool that ran keeps its calls"     "$led" "tool	Bash	1"

printf '\nscope could not see what the diff added\n'
# `felix scope` is the unattended gate — red means a person decides. It asked
# felix_incident_severity, which takes PATHS, so it could only ever apply path
# rules. Both risk tables carry content rules (a credential in the added lines,
# destructive SQL), and scope was blind to every one of them.
#
# So a diff adding a live key to a documentation file printed "In scope.
# Reversible enough for an unattended attempt" and exited 0, while felix
# classify called the same diff red. Reproduced before it was believed.
SC="$TMP/scoperepo"; mkdir -p "$SC"
( cd "$SC" && git init -q -b main )
SC="$(cd "$SC" && pwd -P)"
printf 'widget\n' > "$SC/.felix"; printf 'notes\n' > "$SC/a.md"
( cd "$SC" && git add -A >/dev/null 2>&1 && git -c user.name=t -c user.email=t@t commit -qm base >/dev/null 2>&1 )
cp "$REAL_HARNESS/templates/risk.tsv" "$FROOT/projects/widget/risk.tsv"
printf 'api_key = "sk-ant-api03-QQQQQQQQQQQQQQQQQQQQQQQQ"\n' >> "$SC/a.md"   # must_flag
( cd "$SC" && git add -A >/dev/null 2>&1 && git -c user.name=t -c user.email=t@t commit -qm leak >/dev/null 2>&1 )

out="$( cd "$SC" && "$FELIX" scope --base HEAD~1 2>&1 )"; rc=$?
is  "a credential added to a green path is out of scope" "$rc" "3"
has "and scope says which tier it reached"               "$out" "red"

# Bare paths carry no diff, so content rules cannot be applied at all. It must
# say so rather than report a tier that looks complete.
out="$( cd "$SC" && "$FELIX" scope a.md 2>&1 )"; rc=$?
is  "scoping a bare path still answers"      "$rc" "0"
has "but admits it never read the changes"   "$out" "content"

printf '\nthe line that does the work\n'
# `felix merge` was shipped, deployed, written into the handoff as "Felix can
# merge", and could never merge anything. `gh pr merge --repo <slug> --squash`
# carries no PR selector, and gh rejects it client-side with "argument required
# when using the --repo flag" before any network call.
#
# Every existing merge test asserted a refusal or a dry run, so the single line
# that reaches gh was never executed by anything. Green suite, deployed engine,
# dead command. Fourth time this project has paid for "a test can be green
# because it cannot reach the branch it names".
#
# gh is stubbed here rather than called. The point is not that gh works; it is
# that Felix hands it something it will accept, which is exactly the half no
# test covered.
GHB="$TMP/ghstub"; mkdir -p "$GHB"
cat > "$GHB/gh" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$GHSTUB_LOG"
case "$1 $2" in
  "pr view") printf '{"number":7,"state":"OPEN"}\n' ;;
  "pr merge")
    # Reproduce gh's own precondition rather than trusting it: --repo demands a
    # PR selector, and a selector is any bare argument after `merge`.
    sel=0; skip=0
    for a in "${@:3}"; do
      [ "$skip" -eq 1 ] && { skip=0; continue; }
      case "$a" in --repo|--body|--subject) skip=1 ;; --*) ;; *) sel=1 ;; esac
    done
    case " $* " in *" --repo "*) [ "$sel" -eq 1 ] || {
        echo "argument required when using the --repo flag" >&2; exit 1; } ;;
    esac
    printf 'merged\n' ;;
esac
exit 0
STUB
chmod +x "$GHB/gh"

# Its own checkout, because the main fixture is deliberately remote-less and
# felix merge dies on "no github remote" long before it reaches gh.
MR="$TMP/mergerepo"; mkdir -p "$MR"
( cd "$MR" && git init -q -b main \
  && git remote add origin https://github.com/example/widget.git )
MR="$(cd "$MR" && pwd -P)"
printf 'widget\n' > "$MR/.felix"; printf 'contents\n' > "$MR/WIDGET.txt"
( cd "$MR" && git add -A >/dev/null 2>&1 \
  && git -c user.name=t -c user.email=t@t commit -qm base >/dev/null 2>&1 )
printf 'a change to merge\n' > "$MR/README.md"
( cd "$MR" && git add -A >/dev/null 2>&1 \
  && git -c user.name=t -c user.email=t@t commit -qm c >/dev/null 2>&1 )

export GHSTUB_LOG="$TMP/gh.log"; : > "$GHSTUB_LOG"
( cd "$MR" && . "$FROOT/harness/lib/verify.sh"
  felix_verify_record "$MR" "$FROOT" 0 "true" "$(felix_tree_id "$MR" "$FROOT")" )
( cd "$MR" && PATH="$GHB:$PATH" "$FELIX" merge --base HEAD~1 >/dev/null 2>&1 )
mg="$(grep '^pr merge' "$GHSTUB_LOG" | head -1)"
[ -n "$mg" ] && ok "felix merge reaches gh at all" \
             || bad "felix merge reaches gh at all" "gh was never invoked"
# The assertion that would have caught it: a bare argument after `merge` that is
# not the value of a flag. The naive version counted the value of --repo and
# passed against the broken command, which is the same defect one level up.
sel=0; skip=0
for a in $mg; do
  [ "$skip" -eq 1 ] && { skip=0; continue; }
  case "$a" in
    pr|merge) ;;
    --repo|--body|--subject) skip=1 ;;
    --*) ;;
    *) sel=1 ;;
  esac
done
[ "$sel" -eq 1 ] && ok "and hands it a pull request to merge" \
                 || bad "and hands it a pull request to merge" "no selector in [$mg]"
# And the stub reproduces gh's own refusal, so a regression fails loudly here
# rather than only in somebody's terminal.
printf 'pr merge --repo x/y --squash\n' > "$TMP/shape.probe"
( PATH="$GHB:$PATH" GHSTUB_LOG=/dev/null gh pr merge --repo x/y --squash ) 2>/dev/null \
  && bad "the stub refuses a selectorless merge the way gh does" "stub accepted it" \
  || ok "the stub refuses a selectorless merge the way gh does"
unset GHSTUB_LOG

printf '\na path at the end of a sentence\n'
# An issue says "cover it in tests/test_thing.py." and the trailing full stop
# travels with the path. The extractor strips :line, a trailing comma, ./ and
# leading +-, and never that — so the most ordinary way a person writes a path
# in prose was the one way it did not resolve. `felix brief` silently listed one
# of the two files an issue named, which reads as a complete answer.
IP="$TMP/inc"; mkdir -p "$IP/src" "$IP/tests"
: > "$IP/src/thing.py"; : > "$IP/tests/test_thing.py"
_ip() { ( . "$FROOT/harness/lib/incident.sh"; felix_incident_paths "$IP" "$1" | tr '\n' ' ' ); }
has "a path ending a sentence still resolves" "$(_ip 'fix it in tests/test_thing.py.')" "tests/test_thing.py"
has "and both paths in one sentence are found" \
    "$(_ip 'src/thing.py raises. Cover it in tests/test_thing.py.')" "src/thing.py"
has "including the second one"  \
    "$(_ip 'src/thing.py raises. Cover it in tests/test_thing.py.')" "tests/test_thing.py"
is  "a path naming nothing real is still not invented" "$(_ip 'see docs/nope.py.')" ""

# The same defect one convention along, and this one is how every issue is
# actually written. A path in inline backticks resolved to nothing at all: the
# splitter breaks on quotes, parens, brackets and angle brackets, and never on a
# backtick, so the candidate carried one at each end and no amount of stripping
# leading components could find a file by that name.
#
# Found by filing the first four issues this repository has ever had and running
# `felix brief` on one. It reported a single file and tier yellow. The body also
# named engine/harness/lib/resolve.sh, in backticks, which risk.tsv calls red
# because it is sourced by the CLI and by every hook. So the miss did not read as
# an omission — it read as a confident risk verdict, one tier low.
#
# Markdown emphasis is the same shape and gets the same treatment. Both are
# delimiters nobody puts in a repo path, exactly like the quotes and brackets
# already in the set, and adding them can only ever resolve more.
has "a path in inline backticks resolves"   "$(_ip 'look at `src/thing.py` please')"     "src/thing.py"
has "and one in a double-backtick span"     "$(_ip 'look at ``src/thing.py`` please')"   "src/thing.py"
has "and one wrapped in bold"               "$(_ip 'look at **src/thing.py** please')"   "src/thing.py"
has "backticks plus the punctuation after them" \
    "$(_ip 'added in 52e7723, `tests/test_thing.py`).')"                                 "tests/test_thing.py"
has "a trailing colon does not eat it"      "$(_ip 'the failing file is src/thing.py:')" "src/thing.py"
has "nor a semicolon"                       "$(_ip 'src/thing.py; and then more')"       "src/thing.py"
# The conservative half must survive all of that: still no inventing.
is  "and a backticked path naming nothing is still not invented" \
    "$(_ip 'see `docs/nope.py` there')" ""

printf '\nwhat you are about to commit\n'
# `felix evidence` told a session it owed a web test that the session had
# literally just staged. Every reader of "what changed" tries
# `git diff --name-only base...HEAD` and falls back to `git diff base` only when
# that is EMPTY. On a branch with commits the first form is not empty, so the
# fallback never runs and everything staged or unstaged is dropped — which is
# every pull request. On a branch with no commits yet the fallback covers it,
# which is why this went unnoticed: the shape that hides the bug is the shape a
# fixture reaches for.
#
# Worse than a wrong report: felix_escapes reads the same way, so on any real
# branch a staged workflow change or a staged credential was invisible to the
# merge gate. lessons.sh had it right all along and nothing made the rest agree.
STG="$TMP/stagedrepo"; mkdir -p "$STG"
( cd "$STG" && git init -q -b main )
STG="$(cd "$STG" && pwd -P)"
printf 'widget\n' > "$STG/.felix"; printf 'x\n' > "$STG/seed.txt"
( cd "$STG" && git add -A >/dev/null 2>&1 && git -c user.name=t -c user.email=t@t commit -qm base >/dev/null 2>&1 )
BASE_SHA="$(git -C "$STG" rev-parse HEAD)"
# A commit ahead of base, so `base...HEAD` is non-empty and the fallback is dead.
printf 'notes\n' > "$STG/README.md"
( cd "$STG" && git add -A >/dev/null 2>&1 && git -c user.name=t -c user.email=t@t commit -qm ahead >/dev/null 2>&1 )

mkdir -p "$STG/.github/workflows"
printf 'on: push\n' > "$STG/.github/workflows/ci.yml"
( cd "$STG" && git add .github >/dev/null 2>&1 )   # staged, deliberately not committed

_sesc() { ( cd "$STG" && . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/verify.sh"
            . "$FROOT/harness/lib/review.sh"; . "$FROOT/harness/lib/escape.sh"
            felix_escapes "$FROOT/projects/widget" "$BASE_SHA" "$STG" "$FROOT" ); }
has "a staged workflow escapes even with commits ahead" "$(_sesc)" "execute"

printf 'unit\t^src/\t^tests?/\tcode changes need a test\n' > "$FROOT/projects/widget/evidence.tsv"
mkdir -p "$STG/src" "$STG/tests"; printf 'x=1\n' > "$STG/src/a.py"
( cd "$STG" && git add src >/dev/null 2>&1 )
_sev() { ( cd "$STG" && . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/evidence.sh"
           felix_evidence_check "$FROOT/projects/widget" "$BASE_SHA" "$STG" ); }
has "a staged source change owes its test" "$(_sev)" "gap"
printf 'def test_a(): pass\n' > "$STG/tests/test_a.py"
( cd "$STG" && git add tests >/dev/null 2>&1 )
has "and staging the test closes the gap — the case that started this" "$(_sev)" "met"
rm -f "$FROOT/projects/widget/evidence.tsv"

printf '\na receipt that cannot claim more than it knows\n'
# v3.0's domain-OS contract asks each harness for a machine-readable record of
# what changed, why, evidence, risk and result. Felix computes every one of
# those and emits none of them: classify has the risk, evidence has what is
# owed, the gate has the result, escape has the authority question. This is a
# serialiser over facts that already exist.
#
# Two properties come from the transport research rather than from the contract.
# Neither MCP 2026-07-28 nor A2A 1.0.1 carries a bounded authority claim, and
# neither signs task output — so if a receipt is to say on whose authority the
# work proceeded, the receipt itself must carry it, because no transport will.
# And neither models verification as distinct from completion, which is exactly
# what Felix has that they do not, so the gate verdict is its own field.
#
# The load-bearing property is none of that. It is that the receipt CANNOT CLAIM
# VERIFIED ON AN ABSENCE. Six defects in one day were one species — emptiness
# read as success — so the first consumer of this receipt is that rule.
_rcpt() { ( cd "$STG" && . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/detect.sh"
            . "$FROOT/harness/lib/verify.sh"; . "$FROOT/harness/lib/review.sh"
            . "$FROOT/harness/lib/escape.sh"; . "$FROOT/harness/lib/classify.sh"
            . "$FROOT/harness/lib/evidence.sh"; . "$FROOT/harness/lib/receipt.sh"
            felix_receipt "$FROOT/projects/widget" "${1:-$BASE_SHA}" "$STG" "$FROOT" ); }
_rf() { printf '%s' "$1" | python3 -c '
import json,sys
d=json.load(sys.stdin)
for p in sys.argv[1].split("."): d=d[p]
print(d if isinstance(d,str) else json.dumps(d))' "$2" 2>/dev/null; }

r="$(_rcpt)"
printf '%s' "$r" | python3 -c 'import json,sys; json.load(sys.stdin)' 2>/dev/null \
  && ok "it emits parseable json" || bad "it emits parseable json" "$r"
is  "it names a schema version, so a reader can refuse one it does not know" \
    "$(_rf "$r" schema)" "felix.receipt/1"
is  "and the domain it speaks for"  "$(_rf "$r" domain)" "engineering"
has "it names what changed"         "$(_rf "$r" changed.paths)" "src/a.py"
is  "and says that it knows"        "$(_rf "$r" changed.known)" "true"

# The gate has not run against this tree, so nothing may say it is verified.
# This is the whole point: an absent receipt is not a green one.
vs="$(_rf "$r" verification.state)"
is "an absent gate receipt reads as absent, not as green" "$vs" "none"
st="$(_rf "$r" status)"
case "$st" in verified) bad "and the receipt refuses to call that verified" "$st" ;;
              *)        ok  "and the receipt refuses to call that verified" ;; esac

# Authority is carried in the receipt because no transport carries it.
is "a staged workflow makes this the founder's call" "$(_rf "$r" authority.founder_required)" "true"
is "and it is not autonomous"                        "$(_rf "$r" authority.autonomous)"      "false"
has "naming the channel that escaped"                "$(_rf "$r" authority.escapes)"         "execute"
is "and who granted it, which is nobody yet"         "$(_rf "$r" authority.granted_by)"      "none"

# A base nothing can resolve must not read as "nothing changed". An empty list
# and an unanswerable question are different facts, and the whole family of
# defects this exists to prevent is reporting the second as the first.
r2="$(_rcpt deadbeefdeadbeefdeadbeefdeadbeefdeadbeef)"
is "an unresolvable base is not an empty changeset" "$(_rf "$r2" changed.known)" "false"
has "and it says so where a reader must look"       "$(_rf "$r2" unknown)"       "changed"
case "$(_rf "$r2" status)" in
  indeterminate) ok  "a receipt missing an input is indeterminate, never verified" ;;
  *)             bad "a receipt missing an input is indeterminate, never verified" "$(_rf "$r2" status)" ;;
esac

# Same rule for the risk table. "No risk.tsv" once reported green here, which is
# the same bug wearing the other hat.
mv "$FROOT/projects/widget/risk.tsv" "$TMP/risk.tsv.bak"
r3="$(_rcpt)"
is  "an unreadable risk table yields an unknown tier" "$(_rf "$r3" risk.tier)" "unknown"
has "listed where a reader must look"                "$(_rf "$r3" unknown)"   "risk"
case "$(_rf "$r3" status)" in
  verified) bad "and never a verified receipt" "$(_rf "$r3" status)" ;;
  *)        ok  "and never a verified receipt" ;;
esac
mv "$TMP/risk.tsv.bak" "$FROOT/projects/widget/risk.tsv"

# risk.tsv rows carry more than four columns — `channel` and `confine` follow the
# reason — and the readers take the reason as "everything after the pattern", so
# it arrives with the remaining columns glued on behind two tabs. A human report
# gets away with that. A wire contract does not: a consumer reading `reason`
# would get three fields in a trench coat, and the version number promises it
# will not.
rr="$( . "$FROOT/harness/lib/receipt.sh"
       printf 'red\tsome/path\ta plain reason\tverifier\tcount:^x\n' \
         | _felix_rcpt_rows tier path reason )"
has "a finding names its reason"        "$rr" "a plain reason"
case "$rr" in
  *verifier*|*'count:'*) bad "and not the columns that follow it" "$rr" ;;
  *)                     ok  "and not the columns that follow it" ;;
esac
printf '%s' "$rr" | python3 -c 'import json,sys; json.load(sys.stdin)' 2>/dev/null \
  && ok "and the row is still json" || bad "and the row is still json" "$rr"

printf '\nthe bump is the deployment\n'
# `felix install` detected the exact condition, knew exactly what to do, and
# printed instructions: "Bump version in plugin.json, then re-run this." The
# charter calls that a defect in as many words — a command that prints a
# suggestion for something it could safely have done. The gate has now caught
# `installed` NINE times, every one of them a person typing the number the
# command already knew.
#
# Bumping is not a risky act. install already mutates: it is the thing that
# deploys. Refusing to change a patch digit while happily replacing the engine
# is caution in the wrong place.
VB="$TMP/verbump"; mkdir -p "$VB"
printf '{\n  "name": "felix",\n  "version": "0.9.3",\n  "author": {"name": "x"}\n}\n' > "$VB/plugin.json"
( . "$FROOT/harness/lib/resolve.sh"; felix_version_bump "$VB/plugin.json" ) >/dev/null
is "the patch digit goes up by one" \
   "$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$VB/plugin.json")" "0.9.4"
has "and the rest of the file is untouched" "$(cat "$VB/plugin.json")" '"name": "felix"'
has "including fields after it"             "$(cat "$VB/plugin.json")" '"author"'

( . "$FROOT/harness/lib/resolve.sh"; felix_version_bump "$VB/plugin.json" ) >/dev/null
is "and again, so a session can bump twice" \
   "$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$VB/plugin.json")" "0.9.5"

printf '{\n  "version": "1.0"\n}\n' > "$VB/short.json"
( . "$FROOT/harness/lib/resolve.sh"; felix_version_bump "$VB/short.json" ) >/dev/null; rc=$?
is "a version it cannot parse is refused, not guessed" "$rc" "1"
is "and is left exactly as it was" \
   "$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$VB/short.json")" "1.0"

( . "$FROOT/harness/lib/resolve.sh"; felix_version_bump "$VB/nope.json" ) >/dev/null; rc=$?
is "a missing manifest is refused" "$rc" "1"

printf '\nstaged content, not just staged names\n'
# The path list was fixed; the CONTENT readers were not. felix_escapes still
# read added lines from `base...HEAD` and read a file's current state with
# `git show HEAD:`, so on a branch with commits a staged change was named but
# never inspected. Half a fix reads exactly like a whole one from the outside.
SC2="$TMP/stagedcontent"; mkdir -p "$SC2"
( cd "$SC2" && git init -q -b main )
SC2="$(cd "$SC2" && pwd -P)"
printf 'widget\n' > "$SC2/.felix"
mkdir -p "$SC2/projects/thing"
{ printf '# tier\tkind\tpattern\treason\n'
  printf 'red\tpath\t^secrets/\tsecret material\n'
  printf 'red\tpath\t^auth/\tauthorization model\n'
} > "$SC2/projects/thing/risk.tsv"
printf 'notes\n' > "$SC2/a.md"
( cd "$SC2" && git add -A >/dev/null 2>&1 && git -c user.name=t -c user.email=t@t commit -qm base >/dev/null 2>&1 )
SC2_BASE="$(git -C "$SC2" rev-parse HEAD)"
printf 'more\n' >> "$SC2/a.md"
( cd "$SC2" && git add -A >/dev/null 2>&1 && git -c user.name=t -c user.email=t@t commit -qm ahead >/dev/null 2>&1 )

_sc() { ( cd "$SC2" && . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/verify.sh"
          . "$FROOT/harness/lib/review.sh"; . "$FROOT/harness/lib/escape.sh"
          felix_escapes "$FROOT/projects/widget" "$SC2_BASE" "$SC2" "$FROOT" ); }

# Destructive SQL, staged. The path is seen now; the added LINES were not.
printf 'DROP TABLE users;\n' >> "$SC2/a.md"
( cd "$SC2" && git add a.md >/dev/null 2>&1 )
has "staged destructive SQL still escapes as durable" "$(_sc)" "durable"
( cd "$SC2" && git checkout -q -- a.md 2>/dev/null; git reset -q HEAD a.md 2>/dev/null; git checkout -q -- a.md 2>/dev/null )

# A row removed from an enforcing table, staged. The verifier channel compares
# against `git show HEAD:`, which cannot see the index.
sed '/^red.path.\^auth/d' "$SC2/projects/thing/risk.tsv" > "$TMP/rt2" && mv "$TMP/rt2" "$SC2/projects/thing/risk.tsv"
( cd "$SC2" && git add projects >/dev/null 2>&1 )
has "a staged row removal still escapes as verifier" "$(_sc)" "verifier"
( cd "$SC2" && git reset -q HEAD projects 2>/dev/null; git checkout -q -- projects 2>/dev/null )

printf '\none tier for one table\n'
# Two functions read risk.tsv and disagreed about the same path, and the table's
# own header states the answer: "Anything matching no rule is yellow. Green must
# be earned by an explicit pattern, so an unfamiliar file can never auto-merge
# by being unrecognised."
#
# felix_classify_diff obeyed that. felix_incident_severity started at green and
# only ever escalated on a match, so an unrecognised path came back green — and
# that is the function `felix brief` uses, which is the surface the guidebook
# calls "report confidence". Found by running brief on a real issue naming a
# real file and not believing the answer.
RS="$TMP/riskdrift"; mkdir -p "$RS"
{ printf 'red\tpath\t^migrations/\tschema\n'
  printf 'green\tpath\t\\.md$\tdocumentation\n'
} > "$RS/risk.tsv"
_sev() { ( . "$FROOT/harness/lib/classify.sh"; . "$FROOT/harness/lib/incident.sh"
           felix_incident_severity "$RS" "$1" ); }
is "an unrecognised path is yellow, never green" "$(_sev 'src/whatever.py')" "yellow"
is "a path a green rule names is green"          "$(_sev 'README.md')"      "green"
is "a red rule still wins"                       "$(_sev 'migrations/1.sql')" "red"
is "and one unknown path taints a green set"     "$(_sev "$(printf 'README.md\nsrc/x.py')")" "yellow"
is "red beats an unknown too"                    "$(_sev "$(printf 'migrations/1.sql\nsrc/x.py')")" "red"

printf '\none rule for what a thing looks like\n'
# There were two matchers and they drifted. One scored a marketplace blurb, the
# other scored the name alone, nothing said they had to agree, and a plugin got
# installed under a capability the other matcher would not have given it.
CR="$(printf 'llm\tllm prompt eval evaluation\nfrontend\tpage component styling')"
_cm() { ( . "$FROOT/harness/lib/discover.sh"; felix_capability_match "$1" "$2" "$CR" ); }
is "a name counts triple"            "$(_cm evaltool '' | cut -f1)" "3"
is "and prose counts single"         "$(_cm zzz 'about prompt things' | cut -f1)" "1"
is "prose alone can still add up"    "$(_cm zzz 'an llm platform for prompt management and evaluation' | cut -f1)" "4"
is "the best capability wins"        "$(_cm zzz 'page component styling' | cut -f2)" "frontend"
is "and nothing matching scores nil" "$(_cm zzz 'a database migration tool' | cut -f1)" "0"

# The manifest, not the listing. A catalogue blurb is written to be chosen from;
# a manifest is written to describe.
DD="$TMP/desc/.claude-plugin"; mkdir -p "$DD"
printf '{"name":"x","description":"an llm evaluation harness"}\n' > "$DD/plugin.json"
d="$( . "$FROOT/harness/lib/discover.sh"; felix_plugin_description "$TMP/desc" )"
has "reads a plugin's own description" "$d" "llm evaluation harness"
d="$( . "$FROOT/harness/lib/discover.sh"; felix_plugin_description "$TMP/nosuchdir" )"
is "and is silent when there is none" "$d" ""

printf '\nthe one line git cannot reconstruct\n'
# The handoff regenerates the whole file, so whoever filled in "what was in
# progress" lost it the next time anything ran — while the mechanical half,
# which git can rebuild at any moment, survived. The only irreplaceable line
# was the only one being erased.
HP="$TMP/handoffproj"; mkdir -p "$HP" "$MEM/handoffproj"
( . "$FROOT/harness/lib/memory.sh"; felix_mem_handoff "$HP" "$REPO" "gate.sh" "mid-refactor" )
has "a note reaches the file" "$(cat "$MEM/handoffproj/SESSION_HANDOFF.md")" "mid-refactor"
( . "$FROOT/harness/lib/memory.sh"; felix_mem_handoff "$HP" "$REPO" "gate.sh" )
has "and survives a regeneration that was given none" \
    "$(cat "$MEM/handoffproj/SESSION_HANDOFF.md")" "mid-refactor"
( . "$FROOT/harness/lib/memory.sh"; felix_mem_handoff "$HP" "$REPO" "gate.sh" "something else" )
has "a new note replaces it" "$(cat "$MEM/handoffproj/SESSION_HANDOFF.md")" "something else"
# The placeholder must not be carried forward as though it were a real note.
rm -f "$MEM/handoffproj/SESSION_HANDOFF.md"
( . "$FROOT/harness/lib/memory.sh"; felix_mem_handoff "$HP" "$REPO" "gate.sh" )
( . "$FROOT/harness/lib/memory.sh"; felix_mem_handoff "$HP" "$REPO" "gate.sh" )
has "and the placeholder stays a placeholder" \
    "$(cat "$MEM/handoffproj/SESSION_HANDOFF.md")" "fill this in"

printf '\nFelix noticing its own gaps\n'
# Two coverage gaps were found today by a person noticing, not by any check.
# Absence has no line number: nothing greps for a hook that was never written.
# The stance table turns that into something that fails.
CVT="$TMP/cov"; mkdir -p "$CVT"
printf 'Stop\twired\trefuse completion\nNotification\tdeclined\tnothing to add\n' > "$CVT/lifecycle.tsv"
printf '{"hooks":{"Stop":[{}]}}\n' > "$CVT/hooks.json"
out="$( . "$FROOT/harness/lib/coverage.sh"; felix_coverage_check "$CVT" "$CVT/hooks.json" )"
has "a wired moment with a stance is ok"   "$out" "ok	Stop"
has "and a declined one is ok too"         "$out" "ok	Notification"

# Declared wired, nothing wiring it. A hook deleted in a refactor looks exactly
# like this and looks like nothing at all without the table.
printf 'Stop\twired\trefuse completion\n' > "$CVT/lifecycle.tsv"
printf '{"hooks":{}}\n' > "$CVT/hooks.json"
out="$( . "$FROOT/harness/lib/coverage.sh"; felix_coverage_check "$CVT" "$CVT/hooks.json" )"
has "a hook that stopped being wired is caught" "$out" "missing	Stop"

# Wired with nothing saying why. Someone adds a hook and never argues for it.
printf 'Stop\twired\trefuse completion\n' > "$CVT/lifecycle.tsv"
printf '{"hooks":{"Stop":[{}],"PreToolUse":[{}]}}\n' > "$CVT/hooks.json"
out="$( . "$FROOT/harness/lib/coverage.sh"; felix_coverage_check "$CVT" "$CVT/hooks.json" )"
has "a hook nobody explained is caught" "$out" "undeclared	PreToolUse"

# The row that matters: a moment the platform offers that nobody has considered.
# This is the check that would have named SubagentStop out loud.
#
# The roster is discovered from what this machine binds, so on a bare runner it
# is empty and this asserted nothing while reporting ok — the exact failure the
# roster was rewritten to avoid, reproduced one level up in the test for it. A
# fixture HOME binds two known events, so the discovery runs against something
# on every machine instead of against whatever the laptop happens to have.
CVH="$TMP/coverage-home"; mkdir -p "$CVH/.claude"
printf '{"hooks":{"SessionStart":[],"SubagentStop":[]}}\n' > "$CVH/.claude/settings.json"
printf 'Stop\twired\trefuse completion\n' > "$CVT/lifecycle.tsv"
out="$( HOME="$CVH" . "$FROOT/harness/lib/coverage.sh"
        HOME="$CVH" felix_coverage_unconsidered "$CVT" | tr '\n' ' ' )"
has "an unconsidered moment is named"  "$out" "SubagentStop"
has "and so is every other one"        "$out" "SessionStart"

# A decline is permanent by construction: nothing ever re-reads whether the
# reason still holds. PreCompact is declined *because* the SessionStart matcher
# contains `compact`, so narrowing that matcher makes the decline false and
# nothing says so. The fourth column names the literal the reason rests on.
printf 'PreCompact\tdeclined\tSessionStart matches on compact\tcompact\n' > "$CVT/lifecycle.tsv"
printf '{"hooks":{"SessionStart":[{"matcher":"startup|clear|compact"}]}}\n' > "$CVT/hooks.json"
out="$( . "$FROOT/harness/lib/coverage.sh"; felix_coverage_check "$CVT" "$CVT/hooks.json" )"
has "a decline whose premise still holds is ok" "$out" "ok	PreCompact"

printf '{"hooks":{"SessionStart":[{"matcher":"startup|clear"}]}}\n' > "$CVT/hooks.json"
out="$( . "$FROOT/harness/lib/coverage.sh"; felix_coverage_check "$CVT" "$CVT/hooks.json" )"
has "a decline whose premise died is caught" "$out" "stale-reason	PreCompact"
has "and it names the literal that went missing" "$out" "'compact' is no longer in hooks.json"

# `-` is allowed. A decline resting on judgement rather than on a literal is
# honest, and forcing everyone to invent a token would just produce fake ones.
# It is counted rather than accepted silently, so "N declines rest on nothing
# checkable" is visible instead of the excuses being invisible.
printf 'Notification\tdeclined\tnothing to add\t-\n' > "$CVT/lifecycle.tsv"
printf '{"hooks":{}}\n' > "$CVT/hooks.json"
out="$( . "$FROOT/harness/lib/coverage.sh"; felix_coverage_check "$CVT" "$CVT/hooks.json" )"
has "a decline resting on nothing checkable is still ok" "$out" "ok	Notification"
out="$( . "$FROOT/harness/lib/coverage.sh"; felix_coverage_unchecked "$CVT" )"
is "but it is counted" "$out" "1"

# A three-column table is the old format and must keep working, or every
# governed project's table breaks the day the engine updates.
printf 'Notification\tdeclined\tnothing to add\n' > "$CVT/lifecycle.tsv"
out="$( . "$FROOT/harness/lib/coverage.sh"; felix_coverage_check "$CVT" "$CVT/hooks.json" )"
has "a table with no holds column still works" "$out" "ok	Notification"
out="$( . "$FROOT/harness/lib/coverage.sh"; felix_coverage_unchecked "$CVT" )"
is "and its declines count as unchecked" "$out" "1"

# The shipped table must not regress into unfalsifiable declines. Every one it
# carries either names a literal or is deliberately counted.
out="$( . "$FROOT/harness/lib/coverage.sh"
        felix_coverage_check "$REAL_HARNESS/templates" "$REAL_HARNESS/../hooks/hooks.json" \
        | grep -c '^stale-reason' || true )"
is "no shipped decline rests on a dead premise" "$out" "0"

# And the real table, which must have an opinion on every moment there is.
out="$( . "$FROOT/harness/lib/coverage.sh"
        felix_coverage_unconsidered "$REAL_HARNESS/templates" | tr -d '\n ' )"
is "the shipped table considers every moment" "$out" ""
out="$( . "$FROOT/harness/lib/coverage.sh"
        felix_coverage_check "$REAL_HARNESS/templates" "$REAL_HARNESS/../hooks/hooks.json" \
        | grep -vc '^ok' || true )"
is "and the shipped wiring matches its stance" "$out" "0"

printf '\na bundled plugin is present, not missing\n'
# `claude plugin list` reports what came from a marketplace and nothing else, so
# a plugin compiled into the binary is absent from it while being live in every
# session. Checking presence against only that source reported three real tools
# as missing on every session — the kind of false alarm that teaches somebody to
# skim a pre-flight check until it says nothing they believe.
BP="$TMP/bundleproj"; mkdir -p "$BP"
printf 'plugin\tanthropic-skills\t-\tlow\talways\n' > "$BP/stack.tsv"
# The report walks what routes name, not stdin, so the row has to exist for the
# tool to be asked about at all.
printf 'doc\tpdf slide\tcore\tanthropic-skills:pdf\n' > "$BP/routes.tsv"
# Run with the claude CLI off PATH, which is the case this exists for and was
# also the case these assertions were quietly not testing. They passed here and
# failed on CI for a year's worth of commits' worth of reasons: on a laptop the
# CLI answers, so the bundled branch was never the branch being reached. A
# machine with no CLI is the honest fixture, and every runner is one.
NOCLI=/usr/bin:/bin
out="$( PATH="$NOCLI" . "$FROOT/harness/lib/ready.sh"
        # The narrow source knows nothing; the inventory knows it is bundled.
        felix_ready_inventory() { printf 'plugin\tanthropic-skills\n'; }
        PATH="$NOCLI" felix_ready_report "$BP" )"
has "a bundled plugin reads as usable" "$out" "usable"
has "and says why"                     "$out" "bundled"
# With no CLI and nothing bundled, `absent` would be a guess wearing a verdict's
# clothes: Felix cannot tell "not installed" from "installed where I cannot
# look". Saying so is the whole point of the unknown row, and claiming absent
# here would be the same false alarm the bundled fix was written to stop.
out="$( PATH="$NOCLI" . "$FROOT/harness/lib/ready.sh"
        felix_ready_inventory() { printf 'plugin\tsomething-else\n'; }
        PATH="$NOCLI" felix_ready_report "$BP" )"
has "with no CLI and nothing bundled, Felix says it cannot tell" "$out" "cannot check"

# And where the CLI can answer, not installed still means absent.
if has_claude; then
  out="$( . "$FROOT/harness/lib/ready.sh"
          felix_ready_inventory() { printf 'plugin\tsomething-else\n'; }
          felix_ready_report "$BP" )"
  has "one genuinely absent still reads absent" "$out" "absent"
else
  skip "one genuinely absent still reads absent" "no claude CLI on this machine"
fi

printf '\nevery command says it exists\n'
# Thirty-four commands dispatched and help printed eight. Twenty-six were
# undiscoverable, including `install`, which is how the engine is deployed, and
# `new`, which is how anything is governed at all. Four of them were added the
# same day by somebody who edited the comment block at the top of the file and
# believed that was the help text.
_dispatched="$(sed -n '/^case "${1:-help}"/,/^esac/p' "$FROOT/harness/felix" \
  | grep -oE '^  [a-z-]+\)' | tr -d ' )' | grep -vE '^(help)$' | LC_ALL=C sort -u)"
_helped="$("$FELIX" help 2>&1)"
_undocumented=""
while IFS= read -r c; do
  [ -n "$c" ] || continue
  case "$_helped" in *"felix $c"*) ;; *) _undocumented="$_undocumented $c" ;; esac
done <<EOF
$_dispatched
EOF
[ -z "$_undocumented" ] && ok "help covers every command that dispatches" \
                        || bad "help covers every command that dispatches" "missing:$_undocumented"

printf '\nshape reaches the session that needs it\n'
# Computing shape and waiting to be asked is the same half-built shape as
# installing a tool no route can reach. The moment it matters is the moment
# somebody points at a plan, which is a thing the prompt hook can see.
SR="$TMP/shaperepo"; mkdir -p "$SR/docs"
cat > "$SR/docs/p.md" <<'EOF'
### Task 1: One

**Files:**
- Create: `lib/a.sh`

### Task 2: Two

**Files:**
- Modify: `lib/a.sh`

### Task 3: Three

**Files:**
- Modify: `docs/z.md`
EOF
_named() { ( . "$FROOT/harness/lib/shape.sh"; felix_shape_named "$1" "$SR" ); }
is "finds a plan the prompt points at" \
   "$(_named '{"prompt":"execute docs/p.md now"}')" "docs/p.md"
is "and one written as a path"          \
   "$(_named '{"prompt":"work through ./docs/p.md"}')" "docs/p.md"
is "ignores a file that does not exist" "$(_named '{"prompt":"read docs/nope.md"}')" ""
# A markdown file with no tasks is not a plan, and treating one as a plan would
# put a confident empty answer in front of every prompt naming a readme.
printf '# just prose\n' > "$SR/docs/notes.md"
is "and a document that is not a plan"  "$(_named '{"prompt":"see docs/notes.md"}')" ""
# The envelope names the transcript path, which ends in .jsonl but has been a
# source of phantom matches before. It must never be read as a plan.
is "never the transcript in the envelope" \
   "$(_named '{"transcript_path":"/x/docs/p.md","prompt":"hello"}')" ""

out="$( . "$FROOT/harness/lib/shape.sh"; felix_shape_brief "$SR/docs/p.md" )"
has "briefs which tasks are one unit" "$out" "1,2"
has "and which stand alone"           "$out" "3"

printf '\nautonomy is opted into, never assumed\n'
AUP="$TMP/autoproj"; mkdir -p "$AUP"
a() { ( . "$FROOT/harness/lib/autonomy.sh"; felix_autonomy_allows "$AUP" "$1" && echo yes || echo no ); }
is "nothing is allowed by default"    "$(a tidy)" "no"
printf '# what Felix may do here unattended\ntidy\n' > "$AUP/autonomy"
is "an opted-in capability is allowed" "$(a tidy)" "yes"
is "and one that was not is still not" "$(a route)" "no"
printf 'tidy\n' > "$AUP/autonomy"; printf '\n\n# comment\n' >> "$AUP/autonomy"
is "comments and blanks are not capabilities" "$(a comment)" "no"

printf '\ntidying, with the checks that make it safe\n'
# Felix removing a file from a product repository unattended is the sharpest
# trust boundary in the system. Every check below must hold, and the file must
# still exist somewhere afterwards.
TR="$TMP/tidyrepo"; TH2="$TMP/tidyhome"; TP2="$TH2/projects/widget"
mkdir -p "$TR/scripts" "$TP2"
( cd "$TR" && git init -q . && git config user.email t@t && git config user.name t )
printf 'tidy\n' > "$TP2/autonomy"
printf '#!/bin/sh\necho felix\n' > "$TP2/prepush.sh"
# 1. untracked, and Felix holds a copy of that name -> removable
printf '#!/bin/sh\necho repo\n' > "$TR/scripts/prepush.sh"
# 2. TRACKED, even though Felix holds it -> deleting changes the repo's tracked
#    state, which is a different and much larger act than removing a stray file
printf '#!/bin/sh\necho felix\n' > "$TP2/gate.sh"
printf '#!/bin/sh\necho tracked\n' > "$TR/scripts/gate.sh"
( cd "$TR" && git add scripts/gate.sh && git commit -qm base )
# 3. Felix holds nothing of that name -> may be the only copy anywhere
printf '#!/bin/sh\necho only\n' > "$TR/scripts/verify-mine.sh"
chmod +x "$TR"/scripts/*.sh

out="$( . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/detect.sh"; . "$FROOT/harness/lib/autonomy.sh"
        felix_tidy_safe "$TP2" "$TR" "$TH2" )"
[ -f "$TR/scripts/prepush.sh" ] && bad "removes an untracked copy Felix holds" \
                                || ok  "removes an untracked copy Felix holds"
[ -f "$TR/scripts/gate.sh" ]    && ok  "keeps a tracked one, whatever else is true" \
                                || bad "keeps a tracked one, whatever else is true"
[ -f "$TR/scripts/verify-mine.sh" ] && ok  "keeps one Felix holds no copy of" \
                                    || bad "keeps one Felix holds no copy of"
has "and says what it removed" "$out" "scripts/prepush.sh"
ls "$TH2/state/rivals"/*prepush* >/dev/null 2>&1 \
  && ok "the removed file still exists somewhere" || bad "the removed file still exists somewhere"

# Opt-out is absolute: no autonomy file, no removal, however safe it looks.
rm -f "$TP2/autonomy"
printf '#!/bin/sh\necho repo2\n' > "$TR/scripts/prepush.sh"; chmod +x "$TR/scripts/prepush.sh"
( . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/detect.sh"; . "$FROOT/harness/lib/autonomy.sh"; felix_tidy_safe "$TP2" "$TR" "$TH2" ) >/dev/null
[ -f "$TR/scripts/prepush.sh" ] && ok  "without opting in, nothing is touched" \
                                || bad "without opting in, nothing is touched"

printf '\nexecution shape, computed rather than felt\n'
# Whether work fans out or stays in one context was decided by taste every time,
# which means it held on one machine for one person. Files that overlap cannot
# be worked in parallel: that half is mechanical, it is a refusal, and it binds.
SP="$TMP/plan.md"
cat > "$SP" <<'EOF'
### Task 1: One

**Files:**
- Create: `lib/a.sh`
- Test: `tests/run`

### Task 2: Two

**Files:**
- Modify: `lib/a.sh:12-20`
- Test: `tests/run`

### Task 3: Three

**Files:**
- Modify: `docs/x.md`

### Task 4: Four

**Files:**
- Modify: `README.md`
EOF
u="$( . "$FROOT/harness/lib/shape.sh"; felix_shape_units "$SP" | tr '\n' ' ' )"
has "reads the files a task declares"  "$u" "1	lib/a.sh"
has "and strips a line range"          "$u" "2	lib/a.sh"

g="$( . "$FROOT/harness/lib/shape.sh"; felix_shape_groups "$SP" )"
has "tasks sharing a file are one unit"     "$g" "1,2"
# 3 and 4 touch nothing anyone else touches, so they are genuinely separable.
has "and one that shares nothing stands alone" "$g" "3"
has "as does another"                          "$g" "4"
n="$(printf '%s\n' "$g" | grep -c . )"
is "three groups from four tasks" "$n" "3"

# A plan with no Files blocks cannot be judged, and saying so is the answer.
printf '# a plan with no files\n\n### Task 1: x\n\nnothing declared\n' > "$TMP/bare.md"
g="$( . "$FROOT/harness/lib/shape.sh"; felix_shape_groups "$TMP/bare.md" | tr -d '\n ' )"
is "a plan declaring no files yields nothing" "$g" ""

printf '\ndoctor fixes what it can instead of reporting it\n'
# A founder should never be told where a duplicate script lives. Felix holds the
# authoritative copy, so removing the lookalike loses nothing and is exactly the
# reversible work the charter says to do rather than escalate.
mkdir -p "$REPO/scripts"
printf '#!/bin/sh\necho felix copy\n' > "$FROOT/projects/widget/prepush.sh"
printf '#!/bin/sh\necho stale repo copy\n' > "$REPO/scripts/prepush.sh"
chmod +x "$FROOT/projects/widget/prepush.sh" "$REPO/scripts/prepush.sh"
# A gate-named script Felix does NOT hold. Removing this would destroy the only
# copy, so it stays and is reported.
printf '#!/bin/sh\necho mine\n' > "$REPO/scripts/gate-extra.sh"; chmod +x "$REPO/scripts/gate-extra.sh"

out="$(cd "$REPO" && "$FELIX" doctor --fix 2>&1)"
[ -f "$REPO/scripts/prepush.sh" ] && bad "removes a copy of a file Felix holds" \
                                  || ok  "removes a copy of a file Felix holds"
[ -f "$REPO/scripts/gate-extra.sh" ] && ok  "and keeps one Felix does not hold" \
                                     || bad "and keeps one Felix does not hold"
has "saying why it kept it" "$out" "gate-extra.sh"
# Nothing is destroyed. The copy is recoverable even though git never tracked it.
ls "$FROOT/state/rivals"/*prepush* >/dev/null 2>&1 \
  && ok "backs the removed copy up first" || bad "backs the removed copy up first"
out="$(cd "$REPO" && "$FELIX" doctor --fix 2>&1)"
case "$out" in
  *"prepush.sh"*) bad "and says nothing about it afterwards" "$out" ;;
  *)              ok  "and says nothing about it afterwards" ;;
esac
rm -rf "$REPO/scripts" "$FROOT/projects/widget/prepush.sh"

printf '\nthe toolbox: reach, analyse, and whether anything can route it\n'
# Felix could read a plugin it had fetched from a marketplace and could not read
# one already installed, which is the one it will actually be asked about. The
# shape is identical, so this is a path resolver rather than a second analyser.
TB="$TMP/plugincache"
mkdir -p "$TB/mkt/alpha/1.9.0/skills/one" "$TB/mkt/alpha/1.10.0/skills/one" \
         "$TB/mkt/alpha/1.10.0/skills/two" "$TB/mkt/hooky/0.1.0/hooks"
printf '{"hooks":{}}\n' > "$TB/mkt/hooky/0.1.0/hooks/hooks.json"

p="$( . "$FROOT/harness/lib/toolbox.sh"; FELIX_PLUGIN_CACHE="$TB" felix_toolbox_path alpha )"
is "resolves an installed plugin to its newest version" "$(basename "$p")" "1.10.0"
# 1.10.0 beats 1.9.0 only under -V. The gate's installed check was once wrong
# for exactly this reason, picking a directory nothing loads.
p="$( . "$FROOT/harness/lib/toolbox.sh"; FELIX_PLUGIN_CACHE="$TB" felix_toolbox_path nosuch )" || true
is "and reports nothing for one it does not have" "$p" ""

sk="$( . "$FROOT/harness/lib/toolbox.sh"
       FELIX_PLUGIN_CACHE="$TB" felix_toolbox_skills "$(FELIX_PLUGIN_CACHE="$TB" felix_toolbox_path alpha)" | tr '\n' ' ' )"
has "lists the skills a plugin ships" "$sk" "one"
has "all of them"                    "$sk" "two"

# The last column is the point. A tool no route names is never reached for and
# costs context in every session anyway.
TP="$TMP/tbproj"; mkdir -p "$TP"
printf 'core\talways\nbackend\tapi,database\n'                        > "$TP/profiles.tsv"
printf 'web\tendpoint handler\tbackend\tplaywright\n'                 > "$TP/routes.tsv"
r="$( . "$FROOT/harness/lib/toolbox.sh"; felix_toolbox_routed "$TP" playwright && echo yes || echo no )"
is "sees a plugin a route already names" "$r" "yes"
r="$( . "$FROOT/harness/lib/toolbox.sh"; felix_toolbox_routed "$TP" deepeval && echo yes || echo no )"
is "and one no route names"              "$r" "no"

r="$( . "$FROOT/harness/lib/toolbox.sh"; felix_toolbox_route_for "$TP" database | tr '\n' ' ' )"
has "finds the route a capability belongs to" "$r" "web"
# The empty answer is the useful one: Elenchus declares llm, no profile covers
# it, and that is exactly why three tools adopted for llm can never be reached.
r="$( . "$FROOT/harness/lib/toolbox.sh"; felix_toolbox_route_for "$TP" llm | tr -d '\n ' )"
is "and says so plainly when none does" "$r" ""
# `always` must not act as a wildcard, or every capability routes to core and
# the report succeeds at everything and reports nothing.
r="$( . "$FROOT/harness/lib/toolbox.sh"; felix_toolbox_route_for "$TP" frontend | tr -d '\n ' )"
is "always is a profile, not a wildcard" "$r" ""

# Wiring a tool in. Appended, never reordered: a play is ordered and the router
# names the first unused entry, so inserting would change what gets reached for
# first, which is not what "also make this reachable" means.
printf '# a comment that explains why the row is here\n' >  "$TP/routes.tsv"
printf 'web\tendpoint handler\tbackend\tplaywright\n'     >> "$TP/routes.tsv"
printf 'bare\tthing\tbackend\t-\n'                        >> "$TP/routes.tsv"
( . "$FROOT/harness/lib/route.sh"; felix_route_append_play "$TP" web deepeval ) \
  && ok "wires a tool into a route" || bad "wires a tool into a route"
has "appended after what was there" "$(grep '^web' "$TP/routes.tsv")" "playwright deepeval"
has "and the comment survives"      "$(head -1 "$TP/routes.tsv")"     "explains why"
( . "$FROOT/harness/lib/route.sh"; felix_route_append_play "$TP" web deepeval ) \
  && bad "wiring the same tool twice is refused" || ok "wiring the same tool twice is refused"
( . "$FROOT/harness/lib/route.sh"; felix_route_append_play "$TP" nosuch deepeval ) \
  && bad "wiring into a route that does not exist is refused" \
  || ok "wiring into a route that does not exist is refused"
# `-` means no play. Appending to it would name a tool called "-".
( . "$FROOT/harness/lib/route.sh"; felix_route_append_play "$TP" bare semgrep ) >/dev/null
is "an empty play is replaced, not appended to" "$(grep '^bare' "$TP/routes.tsv" | cut -f4)" "semgrep"

printf '\ndiscovery declares what it has read and judged safe\n'
# Felix already read the candidate at its pinned sha and already scored the
# risk. Stopping there and handing the founder a shopping list was the
# governance charter talking: if the founder is thinking about tooling, Felix
# has failed. Declaring is a manifest edit, which detection was always allowed
# to do unattended.
AH="$TMP/adopthome"; mkdir -p "$AH/state/discover"
AP="$AH/projects/widget"; mkdir -p "$AP"
printf 'plugin\tlangfuse@x\t-\tlow\tllm\n' > "$AP/stack.tsv"
# A real cache: three tiers, one already declared, and — from the actual felix
# cache — prose where rows were expected. A parser that adopts a sentence is
# worse than one that adopts nothing.
cat > "$AH/state/discover/widget.tsv" <<'EOF'
deepeval	llm	low
langfuse	llm	low
figma	frontend	medium
outputai	llm	high
Nothing in the marketplaces matches what widget declares.
EOF
out="$( . "$FROOT/harness/lib/discover.sh"; felix_discover_adopt "$AP" "$AH" )"
has "a low-risk candidate is declared"        "$out" "declare	deepeval"
has "a medium one is refused"                 "$out" "refuse	figma"
has "and a high one is refused"               "$out" "refuse	outputai"
has "one already declared is left alone"      "$out" "already	langfuse"
case "$out" in
  *Nothing*|*marketplaces*) bad "prose in the cache is not adopted" "$out" ;;
  *)                        ok  "prose in the cache is not adopted" ;;
esac
n="$(printf '%s\n' "$out" | grep -c '^declare' || true)"
is "exactly one declaration from that cache" "$n" "1"

why="$( . "$FROOT/harness/lib/discover.sh"; felix_discover_why "$(felix_discover_inspect "$DF/creds")" )"
has "and says which variable it sends" "$why" "environment variable"

# The whole safety argument is that fetched source is read and never run. A
# fixture whose hook would create a sentinel proves it: if the file appears,
# this stage has stopped being static analysis.
mkdir -p "$DF/hostile/hooks"
printf '{"hooks":{"SessionStart":[{"hooks":[{"command":"touch %s/PWNED"}]}]}}\n' "$DF" > "$DF/hostile/hooks/hooks.json"
( . "$FROOT/harness/lib/discover.sh"; felix_discover_inspect "$DF/hostile" >/dev/null 2>&1 )
[ -e "$DF/PWNED" ] && bad "inspecting a plugin never runs it" "sentinel was created" \
                   || ok "inspecting a plugin never runs it"

# It recommends. It must never acquire.
before="$(cksum < "$FROOT/projects/widget/stack.tsv")"
out="$(cd "$REPO" && "$FELIX" discover 2>&1)"; rc=$?
after="$(cksum < "$FROOT/projects/widget/stack.tsv")"
is "discovery writes nothing" "$after" "$before"
out="$(cd "$REPO" && "$FELIX" discover --yes 2>&1)"; rc=$?
[ "$rc" -ne 0 ] && ok "there is no --yes" || bad "there is no --yes" "$out"

printf '\nseeing the whole toolbox\n'
# No single source knows every plugin. The CLI misses everything bundled into
# the binary; the on-disk registry misses it too; only the config records it.
# Felix has to work on somebody else's laptop, laid out however they left it,
# so the inventory unions every source and each one is optional.
INV="$( . "$FROOT/harness/lib/ready.sh"; felix_ready_inventory 2>/dev/null )"
if has_claude; then
  n_plug="$(printf '%s\n' "$INV" | grep -c '^plugin' || true)"
  [ "${n_plug:-0}" -gt 0 ] && ok "finds plugins ($n_plug)" || bad "finds plugins" "none"
else
  skip "finds plugins" "no claude CLI"
fi
# Nothing may appear twice however many sources reported it.
dupes="$(printf '%s\n' "$INV" | sort | uniq -d | grep -c . || true)"
is "no entry is listed twice" "${dupes:-0}" "0"
# A version string is not a plugin. The @inline scan picks them up otherwise.
case "$INV" in
  *"	1.0.0"*|*"	2.0.0"*) bad "version strings are not mistaken for plugins" "$INV" ;;
  *) ok "version strings are not mistaken for plugins" ;;
esac
# With no config and no CLI it must still answer from disk rather than die.
out="$( . "$FROOT/harness/lib/ready.sh"; HOME="$TMP/empty-home" felix_ready_inventory 2>&1 )"; rc=$?
is "survives a machine laid out differently" "$rc" "0"

printf '\ndetection reads what a project depends on\n'
DREPO="$TMP/detectrepo"; mkdir -p "$DREPO/src/web/static"
printf '[project]\ndependencies = ["anthropic>=0.40", "fastapi"]\n' > "$DREPO/pyproject.toml"
for i in 1 2 3; do printf 'x\n' > "$DREPO/src/web/static/a$i.js"; done
caps="$( . "$FROOT/harness/lib/detect.sh"; felix_detect "$DREPO" | sort -u | tr '\n' ' ' )"
has "an SDK dependency makes it an llm project" "$caps" "llm"
# package.json was the entire frontend test, which misses every web surface
# served by a backend.
has "a web surface counts without package.json" "$caps" "frontend"
printf '[package]\nname = "x"\n' > "$DREPO/Cargo.toml"
caps="$( . "$FROOT/harness/lib/detect.sh"; felix_detect "$DREPO" | sort -u | tr '\n' ' ' )"
has "a cargo crate is a rust project" "$caps" "rust"

printf '\nthe pre-flight\n'
# A skill can be invoked mid-turn; a plugin that is switched off cannot be
# switched on without a restart. So whether the router's picks will actually
# work is decided before a session starts, and it differs per project.
mkdir -p "$HOME/.claude/skills" 2>/dev/null || true
cat >> "$FROOT/projects/widget/stack.tsv" <<'EOF'
skill	widget-only-skill	-	low	always
EOF
cat >> "$FROOT/projects/widget/routes.tsv" <<'EOF'
preflight	preflightword	frontend	widget-only-skill never-declared-tool
EOF
out="$(cd "$REPO" && "$FELIX" ready 2>&1)"
has "reports a tool no manifest declares" "$out" "never-declared-tool"
has "and says why"                        "$out" "absent from stack.tsv"
# A standalone skill is a directory, not a package. Looking for it in the
# plugin list reported a working skill as missing, which is how a pre-flight
# check earns being ignored.
has "knows a standalone skill is not a plugin" "$out" "widget-only-skill"
case "$out" in
  *"widget-only-skill"*"not installed"*) bad "a skill is not looked up as a plugin" "$out" ;;
  *) ok "a skill is not looked up as a plugin" ;;
esac
# Reporting a clean bill when nothing could be checked is the failure this
# project keeps re-finding.
case "$out" in
  *"could not be checked"*|*"cannot be used"*|*"switched on."*) ok "the summary matches what was actually checked" ;;
  *) bad "the summary matches what was actually checked" "$out" ;;
esac
# Felix has to know the whole inventory, not just its own list. A table naming
# one plugin five times while thirty others sit idle is a habit, not a router.
# This section also guards a bash-3.2 trap: a `case` pattern's closing paren
# inside $( ) ends the substitution, which parses fine under zsh and dies the
# moment the real CLI runs it. Only running the CLI catches that.
if has_claude; then
  case "$out" in
    *"never reached for"*) ok "reports what is installed but unused" ;;
    *) bad "reports what is installed but unused" "$out" ;;
  esac
else
  skip "reports what is installed but unused" "no claude CLI"
fi
case "$out" in
  *"syntax error"*|*"unbound variable"*) bad "the pre-flight runs clean under bash" "$out" ;;
  *) ok "the pre-flight runs clean under bash" ;;
esac

printf '\nkeeping what Felix said\n'
# Everything Felix tells a session goes out as additionalContext, which reaches
# the model and never the terminal. The logs recorded which route fired and
# what it scored; they did not record the words, so "why did Claude suddenly
# start using that skill" was unanswerable from anything Felix kept.
SP="$FROOT/projects/widget"
rm -f "$MEM/widget/says.log"
( . "$FROOT/harness/lib/say.sh"
  felix_say "$SP" "brief" "line one
line two" "why I asked" "sess-42" )
[ -s "$MEM/widget/says.log" ] && ok "records what it said" || bad "records what it said"
n="$(wc -l < "$MEM/widget/says.log" | tr -d ' ')"
is "a multi-line utterance stays one greppable line" "$n" "1"
has "and keeps the session it was said in" "$(cut -f3 "$MEM/widget/says.log")" "sess-42"
has "and keeps the prompt that caused it"   "$(cut -f4 "$MEM/widget/says.log")" "why I asked"
has "with the newlines escaped, not lost"   "$(cut -f5 "$MEM/widget/says.log")" 'line one\nline two'

# The hook must record the same words it sends, or the page is fiction.
rm -f "$MEM/widget/says.log"
out="$(cd "$REPO" && printf '{"session_id":"sayer","prompt":"the migration schema needs an index"}' | "$RHK" 2>&1)"
sent="$(_ctx "$out" | head -1)"
kept="$(cut -f5 "$MEM/widget/says.log" 2>/dev/null | head -1 | sed 's/\\n.*//')"
is "what it kept is what it sent" "$kept" "$sent"
has "and the cause is the prompt, not the envelope" \
    "$(cut -f4 "$MEM/widget/says.log" 2>/dev/null)" "migration schema"
case "$(cut -f4 "$MEM/widget/says.log" 2>/dev/null)" in
  *session_id*) bad "the cause is not the raw payload" "carried the envelope" ;;
  *) ok "the cause is not the raw payload" ;;
esac

# ...and the page shows it verbatim.
out="$(cd "$REPO" && "$FELIX" monitor 2>&1)"
MON2="$FROOT/state/monitor.html"
grep -q '"says"' "$MON2" && ok "the page carries the speech" || bad "the page carries the speech"
grep -q 'migration schema needs an index' "$MON2" \
  && ok "including what prompted each utterance" || bad "including what prompted each utterance"

  # A column was inserted into the middle of this record once. Read as the new
  # shape, an old line puts its text where the cause belongs, and the page
  # attributes a gate verdict to a prompt nobody typed. Both shapes must read.
  printf '%s\told-shape\tno session here\tthe words\n' "2020-01-01T00:00:00Z" >> "$MEM/widget/says.log"
  ( cd "$REPO" && "$FELIX" monitor >/dev/null 2>&1 )
  if grep -q '"kind":"old-shape","session":"","cause":"no session here","text":"the words"' "$MON2"; then
    ok "a record from before the session column still reads"
  else
    bad "a record from before the session column still reads" \
        "$(grep -o '"kind":"old-shape"[^}]*' "$MON2" | head -1)"
  fi

printf '\nupkeep that can never come due\n'
# `felix maintenance` printed "Nothing due" for four routines that had never run
# and never could. The capability column takes `always` or a capability the
# project declares; Felix's own table used `-`, which is neither, so every row
# resolved to dormant and the report read exactly like a well-kept repository.
#
# Same shape as the ledger overclaim and the coverage table before it: a surface
# saying "nothing to do" when the truth is "nothing is being checked". Found by
# building the thing that ranks upkeep, not by reading the table.
MT="$TMP/maintcheck"; mkdir -p "$MT" "$MEM/maintcheck"
printf '{"name":"maintcheck","gate":"true"}\n' > "$MT/project.json"
{ printf 'good\t7\talways\tthis one can come due\n'
  printf 'typo\t7\t-\tthis one never can\n'
  printf 'gated\t7\tci\tonly when ci is declared\n'
} > "$MT/maintenance.tsv"
u="$( . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/detect.sh"
      . "$FROOT/harness/lib/stack.sh"; . "$FROOT/harness/lib/maintenance.sh"
      felix_maint_unreachable "$MT" )"
has "a row naming no real capability is caught" "$u" "typo"
case "$u" in
  *good*)  bad "an always row is not flagged" "$u" ;;
  *)       ok  "an always row is not flagged" ;;
esac
# `ci` is a real capability that this project has simply not declared. That is a
# dormant row working as intended, not a broken one, and flagging it would make
# the check noise.
case "$u" in
  *gated*) bad "a real capability left undeclared is not an error" "$u" ;;
  *)       ok  "a real capability left undeclared is not an error" ;;
esac

# And the shipped tables, which is where the bug actually was.
for _p in "$FELIX_HOME"/projects/*/; do :; done
u="$( . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/detect.sh"
      . "$FROOT/harness/lib/stack.sh"; . "$FROOT/harness/lib/maintenance.sh"
      for p in "$(cd "$REAL_HARNESS/../.." && pwd)"/projects/*/; do
        [ -f "$p/maintenance.tsv" ] && felix_maint_unreachable "${p%/}"
      done )"
is "no shipped upkeep row is unreachable" "$(printf '%s' "$u" | tr -d '\n ')" ""

printf '\nan engine a marketplace does not serve\n'
# `felix install` from a worktree bumps the manifest, runs the three plugin
# commands, finds the cache unchanged and says "this is no longer the version
# cache; something else is wrong" — which sends you hunting for corruption. A
# directory marketplace is pinned to one path. The worktree's engine is not the
# engine being served, the cache still matches the tree that is, and nothing is
# broken. Same shape as every other failure in section 8 of the handoff: correct
# code, wrong place, and a message that described the code.
MKT="$TMP/known_marketplaces.json"
cat > "$MKT" <<'MJ'
{
  "other": { "installLocation": "/somewhere/else" },
  "felix": {
    "source": { "source": "directory", "path": "/Users/x/Felix" },
    "installLocation": "/Users/x/Felix"
  }
}
MJ
mroot="$( . "$FROOT/harness/lib/resolve.sh"; felix_marketplace_root "$MKT" )"
is "the registry says where the engine is served from" "$mroot" "/Users/x/Felix"

( . "$FROOT/harness/lib/resolve.sh"; felix_deployable_from "/Users/x/Felix/engine" "$MKT" >/dev/null ) \
  && ok  "an engine under that path can deploy" \
  || bad "an engine under that path can deploy"

wt="$( . "$FROOT/harness/lib/resolve.sh"
       felix_deployable_from "/Users/x/Felix/.claude/worktrees/w1/engine" "$MKT" )" && rc=0 || rc=1
is "a worktree engine cannot"                    "$rc"  "1"
is "and it names the tree that can, not a fault" "$wt"  "/Users/x/Felix"

# No registry at all is not an accusation: an engine nobody has registered yet
# is the ordinary first-install case, and must not be told it is in a worktree.
( . "$FROOT/harness/lib/resolve.sh"; felix_deployable_from "/anywhere/engine" "$TMP/absent.json" >/dev/null ) \
  && ok  "an unregistered marketplace makes no claim either way" \
  || bad "an unregistered marketplace makes no claim either way"

printf '\na local that reads a local\n'
# `local proj="$1" log="$proj/memory/routes.log"` — bash expands every word of
# the statement before it assigns any of them, so `$proj` was read before it
# existed and the path came out as `/memory/routes.log`. The function then found
# no file and returned nothing, silently.
#
# It survived because of where it ran. `cmd_route` declares its own `proj`, and
# bash's dynamic scoping handed that one to the callee — so the single caller
# anybody exercised got the right answer and every other caller got silence. A
# lesson would not have caught this: the line reads correctly, and it was correct
# in the only place it was ever looked at. That is this project's oldest failure
# shape, so it goes where a check can see it instead.
# The scanner lives in a file and takes its root as an argument, so the proof
# that it can fail runs THE SCANNER. The first version of this asserted against a
# retyped copy of the same regex — which meant breaking the real scanner left the
# suite green while the proof went on passing, in the check whose entire purpose
# is catching things that cannot fail. Found by an adversarial audit of this
# file, which is the correct way to find it and an uncomfortable place for it to
# have been.
SR="$TMP/selfref.py"
cat > "$SR" <<'PY'
import re, glob, os, sys
root, out = sys.argv[1], []
for pat in sys.argv[2:]:
    for f in glob.glob(os.path.join(root, pat)):
        if not os.path.isfile(f):
            continue
        for i, line in enumerate(open(f, encoding="utf-8", errors="replace"), 1):
            s = line.strip()
            if not s.startswith("local "):
                continue
            seen = set()
            for m in re.finditer(r'(?:^|\s)([A-Za-z_][A-Za-z0-9_]*)=(\S*)', s[6:]):
                for ref in re.findall(r'\$\{?([A-Za-z_][A-Za-z0-9_]*)', m.group(2)):
                    if ref in seen:
                        out.append("%s:%d" % (os.path.basename(f), i))
                seen.add(m.group(1))
print(" ".join(sorted(set(out))))
PY
selfref="$(python3 "$SR" "$(cd "$REAL_HARNESS/.." && pwd)" \
           "harness/lib/*.sh" "harness/felix" "harness/hooks/*" "harness/tests/run")"
is "no local assignment reads one declared beside it" "$selfref" ""

# The same scanner, against a planted instance of the exact shape. If somebody
# breaks the scanner, this goes red too — which is the property the retyped copy
# did not have.
#
# Assembled rather than written out, because this file is one of the roots the
# scanner sweeps: a heredoc containing the literal bad line makes tests/run
# itself a hit, and the check reports a defect it planted. The fixture holds the
# shape; this file never contains it.
SRF="$TMP/selfreffix/harness/lib"; mkdir -p "$SRF"
{ printf 'demo() {\n'
  printf '  local proj="%s1" log="%sproj/memory/routes.log"\n' '$' '$'
  printf '  printf "%%s" "%slog"\n' '$'
  printf '}\n'
} > "$SRF/planted.sh"
planted="$(python3 "$SR" "$TMP/selfreffix" "harness/lib/*.sh")"
has "and the same scanner catches a planted one" "$planted" "planted.sh"

printf '\na lesson that is not working\n'
# `felix promote` knew the gate had caught the same check eight times and then
# asked a person to type `felix lesson "..."`. That is the defect the charter
# names: it had the finding and handed back the work.
#
# Converting it does not mean writing the prose — a lesson is judgement and a
# fabricated one pollutes the file that gets matched into every prompt. What is
# mechanical is the distinction promote's own closing line draws and never acts
# on: a recurrence with no lesson behind it needs one written, and a recurrence
# that already HAS a lesson means the lesson is not working and the fix belongs
# somewhere the gate can see.
PM="$TMP/promoteproj"; mkdir -p "$PM" "$MEM/promoteproj"
printf '{"name":"promoteproj","gate":"true"}\n' > "$PM/project.json"
# Relative dates, because liveness is now part of what is asserted and a fixture
# of literal dates is a test that passes until a fortnight after it was written.
_ago() { date -v-"$1"d +%Y-%m-%d 2>/dev/null || date -d "$1 days ago" +%Y-%m-%d 2>/dev/null; }
{ printf '%s\tmain\taaa\tflaky \n'      "$(_ago 3)"
  printf '%s\tmain\tbbb\tflaky \n'      "$(_ago 2)"
  printf '%s\tmain\tccc\tuncovered \n'  "$(_ago 3)"
  printf '%s\tmain\tddd\tuncovered \n'  "$(_ago 1)"
  printf '%s\tmain\teee\tsettled \n'    "$(_ago 90)"
  printf '%s\tmain\tfff\tsettled \n'    "$(_ago 89)"
  printf '%s\tmain\tggg\tsettled \n'    "$(_ago 88)"
  printf '%s\tmain\thhh\tdrifting \n'   "$(_ago 2)"
  printf '%s\tmain\tiii\tdrifting \n'   "$(_ago 1)"
} > "$MEM/promoteproj/mistakes.log"
{ printf -- '- **Something about `flaky` things.** It was written down.\n'
  # Names the word and is not about the check. The real lessons file says
  # "executing the installed hooks by hand" and "cannot be uninstalled", and a
  # substring test read both as a lesson about the `installed` gate check.
  printf -- '- **A note that mentions drifting in passing.** Not about that check.\n'
} > "$MEM/promoteproj/lessons.md"

_pnext() { ( cd "$REPO" && . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/detect.sh"
             . "$FROOT/harness/lib/verify.sh"; . "$FROOT/harness/lib/review.sh"
             . "$FROOT/harness/lib/escape.sh"; . "$FROOT/harness/lib/evidence.sh"
             . "$FROOT/harness/lib/maintenance.sh"; . "$FROOT/harness/lib/stack.sh"
             . "$FROOT/harness/lib/ready.sh"; . "$FROOT/harness/lib/ledger.sh"
             . "$FROOT/harness/lib/coverage.sh"; . "$FROOT/harness/lib/deny.sh"
             . "$FROOT/harness/lib/memory.sh"; . "$FROOT/harness/lib/next.sh"
             felix_next "$PM" "$FROOT" "$REPO" HEAD~1 ); }

n="$(_pnext)"
has "a recurrence with no lesson says to write one" "$n" "uncovered"
has "and names the command that writes it"          "$n" "felix lesson"
has "a recurrence that already has a lesson is different" "$n" "flaky"
case "$(printf '%s\n' "$n" | grep flaky)" in
  *"felix lesson"*) bad "and does not ask for a lesson that already exists" "$n" ;;
  *)                ok  "and does not ask for a lesson that already exists" ;;
esac
has "it says the lesson is not working" "$(printf '%s\n' "$n" | grep flaky)" "not working"

# A recurrence that stopped recurring is history. It kept its lifetime count and
# so kept its place at the rank the code itself calls the strongest signal there
# is — nine `installed` failures, every one before the fix landed, ranked above
# whatever is costing time today. A permanent row at that rank is how a ranked
# list stops being read. `felix_guard_unrecorded` already draws this line at the
# whole file; this draws it per term, where the recurrence is counted.
case "$n" in
  *settled*) bad "a recurrence that stopped recurring is not still ranked" "$n" ;;
  *)         ok  "a recurrence that stopped recurring is not still ranked" ;;
esac
has "and a live one says when it was last caught" "$n" "$(_ago 1)"

# The lesson test read a substring of the whole file, so an ordinary English
# word anywhere in it counted as a lesson about a check of that name — and then
# sent you to build a mechanism for a lesson that was never written.
case "$(printf '%s\n' "$n" | grep drifting)" in
  *"felix lesson"*) ok  "a passing mention is not a lesson about the check" ;;
  *)                bad "a passing mention is not a lesson about the check" "$n" ;;
esac

# A check name is usually written as the head of a path, because that is what it
# is — `tests/run`, `memory/verification.log`. The follow-class allowed a
# backtick, dot, underscore or hyphen after the term and not a slash, so `tests`
# and `memory`, two of Felix's own seven gate checks, read as "no lesson mentions
# it" against a lessons file that discusses both at length. The advice that
# follows is the opposite of the right one: write the prose, when the prose is
# already there and something else is wrong.
#
# Asserted against the shipped lessons file as well as a fixture, because the
# fixture is what missed it — every fixture path in this suite was written as a
# bare filename, which is not how anyone writes one.
LN="$TMP/lessonnames"; mkdir -p "$LN" "$MEM/lessonnames"
{ printf -- '- **On the suite.** `tests/run` computes its path from `$0`.\n'
  printf -- '- **On records.** `memory/verification.log` is where a gate receipt lands.\n'
} > "$MEM/lessonnames/lessons.md"
_lname() { ( . "$FROOT/harness/lib/memory.sh"; felix_mem_lesson_names "$LN" "$1" ) && printf yes || printf no; }
is "a check named as the head of a path is found"  "$(_lname tests)"  "yes"
is "and so is the other one"                       "$(_lname memory)" "yes"
is "a name nothing mentions is still not found"    "$(_lname secret)" "no"

REALDIR="$(cd "$REAL_HARNESS/../.." && pwd)"
REALMEM="${HOME}/.felix/memory/felix/lessons.md"
if [ -f "$REALMEM" ]; then
  RL="$TMP/reallessons"; mkdir -p "$RL" "$MEM/reallessons"
  cp "$REALMEM" "$MEM/reallessons/lessons.md"
  _rname() { ( . "$FROOT/harness/lib/memory.sh"; felix_mem_lesson_names "$RL" "$1" ) && printf yes || printf no; }
  # Only the names the shipped file demonstrably discusses, so this asserts the
  # matcher rather than the prose. Both appear there inside backticks as paths.
  is "and it holds against the shipped lessons file" "$(_rname tests)"  "yes"
  is "for every gate check that file actually covers" "$(_rname memory)" "yes"
fi

# Nothing recurring is silence, not a reassurance.
: > "$MEM/promoteproj/mistakes.log"
n="$(_pnext)"
case "$n" in
  *flaky*|*uncovered*) bad "no recurrence says nothing at all" "$n" ;;
  *)                   ok  "no recurrence says nothing at all" ;;
esac

printf '\nwhat to do next\n'
# Felix tracked maintenance, drift, setup gaps, evidence gaps and coverage in
# five separate commands and never once said which of them mattered. A founder
# reading five reports to work out the order is doing exactly the job Felix
# exists to take.
#
# The ranking is anchored on the declared objective — founder interruptions per
# session — and then on what is blocking now. So the order is: work Felix owes
# on the change in hand, then the things that will interrupt a future session,
# then rot that will quietly mislead one.
NX="$TMP/nextproj"; mkdir -p "$NX" "$MEM/nextproj"
printf '{"name":"nextproj","gate":"true"}\n' > "$NX/project.json"
: > "$NX/routes.tsv"; : > "$NX/stack.tsv"

# Sourced the way the CLI sources them. A short list here passed a `dormant`
# maintenance row for a fixture that was plainly due, because the capability
# check silently degrades when its helpers are absent — the test would have
# been asserting the absence of a library.
_next() { ( cd "$REPO" && . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/detect.sh"
            . "$FROOT/harness/lib/verify.sh"; . "$FROOT/harness/lib/review.sh"
            . "$FROOT/harness/lib/escape.sh"; . "$FROOT/harness/lib/evidence.sh"
            . "$FROOT/harness/lib/maintenance.sh"; . "$FROOT/harness/lib/stack.sh"
            . "$FROOT/harness/lib/ready.sh"; . "$FROOT/harness/lib/ledger.sh"
            . "$FROOT/harness/lib/coverage.sh"; . "$FROOT/harness/lib/deny.sh"
            . "$FROOT/harness/lib/route.sh"; . "$FROOT/harness/lib/next.sh"
            felix_next "$NX" "$FROOT" "$REPO" HEAD~1 ); }

printf 'ordinary\n' > "$REPO/README.md"; _stage
n="$(_next)"
has "an unverified tree is the first thing to do" "$(printf '%s\n' "$n" | head -1)" "gate"
has "and it is Felix's own work"                  "$(printf '%s\n' "$n" | head -1)" "felix"
has "every row carries the command that clears it" "$(printf '%s\n' "$n" | head -1)" "felix gate"

# Two capabilities that were never pointed at, for two different reasons, and
# only one of them is about keywords.
#
# `felix next` told the founder to fix the keywords in routes.tsv for plugins no
# route names at all — advice nobody can follow, because no keyword can reach a
# capability that appears in no play. Six rows on the real project, three of
# them impossible. The ledger already draws this distinction one layer down:
# named>0 with calls=0 is evidence about the capability, named=0 is evidence
# about routing and none at all about the capability. Rank 7 never inherited it.
#
# The general form is the one this project keeps paying for: absence of
# opportunity is not evidence of failure.
cat > "$MEM/nextproj/ledger.tsv" <<'LED'
s1	2026-08-01	plugin	reachable	0	0
s1	2026-08-01	plugin	unreachable	0	0
LED
printf 'work\tstuff\tcore\treachable\n' > "$NX/routes.tsv"
n="$(_next)"
rrow="$(printf '%s\n' "$n" | grep -A1 'reachable is mounted' | grep -v 'unreachable')"
urow="$(printf '%s\n' "$n" | grep -A1 'unreachable is mounted')"
has "a capability some route names is a keyword problem" "$rrow" "keywords"
case "$urow" in
  *keywords*) bad "one no route names is not" "$urow" ;;
  *)          ok  "one no route names is not" ;;
esac
has "and it says what would actually reach it" "$urow" "no route names it"
# Both are fixture state a later section asserts the absence of, so both are put
# back. A test that leaves its own evidence lying around makes the next one lie.
: > "$NX/routes.tsv"; : > "$MEM/nextproj/ledger.tsv"

# An escape outranks upkeep and is the founder's. It is also the thing the
# declared objective counts, so burying it under a maintenance row would hide
# the one number Felix is trying to move.
{ printf 'deployed\t7\talways\tconfirm the installed engine still matches\n'; } > "$NX/maintenance.tsv"
mkdir -p "$REPO/migrations"; printf 'x\n' > "$REPO/migrations/990.sql"; _stage
n="$(_next)"
has "an escape is named as the founder's"  "$n" "founder"
has "and says which channel"               "$n" "durable"
first_owner="$(printf '%s\n' "$n" | grep '	founder	' | head -1 | cut -f2)"
is "the founder's item is not buried"      "$first_owner" "founder"
_reset

# A tool a route names but cannot reach breaks the session it is needed in, and
# plugins bind at session start — so it can only be fixed between sessions.
# That is the highest-leverage preventive row there is.
# felix_ready_report is stubbed rather than driven. Whether a tool is really
# absent is ready.sh's own concern and it is tested there; here the question is
# only whether felix_next ranks an absent one. Driving it for real asserted the
# machine instead: with no claude CLI the honest answer is `unknown`, never
# `absent`, so this passed on a laptop and failed on every runner.
n="$( cd "$REPO" && . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/detect.sh"
      . "$FROOT/harness/lib/verify.sh"; . "$FROOT/harness/lib/review.sh"
      . "$FROOT/harness/lib/escape.sh"; . "$FROOT/harness/lib/evidence.sh"
      . "$FROOT/harness/lib/maintenance.sh"; . "$FROOT/harness/lib/stack.sh"
      . "$FROOT/harness/lib/ready.sh"; . "$FROOT/harness/lib/ledger.sh"
      . "$FROOT/harness/lib/coverage.sh"; . "$FROOT/harness/lib/deny.sh"
      . "$FROOT/harness/lib/next.sh"
      felix_ready_report() { printf 'absent\tnot-installed-anywhere:tool\tnot installed\n'; }
      felix_next "$NX" "$FROOT" "$REPO" HEAD~1 )"
has "a route naming an unreachable tool is ranked" "$n" "not-installed-anywhere"
has "and says it must be fixed before the next session" "$n" "bind at start"

# Due upkeep appears, and below the blocking rows.
printf 'ordinary again\n' > "$REPO/README.md"; _stage
( . "$FROOT/harness/lib/verify.sh"
  felix_verify_record "$REPO" "$FROOT" 0 "true" "$(felix_tree_id "$REPO" "$FROOT")" )
n="$(_next)"
has "maintenance that is due is named" "$n" "deployed"
rm -f "$NX/maintenance.tsv"

# Nothing wrong is a real answer and has to be said, or the command becomes one
# people run and squint at.
n="$(_next)"
is "with nothing due it reports nothing" "$(printf '%s' "$n" | tr -d '\n ')" ""
_reset

printf '\nwhether the delegation actually works\n'
# The monitor showed every record Felix wrote and never once showed whether
# Claude did the thing Felix named. Those are different claims, and only the
# second one is evidence that any of this is worth running.
#
# The signal is recorded rather than parsed. `named` is what a route pointed at
# and `calls` is what got reached for, both already in the ledger, so this is
# arithmetic on committed rows and not a transcript reader.
CM="$TMP/compliance"; mkdir -p "$CM" "$MEM/compliance"
cat > "$MEM/compliance/ledger.tsv" <<'EOF'
s1	2026-08-01	plugin	followed@x	4	2
s1	2026-08-01	plugin	ignored@x	0	3
s1	2026-08-01	plugin	unnamed@x	7	0
s2	2026-08-02	plugin	followed@x	1	1
s2	2026-08-02	plugin	ignored@x	0	1
EOF
c="$( . "$FROOT/harness/lib/monitor.sh"; . "$FROOT/harness/lib/ledger.sh"
      felix_monitor_compliance "$CM" )"
has "a session reports what was named and what was followed" "$c" "s1	2026-08-01	2	1	1"
has "and so does the next one"                               "$c" "s2	2026-08-02	2	1	1"
case "$c" in
  *unnamed*) bad "what no route named is not a compliance figure" "$c" ;;
  *)         ok  "what no route named is not a compliance figure" ;;
esac

# A ledger written before the named column cannot answer this, and must say so
# rather than reporting perfect compliance by counting nothing.
cat > "$MEM/compliance/ledger.tsv" <<'EOF'
s9	2026-07-01	plugin	old@x	0
EOF
c="$( . "$FROOT/harness/lib/monitor.sh"; . "$FROOT/harness/lib/ledger.sh"
      felix_monitor_compliance "$CM" | tr -d '\n ' )"
is "a ledger from before the column reports nothing at all" "$c" ""

printf '\nthe monitor\n'
# A hook's additionalContext reaches the model and never the terminal, so every
# routing decision and every gate verdict happens behind glass. The monitor is
# the only surface where a person can see what Felix actually did.
out="$(cd "$REPO" && "$FELIX" monitor 2>&1)"
MON="$FROOT/state/monitor.html"
[ -s "$MON" ] && ok "renders a page" || bad "renders a page" "$out"
if [ -s "$MON" ]; then
  grep -q '"name":"widget"' "$MON" \
    && ok "carries the governed project" || bad "carries the governed project"
  # A page shipped with its placeholder intact looks fine and shows nothing.
  grep -q 'FELIX_DATA' "$MON" \
    && bad "the data marker is substituted" "marker still present" \
    || ok "the data marker is substituted"

  # The panel that answers whether the delegation works has to be on the page
  # and fed by the payload. A render function nothing calls is the same defect
  # as a capability no route names.
  grep -q '"compliance":' "$MON" \
    && ok "the payload carries compliance" || bad "the payload carries compliance"
  grep -q 'renderCompliance()' "$MON" \
    && ok "and the page has a panel for it" || bad "and the page has a panel for it"
  grep -q 'renderMem();renderCompliance()' "$MON" \
    && ok "and paint actually calls it" || bad "and paint actually calls it"
  # No server and no network. A governance page that phones out is not one.
  if grep -qiE 'src="https?:|href="https?:|@import[[:space:]]+url\(http' "$MON"; then
    bad "self-contained, no external references"
  else
    ok "self-contained, no external references"
  fi

  # The route log records whatever was typed, and the data is embedded inside a
  # <script> element. An HTML parser looks for the literal characters closing
  # that tag without caring that they sit inside a string, so a prompt is a way
  # to end the script early and put markup on the page.
  printf '%s\thostile\t9\t{"prompt":"</script\076<img src=x onerror=alert(1)\076"}\n' \
    "2026-01-01T00:00:00Z" >> "$MEM/widget/routes.log"
  ( cd "$REPO" && "$FELIX" monitor >/dev/null 2>&1 )
  # The payload survives as inert text — that is fine and even desirable, since
  # the page is for reading what happened. What must not survive is a bracket.
  if grep -q 'u003c/script' "$MON"; then
    ok "a hostile prompt is neutralised, not dropped"
  else
    bad "a hostile prompt is neutralised, not dropped" "escaped form absent"
  fi
  grep -q '<img' "$MON" && bad "no markup from a prompt reaches the page" \
                        || ok "no markup from a prompt reaches the page"
  # ...and the page must still be one script element, not two.
  n="$(grep -c '</script>' "$MON")"
  is "the page still closes exactly one script" "$n" "1"
fi

printf '\ndenial\n'
# The first thing Felix can actually stop. Every other hook injects text a
# session may ignore; PreToolUse decides. Verified against two working
# implementations on this machine rather than assumed: exit 2 blocks and the
# reason goes to stderr, exit 0 allows.
#
# Scoped to Bash by the matcher in hooks.json, so a mistake here cannot deny an
# edit. A deny hook that gets this wrong is indistinguishable from a broken
# editor, which is the failure guard.sh exists to describe.
cat > "$FROOT/projects/widget/deny.tsv" <<'EOF'
# tool	pattern	reason
Bash	git add (-A|--all|\.)$	stage explicit paths; -A stages what you did not read
Bash	(^|[;&| ])\./scripts/gate\.sh	that is not the gate Felix runs
EOF

_pre() { printf '%s' "$1" | "$FROOT/harness/hooks/pre-tool" 2>"$FROOT/.deny-err"; }

( cd "$REPO" && _pre '{"tool_name":"Bash","tool_input":{"command":"git add -A"}}' ); rc=$?
is "a denied command exits 2" "$rc" "2"
has "and says why" "$(cat "$FROOT/.deny-err")" "stage explicit paths"

( cd "$REPO" && _pre '{"tool_name":"Bash","tool_input":{"command":"git add src/widget.py"}}' ); rc=$?
is "an explicit path is allowed" "$rc" "0"

( cd "$REPO" && _pre '{"tool_name":"Bash","tool_input":{"command":"./scripts/gate.sh --quick"}}' ); rc=$?
is "running a rival gate is denied" "$rc" "2"

# The reason a project would ever turn this off is a false deny, so the failure
# mode has to be allow. Anything unparseable, any missing table, any error.
( cd "$REPO" && _pre 'not json at all' ); rc=$?
is "an unparseable payload is allowed" "$rc" "0"
( cd "$PLAIN" && _pre '{"tool_name":"Bash","tool_input":{"command":"git add -A"}}' ); rc=$?
is "an ungoverned repo is allowed" "$rc" "0"

# A malformed row must not take the whole table down with it, the same way a
# malformed routes.tsv row is skipped rather than fatal.
printf 'Bash\n' >> "$FROOT/projects/widget/deny.tsv"
( cd "$REPO" && _pre '{"tool_name":"Bash","tool_input":{"command":"git add -A"}}' ); rc=$?
is "a malformed row is skipped, others still deny" "$rc" "2"
rm -f "$FROOT/projects/widget/deny.tsv" "$FROOT/.deny-err"

( cd "$REPO" && _pre '{"tool_name":"Bash","tool_input":{"command":"git add -A"}}' ); rc=$?
is "no deny.tsv means nothing is denied" "$rc" "0"

printf '\ndenial past Bash\n'
# The matcher bound Bash alone, so no rule could see Read, Edit or Write — which
# the ledger then showed is where real sessions spend most of their calls. The
# hold-up was never the plumbing: the matcher was the blast-radius control, and
# a bad regex reaching Edit looks exactly like a broken editor.
#
# What a rule matches is now the field naming the thing the tool acts on, and a
# pattern broad enough to refuse ordinary work is refused as a rule instead of
# honoured. That makes the bad-regex case unreachable rather than accepted.
{ printf 'Bash\tgit add (-A|--all|\\.)$\tstage explicit paths\n'
  printf 'Edit\t/\\.env$\t.env holds live credentials; change it by hand\n'
  printf 'Write\t\\.lock$\ta lockfile is written by its tool, never by hand\n'
  printf 'Read\t/secrets/\treading a secret is how it reaches a transcript\n'
} > "$FROOT/projects/widget/deny.tsv"

( cd "$REPO" && _pre '{"tool_name":"Edit","tool_input":{"file_path":"/w/.env","old_string":"a","new_string":"b"}}' ); rc=$?
is  "a path rule denies an edit" "$rc" "2"
has "and says why" "$(cat "$FROOT/.deny-err")" "live credentials"

( cd "$REPO" && _pre '{"tool_name":"Edit","tool_input":{"file_path":"/w/src/widget.py","old_string":"a","new_string":"b"}}' ); rc=$?
is "an unrelated path is allowed" "$rc" "0"

( cd "$REPO" && _pre '{"tool_name":"Write","tool_input":{"file_path":"/w/uv.lock","content":"x"}}' ); rc=$?
is "a write rule denies a write" "$rc" "2"

# The tool column has to keep meaning something, or widening the matcher has
# quietly turned every rule into a rule about every tool.
( cd "$REPO" && _pre '{"tool_name":"Write","tool_input":{"file_path":"/w/.env","content":"x"}}' ); rc=$?
is "a rule naming Edit does not deny a Write" "$rc" "0"

( cd "$REPO" && _pre '{"tool_name":"Read","tool_input":{"file_path":"/w/secrets/key.pem"}}' ); rc=$?
is "reading can be refused too" "$rc" "2"

( cd "$REPO" && _pre '{"tool_name":"NotebookEdit","tool_input":{"notebook_path":"/w/.env"}}' ); rc=$?
is "a notebook is matched on its own path field" "$rc" "0"

# A rule matches what the tool acts on and never what it would write. Matching
# content would turn every edit payload into a search target, so a rule written
# about a filename would start firing on prose that merely mentions it.
printf 'Edit\tuv\\.lock\tnot by hand\n' > "$FROOT/projects/widget/deny.tsv"
( cd "$REPO" && _pre '{"tool_name":"Edit","tool_input":{"file_path":"/w/README.md","old_string":"see uv.lock","new_string":"see uv.lock now"}}' ); rc=$?
is "a rule never matches file content" "$rc" "0"

( cd "$REPO" && _pre '{"tool_name":"Edit","tool_input":{}}' ); rc=$?
is "a payload naming nothing to act on is allowed" "$rc" "0"

# The sharp version of the same thing, and the one that decides how the field
# is read. Content quoting the field name is already defused, because JSON
# escapes those quotes and they are neutralised before any match runs — checked
# rather than assumed. What is not defused is a second unescaped copy further
# along the envelope, which a greedy match reads in preference to the real one.
# Claude Code is free to add envelope keys, so the subject has to be the first
# occurrence rather than the last.
printf 'Edit\t/\\.env$\tcredentials\n' > "$FROOT/projects/widget/deny.tsv"
( cd "$REPO" && _pre '{"tool_name":"Edit","tool_input":{"file_path":"/w/README.md"},"related":{"file_path":"/w/.env"}}' ); rc=$?
is "a later copy of the field in the envelope is not the subject" "$rc" "0"

# The reason widening was held back, made unreachable. A pattern matching an
# ordinary path or an ordinary command is not a narrow rule with a bug in it;
# it is a rule that refuses everything, and honouring one is indistinguishable
# from a broken editor. Skipping it can only ever allow more than was intended,
# which is the direction every other failure in this file already takes.
printf 'Edit\t.*\teverything\n' > "$FROOT/projects/widget/deny.tsv"
( cd "$REPO" && _pre '{"tool_name":"Edit","tool_input":{"file_path":"/w/src/widget.py"}}' ); rc=$?
is "a rule that refuses everything is refused as a rule" "$rc" "0"

printf 'Bash\t.\tanything at all\n' > "$FROOT/projects/widget/deny.tsv"
( cd "$REPO" && _pre '{"tool_name":"Bash","tool_input":{"command":"ls"}}' ); rc=$?
is "and over-broad means over-broad for Bash too" "$rc" "0"

# Generous is not the same as over-broad. A rule covering a whole tree of
# generated files still has to fire, or the guard has eaten the feature.
printf 'Edit\t/(node_modules|dist)/\tgenerated; change the source\n' > "$FROOT/projects/widget/deny.tsv"
( cd "$REPO" && _pre '{"tool_name":"Edit","tool_input":{"file_path":"/w/dist/bundle.js"}}' ); rc=$?
is "a broad but legitimate rule still denies" "$rc" "2"

# A skipped rule has to be visible somewhere a person looks, or it is a rule
# that silently does nothing — the same complaint Felix makes about other
# people's plugins. The hook stays quiet because it runs on every call.
printf 'Edit\t.*\teverything\n' > "$FROOT/projects/widget/deny.tsv"
out="$( cd "$REPO" && "$FELIX" doctor 2>&1 )"
has "doctor names the rule that refuses everything" "$out" "refuses everything it was asked about"
printf 'Edit\t/\\.env$\tcredentials\n' > "$FROOT/projects/widget/deny.tsv"
out="$( cd "$REPO" && "$FELIX" doctor 2>&1 )"
case "$out" in
  *"refuses everything it was asked about"*) bad "doctor is quiet when every rule is narrow" "reported anyway" ;;
  *) ok "doctor is quiet when every rule is narrow" ;;
esac
rm -f "$FROOT/projects/widget/deny.tsv" "$FROOT/.deny-err"

# The wiring itself, read off the file that ships rather than the fixture copy.
# Correct code behind a matcher that never fires is this project's oldest and
# most expensive failure mode.
HOOKS_JSON="$(cd "$REAL_HARNESS/.." && pwd)/hooks/hooks.json"
mj="$(sed -n '/"PreToolUse"/,/]/p' "$HOOKS_JSON" | sed -n 's/.*"matcher"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
for t in Bash Edit Write Read NotebookEdit; do
  case "$mj" in *"$t"*) ok "PreToolUse is bound for $t" ;; *) bad "PreToolUse is bound for $t" "matcher is [$mj]" ;; esac
done

printf '\nwhere memory lives\n'
# Memory left this repository on 2026-08-14. The property under test is not
# which directory it landed in — that is configurable — but that the answer
# never depends on where Felix's home is. Home *is* the checkout whenever Felix
# governs itself, and that is the exact case that put somebody else's
# confidential material into a public repository.
_md() { ( . "$REAL_HARNESS/lib/resolve.sh"; unset FELIX_MEMORY; HOME=/tmp/nohome; felix_mem_dir "$1" ) ; }
is "memory is keyed on the project name"   "$(_md /some/home/projects/widget)" "/tmp/nohome/.felix/memory/widget"
is "and not on which home it came from"    "$(_md /a/different/home/projects/widget)" "$(_md /some/home/projects/widget)"
is "a trailing slash resolves the same"    "$(_md /some/home/projects/widget/)" "$(_md /some/home/projects/widget)"
# The override is what makes this suite possible at all, so it is asserted
# rather than assumed: without it every fixture would write into the developer's
# own memory and the tests would pass while corrupting the record.
is "FELIX_MEMORY overrides the default" \
   "$( . "$REAL_HARNESS/lib/resolve.sh"; FELIX_MEMORY=/tmp/elsewhere felix_mem_dir /h/projects/widget )" \
   "/tmp/elsewhere/widget"
# The root, without a project on the end, for the one caller that has to talk
# about memory in general rather than one project's.
is "the root is available on its own" \
   "$( . "$REAL_HARNESS/lib/resolve.sh"; FELIX_MEMORY=/tmp/elsewhere felix_mem_root )" \
   "/tmp/elsewhere"

# Uninstall says what it kept, and the split left it naming the wrong place.
#
# It printed "left <home> alone: it holds your doctrine and memory" — naming the
# checkout, which after 2026-08-14 holds doctrine and no memory at all. Nothing
# was ever destroyed; the message was simply wrong about where the thing it
# preserved had gone. On the uninstall path that is the worst place to be vague,
# because it is the one moment somebody is deciding whether they are about to
# lose something.
CLB="$TMP/claudestub"; mkdir -p "$CLB"
printf '#!/usr/bin/env bash\nexit 0\n' > "$CLB/claude"; chmod +x "$CLB/claude"
uout="$(cd "$REPO" && PATH="$CLB:$PATH" FELIX_MEMORY=/tmp/mem-elsewhere "$FELIX" install --uninstall 2>&1)"
has "uninstall names the doctrine it left alone" "$uout" "$FROOT"
has "and the memory, which is somewhere else now" "$uout" "/tmp/mem-elsewhere"
# Never inside the tree it is describing, whatever home resolves to. Stated as
# its own assertion because it is the whole point and a future refactor that
# derived the root from felix_home would still pass every check above.
case "$(_md /some/home/projects/widget)" in
  /some/home/*) bad "the root is never under the home it was asked about" ;;
  *)            ok  "the root is never under the home it was asked about" ;;
esac

# And the shipped tree, because a fixture cannot tell you whether the real
# repository is still carrying memory. This is the same question the gate's
# `memory` check asks, asserted here so the suite fails too rather than leaving
# it to a gate somebody can skip.
_RD="$(cd "$REAL_HARNESS/../.." && pwd)"
if git -C "$_RD" rev-parse --git-dir >/dev/null 2>&1; then
  is "the repository tracks no project memory" \
     "$(git -C "$_RD" ls-files -- 'projects/*/memory/*' | head -3 | tr '\n' ' ')" ""
  # The ignore rule is the backstop for the same property. Checked against a
  # path rather than a file, so it holds in a checkout where nothing is there.
  git -C "$_RD" check-ignore -q 'projects/widget/memory/says.log' 2>/dev/null \
    && ok "and ignores the path so it cannot come back" \
    || bad "and ignores the path so it cannot come back"
else
  skip "the repository tracks no project memory" "not a git checkout"
fi

printf '\nindependence\n'
# Scoped to code that runs in production. This suite names Elenchus in its own
# comments on purpose, since explaining what it refuses to depend on is the point.
runtime=("$FROOT/harness/felix" "$FROOT/harness/lib" "$FROOT/harness/hooks")
if grep -rniq "elenchus" "${runtime[@]}" 2>/dev/null; then
  bad "runtime harness names no specific project" \
      "$(grep -rni 'elenchus' "${runtime[@]}" | head -3)"
else
  ok "runtime harness names no specific project"
fi

printf '\n%d passed, %d failed' "$PASS" "$FAIL"
[ "$SKIP" -gt 0 ] && printf ', %d skipped' "$SKIP"
printf '\n'
[ "$FAIL" -eq 0 ] || exit 1

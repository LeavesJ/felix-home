for i in 1 2 3; do printf '\n## 2026-01-0%s b abc\n\nzephyrine handling again\n' "$i" >> "$D"; done
printf '\n## 2026-02-01 b abc\n\nmonolith monolith monolith monolith monolith\n' >> "$D"

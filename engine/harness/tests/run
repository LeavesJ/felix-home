MEMREPO="$REPO"
out="$(cd "$MEMREPO" && "$FELIX" log "did a thing for a reason" 2>&1)"
has "log writes to the devlog" "$out" "DEVLOG.md"
grep -q "did a thing for a reason" "$MEM/widget/DEVLOG.md" \

       "$(_jstr "bash -s \"$GOV\" <<'EOF'"$'\n''C="$1"; cd "$C" || exit 1'$'\n''git update-ref refs/remotes/origin/main HEAD'$'\n''EOF')" \
       "$GOV" "$GOV" && echo lifted || echo stood )" "stood"
_sc 0 "scoped: a single-quoted bash -c fixture given its directory" - "bash -c 'mkdir -p \"\$1/r\" && cd \"\$1/r\" && git init -q && git remote add origin https://example.com/x.git' sh $SCR/p3"
_sc 0 "scoped: mkdir -p, cd, then a remote on the lines after" - "W=$SCR/p4; mkdir -p \"\$W/repo\"; cd \"\$W/repo\"; git init -q"$'\n''git remote add origin https://nowhere.example/fx.git'
_sc 0 "scoped: a mktemp fixture read back through pwd -P" - 'T=$(mktemp -d); REPO="$T/repo"; mkdir -p "$REPO"; (cd "$REPO" && git init -q -b main); REPO="$(cd "$REPO" && pwd -P)"; (cd "$REPO" && git add -A && git commit -qm base)'
# --- what can change the meaning of a word the reader already knows. Each of
# these lifted before the reader was taught it, found by reading it against
# the shell rather than by a case.
_scr stage "scoped: a function named cd runs instead of the builtin" - "cd() { builtin cd $GOV; }; cd $SCR/plain && git add -A && git commit -qm x"
_scr stage "scoped: a function named git runs instead of git" - "git() { command git -C $GOV \"\$@\"; }; cd $SCR/clone && git add -A && git commit -qm x"
_sc 0 "scoped: builtin cd steps past a function of that name" - "cd() { :; }; builtin cd $SCR/clone && command git add -A && command git commit -qm x"
_scr stage "scoped: printf -v assigns the variable a later cd reads" - "x=$SCR/plain; printf -v x '%s' \"$GOV\"; cd \"\$x\" && git add -A && git commit -qm x"
_scr stage "scoped: an ANSI-C escape the reader does not decode" "$SCR/plain" "cd \$'..\\x2f..\\x2fgov' && git add -A && git commit -qm x"
_scr stage "scoped: a directory named as a command, which AUTO_CD would enter" "$SCR/plain" "$GOV; git add -A && git commit -qm x"
_scr stage "scoped: a DEBUG trap runs between the commands read" - "trap 'cd $GOV' DEBUG; cd $SCR/clone && git add -A && git commit -qm x"
_sc 0 "scoped: an EXIT trap with a known action does not" - "trap 'true' EXIT; cd $SCR/clone && git add -A && git commit -qm x"
_scr stage "scoped: CDPATH given to cd moves a relative cd" "$SCR/plain" "CDPATH=$SC cd gov && git add -A && git commit -qm x"
_scr stage "scoped: cd - goes where OLDPWD says" "$SCR/plain" "cd $SCR/clone; OLDPWD=$GOV; cd - && git add -A && git commit -qm x"
_scr stage "scoped: cd reads .. by spelling, through a link out of the checkout" "$SCR/plain" "cd $GOV/out/.. && git add -A && git commit -qm x"
( cd "$GOV" && printf '{"session_id":"scoped","cwd":"%s","tool_name":"Bash","tool_input":{"command":"cd \\u002f%s && git add -A"}}' \
    "$SCR/plain" "${GOV#/}" | "$FROOT/harness/hooks/pre-tool" 2>"$SC_ERR" ); rc=$?
is "scoped: a \\u escape in the payload is not read as its letters" "$rc" "2"
_long="cd $SCR/clone && git add -A && git commit -qm x$(printf ' %.0s' $(seq 1 33000))"
_scr stage "scoped: a command longer than the reader reads keeps the refusal" - "$_long"
has "and says it was too long to read" "$(cat "$SC_ERR")" "longer than this reads"
# --- a lift is written down, and a refusal is not written as one
_lifts() { awk -F'\t' '$2 == "lifted"' "$MEM/widget/says.log" 2>/dev/null; }
_sc 0 "scoped: a lift to be recorded" "$SCR/clone" 'git add -A && git commit -qm recorded-lift'
has "a lifted scoped row is written to says.log with the command" "$(_lifts | tail -1)" "recorded-lift"
_n="$(_lifts | wc -l | tr -d ' ')"
_scr stage "scoped: a refusal that must not be recorded as a lift" - 'git add -A && git commit -qm not-a-lift'
is "and a scoped row that stood writes no lift" "$(_lifts | wc -l | tr -d ' ')" "$_n"
# --- what a refusal of a scoped row says
( cd "$GOV" && _scpay - Bash command 'git add -A' | "$FROOT/harness/hooks/pre-tool" 2>"$SC_ERR" )
has "a scoped row that stands says it covers only the checkout" "$(cat "$SC_ERR")" "covers only the governed checkout"
has "and names the command and the place" "$(cat "$SC_ERR")" "\`git add -A\`: it acts on $GOV, in the governed checkout"
# --- it can only keep a refusal when it cannot tell
mkdir -p "$SC/nowhere"; cp "$FROOT/harness/lib/deny.sh" "$FROOT/harness/lib/deny-read.sh" "$SC/nowhere/"
is "without lib/where.sh beside it a scoped row stands" \
   "$( cd "$GOV" && . "$SC/nowhere/deny.sh" && felix_deny_match "$FROOT/projects/widget" Bash "cd $SCR/plain && git add -A" "$SCR/plain" >/dev/null && echo refused )" \
   "refused"
is "and with it, the same call lifts" \
   "$( cd "$GOV" && . "$FROOT/harness/lib/deny.sh" && felix_deny_match "$FROOT/projects/widget" Bash "cd $SCR/plain && git add -A" "$SCR/plain" >/dev/null && echo refused || echo lifted )" \
   "lifted"
is "a reader that cannot run lifts nothing" \
   "$( cd "$GOV" && . "$FROOT/harness/lib/where.sh" && _FELIX_WHERE_READ='this is not awk {' \
       && felix_where_lifts 'git add' "cd $SCR/plain && git add -A" "$SCR/plain" "$GOV" && echo lifted || echo stood )" \
   "stood"
is "the judge alone: a scratch path is throwaway" \
   "$( . "$FROOT/harness/lib/where.sh"; felix_where_path_lifts "$SCR/plain/.felix" "$SCR" "$GOV" && echo lifted || echo stood )" "lifted"
is "the judge alone: a worktree of the checkout is not" \
   "$( . "$FROOT/harness/lib/where.sh"; felix_where_path_lifts "$GWT/.felix" "$SCR" "$GOV" && echo lifted || echo stood )" "stood"
is "a TMPDIR of / is not a temporary root" \
   "$( . "$FROOT/harness/lib/where.sh"; TMPDIR=/; felix_where_path_lifts /usr/felix-where-nowhere "$SCR" "$GOV" && echo lifted || echo stood )" "stood"
is "a TMPDIR that holds \$HOME is not a temporary root" \
   "$( . "$FROOT/harness/lib/where.sh"; h="$(cd -P "$HOME/.." && pwd -P)"; TMPDIR="$h"
       felix_where_path_lifts "${h%/}/felix-where-nowhere/x" "$SCR" "$GOV" && echo lifted || echo stood )" "stood"
mkdir -p "$SCR/home"
( cd "$GOV" && _scpay "$SCR/plain" Bash command 'echo w > ~/.felix-home' | HOME="$SCR/home" "$FROOT/harness/hooks/pre-tool" 2>"$SC_ERR" ); rc=$?
is "a \$HOME under a temporary root still keeps its pointer" "$rc" "2"
# A reader that dies part-way has written only some of what it would have. The
# control beside it is the same reader reaching its end, which lifts, so the
# refusal is the missing end and nothing else.
cat > "$SC/stops.awk" <<'EOF'
BEGIN { printf "C\tp\t\tgit add -A\t\036%s\t0,9\n", CWD0; exit 0 }
EOF
cat > "$SC/ends.awk" <<'EOF'
BEGIN { printf "C\tp\t\tgit add -A\t\036%s\t0,9\nE\n", CWD0; exit 0 }
EOF
for _sa in stops ends; do
  _sv="$( cd "$GOV" && . "$FROOT/harness/lib/where.sh" && _FELIX_WHERE_READ="$(cat "$SC/$_sa.awk")" \
          && felix_where_lifts 'git add' 'git add -A' "$SCR/plain" "$GOV" && echo lifted || echo stood )"
  case "$_sa" in
    stops) is "a reader that stops before its end lifts nothing" "$_sv" "stood" ;;
    ends)  is "the same reader reaching its end would lift" "$_sv" "lifted" ;;
  esac
done
rm -f "$FROOT/projects/widget/deny.tsv" "$SC_ERR"

printf '\nthe subject of a large payload\n'
# felix_deny_subject reads a small payload with parameter expansion and a large
# one with one awk, because ${s//pat/rep} in bash 3.2 is not linear. Measured
# 2026-09-23 on 3.2.57, the bash the hook runs under on macOS: a 31K
# commit-template payload took 12 to 13 s to read, a 9K `python3 -c` one 19 s,
# and a 45K one did not finish in 110 s, against Claude Code's 60 s hook
# timeout. Two readings of one thing are safe only if size never changes the
# answer, so each case is read both ways and held to one expected subject.
_subj() {  # _subj <inline limit> <tool> <payload>
  ( . "$FROOT/harness/lib/deny.sh"; _FELIX_DENY_INLINE="$1"; felix_deny_subject "$3" "$2" )
}
_both() {  # _both <name> <tool> <payload> <expected>
  is "$1" "$(_subj 0 "$2" "$3")|$(_subj 999999999 "$2" "$3")" "$4|$4"
}
_both "read by awk and by expansion alike: escaped quotes are the value's own" Bash \
  '{"tool_input":{"command":"echo \"a b\" | grep \"c\"","description":"d"}}' 'echo "a b" | grep "c"'
_both "read by awk and by expansion alike: an escaped quote does not carry the value into the next field" Bash \
  '{"tool_input":{"command":"say \"hi\"","description":"git add -A"}}' 'say "hi"'
_both "read by awk and by expansion alike: the first occurrence of the field wins" Edit \
  '{"tool_input":{"file_path":"/w/README.md"},"related":{"file_path":"/w/.env"}}' '/w/README.md'
_both "read by awk and by expansion alike: a value ending on an escaped quote" Bash \
  '{"tool_input":{"command":"echo \""}}' 'echo "'
_both "read by awk and by expansion alike: a value opening on an escaped quote" Bash \
  '{"tool_input":{"command":"\"x\" y"}}' '"x" y'
_both "read by awk and by expansion alike: an empty value is empty" Bash \
  '{"tool_input":{"command":"","description":"x"}}' ''
_both "read by awk and by expansion alike: every other JSON escape is left as written" Bash \
  '{"tool_input":{"command":"a\nb\tc\\d\/e"}}' 'a\nb\tc\\d\/e'
_both "read by awk and by expansion alike: a line break in the value is kept, beside escaped quotes" Bash \
  $'{"tool_input":{"command":"a \\"b\nc\\" d"}}' $'a "b\nc" d'
_both "read by awk and by expansion alike: a value with no closing quote runs to the end" Bash \
  '{"tool_input":{"command":"abc' 'abc'
_both "read by awk and by expansion alike: space round the colon" Bash \
  '{"tool_input":{"command" : "x y"}}' 'x y'
# Two of 44 cases derived blind from the contract alone, kept here because
# they are where awks differ, and CI reads them with another awk than macOS:
# bytes that are not UTF-8, and CRs, taken as they are; three backslashes
# before a quote, which lose one.
_both "read by awk and by expansion alike: bytes that are not UTF-8, and CRs, are kept as they are" Bash \
  $'{"tool_input":{"command":"caf\xc3\xa9 \xe9\xff\xfe \\"x\\"\r\\"y\\"\r\xc3","description":"d"}}' \
  $'caf\xc3\xa9 \xe9\xff\xfe "x"\r"y"\r\xc3'
_both "read by awk and by expansion alike: three backslashes before a quote lose one" Bash \
  '{"tool_input":{"command":"a\\\"b\\\"","description":"d"}}' 'a\\"b\\"'
# A quote after an escaped backslash ends a JSON string, and the expansion
# reads it as escaped: it looks only at the character before each quote. The
# awk does the same on purpose, so that where the reading is loose, it is
# loose the same way whatever the size.
is "a value ending on an escaped backslash is read the same both ways" \
   "$(_subj 0 Bash '{"tool_input":{"command":"echo a\\","description":"b"}}')" \
   "$(_subj 999999999 Bash '{"tool_input":{"command":"echo a\\","description":"b"}}')"
# A raw \001 is not JSON, and it is the expansion's own placeholder, so it
# read as a quote there and as itself in the awk. Neither reads it now.
_soh="$(printf '\001')"
_soh="{\"tool_input\":{\"command\":\"a${_soh}b\",\"description\":\"d\"}}"
_both "read by awk and by expansion alike: a payload holding a raw SOH byte, which JSON cannot, has no subject" Bash \
  "$_soh" ''

# What each reading costs. The expansion runs on nearly every call, and a
# program started there is a tax on the whole session, so a small payload
# must run no awk. A large one is read by exactly one, whatever it holds.
_AWKN="$TMP/awk-calls"; mkdir -p "$TMP/awkshim" "$TMP/awkfail"
printf '#!/bin/sh\nprintf x >> "%s"\nexec "%s" "$@"\n' "$_AWKN" "$(command -v awk)" > "$TMP/awkshim/awk"
chmod +x "$TMP/awkshim/awk"
_awkn() {  # _awkn <payload>: how many awk processes reading its subject took
  : > "$_AWKN"
  ( . "$FROOT/harness/lib/deny.sh"; PATH="$TMP/awkshim:$PATH"; felix_deny_subject "$1" Bash >/dev/null )
  wc -c < "$_AWKN" | tr -d ' '
}
is "a small payload's subject is read without running awk" \
   "$(_awkn '{"tool_name":"Bash","tool_input":{"command":"git status --short"}}')" "0"
# Built into a variable first: in bash 3.2 a quoted {..,..} inside "$( )"
# is brace-expanded, and the payload arrives as `"tool_name":"Bash"`.
_mid="$(awk 'BEGIN { for (i = 0; i < 200; i++) printf "echo \\\"%d\\\" ; ", i }')"
_mid="{\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"$_mid\"}}"
is "a large payload's subject is read by exactly one awk" "$(_awkn "$_mid")" "1"
# Fails open, and never on part of a command: a row anchored at the end can
# refuse the part an awk printed before it died, where the whole command
# would not match. An awk that fails reads as no subject.
printf '#!/bin/sh\ncat >/dev/null\nprintf "git add -A"\nexit 2\n' > "$TMP/awkfail/awk"
chmod +x "$TMP/awkfail/awk"
is "a large payload whose awk fails part way has no subject, rather than the part it printed" \
   "$( . "$FROOT/harness/lib/deny.sh"; PATH="$TMP/awkfail:$PATH"; felix_deny_subject "$_mid" Bash )" ""

# A watchdog ends the whole tree it started: the awk is a grandchild of the
# hook, and ending the direct children alone leaves it running.
_killtree() { local c; for c in $(pgrep -P "$1" 2>/dev/null); do _killtree "$c"; done; kill "$1" 2>/dev/null; }

# Linear, and not only fast at one size. A reading with a gsub in it is
# quadratic in BWK awk and still passes a deadline at 220K: measured 0.22 s
# there, and 15.7 s at 2M. So the CPU time of one reading, taken inside the
# subshell so that neither load nor the watchdog's polling adds to it, for a
# payload and one four times its size: linear is about four times, quadratic
# sixteen. Under a watchdog at thirty seconds, for the expansion's sake.
_lin() {  # _lin <units>: CPU ms for one reading of that many 22-byte units, or killed
  local f="$TMP/lin-$1.json" i=0 pid
  { printf '{"tool_name":"Bash","tool_input":{"command":"'
    awk -v n="$1" 'BEGIN { for (i = 0; i < n; i++) printf "printf \\\"%%s\\\" \\\"a\\\" ; " }'
    printf 'true"}}'; } > "$f"
  ( . "$FROOT/harness/lib/deny.sh"; raw="$(cat "$f")"
    felix_deny_subject "$raw" Bash >/dev/null; times > "$f.cpu" ) &
  pid=$!
  while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 300 ]; do sleep 0.1; i=$((i + 1)); done
  if kill -0 "$pid" 2>/dev/null; then _killtree "$pid"; wait "$pid" 2>/dev/null; echo killed; return; fi
  wait "$pid" 2>/dev/null
  # times: the subshell's user and system time, then its children's, as 0m1.234s.
  awk '{ for (i = 1; i <= NF; i++) { split($i, t, "m"); sub(/s$/, "", t[2]); ms += (t[1] * 60 + t[2]) * 1000 } }
       END { printf "%d", ms }' "$f.cpu"
  rm -f "$f" "$f.cpu"
}
_l1="$(_lin 12000)"
if [ "$_l1" = killed ]; then _lv="264K was not read in thirty seconds"; else
  _l4="$(_lin 48000)"
  if [ "$_l4" = killed ]; then _lv="1M was not read in thirty seconds"
  elif [ "$_l4" -lt $((_l1 * 8)) ]; then _lv=linear
  else _lv="264K took ${_l1} ms and 1M ${_l4} ms"; fi
fi
is "reading a large payload's subject is linear: four times the payload costs under eight times the CPU" "$_lv" "linear"

# The reason for all of it, as deadlines through the hook, refused well
# inside Claude Code's 60 s. Each under a watchdog that ends the hook and
# everything under it at twenty seconds, since the expansion on these
# payloads runs for minutes or days, and a red run is exactly where it would.
#
# A refused Bash command is read a second time, by felix_deny_code, at about
# 12 us a character (2.3 s of CPU for 200K, measured 2026-09-23), and a
# deadline on a large one would be measuring that. So the Bash command is
# 44K, where the expansion took 102 s of CPU, and the large payload is a
# Write: the expansion read everything after the key, a Write's content
# included.
_hook_within() {  # _hook_within <payload file>: finished:<exit> or killed:<exit>
  local pid i=0 end
  ( cd "$REPO" && exec "$FROOT/harness/hooks/pre-tool" < "$1" 2>/dev/null ) &
  pid=$!
  while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 200 ]; do sleep 0.1; i=$((i + 1)); done
  if kill -0 "$pid" 2>/dev/null; then _killtree "$pid"; end=killed; else end=finished; fi
  wait "$pid" 2>/dev/null
  printf '%s:%s' "$end" "$?"
}
{ printf 'Bash\tgit add (-A|--all|\\.)$\tstage explicit paths\n'
  printf 'Write\t\\.lock$\ta lockfile is written by its tool\n'; } > "$FROOT/projects/widget/deny.tsv"
_big="$TMP/deny-big.json"
{ printf '{"session_id":"deny-big","tool_name":"Bash","tool_input":{"command":"'
  awk 'BEGIN { for (i = 0; i < 2000; i++) printf "printf \\\"%%s\\\" \\\"a\\\" ; " }'
  printf 'git add -A","description":"d"},"tool_use_id":"t"}'; } > "$_big"
is "a 44K command with 8,000 escaped quotes is refused through the hook inside twenty seconds" \
   "$(_hook_within "$_big")" "finished:2"
{ printf '{"session_id":"deny-big","tool_name":"Write","tool_input":{"file_path":"/w/uv.lock","content":"'
  awk 'BEGIN { for (i = 0; i < 10000; i++) printf (i % 20 ? "printf %%s aaaaaaa ; " : "printf \\\"%%s\\\" \\\"a\\\" ; ") }'
  printf '"},"tool_use_id":"t"}'; } > "$_big"
is "a 200K Write holding 2,000 escaped quotes is refused on its path through the hook inside twenty seconds" \
   "$(_hook_within "$_big")" "finished:2"
rm -f "$FROOT/projects/widget/deny.tsv" "$_big"

printf '\nwhere memory lives\n'
# Memory left this repository on 2026-08-14. The property under test is not
# which directory it landed in — that is configurable — but that the answer
# never depends on where Felix's home is. Home *is* the checkout whenever Felix
# governs itself, and that is the exact case that put somebody else's
# confidential material into a public repository.
_md() { ( . "$REAL_HARNESS/lib/resolve.sh"; unset FELIX_MEMORY; HOME=/tmp/nohome; felix_mem_dir "$1" ) ; }
is "memory is keyed on the project name"   "$(_md /some/home/projects/widget)" "/tmp/nohome/.felix/memory/widget"
is "and not on which home it came from"    "$(_md /a/different/home/projects/widget)" "$(_md /some/home/projects/widget)"
is "a trailing slash resolves the same"    "$(_md /some/home/projects/widget/)" "$(_md /some/home/projects/widget)"
# The override is what makes this suite possible at all, so it is asserted
# rather than assumed: without it every fixture would write into the developer's
# own memory and the tests would pass while corrupting the record.
is "FELIX_MEMORY overrides the default" \
   "$( . "$REAL_HARNESS/lib/resolve.sh"; FELIX_MEMORY=/tmp/elsewhere felix_mem_dir /h/projects/widget )" \
   "/tmp/elsewhere/widget"
# The root, without a project on the end, for the one caller that has to talk
# about memory in general rather than one project's.
is "the root is available on its own" \
   "$( . "$REAL_HARNESS/lib/resolve.sh"; FELIX_MEMORY=/tmp/elsewhere felix_mem_root )" \
   "/tmp/elsewhere"

# Uninstall says what it kept, and the split left it naming the wrong place.
#
# It printed "left <home> alone: it holds your doctrine and memory" — naming the
# checkout, which after 2026-08-14 holds doctrine and no memory at all. Nothing
# was ever destroyed; the message was simply wrong about where the thing it
# preserved had gone. On the uninstall path that is the worst place to be vague,
# because it is the one moment somebody is deciding whether they are about to
# lose something.
CLB="$TMP/claudestub"; mkdir -p "$CLB"
printf '#!/usr/bin/env bash\nexit 0\n' > "$CLB/claude"; chmod +x "$CLB/claude"
uout="$(cd "$REPO" && PATH="$CLB:$PATH" FELIX_MEMORY=/tmp/mem-elsewhere "$FELIX" install --uninstall 2>&1)"
has "uninstall names the doctrine it left alone" "$uout" "$FROOT"
has "and the memory, which is somewhere else now" "$uout" "/tmp/mem-elsewhere"
# Never inside the tree it is describing, whatever home resolves to. Stated as
# its own assertion because it is the whole point and a future refactor that
# derived the root from felix_home would still pass every check above.
case "$(_md /some/home/projects/widget)" in
  /some/home/*) bad "the root is never under the home it was asked about" ;;
  *)            ok  "the root is never under the home it was asked about" ;;
esac

# And the shipped tree, because a fixture cannot tell you whether the real
# repository is still carrying memory. This is the same question the gate's
# `memory` check asks, asserted here so the suite fails too rather than leaving
# it to a gate somebody can skip.
_RD="$(cd "$REAL_HARNESS/../.." && pwd)"
if git -C "$_RD" rev-parse --git-dir >/dev/null 2>&1; then
  is "the repository tracks no project memory" \
     "$(git -C "$_RD" ls-files -- 'projects/*/memory/*' | head -3 | tr '\n' ' ')" ""
  # The ignore rule is the backstop for the same property. Checked against a
  # path rather than a file, so it holds in a checkout where nothing is there.
  git -C "$_RD" check-ignore -q 'projects/widget/memory/says.log' 2>/dev/null \
    && ok "and ignores the path so it cannot come back" \
    || bad "and ignores the path so it cannot come back"
else
  skip "the repository tracks no project memory" "not a git checkout"
fi

printf '\ninstalling\n'
# #55. `felix install` invoked through the DEPLOYED CLI — the way every
# session-start message tells you to reach Felix — compared the plugin cache
# against itself, reported "verified the installed engine matches this tree",
# and deployed nothing.
#
# FELIX_ROOT is computed at felix:64 from the running script's own location and
# is not overridable. Run the CLI from the cache and FELIX_ROOT *is* the cache,
# so `diff -rq "$FELIX_ROOT/harness" "$live/harness"` is a directory compared
# with itself. It cannot fail. HANDOFF.md §8 records four separate defects whose
# cause was "correct code, installed nowhere"; this was the fifth, sitting in the
# guard written to stop the other four.
#
# HOME is redirected for every invocation below. felix:264 writes
# `$FELIX_HOME_DIR` into `$HOME/.felix-home`, so a test that skipped this would
# repoint the developer's real Felix at a fixture on every suite run.
IHOME="$TMP/installhome"; mkdir -p "$IHOME/.claude/plugins"

# The engine as Claude Code actually deploys it. marketplace.json declares
# `"source": "./engine"`, so a version directory under the plugins cache holds
# the CONTENTS of engine/ — harness/ at its top level, not engine/harness/.
# Getting that nesting wrong is what makes the issue's own proposed fix wrong:
# $FELIX_HOME_DIR is the repository ROOT, so "$FELIX_HOME_DIR/harness" names
# nothing and would turn a false pass into a false failure.
ICACHE="$IHOME/.claude/plugins/cache/felix/felix/0.49.9"
mkdir -p "$ICACHE/.claude-plugin"
cp -R "$FROOT/harness" "$ICACHE/harness"
printf '{\n  "name": "felix",\n  "version": "0.49.9"\n}\n' > "$ICACHE/.claude-plugin/plugin.json"

# A source checkout whose engine DIFFERS from what is deployed. This is the
# state the command exists to detect and the state it reported as clean.
ISRC="$TMP/installsrc"
mkdir -p "$ISRC/engine/.claude-plugin" "$ISRC/.claude-plugin"
cp -R "$FROOT/harness" "$ISRC/engine/harness"
printf '\n# a line the deployed engine does not have\n' >> "$ISRC/engine/harness/lib/escape.sh"
printf '{\n  "name": "felix",\n  "version": "0.49.9"\n}\n' > "$ISRC/engine/.claude-plugin/plugin.json"
printf '{\n  "name": "felix",\n  "plugins": [ { "name": "felix", "source": "./engine" } ]\n}\n' \
  > "$ISRC/.claude-plugin/marketplace.json"

# The claude stub reports the cache as the live install path, which is what the
# real CLI reports. Only `plugin list --json` needs a body; the three mutating
# subcommands are no-ops here because the fixture is the deployed state already.
ICB="$TMP/installclaude"; mkdir -p "$ICB"
# The stub mirrors what the real CLI was MEASURED to do, not what is convenient.
# It used to exit 0 for everything, which is why #66 went unnoticed here: the
# marketplace path could be wrong and the stub would report success anyway.
#
# Measured in a scratch HOME against the real `claude`, so this is a recording
# and not a guess:
#   add <repo>/engine  -> exit 1, "Marketplace file not found at
#                         <repo>/engine/.claude-plugin/marketplace.json"
#   add <repo>         -> exit 0, registers installLocation=<repo>
# It does NOT resolve upward. Every argument is logged so the assertion can name
# the path the command actually passed rather than infer it from the output.
ICB_LOG="$TMP/installclaude.log"; : > "$ICB_LOG"
cat > "$ICB/claude" <<STUB
#!/usr/bin/env bash
printf '%s\n' "\$*" >> "$ICB_LOG"
case "\$*" in
  "plugin list --json") printf '{ "felix@felix": { "installPath": "%s" } }\n' "$ICACHE" ;;
  "plugin marketplace add "*)
    # \$4, not \${*#plugin marketplace add }. Prefix removal on \$* applies the
    # pattern to each positional parameter separately and then joins, so it
    # strips nothing here and leaves the whole command line — which made the
    # stub reject the correct path and the fix look wrong.
    [ -f "\$4/.claude-plugin/marketplace.json" ] || exit 1 ;;
esac
exit 0
STUB
chmod +x "$ICB/claude"

_inst_from_cache() {
  ( cd "$ISRC" && HOME="$IHOME" FELIX_HOME="$ISRC" PATH="$ICB:$PATH" \
      "$ICACHE/harness/felix" install --no-bump 2>&1 )
}

# THE ASSERTION THE ISSUE REQUIRES. The source tree differs from the deployed
# engine in one line, and the command is invoked from the cache. It must not
# certify that they match.
icache_out="$(_inst_from_cache)"
case "$icache_out" in
  *"verified   the installed engine matches this tree"*)
    bad "install from the plugin cache does not certify the cache against itself" "$icache_out" ;;
  *) ok "install from the plugin cache does not certify the cache against itself" ;;
esac
# And it must say which tree it compared, or the reader cannot tell a real
# verification from the vacuous one this replaces.
has "and names the source tree it compared" "$icache_out" "$ISRC/engine"

# #66. The marketplace is registered from the directory that HOLDS
# marketplace.json, which is the repository root — not the engine one level in.
# Measured against the real CLI: `add <repo>/engine` exits 1 with "Marketplace
# file not found", and does not resolve upward.
#
# It stayed invisible because the else branch masks it. add fails, control falls
# through to `marketplace update felix`, and that is the call that did the work —
# which is why the reproduction in #55 printed "marketplace refreshed" and never
# "marketplace registered". That only works because the marketplace was already
# registered correctly at some point in the past. On a genuinely FIRST install
# there is nothing to update, and the marketplace is never registered at all.
is "the marketplace is added from the directory holding its manifest" \
   "$(grep -m1 '^plugin marketplace add ' "$ICB_LOG" | sed 's#^plugin marketplace add ##')" \
   "$ISRC"
has "and it registers rather than falling through to a refresh" \
    "$icache_out" "marketplace registered"

# The control, and the half a careless fix breaks: from the cache with the
# source MATCHING, it must still verify. A fix that simply always refuses would
# pass the assertion above and make the command useless.
cp -R "$ISRC/engine/harness/." "$ICACHE/harness/"
imatch_out="$(_inst_from_cache)"
has "and still verifies when the source really does match" \
    "$imatch_out" "verified   the installed engine matches this tree"

# Run from a checkout, the behaviour is unchanged. This is the path that always
# worked, and it is what the fix must not disturb.
printf '\n# and another the deployed engine does not have\n' >> "$ISRC/engine/harness/lib/next.sh"
irepo_out="$( cd "$ISRC" && HOME="$IHOME" FELIX_HOME="$ISRC" PATH="$ICB:$PATH" \
                "$ISRC/engine/harness/felix" install --no-bump 2>&1 )"
case "$irepo_out" in
  *"verified   the installed engine matches this tree"*)
    bad "install from the checkout still reports a real mismatch" "$irepo_out" ;;
  *) ok "install from the checkout still reports a real mismatch" ;;
esac

# The fixture must not have reached outside itself. felix:264 is one line away
# from rewriting the developer's real pointer file, so this is asserted rather
# than assumed.
is "and nothing was written to the real felix home pointer" \
   "$(cat "$IHOME/.felix-home" 2>/dev/null)" "$ISRC"

printf '\nthe deployed surface is three directories\n'
# #82. The verification compared harness/ alone, and the cache serves
# harness/, hooks/ and commands/. hooks/hooks.json is the file that decides
# which hooks BIND — so a deploy that carried harness/ and dropped hooks/
# certified as `installed ok` while every session ran yesterday's bindings: a
# hook binary deployed perfectly and running nowhere, which is HANDOFF §8's
# family in the one place that claims to check deployment.
#
# Both sides get hooks/ first, matching, and the control runs before the
# tamper — a guard that refuses everything passes every tamper test.
cp -R "$ICACHE/harness/." "$ISRC/engine/harness/"
mkdir -p "$ISRC/engine/hooks" "$ICACHE/hooks"
printf '{ "hooks": { "SessionStart": [] } }\n' > "$ISRC/engine/hooks/hooks.json"
printf '{ "hooks": { "SessionStart": [] } }\n' > "$ICACHE/hooks/hooks.json"
imatch_out="$(_inst_from_cache)"
has "matching hooks still verify" \
    "$imatch_out" "verified   the installed engine matches this tree"

# The tamper: harness byte-identical, hooks.json differing — the exact state
# the old comparison certified.
printf '{ "hooks": {} }\n' > "$ICACHE/hooks/hooks.json"
itamper_out="$(_inst_from_cache)"
case "$itamper_out" in
  *"verified   the installed engine matches this tree"*)
    bad "a hooks.json that never deployed is not certified" "$itamper_out" ;;
  *) ok "a hooks.json that never deployed is not certified" ;;
esac

# And the library says so on its own, both directions, so the fix cannot be a
# message change while the comparison stays narrow.
_ddiff() { ( . "$FROOT/harness/lib/resolve.sh"; felix_deploy_diff "$1" "$2" >/dev/null 2>&1 ); }
_ddiff "$ISRC/engine" "$ICACHE" && bad "felix_deploy_diff sees the hooks drift" "reported clean" \
                                || ok  "felix_deploy_diff sees the hooks drift"
printf '{ "hooks": { "SessionStart": [] } }\n' > "$ICACHE/hooks/hooks.json"
_ddiff "$ISRC/engine" "$ICACHE" && ok  "and is clean when the three directories agree" \
                                || bad "and is clean when the three directories agree" "reported drift"
# A directory absent from ONE side is a drift, not a skip — the skip-if-absent
# shape is how a check passes by finding nothing.
rm -rf "$ICACHE/hooks"
_ddiff "$ISRC/engine" "$ICACHE" && bad "a directory missing from one side is a drift" "reported clean" \
                                || ok  "a directory missing from one side is a drift"
rm -rf "$ISRC/engine/hooks"
_ddiff "$ISRC/engine" "$ICACHE" && ok  "and absent from both sides is a fixture, not a drift" \
                                || bad "and absent from both sides is a fixture, not a drift" "reported drift"

# A path the repository itself declares non-content is residue, not drift
# (#86). The stray that fired live: a claude-flow hook dropped state under
# tests/ while the suite ran there, and the installed check called a
# byte-identical deploy a drift — then, in a worktree, misdiagnosed it as
# structural with the one-line evidence suppressed. tests/ exists on both
# sides here because that is the real shape: the stray's parent deployed
# fine, only the residue differs.
RSD="$TMP/residue"
mkdir -p "$RSD/engine/harness/tests" "$RSD/cache/harness/tests"
( cd "$RSD" && git init -q -b main )
printf '.claude-flow/\n.DS_Store\n' > "$RSD/.gitignore"
printf 'real\n' > "$RSD/engine/harness/felix"
printf 'real\n' > "$RSD/cache/harness/felix"
printf 'suite\n' > "$RSD/engine/harness/tests/run"
printf 'suite\n' > "$RSD/cache/harness/tests/run"
_ddiff "$RSD/engine" "$RSD/cache" && ok  "identical deploys are clean before any stray lands" \
                                  || bad "identical deploys are clean before any stray lands" "reported drift"
mkdir -p "$RSD/engine/harness/tests/.claude-flow/data"
printf 'x\n' > "$RSD/engine/harness/tests/.claude-flow/data/insights.jsonl"
_ddiff "$RSD/engine" "$RSD/cache" && ok  "a gitignored stray in the tree is residue, not drift" \
                                  || bad "a gitignored stray in the tree is residue, not drift" "reported drift"
printf 'junk\n' > "$RSD/cache/harness/.DS_Store"
_ddiff "$RSD/engine" "$RSD/cache" && ok  "and a gitignored stray in the cache is too" \
                                  || bad "and a gitignored stray in the cache is too" "reported drift"
printf 'new\n' > "$RSD/engine/harness/undeployed.sh"
_ddiff "$RSD/engine" "$RSD/cache" && bad "an untracked file the repo does not ignore is still a drift" "reported clean" \
                                  || ok  "an untracked file the repo does not ignore is still a drift"
ddout="$( . "$FROOT/harness/lib/resolve.sh"
          felix_deploy_diff "$RSD/engine" "$RSD/cache" 2>&1 )"
has "the surviving drift is named" "$ddout" "undeployed.sh"
case "$ddout" in
  *claude-flow*|*DS_Store*) bad "and the residue is not" "$ddout" ;;
  *)                        ok  "and the residue is not" ;;
esac
rm -f "$RSD/engine/harness/undeployed.sh"
printf 'changed\n' > "$RSD/cache/harness/felix"
_ddiff "$RSD/engine" "$RSD/cache" && bad "a content difference is still a drift" "reported clean" \
                                  || ok  "a content difference is still a drift"
printf 'real\n' > "$RSD/cache/harness/felix"

# The review of the first fix found four holes in it, each by construction,
# and each is pinned here so a refactor cannot quietly reopen it.
#
# 1. A filename containing " and " used to truncate at the first " and ", so
#    check-ignore was answered about a fragment — and an ignore rule matching
#    the fragment certified REAL content drift as clean. `notes` is ignored;
#    `notes and helpers.sh` is not, and its drift must be reported in full.
printf 'notes\n.claude-flow/\n.DS_Store\n' > "$RSD/.gitignore"
printf 'v2\n' > "$RSD/engine/harness/notes and helpers.sh"
printf 'v1\n' > "$RSD/cache/harness/notes and helpers.sh"
ddout="$( . "$FROOT/harness/lib/resolve.sh"
          felix_deploy_diff "$RSD/engine" "$RSD/cache" 2>&1 )"; ddrc=$?
is  "a filename containing ' and ' cannot hide behind a fragment" "$ddrc" "1"
has "and the drift line carries the whole name" "$ddout" "notes and helpers.sh"
rm -f "$RSD/engine/harness/notes and helpers.sh" "$RSD/cache/harness/notes and helpers.sh"

# 2. A directory-only pattern — `.claude-flow/`, the incident's own rule —
#    matches only what git can see is a directory, and a cache-side stray
#    exists in no tree at all. Asked with the trailing slash, it filters.
mkdir -p "$RSD/cache/harness/tests/.claude-flow"
printf 'x\n' > "$RSD/cache/harness/tests/.claude-flow/state"
_ddiff "$RSD/engine" "$RSD/cache" && ok  "a cache-side stray matching a directory-only rule is residue" \
                                  || bad "a cache-side stray matching a directory-only rule is residue" "reported drift"
rm -rf "$RSD/cache/harness/tests/.claude-flow"

# 3. The rule is the repository's committed ignore file, not this machine's.
#    A core.excludesFile pointing anywhere — repo config counts, it is not
#    committed either — must not reclassify real undeployed work as residue.
printf 'undeployed.sh\n' > "$RSD/private-ignore"
git -C "$RSD" config core.excludesFile "$RSD/private-ignore"
printf 'new\n' > "$RSD/engine/harness/undeployed.sh"
_ddiff "$RSD/engine" "$RSD/cache" && bad "a personal excludes file cannot hide real drift" "reported clean" \
                                  || ok  "a personal excludes file cannot hide real drift"
git -C "$RSD" config --unset core.excludesFile
rm -f "$RSD/engine/harness/undeployed.sh"

# 4. Apple diff -rq EXITS 0 when a file faces a directory of the same name —
#    the old exit-code rc certified that real deploy break as clean on macOS.
#    The line-based rc reads the message instead, which no arm claims.
mkdir -p "$RSD/cache/harness/mixed"
printf 'file\n' > "$RSD/engine/harness/mixed"
_ddiff "$RSD/engine" "$RSD/cache" && bad "a file facing a directory is a drift, whatever diff exits" "reported clean" \
                                  || ok  "a file facing a directory is a drift, whatever diff exits"
rm -rf "$RSD/cache/harness/mixed" "$RSD/engine/harness/mixed"

# 5. A directory only the cache holds, with nothing in it but residue, is
#    residue: what git ignores is subtracted before the question is asked, so
#    a whole directory of it is empty. The gate's inline copy read the missing
#    diff operand as drift; when the gate was folded onto this function
#    (2026-09-17) it took this reading, which deploy-check had answered for
#    the same fact all along, and it is pinned here so the two cannot part
#    again in silence. A real file in that directory is still drift.
mkdir -p "$RSD/cache/commands/.claude-flow"
printf 'x\n' > "$RSD/cache/commands/.claude-flow/state"
_ddiff "$RSD/engine" "$RSD/cache" && ok  "a directory only the cache holds, with nothing in it but residue, is residue" \
                                  || bad "a directory only the cache holds, with nothing in it but residue, is residue" "reported drift"
printf 'real\n' > "$RSD/cache/commands/felix.md"
_ddiff "$RSD/engine" "$RSD/cache" && bad "and with a real file in it, it is drift" "reported clean" \
                                  || ok  "and with a real file in it, it is drift"
rm -rf "$RSD/cache/commands"

# The gate kept its own inline copy of this comparison until 2026-09-17, on the
# argument that a verifier which sources the code it judges can be switched off
# by editing that code, and four assertions here held the two copies in step by
# counting the copy's tokens. The fold answered the argument without the copy:
# the installed block sources felix_accepted_deploy_diff from the BASE REF's
# resolve.sh — `git show`, never this tree, never the cache entry — and asks
# it, so the code that judges is the code main accepted. The premise the four
# rested on is gone, and what is counted now is the new mechanism's tokens, the
# same way: the function is asked, it is read from the base, that copy is the
# only thing sourced, and the residue rule (#86) is the library's alone.
# Non-comment lines only.
_REALG2="$(cd "$REAL_HARNESS/../.." && pwd)/projects/felix/gate.sh"
if [ -f "$_REALG2" ]; then
  _gate_inst="$(sed -n '/^# -.*installed/,/^# -.*tests/p' "$_REALG2" | grep -vE '^[[:space:]]*#')"
  case "$_gate_inst" in
    *'felix_accepted_deploy_diff "$ROOT"'*) ok "the gate's installed check asks the one reader, felix_accepted_deploy_diff" ;;
    *) bad "the gate's installed check asks the one reader, felix_accepted_deploy_diff" \
           "no call to felix_accepted_deploy_diff in the installed block" ;;
  esac
  case "$_gate_inst" in
    *'git show "$GBASE:engine/harness/lib/resolve.sh"'*) ok "and reads it from the base ref's resolve.sh" ;;
    *) bad "and reads it from the base ref's resolve.sh" "no git show of the base's resolve.sh" ;;
  esac
  # Every `. file` in the block — a dot, a space and then a path — and there
  # must be exactly the one, on the copy just read: a second source line is a
  # library from somewhere else. `grep .` is not a source statement.
  _gate_src="$(printf '%s\n' "$_gate_inst" | grep -E '(^|[[:space:]]|\()\. ["$/.~]' )"
  case "$(printf '%s\n' "$_gate_src" | grep -c .)|$_gate_src" in
    '1|'*'"$GLIB/resolve.sh"'*) ok "and that copy is the only library the block sources" ;;
    *) bad "and that copy is the only library the block sources" "source lines: $_gate_src" ;;
  esac
  case "$_gate_inst" in
    *check-ignore*) bad "and the residue rule is the library's alone" "check-ignore is still in the installed block" ;;
    *) ok "and the residue rule is the library's alone" ;;
  esac
  # Both failing branches print the differing paths. They were read back from a
  # fixed file every gate on the machine shared, and are held in GDRIFT now.
  is "the structural verdict shows its evidence too" \
     "$(grep -cF 'printf '"'"'%s\n'"'"' "$GDRIFT" | head -5' "$_REALG2")" "2"
else
  skip "the gate's installed check asks the one reader, felix_accepted_deploy_diff" "no shipped gate"
  skip "and reads it from the base ref's resolve.sh" "no shipped gate"
  skip "and that copy is the only library the block sources" "no shipped gate"
  skip "and the residue rule is the library's alone" "no shipped gate"
  skip "the structural verdict shows its evidence too" "no shipped gate"
fi

printf '\nindependence\n'
# #85, and mounting a second real project is what made it matter. The check
# grepped ONE hard-coded literal, `elenchus`, over three paths. Constitution
# invariant 1 is "The engine names no project" - the first invariant in the
# file - and what the check established was that seven particular letters were
# absent from three of the directories under engine/harness.
#
# Demonstrated against the real gate before this was written: an engine that
# hard-codes `veldra`, a project Felix actually governs, passes; the identical
# edit naming `elenchus` fails.
#
# The names are enumerated from projects/ so governing something new cannot
# quietly widen what the engine may say. The engine's OWN name is exempt and
# has to be: `felix` appears 1452 times in runtime code because it is the
# product, the function prefix and the binary, not a governed product being
# named. `bin/` is in the searched set because the gate EXECUTES it - the
# literal `elenchus` sitting in engine/harness/bin/secret-scan passed before.
#
# tests/ and templates/ stay out, deliberately. This suite names Elenchus in
# its own comments on purpose, since explaining what it refuses to depend on is
# the point, and the widget fixture names itself 256 times.
#
# A project is a directory that DECLARES itself with a project.json, not one
# that happens to exist. The first version globbed bare directories, which gave
# an empty stray the same authority as a governed project - projects/widget is
# one - and disagreed with the gate, which used `ls -1 projects` and so counted
# plain files too. Two hand-rolled enumerators, already divergent, under an
# assertion that claimed they were in step.
_REALP="$(cd "$REAL_HARNESS/../.." && pwd)/projects"
_gov_names() {   # every governed project except the engine's own name
  local meta n
  [ -d "$_REALP" ] || return 0
  for meta in "$_REALP"/*/project.json; do
    [ -f "$meta" ] || continue
    n="${meta%/project.json}"; n="${n##*/}"
    [ "$n" = "felix" ] && continue
    printf '%s\n' "$n"
  done
}
runtime=("$FROOT/harness/felix" "$FROOT/harness/lib" "$FROOT/harness/hooks" "$FROOT/harness/bin")

# Armed before it is trusted. This is a negative assertion over a generated set,
# which is the shape that reports success whenever the set is empty - and the
# set is read off a directory, so "no projects found" and "no project leaked"
# arrived as the same pass.
#
# A checkout that governs ONLY the engine's own project is the third case, and
# it is what anybody who clones this repository has. There is no other name to
# search for, so the negative assertion below cannot be armed — and a `bad`
# there would tell a stranger their fresh clone is broken, while an `ok` would
# be the vacuous pass this comment is about. Both are wrong; the answer is
# that the check did not run, said out loud, which is what `skip` is for.
_govn="$(_gov_names | wc -l | tr -d ' ')"
if [ "${_govn:-0}" -gt 0 ]; then
  ok "there is at least one governed project to check for"
else
  skip "there is at least one governed project to check for" \
       "this checkout governs only the engine's own project, so there is no other name to look for"
fi

# ONE assertion, with the leaking names in the detail rather than in the name.
# Per name read better and was wrong: the name is the assertion's identity, and
# these names come from the developer's own projects/ directory, so the manifest
# recorded `(veldra)` on a machine that has veldra mounted and CI - which does
# not - then FAILED with "assertion did not run". The standing instruction after
# any assertion change is to re-record, so the documented procedure broke the
# build. Static name, varying value in the detail.
_leaked=""
while IFS= read -r _gn; do
  [ -n "$_gn" ] || continue
  grep -rniqF -- "$_gn" "${runtime[@]}" 2>/dev/null && _leaked="$_leaked $_gn"
done <<EOF
$(_gov_names)
EOF
if [ "${_govn:-0}" -eq 0 ]; then
  skip "the engine names no governed project" \
       "no governed project other than the engine's own, so nothing to search for"
elif [ -z "$_leaked" ]; then
  ok "the engine names no governed project"
else
  bad "the engine names no governed project" \
      "names:$_leaked
$(for _gn in $_leaked; do grep -rniF -- "$_gn" "${runtime[@]}" | head -2; done)"
fi

# The engine's own name is exempt, and that exemption must not silently become
# a hole for everything: it is one name, and it is the one Felix governs itself
# under.
is "exactly one name is exempt, and it is the engine's own" \
   "$(_gov_names | grep -cx felix)" "0"

# The enumeration rule itself, against a fixture holding all three cases. This
# is what the two copies disagreed about, and nothing compared them: a real
# project, an empty stray, and a plain file dropped in projects/.
_ENUMP="$TMP/enumproj"; rm -rf "$_ENUMP"; mkdir -p "$_ENUMP/real" "$_ENUMP/stray"
printf '{ "name": "real" }\n' > "$_ENUMP/real/project.json"
printf 'not a project\n' > "$_ENUMP/README.md"
_enum_at() { local p meta n; for meta in "$1"/*/project.json; do
               [ -f "$meta" ] || continue; n="${meta%/project.json}"
               printf '%s\n' "${n##*/}"; done; }
is "a directory declaring project.json is enumerated" \
   "$(_enum_at "$_ENUMP" | tr '\n' ' ')" "real "
_enum_bare() { ls -1 "$1" 2>/dev/null | tr '\n' ' '; }
case "$(_enum_bare "$_ENUMP")" in
  *README.md*) ok "and the bare listing the gate used to do would have counted a plain file" ;;
  *)           bad "and the bare listing the gate used to do would have counted a plain file" \
                   "$(_enum_bare "$_ENUMP")" ;;
esac
rm -rf "$_ENUMP"

# The independence check is a command now — engine/harness/bin/independence-scan
# — so every property below is driven rather than read off the gate's source.
# The first draft of these grepped the gate's block for tokens; the tokens moved
# to the scanner, and an assertion about a mechanism should break when the
# mechanism does, not when it is relocated. Each fixture breaks the property it
# names and expects the scanner to say so.
_ISCAN="$FROOT/harness/bin/independence-scan"
_indep_repo() {   # name -> path of a fresh repo with the four engine dirs tracked
  local r="$TMP/indep-$1"; mkdir -p "$r/engine/harness/lib" "$r/engine/harness/hooks" \
    "$r/engine/harness/bin" "$r/projects"
  ( cd "$r" && git init -q -b main \
    && printf '#!/bin/sh\n' > engine/harness/felix && printf '# lib\n' > engine/harness/lib/a.sh \
    && printf '# hook\n' > engine/harness/hooks/h && printf '# bin\n' > engine/harness/bin/b \
    && git add -A && git -c user.name=t -c user.email=t@t commit -qm base ) >/dev/null 2>&1
  printf '%s' "$r"
}
_iscan() { ( cd "$1" && "$_ISCAN" 2>&1 ); }

# Refuses to answer on a path it cannot search. git grep exits 128 on an
# unresolvable pathspec and abandons the whole search, so one absent path
# silenced every name — reproduced against the real gate once: a name planted
# in lib/ read FAIL, and moving bin/ aside turned it into ok with the violation
# still there. Both halves: the path must exist, and something tracked must be
# under it, because a directory of only untracked files lets git grep read
# nothing and return 0.
_IR="$(_indep_repo blind)"
printf '{"name":"blindproj"}\n' > "$_IR/projects/blindproj/project.json" 2>/dev/null || { mkdir -p "$_IR/projects/blindproj"; printf '{"name":"blindproj"}\n' > "$_IR/projects/blindproj/project.json"; }
printf '# blindproj\n' >> "$_IR/engine/harness/lib/a.sh"
( cd "$_IR" && git add -A && git -c user.name=t -c user.email=t@t commit -qm plant ) >/dev/null 2>&1
has "a planted name is caught" "$(_iscan "$_IR")" "blindproj"
( cd "$_IR" && git rm -rq engine/harness/bin && git -c user.name=t -c user.email=t@t commit -qm nobin ) >/dev/null 2>&1
_o="$(_iscan "$_IR")"
has "the scanner refuses to answer on a path it cannot search" "$_o" "cannot search"
case "$_o" in
  *blindproj*) bad "and does not pretend it searched the rest" "$_o" ;;
  *)           ok  "and does not pretend it searched the rest" ;;
esac
mkdir -p "$_IR/engine/harness/bin"; printf '# untracked only\n' > "$_IR/engine/harness/bin/stray"
has "a directory holding only untracked files is blind too" "$(_iscan "$_IR")" "cannot search"

# Enumerates declared projects, not directory entries. A project is a directory
# that declares itself with project.json; an empty stray and a plain file
# dropped in projects/ contribute nothing.
_IR="$(_indep_repo enum)"
mkdir -p "$_IR/projects/real" "$_IR/projects/stray"
printf '{"name":"real"}\n' > "$_IR/projects/real/project.json"
printf 'not a project\n' > "$_IR/projects/README.md"
printf '# a stray word and a README word\n' >> "$_IR/engine/harness/lib/a.sh"
( cd "$_IR" && git add -A && git -c user.name=t -c user.email=t@t commit -qm enum ) >/dev/null 2>&1
( cd "$_IR" && "$_ISCAN" >/dev/null 2>&1 ) && ok "it enumerates declared projects, not directory entries" \
  || bad "it enumerates declared projects, not directory entries" "$(_iscan "$_IR")"
printf '# real\n' >> "$_IR/engine/harness/lib/a.sh"
( cd "$_IR" && git add -A && git -c user.name=t -c user.email=t@t commit -qm real ) >/dev/null 2>&1
has "while a declared one is caught" "$(_iscan "$_IR")" "real"

# Matches a project name as a literal. -F, not -E: the name is interpolated
# straight into the search, so a project called `vel.ra` searched for a pattern
# and matched `velXra`, which names nothing.
_IR="$(_indep_repo literal)"
mkdir -p "$_IR/projects/vel.ra"; printf '{"name":"vel.ra"}\n' > "$_IR/projects/vel.ra/project.json"
printf '# velXra is not that project\n' >> "$_IR/engine/harness/lib/a.sh"
( cd "$_IR" && git add -A && git -c user.name=t -c user.email=t@t commit -qm lit ) >/dev/null 2>&1
( cd "$_IR" && "$_ISCAN" >/dev/null 2>&1 ) && ok "it matches a project name as a literal" \
  || bad "it matches a project name as a literal" "$(_iscan "$_IR")"
printf '# vel.ra itself\n' >> "$_IR/engine/harness/lib/a.sh"
( cd "$_IR" && git add -A && git -c user.name=t -c user.email=t@t commit -qm dot ) >/dev/null 2>&1
has "and the literal name is caught" "$(_iscan "$_IR")" "vel.ra"

# All four engine directories are searched. Planted in each in turn, because
# a path list is the kind of constant that gets shortened by accident and a
# source grep for it would pass on a list that a later edit reordered.
for _d in felix lib/a.sh hooks/h bin/b; do
  _IR="$(_indep_repo "paths-${_d%%/*}")"
  mkdir -p "$_IR/projects/pathproj"; printf '{"name":"pathproj"}\n' > "$_IR/projects/pathproj/project.json"
  printf '# pathproj\n' >> "$_IR/engine/harness/$_d"
  ( cd "$_IR" && git add -A && git -c user.name=t -c user.email=t@t commit -qm p ) >/dev/null 2>&1
  has "a name planted in engine/harness/${_d%%/*} is caught" "$(_iscan "$_IR")" "pathproj"
done

# And the scanner's own source names no project. bin/ is searched, and that
# includes this file, so this is the real tree judging the real scanner —
# the property, not a grep for a name the comment might have used.
( cd "$REAL_HARNESS/../.." && ./engine/harness/bin/independence-scan >/dev/null 2>&1 ) \
  && ok "the scanner's own code names no project" \
  || bad "the scanner's own code names no project" "$(cd "$REAL_HARNESS/../.." && ./engine/harness/bin/independence-scan 2>&1 | head -3)"


printf '\necosystem\n'
# Invariant 1, one level up from the name.
#
# The independence block above proves the engine names no governed PROJECT. It
# cannot see the other half of the same invariant. A detector in engine/harness
# hard-coded to FastAPI route decorators and an Anthropic client construction
# site contains no project name, passes that check, and encodes exactly one
# project's shape into an engine whose whole claim is that it holds none. That
# is not hypothetical: it is a design that was drafted for Felix and would have
# shipped.
#
# So the words are enumerated the way the names are - off reality, never off a
# literal. Reality here is lib/detect.sh: the alternation tokens inside its own
# _felix_dep_grep calls ARE the set of ecosystems the engine reasons about, so
# teaching the probe a new framework arms this check for it in the same commit.
#
# What reality cannot supply is a stance. Some ecosystems the engine reaches
# through a manifest FILENAME rather than a probe token - `pyproject.toml` never
# spells `python` - and some probe tokens are ordinary English (`next`) and can
# never be enforced. Those are `word` and `mute` rows, each carrying a written
# reason, in the style of deny.tsv and risk.tsv. Felix holds stances; it does
# not author the enumeration.
#
# Matching is word-boundaried, and that is a measured choice rather than a
# neat one. Substring matching flags `cohere` inside "coherent", `vite` inside
# "invite" and `express` inside "expressed" - three false positives in the
# engine's own prose today. Word boundaries leave `ANTHROPIC_API_KEY` alone,
# which is correct twice over: bin/secret-scan and lib/unattended.sh both name
# it as a credential, which is what they are for.
_ECOT="$FROOT/harness/ecosystem.tsv"
_ECOD="$FROOT/harness/lib/detect.sh"
_ecorun=("$FROOT/harness/felix" "$FROOT/harness/lib" "$FROOT/harness/hooks" "$FROOT/harness/bin")

# Every alternation token inside a _felix_dep_grep pattern. Continuation lines
# are joined first: the llm probe's pattern sits on its own line, and reading
# line-by-line silently drops the whole model-SDK vocabulary - anthropic
# included, which is half the case this block exists for.
_eco_probe_words() {
  sed -e :a -e '/\\$/N; s/\\\n//; ta' "$_ECOD" 2>/dev/null \
    | grep -oE '_felix_dep_grep "\$root" +"[^"]*(\\"[^"]*)*"' \
    | sed -E 's/.*_felix_dep_grep "\$root" +"//; s/"$//' \
    | sed 's/\\"?//g; s/\\"//g' | tr '|' '\n' \
    | sed 's/^ *//; s/ *$//' | grep -v '^$' | LC_ALL=C sort -u
}

# kind <TAB> file <TAB> token <TAB> reason. `file` is relative to harness/, and
# `-` where the row is not about one file.
_eco_rows() {
  local want="$1" kind file token reason
  [ -f "$_ECOT" ] || return 0
  while IFS=$'\t' read -r kind file token reason; do
    case "$kind" in ''|'#'*) continue ;; esac
    [ "$kind" = "$want" ] || continue
    [ -n "${token:-}" ] || continue
    printf '%s\t%s\t%s\n' "$file" "$token" "${reason:-}"
  done < "$_ECOT"
}

# probe + word - mute.
_eco_words() {
  { _eco_probe_words
    _eco_rows word | cut -f2 | tr '|' '\n'
  } | sed 's/^ *//; s/ *$//' | grep -v '^$' | LC_ALL=C sort -u \
    | grep -vxF -f <(_eco_rows mute | cut -f2 | tr '|' '\n' | grep -v '^$') 2>/dev/null \
    || true
}

# Does a row permit this file to say this word? `*` means every word.
_eco_allowed() {
  local f="$1" w="$2" rf rt rr
  while IFS=$'\t' read -r rf rt rr; do
    [ "$rf" = "$f" ] || continue
    [ "$rt" = '*' ] && return 0
    case "|$rt|" in *"|$w|"*) return 0 ;; esac
  done <<EOF
$(_eco_rows allow)
EOF
  return 1
}

# Every (file, word) pair in a tree that no row permits.
_eco_leaks() {
  local w f rel
  while IFS= read -r w; do
    [ -n "$w" ] || continue
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      rel="${f#"$FROOT"/harness/}"
      _eco_allowed "$rel" "$w" || printf '%s names %s\n' "$rel" "$w"
    done <<EOF
$(grep -rlwiE -- "$w" "${_ecorun[@]}" 2>/dev/null)
EOF
  done <<EOF
$(_eco_words)
EOF
}

# Armed before it is trusted, and this is the arming that matters most: the
# words come out of another file by pattern, so a refactor of detect.sh that
# this extractor no longer recognises empties the vocabulary, and a negative
# assertion over an empty set is the shape that passes by finding nothing.
_ecopn="$(_eco_probe_words | wc -l | tr -d ' ')"
[ "${_ecopn:-0}" -gt 0 ] \
  && ok "the capability probe yields ecosystem words to check for" \
  || bad "the capability probe yields ecosystem words to check for" \
         "_eco_probe_words returned nothing from $_ECOD"

# And that they are really read off the probe rather than carried here. Two
# tokens from two different probes, one of them on the continued line.
_ecop="$(_eco_probe_words | tr '\n' ' ')"
case "$_ecop" in
  *fastapi*) ok "the words are read off lib/detect.sh, not carried as a literal" ;;
  *) bad "the words are read off lib/detect.sh, not carried as a literal" "got: $_ecop" ;;
esac
case "$_ecop" in
  *anthropic*) ok "including the model-SDK probe, which sits on a continued line" ;;
  *) bad "including the model-SDK probe, which sits on a continued line" "got: $_ecop" ;;
esac
# And that every token is a word, not a regex fragment. The extractor's sed
# used `\?`, which BSD sed reads as a literal `?` and GNU sed as a quantifier —
# so on the Linux runner the probe pattern `\"?stripe\"?` came out as `?stripe?`,
# which `grep -wE` reads as "strip, optionally followed by e", and two files
# were reported for naming the English word "strip". Locally it never
# reproduced, because this machine's sed is BSD. A vocabulary check whose
# vocabulary is a regex fragment is wrong in both directions at once.
_ecobad="$(_eco_probe_words | grep -E '^[^a-z0-9]|[^a-z0-9]$|["\\]' || true)"
[ -z "$_ecobad" ] \
  && ok "every vocabulary token is a word, not a regex fragment" \
  || bad "every vocabulary token is a word, not a regex fragment" "tokens: $(printf '%s' "$_ecobad" | tr '\n' ' ')"

# The property itself.
_ecoleak="$(_eco_leaks)"
[ -z "$_ecoleak" ] \
  && ok "the engine names no ecosystem without a declared reason" \
  || bad "the engine names no ecosystem without a declared reason" \
         "$(printf '%s\n' "$_ecoleak" | head -8)"

# Armed on the other side too. The two row-quality assertions below are negative
# over a set read out of a file, so a missing or unparseable ecosystem.tsv makes
# both of them pass having judged nothing. The leak assertion above would go red
# in that case and this would still be the wrong reason to be green.
_ecorn="$(_eco_rows allow | wc -l | tr -d ' ')"
[ "${_ecorn:-0}" -gt 0 ] \
  && ok "there are declared ecosystem rows to judge" \
  || bad "there are declared ecosystem rows to judge" "no allow rows parsed from $_ECOT"

# Every row carries a reason. A table of bare exemptions is a list of things
# nobody had to justify, which is how an allowlist becomes the hole.
_ecomute=0
while IFS=$'\t' read -r rf rt rr; do
  [ -n "${rt:-}" ] || continue
  [ -n "${rr:-}" ] || _ecomute=$((_ecomute+1))
done <<EOF
$(_eco_rows allow; _eco_rows word; _eco_rows mute)
EOF
is "every ecosystem row carries a written reason" "$_ecomute" "0"

# A row that no longer matches anything is a claim about a surface that is
# gone - the orphan-stance class of gap, which #125's own review found by
# looking for it. Reported, not fatal: a file may legitimately stop naming
# something before anybody prunes the row.
_ecoorphan=""
while IFS=$'\t' read -r rf rt rr; do
  [ -n "${rt:-}" ] || continue
  [ "$rt" = '*' ] && continue
  [ -f "$FROOT/harness/$rf" ] || [ -d "$FROOT/harness/$rf" ] || { _ecoorphan="$_ecoorphan $rf"; continue; }
  grep -rlwiE -- "$rt" "$FROOT/harness/$rf" >/dev/null 2>&1 || _ecoorphan="$_ecoorphan $rf:$rt"
done <<EOF
$(_eco_rows allow)
EOF
is "no allow row claims a surface that no longer names it" "$_ecoorphan" ""

# The rule, against a fixture holding the exact design that would have shipped.
# This is the assertion the independence block could not carry: the same file
# names no project at all, so the check above it passes on it.
_ECOF="$TMP/ecofixture"; rm -rf "$_ECOF"; mkdir -p "$_ECOF"
cat > "$_ECOF/planted.sh" <<'PLANT'
_felix_planted_routes() { grep -rnE 'from fastapi import|@(app|router)\.(get|post)\(' "$1"; }
_felix_planted_llm()    { grep -rnE 'anthropic\.Anthropic\(' "$1"; }
_felix_planted_gate()   { printf 'python -m pytest -q\n'; }
PLANT
_eco_fixture_hits() {
  local w n=0
  while IFS= read -r w; do
    [ -n "$w" ] || continue
    grep -qlwiE -- "$w" "$_ECOF/planted.sh" 2>/dev/null && n=$((n+1))
  done <<EOF
$(_eco_words)
EOF
  printf '%s\n' "$n"
}
[ "$(_eco_fixture_hits)" -ge 2 ] \
  && ok "a detector hard-coded to one stack is caught" \
  || bad "a detector hard-coded to one stack is caught" \
         "matched $(_eco_fixture_hits) ecosystem words in the planted detector"
# And why it needed catching here: the name check cannot see it.
_ecogov=0
while IFS= read -r _gn; do
  [ -n "$_gn" ] || continue
  grep -qniF -- "$_gn" "$_ECOF/planted.sh" 2>/dev/null && _ecogov=$((_ecogov+1))
done <<EOF
$(_gov_names)
EOF
is "and the independence check above it sees nothing wrong with that file" "$_ecogov" "0"
rm -rf "$_ECOF"

# A word that cannot be enforced is muted on the record rather than quietly
# left out of the vocabulary. `next` is a probe token AND the name of a Felix
# command, so enforcing it would flag twenty engine files on the first run.
case "$(_eco_words | tr '\n' ' ')" in
  *" next "*) bad "an unenforceable probe word is muted on the record" "next is still in the vocabulary" ;;
  *)          ok  "an unenforceable probe word is muted on the record" ;;
esac
is "and the mute is a row, not a silent omission" \
   "$(_eco_rows mute | cut -f2 | tr '|' '\n' | grep -cx next)" "1"

# The whole mute set, not just that `next` is in it. This is the one edit that
# narrows invariant 1 while the table GROWS, so the escape channel cannot see
# it: ecosystem.tsv is an enforcing table and shrinking it fires `verifier`, but
# adding `mute - fastapi` removes fastapi from the vocabulary by addition. A
# mute is meant to be rare and argued, so the set is pinned and a new one has to
# come here and say which word the engine cannot help using and why.
is "and nothing else is muted, because muting is how this narrows quietly" \
   "$(_eco_rows mute | cut -f2 | tr '|' '\n' | grep -v '^$' | LC_ALL=C sort -u | tr '\n' ' ')" \
   "next "

# The gate keeps its own copy, for the same reason it keeps one of every other
# check: a verifier that sources the code it judges can be switched off by
# editing that code. Asserted in step by naming the mechanism, not a marker.
_REALG="$(cd "$REAL_HARNESS/../.." && pwd)/projects/felix/gate.sh"
if [ -f "$_REALG" ]; then
  _gate_eco="$(sed -n '/^# -.*ecosystem/,/^# -.*memory/p' "$_REALG" | grep -vE '^[[:space:]]*#')"
  case "$_gate_eco" in
    *ecosystem.tsv*) ok "the gate carries the ecosystem check too" ;;
    *) bad "the gate carries the ecosystem check too" "no ecosystem block in the shipped gate" ;;
  esac
  case "$_gate_eco" in
    *detect.sh*) ok "and reads its words off the capability probe" ;;
    *) bad "and reads its words off the capability probe" "no detect.sh in the ecosystem block" ;;
  esac
  case "$_gate_eco" in
    *ECO_BLIND*) ok "and refuses to answer when the probe yields no words" ;;
    *) bad "and refuses to answer when the probe yields no words" "no blindness guard in the ecosystem block" ;;
  esac
  case "$_gate_eco" in
    *'git grep -lwniE'*) ok "and matches an ecosystem word on a word boundary" ;;
    *) bad "and matches an ecosystem word on a word boundary" "not a word-boundaried search" ;;
  esac
else
  skip "the gate carries the ecosystem check too" "no shipped gate"
  skip "and reads its words off the capability probe" "no shipped gate"
  skip "and refuses to answer when the probe yields no words" "no shipped gate"
  skip "and matches an ecosystem word on a word boundary" "no shipped gate"
fi

# It decides what stops, so shrinking it is an escape channel. Removing one
# `word` row silently narrows the invariant, which is the same shape as
# narrowing risk.tsv and belongs in the same list.
case " $(grep -E "^FELIX_ESCAPE_TABLES=" "$FROOT/harness/lib/escape.sh" | sed "s/.*='//; s/'.*//") " in
  *" ecosystem.tsv "*) ok "the ecosystem table is an enforcing table, and escape.sh says so" ;;
  *) bad "the ecosystem table is an enforcing table, and escape.sh says so" \
         "ecosystem.tsv is not in FELIX_ESCAPE_TABLES" ;;
esac
printf '\ncommissioning: one moment, one table, one policy\n'
# The first-encounter moment (v3.2 §8) as a table. Every stage existed as a
# command a person typed in order and felix new printed the order; now a row
# names a need, an instrument, an engine stage that answers it and a check
# that decides, and `unknown` is reachable by construction.
CMP="$FROOT/projects/cmproj"; CMR="$TMP/cm-repo"
mkdir -p "$CMP" "$CMR/src" "$MEM/cmproj"
( cd "$CMR" && git init -q -b main && printf 'x\n' > src/a.txt && printf 'KEY=\n' > .env.example
  git add -A && git -c user.name=t -c user.email=t@t commit -qm init
  printf 'y\n' > src/b.txt && git add -A && git -c user.name=t -c user.email=t@t commit -qm two ) >/dev/null 2>&1
CMR="$(cd "$CMR" && pwd -P)"
printf 'cmproj\n' > "$CMR/.felix"
printf '{"name":"cmproj","gate":"true"}\n' > "$CMP/project.json"
: > "$CMP/capabilities"
printf '# k\tn\ts\tr\tc\n' > "$CMP/stack.tsv"
cp "$FROOT/harness/templates/profiles.tsv" "$FROOT/harness/templates/routes.tsv" "$CMP/"
_cmtable() { { printf '# need\tgrounds\tinstrument\twhen\tanswer\tcheck\tstep\n'
               for r in "$@"; do printf '%s\n' "$r"; done; } > "$CMP/commissioning.tsv"; }
_cm() { ( FELIX_HOME_DIR="$FROOT"; PATH="$CMSTUB:$PATH"
          . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/detect.sh"; . "$FROOT/harness/lib/stack.sh"
          . "$FROOT/harness/lib/probes.sh"; . "$FROOT/harness/lib/verify.sh"; . "$FROOT/harness/lib/toolbox.sh"
          . "$FROOT/harness/lib/discover.sh"; . "$FROOT/harness/lib/ready.sh"; . "$FROOT/harness/lib/commission.sh"
          . "$FROOT/harness/lib/commission-provider.sh"
          "$@" ); }
_cmstate() { _cm felix_commission_run "$CMP" "$CMR" - | awk -F'\t' -v n="$1" '$1 == n { print $2 }'; }
_cmdetail() { _cm felix_commission_run "$CMP" "$CMR" - | awk -F'\t' -v n="$1" '$1 == n { print $6 }'; }

_cmtable 'alpha	-	-	-	-	test -f src/a.txt	3' \
         'plain	-	-	-	-	printf x | grep -q x	9' \
         'beta	-	-	-	felix:toolbox --route	test -f src/made-by-answer	5' \
         'gamma	-	definitely-not-a-real-command-xyz	-	-	true	5' \
         'delta	-	-	definitely-not-a-real-command-xyz	-	true	5' \
         'eps	billing	-	-	-	true	6' \
         'zeta	-	-	-	-	[ -z "$(felix_no_such_function)" ]	7' \
         'eta	-	-	-	-	! true	9' \
         'theta	-	-	-	felix:rm -rf	true	9' \
         'iota	-	-	-	-	true	99' \
         'kappa	-	-	-	-	true' \
         'prov	-	-	-	provider:claude-code-setup:claude-automation-recommender	-	4'
is  "seven-field rows with an engine-stage answer and a check that can fail are rows" \
    "$(_cm felix_commission_rows "$CMP" | cut -f1 | tr '\n' ' ')" "alpha plain beta gamma delta eps zeta prov "
_cmmal="$(_cm felix_commission_malformed "$CMP")"
has "a negated check is malformed, because it could not fail"      "$_cmmal" "eta"
has "an answer outside the engine's stages is malformed"           "$_cmmal" 'felix:rm -rf'
has "a step outside 1-10 is malformed"                             "$_cmmal" "iota"
has "six fields is malformed, never truncated"                     "$_cmmal" "kappa"

is  "a check that passes is done"                                        "$(_cmstate alpha)" "done"
is  "a check naming no engine function is not read as one missing"       "$(_cmstate plain)" "done"
is  "a check that fails is held"                                         "$(_cmstate beta)"  "held"
is  "an instrument this machine lacks makes the row unknown"             "$(_cmstate gamma)" "unknown"
has "and says it could not be asked here"                                "$(_cmdetail gamma)" "could not be asked on this machine"
is  "a when whose command does not exist is unknown, not not-applicable" "$(_cmstate delta)" "unknown"
is  "an inactive capability makes the row not-applicable"                "$(_cmstate eps)"   "not-applicable"
is  "an engine function the check names that is not loaded is unknown"   "$(_cmstate zeta)"  "unknown"
has "and the missing function is named"                                  "$(_cmdetail zeta)" "felix_no_such_function"
is  "a provider row is awaiting, a class of its own"                     "$(_cmstate prov)"  "awaiting"

# A row's text means what it means in a probe.
#
# felix_commission_ask evaluates a row in-process, so the row inherited the
# CLI's `set -uo pipefail`, which no other table runner has. A check shaped
# `producer | grep -q x` whose grep matched and left while the producer still
# had output to write read as failed, because the producer died of SIGPIPE: a
# check read held for a step that was done, and a `when` read not-applicable
# and skipped its step. The producer here writes about 1.3 MB with the match on
# its first line, far past what one pipe holds, so grep leaving early is
# certain and not a matter of load. The engine functions a row names run
# without pipefail too, as they already do under bin/probes-check.
# Everything this touches is restored below and everything it defines unset.
cp "$CMP/commissioning.tsv" "$TMP/cmpf-table.keep"
_cmpfml="$MEM/cmproj/mistakes.log"
rm -f "$TMP/cmpf-mistakes.keep"; [ -f "$_cmpfml" ] && cp "$_cmpfml" "$TMP/cmpf-mistakes.keep"
_cmpfp="awk 'BEGIN { print \"cmpfhit\"; for (i = 0; i < 20000; i++) print \"filler that pushes the producer far past what one pipe can hold\" }'"
_cmpfrow() { printf '%s\t-\t-\t%s\t-\t%s\t9' "$1" "$2" "$3"; }   # need, when, check
_cmpfst()  { printf '%s\n' "$1" | awk -F'\t' -v n="$2" '$1 == n { print $2 }'; }
felix_cmpf_on()    { [ -o pipefail ]; }
felix_cmpf_off()   { ! [ -o pipefail ]; }
felix_cmpf_state() { if [ -o pipefail ]; then printf 'on\n'; else printf 'off\n'; fi; }
felix_cmpf_true()  { return 0; }
# An engine function that sources a library, as cmd_bootstrap's kind do: the
# library redefines the function running it, redefines a function the row also
# names, and defines one nothing named before.
felix_cmpf_src()         { . "$TMP/cmpf-lib.sh" && felix_cmpf_src_fresh; }
felix_cmpf_src_defined() { return 1; }
cat > "$TMP/cmpf-lib.sh" <<'CMPFLIB'
felix_cmpf_src() { . "$TMP/cmpf-lib.sh" && felix_cmpf_src_fresh; }
felix_cmpf_src_defined() { return 0; }
felix_cmpf_src_fresh() { return 0; }
CMPFLIB
# A mistakes.log far past 64 KB whose first row's label is neither commission
# nor probes, which is the state the seeded gate_shown_failing check calls done.
awk 'BEGIN { printf "2026-09-25\tmain\tabc1234\tgate\n"
             for (i = 0; i < 20000; i++)
               printf "2026-09-25\tmain\tabc1234\tcheck%d filler words that are neither commission nor probes\n", i }' > "$_cmpfml"
_cmpfgsf="$(awk -F'\t' '$1 == "gate_shown_failing"' "$FROOT/harness/templates/commissioning.tsv")"
_cmtable "$(_cmpfrow cmpf_yes       - "$_cmpfp | grep -q cmpfhit")" \
         "$(_cmpfrow cmpf_when_yes  "$_cmpfp | grep -q cmpfhit" true)" \
         "$(_cmpfrow cmpf_no        - "$_cmpfp | grep -q cmpfnope")" \
         "$(_cmpfrow cmpf_when_no   "$_cmpfp | grep -q cmpfnope" true)" \
         "$(_cmpfrow cmpf_early     - "sh -c 'echo hit; exit 3' | grep -q hit")" \
         "$_cmpfgsf" \
         "$(_cmpfrow cmpf_whole     - 'felix_cmpf_off')" \
         "$(_cmpfrow cmpf_subst     - '[ "$(felix_cmpf_state)" = off ]')" \
         "$(_cmpfrow cmpf_when_fn   'felix_cmpf_off' true)" \
         "$(_cmpfrow cmpf_fails     - 'felix_cmpf_on')" \
         "$(_cmpfrow cmpf_src       - 'felix_cmpf_src && felix_cmpf_src_defined')" \
         "$(_cmpfrow cmpf_cmdv      - '[ "$(command -v felix_cmpf_on)" = felix_cmpf_on ]')" \
         "$(_cmpfrow cmpf_type      - '[ "$(type -t felix_cmpf_on)" = function ]')" \
         "$(_cmpfrow cmpf_quoted    - "_s='felix_cmpf_on'; [ \"\${#_s}\" -eq 13 ]")" \
         "$(_cmpfrow cmpf_redef     'felix_cmpf_true() { return 0; }; felix_cmpf_true' true)" \
         "$(_cmpfrow cmpf_unset     - 'test -z "$cmpf_never_set_anywhere"')"
# The suite runs under pipefail, so _cm is a caller that has it.
_cmpfon="$(_cm felix_commission_run "$CMP" "$CMR" -)"

is  "a check whose producer outruns grep -q, the match on its first line, is done" \
    "$(_cmpfst "$_cmpfon" cmpf_yes)" "done"
is  "a when of that shape makes its row applicable, and the check decides it" \
    "$(_cmpfst "$_cmpfon" cmpf_when_yes)" "done"
has "the seeded gate_shown_failing row is read from the template, not retyped" \
    "$_cmpfgsf" "gate_shown_failing	"
is  "the seeded gate_shown_failing check is done over a mistakes.log far past 64 KB" \
    "$(_cmpfst "$_cmpfon" gate_shown_failing)" "done"
is  "a check whose producer never shows the match is still held" \
    "$(_cmpfst "$_cmpfon" cmpf_no)" "held"
is  "and a when of that shape still makes its row not-applicable" \
    "$(_cmpfst "$_cmpfon" cmpf_when_no)" "not-applicable"
is  "a pipeline whose first stage fails and whose last succeeds is done, as in a probe" \
    "$(_cmpfst "$_cmpfon" cmpf_early)" "done"

is  "an engine function that is the whole check runs without pipefail, as the row does" \
    "$(_cmpfst "$_cmpfon" cmpf_whole)" "done"
is  "and so does one inside a command substitution"           "$(_cmpfst "$_cmpfon" cmpf_subst)"   "done"
is  "and one named in a when"                                 "$(_cmpfst "$_cmpfon" cmpf_when_fn)" "done"
is  "and an engine function that fails there reads held"      "$(_cmpfst "$_cmpfon" cmpf_fails)"   "held"
is  "an engine function that sources a library redefining what the check names runs the new definitions" \
    "$(_cmpfst "$_cmpfon" cmpf_src)" "done"

is  "an engine function's name passed to command -v comes back as written" \
    "$(_cmpfst "$_cmpfon" cmpf_cmdv)" "done"
is  "and type -t calls that name a function"                  "$(_cmpfst "$_cmpfon" cmpf_type)"   "done"
is  "and inside a quoted string that name is the string as written" \
    "$(_cmpfst "$_cmpfon" cmpf_quoted)" "done"
is  "a when may define a function under an engine function's name and call it" \
    "$(_cmpfst "$_cmpfon" cmpf_redef)" "done"
is  "a check naming an unset variable is still held, because nounset stays" \
    "$(_cmpfst "$_cmpfon" cmpf_unset)" "held"

# An ask changes nothing about the shell that asked.
_cmpfkept() { local before; before="$(set +o)"
              felix_commission_ask "$CMR" "$_cmpfp | grep -q cmpfhit"
              felix_commission_ask "$CMR" 'felix_cmpf_on && false | true'
              felix_commission_run "$CMP" "$CMR" - >/dev/null
              if [ "$(set +o)" = "$before" ]; then printf 'kept'; else printf 'moved'; fi
              if [ -o pipefail ]; then printf ' on\n'; else printf ' off\n'; fi; }
_cmpfnopfkept() { set +o pipefail; _cmpfkept; }
is  "an ask and a run leave a caller that had pipefail every option it had" "$(_cm _cmpfkept)"     "kept on"
is  "and leave a caller without pipefail every option it had"              "$(_cm _cmpfnopfkept)" "kept off"

# And through the real command, whose own shell is `set -uo pipefail`.
_cmtable "$(_cmpfrow cmpf_yes - "$_cmpfp | grep -q cmpfhit")" "$_cmpfgsf"
_cmpfcli="$( cd "$CMR" && PATH="$CMSTUB:$PATH" "$FELIX" commission --status 2>&1 )"
is  "felix commission --status reads the row whose producer outruns grep -q done" \
    "$(printf '%s\n' "$_cmpfcli" | awk '$2 == "cmpf_yes" { print $1 }')" "done"
is  "and reads the seeded gate_shown_failing row done over that mistakes.log" \
    "$(printf '%s\n' "$_cmpfcli" | awk '$2 == "gate_shown_failing" { print $1 }')" "done"

cp "$TMP/cmpf-table.keep" "$CMP/commissioning.tsv"
if [ -f "$TMP/cmpf-mistakes.keep" ]; then mv "$TMP/cmpf-mistakes.keep" "$_cmpfml"; else rm -f "$_cmpfml"; fi
rm -f "$TMP/cmpf-table.keep" "$TMP/cmpf-lib.sh"
unset -f _cmpfrow _cmpfst _cmpfkept _cmpfnopfkept felix_cmpf_on felix_cmpf_off felix_cmpf_state \
         felix_cmpf_true felix_cmpf_src felix_cmpf_src_defined
unset _cmpfml _cmpfp _cmpfgsf _cmpfon _cmpfcli

# A `when` that answers neither yes nor no is unknown, as in a probe.
#
# felix_commission_state read every status of a `when` other than 0, 126 and
# 127 as the grounded state saying no, and skipped the row's step, so a `when`
# that crashed failed open. Probes and obligations already read anything that
# is neither 0 nor 1 as unknown. The status alone could not carry it either:
# the row runs in-process and inherits the CLI's `set -u`, so a `when` naming
# an unset variable ended the shell running it with 1, which is what a real no
# returns, and felix_commission_ask folded every status but 0, 126 and 127 to 1
# before the state saw it. So the ask keeps the status and, asked, says whether
# the text returned it, ended the shell with it, or was never run because the
# checkout could not be entered; a `when` that does not parse is unknown and
# never run; a `when` that ended the shell with 0 still applies. The check
# column is pinned unchanged, because anything but 0, 126 and 127 there is
# held, and held fails closed. Everything this touches is restored below and
# everything it defines unset.
cp "$CMP/commissioning.tsv" "$TMP/cmwc-table.keep"
_cmwcrow() { printf '%s\t-\t-\t%s\t-\t%s\t9' "$1" "$2" "$3"; }   # need, when, check
_cmwcst()  { printf '%s\n' "$1" | awk -F'\t' -v n="$2" '$1 == n { print $2 }'; }
_cmwcdt()  { printf '%s\n' "$1" | awk -F'\t' -v n="$2" '$1 == n { print $6 }'; }
# An engine function that ends the shell running it, as the engine's die does.
felix_cmwc_die() { exit 5; }
# The status this bash ends a shell with on an unset variable under set -u,
# measured the way the engine meets it rather than assumed: 1 on bash 3.2.
_cmwcu="$( ( eval '[ -n "$cmwc_never_set_anywhere" ]' ) 2>/dev/null; printf '%s' "$?" )"
# A text that writes what an honest run is read by into its descriptors 1 to
# 9, then ends the shell. Amended after review: the first line was a bare
# `returned`, which no reading accepts, so a run whose own stdout reached the
# answer went unseen. fd 10 stays out: that is bash's saved copy of the
# answer's pipe, and a text writing there can forge it, which nothing that runs
# in its process can prevent.
_cmwcfake="for _cmwcd in 1 2 3 4 5 6 7 8 9; do printf 'returned 0\nreturned 1\n' >&\"\$_cmwcd\"; done; exit 1"
_cmtable "$(_cmwcrow cmwc_unset     '[ -n "$cmwc_never_set_anywhere" ]' true)" \
         "$(_cmwcrow cmwc_colon     ': "${cmwc_never_set_anywhere:?}"' true)" \
         "$(_cmwcrow cmwc_infn      '_cmwc_inner() { [ -n "$cmwc_never_set_anywhere" ]; }; _cmwc_inner' true)" \
         "$(_cmwcrow cmwc_die       'felix_cmwc_die' true)" \
         "$(_cmwcrow cmwc_exit1     'exit 1' true)" \
         "$(_cmwcrow cmwc_exit3     'exit 3' true)" \
         "$(_cmwcrow cmwc_exit127   'exit 127' true)" \
         "$(_cmwcrow cmwc_exec      'exec false' true)" \
         "$(_cmwcrow cmwc_exit0     'exit 0' true)" \
         "$(_cmwcrow cmwc_exit0_no  'exit 0' 'test -f cmwc-no-such-file')" \
         "$(_cmwcrow cmwc_two       'grep -q x cmwc-no-such-file' true)" \
         "$(_cmwcrow cmwc_three     "sh -c 'exit 3'" true)" \
         "$(_cmwcrow cmwc_r126      "sh -c 'exit 126'" true)" \
         "$(_cmwcrow cmwc_r130      "sh -c 'exit 130'" true)" \
         "$(_cmwcrow cmwc_no        'test -f cmwc-no-such-file' true)" \
         "$(_cmwcrow cmwc_no_grep   'grep -q cmwcnope src/a.txt' true)" \
         "$(_cmwcrow cmwc_yes       'test -f src/a.txt' true)" \
         "$(_cmwcrow cmwc_yes_no    'test -f src/a.txt' 'test -f cmwc-no-such-file')" \
         "$(_cmwcrow cmwc_missing   'cmwc-no-such-command-xyz' true)" \
         "$(_cmwcrow cmwc_parse     'touch cmwc-parse-ran; if then' true)" \
         "$(_cmwcrow cmwc_parse2    'case x in' true)" \
         "$(_cmwcrow cmwc_fake      "$_cmwcfake" true)" \
         "cmwc_grounds	billing	-	sh -c 'exit 3'	-	true	9" \
         "cmwc_instr	-	cmwc-no-such-instrument-xyz	sh -c 'exit 3'	-	true	9" \
         "$(_cmwcrow cmwc_efn       'test -f cmwc-no-such-file' '[ -z "$(felix_cmwc_no_such_function)" ]')" \
         "$(_cmwcrow cmwc_c_unset   - 'test -n "$cmwc_never_set_anywhere"')" \
         "$(_cmwcrow cmwc_c_two     - 'grep -q x cmwc-no-such-file')" \
         "$(_cmwcrow cmwc_c_exit3   - 'exit 3')" \
         "$(_cmwcrow cmwc_c_die     - 'felix_cmwc_die')" \
         "$(_cmwcrow cmwc_c_parse   - 'if then')" \
         "$(_cmwcrow cmwc_c_fake    - "$_cmwcfake")" \
         "$(_cmwcrow cmwc_c_missing - 'cmwc-no-such-command-xyz')"
rm -f "$CMR/cmwc-parse-ran"
_cmwcrun="$(_cm felix_commission_run "$CMP" "$CMR" -)"

is  "the when-status rows are read as rows, none of them malformed" \
    "$(_cm felix_commission_malformed "$CMP")" ""
is  "the shell this suite runs ends on an unset variable with a status that is not 0" \
    "$([ -n "$_cmwcu" ] && [ "$_cmwcu" != 0 ] && printf measured)" "measured"

is  "a when naming an unset variable is unknown, not not-applicable" "$(_cmwcst "$_cmwcrun" cmwc_unset)" "unknown"
has "and it says the when ended the shell, with the status it ended with" \
    "$(_cmwcdt "$_cmwcrun" cmwc_unset)" "the \`when\` test ended the shell with status $_cmwcu before it answered"
has "and it names an unset variable under set -u as a cause" "$(_cmwcdt "$_cmwcrun" cmwc_unset)" "set -u"
is  "a when whose \${x:?} fails is unknown"                           "$(_cmwcst "$_cmwcrun" cmwc_colon)" "unknown"
is  "a when whose own function reads an unset variable is unknown"    "$(_cmwcst "$_cmwcrun" cmwc_infn)"  "unknown"
is  "a when whose engine function ends the shell is unknown"          "$(_cmwcst "$_cmwcrun" cmwc_die)"   "unknown"
has "and it says the shell ended with that function's status" \
    "$(_cmwcdt "$_cmwcrun" cmwc_die)" "ended the shell with status 5"

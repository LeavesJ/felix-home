# ---- the fixture holds what the assertions below say ---------------------
_ivfx=""
[ -e "$IVZX/filter-ran" ] && _ivfx="$_ivfx the filter already ran;"
[ -e "$IVZC/wt-q/.git" ] && _ivfx="$_ivfx wt-q still has its .git;"
_ivq -C "$IVZ" worktree list --porcelain | grep -q "^worktree $IVZD\$" || _ivfx="$_ivfx the line break does not spell the decoy;"
[ "$(_ivq -C "$IVZ" config branch.topic/feat2.merge)" = refs/heads/main ] || _ivfx="$_ivfx feat2 does not track main;"
[ "$(_ivq -C "$IVZ" rev-parse origin/topic/feat2)" = "$IVZ_F2" ] || _ivfx="$_ivfx feat2 is not pushed;"
_ivq -C "$IVZ" merge-base --is-ancestor origin/topic/diverge topic/diverge && _ivfx="$_ivfx origin/topic/diverge is behind the local branch;"
_ivq -C "$IVZC/wt-m3" diff-index --cached --quiet "$IVZ_X1" || _ivfx="$_ivfx wt-m3's index is not X1;"
[ "$(_ivq -C "$IVZC/wt-m3" rev-parse HEAD)" = "$IVZ_X2" ] || _ivfx="$_ivfx wt-m3's HEAD is not X2;"
_ivq -C "$IVZC/wt-m3" symbolic-ref -q HEAD >/dev/null && _ivfx="$_ivfx wt-m3 is not detached;"
_ivq -C "$IVZ" worktree list --porcelain | grep -q '\.lost/' && _ivfx="$_ivfx git still lists .lost;"
_ivq -C "$IVZ" ls-files -- "$IVZC/k*" | grep -q kept || _ivfx="$_ivfx k* does not glob to kept;"
[ "$(_ivq -C "$IV/pc1" config remote.origin.promisor)" = true ] || _ivfx="$_ivfx pc1 is no partial clone;"
# Asked with lazy fetching off, since asking would otherwise fetch it.
( export GIT_NO_LAZY_FETCH=1; _ivq -C "$IV/pc1" cat-file -e "$(_ivq -C "$IV/pc1" rev-parse origin/main:docs/handoff/pending/20260924T000000Z-gizmo.md)" ) 2>/dev/null \
  && _ivfx="$_ivfx pc1 already holds the section;"
[ -z "$_ivfx" ] && ok  "the fixture: gizmo holds each finding's shape, and neither partial clone holds the handoff section" \
                || bad "the fixture: gizmo holds each finding's shape, and neither partial clone holds the handoff section" "$_ivfx"

# ---- the runs ------------------------------------------------------------
_ivzrun() {  # [--path P] [--tmp D] [--cwd D] felix-args...
  local p="$IVSTUB2:$IVSTUB:$PATH" t="$IV/tz" d="$IVZ"
  while :; do
    case "${1:-}" in
      --path) p="$2"; shift 2 ;;
      --tmp)  t="$2"; shift 2 ;;
      --cwd)  d="$2"; shift 2 ;;
      *) break ;;
    esac
  done
  ( cd "$d" || exit 97
    unset FELIX_HOME FELIX_MEMORY FELIX_KERNEL FELIX_KERNEL_CACHE FELIX_PLUGIN_CACHE CLAUDE_PLUGIN_ROOT \
          CLAUDE_CONFIG_DIR GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OPTIONAL_LOCKS GIT_CEILING_DIRECTORIES \
          XDG_STATE_HOME XDG_CACHE_HOME FELIX_INVENTORY_TEMP_ROOTS
    export HOME="$IVH" TMPDIR="$t" PATH="$p" XDG_CONFIG_HOME="$IVH/.config" GIT_CONFIG_NOSYSTEM=1 \
           GIT_ALLOW_PROTOCOL=file GIT_TERMINAL_PROMPT=0 GIT_CEILING_DIRECTORIES="$IV"
    "$IVF" "$@" ) 2>>"$IV_ERR"
}
_ivz_snap() {
  local d
  for d in "$IVW3" "$IVZO" "$IVZD"; do
    ( cd "$d" && find . -print | LC_ALL=C sort && find . -type f -exec "$_iv_sum" {} + | LC_ALL=C sort ) 2>&1
  done
}
_ivz_before="$(_ivz_snap)"
_ivz_pack() { ( cd "$1/.git/objects" && find . -print | LC_ALL=C sort ); }
_ivz_pc1="$(_ivz_pack "$IV/pc1")"
: > "$IVGIT_LOG"; : > "$IV/gh-slow.log"
IVZ_T1="$IV/z1.tsv"; _ivzrun inventory --tsv --repo "$IVZ" > "$IVZ_T1"
IVZ_H2="$IV/z2.txt"; _ivzrun inventory --no-gh --repo "$IVZ" > "$IVZ_H2"
IVZ_T2NG="$IV/z2ng.tsv"; _ivzrun inventory --tsv --no-gh --repo "$IVZ" > "$IVZ_T2NG"
IVZ_T3="$IV/z3.tsv"; _ivzrun --path "$IVSTUB3:$IVSTUB:$PATH" inventory --tsv --repo "$IVZ" > "$IVZ_T3"
IVZ_T4="$IV/z4.tsv"; _ivzrun --tmp "$IVZC/wt-clean/tmpdir-here" inventory --tsv --no-gh --no-host --repo "$IVZ" > "$IVZ_T4"
IVZ_P1="$IV/p1.tsv"; _ivzrun --cwd "$IV/pc1" inventory --tsv --no-gh --no-host > "$IVZ_P1"
IVZ_P2="$IV/p2.tsv"; _ivzrun --cwd "$IV/pc2" inventory --tsv --no-gh --no-host > "$IVZ_P2"
# The rows of one ref, exactly.
_ivz_sel() { LC_ALL=C awk -F'\t' -v r="$2" '$3 == r' "$1" > "$IV/sel"; }
_ivz_chk() {  # name file ref mode arg
  _ivz_sel "$2" "$3"
  if _iv_q "$4" "$5"; then ok "$1"; else bad "$1" "$(_iv_diag)"; fi; }
_ivz_det() { LC_ALL=C awk -F'\t' -v e="$1" '$8 ~ e { f = 1 } END { exit !(NR && f) }' "$IV/sel"; }

# Filters (a clean filter is a program the repository's config runs; git-lfs
# stores what it is handed): none runs, and a path one would have cleaned is
# not called uncommitted on its raw bytes.
[ -s "$IVZ_T1" ] && [ ! -e "$IVZX/filter-ran" ] && ok "no clean filter the repository configures runs, in any run" \
  || bad "no clean filter the repository configures runs, in any run" "$(_ivrows "$IVZ_T1" "the filter left $(wc -l < "$IVZX/filter-ran" 2>/dev/null | tr -d ' ') marks")"
_ivz_sel "$IVZ_T1" "$IVZC/wt-filter"
if _iv_q lack uncommitted && _iv_q word 0:unknown; then ok "a worktree whose only changed-looking file sits under a clean filter is not called uncommitted, and says unknown"
else bad "a worktree whose only changed-looking file sits under a clean filter is not called uncommitted, and says unknown" "$(_iv_diag)"; fi
# Worktree paths: a line break spells no second worktree, and a directory git
# lists whose .git file is gone is read as what it is.
if [ -s "$IVZ_T1" ] && ! LC_ALL=C awk -F'\t' -v r="$IVZD" '$3 == r { f = 1 } END { exit !f }' "$IVZ_T1" \
   && ! grep -qF -- "-C $IVZD " "$IVGIT_LOG"; then ok "a worktree whose path holds a line break makes no row of the directory the break spells, and no git runs there"
else bad "a worktree whose path holds a line break makes no row of the directory the break spells, and no git runs there" "$(grep -F -- "$IVZD" "$IVZ_T1" "$IVGIT_LOG" | head -n 3 | tr '\t\n' '|;')"; fi
_ivz_chk "a listed worktree whose .git file is gone is an orphan of the repository, not the checkout around it" "$IVZ_T1" "$IVZC/wt-q" hold orphan
_ivz_chk "and it is not landed" "$IVZ_T1" "$IVZC/wt-q" lack landed
_ivz_chk "and its row says git marks it prunable" "$IVZ_T1" "$IVZC/wt-q" word 8:prunable
_ivz_chk "the main worktree does not count its linked worktrees' and orphans' files as its own changes" "$IVZ_T1" "$IVZ" lack uncommitted
# Branches: the default branch is told by name, and a remote branch ahead of
# its local namesake is read.
_ivz_chk "a worktree on a branch tracking origin/main, pushed under its own name with an open pull request, is pr-open" "$IVZ_T1" "$IVZC/wt-feat2" hold pr-open
_ivz_chk "and not landed" "$IVZ_T1" "$IVZC/wt-feat2" lack landed
_ivz_chk "a branch tracking origin/main, pushed under its own name with no pull request, is unproposed" "$IVZ_T1" topic/feat3 hold unproposed
_ivz_chk "a remote branch that moved on from its local namesake, content not on main and no pull request, has a row, unproposed" "$IVZ_T1" origin/topic/diverge hold unproposed
_ivz_chk "a detached worktree whose index holds an earlier HEAD's tree leads with hazard:staged-revert" "$IVZ_T1" "$IVZC/wt-m3" lead hazard:staged-revert
_ivz_sel "$IVZ_T1" "$IVZC/wt-f2"
if _iv_q hold uncommitted && _ivz_det ', 0 of them holding content in no object'; then ok "an uncommitted worktree whose changed file's content an object holds says none of its content is in no object"
else bad "an uncommitted worktree whose changed file's content an object holds says none of its content is in no object" "$(_iv_diag)"; fi
# Orphans.
_ivz_chk "a directory named with a glob character is an orphan, not hidden by the tracked directory its name globs to" "$IVZ_T1" "$IVZC/k*" lead orphan
_ivz_sel "$IVZ_T1" "$IVZC/plain"
if _iv_q lead orphan && _ivz_det '^1 of 1 files'; then ok "a plain directory's orphan count leaves out what the repository's ignore file ignores"
else bad "a plain directory's orphan count leaves out what the repository's ignore file ignores" "$(_iv_diag)"; fi
_ivz_sel "$IVZ_T1" "$IVZC/ign"
if _iv_q lead orphan && _ivz_det '(^|; )1 of 1 ignored files hold content in no object'; then ok "an orphan's ignored file whose content is in no object is counted, not passed over"
else bad "an orphan's ignored file whose content is in no object is counted, not passed over" "$(_iv_diag)"; fi
_ivz_chk "a worktree pruned from a directory where git lists no worktree any more is still an orphan" "$IVZ_T1" "$IVZ/.lost/g1" lead orphan
# The host's records.
_ivz_chk "a live session in a non-ASCII directory, filed as Claude Code files it, makes it live" "$IVZ_T1" "$IVZ_JOSE" hold live
_ivz_chk "a live session in a directory whose record name Claude Code cuts at 200 makes it live" "$IVZ_T1" "$IVZ_LONG" hold live
_ivz_sel "$IVZ_T1" "$IVZC/wt-tab"
if _iv_q hold live && _iv_q lack question && _iv_q lack blocked; then ok "a live session whose file name holds a tab is live, and neither a question nor blocked"
else bad "a live session whose file name holds a tab is live, and neither a question nor blocked" "$(_iv_diag)"; fi
_ivz_chk "a newest session that is not JSON says unknown, rather than passing as ended on no question" "$IVZ_T1" "$IVZC/wt-garbage" word 0:unknown
_ivz_chk "a question whose note is cut inside a character is still a question" "$IVZ_T1" "$IVZC/wt-utf8" hold question
if [ -s "$IVZ_T1" ] && iconv -f UTF-8 -t UTF-8 < "$IVZ_T1" > /dev/null 2>&1; then ok "and every --tsv byte is valid UTF-8"
else bad "and every --tsv byte is valid UTF-8" "$(_ivrows "$IVZ_T1" "iconv rejects it")"; fi
_iv_selstate "$IVZ_T1" chip-unstarted
if grep -qF 'Title with C:\path' "$IV/sel" && ! LC_ALL=C grep -q "$(printf '\001')" "$IV/sel"; then ok "a chip title's backslash prints as a backslash, with no control byte"
else bad "a chip title's backslash prints as a backslash, with no control byte" "$(_iv_diag | od -c | head -n 3 | tr '\n' ' ')"; fi
# What gh cannot say.
# Spec §4.3 rule 5 and §8: under --no-gh a pushed tip's not reads unknown, so
# the row is undecided with content not not or partly: counted, not listed.
# The count is the view's own: it equals the --tsv rows of the same reading
# that are undecided (an unknown: headline, or states - or live alone) with
# content neither not nor partly, so a view that drops feat3 uncounted fails.
_ivx="$(LC_ALL=C awk '/nothing decided but unknown [0-9]/ { sub(/.*nothing decided but unknown /, ""); print; exit }' "$IVZ_H2")"
_ivy="$(LC_ALL=C awk -F'\t' '$1 != "cover" { h = $4; sub(/,.*/, "", h); if ((h ~ /^unknown:/ || $4 == "-" || $4 == "live") && $7 != "not" && $7 != "partly") n++ } END { print n + 0 }' "$IVZ_T2NG")"
_ivz_sel "$IVZ_T2NG" topic/feat3
[ -s "$IVZ_H2" ] && ! grep -qF topic/feat3 "$IVZ_H2" && [ -n "$_ivx" ] && [ "$_ivx" = "$_ivy" ] \
  && LC_ALL=C awk -F'\t' '$7 == "unknown" && $4 ~ /^unknown:/ { f = 1 } END { exit !f }' "$IV/sel" \
  && ok "under --no-gh the human view counts a pushed branch whose content cannot be confirmed off main, rather than listing it" \
  || bad "under --no-gh the human view counts a pushed branch whose content cannot be confirmed off main, rather than listing it" "count [$_ivx] derived [$_ivy] row [$(_iv_diag)] $(grep -F topic/feat3 "$IVZ_H2" | head -n 2 | tr '\n' ';')$(tail -n 4 "$IVZ_H2" | tr '\n' ';')"
_ivz_sel "$IVZ_T3" topic/feat3
if _iv_q lack unproposed && _iv_q word 0:unknown; then ok "when gh lists its limit of pull requests, a pushed branch with none among them is unknown, not unproposed"
else bad "when gh lists its limit of pull requests, a pushed branch with none among them is unknown, not unproposed" "$(_iv_diag)"; fi
[ ! -e "$IVH/.local/state" ] && [ -s "$IVZ_T1" ] && ok "what gh keeps of its own lands in no file under HOME" \
  || bad "what gh keeps of its own lands in no file under HOME" "$(_ivrows "$IVZ_T1" "$(find "$IVH/.local" -type f 2>/dev/null | head -n 2 | tr '\n' ' ')")"
# Scratch, signals and here-documents.
_ivz_sel "$IVZ_T4" "$IVZC/wt-clean"
if _iv_q lack uncommitted && [ -z "$(ls -A "$IVZC/wt-clean/tmpdir-here")" ]; then ok "with TMPDIR inside a clean worktree, that worktree is not called uncommitted, and nothing is left there"
else bad "with TMPDIR inside a clean worktree, that worktree is not called uncommitted, and nothing is left there" "$(_iv_diag)"; fi
( cd "$IVZ" || exit 97; ulimit -c 0
  unset FELIX_HOME FELIX_MEMORY GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_CEILING_DIRECTORIES
  export HOME="$IVH" TMPDIR="$IV/tq" PATH="$IVSTUB4:$IVSTUB:$PATH" XDG_CONFIG_HOME="$IVH/.config" GIT_CONFIG_NOSYSTEM=1 \
         GIT_ALLOW_PROTOCOL=file GIT_TERMINAL_PROMPT=0 GIT_CEILING_DIRECTORIES="$IV"
  exec perl -e '$SIG{QUIT} = "DEFAULT"; $SIG{INT} = "DEFAULT"; exec @ARGV or exit 127' "$IVF" inventory --tsv --no-host --repo "$IVZ" ) > /dev/null 2>&1 &
_ivzq=$!; _ivn=0
while [ ! -s "$IV/gh-slow.log" ] && [ "$_ivn" -lt 600 ] && kill -0 "$_ivzq" 2>/dev/null; do sleep 0.2; _ivn=$((_ivn + 1)); done
_ivx="$(ls -A "$IV/tq" | tr '\n' ' ')"
kill -QUIT "$_ivzq" 2>/dev/null; wait "$_ivzq" 2>/dev/null; _ivzqr=$?
if [ ! -s "$IV/gh-slow.log" ]; then bad "a QUIT mid-run leaves no scratch behind" "gh was never reached, so no signal was sent (rc $_ivzqr)"
elif [ -z "$_ivx" ]; then bad "a QUIT mid-run leaves no scratch behind" "no scratch was there to leave while gh ran"
else is "a QUIT mid-run leaves no scratch behind" "$(ls -A "$IV/tq" | tr '\n' ' ')" ""; fi
_iv_heredoc() { _ivcode "$IVLIB" "$IVLIBH" ${IVPARTS[@]+"${IVPARTS[@]}"} | grep -E '<<-?[[:space:]]*[A-Za-z_"'"'"']|<<<' | _ivwhere 'a here-document'; }
is  "no library feeds anything from a here-document or here-string, which bash 3.2 writes to a file outside the scratch" "$(_iv_heredoc)" ""
# Partial clones: nothing fetched, and what could not be read is unknown.
[ -s "$IVZ_P1" ] && [ "$(_ivz_pack "$IV/pc1")" = "$_ivz_pc1" ] && ok "reading a partial clone fetches nothing into it" \
  || bad "reading a partial clone fetches nothing into it" "$(_ivrows "$IVZ_P1" "$(diff <(printf '%s\n' "$_ivz_pc1") <(_ivz_pack "$IV/pc1") | head -n 4 | tr '\n' ';')")"
_iv_selstate "$IVZ_P2" handoff-pending
if [ -s "$IV/sel" ] && ! grep -qF 'no Next lines' "$IV/sel"; then ok "a pending section a partial clone cannot read is not said to have no Next lines"
else bad "a pending section a partial clone cannot read is not said to have no Next lines" "$(_iv_diag)"; fi
_ivz_after="$(_ivz_snap)"
[ -s "$IVZ_T1" ] && [ "$_ivz_after" = "$_ivz_before" ] && ok "no file under gizmo, its origin or the decoy changed across these runs" \
  || bad "no file under gizmo, its origin or the decoy changed across these runs" "$(diff <(printf '%s\n' "$_ivz_before") <(printf '%s\n' "$_ivz_after") | head -n 6 | tr '\n' ';')"
_ivx="$(grep -E 'bad substitution|syntax error|unbound variable|command not found|invalid option|not a valid identifier|division by 0|awk: |Permission denied' "$IV_ERR" | head -n 3 | tr '\n' ';')"
is  "no run wrote a shell or awk error to stderr, nor a failed redirection" "$_ivx" ""

# ---- spec decisions of 2026-09-24 ----------------------------------------
# Six decisions Felix took on the spec after review, each held to the rule it
# sets and each seen failing on the command as it stood before it was built:
#   D1 a session ended on a question when its final assistant text asks,
#      and no human text follows. Asks is the rule measured on 227 real
#      endings read by hand on 2026-09-24: fenced blocks, code spans,
#      double-quoted spans and blockquotes set aside, a ? ends a line in the
#      last three paragraphs, or the text makes one of ten offers (say the
#      word, want me to, your call, ...) not negated within its clause. The
#      note stays the text's last 160 characters, cut on a character boundary
#   D2 live is the newest mtime among a session's own file and every file
#      under its <session-id>/subagents/ (workflows/ too); blocked also needs
#      nothing there written within --blocked; question and blocked read the
#      session's own file only
#   D3 superseded 2026-10-01 (spec §5, §5.1): what was read is five cover
#      rows per repository, ref the facet; no row is of kind repo
#   D4 --days defaults to 14, and the human view states the window
#   D5 a worktree or orphan under $TMPDIR, /tmp, /private/tmp or
#      /private/var/folders carries the detail word temp, keeps its states,
#      and is listed in a group of its own after what needs action
#   D6 no code: pending/ only, which the handoff assertions above hold
# D1, D2 and D4 are built on a fourth repository, doohickey, so nothing above
# changes its fixture; D3 and D5 read the runs above as well.
printf '\nfelix inventory: the spec decisions of 2026-09-24\n'
IVW4="$IV/work4"; IVK="$IVW4/doohickey"; IVKO="$IV/origin4.git"
mkdir -p "$IVW4"
_ivrepo "$IVKO" "$IVK" acme/doohickey
# Its one commit is ten days old, so a row's age comes from its sessions.
printf 'doohickey\n' > "$IVK/README.md"
( _ivx="$(( $(date +%s) - 864000 )) +0000"; export GIT_COMMITTER_DATE="$_ivx" GIT_AUTHOR_DATE="$_ivx"; _ivwc "$IVK" 'the first doohickey' )
_ivg -C "$IVK" push -q origin main; _ivg -C "$IVK" remote set-head origin main
for _ivn in midq boldq listq longq trail earlier blankws quoted code then offer plain agent flow stale mid two; do
  _ivg -C "$IVK" worktree add -q -b "topic/$_ivn" "$IVW4/wt-$_ivn" main
done
# D1: sessions two hours old, each ending on one final text. The texts are
# written as a transcript holds them, a line break as \n.
_ivk1() {  # worktree sid text
  _ivopen "$IVW4/$1" "$2"
  _au_say  "$(_ivago 122 iso)" 'report back'
  _au_stop "$(_ivago 120 iso)" "msg_$1" "$3"
  _ivtouch "$_AU_F" 120
}
IVK_TAIL='the rest of the paragraph runs on the rest of the paragraph runs on the rest of the paragraph runs on the rest of the paragraph runs on the rest of the paragraph runs on the rest of the paragraph runs on the rest of the paragraph runs on'
_ivk1 wt-midq    d1d1d1d1-0000-4000-8000-000000000001 'I rebased the branch and the suite is green.\n\nShall I push it? Or leave it for review.'
_ivk1 wt-boldq   d1d1d1d1-0000-4000-8000-000000000002 'The two layouts differ in one place.\n\n**Want me to merge it?** I can wait.'
_ivk1 wt-listq   d1d1d1d1-0000-4000-8000-000000000003 'Three options remain:\n- keep it\n- drop it\n- split it\nWhich one do you prefer?\nAny of them works.'
_ivk1 wt-longq   d1d1d1d1-0000-4000-8000-000000000004 "Done.\\n\\nShall I go on? $IVK_TAIL "
_ivk1 wt-trail   d1d1d1d1-0000-4000-8000-000000000005 'Here it is.\n\nWhich one do you want?\n\n'
# A ? four paragraphs back, in a text that makes no offer; and the same with
# the first break a line of spaces and a tab, which three paragraphs would
# reach if that line were not blank.
_ivk1 wt-earlier d1d1d1d1-0000-4000-8000-000000000006 'Is it pushed?\n\nOne thing is left.\n\nThe tests pass.\n\nThe branch is pushed.'
_ivk1 wt-blankws d1d1d1d1-0000-4000-8000-000000000007 'Is it pushed?\n \t \nOne thing is left.\n\nThe tests pass.\n\nThe branch is pushed.'
# What a ? in the last paragraph got wrong on real endings, each way: a
# question quoted from someone else, git status's ?? in a code span, a
# question with one more paragraph after it, an offer with no ?, and a
# summary whose one offer-like phrase is negated.
_ivk1 wt-quoted  d1d1d1d1-0000-4000-8000-000000000008 'I answered the one review comment, which asked \"is this realistic?\"'
_ivk1 wt-code    d1d1d1d1-0000-4000-8000-000000000009 'The tree is clean but for one scratch file, `?? notes.txt`, which stays out of the commit.'
_ivk1 wt-then    d1d1d1d1-0000-4000-8000-00000000000a 'Is the second layout the one to keep?\n\nEverything else is pushed.'
_ivk1 wt-offer   d1d1d1d1-0000-4000-8000-00000000000b 'The fix is on the branch. Say the word and I will open the pull request.'
_ivk1 wt-plain   d1d1d1d1-0000-4000-8000-00000000000c 'The branch is merged and the worktree is clean; nothing here needs your decision.'
# D2: sessions whose own file last moved two or three hours ago, on a call
# to a subagent that has had no result, and whose subagents/ holds a file
# last written some minutes ago.
_ivk2() {  # worktree sid own-age-min
  _ivopen "$IVW4/$1" "$2"
  _au_say  "$(_ivago $(($3 + 2)) iso)" 'look into it'
  _au_tool "toolu_$1" Agent '{"description":"Look into it","prompt":"look into it","subagent_type":"general-purpose"}'
  _au_a    "$(_ivago "$3" iso)" "msg_$1" '"tool_use"' "$_AU_B"
  _ivtouch "$_AU_F" "$3"
}
_ivk2sub() {  # worktree sid path-under-subagents age-min
  _au_open "$(_ive "$IVW4/$1")/$2/subagents/$3" "agent-$1"
  _au_say  "$(_ivago $(($4 + 1)) iso)" 'look into it'
  _au_stop "$(_ivago "$4" iso)" "msg_sub_$1" 'Found it. Anything else?'
  _ivtouch "$_AU_F" "$4"
}
_ivk2    wt-agent d2d2d2d2-0000-4000-8000-000000000001 120
_ivk2sub wt-agent d2d2d2d2-0000-4000-8000-000000000001 agent-a1.jsonl 2
_ivk2    wt-flow  d2d2d2d2-0000-4000-8000-000000000002 120
_ivk2sub wt-flow  d2d2d2d2-0000-4000-8000-000000000002 workflows/wf_1/agent-a2.jsonl 2
_ivk2    wt-stale d2d2d2d2-0000-4000-8000-000000000003 120
_ivk2sub wt-stale d2d2d2d2-0000-4000-8000-000000000003 agent-a3.jsonl 90
_ivk2    wt-mid   d2d2d2d2-0000-4000-8000-000000000004 120
_ivk2sub wt-mid   d2d2d2d2-0000-4000-8000-000000000004 agent-a4.jsonl 30
# wt-two: an older session, quiet three hours on a subagent that wrote two
# minutes ago, and a newer one that ended on a question ninety minutes ago.
_ivk2    wt-two   d2d2d2d2-0000-4000-8000-00000000000a 180
_ivk2sub wt-two   d2d2d2d2-0000-4000-8000-00000000000a agent-a5.jsonl 2
_ivopen "$IVW4/wt-two" d2d2d2d2-0000-4000-8000-00000000000b
_au_say  "$(_ivago 92 iso)" 'is it ready'
_au_stop "$(_ivago 90 iso)" msg_two_b 'It is ready. Shall I merge it?'
_ivtouch "$_AU_F" 90
# D4: a chip in a session ten days old, never started, and one in a session
# twenty days old.
IV_PK_PROMPT='Kappa task: make the importer skip a row whose checksum repeats the previous row, and test it on a file holding one row twice in a row.'
IV_PI_PROMPT='Iota task: teach the report to name the file each total came from, and test that a total built from two files names both of them.'
_ivopen "$IVK" d4d4d4d4-0000-4000-8000-00000000000a
_au_say  "$(_ivago 14402 iso)" 'note what is left'
_ivchip  "$(_ivago 14401 iso)" toolu_ck task_k4k4k4k4 'Kappa chip ten days old' "$IV_PK_PROMPT"
_au_stop "$(_ivago 14400 iso)" msg_ck 'Noted.'
_ivtouch "$_AU_F" 14400
_ivopen "$IVK" d4d4d4d4-0000-4000-8000-00000000000b
_au_say  "$(_ivago 28802 iso)" 'note what is left'
_ivchip  "$(_ivago 28801 iso)" toolu_ci task_i4i4i4i4 'Iota chip twenty days old' "$IV_PI_PROMPT"
_au_stop "$(_ivago 28800 iso)" msg_ci 'Noted.'
_ivtouch "$_AU_F" 28800

IVK_T1="$IV/k1.tsv"; _ivrun --cwd "$IVK" inventory --tsv --no-gh --repo "$IVK" > "$IVK_T1"; IVK_RC1=$?
IVK_T2="$IV/k2.tsv"; _ivrun --cwd "$IVK" inventory --tsv --no-gh --blocked 40 --repo "$IVK" > "$IVK_T2"
IVK_H1="$IV/k1.txt"; _ivrun --cwd "$IVK" inventory --no-gh --repo "$IVK" > "$IVK_H1"
IVK_H3="$IV/k3.txt"; _ivrun --cwd "$IVK" inventory --no-gh --days 3 --repo "$IVK" > "$IVK_H3"
# The temporary directories replaced by one outside the fixture, so its rows
# read as a checkout anywhere else would; and a HOME with no session records.
IVK_T4="$IV/k4.tsv"; _ivrun --cwd "$IVK" --troots "$TMP/elsewhere" inventory --tsv --no-gh --repo "$IVK" > "$IVK_T4"
IVK_H4="$IV/k4.txt"; _ivrun --cwd "$IVK" --troots "$TMP/elsewhere" inventory --no-gh --repo "$IVK" > "$IVK_H4"
mkdir -p "$IV/norecords"
IVK_H5="$IV/k5.txt"; _ivrun --cwd "$IVK" --home "$IV/norecords" inventory --no-gh --repo "$IVK" > "$IVK_H5"
is  "the decisions' runs: felix inventory --tsv over doohickey exits 0" "$IVK_RC1" "0"
# The row of one worktree, by its path exactly.
_ivk_sel() { LC_ALL=C awk -F'\t' -v r="$IVW4/$2" '$3 == r' "$1" > "$IV/sel"; }
_ivk_chk() {  # name file worktree mode arg
  _ivk_sel "$2" "$3"
  if _iv_q "$4" "$5"; then ok "$1"; else bad "$1" "$(_iv_diag)"; fi; }

# ---- D1: question ----
_ivk_chk "D1: an offer that asks and then goes on on the same line is a question" "$IVK_T1" wt-midq hold question
_ivk_chk "D1: a question in bold followed by a statement is a question" "$IVK_T1" wt-boldq hold question
_ivk_chk "D1: a last paragraph of single lines, one of them ending on ?, is a question" "$IVK_T1" wt-listq hold question
_ivk_chk "D1: blank lines after the question leave it in the last paragraphs, a question" "$IVK_T1" wt-trail hold question
_ivk_chk "D1: a ? four paragraphs back, in a text that makes no offer, is no question" "$IVK_T1" wt-earlier lack question
_ivk_chk "D1: a line of spaces and a tab is a blank line, so the ? before it is four paragraphs back" "$IVK_T1" wt-blankws lack question
_ivk_chk "D1: a question inside double quotes is no question" "$IVK_T1" wt-quoted lack question
_ivk_chk "D1: a ?? inside a code span is no question" "$IVK_T1" wt-code lack question
_ivk_chk "D1: a question followed by one more paragraph is a question" "$IVK_T1" wt-then hold question
_ivk_chk "D1: an offer with no ? is a question" "$IVK_T1" wt-offer hold question
_ivk_chk "D1: a plain summary, even one saying nothing needs your decision, is no question" "$IVK_T1" wt-plain lack question
_ivk_sel "$IVK_T1" wt-midq
has "D1: the note of a short question is the whole text, a line break read as a space" "$(cut -f8 "$IV/sel")" \
    "ended on: I rebased the branch and the suite is green.  Shall I push it? Or leave it for review."
_ivx="Done.  Shall I go on? $IVK_TAIL"; _ivx="${_ivx:$((${#_ivx} - 160))}"
_ivk_sel "$IVK_T1" wt-longq
if _iv_q hold question; then has "D1: the note of a long question is the text's last 160 characters" "$(cut -f8 "$IV/sel")" "ended on: $_ivx"
else bad "D1: the note of a long question is the text's last 160 characters" "$(_iv_diag)"; fi

# ---- D2: live and blocked ----
_ivk_chk "D2: a session quiet two hours on a subagent call is live when a file under its subagents/ was written 2 minutes ago" "$IVK_T1" wt-agent hold live
_ivk_chk "D2: and it is not blocked, since its subagents wrote within --blocked" "$IVK_T1" wt-agent lack blocked
_ivk_sel "$IVK_T1" wt-agent
is  "D2: and its age is its newest file's, 0 hours" "$(cut -f6 "$IV/sel")" "0"
_ivk_chk "D2: a file under subagents/workflows/ written 2 minutes ago counts as well" "$IVK_T1" wt-flow hold live
_ivk_sel "$IVK_T1" wt-stale
if _iv_q lack live && _iv_q hold blocked; then ok "D2: subagents that last wrote 90 minutes ago make it neither live nor unblocked"
else bad "D2: subagents that last wrote 90 minutes ago make it neither live nor unblocked" "$(_iv_diag)"; fi
_ivk_sel "$IVK_T1" wt-mid
if _iv_q hold live && _iv_q hold blocked; then ok "D2: subagents that last wrote 30 minutes ago make it live, and under the default --blocked 20 still blocked"
else bad "D2: subagents that last wrote 30 minutes ago make it live, and under the default --blocked 20 still blocked" "$(_iv_diag)"; fi
_ivk_chk "D2: and under --blocked 40 they keep it from being blocked" "$IVK_T2" wt-mid lack blocked
_ivk_sel "$IVK_T1" wt-two
if _iv_q hold live && _iv_q hold question; then ok "D2: an older session's subagent writing now makes the worktree live, and the newest session's question stands"
else bad "D2: an older session's subagent writing now makes the worktree live, and the newest session's question stands" "$(_iv_diag)"; fi

# ---- D3: repository-level rows ----
# Superseded by the settled contract (2026-10-01 spec §5, §5.1, §11 row 2): what
# was read is five rows of kind cover per repository, ref the facet name, and
# no row of kind repo is ever printed. Each check names the facet and a
# state its states column must hold.
# kind ref states, for every row of kind cover or repo, or with ref -.
_ivk_repo() { LC_ALL=C awk -F'\t' '$1 == "kind" && $4 == "states" { next } $1 == "cover" || $1 == "repo" || $3 == "-" { print $1 "\t" $3 "\t" $4 }' "$1"; }
_ivk_rchk() {  # name file facet state
  if [ -s "$2" ] && _ivk_repo "$2" | LC_ALL=C awk -F'\t' -v r="$3" -v s="$4" '$1 == "cover" && $2 == r && index("," $3 ",", "," s ",") { f = 1 } END { exit !f }'; then ok "$1"
  else bad "$1" "$(_ivrows "$2" "$(_ivk_repo "$2" | tr '\t\n' '|;')")"; fi; }
_ivk_rchk "D3: under --no-gh the open PRs not listed are stated on the cover row prs" "$IV_T3" prs unknown:pr-open
_ivk_rchk "D3: with no gh on PATH, likewise" "$IV_T5" prs unknown:pr-open
_ivk_rchk "D3: under --no-host the chips not read are stated on the cover row chips" "$IV_T4" chips unknown:chip-unstarted
_ivk_rchk "D3: when gh lists its limit of 1000, the cover row prs says partial,unknown:unproposed" "$IVZ_T3" prs partial,unknown:unproposed
_ivx=""
for _ivf in "$IV_T0" "$IV_T0W" "$IV_T1" "$IV_T3" "$IV_T4" "$IV_T5" "$IV_T6" "$IV/t7.tsv" "$IV_T8" "$IVZ_T1" "$IVZ_T3" "$IVZ_T4" "$IVZ_P1" "$IVZ_P2" "$IVK_T1" "$IVK_T2"; do
  [ -f "$_ivf" ] || continue
  _ivx="$_ivx$(_ivk_repo "$_ivf" | LC_ALL=C awk -F'\t' -v f="${_ivf##*/}" '$1 == "repo" || $2 == "-" { printf "%s: %s %s; ", f, $1, $2 }')"
done
is  "D3: across every run, no row is of kind repo and no row has ref -" "$_ivx" ""

# ---- D4: the chip window ----
_iv_selstate "$IVK_T1" chip-unstarted
if grep -qE 'Kappa chip|task_k4k4k4k4' "$IV/sel"; then ok "D4: by default a chip from a session 10 days old is listed"
else bad "D4: by default a chip from a session 10 days old is listed" "$(_iv_diag)"; fi
if [ -s "$IVK_T1" ] && ! grep -qE 'Iota chip|task_i4i4i4i4' "$IV/sel"; then ok "D4: and one from a session 20 days old is not"
else bad "D4: and one from a session 20 days old is not" "$(_ivrows "$IVK_T1" "$(_iv_diag)")"; fi
LC_ALL=C grep -qiE 'chips.*last 14 days' "$IVK_H1" && ok "D4: the human view states the window: chips from the last 14 days" \
  || bad "D4: the human view states the window: chips from the last 14 days" "$(head -n 8 "$IVK_H1" | tr '\n' ';')"
LC_ALL=C grep -qiE 'chips.*last 3 days' "$IVK_H3" && ok "D4: and under --days 3 it says 3 days" \
  || bad "D4: and under --days 3 it says 3 days" "$(head -n 8 "$IVK_H3" | tr '\n' ';')"

# ---- D5: temporary directories ----
_iv_chk "D5: a worktree under a temporary directory carries the word temp in its detail" "$IV_T1" wt-dirty word 8:temp
_iv_chk "D5: and its states are computed as for any other: it still leads with uncommitted" "$IV_T1" wt-dirty lead uncommitted
_iv_chk "D5: an orphan under one carries temp too" "$IV_T1" orphan-edit word 8:temp
_ivx="$(LC_ALL=C awk -F'\t' '$1 == "kind" && $4 == "states" { next }
  $1 != "worktree" && $1 != "orphan" && tolower($8) ~ /(^|[^a-z])temp([^a-z]|$)/ { printf "%s %s; ", $1, $3 }' "$IV_T1" "$IV_T3" "$IV_T4")"
is  "D5: no row that is not a directory carries temp: branches, remote branches, PRs, chips, handoff sections, cover rows" "$(_ivrows "$IV_T1" "$_ivx")" ""
# Every fixture lies in a temporary directory (the suite's TMP is one), so
# the one path outside every temporary directory is asked of the test the
# command applies, below the command: the libraries sourced, _fi_tmps reading
# TMPDIR and _fi_temp asked of each path.
_ivx="$(TMPDIR=/nowhere/t/ /bin/bash -c 'unset FELIX_INVENTORY_TEMP_ROOTS; for f in "$@"; do . "$f" || exit 1; done; _fi_tmps; for p in /home/u/x /tmpx/y /private/varx /nowhere/tt /nowhere/t/z /tmp/a /private/tmp /private/var/folders/q/r; do _fi_temp "$p" && printf "%s " "$p"; done; exit 0' _ "$IVLIB" ${IVPARTS[@]+"${IVPARTS[@]}"} 2>&1)"
is  "D5: of eight paths, the four under TMPDIR, /tmp, /private/tmp or /private/var/folders are temp, and no other" "$_ivx" "/nowhere/t/z /tmp/a /private/tmp /private/var/folders/q/r "
IV_HT="$(_ivln "$IV_HU" 'in temporary directories' 'in temporary directories')"
IV_HX="$(LC_ALL=C awk '/(^|[^a-z])live [0-9]/ && /landed [0-9]/ { print NR; exit }' "$IV_HU")"
IV_HN="$(_ivln "$IV_HU" 'Delta chip' task_d4d4d4d4)"; IV_HF="$(_ivln "$IV_HU" frobnicator frobnicator)"; IV_HW="$(_ivln "$IV_HU" wt-dirty wt-dirty)"
if [ -n "$IV_HT" ] && [ -n "$IV_HX" ] && [ -n "$IV_HN" ] && [ -n "$IV_HF" ] && [ -n "$IV_HW" ] \
   && [ "$IV_HN" -lt "$IV_HT" ] && [ "$IV_HF" -lt "$IV_HT" ] && [ "$IV_HT" -lt "$IV_HW" ] && [ "$IV_HW" -lt "$IV_HX" ]; then
  ok  "D5: the human view lists them under \"in temporary directories\", after the groups that need action and before the live and landed counts"
else bad "D5: the human view lists them under \"in temporary directories\", after the groups that need action and before the live and landed counts" \
         "lines: temp group ${IV_HT:-none}, chip ${IV_HN:-none}, handoff ${IV_HF:-none}, wt-dirty ${IV_HW:-none}, counts ${IV_HX:-none}"; fi

# ---- what review of the decisions found ----
# Each held to the rule it broke, and seen failing on the command before its
# fix. A human view's item line is "    kind     ref  [states]": the group it
# sits in is the last heading above it, and a ref is matched whole.
_ivk_item()  { LC_ALL=C awk -v n="$2" '/^    [^ ]/ { s = substr($0, 14); sub(/  \[.*$/, "", s); if (s == n) { print; exit } }' "$1"; }
_ivk_group() { LC_ALL=C awk -v n="$2" '/^  [^ ]/ { g = $0; sub(/^  /, "", g); sub(/  [0-9]+$/, "", g); next }
    /^    [^ ]/ { s = substr($0, 14); sub(/  \[.*$/, "", s); if (s == n) { print g; exit } }' "$1"; }
_ivx="$(_ivk_item "$IVK_H1" "$IVW4/wt-two")"
[ -n "$_ivx" ] && ok "the human view lists a live worktree whose newest session ended on a question, rather than only counting it live" \
  || bad "the human view lists a live worktree whose newest session ended on a question, rather than only counting it live" "$(grep -F wt-two "$IVK_H1" | head -n 3 | tr '\n' ';')"
_ivx="$(_ivk_item "$IVK_H4" "$IVW4/wt-two")"
case "$(_ivk_group "$IVK_H4" "$IVW4/wt-two"):$_ivx" in
  question:*live*) ok  "and outside a temporary directory it is listed under question, its listing saying live" ;;
  *)               bad "and outside a temporary directory it is listed under question, its listing saying live" "group [$(_ivk_group "$IVK_H4" "$IVW4/wt-two")], line [$_ivx]" ;;
esac
is  "a live worktree whose tool call has waited past --blocked is listed under blocked, rather than only counted" "$(_ivk_group "$IVK_H4" "$IVW4/wt-mid")" "blocked"
_ivx="$(LC_ALL=C awk '/nothing decided but unknown [0-9]/ { sub(/.*nothing decided but unknown /, ""); print; exit }' "$IVK_H1")"
if [ "$_ivx" = 0 ] && LC_ALL=C grep -qE '(^|[^a-z])prs([^a-z]|$).*--no-gh' "$IVK_H1"; then
  ok  "nothing decided but unknown counts items, not the repository's own unknowns, which its header states"
else bad "nothing decided but unknown counts items, not the repository's own unknowns, which its header states" "count [$_ivx]; $(head -n 6 "$IVK_H1" | tr '\n' ';')"; fi
LC_ALL=C grep -qE '(^|[^a-z])chips([^a-z]|$).*no session records' "$IVK_H5" && ok "with no session records to read, the header says the chips are unknown, since no count does" \
  || bad "with no session records to read, the header says the chips are unknown, since no count does" "$(head -n 7 "$IVK_H5" | tr '\n' ';')"
# Spec §4.1, §5.1: the row carries each unknown: entry its unread facet
# leaves, read from --tsv, since §8 no longer lists such a row.
_iv_sel "$IV_T3" wt-unproposed
if _iv_q hold unknown:unproposed && _iv_q hold unknown:pr-open && _iv_q hold unknown:pr-closed-unlanded \
   && LC_ALL=C awk -F'\t' 'index("," $4 ",", ",unknown:unproposed,unknown:pr-open,unknown:pr-closed-unlanded,") { f = 1 } END { exit f ? 0 : 1 }' "$IV/sel"; then ok "an undecided row lists every state it could not decide, the first of them too"
else bad "an undecided row lists every state it could not decide, the first of them too" "$(_iv_diag)"; fi
# D5's list, replaced: the unit, then the command.
_ivx="$(FELIX_INVENTORY_TEMP_ROOTS=/nowhere/a:/nowhere/b/ TMPDIR=/nowhere/t /bin/bash -c 'for f in "$@"; do . "$f" || exit 1; done; _fi_tmps; for p in /nowhere/a/x /nowhere/b/y /nowhere/t/z /tmp/a /nowhere/ab; do _fi_temp "$p" && printf "%s " "$p"; done; exit 0' _ "$IVLIB" ${IVPARTS[@]+"${IVPARTS[@]}"} 2>&1)"
is  "D5: FELIX_INVENTORY_TEMP_ROOTS, colon-separated, replaces the list: of five paths only the two under its roots are temp" "$_ivx" "/nowhere/a/x /nowhere/b/y "
_ivx="$(LC_ALL=C awk -F'\t' '$1 == "kind" && $4 == "states" { next } tolower($8) ~ /(^|[^a-z])temp([^a-z]|$)/ { printf "%s; ", $3 }' "$IVK_T4")"
_ivk_sel "$IVK_T4" wt-midq
if [ -s "$IVK_T4" ] && [ -z "$_ivx" ] && _iv_q hold question; then
  ok  "D5: with it naming a directory outside the fixture, no fixture row carries temp, and each keeps its states"
else bad "D5: with it naming a directory outside the fixture, no fixture row carries temp, and each keeps its states" "temp: [$_ivx]; $(_iv_diag)"; fi
is  "D5: and the human view lists a worktree whose session asked in its needs-action group, question" "$(_ivk_group "$IVK_H4" "$IVW4/wt-midq")" "question"

_ivx="$(grep -E 'bad substitution|syntax error|unbound variable|command not found|invalid option|not a valid identifier|division by 0|awk: |Permission denied' "$IV_ERR" | head -n 3 | tr '\n' ';')"
is  "the decisions' runs wrote no shell or awk error to stderr" "$_ivx" ""

# ---------------------------- felix inventory: the settled contract, blind ----
# The assertions of audits/2026-10-01-report-v5-review/specs/inventory/
# assertions.md, written blind from that day's settled spec.md (no inventory
# library and no implementation diff read), with the rulings of disposition.md
# beside them. Each name carries its id: A1 ... A120 from assertions.md, and
# N1 ... N16 for what disposition.md asked the blind author for (the
# replacements for A101 and A107(a), the re-derived first line of A16 and tail
# of A22, H2's example, H4's guard, M1's gpg probe, M3's fork PR, H5's squash
# case, §6.2's message-first record) and for settled clauses no A-row reached
# (shallow clones, ssh ports, CLAUDE_CONFIG_DIR, a PR headed like the default
# branch). A101 is obsolete whole and is not here; A16, A22, A103 and A107 are
# here as the settlement left them, and their obsolete parts are left out.
#
# Records (spec.md §0 step 3, disposition.md H2): every user or assistant
# record the builders below write carries a "timestamp" equal to the age the
# fixture gives its session, and the session file's mtime is set to that same
# age, so a record's time and its file's time agree unless an assertion sets
# them apart on purpose (N1, N2). A user record puts "type":"user" before its
# message; an assistant record puts its message first and its own
# "type":"assistant" after it, as §6.2 states and the audit builders write.
#
# Everything lives under $IB, one repository per concern, so no block here
# depends on a project table or on a fixture another section leaves behind.
# Records are written just before the runs that read them, because their ages
# are minutes and a loaded machine spends minutes building the repositories.
printf '\nfelix inventory: the settled contract of 2026-10-01, written blind\n'

IB="$TMP/inventory-blind"; mkdir -p "$IB"; IB="$(cd "$IB" && pwd -P)"
mkdir -p "$IB/home/.claude/projects" "$IB/home0/.claude/projects" "$IB/homenone" "$IB/fxhome" "$IB/tmp" \
         "$IB/cwd" "$IB/stub" "$IB/stubng" "$IB/spy" "$IB/old" "$IB/gh/default" "$IB/mem" "$IB/temproot" \
         "$IB/runs" "$IB/ccd/projects" "$IB/plain" "$IB/clone/felix/engine"
_copy_content "$REAL_HARNESS" "$IB/clone/felix/engine/harness"
IBF="$IB/clone/felix/engine/harness/felix"; IBP="$IB/home/.claude/projects"; IB_GIT="$(command -v git)"
IBL="$REAL_HARNESS/lib"
printf '[]\n' > "$IB/gh/default/all.json"; printf '[]\n' > "$IB/gh/default/open.json"
printf '0\n' > "$IB/gh/rc"; : > "$IB/gh/err"

# ---- stand-ins -----------------------------------------------------------
# gh logs PWD|ARGS|GH_NO_UPDATE_NOTIFIER|GH_PROMPT_DISABLED|XDG_STATE_HOME|
# XDG_CACHE_HOME and answers the --state all or --state open listing of the
# repository -R names (else of the directory it runs in) from $IB/gh/<key>/.
# $IB/gh/rc and err make it fail, fail-open fails the second call only, and
# slow makes it write its PID and sleep.
cat > "$IB/stub/gh" <<IBGHEOF
#!/bin/sh
D='$IB/gh'
printf '%s|%s|%s|%s|%s|%s\n' "\$PWD" "\$*" "\${GH_NO_UPDATE_NOTIFIER-}" "\${GH_PROMPT_DISABLED-}" "\${XDG_STATE_HOME-}" "\${XDG_CACHE_HOME-}" >> '$IB/gh.log'
r=""; p=""
for a in "\$@"; do [ "\$p" = -R ] && r="\$a"; p="\$a"; done
if [ -n "\$r" ]; then k="\$(printf '%s' "\$r" | tr '/' '_')"; else k="pwd_\${PWD##*/}"; fi
[ -d "\$D/\$k" ] || k=default
if [ -f "\$D/slow" ]; then printf '%s\n' "\$\$" > '$IB/gh.pid'; exec sleep 30; fi
s=all; case " \$* " in *" --state open "*) s=open ;; esac
if [ "\$s" = open ] && [ -f "\$D/fail-open" ]; then echo 'gh: the open listing failed' >&2; exit 1; fi
rc="\$(cat "\$D/rc")"
if [ "\$rc" != 0 ]; then cat "\$D/err" >&2; exit "\$rc"; fi
cat "\$D/\$k/\$s.json"
IBGHEOF
for _ibn in curl wget ssh nc; do
  printf '#!/bin/sh\nprintf "%%s\\n" %s >> "%s/net.log"\nexit 0\n' "$_ibn" "$IB" > "$IB/stub/$_ibn"
  cp "$IB/stub/$_ibn" "$IB/stubng/$_ibn"
done
# The git spy logs GIT_NO_LAZY_FETCH=<v>|<args>; the old git says 2.43.0.
cat > "$IB/spy/git" <<IBSPYEOF
#!/bin/sh
printf 'GIT_NO_LAZY_FETCH=%s|%s\n' "\${GIT_NO_LAZY_FETCH-}" "\$*" >> '$IB/git.log'
exec '$IB_GIT' "\$@"
IBSPYEOF
cat > "$IB/old/git" <<IBOLDEOF
#!/bin/sh
for a in "\$@"; do case "\$a" in --version|version) echo 'git version 2.43.0'; exit 0 ;; esac; done
exec '$IB_GIT' "\$@"
IBOLDEOF
printf '#!/bin/sh\n: > "%s/gpg-ran"\nexit 1\n' "$IB" > "$IB/gpgstub"
chmod +x "$IB/stub/"* "$IB/stubng/"* "$IB/spy/git" "$IB/old/git" "$IB/gpgstub"

# ---- the fixture's git, commits and records ------------------------------
_ibg() { HOME="$IB/fxhome" XDG_CONFIG_HOME="$IB/fxhome/.config" GIT_CONFIG_NOSYSTEM=1 \
         GIT_AUTHOR_NAME=Fixture GIT_AUTHOR_EMAIL=fixture@example.invalid \
         GIT_COMMITTER_NAME=Fixture GIT_COMMITTER_EMAIL=fixture@example.invalid \
         "$IB_GIT" -c init.defaultBranch=main -c advice.detachedHead=false "$@"; }
_ibq() { _ibg --no-optional-locks "$@"; }
_ibi() { GIT_INDEX_FILE="$IB/fx.idx" HOME="$IB/fxhome" XDG_CONFIG_HOME="$IB/fxhome/.config" GIT_CONFIG_NOSYSTEM=1 "$IB_GIT" "$@"; }
_ibago() { printf '%s' $(( $(date +%s) - $1 * 60 )); }
IBC=""
_ibmk() {  # MIN|- repo parent|- message [path content|-]...  -> IBC, a commit no checkout holds
  local d="$1" r="$2" par="$3" msg="$4" blob tree; shift 4
  rm -f "$IB/fx.idx"
  if [ "$par" = - ]; then _ibi -C "$r" read-tree --empty; else _ibi -C "$r" read-tree "$par"; fi
  while [ $# -ge 2 ]; do
    if [ "$2" = - ]; then _ibi -C "$r" update-index --force-remove "$1"
    else blob="$(printf '%s\n' "$2" | _ibg -C "$r" hash-object -w --stdin)"
         _ibi -C "$r" update-index --add --cacheinfo "100644,$blob,$1"; fi
    shift 2
  done
  tree="$(_ibi -C "$r" write-tree)"
  IBC="$( if [ "$d" != - ]; then GIT_AUTHOR_DATE="$(_ibago "$d") +0000"; GIT_COMMITTER_DATE="$GIT_AUTHOR_DATE"
                                 export GIT_AUTHOR_DATE GIT_COMMITTER_DATE; fi
          if [ "$par" = - ]; then _ibg -C "$r" commit-tree "$tree" -m "$msg"
          else _ibg -C "$r" commit-tree "$tree" -p "$par" -m "$msg"; fi )"
}
_ibci() { _ibg -C "$1" add -A && _ibg -C "$1" commit -q -m "$2"; }
_ibnew() {  # NAME [path content]...: $IB/NAME-origin.git holding main, and $IB/NAME cloned from it
  local n="$1"; shift
  _ibg init -q --bare "$IB/$n-origin.git"
  _ibmk - "$IB/$n-origin.git" - "the first $n" README.md "$n" "$@"
  _ibg -C "$IB/$n-origin.git" update-ref refs/heads/main "$IBC"
  _ibg clone -q "$IB/$n-origin.git" "$IB/$n"
}
_ibmainwt() { _ibq -C "$1" worktree list --porcelain | LC_ALL=C awk 'NR == 1 { sub(/^worktree /, ""); print }'; }
_ibenc() { printf '%s' "$1" | LC_ALL=C sed 's/[^A-Za-z0-9]/-/g'; }
_ibts() { local e; e="$(_ibago "$1")"
          date -u -r "$e" '+%Y-%m-%dT%H:%M:%S.000Z' 2>/dev/null || date -u -d "@$e" '+%Y-%m-%dT%H:%M:%S.000Z'; }
_ibage() { local e; e="$(_ibago "$2")"
           touch -t "$(date -r "$e" '+%Y%m%d%H%M.%S' 2>/dev/null || date -d "@$e" '+%Y%m%d%H%M.%S')" "$1"; }
# A session file: _ibsess DIR SID files it where Claude Code files DIR's
# sessions; _ibopen FILE SID opens any path. IB_BR, when set, is the
# gitBranch every record carries; IB_SID is the sessionId.
IB_F=""; IB_SID=""; IB_BR=""; IB_TSF=""
_ibopen() { IB_F="$1"; IB_SID="$2"; mkdir -p "${1%/*}"; : > "$1"; }
_ibsess() { _ibopen "$IBP/$(_ibenc "$1")/$2.jsonl" "$2"; }
_ib_tsf() { if [ "$1" = none ]; then IB_TSF=""; else IB_TSF=",\"timestamp\":\"$(_ibts "$1")\""; fi; }
_ib_raw() { printf '%s\n' "$1" >> "$IB_F"; }
_ib_u() {  # MIN|none content-json [fields after the message]
  local g="" l; [ -n "$IB_BR" ] && g=",\"gitBranch\":\"$IB_BR\""; _ib_tsf "$1"
  printf -v l '{"parentUuid":"p","isSidechain":false,"userType":"external","sessionId":"%s","version":"2.1.286"%s,"type":"user","message":{"role":"user","content":%s}%s,"uuid":"u-%s"%s}' \
    "$IB_SID" "$g" "$2" "${3:-}" "$RANDOM" "$IB_TSF"
  printf '%s\n' "$l" >> "$IB_F"; }
_ib_ax() {  # MIN|none content-items-json stop-reason [isSidechain]
  local g="" l; [ -n "$IB_BR" ] && g=",\"gitBranch\":\"$IB_BR\""; _ib_tsf "$1"
  printf -v l '{"parentUuid":"p","isSidechain":%s,"userType":"external","sessionId":"%s","version":"2.1.286"%s,"message":{"model":"claude-test","id":"msg_%s","type":"message","role":"assistant","content":[%s],"stop_reason":"%s","stop_sequence":null,"usage":{"input_tokens":1,"output_tokens":1}},"requestId":"req_%s","type":"assistant","uuid":"a-%s"%s}' \
    "${4:-false}" "$IB_SID" "$g" "$RANDOM" "$2" "$3" "$RANDOM" "$RANDOM" "$IB_TSF"
  printf '%s\n' "$l" >> "$IB_F"; }
_ib_h()  { _ib_u "$1" "\"$2\""; }
_ib_a()  { local b; printf -v b '{"type":"text","text":"%s"}' "$2"; _ib_ax "$1" "$b" end_turn "${3:-false}"; }
_ib_tu() { local b; printf -v b '{"type":"tool_use","id":"%s","name":"%s","input":%s}' "$2" "$3" "$4"; _ib_ax "$1" "$b" tool_use; }
_ib_tr() { local b; printf -v b '[{"tool_use_id":"%s","type":"tool_result","content":"%s"}]' "$2" "$3"; _ib_u "$1" "$b"; }
_ib_chip() {  # MIN tool-id task-id title prompt: a spawn_task call and the result naming its task
  local i; printf -v i '{"title":"%s","prompt":"%s","tldr":"Noticed in passing."}' "$4" "$5"
  _ib_tu "$1" "$2" mcp__ccd_session__spawn_task "$i"
  _ib_tr "$1" "$2" "Noted (position 1, task_id: $3). A chip is showing for the user."; }
# A prompt of exactly N characters, from a seed sentence.
_ibp() { local s="$1 $1 $1 $1 $1"; printf '%s' "${s:0:$2}"; }

# ---- the runner and the row readers --------------------------------------
# _ibrun NAME [--home H] [--path P] [--cwd D] [--env V=X]... -- felix-args:
# from $IB/cwd, with nothing of Felix's or git's own in the environment, HOME
# the scratch home, TMPDIR $IB/tmp and the temporary roots $IB/temproot only
# (the suite's own TMP sits under the real ones). Output in $IB/runs/NAME.*.
_ibrun() {
  local n="$1" h="$IB/home" p="$IB/stub:$PATH" d="$IB/cwd" e=(); shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --home) h="$2"; shift 2 ;; --path) p="$2"; shift 2 ;; --cwd) d="$2"; shift 2 ;;
      --env) e[${#e[@]}]="$2"; shift 2 ;; --) shift; break ;; *) break ;;
    esac
  done
  ( cd "$d" || exit 97
    unset FELIX_HOME FELIX_MEMORY FELIX_KERNEL FELIX_KERNEL_CACHE FELIX_PLUGIN_CACHE CLAUDE_PLUGIN_ROOT CLAUDE_CONFIG_DIR \
          GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_OPTIONAL_LOCKS \
          XDG_STATE_HOME XDG_CACHE_HOME
    export HOME="$h" TMPDIR="$IB/tmp" FELIX_INVENTORY_TEMP_ROOTS="$IB/temproot" PATH="$p" XDG_CONFIG_HOME="$h/.config" \
           GIT_CONFIG_NOSYSTEM=1 GIT_TERMINAL_PROMPT=0 GIT_CEILING_DIRECTORIES="$IB"
    for _ibv in ${e[@]+"${e[@]}"}; do export "$_ibv"; done
    "$IBF" "$@" ) > "$IB/runs/$n.out" 2> "$IB/runs/$n.err"
  printf '%s' "$?" > "$IB/runs/$n.rc"
}
_ibo()  { printf '%s' "$IB/runs/$1.out"; }
_ibrc() { cat "$IB/runs/$1.rc" 2>/dev/null; }
# _ibrow RUN KIND REF [REPO]: that --tsv line; _ibcol ... N: its column N, or
# "no row"; _ibst: its states; _ibholds RUN KIND REF STATE: yes, no or no row.
_ibrow() { LC_ALL=C awk -F'\t' -v k="$2" -v r="$3" -v p="${4:-}" '$1 == k && $3 == r && (p == "" || $2 == p) { print; exit }' "$(_ibo "$1")"; }
_ibcol() { local l; l="$(_ibrow "$1" "$2" "$3" "${5:-}")"
           if [ -z "$l" ]; then printf 'no row'; else printf '%s\n' "$l" | LC_ALL=C awk -F'\t' -v n="$4" '{ printf "%s", $n }'; fi; }
_ibst()  { _ibcol "$1" "$2" "$3" 4 "${4:-}"; }
_ibholds() { local s; s="$(_ibst "$1" "$2" "$3" "${5:-}")"
             if [ "$s" = "no row" ]; then printf 'no row'; else case ",$s," in *",$4,"*) printf yes ;; *) printf no ;; esac; fi; }
# Several states at once: "S1=yes S2=no ...", each as _ibholds answers.
_ibmany() { local r="$1" k="$2" f="$3" s o=""; shift 3
            for s in "$@"; do o="$o${o:+ }$s=$(_ibholds "$r" "$k" "$f" "$s")"; done; printf '%s' "$o"; }
_ibcount() { LC_ALL=C awk -F'\t' -v k="$2" -v p="${3:-}" '$1 == k && (p == "" || $2 == p) { n++ } END { print n + 0 }' "$(_ibo "$1")"; }
# The element of a detail that starts with PREFIX (elements are joined by "; ").
_ibelem() { _ibcol "$1" "$2" "$3" 8 | LC_ALL=C awk -v p="$4" '{ n = split($0, e, "; "); for (i = 1; i <= n; i++) if (index(e[i], p) == 1) { print e[i]; exit } }'; }
_ibhaselem() { [ -n "$(_ibrow "$1" "$2" "$3")" ] || { printf 'no row'; return; }
               _ibcol "$1" "$2" "$3" 8 | LC_ALL=C awk -v w="$4" '{ n = split($0, e, "; "); for (i = 1; i <= n; i++) if (e[i] == w) f = 1 } END { print (f ? "yes" : "no") }'; }
_ibsnap() { ( cd "$1" && find . -print | LC_ALL=C sort && find . -type f -exec cksum {} + | LC_ALL=C sort ) 2>&1; }

# ---- r: the widget, where most items live --------------------------------
# main: M0 (100 hours old) holds every file the branches change; M1 (30h20m)
# adds two pending handoff sections; M2 (29h) changes a.txt; then, after the
# branches are cut from M2, main takes the squashes, the deletion, the merged
# and reverted change and the later edits the content rules are tested on.
IBO="$IB/origin.git"; IBR="$IB/r"
_ibg init -q --bare "$IBO"
_ibmk 6000 "$IBO" - 'the first widget' a.txt a0 b.txt b0 .gitignore '*.log' sq-a.txt s0 sq-b.txt s0 \
  half-a.txt h0 half-b.txt h0 none.txt n0 del.txt d0 rv.txt r0 late.txt l0 rev.txt e0 sqp.txt p0 \
  docs/handoff/pending/notes.txt 'notes, no section'; IB_M0="$IBC"
_ibmk 1820 "$IBO" "$IB_M0" 'two pending sections' \
  docs/handoff/pending/h1.md "$(printf '### a section\n\nWhat was done.\n\n## Next\n- one\n- two')" \
  docs/handoff/pending/h3.md "$(printf '### another section\n\nOnly prose here, and nothing after it.')"; IB_M1="$IBC"
_ibmk 1740 "$IBO" "$IB_M1" 'a.txt moves on' a.txt a1; IB_M2="$IBC"
_ibg -C "$IBO" update-ref refs/heads/main "$IB_M2"
_ibg clone -q "$IBO" "$IBR"
_ibb()    { _ibg -C "$IBR" branch -q -f "$1" "$2"; }
_ibpush() { _ibg -C "$IBR" push -q origin "$2:refs/heads/$1"; }
_ibmk 3040 "$IBR" "$IB_M2" 'aged work' aged.txt 'aged, nowhere else'; _ibb aged "$IBC"
_ibmk - "$IBR" "$IB_M2" 'same' cov-same.txt same; _ibb cov-same "$IBC"; _ibpush cov-same "$IBC"
_ibmk - "$IBR" "$IB_M2" 'ahead one' cov-ahead.txt one; _ibpush cov-ahead "$IBC"
_ibmk - "$IBR" "$IBC" 'ahead two' cov-ahead.txt two; _ibb cov-ahead "$IBC"
_ibmk - "$IBR" "$IB_M2" 'behind one' cov-behind.txt one; _ibb cov-behind "$IBC"
_ibmk - "$IBR" "$IBC" 'behind two' cov-behind.txt two; _ibpush cov-behind "$IBC"
_ibmk - "$IBR" "$IB_M2" 'theirs' theirs.txt theirs; _ibpush theirs "$IBC"; _ibb mine "$IBC"; IB_T1="$IBC"
_ibg -C "$IBR" config branch.mine.remote origin; _ibg -C "$IBR" config branch.mine.merge refs/heads/theirs
_ibmk - "$IBR" "$IB_M2" 'tracker' tracker.txt tracker; _ibb tracker "$IBC"
_ibg -C "$IBR" config branch.tracker.remote origin; _ibg -C "$IBR" config branch.tracker.merge refs/heads/main
_ibmk - "$IBR" "$IB_M2" 'pr only' pr-only.txt 'pr only'; _ibpush pr-only "$IBC"; IB_PO="$IBC"
_ibmk - "$IBR" "$IB_M2" 'stale pr' stale.txt stale; _ibpush stale-pr "$IBC"; IB_SP="$IBC"
_ibmk - "$IBR" "$IB_M2" 'nobody' nobody.txt nobody; _ibpush nobody "$IBC"; IB_NB="$IBC"
_ibmk - "$IBR" "$IB_M2" 'forked' forked.txt forked; _ibb forked "$IBC"; IB_FK="$IBC"
_ibmk - "$IBR" "$IB_M2" 'fork two' fk2.txt fk2; _ibb fk2 "$IBC"; _ibpush fk2 "$IBC"; IB_FK2="$IBC"
_ibmk - "$IBR" "$IB_M2" 'sq one' sq-a.txt s2; _ibmk - "$IBR" "$IBC" 'sq two' sq-b.txt s2; _ibb sq "$IBC"
_ibmk - "$IBR" "$IB_M2" 'half' half-a.txt h1 half-b.txt 'half, nowhere else'; _ibb half "$IBC"
_ibmk - "$IBR" "$IB_M2" 'none' none.txt 'none, nowhere else'; _ibb none "$IBC"
_ibmk - "$IBR" "$IB_M2" 'del' del.txt -; _ibb del "$IBC"
_ibmk - "$IBR" "$IB_M2" 'rv' rv.txt r1; _ibb rv "$IBC"; _ibpush rv "$IBC"; IB_RV="$IBC"
_ibmk - "$IBR" "$IB_M2" 'own a' own-a.txt oa; _ibpush own-a "$IBC"; IB_OA="$IBC"
_ibmk - "$IBR" "$IB_M2" 'own b' own-b.txt ob; _ibpush own-b "$IBC"; IB_OB="$IBC"
_ibmk - "$IBR" "$IB_M2" 'own c' own-c.txt oc; _ibpush own-c "$IBC"; IB_OC="$IBC"
_ibmk - "$IBR" "$IB_M2" 'rv2 one' rv2.txt q1; _ibb rv2 "$IBC"

#!/usr/bin/env bash
# Felix harness self-test.
#
# The claim under test is that Felix governs a project it knows nothing about.
# So this suite never touches Elenchus. It builds a throwaway Felix root holding
# a single invented project whose gate is a shell one-liner, in a checkout with
# no git remote, and drives the real CLI and the real hook against it.
#
# If Felix ever grows a hidden assumption about Python, about a remote naming
# scheme, or about Elenchus specifically, these tests are where it surfaces.
#
#   harness/tests/run

set -uo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
REAL_HARNESS="$(cd "$HERE/.." && pwd)"

PASS=0; FAIL=0
# Every assertion that RAN, by name, whatever its verdict.
#
# #67: two assertions execute on macOS and never run on the Linux runner — no
# pass, no fail, no skip line. Measured as a constant gap of 2 across three
# unrelated commits, including a pre-session main, and not caused by the
# `claude` CLI: hiding claude locally converts four passes into four skips and
# leaves the attempted total unchanged, while CI attempts two fewer.
#
# A total alone cannot say which two. This records names so the suite can
# compare what it ran against what it is supposed to run, and name the
# difference. A count that silently drops is indistinguishable from a passing
# run, which is the property this repository most needs not to have.
#
# Appended to a file rather than accumulated in a variable, because a shell
# variable does not survive the subshells some of these assertions run inside —
# the same reason PASS and FAIL are incremented in the main shell only.
FELIX_TEST_RAN=""
_ran() { [ -n "$FELIX_TEST_RAN" ] && printf '%s\n' "$1" >> "$FELIX_TEST_RAN"; return 0; }
ok()   { PASS=$((PASS+1)); _ran "$1"; printf '  ok    %s\n' "$1"; }
bad()  { FAIL=$((FAIL+1)); _ran "$1"; printf '  FAIL  %s\n' "$1"; [ -n "${2:-}" ] && printf '        %s\n' "$2"; }
is()   { [ "$2" = "$3" ] && ok "$1" || bad "$1" "expected [$3] got [$2]"; }
has()  { case "$2" in *"$3"*) ok "$1" ;; *) bad "$1" "[$2] lacks [$3]" ;; esac; }
# Some assertions describe the machine, not Felix: whether a real plugin is
# installed depends on the claude CLI existing. Skipping is honest; passing them
# by accident on a runner that has no CLI would be worse than not running them.
#
# A skip counts as REACHED for the manifest above. The distinction that matters
# there is between an assertion the suite decided about and one it never got to.
SKIP=0
skip() { SKIP=$((SKIP+1)); _ran "$1"; printf '  skip  %s (%s)\n' "$1" "$2"; }
has_claude() { command -v claude >/dev/null 2>&1; }

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
FELIX_TEST_RAN="$TMP/ran"; : > "$FELIX_TEST_RAN"
# The manifest of assertions this suite is supposed to reach, beside the suite
# and tracked. Regenerated with `tests/run --record-assertions`, which is the
# one command that changes it, so the diff on every PR says plainly which
# assertions were added and which were removed.
FELIX_TEST_MANIFEST="$HERE/assertions.tsv"
FELIX_TEST_RECORD=0
[ "${1:-}" = "--record-assertions" ] && { FELIX_TEST_RECORD=1; shift; }

# Memory has lived outside any checkout since 2026-08-14, so the fixture needs a
# root of its own rather than a directory inside the fixture home.
#
# Exported, and that is not a detail. This suite drives the real CLI and the real
# hooks as child processes; an unexported value would leave every one of them
# resolving felix_mem_root to the default and writing the fixture's invented
# projects into the developer's own memory — which is both a corrupted test and
# a corrupted record, and neither would announce itself.
MEM="$TMP/memory"
export FELIX_MEMORY="$MEM"
mkdir -p "$MEM"

# Every lib that writes memory calls felix_mem_dir, which resolve.sh defines and
# which the CLI and both hooks always source first. The subshells below source
# one lib at a time, so without this they run under a load order production
# never has. Worth stating because of how that fails: bash reports "command not
# found" on stderr, the append is redirected to /dev/null, and the assertion
# then reads as "memory was not written" — a wrong answer about the code rather
# than about the test. Functions defined here are inherited by every subshell.
. "$REAL_HARNESS/lib/resolve.sh"

# ---------------------------------------------------------------- fixture ----
# A Felix root with the real harness and one invented project.
FROOT="$TMP/felix"
mkdir -p "$FROOT/projects/widget" "$MEM/widget"
cp -R "$REAL_HARNESS" "$FROOT/harness"

cat > "$FROOT/projects/widget/project.json" <<'EOF'
{
  "name": "widget",
  "remote_match": "example.com/widget",
  "gate": "sh -c 'test -f WIDGET.txt && echo widget-gate-ran'"
}
EOF
printf '# widget\n' > "$FROOT/projects/widget/CLAUDE.md"

FELIX="$FROOT/harness/felix"
# Pin the home. Resolution consults ~/.felix-home, so without this the suite
# runs against whatever the machine has installed, writes test projects into it,
# and reports failures about the wrong tree. Observed exactly that.
export FELIX_HOME="$FROOT"

# A checkout with NO git remote, bound by marker file alone.
REPO="$TMP/some-customer-repo"
mkdir -p "$REPO/deep/nested"
( cd "$REPO" && git init -q -b main )
# macOS resolves /var to /private/var, and git reports the resolved path. Compare
# against what the filesystem actually calls this directory, not what mktemp said.
REPO="$(cd "$REPO" && pwd -P)"
printf 'widget\n' > "$REPO/.felix"
printf 'contents\n'  > "$REPO/WIDGET.txt"

printf '\nresolution\n'
out="$(cd "$REPO" && "$FELIX" which 2>&1)"
has "resolves via .felix marker with no remote" "$out" "project:      widget"
has "reports the governed tree"                 "$out" "governs:      $REPO"

out="$(cd "$REPO/deep/nested" && "$FELIX" which 2>&1)"
has "resolves from a nested subdirectory" "$out" "project:      widget"

printf '\ngate execution\n'
out="$(cd "$REPO/deep/nested" && "$FELIX" gate 2>&1)"; rc=$?
is  "passing gate exits 0" "$rc" "0"
has "gate command actually ran" "$out" "widget-gate-ran"

# The gate must run against the checkout it was pointed at, not against Felix.
# A gate that inspects its own directory returns a verdict about the wrong code.
rm "$REPO/WIDGET.txt"
out="$(cd "$REPO" && "$FELIX" gate 2>&1)"; rc=$?
[ "$rc" -ne 0 ] && ok "failing gate propagates non-zero exit" \
                || bad "failing gate propagates non-zero exit" "got 0, a gate that cannot fail is not a gate"
printf 'contents\n' > "$REPO/WIDGET.txt"

printf '\nungoverned directories\n'
PLAIN="$TMP/unrelated"; mkdir -p "$PLAIN"; ( cd "$PLAIN" && git init -q -b main )
out="$(cd "$PLAIN" && "$FELIX" gate 2>&1)"; rc=$?
is  "ungoverned repo refuses to run a gate" "$rc" "2"
has "and says which projects it knows"      "$out" "Known projects:"

printf '\nsession hook\n'
out="$(cd "$REPO" && CLAUDE_PLUGIN_ROOT="$FROOT" "$FROOT/harness/hooks/session-start" 2>&1)"
has "hook binds the invented project" "$out" "Project: widget"
case "$out" in
  *'"hookSpecificOutput"'*) ok "hook emits Claude Code shape as a plugin" ;;
  *) bad "hook emits Claude Code shape as a plugin" "$out" ;;
esac

# A governed project's constitution lives in Felix's home, not the repository,
# so nothing auto-loads it and naming it is the entire delivery mechanism. This
# was masked inside Felix itself, where the file happens to sit in the tree
# being edited, and not masked at all anywhere else.
has "the hook says what must be read first" "$out" "Read before planning"

# The hook must actually be able to call what it reports on. A missing source
# line makes tidy and retire silent rather than broken, which is the shape of
# every "passes by finding nothing" bug this project has paid for.
for _fn in felix_tidy_safe felix_ledger_retire felix_autonomy_allows; do
  ( . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/detect.sh"
    . "$FROOT/harness/lib/autonomy.sh"; . "$FROOT/harness/lib/ledger.sh"
    command -v "$_fn" >/dev/null 2>&1 ) \
    && ok "$_fn is defined for the hook" || bad "$_fn is defined for the hook"
  grep -q "lib/${_fn#felix_}" /dev/null 2>&1 || true
done
for _lib in autonomy ledger; do
  grep -q "lib/${_lib}.sh" "$FROOT/harness/hooks/session-start" \
    && ok "session-start sources ${_lib}.sh" \
    || bad "session-start sources ${_lib}.sh" "it would fail silently"
done
printf '# handoff\n' > "$REPO/HANDOFF.md"
out="$(cd "$REPO" && CLAUDE_PLUGIN_ROOT="$FROOT" "$FROOT/harness/hooks/session-start" 2>&1)"
has "and names a handoff when the repo has one" "$out" "HANDOFF.md"
rm -f "$REPO/HANDOFF.md"
out="$(cd "$REPO" && CLAUDE_PLUGIN_ROOT="$FROOT" "$FROOT/harness/hooks/session-start" 2>&1)"
case "$out" in
  *"$REPO/HANDOFF.md"*) bad "and names none when there is none" "$out" ;;
  *)                    ok  "and names none when there is none" ;;
esac

# Felix also installs as a plain settings.json hook, where CLAUDE_PLUGIN_ROOT is
# unset. Emitting the wrong shape there injects nothing and fails silently.
out="$(cd "$REPO" && env -u CLAUDE_PLUGIN_ROOT "$FROOT/harness/hooks/session-start" 2>&1)"
case "$out" in
  *'"hookSpecificOutput"'*) ok "hook emits Claude Code shape without plugin env" ;;
  *) bad "hook emits Claude Code shape without plugin env" "$out" ;;
esac
out_json="$(printf '%s' "$out" | python3 -c 'import json,sys; print(json.load(sys.stdin)["hookSpecificOutput"]["additionalContext"][:20])' 2>&1)"
has "and that output is valid JSON" "$out_json" "Felix governs"

out="$(cd "$PLAIN" && CLAUDE_PLUGIN_ROOT="$FROOT" "$FROOT/harness/hooks/session-start" 2>&1)"; rc=$?
is "hook silent in ungoverned repo" "${#out}" "0"
is "hook still exits 0 there"       "$rc" "0"

printf '\nonboarding a stranger project\n'
# The claim under test: someone who downloads Felix gets what Elenchus got,
# without hand-writing any of it. A Node app with no git remote, nothing to do
# with anything already here.
STRANGE="$TMP/stranger"
mkdir -p "$STRANGE"
( cd "$STRANGE" && git init -q -b main )
cat > "$STRANGE/package.json" <<'JSON'
{ "name": "stranger", "scripts": { "verify": "echo ok" },
  "dependencies": { "express": "^4", "stripe": "^17" },
  "devDependencies": { "playwright": "^1" } }
JSON

out="$(cd "$STRANGE" && "$FELIX" new stranger 2>&1)"; rc=$?
is  "felix new exits 0"            "$rc" "0"
has "detects from their manifest"  "$out" "billing"
has "guesses their gate"           "$out" "npm run verify"

SP="$FROOT/projects/stranger"
for f in project.json capabilities stack.tsv profiles.tsv setup.tsv CLAUDE.md; do
  [ -f "$SP/$f" ] && ok "seeded $f" || bad "seeded $f"
done
[ -s "$SP/setup/stripe.md" ] && ok "copied the runbook their stack implies" \
                             || bad "copied the runbook their stack implies"
[ -f "$SP/setup/sentry.md" ] && bad "skips runbooks for absent capabilities" \
                             || ok "skips runbooks for absent capabilities"
[ -f "$STRANGE/.felix" ] && ok "binds the checkout with no remote" \
                         || bad "binds the checkout with no remote"

out="$(cd "$STRANGE" && "$FELIX" which 2>&1)"
has "governs them immediately" "$out" "project:      stranger"
# The guess was already asserted above. Executing it should test that Felix runs
# a project's declared gate, not that npm happens to be installed on this
# machine, so the declared command is swapped for a shell-native one.
python3 - "$SP/project.json" <<'PYJ'
import json,sys,pathlib
p=pathlib.Path(sys.argv[1]); d=json.loads(p.read_text())
d["gate"]="sh -c 'test -f package.json'"
p.write_text(json.dumps(d,indent=2))
PYJ
out="$(cd "$STRANGE" && "$FELIX" gate 2>&1)"; rc=$?
is "their declared gate runs and passes" "$rc" "0"

# High risk must stay blocked for a stranger exactly as it does for us.
out="$(cd "$STRANGE" && "$FELIX" stack plan 2>&1)"
case "$out" in
  *"blocked"*"stripe"*) ok "their high-risk rows are blocked too" ;;
  *) bad "their high-risk rows are blocked too" "$out" ;;
esac

out="$("$FELIX" new stranger 2>&1)"; rc=$?
[ "$rc" -ne 0 ] && ok "refuses to clobber an existing project" \
                || bad "refuses to clobber an existing project"

printf '\ncapability detection\n'
# The scenario the founder asked for: a surface that does not exist today, and
# the day it appears Felix notices without anyone remembering to look.
out="$(cd "$REPO" && "$FELIX" doctor 2>&1)"
case "$out" in
  *"undeclared:   none"*) ok "clean project reports no drift" ;;
  *) bad "clean project reports no drift" "$out" ;;
esac

printf 'sentry-sdk>=2.0\n' > "$REPO/requirements.txt"
out="$(cd "$REPO" && "$FELIX" doctor 2>&1)"
has "adding sentry surfaces observability" "$out" "observability"
has "and explains why it now matters"      "$out" "incident loop"

printf 'FROM python:3.12\n' > "$REPO/Dockerfile"
out="$(cd "$REPO" && "$FELIX" doctor 2>&1)"
has "adding a Dockerfile surfaces deploy" "$out" "deploy"

out="$(cd "$REPO" && "$FELIX" doctor 2>&1)"; rc=$?
is "doctor exits 0 despite drift" "$rc" "0"

# Adopting must also pull in what the capability implies. Recording it and
# stopping was the original bug: the checklist looked complete while the tooling
# and human steps stayed invisible.
cp "$REAL_HARNESS/templates/setup.tsv" /dev/null 2>/dev/null || true
before_stack="$(cat "$FROOT/projects/widget/stack.tsv" 2>/dev/null | wc -l)"
before_setup="$(cat "$FROOT/projects/widget/setup.tsv" 2>/dev/null | wc -l)"
out="$(cd "$REPO" && "$FELIX" adopt observability 2>&1)"
has "adopting reports the backfill" "$out" "backfilled"
after_stack="$(cat "$FROOT/projects/widget/stack.tsv" 2>/dev/null | wc -l)"
after_setup="$(cat "$FROOT/projects/widget/setup.tsv" 2>/dev/null | wc -l)"
[ "$after_stack" -gt "$before_stack" ] && ok "backfilled the tooling the capability implies" \
                                       || bad "backfilled the tooling the capability implies" "stack.tsv unchanged"
[ "$after_setup" -gt "$before_setup" ] && ok "backfilled the human steps it implies" \
                                       || bad "backfilled the human steps it implies" "setup.tsv unchanged"
[ -f "$FROOT/projects/widget/setup/sentry.md" ] && ok "copied the runbook it implies" \
                                                || bad "copied the runbook it implies"
out="$(cd "$REPO" && "$FELIX" adopt observability 2>&1)"
has "adopting twice is a no-op" "$out" "already declared"
out="$(cd "$REPO" && "$FELIX" doctor 2>&1)"
case "$out" in
  *"undeclared:   deploy"*) ok "adopting removes it from drift" ;;
  *) bad "adopting removes it from drift" "$out" ;;
esac
rm -f "$REPO/requirements.txt" "$REPO/Dockerfile"

printf '\nrival gates\n'
# From a real failure. An untracked, day-stale, strictly weaker copy of the gate
# sat inside the governed repo, and it was the file physically in front of any
# session that looked around. A session ran it all day and reported green from a
# gate missing a check. A gate with a lookalike is not a gate; it is a coin flip
# on which file somebody reaches for, and the wrong side reports success.
out="$(cd "$REPO" && "$FELIX" doctor 2>&1)"
case "$out" in
  *rival*) bad "a clean checkout claims no rival gate" "$out" ;;
  *)       ok  "a clean checkout claims no rival gate" ;;
esac

mkdir -p "$REPO/scripts"
printf '#!/bin/sh\npass format\npass lint\n' > "$REPO/scripts/gate.sh"
chmod +x "$REPO/scripts/gate.sh"
out="$(cd "$REPO" && "$FELIX" doctor 2>&1)"
has "a lookalike gate is reported"   "$out" "scripts/gate.sh"
has "and whether git tracks it"      "$out" "untracked"

# Not executable is not a gate. Without this the check flags every README that
# happens to have the word in its name.
printf '#!/bin/sh\n' > "$REPO/scripts/verify-notes.sh"
out="$(cd "$REPO" && "$FELIX" doctor 2>&1)"
case "$out" in
  *verify-notes*) bad "a non-executable lookalike is ignored" "$out" ;;
  *)              ok  "a non-executable lookalike is ignored" ;;
esac

out="$(cd "$REPO" && "$FELIX" doctor 2>&1)"; rc=$?
is "reporting a rival gate still exits 0" "$rc" "0"

# Matching on the name gate|verify|check missed the second instance of the same
# trap the day the first was deleted: prepush.sh, an untracked repo copy of a
# file Felix holds, identical that morning and free to drift by the afternoon.
# The name was never the point. Felix holding the authoritative copy is.
printf '#!/bin/sh\necho felix copy\n' > "$FROOT/projects/widget/prepush.sh"
chmod +x "$FROOT/projects/widget/prepush.sh"
printf '#!/bin/sh\necho repo copy\n' > "$REPO/scripts/prepush.sh"
chmod +x "$REPO/scripts/prepush.sh"
out="$(cd "$REPO" && "$FELIX" doctor 2>&1)"
has "a repo copy of a file Felix holds is reported" "$out" "prepush.sh"

# ...and a name Felix does not hold is still nobody's business.
printf '#!/bin/sh\n' > "$REPO/scripts/deploy-thing.sh"
chmod +x "$REPO/scripts/deploy-thing.sh"
out="$(cd "$REPO" && "$FELIX" doctor 2>&1)"
case "$out" in
  *deploy-thing*) bad "an unrelated executable is left alone" "$out" ;;
  *)              ok  "an unrelated executable is left alone" ;;
esac
rm -f "$FROOT/projects/widget/prepush.sh"
rm -rf "$REPO/scripts"

# Felix's own per-project storage, seen from a worktree of Felix.
#
# The guard for that storage was a path-prefix test — "does this file live under
# $FELIX_HOME_DIR/projects/" — and in a worktree it never matches, because the
# root is the worktree and the home is still the main checkout. So `felix doctor`
# reported every governed project's stored gate as a rival gate, under a banner
# saying whichever one a session reaches for decides what green means. It also
# called `projects/elenchus/gate.sh` "differs from the copy Felix holds", having
# compared it against `projects/felix/gate.sh` on the strength of a shared
# basename, while it was byte-identical to the copy Felix actually holds for
# Elenchus. A tool whose job is finding drift, inventing drift.
#
# The fix is an identity test on the repository rather than on the path string:
# a worktree and its main checkout share one `--git-common-dir`, so "is this
# checkout Felix" survives being somewhere else. Worktrees are how work happens
# here — issue #2 records that `felix merge` is unreachable from one — so a
# guard that silently lapses there is a guard for the case that does not arise.
RH="$TMP/felixhome"; mkdir -p "$RH/projects/p1" "$RH/projects/p2"
( cd "$RH" && git init -q -b main )
RH="$(cd "$RH" && pwd -P)"
printf '#!/bin/sh\necho p1\n' > "$RH/projects/p1/gate.sh"
printf '#!/bin/sh\necho p2\n' > "$RH/projects/p2/gate.sh"
chmod +x "$RH/projects/p1/gate.sh" "$RH/projects/p2/gate.sh"
printf '{"name":"p1","gate":"gate.sh"}\n' > "$RH/projects/p1/project.json"
( cd "$RH" && git add -A >/dev/null 2>&1 \
  && git -c user.name=t -c user.email=t@t commit -qm home >/dev/null 2>&1 )
RW="$TMP/felixwork"
( cd "$RH" && git worktree add -q -b wt "$RW" >/dev/null 2>&1 )
RW="$(cd "$RW" && pwd -P)"

_riv() { ( . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/detect.sh"
           FELIX_HOME_DIR="$RH" _felix_rival_gates "$1" "$RH/projects/p1" "gate.sh" ); }

case "$(_riv "$RH")" in
  *projects/p2/gate.sh*) bad "the main checkout knows its own storage is not a rival" "$(_riv "$RH")" ;;
  *)                     ok  "the main checkout knows its own storage is not a rival" ;;
esac
case "$(_riv "$RW")" in
  *projects/p2/gate.sh*) bad "and so does a worktree of it" "$(_riv "$RW")" ;;
  *)                     ok  "and so does a worktree of it" ;;
esac
# The guard must stay narrow: a genuinely unrelated repo that happens to have a
# projects/ directory is not Felix, and its lookalikes are still reported.
OTHER="$TMP/notfelix"; mkdir -p "$OTHER/projects/p2"
( cd "$OTHER" && git init -q -b main )
OTHER="$(cd "$OTHER" && pwd -P)"
printf '#!/bin/sh\necho other\n' > "$OTHER/projects/p2/gate.sh"
chmod +x "$OTHER/projects/p2/gate.sh"
( cd "$OTHER" && git add -A >/dev/null 2>&1 \
  && git -c user.name=t -c user.email=t@t commit -qm other >/dev/null 2>&1 )
has "a different repository is still checked" "$(_riv "$OTHER")" "projects/p2/gate.sh"

# The assertions below shell out to `claude plugin list` and `claude mcp list`.
# The latter performs live health checks, so they are network-dependent and can
# flake: one spurious failure was observed in a run that passed three times
# either side. Resolution, detection, classification and pipefail safety are all
# offline and deterministic. Only presence checks against real installs are not,
# so a lone failure here is worth re-running before believing.
printf '\nthe hook adopts rather than nags\n'
# A surface detected and left undeclared stays unhandled for as long as nobody
# reads the message. The hook closes that itself.
HOOKREPO="$TMP/hookrepo"; mkdir -p "$HOOKREPO"
( cd "$HOOKREPO" && git init -q -b main )
printf 'hookproj\n' > "$HOOKREPO/.felix"
mkdir -p "$FROOT/projects/hookproj" "$MEM/hookproj"
printf '{"name":"hookproj","gate":"true"}\n' > "$FROOT/projects/hookproj/project.json"
printf '# h\n' > "$FROOT/projects/hookproj/CLAUDE.md"

out="$(cd "$HOOKREPO" && CLAUDE_PLUGIN_ROOT="$FROOT" "$FROOT/harness/hooks/session-start" 2>&1)"
case "$out" in
  *Adopted*) bad "a bare repo has nothing to adopt" "$out" ;;
  *) ok "a bare repo has nothing to adopt" ;;
esac

printf 'sentry-sdk\n' > "$HOOKREPO/requirements.txt"
out="$(cd "$HOOKREPO" && CLAUDE_PLUGIN_ROOT="$FROOT" "$FROOT/harness/hooks/session-start" 2>&1)"
has "the hook announces what it adopted" "$out" "Adopted automatically"
has "and names the capability"           "$out" "observability"
has "and says nothing was installed"     "$out" "Nothing was installed"

# Talking is not the same as doing. The manifests must actually have changed.
grep -qxF observability "$FROOT/projects/hookproj/capabilities" 2>/dev/null \
  && ok "it recorded the capability" || bad "it recorded the capability"
[ -f "$FROOT/projects/hookproj/setup/sentry.md" ] \
  && ok "it copied the runbook the capability implies" \
  || bad "it copied the runbook the capability implies"
grep -q sentry "$FROOT/projects/hookproj/stack.tsv" 2>/dev/null \
  && ok "it appended the tooling row" || bad "it appended the tooling row"

out="$(cd "$HOOKREPO" && CLAUDE_PLUGIN_ROOT="$FROOT" "$FROOT/harness/hooks/session-start" 2>&1)"
case "$out" in
  *Adopted*) bad "it goes quiet once nothing is new" "$out" ;;
  *) ok "it goes quiet once nothing is new" ;;
esac

printf '\nstack provisioning\n'
# Classification is where the safety policy lives, so that is what is asserted.
# These rows never install anything: the two that would are deliberately fake.
{
  printf 'plugin\tsuperpowers@claude-plugins-official\t-\tlow\talways\n'
  printf 'plugin\tfelix-test-absent@nowhere\t-\tlow\tbilling\n'
  printf 'plugin\tfelix-test-dangerous@nowhere\t-\thigh\talways\n'
} > "$FROOT/projects/widget/stack.tsv"

out="$(cd "$REPO" && "$FELIX" stack plan 2>&1)"
case "$out" in
  *"blocked"*"felix-test-dangerous"*) ok "high risk classifies as blocked" ;;
  *) bad "high risk classifies as blocked" "$out" ;;
esac
case "$out" in
  *"dormant"*"felix-test-absent"*) ok "undeclared capability classifies as dormant" ;;
  *) bad "undeclared capability classifies as dormant" "$out" ;;
esac
if has_claude; then
  has "already-installed rows report present" "$out" "present"
else
  skip "already-installed rows report present" "no claude CLI here"
fi

out="$(cd "$REPO" && "$FELIX" stack apply 2>&1)"
has "apply without --yes changes nothing" "$out" "Nothing changed"

# The safety property: no flag promotes a high-risk row into the apply set.
out="$(cd "$REPO" && "$FELIX" stack apply --yes 2>&1)"
case "$out" in
  *"installed  plugin felix-test-dangerous"*)
    bad "--yes never installs high risk" "high-risk row was applied" ;;
  *) ok "--yes never installs high risk" ;;
esac
has "and says why it was left alone" "$out" "No flag installs those"

printf '\nprofiles\n'
printf 'core\talways\nbilling\tbilling\n' > "$FROOT/projects/widget/profiles.tsv"
out="$(cd "$REPO" && "$FELIX" profile core 2>&1)"
has "core profile mounts unconditional rows" "$out" "superpowers"
case "$out" in

PYJ
( cd "$REPO" && "$FELIX" gate >/dev/null 2>&1 ); rc=$?
is "a failing gate still exits non-zero" "$rc" "1"
[ -f "$MISLOG" ] && ok "and records the failure without being asked" \
                 || bad "and records the failure without being asked"
grep -q 'lint' "$MISLOG" 2>/dev/null \
  && ok "naming which check failed" || bad "naming which check failed"

( cd "$REPO" && "$FELIX" gate >/dev/null 2>&1 )
out="$(cd "$REPO" && "$FELIX" promote 2>&1)"
has "twice makes it a promotion candidate" "$out" "the gate keeps catching"
has "and names the habit"                  "$out" "lint"

# A check that could not have passed did not catch anything.
#
# Felix's `installed` check compares the tree against the deployed plugin cache.
# In a worktree that can never match — the marketplace is pinned to one path, so
# a worktree's engine is not the one being served — and every gate run there
# recorded `installed` as a mistake. The count went 9 to 11 during the session
# that fixed the recurrence report, and it sat at the top of `felix next` rank 5
# under "already cost time more than once", where the advice is to go and build
# a mechanism. The check manufactured the evidence that ranked it.
#
# The verdict is deliberately NOT changed: the gate still fails, because the
# tree genuinely does not match, and loosening a gate to quiet a report is the
# move this project warns about in the definition of its own objective. Only the
# RECORD changes. A gate may mark a failure as a property of where it ran rather
# than of the work, and the engine subtracts those from what it writes down
# without learning any check's name — the project's own gate declares it.
cat > "$FROOT/projects/widget/structural-gate.sh" <<'GS'
#!/usr/bin/env bash
echo "  lint               FAIL"
echo "  deployed           FAIL (structural: this tree is not the one that deploys)"
exit 1
GS
chmod +x "$FROOT/projects/widget/structural-gate.sh"
python3 - "$FROOT/projects/widget/project.json" <<'PYJ'
import json,sys,pathlib
p=pathlib.Path(sys.argv[1]); d=json.loads(p.read_text())
d["gate"]="structural-gate.sh"; p.write_text(json.dumps(d,indent=2))
PYJ
: > "$MISLOG"
( cd "$REPO" && "$FELIX" gate >/dev/null 2>&1 ); rc=$?
is "a structural failure still fails the gate" "$rc" "1"
grep -q 'lint' "$MISLOG" 2>/dev/null \
  && ok "an ordinary failure is still written down" \
  || bad "an ordinary failure is still written down" "$(cat "$MISLOG")"
grep -q 'deployed' "$MISLOG" 2>/dev/null \
  && bad "but one that could not have passed is not" "$(cat "$MISLOG")" \
  || ok  "but one that could not have passed is not"

# And when EVERY failure was structural, nothing is written — not even the
# exit-status fallback. The first version of this fixed the named check and then
# recorded `exit-1` instead, which is the same permanent row wearing a less
# informative name. Caught by running the real gate in a real worktree, which is
# where the case lives; the suite had passed.
cat > "$FROOT/projects/widget/structural-gate.sh" <<'GS'
#!/usr/bin/env bash
echo "  deployed           FAIL (structural: this tree is not the one that deploys)"
exit 1
GS
: > "$MISLOG"
( cd "$REPO" && "$FELIX" gate >/dev/null 2>&1 ); rc=$?
is "an all-structural gate still fails"           "$rc" "1"
is "and writes no row at all, not even exit-1"    "$(wc -l < "$MISLOG" | tr -d ' ')" "0"

# A gate that names nothing still falls back, because then the status is all
# anybody knows.
cat > "$FROOT/projects/widget/structural-gate.sh" <<'GS'
#!/usr/bin/env bash
echo "something went wrong but no check is named"
exit 3
GS
: > "$MISLOG"
( cd "$REPO" && "$FELIX" gate >/dev/null 2>&1 )
grep -q 'exit-3' "$MISLOG" 2>/dev/null \
  && ok "a gate naming no check still records its status" \
  || bad "a gate naming no check still records its status" "$(cat "$MISLOG")"

# A passing gate must not record anything, or the signal is just a run counter.
python3 - "$FROOT/projects/widget/project.json" <<'PYJ'
import json,sys,pathlib
p=pathlib.Path(sys.argv[1]); d=json.loads(p.read_text())
d["gate"]="true"; p.write_text(json.dumps(d,indent=2))
PYJ
before="$(wc -l < "$MISLOG")"
( cd "$REPO" && "$FELIX" gate >/dev/null 2>&1 )
is "a passing gate records nothing" "$(wc -l < "$MISLOG")" "$before"

printf '\ngenerated constitution\n'
CDIR="$FROOT/projects/stranger"
[ -s "$CDIR/CLAUDE.md" ] && ok "onboarding writes one" || bad "onboarding writes one"
has "it names the verification command" "$(cat "$CDIR/CLAUDE.md")" "felix gate"
has "and what was detected"             "$(cat "$CDIR/CLAUDE.md")" "billing"
# The invariants are the part that cannot be generated, and the file says why
# rather than pretending or leaving a bare TODO.
has "invariants say where they come from" "$(cat "$CDIR/CLAUDE.md")" "earned rather"
case "$(cat "$CDIR/CLAUDE.md")" in
  *"Replace this"*) bad "no placeholder telling someone to write it" "still a stub" ;;
  *) ok "no placeholder telling someone to write it" ;;
esac

printf '\nlessons are mounted, not offered\n'
cat > "$MEM/widget/lessons.md" <<'LES'
# widget lessons

## Checklist
1. run the gate
2. update the devlog

## Seeded principles
- **L-1 Migrations need a rollback path.** Long evidence about a migration that
  went wrong, with detail nobody needs mounted on every single turn.
- **L-2 Browser tests belong on critical flows.** More evidence, equally long,
  equally irrelevant until someone is actually touching the browser layer.
LES

out="$(cd "$REPO" && "$FELIX" lessons --for "changing a migration" 2>&1)"
has "matches the relevant lesson"   "$out" "L-1"
case "$out" in *"L-2"*) bad "and not the irrelevant one" "$out" ;; *) ok "and not the irrelevant one" ;; esac
has "the always-applicable part is shown" "$out" "run the gate"

# The evidence is why a lesson is believed; the claim is what needs mounting.
# Injecting the evidence every turn is how a helpful injection becomes ignored.
case "$out" in
  *"Long evidence about"*) bad "only the claim is mounted, not the evidence" "$out" ;;
  *) ok "only the claim is mounted, not the evidence" ;;
esac

out="$(cd "$REPO" && "$FELIX" lessons --for "unrelated quantum teleportation" 2>&1)"
has "an unrelated context matches nothing" "$out" "nothing matched"

printf '\nthe prompt hook\n'
HK="$FROOT/harness/hooks/user-prompt"
out="$(cd "$REPO" && printf '{"prompt":"fix the migration rollback"}' | "$HK" 2>&1)"
case "$out" in
  *'"hookSpecificOutput"'*) ok "emits the documented UserPromptSubmit shape" ;;
  *) bad "emits the documented UserPromptSubmit shape" "$out" ;;
esac
ctx="$(printf '%s' "$out" | python3 -c 'import json,sys; print(json.load(sys.stdin)["hookSpecificOutput"]["additionalContext"])' 2>&1)"
has "carries the matched lesson" "$ctx" "L-1"
# Bounded. A hook that floods the turn is a hook people learn to skim past.
lines="$(printf '%s\n' "$ctx" | wc -l | tr -d ' ')"
[ "$lines" -le 20 ] && ok "and stays small" \
                    || bad "and stays small" "$lines lines is too much for every turn"

out="$(cd "$PLAIN" && printf '{"prompt":"anything"}' | "$HK" 2>&1)"; rc=$?
is "silent in an ungoverned repo" "${#out}" "0"
is "and exits 0 there"            "$rc" "0"

mv "$MEM/widget/lessons.md" "$TMP/lessons.bak"
out="$(cd "$REPO" && printf '{"prompt":"fix the migration"}' | "$HK" 2>&1)"
is "silent when a project has no lessons yet" "${#out}" "0"
mv "$TMP/lessons.bak" "$MEM/widget/lessons.md"

printf '\npipefail safety\n'
# Regression. Every presence check used to be `producer | grep -q x`, which under
# `set -o pipefail` reports 141 because grep exits on match and the producer takes
# SIGPIPE. The check then says absent about something present, and it is
# timing-dependent, so small producers pass and a real repository fails.
big="$(seq 1 200000)"
# Deliberately not asserting that `producer | grep -q x` fails here. It fails
# only when the producer is still writing when grep exits, so the assertion is a
# race and flakes. The reason the helpers exist is recorded above instead.
if ( set -uo pipefail
     . "$FROOT/harness/lib/resolve.sh"
     felix_contains "$big" "199999" ); then
  ok "felix_contains survives a large haystack under pipefail"
else
  bad "felix_contains survives a large haystack under pipefail"
fi
if ( set -uo pipefail
     . "$FROOT/harness/lib/resolve.sh"
     felix_has_line "$big" "199999" ) ; then
  ok "felix_has_line matches whole lines under pipefail"
else
  bad "felix_has_line matches whole lines under pipefail"
fi
if ( set -uo pipefail
     . "$FROOT/harness/lib/resolve.sh"
     felix_has_line "alpha
beta" "alph" ); then
  bad "felix_has_line rejects partial lines" "matched a prefix"
else
  ok "felix_has_line rejects partial lines"
fi

printf '\nthe completion gate\n'
# The principle under test: an agent must not be able to say it is finished
# while the tree it changed has never been verified. Everything here drives the
# real Stop hook with real JSON on stdin, against a real git repository.
STOP="$FROOT/harness/hooks/stop"
# Earlier sections rewrite the widget gate to prove other things, so this one
# declares the gate it depends on instead of inheriting whatever ran last.
# Without this the red-gate case silently tests a gate of `true`, which cannot
# fail, and the failure reads like a product bug rather than a suite bug.
cat > "$FROOT/projects/widget/project.json" <<'EOF'
{
  "name": "widget",
  "remote_match": "example.com/widget",
  "gate": "sh -c 'test -f WIDGET.txt && echo widget-gate-ran'"
}
EOF
GREPO="$TMP/gaterepo"
mkdir -p "$GREPO"
( cd "$GREPO" && git init -q -b main
  printf 'contents\n' > WIDGET.txt
  printf 'widget\n'   > .felix
  git add -A >/dev/null 2>&1
  git -c user.name=t -c user.email=t@t commit -qm init >/dev/null 2>&1 )
GREPO="$(cd "$GREPO" && pwd -P)"

EMPTY_JSON='{"hook_event_name":"Stop","stop_hook_active":false}'
ACTIVE_JSON='{"hook_event_name":"Stop","stop_hook_active":true}'
_stop() { ( cd "$1" && printf '%s' "${2:-$EMPTY_JSON}" | "$STOP" 2>&1 ); }
_blocks() {
  case "$2" in *'"decision"'*'"block"'*) ok "$1" ;; *) bad "$1" "expected a block, got [$2]" ;; esac
}
_allows() { [ -z "$2" ] && ok "$1" || bad "$1" "expected silence, got [$2]"; }

out="$(_stop "$GREPO")"; rc=$?
_allows "a session that changed nothing stops silently" "$out"
is      "and exits 0"                                   "$rc" "0"

# The guidebook states DEFINITION OF DONE absolutely: never declare a task
# complete while a required deterministic verification step is failing. The hook
# opened with a bare `felix_tree_dirty || exit 0`, so committing your work
# skipped the check entirely — and committing is what you do at the end. Every
# session that finished properly was the one never asked.
#
# "Dirty" was standing in for "this session changed something", and those come
# apart the moment anybody commits. SessionStart now records the HEAD it saw, so
# the two can be told apart.
SESS='{"hook_event_name":"Stop","stop_hook_active":false,"session_id":"dod-sess"}'
# Laid by the real hook rather than hand-written, so the test exercises the
# path that actually runs. UserPromptSubmit carries the session id;
# SessionStart never reads its payload at all.
_start_at() {
  rm -f "$FROOT/state/session/dod-sess"
  ( cd "$1" && printf '{"session_id":"dod-sess","prompt":"begin"}' \
      | "$FROOT/harness/hooks/user-prompt" >/dev/null 2>&1 )
}

_start_at "$GREPO"
out="$(_stop "$GREPO" "$SESS")"
_allows "a recorded session that committed nothing is still silent" "$out"

printf 'committed work\n' >> "$GREPO/WIDGET.txt"
( cd "$GREPO" && git add -A >/dev/null 2>&1 \
  && git -c user.name=t -c user.email=t@t commit -qm work >/dev/null 2>&1 )
out="$(_stop "$GREPO" "$SESS")"
_blocks "committing unverified work no longer skips the check" "$out"
has     "and says the gate has not seen it"                    "$out" "gate"

# Fail open when there is no record: a session that began before this shipped,
# or one whose id could not be read, must not start blocking on a clean tree.
out="$(_stop "$GREPO" "$EMPTY_JSON")"
_allows "with no session record it behaves as before" "$out"
rm -f "$FROOT/state/session/dod-sess"

# Restore the fixture for the assertions below, which expect an unverified edit.
( cd "$GREPO" && git reset -q --hard HEAD~1 )

printf 'edited\n' >> "$GREPO/WIDGET.txt"
out="$(_stop "$GREPO")"
_blocks "an unverified change blocks completion" "$out"
has     "and says the gate never ran"            "$out" "never"

out="$(cd "$GREPO" && "$FELIX" gate 2>&1)"
out="$(_stop "$GREPO")"
_allows "a green gate on this exact tree allows it" "$out"

# A green gate proves the suite passed and nothing about the claims made on the
# way there. Those are what go wrong: work reported as fixed that reached no
# session, a tool reported as removed that was still installed, a document
# describing a capability the thing had outgrown. All three passed a gate.
printf 'plugin\tsuperpowers@x\t-\tlow\talways\n' > "$FROOT/projects/widget/stack.tsv"
rm -rf "$FROOT/state/verified"
out="$(cd "$GREPO" && printf '{"hook_event_name":"Stop","stop_hook_active":false,"session_id":"vsess"}' \
       | "$STOP" 2>&1)"
has "a green gate still asks for verification" "$out" "verification-before-completion"
has "and says why the gate is not enough"      "$out" "does not mean"
# Once per session. Said at every stop it becomes noise, and noise is skimmed.
out="$(cd "$GREPO" && printf '{"hook_event_name":"Stop","stop_hook_active":false,"session_id":"vsess"}' \
       | "$STOP" 2>&1)"
case "$out" in
  *verification-before-completion*) bad "and only once per session" "$out" ;;
  *)                                ok  "and only once per session" ;;
esac
# A project that does not use superpowers is not told to reach for it.
printf 'plugin\tsomething-else@x\t-\tlow\talways\n' > "$FROOT/projects/widget/stack.tsv"
rm -rf "$FROOT/state/verified"
out="$(cd "$GREPO" && printf '{"hook_event_name":"Stop","stop_hook_active":false,"session_id":"vsess2"}' \
       | "$STOP" 2>&1)"
case "$out" in
  *verification-before-completion*) bad "and never where it is not declared" "$out" ;;
  *)                                ok  "and never where it is not declared" ;;
esac
rm -rf "$FROOT/state/verified"

# The git-status trap. Two different edits to the same file produce identical
# porcelain output, so a receipt keyed on status alone stays valid across a
# change it never saw. The hash has to include diff content.
printf 'different\n' >> "$GREPO/WIDGET.txt"
out="$(_stop "$GREPO")"
_blocks "editing the same file again invalidates the receipt" "$out"

( cd "$GREPO" && git checkout -q -- WIDGET.txt )
out="$(cd "$GREPO" && "$FELIX" gate 2>&1)"
printf 'new\n' > "$GREPO/untracked.txt"
out="$(_stop "$GREPO")"
_blocks "a new untracked file invalidates the receipt" "$out"
rm -f "$GREPO/untracked.txt"

# The platform caps consecutive blocks and documents the contract: return
# success while stop_hook_active is set. Ignoring it is how a hook loops.
printf 'unverified\n' >> "$GREPO/WIDGET.txt"
out="$(_stop "$GREPO" "$ACTIVE_JSON")"
_allows "stop_hook_active is honoured, so it never loops" "$out"

# The override is the founder's, not the model's: it is read from the
# environment the session was launched with.
out="$(cd "$GREPO" && FELIX_ALLOW_RED=1 printf '%s' "$EMPTY_JSON" | FELIX_ALLOW_RED=1 "$STOP" 2>&1)"
_allows "FELIX_ALLOW_RED lets a founder stop anyway" "$out"

# A failing gate must leave a red receipt, not no receipt. No receipt and a red
# one both block, but only one of them tells the truth about what happened.
rm -f "$GREPO/WIDGET.txt"
out="$(cd "$GREPO" && "$FELIX" gate 2>&1)"
out="$(_stop "$GREPO")"
_blocks "a failing gate still blocks"  "$out"
has     "and says the gate failed"     "$out" "failed"
printf 'contents\n' > "$GREPO/WIDGET.txt"

VLOG="$MEM/widget/verification.log"
[ -s "$VLOG" ] && ok "every decision is recorded" \
               || bad "every decision is recorded" "no verification.log at $VLOG"
if [ -s "$VLOG" ]; then
  grep -q 'blocked'  "$VLOG" && ok "blocks are recorded"    || bad "blocks are recorded"
  grep -q 'override' "$VLOG" && ok "overrides are recorded" || bad "overrides are recorded"
fi

out="$(_stop "$PLAIN")"; rc=$?
_allows "silent in an ungoverned repo" "$out"
is      "and exits 0 there"            "$rc" "0"

NOGIT="$TMP/notgit"; mkdir -p "$NOGIT"; printf 'widget\n' > "$NOGIT/.felix"
out="$(_stop "$NOGIT")"; rc=$?
_allows "silent outside a git repository" "$out"
is      "and exits 0 there too"           "$rc" "0"

# A project that declares no gate has nothing to enforce, and inventing an
# obligation for it would make Felix unusable on a repo mid-onboarding.
mkdir -p "$FROOT/projects/nogate" "$MEM/nogate"
printf '{\n  "name": "nogate"\n}\n' > "$FROOT/projects/nogate/project.json"
NGREPO="$TMP/nogaterepo"; mkdir -p "$NGREPO"
( cd "$NGREPO" && git init -q -b main && printf 'x\n' > a.txt
  git add -A >/dev/null 2>&1 && git -c user.name=t -c user.email=t@t commit -qm i >/dev/null 2>&1 )
printf 'nogate\n' > "$NGREPO/.felix"; printf 'dirty\n' >> "$NGREPO/a.txt"
out="$(_stop "$NGREPO")"
_allows "a project with no declared gate is left alone" "$out"

# Felix governs projects in languages it does not know, and one of their
# untracked directories may be a virtualenv or a model artifact. Metadata only.
mkdir -p "$GREPO/bigdir"
i=0; while [ "$i" -lt 60 ]; do printf 'x\n' > "$GREPO/bigdir/f$i"; i=$((i+1)); done
t0=$(date +%s); out="$(_stop "$GREPO")"; t1=$(date +%s)
[ $((t1-t0)) -le 3 ] && ok "stays fast with many untracked files" \
                     || bad "stays fast with many untracked files" "$((t1-t0))s"
rm -rf "$GREPO/bigdir"

# The gate and the hook compute tree identity independently. If they ever
# disagree the gate silently stops counting, so they must share one function.
tid_lib="$( . "$FROOT/harness/lib/verify.sh"; felix_tree_id "$GREPO" )"
[ -n "$tid_lib" ] && ok "tree identity is computable" \
                  || bad "tree identity is computable" "empty"
printf 'moved\n' >> "$GREPO/WIDGET.txt"
tid2="$( . "$FROOT/harness/lib/verify.sh"; felix_tree_id "$GREPO" )"
[ "$tid_lib" != "$tid2" ] && ok "and changes when the tree changes" \
                          || bad "and changes when the tree changes" "$tid_lib == $tid2"
( cd "$GREPO" && git checkout -q -- WIDGET.txt )

# A repository with no commits at all. HEAD is unborn, and every naive
# implementation of this dies there. The suite's own fixture is in that state.
UNBORN="$TMP/unborn"; mkdir -p "$UNBORN"
( cd "$UNBORN" && git init -q -b main )
printf 'widget\n' > "$UNBORN/.felix"; printf 'x\n' > "$UNBORN/new.txt"
tid3="$( . "$FROOT/harness/lib/verify.sh"; felix_tree_id "$UNBORN" )"
[ -n "$tid3" ] && ok "tree identity survives an unborn HEAD" \
               || bad "tree identity survives an unborn HEAD" "empty"
out="$(_stop "$UNBORN")"; rc=$?
is "and the hook still exits 0 there" "$rc" "0"

# Felix governing itself: the home lives INSIDE the tree being gated, so every
# receipt, verification line and route line lands in the repo it describes.
# Writing a receipt then changes the tree, which invalidates the receipt just
# written, and no gate run can ever produce a valid one. The fixture above hides
# this entirely because there the home sits outside the governed repo — which is
# why this reproduces the real layout instead.
SELF="$TMP/selfgoverned"
mkdir -p "$SELF/projects/self" "$MEM/self" "$SELF/harness"
cp -R "$REAL_HARNESS/." "$SELF/harness/"
cat > "$SELF/projects/self/project.json" <<'EOF'
{ "name": "self", "gate": "true" }
EOF
printf '# self\n' > "$SELF/projects/self/CLAUDE.md"
( cd "$SELF" && git init -q -b main && printf 'x\n' > code.txt && printf 'self\n' > .felix
  git add -A >/dev/null 2>&1
  git -c user.name=t -c user.email=t@t commit -qm i >/dev/null 2>&1 )
SELF="$(cd "$SELF" && pwd -P)"
printf 'real work\n' >> "$SELF/code.txt"
( cd "$SELF" && FELIX_HOME="$SELF" "$SELF/harness/felix" gate >/dev/null 2>&1 )
out="$(cd "$SELF" && FELIX_HOME="$SELF" printf '%s' "$EMPTY_JSON" \
        | FELIX_HOME="$SELF" "$SELF/harness/hooks/stop" 2>&1)"
_allows "a receipt survives being written inside the tree it describes" "$out"
# And a second stop, which appends another verification line, must also pass.
out="$(cd "$SELF" && FELIX_HOME="$SELF" printf '%s' "$EMPTY_JSON" \
        | FELIX_HOME="$SELF" "$SELF/harness/hooks/stop" 2>&1)"
_allows "and keeps surviving as its own log grows" "$out"
# Real work still has to be verified, bookkeeping exemption or not.
printf 'more real work\n' >> "$SELF/code.txt"
out="$(cd "$SELF" && FELIX_HOME="$SELF" printf '%s' "$EMPTY_JSON" \
        | FELIX_HOME="$SELF" "$SELF/harness/hooks/stop" 2>&1)"
_blocks "but a real edit still blocks" "$out"

printf '\nthe same gate, for a subagent\n'
# #83. subagent-stop had NO assertions at all — a risk-red hook that runs in
# every session of every governed project, with nothing holding it. That is why
# both halves of this went unnoticed.
#
# It asks the same question `stop` asks and answers it with a raw
# `git status --porcelain`, where stop uses two helpers written precisely
# because that raw test is wrong in both directions. stop's own comment records
# the diagnosis: "A clean tree used to end the hook here, which meant committing
# your work skipped the completion check entirely — and committing is what you
# do at the end." The fix was never carried across.
SUBSTOP="$FROOT/harness/hooks/subagent-stop"
SUB_SID="sub-session-1"
SUB_JSON="{\"hook_event_name\":\"SubagentStop\",\"session_id\":\"$SUB_SID\"}"
_sub() { ( cd "$1" && FELIX_HOME="$2" printf '%s' "$SUB_JSON" \
           | FELIX_HOME="$2" "$SUBSTOP" 2>&1 ); }
# The matcher is the new sentence's claim — the checkout's state, not the
# subagent's conduct. SubagentStop carries the parent's session id and nothing
# about which subagent finished, so "This subagent changed files" asserted a
# fact the hook cannot know, and was false for every read-only subagent after
# the parent's first commit — 48 of Felix's 136 utterances in five days (#97).
_sub_speaks() { case "$1" in *"no gate has passed on"*) return 0 ;; *) return 1 ;; esac; }

SUBR="$TMP/subrepo"; mkdir -p "$SUBR"
( cd "$SUBR" && git init -q -b main
  printf 'widget\n' > .felix
  printf 'contents\n' > WIDGET.txt
  printf 'x\n' > code.txt
  git add -A; git -c user.name=t -c user.email=t@t commit -qm init ) >/dev/null 2>&1
SUBR="$(cd "$SUBR" && pwd -P)"

# Baseline: a clean tree this session did not touch. Silence is correct, and
# this is the case the raw test got right — kept so a fix cannot buy the two
# below by simply speaking always.
out="$(_sub "$SUBR" "$FROOT")"
_sub_speaks "$out" && bad "an untouched clean tree stays silent" "$out" \
                   || ok  "an untouched clean tree stays silent"

# UNDER-FIRES. The subagent commits its work, which is what you do at the end,
# so the tree is clean and the hook said nothing about an unverified result.
( cd "$SUBR" && printf 'the subagent work\n' >> code.txt
  git add -A; git -c user.name=t -c user.email=t@t commit -qm "subagent work" ) >/dev/null 2>&1
# The mark the user-prompt hook writes at the start of a session, which is what
# makes "this session committed something" answerable at all.
( . "$FROOT/harness/lib/verify.sh"
  felix_session_mark "$FROOT" "$SUB_SID" "$SUBR" ) >/dev/null 2>&1
( cd "$SUBR" && printf 'more\n' >> code.txt
  git add -A; git -c user.name=t -c user.email=t@t commit -qm "more work" ) >/dev/null 2>&1
out="$(_sub "$SUBR" "$FROOT")"
_sub_speaks "$out" && ok  "work the subagent committed is still checked" \
                   || bad "work the subagent committed is still checked" "$out"

# The sentence claims what the hook can know — the checkout — and never the
# subagent's own conduct, which the payload does not carry.
case "$out" in
  *"This subagent changed files"*) bad "and the message does not accuse the subagent" "$out" ;;
  *) ok "and the message does not accuse the subagent" ;;
esac
has "it says the fact it has instead" "$out" "no gate has passed on"

# Once per session, not per agent. Three reviewers after one parent commit got
# three copies of a message that was false for all three; the second telling
# of an unchanged fact is pressure, not information.
out="$(_sub "$SUBR" "$FROOT")"
_sub_speaks "$out" && bad "a second hand-off in the same session stays quiet" "$out" \
                   || ok  "a second hand-off in the same session stays quiet"

# OVER-FIRES, the other direction and the same root cause. Only Felix's own
# bookkeeping changed. felix_tree_dirty excludes it deliberately — "a session
# that appended one line to a log has not changed the work" — and the raw
# status test does not.
#
# Run against the SELF fixture, not the one above, and that is the whole point
# of the case rather than a detail: _felix_tree_excludes returns nothing unless
# the home sits inside the tree being judged. A governed product has its home
# elsewhere and nothing to exclude; Felix governing itself is the layout where
# the exclusion exists and therefore the only layout where ignoring it shows.
# My first attempt used a home with no projects/ at all, so the hook exited on
# an unresolved project and the assertion passed for the wrong reason.
# Committed but deliberately NOT gated. With a green receipt both hooks exit at
# the receipt check and the difference is invisible: felix_tree_id excludes
# bookkeeping too, so appending a log line leaves the receipt valid. The
# over-fire is only reachable on an UNVERIFIED tree, which is exactly the state
# the hook exists to speak about.
( cd "$SELF" && git add -A && git -c user.name=t -c user.email=t@t commit -qm settle ) >/dev/null 2>&1
mkdir -p "$SELF/state"; printf 'a log line\n' >> "$SELF/state/keep.log"
is "the fixture is dirty only in Felix's own bookkeeping" \
   "$( cd "$SELF" && . "$SELF/harness/lib/verify.sh"
       felix_tree_dirty "$SELF" "$SELF" && echo dirty || echo clean )" "clean"
out="$( cd "$SELF" && FELIX_HOME="$SELF" printf '%s' "$SUB_JSON" \
        | FELIX_HOME="$SELF" "$SELF/harness/hooks/subagent-stop" 2>&1 )"
_sub_speaks "$out" && bad "but Felix's own bookkeeping is not the subagent's work" "$out" \
                   || ok  "but Felix's own bookkeeping is not the subagent's work"
rm -rf "$SELF/state"

# And a real uncommitted edit still speaks — in a fresh session, because the
# session above has had its one telling. A new session id is a new parent
# integrating reports, and it has not been told anything yet.
( cd "$SUBR" && printf 'uncommitted real work\n' >> code.txt )
SUB_JSON="{\"hook_event_name\":\"SubagentStop\",\"session_id\":\"sub-session-2\"}"
out="$(_sub "$SUBR" "$FROOT")"
_sub_speaks "$out" && ok  "a real uncommitted edit still speaks, in a fresh session" \
                   || bad "a real uncommitted edit still speaks, in a fresh session" "$out"
( cd "$SUBR" && git checkout -q -- code.txt )
SUB_JSON="{\"hook_event_name\":\"SubagentStop\",\"session_id\":\"$SUB_SID\"}"

printf '\na flag is not a positional\n'

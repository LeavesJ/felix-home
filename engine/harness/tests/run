cp "$TMP/project.wf.keep" "$FROOT/projects/widget/project.json"
unset WFSTUB_LOG WFSTUB_RUNS WFSTUB_WORKFLOWS WFSTUB_PRS
fi

printf '\nthe unattended repair acts only on a brief\n'
# The ceiling above is enforced by felix repair's exit status, and the one
# thing that reads that status in CI is the scope step of
# templates/unattended.yml. It proceeded on everything but 3, so read under
# plain bash, exit 2, CEILING REACHED, still spent the budget and handed a
# model the brief that told it to stop: the ceiling held only as long as a
# model read a sentence. Nothing to repair exited 0 until 2026-09-23, so a
# green branch would have done the same with a brief saying nothing was wrong;
# it exits 5 now.
# The step is taken out of the shipped template as it stands and run against a
# stub felix that exits with each status repair can return, with gh stubbed to
# record what it is asked. Its brief goes to the fixture, not to /tmp. It runs
# under bash -e, as Actions runs a step that names no shell (the shell line of
# every step in a gate run's log). Under plain bash it read every status; under
# -e with pipefail it ended at felix repair's first non-zero one, so the
# escalation asserted below had never run in CI.
SC="$TMP/scope"; mkdir -p "$SC/repo" "$SC/felix/engine/harness" "$SC/bin"
awk '/- name: Scope the failure/ { f = 1 } f && /^        run: \|/ { r = 1; next }
     r && /^      [^ ]/ { exit } r { sub(/^          /, ""); print }' \
  "$REAL_HARNESS/templates/unattended.yml" \
  | sed "s#/tmp/brief.txt#$SC/brief.txt#; s#/tmp/implicated.txt#$SC/implicated.txt#g" > "$SC/step.sh"
# felix repair as the step calls it: --implicated names a file it empties, and
# a brief (0) writes the named files into it. SCOPE_NAMED is that set, and
# SCOPE_NOFILE a Felix from before --implicated, which writes nothing.
cat > "$SC/felix/engine/harness/felix" <<'STUB'
#!/usr/bin/env bash
prev=""
for a in "$@"; do
  if [ "$prev" = "--implicated" ] && [ -z "${SCOPE_NOFILE:-}" ]; then
    : > "$a"
    if [ "${SCOPE_RC:-0}" = "0" ] && [ -n "${SCOPE_NAMED:-}" ]; then
      printf '%s\n' "$SCOPE_NAMED" > "$a"
    fi
  fi
  prev="$a"
done
printf "brief\n"; exit "${SCOPE_RC:-0}"
STUB
printf '#!/usr/bin/env bash\nprintf "%%s\\n" "$*" >> "%s/gh.log"\ncase "$1 $2" in "pr list") printf "7\\n" ;; esac\nexit 0\n' "$SC" > "$SC/bin/gh"
chmod +x "$SC/felix/engine/harness/felix" "$SC/bin/gh"
_scope() { : > "$SC/out"; : > "$SC/gh.log"
  ( cd "$SC/${2:-repo}" && SCOPE_RC="$1" SCOPE_NAMED="${_snamed-src/a.py}" SCOPE_NOFILE="${_snofile:-}" \
      GITHUB_OUTPUT="$SC/out" BRANCH=fix/x PATH="$SC/bin:$PATH" \
      bash -e "$SC/step.sh" ) >/dev/null 2>"$SC/err"; }
_sres=""; _snot=""
for _r in 0 1 2 3 4 5; do
  _scope "$_r"; _src=$?
  _sres="$_sres $_r:$(sed -n 's/^proceed=//p' "$SC/out" | head -1)"
  _snot="$_snot $_r:$(sed -n 's/^nothing=//p' "$SC/out" | head -1)"
  case "$_r" in
    0) _s0brief="$(cat "$SC/brief.txt" 2>/dev/null)"
       _s0set="$(awk '/^implicated<</ { d = substr($0, 13); f = 1; next } f && $0 == d { exit } f' "$SC/out")" ;;
    1) _s1rc="$_src" ;;
    2) _s2gh="$(cat "$SC/gh.log")" ;;
    3) _s3gh="$(cat "$SC/gh.log")" ;;
    5) _s5rc="$_src"; _s5gh="$(cat "$SC/gh.log")"
       _s5p="$(sed -n 's/^proceed=//p' "$SC/out" | head -1)" ;;
  esac
done
is  "the unattended repair proceeds on a brief, and on no other exit of felix repair" "$_sres" " 0:yes 1:no 2:no 3:no 4:no 5:no"
is  "and the brief it proceeds on is the file the repair step hands a model" "$_s0brief" "brief"
# The set goes on as a step output, which nothing after the step can rewrite,
# whatever the model's tools could reach.
is  "and the set it proceeds on is handed on as the step's output" "$_s0set" "src/a.py"
has "a reached repair ceiling is escalated to a person" "$_s2gh" "pr edit 7 --add-label needs-founder"
has "a failure on a red path is escalated to a person" "$_s3gh" "pr edit 7 --add-label needs-founder"
[ "${_s1rc:-0}" -ne 0 ] && ok  "a run felix repair could not read fails the job rather than passing quietly" \
                        || bad "a run felix repair could not read fails the job rather than passing quietly" "exit ${_s1rc:-?}"
[ "${_s5rc:-1}" -eq 0 ] && [ "${_s5p:-}" = "no" ] && [ -z "${_s5gh:-}" ] \
  && ok  "nothing to repair ends the job clean: not acted on, not failed, not escalated" \
  || bad "nothing to repair ends the job clean: not acted on, not failed, not escalated" \
         "exit ${_s5rc:-?}, proceed=${_s5p:-(unset)}, gh asked: ${_s5gh:-nothing}"
# Under the name the report reads: every steps.scope.outputs key the template
# reads is one the step writes, since an output never written reads as empty.
_sread="$(grep -o 'steps\.scope\.outputs\.[a-z_]*' "$REAL_HARNESS/templates/unattended.yml" \
          | sed 's/.*\.//' | sort -u)"
_sunwritten=""
for _k in $_sread; do grep -qE "echo \"$_k(=|<<)" "$SC/step.sh" || _sunwritten="$_sunwritten $_k"; done
[ "$_snot" = " 0: 1: 2: 3: 4: 5:yes" ] && [ -z "$_sunwritten" ] \
  && ok  "and only nothing to repair tells the report so, under the name the report reads" \
  || bad "and only nothing to repair tells the report so, under the name the report reads" \
         "written:$_snot; read and never written:${_sunwritten:- none}"

# A brief that names no file in the checkout. The model would be told to edit
# only the files the brief lists, it lists none, and the verify step refuses
# any other, so every change would be refused after the budget and a model run
# were spent. It stops at scope instead, and without a label: the failure is
# already red on the pull request, and nothing risky is known about it.
_snamed=""; _scope 0; _src=$?; unset _snamed
is  "a brief that names no file stops at scope: not acted on, not failed, not escalated" \
    "exit $_src, proceed=$(sed -n 's/^proceed=//p' "$SC/out" | head -1), unnamed=$(sed -n 's/^unnamed=//p' "$SC/out" | head -1), gh [$(tr '\n' ' ' < "$SC/gh.log")]" \
    "exit 0, proceed=no, unnamed=yes, gh []"
# A Felix that never writes the set, one pinned from before --implicated, with
# a set left over from an earlier run on the same runner. Read as this run's,
# the leftover would hold a repair to files the failing log never named.
printf 'src/a.py\n' > "$SC/implicated.txt"
_snofile=1; _scope 0; _src=$?; unset _snofile
is  "a Felix that writes no implicated set fails the job, and a set left from an earlier run does not stand in" \
    "exit $_src, proceed=$(sed -n 's/^proceed=//p' "$SC/out" | head -1), gh [$(tr '\n' ' ' < "$SC/gh.log")]" \
    "exit 1, proceed=no, gh []"

# The step above branches on felix repair's statuses, and the engine answering
# is whatever the Felix checkout fetched. With no ref that was the default
# branch on the day the job ran, and those statuses changed four times on
# 2026-09-23 under copies that had not changed. The pin is what keeps a copy
# and the engine it reads on the same commit.
_sfx="$(grep -A1 'repository: {{FELIX_REPO}}' "$REAL_HARNESS/templates/unattended.yml" | sed -n 2p)"
is  "the unattended template checks Felix out at a pinned ref, not the default branch" \
    "$(printf '%s' "$_sfx" | tr -d ' ')" "ref:'{{FELIX_REF}}'"

# The two halves together: the real felix repair on a green branch, read by the
# step as shipped. Each half can pass its own assertions while the pair does
# not, as when repair's status and the step's reading of it change apart.
if command -v jq >/dev/null 2>&1; then
  sed "s#\.\./felix/engine/harness/felix#$FELIX#" "$SC/step.sh" > "$SC/step-real.sh"
  printf 'gate.yml\tgate\tfix/y\t211\tcompleted\tsuccess\n' > "$SC/runs"
  : > "$SC/out"
  ( cd "$WFR" && GITHUB_OUTPUT="$SC/out" BRANCH=fix/y WFSTUB_LOG="$SC/wf.log" \
      WFSTUB_RUNS="$SC/runs" WFSTUB_WORKFLOWS="gate.yml" PATH="$WFB:$PATH" \
      bash -e "$SC/step-real.sh" ) >/dev/null 2>&1; _serc=$?
  _sep="$(sed -n 's/^proceed=//p' "$SC/out" | head -1)"
  _sen="$(sed -n 's/^nothing=//p' "$SC/out" | head -1)"
  [ "$_serc" -eq 0 ] && [ "$_sep" = "no" ] && [ "$_sen" = "yes" ] \
    && ok  "a green branch stops the shipped step at scope, read from the real felix repair" \
    || bad "a green branch stops the shipped step at scope, read from the real felix repair" \
           "exit $_serc, proceed=${_sep:-(unset)}, nothing=${_sen:-(unset)}"
else
  skip "a green branch stops the shipped step at scope, read from the real felix repair" \
       "no jq here to evaluate gh's -q expressions"
fi

# A checkout Felix cannot resolve, through the real felix repair rather than a
# stub's chosen status. Resolution exited 2 there, which this step's case read
# as the ceiling and escalated to a person under that reason. It is wiring,
# and true of every branch at once, so the job fails, no pull request is
# labelled, and the message names the binding. Both ways resolution fails: no
# project claims the checkout, and a .felix marker names a project the home
# does not hold.
printf '#!/usr/bin/env bash\nexec "%s" "$@"\n' "$FELIX" > "$SC/felix/engine/harness/felix"
chmod +x "$SC/felix/engine/harness/felix"
mkdir -p "$SC/unbound" "$SC/misbound"
( cd "$SC/unbound" && git init -q -b main )
( cd "$SC/misbound" && git init -q -b main && printf 'nonexistent\n' > .felix )
for _w in unbound misbound; do
  _scope 0 "$_w"; _src=$?
  _sgot="exit $_src, proceed=$(sed -n 's/^proceed=//p' "$SC/out" | head -1), gh [$(tr '\n' ' ' < "$SC/gh.log")]"
  is  "the unattended job on the $_w checkout fails and labels no pull request" \
      "$_sgot" "exit 1, proceed=no, gh []"
  case "$(cat "$SC/err")" in
    *ceiling*) bad "and the $_w job says the binding failed, not the ceiling" "$(cat "$SC/err")" ;;
    *"governs this repository"*) ok "and the $_w job says the binding failed, not the ceiling" ;;
    *) bad "and the $_w job says the binding failed, not the ceiling" "$(cat "$SC/err")" ;;
  esac
done

printf '\nthe unattended repair says why it stopped before the model\n'
# The attempt step installs the pinned claude-code with every line of npm's
# output thrown away, and Actions runs a step that names no shell as `bash -e`.
# A failed install therefore ended the step at that line with nothing printed,
# after the budget step had already recorded the run's spend. The step is taken
# out of the shipped template as it stands and run under `bash -e`, with npm
# and claude stubbed.
AT="$TMP/attempt"; mkdir -p "$AT/repo" "$AT/bin"
awk '/- name: Attempt a repair/ { f = 1 } f && /^        run: \|/ { r = 1; next }
     r && /^      [^ ]/ { exit } r { sub(/^          /, ""); print }' \
  "$REAL_HARNESS/templates/unattended.yml" | sed "s#/tmp/brief.txt#$AT/brief.txt#" > "$AT/step.sh"
printf 'brief\n' > "$AT/brief.txt"
cat > "$AT/bin/npm" <<'STUB'
#!/usr/bin/env bash
[ -z "${ATTEMPT_NPM_FAILS:-}" ] && exit 0
printf 'npm error code E404\nnpm error 404 Not Found - GET https://registry.npmjs.org/@anthropic-ai%%2fclaude-code\n' >&2
exit 1
STUB
printf '#!/usr/bin/env bash\nprintf "claude\\n" >> "%s/claude.log"\n' "$AT" > "$AT/bin/claude"
chmod +x "$AT/bin/npm" "$AT/bin/claude"
_attempt() { : > "$AT/claude.log"
  ( cd "$AT/repo" && ATTEMPT_NPM_FAILS="$1" PATH="$AT/bin:$PATH" bash -e "$AT/step.sh" ) > "$AT/out" 2>&1; }
_attempt 1; _arc=$?
[ "$_arc" -ne 0 ] && ok  "a failed install fails the repair step" \
                  || bad "a failed install fails the repair step" "exit 0: $(cat "$AT/out")"
has "and says the install failed rather than ending in silence" "$(cat "$AT/out")" "could not install"
has "and passes on npm's own reason" "$(cat "$AT/out")" "E404"
is  "and no model is run" "$(wc -l < "$AT/claude.log" | tr -d ' ')" "0"
_attempt ""
is  "an install that succeeds goes on to the model" "$(wc -l < "$AT/claude.log" | tr -d ' ')" "1"

printf '\nthe unattended repair gets its push gated\n'
# The repair pushes with the GITHUB_TOKEN actions/checkout leaves in the
# checkout, and GitHub starts no workflow for an event that token causes,
# workflow_dispatch and repository_dispatch excepted. On github.com a pull
# request the token updates gets a pull_request run that waits for a person to
# approve it. So a repaired commit reached its pull request with no gate
# verdict, and the ceiling counted gate runs people caused, not repair
# attempts. The same token cannot push a change under .github/workflows, so a
# repair that edited one failed at the push, after the gate had passed it.
# Both rules are GitHub's, from "Triggering a workflow from a workflow".
#
# The verify step is taken out of the shipped template and run under bash -e
# in a clone of a bare remote, with felix stubbed to a gate of the test's
# choosing. A bare remote takes a workflow file from anyone, so a refusal here
# is the step's own and not the server's.
UT="$REAL_HARNESS/templates/unattended.yml"
VP="$TMP/verify"; mkdir -p "$VP/felix/engine/harness" "$VP/bin" "$VP/vbin"
awk '/- name: Verify and push/ { f = 1 } f && /^        run: \|/ { r = 1; next }
     r && /^      [^ ]/ { exit } r { sub(/^          /, ""); print }' "$UT" > "$VP/step.sh"
# The gate is stubbed to a status of the test's choosing. Everything else is
# the real felix, so the verify step's own scope check is the real classifier
# reading the real risk table: the fixture checkout is bound to widget, whose
# table is the shipped template's for the length of this section.
printf '#!/usr/bin/env bash\n[ "$1" = gate ] || exec "%s" "$@"\nprintf "gate\\n" >> "%s/gate.log"\nexit "${VERIFY_GATE_RC:-0}"\n' \
  "$FELIX" "$VP" > "$VP/felix/engine/harness/felix"
printf '#!/usr/bin/env bash\nprintf "%%s\\n" "$*" >> "%s/gh.log"\ncase "$1 $2" in "pr list") printf "7\\n" ;; esac\nexit 0\n' \
  "$VP" > "$VP/vbin/gh"
chmod +x "$VP/felix/engine/harness/felix" "$VP/vbin/gh"
# The judge the verify step checks is unchanged: a checkout, as in the job,
# with a risk table of its own in it.
mkdir -p "$VP/felix/projects/widget"
cp "$REAL_HARNESS/templates/risk.tsv" "$VP/felix/projects/widget/risk.tsv"
( cd "$VP/felix" && git init -q -b main && git add -A \
  && git -c user.name=t -c user.email=t@t commit -qm felix ) >/dev/null 2>&1
cp "$FROOT/projects/widget/risk.tsv" "$VP/risk.keep"
cp "$REAL_HARNESS/templates/risk.tsv" "$FROOT/projects/widget/risk.tsv"
# The implicated set the scope step would hand on as its output, src/a.txt
# unless a test says otherwise; _verify passes it in as the job would.
_vfix() { rm -rf "$VP/remote.git" "$VP/repo"
  git init -q --bare "$VP/remote.git"
  git init -q -b fix/x "$VP/repo"
  ( cd "$VP/repo" && git remote add origin "$VP/remote.git" \
    && mkdir -p .github/workflows src tests && printf 'on: push\n' > .github/workflows/gate.yml \
    && printf 'a\n' > src/a.txt && printf 'def test_a(): pass\n' > tests/test_a.py \
    && printf 'c\n' > "src/caf$(printf '\303\251').txt" && printf '*.local\n' > .gitignore \
    && printf 'widget\n' > .felix && git add -A \
    && git -c user.name=t -c user.email=t@t commit -qm base && git push -q origin fix/x ) >/dev/null 2>&1
  printf 'src/a.txt\n' > "$VP/implicated.txt"
  _v0="$(git --git-dir="$VP/remote.git" rev-parse fix/x)"; }
_verify() { : > "$VP/out"; : > "$VP/gate.log"; : > "$VP/gh.log"
  ( cd "$VP/repo" && IMPLICATED="$(cat "$VP/implicated.txt" 2>/dev/null)" VERIFY_GATE_RC="$1" \
      GITHUB_OUTPUT="$VP/out" BRANCH=fix/x PATH="$VP/vbin:$PATH" \
      bash -e "$VP/step.sh" ) > "$VP/log" 2>&1; _vrc=$?
  _vgot="exit $_vrc, remote $([ "$(git --git-dir="$VP/remote.git" rev-parse fix/x)" = "$_v0" ] \
    && echo unchanged || echo moved), gate $(wc -l < "$VP/gate.log" | tr -d ' '), pushed=$(sed -n 's/^pushed=//p' "$VP/out" | head -1)"
  _vtree="tree $( cd "$VP/repo" && [ "$(git rev-parse HEAD)" = "$_v0" ] && [ -z "$(git status --porcelain --ignored)" ] \
    && echo "at base" || echo "not at base" ), refused=$(sed -n 's/^refused=//p' "$VP/out" | head -1)"
  _vlab="$(tr '\n' ' ' < "$VP/gh.log")"; }

# Named in the set, so what stops it is the workflow-file check and not the
# set: a project whose risk table does not call .github/workflows red lets the
# scope step hand such a file on.
_vfix; printf '.github/workflows/gate.yml\n' > "$VP/implicated.txt"
printf 'on: [push, workflow_dispatch]\n' > "$VP/repo/.github/workflows/gate.yml"
_verify 0
is  "a repair that edits a workflow file is not pushed, and the gate is not spent on it" \
    "$_vgot, tree $(cd "$VP/repo" && git diff --quiet && echo clean || echo dirty)" \
    "exit 1, remote unchanged, gate 0, pushed=, tree clean"
has "and it names the workflow file it will not push" "$(cat "$VP/log")" ".github/workflows/gate.yml"
_vfix; printf 'b\n' >> "$VP/repo/src/a.txt"
_verify 0
is  "a repair the gate passes is pushed, and says so to the job that runs the gate again" \
    "$_vgot" "exit 0, remote moved, gate 1, pushed=yes"
_vfix; printf 'b\n' >> "$VP/repo/src/a.txt"
_verify 1
is  "a repair the gate fails is not pushed, and asks for no second gate run" \
    "$_vgot" "exit 1, remote unchanged, gate 1, pushed="

# What the attempt may touch, checked on its own diff before the gate. The
# prompt tells the model to edit only the files the brief names, and until
# 2026-09-24 nothing else did: whatever it changed was pushed once the gate
# was green, red paths included, and a gate can be turned green by editing
# what it reads. A file outside the set is refused whatever its tier, so the
# one here is a file the risk rules call green.
_vfix; printf 'b\n' >> "$VP/repo/src/a.txt"; printf 'import pytest; pytest.skip()\n' >> "$VP/repo/tests/test_a.py"
_verify 0
is  "a repair that changes a file the brief did not name is not pushed, and the gate is not spent on it" \
    "$_vgot, $_vtree" "exit 1, remote unchanged, gate 0, pushed=, tree at base, refused=yes"
is  "and it is refused though the risk rules call that file green" \
    "$(cd "$VP/repo" && "$FELIX" scope tests/test_a.py 2>&1 | sed -n 's/^highest tier: //p')" "green"
has "and it names the file it will not push" "$(cat "$VP/log")" "tests/test_a.py"
has "and it hands the change to a person on the branch's pull request" "$_vlab" "pr edit 7 --add-label needs-founder"

# A file the model created is in neither `git diff` nor `git commit -a`, so it
# is never pushed, but the gate reads it: a conftest.py that skips the failing
# test would turn the gate green on a commit that never carried it.
_vfix; printf 'b\n' >> "$VP/repo/src/a.txt"; printf 'collect_ignore = ["src"]\n' > "$VP/repo/src/conftest.py"
_verify 0
is  "a file the attempt created is outside the brief too, and is not left for anything to read" \
    "$_vgot, $_vtree" "exit 1, remote unchanged, gate 0, pushed=, tree at base, refused=yes"

# Inside the set, the diff is classified with its content, not only its paths.
# A credential written into a file the brief named is red whatever the file is
# called, and scoping the path alone passed it (#100's defect, one step later).
# `sk-` and not `sk-ant-`, as in the scope section: must_flag excuses a fixture
# line to secret-scan only when no hard shape is on it, and `sk-ant-` is one.
_vfix; printf 'api_key = "sk-QQQQQQQQQQQQQQQQQQQQQQQQ"\n' >> "$VP/repo/src/a.txt"   # must_flag
_verify 0
is  "a credential written into a file the brief named is red, and is not pushed" \
    "$_vgot, $_vtree" "exit 1, remote unchanged, gate 0, pushed=, tree at base, refused=yes"
has "and it says the risk rules called the diff red" "$(cat "$VP/log")" "call the attempt's own diff red"
has "and it hands that to a person too" "$_vlab" "pr edit 7 --add-label needs-founder"

# An ignored file is untracked too, and the gate reads it the same way: a
# *.local a test run picks up passed the gate, and the named edit beside it
# was pushed, since neither the diff nor the untracked list showed it.
_vfix; printf 'b\n' >> "$VP/repo/src/a.txt"; printf 'fixed\n' > "$VP/repo/gate.local"
_verify 0
is  "an ignored file the attempt created is outside the brief as well, and is removed" \
    "$_vgot, $_vtree" "exit 1, remote unchanged, gate 0, pushed=, tree at base, refused=yes"
# The judge: the scope check and the gate run from the Felix checkout beside
# this one, and a green row added to its risk table would clear the change it
# judges. No command the job runs writes there.
_vfix; printf 'b\n' >> "$VP/repo/src/a.txt"
printf 'green\tpath\t.*\tanything goes\n' >> "$VP/felix/projects/widget/risk.tsv"
_verify 0
( cd "$VP/felix" && git checkout -q -- . )
is  "a change to the Felix checkout that judges the repair is refused before it judges" \
    "$_vgot, $_vtree" "exit 1, remote unchanged, gate 0, pushed=, tree at base, refused=yes"
# git quotes a name outside ASCII, so the file the brief named never matched
# its own entry and every such repair was refused and labelled.
_vfix; _vcafe="src/caf$(printf '\303\251').txt"
printf '%s\n' "$_vcafe" > "$VP/implicated.txt"; printf 'd\n' >> "$VP/repo/$_vcafe"
_verify 0
is  "a named file whose name is not ASCII is pushed like any other" \
    "$_vgot, refused=$(sed -n 's/^refused=//p' "$VP/out" | head -1)" "exit 0, remote moved, gate 1, pushed=yes, refused="

# Wiring, not the change, so no label: the scope step left no set, or felix
# scope could not classify. Neither is pushed on the strength of a check that
# did not run.
_vfix; rm -f "$VP/implicated.txt"; printf 'b\n' >> "$VP/repo/src/a.txt"
_verify 0
is  "with no implicated set from the scope step, nothing is pushed and no pull request is labelled" \
    "$_vgot, $_vtree, gh [$_vlab]" "exit 1, remote unchanged, gate 0, pushed=, tree at base, refused=, gh []"
_vfix; printf 'b\n' >> "$VP/repo/src/a.txt"
mv "$FROOT/projects/widget/risk.tsv" "$VP/risk.away"
_verify 0
mv "$VP/risk.away" "$FROOT/projects/widget/risk.tsv"
is  "a diff felix scope cannot classify is not pushed, and no pull request is labelled" \
    "$_vgot, $_vtree, gh [$_vlab]" "exit 1, remote unchanged, gate 0, pushed=, tree at base, refused=, gh []"

# The set reaches the verify step as the scope step's output, never as a file.
# With `Read,Edit` unscoped the model read and edited /tmp and the Felix
# checkout (measured on the pinned CLI), so a set read back from disk after it
# ran, as the first version of this step read /tmp/implicated.txt, held only
# while the attempt step's scoping does.
_vimpenv="$(awk '/- name: Verify and push/ { f = 1 } f && /^ *IMPLICATED: / { sub(/^ *IMPLICATED: /, ""); print; exit }' "$UT")"
is  "the verify step takes the implicated set from the scope step's output, and reads no file for it" \
    "$_vimpenv, $(grep -c '/tmp/' "$VP/step.sh" | tr -d ' ') /tmp reads" \
    "\${{ steps.scope.outputs.implicated }}, 0 /tmp reads"
# And the report reads the refusal under the name the step writes it.
_vpunwritten=""
for _k in $(grep -o 'steps\.push\.outputs\.[a-z_]*' "$UT" | sed 's/.*\.//' | sort -u); do
  grep -q "echo \"$_k=" "$VP/step.sh" || _vpunwritten="$_vpunwritten $_k"
done
is  "every steps.push output the template reads is one the verify step writes" "${_vpunwritten:-none}" "none"
cp "$VP/risk.keep" "$FROOT/projects/widget/risk.tsv"

# The job that runs the gate again, read out of the template: what it waits
# for, what its token may do, and what it asks GitHub for. It holds actions:
# write, which dispatching a workflow needs, and nothing else; the job with the
# model and the push holds none of it.
_ujob() { awk -v j="  $1:" '$0 == j { f = 1; next } f && (/^  [^ ]/ || /^[^ ]/) { exit } f' "$UT"; }
_rg="$(_ujob regate)"
_rgperm="$(printf '%s\n' "$_rg" | awk '/^    permissions:/ { p = 1; next }
  p && /^      [a-z-]+:/ { gsub(/ /, ""); printf "%s ", $0; next } p { exit }')"
is  "a job runs the gate again only after the repair job pushed" \
    "$(printf '%s\n' "$_rg" | sed -n 's/^    needs: //p; s/^    if: //p' | tr '\n' ';')" \
    "repair;needs.repair.outputs.pushed == 'yes';"
is  "and its token may dispatch workflows and do nothing else" "$_rgperm" "actions:write "
_rtop="$(awk '/^permissions:/ { p = 1; next } p && /^  [a-z-]+:/ { gsub(/ /, ""); printf "%s ", $0; next } p { exit }' "$UT")"
case "$_rtop $(_ujob repair | grep -c 'permissions:')" in
  *actions*|*" "[1-9]*) bad "and the job that runs the model holds no actions permission" "workflow: $_rtop" ;;
  *) ok "and the job that runs the model holds no actions permission" ;;
esac
# The output it waits on is one the repair job hands on from the step that
# pushed, and that step writes it. An output never written reads as empty, and
# the gate would never run again.
_rpid="$(awk '/- name: Verify and push/ { f = 1; next } f && /^        id: / { print $2; exit } f && /^      - / { exit }' "$UT")"
_rpout="$(_ujob repair | sed -n 's/^      pushed: //p')"
[ -n "$_rpid" ] && [ "$_rpout" = "\${{ steps.$_rpid.outputs.pushed }}" ] \
  && grep -q 'echo "pushed=yes" >> "$GITHUB_OUTPUT"' "$VP/step.sh" \
  && ok  "and that output is handed on from the step that pushed, which writes it" \
  || bad "and that output is handed on from the step that pushed, which writes it" \
         "push step id [$_rpid], job output [$_rpout]"
has "and it dispatches the workflow whose failure started the repair" "$_rg" \
    "GATE: \${{ github.event.workflow_run.workflow_id || 'gate' }}"
is  "and on the branch the repair pushed to" \
    "$(printf '%s\n' "$_rg" | sed -n 's/^ *BRANCH: //p')" \
    "$(awk '/- name: Verify and push/ { f = 1 } f && /^ *BRANCH: / { sub(/^ *BRANCH: /, ""); print; exit }' "$UT")"

awk '/- name: Run the gate on the pushed commit/ { f = 1 } f && /^        run: \|/ { r = 1; next }
     r && /^      [^ ]/ { exit } r { sub(/^          /, ""); print }' "$UT" > "$VP/regate.sh"
cat > "$VP/bin/gh" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$REGATE_LOG"
[ -z "${REGATE_FAILS:-}" ] && exit 0
printf "could not create workflow dispatch event: HTTP 422: Workflow does not have 'workflow_dispatch' trigger\n" >&2
exit 1
STUB
chmod +x "$VP/bin/gh"
_regate() { : > "$VP/gh.log"
  ( cd "$VP" && REGATE_FAILS="$1" REGATE_LOG="$VP/gh.log" GATE=4242 BRANCH=fix/x \
      GITHUB_REPOSITORY=example/widget GH_TOKEN=t PATH="$VP/bin:$PATH" bash -e "$VP/regate.sh" ) \
    > "$VP/regate.out" 2>&1; }
_regate ""; _rgrc=$?
is  "the gate is dispatched on the pushed branch" "exit $_rgrc: $(cat "$VP/gh.log")" \
    "exit 0: workflow run 4242 --repo example/widget --ref fix/x"
_regate 1; _rgrc=$?
[ "$_rgrc" -ne 0 ] && ok  "a gate that cannot be dispatched fails the job" \
                   || bad "a gate that cannot be dispatched fails the job" "exit 0: $(cat "$VP/regate.out")"
has "and says the pushed commit has no gate verdict" "$(cat "$VP/regate.out")" "no gate verdict"
has "and passes on GitHub's own reason" "$(cat "$VP/regate.out")" "HTTP 422"

# The gate workflow bootstrap writes has to accept the dispatch, or every
# repository bootstrapped from it fails the job above on its first push.
has "the gate workflow bootstrap writes can be dispatched" \
    "$( . "$REAL_HARNESS/lib/detect.sh"; . "$REAL_HARNESS/lib/bootstrap.sh"
        felix_bs_render_workflow none someone/repo )" "  workflow_dispatch:"

# Each push leaves a gate run on the pull request that waits for a person's
# approval, so on github.com the branch reads, newest first: the dispatched
# run, the waiting one, the run before. The count stopped at the waiting run,
# so however many repairs failed it read as the failures since the last push,
# and the ceiling never came.
if command -v jq >/dev/null 2>&1; then
  { printf 'gate.yml\tgate\tfix/z\t405\tcompleted\tfailure\n'
    printf 'gate.yml\tgate\tfix/z\t404\tcompleted\taction_required\n'
    printf 'gate.yml\tgate\tfix/z\t403\tcompleted\tfailure\n'
    printf 'gate.yml\tgate\tfix/z\t402\tcompleted\taction_required\n'
    printf 'gate.yml\tgate\tfix/z\t401\tcompleted\tfailure\n'
    printf 'gate.yml\tgate\tfix/z\t400\tcompleted\tsuccess\n'
  } > "$VP/runs"
  is "a gate run waiting for approval does not end the count of failures behind it" \
     "$( export WFSTUB_LOG="$VP/wf.log" WFSTUB_RUNS="$VP/runs" WFSTUB_WORKFLOWS=gate.yml
         _wfatt fix/z gate.yml )" "3"
else
  skip "a gate run waiting for approval does not end the count of failures behind it" \
       "no jq here to evaluate gh's -q expressions"
fi

printf '\nthe unattended repair leaves the model no credential to copy\n'
# Both checkouts left a credential on the runner for the model step to read.
# actions/checkout persists what it fetched with unless told otherwise: the
# job's token as an http.extraheader in repo/.git/config, and the deploy key as
# a file under $RUNNER_TEMP that felix/.git/config's core.sshCommand names by
# path. The model step runs `claude -p` with Read and Edit allowed, and a
# tool-name allow rule matches every path. Measured on the pinned 2.1.37
# (2026-09-23, the real binary against a scripted Messages API): Read returned
# all three files, Edit put their contents in a tracked file, and
# bin/secret-scan passed the diff, since a base64 header and a ghs_ token are
# shapes it does not know; the push step then commits every tracked change.
# Without Read in --allowedTools the two paths outside the working directory
# were refused, so the allow rule is what opens them, and the model needs it.
# The fix is upstream of the model: neither checkout persists, so the key file
# is gone before the scope step runs, and the push step hands git the token
# itself, from its own environment, through a credential helper, so it is in
# no file and no argument.
UC="$TMP/uncred"; mkdir -p "$UC/repo" "$UC/bin" "$UC/felix/engine/harness"
# Every checkout, enumerated. A rule read off the two there are stops holding
# the day a third is added.
_ucblocks="$(awk '/^      - uses: actions\/checkout@/ { if (n) print (p ? "dropped" : "kept"); n = 1; p = 0; next }
                  n && /^      - / { print (p ? "dropped" : "kept"); n = 0; next }
                  n && /persist-credentials: false/ { p = 1 }
                  END { if (n) print (p ? "dropped" : "kept") }' "$REAL_HARNESS/templates/unattended.yml")"
is  "every checkout in the unattended template drops its credential once the fetch is done" \
    "$(printf '%s\n' "$_ucblocks" | grep -c kept) of $(printf '%s\n' "$_ucblocks" | grep -c .) keep one" "0 of 2 keep one"
# The token may reach the model step neither as environment nor as text.
_ucstep="$(awk '/- name: Attempt a repair/ { f = 1; next } f && /^      - / { exit } f' "$REAL_HARNESS/templates/unattended.yml")"
case "$_ucstep" in
  *GITHUB_TOKEN*|*GH_TOKEN*|*github.token*|*secrets.GITHUB*)
     bad "and the model step is handed no token, in its environment or its text" \
         "$(printf '%s\n' "$_ucstep" | grep -n 'TOKEN\|github\.token\|secrets\.GITHUB')" ;;
  *) ok  "and the model step is handed no token, in its environment or its text" ;;
esac
# The rules the model runs under, read off the step as shipped. What they mean
# was measured on the binary, which this suite has neither of (no network, no
# model): a bare tool name matches every path; `./**` as an allow stops at the
# working directory, so -p refuses the rest as ungranted; `.git/**` as a deny
# matches under the working directory and nowhere else, which is why the deny
# alone left ../felix/.git/config editable and core.hooksPath landed in it.
# The allow list is held exactly, since any widening is the thing guarded; the
# deny lists are joined, so another rule beside these two is not a failure.
_ucallow="$(printf '%s\n' "$_ucstep" | sed -n 's/.*--allowedTools "\([^"]*\)".*/\1/p' | tr '\n' ',')"
_ucdeny="$(printf '%s\n' "$_ucstep" | sed -n 's/.*--disallowedTools "\([^"]*\)".*/\1/p' | tr '\n' ',')"
is  "the model's tools are allowed inside the checkout and nowhere else" "$_ucallow" "Read(./**),Edit(./**),"
has "and reading the checkout's .git is denied" ",$_ucdeny" ",Read(.git/**),"
has "and editing it is denied"                   ",$_ucdeny" ",Edit(.git/**),"
# The push step, taken out of the shipped template as it stands and run under
# bash -e with the gate green and a git that records each call. On push the
# stub runs the credential helper the call configured exactly as git would,
# `sh -c 'HELPER "$@"' -- get`, so the helper is exercised and not just named.
awk '/- name: Verify and push/ { f = 1 } f && /^        run: \|/ { r = 1; next }
     r && /^      [^ ]/ { exit } r { sub(/^          /, ""); print }' \
  "$REAL_HARNESS/templates/unattended.yml" > "$UC/step.sh"
printf '#!/usr/bin/env bash\nexit 0\n' > "$UC/felix/engine/harness/felix"
cat > "$UC/bin/git" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$UC_LOG"
case "$1 $2 $3" in "diff --quiet "*) exit 1 ;; esac
# What the verify step asks before it pushes: the commit it starts from, and
# what changed, one file, the one the brief named. Its workflow-file check
# asks `diff --name-only -- .github/workflows`, which names nothing here.
case " $* " in
  *" rev-parse HEAD "*) echo 0123456789abcdef0123456789abcdef01234567; exit 0 ;;
  *" diff --name-only --no-renames HEAD "*) echo src/a.txt; exit 0 ;;
esac
helper=""
while [ $# -gt 0 ]; do
  case "$1" in
    -c) case "$2" in credential.helper=!*) helper="${2#credential.helper=!}" ;; esac; shift 2 ;;
    push) [ -n "$helper" ] && sh -c "$helper \"\$@\"" -- get >> "${UC_LOG%.log}.cred" </dev/null
          # Only the push the step is meant to make succeeds, so "a green
          # gate pushes" can fail on the push and not just on the shell.
          [ "$*" = "push origin HEAD:$BRANCH" ] && exit 0; echo "unexpected push: $*" >&2; exit 7 ;;
    *) shift ;;
  esac
done
exit 0
STUB
chmod +x "$UC/felix/engine/harness/felix" "$UC/bin/git"
# A placeholder by secret-scan's own rule (an "example" in the value): since
# #342 taught the scan ghs_ tokens, a real-looking value here was a line the
# public snapshot's credential scan refused to publish.
_uctok="ghs_exampletokenexampletokenexample"
: > "$UC/git.log"; : > "$UC/git.cred"
( cd "$UC/repo" && UC_LOG="$UC/git.log" GITHUB_TOKEN="$_uctok" IMPLICATED=src/a.txt GITHUB_OUTPUT="$UC/out.gh" \
    BRANCH=fix/x PATH="$UC/bin:$PATH" \
    bash -e "$UC/step.sh" ) > "$UC/out" 2>&1; _ucrc=$?
[ "$_ucrc" -eq 0 ] && ok  "a green gate pushes the repair" \
                   || bad "a green gate pushes the repair" "exit $_ucrc: $(cat "$UC/out")"
has "and pushes it to the branch the run repaired" "$(cat "$UC/git.log")" "push origin HEAD:fix/x"
has "the push step hands git the token itself, through a helper reading the step's environment" \
    "$(cat "$UC/git.cred")" "password=$_uctok"
case "$(cat "$UC/git.log")" in
  *"$_uctok"*) bad "and the token is in no argument git was given" "$(grep -n "$_uctok" "$UC/git.log")" ;;
  *)           ok  "and the token is in no argument git was given" ;;
esac
printf '\nthe unattended repair denies the model its own environment\n'
# The attempt step runs with ANTHROPIC_API_KEY in its environment, so the
# claude process it starts carries the key, and on Linux a process's
# environment is a file, /proc/self/environ. A tool-name allow rule matches
# every path, and `--allowedTools "Read,Edit"` is one. Measured on the pinned
# 2.1.37 on ubuntu-latest (2026-09-24, the real binary against a scripted
# Messages API, run in a throwaway Actions repository; the rig is in the pull
# request): Read on /proc/self/environ returned the environment, key included,
# and Edit put the key in a tracked file, which the push step commits. A model
# steered by a hostile failing log is the reader to plan for. A deny rule is
# read before the allow rule, and the same measurement chose the spelling:
# `Read(//proc/**)` refused the path however it was written (/proc/self/environ,
# /proc/self/../self/environ, a relative path climbing to /proc,
# /proc//self/environ, /proc/thread-self/environ), each as a tool_use_error
# reading "File is in a directory that is denied by your permission settings"
# with the result line's permission_denials left empty, and left the
# repository's own files readable; `Read(/proc/**)`, one slash, refused
# nothing, since one slash names a path under the working directory. The
# measurement is the pin's: when the claude-code version moves, measure again.
# The claude stub records each argument on a line of its own, so what is
# asserted is what the shell handed the binary, not the template's text.
# Every --disallowedTools value is read, and every --allowedTools value, so
# a second deny rule beside this one, in the same list or its own flag, and
# an allow list that scopes Read and Edit to a path, keep passing.
printf '#!/usr/bin/env bash\nprintf "claude\\n" >> "%s/claude.log"\nprintf "%%s\\n" "$@" > "%s/claude.args"\n' "$AT" "$AT" > "$AT/bin/claude"
_attempt ""
_atrules() { awk -v f="$1" 'p { print; p = 0; next } $0 == f { p = 1 }' "$AT/claude.args" | tr ', ' '\n\n' | grep -v '^$'; }
_atdeny="$(_atrules --disallowedTools)"
if grep -q -x -F 'Read(//proc/**)' <<<"$_atdeny"; then
  ok  "the model step disallows Read under /proc, in the spelling 2.1.37 honours"
else
  bad "the model step disallows Read under /proc, in the spelling 2.1.37 honours" \
      "--disallowedTools ${_atdeny:-(absent)}"
fi
_atallow="$(_atrules --allowedTools)"
if grep -q -x -E 'Read(\(.*\))?' <<<"$_atallow" \
   && grep -q -x -E 'Edit(\(.*\))?' <<<"$_atallow"; then
  ok  "and Read and Edit stay allowed, since the repair needs both"
else
  bad "and Read and Edit stay allowed, since the repair needs both" "--allowedTools ${_atallow:-(absent)}"
fi

printf '\nthe unattended repair runs the action code its pins name, and no other\n'
# A tag is a ref its owner can move, so `actions/checkout@v5` runs whatever
# that repository points v5 at on the day the job runs, and it runs inside the
# step that fetches Felix with the deploy key, in a job holding a write token.
# The template pins the Felix ref and the claude-code install for that reason;
# semgrep's github-actions-mutable-action-tag (1.175, p/github-actions, run
# 2026-09-24) found the two checkouts had been left on a tag. Every `uses:` key
# in the file is read, a step's or a job's, so an action added later is held
# to the same pin without this list being edited. A read that found none is a
# failure too: an enumeration that matched nothing would pass every file.
_uauses="$(awk '/^[ \t]*#/ { next }
                /^[ \t]*(-[ \t]+)?uses:/ { v = $0
                  sub(/^[ \t]*(-[ \t]+)?uses:[ \t]*/, "", v); sub(/[ \t]+#.*$/, "", v)
                  print NR ": " v }' "$REAL_HARNESS/templates/unattended.yml" | tr -d "\"'")"
_ualoose="$(printf '%s\n' "$_uauses" | grep -v -E '^[0-9]+: [^@[:space:]]+@[0-9a-f]{40}$')"
if [ -n "$_uauses" ] && [ -z "$_ualoose" ]; then
  ok  "every uses: in the unattended template names a full commit sha, not a ref its owner can move"
else
  bad "every uses: in the unattended template names a full commit sha, not a ref its owner can move" \
      "${_ualoose:-no uses: line found}"
fi

printf '\nunattended budget\n'
# The ceiling worth having fails between runs, not during one, and counts
# repetition rather than money: ten deliberate attempts in a day is a working
# system, two hundred is a loop whatever each one cost.
rm -f "$FROOT/projects/widget/budget.log"
python3 - "$FROOT/projects/widget/project.json" <<'PYJ'
import json,sys,pathlib
p=pathlib.Path(sys.argv[1]); d=json.loads(p.read_text())
d["unattended_daily_limit"]="2"; p.write_text(json.dumps(d,indent=2))
PYJ
out="$(cd "$REPO" && "$FELIX" budget 2>&1)"
has "reads the per-project limit" "$out" "limit:  2"
has "and reports what is left"    "$out" "left:   2"

( cd "$REPO" && "$FELIX" budget --record >/dev/null 2>&1 )
( cd "$REPO" && "$FELIX" budget --record >/dev/null 2>&1 )
out="$(cd "$REPO" && "$FELIX" budget 2>&1)"; rc=$?
has "spending is counted" "$out" "used:   2"
is  "exhausted exits 3"   "$rc" "3"

out="$(cd "$REPO" && "$FELIX" budget --record 2>&1)"; rc=$?
is  "and refuses to spend past the ceiling" "$rc" "3"
has "saying why"                            "$out" "budget exhausted"

# A ceiling in a runner's ephemeral filesystem resets every job, invisibly.
[ -f "$FROOT/projects/widget/budget.log" ] \
  && ok "the ledger is durable state in the project" \
  || bad "the ledger is durable state in the project"

# Old entries age out rather than accumulating forever.
printf '1\t1970-01-01T00:00\tancient\n' >> "$FROOT/projects/widget/budget.log"
out="$(cd "$REPO" && "$FELIX" budget 2>&1)"
has "entries older than a day do not count" "$out" "used:   2"

# #84, the half that is mechanical. The append was unchecked and the caller
# reported `used + 1` - arithmetic on a value read BEFORE the write, not a
# reading of what landed. So a record that never landed printed
# `recorded. 1 of 10 used` and exited 0; `used` stayed 0 forever; and the
# ceiling silently became no ceiling. budget.sh's own header names that exact
# outcome as the thing to prevent - "which is the same as no ceiling, and it
# resets invisibly."
#
# An unwritable project directory is the cheapest real cause. A full disk or a
# read-only mount reach the same place, and one of them is how this would
# actually happen on a runner.
#
# A write refused by a mode is asked of this machine first, the way a read is
# further down: root writes through a directory at 555 and a file at 444, and
# a cloud session runs as root, so there the refusal cannot be built. Those
# assertions skip, not pass, and not fail on a write that was never refused,
# which also left the probe's row in the log for the control below to count.
mkdir "$TMP/mode-555"; chmod 555 "$TMP/mode-555"
printf 'x\n' > "$TMP/mode-444"; chmod 444 "$TMP/mode-444"
_unwritable=1
( : > "$TMP/mode-555/x" ) 2>/dev/null && _unwritable=0
( printf 'x\n' >> "$TMP/mode-444" ) 2>/dev/null && _unwritable=0
chmod 755 "$TMP/mode-555"; chmod 644 "$TMP/mode-444"
_nowrite="this user writes through a mode of 555 or 444, so no write can be refused"
rm -f "$FROOT/projects/widget/budget.log"
python3 - "$FROOT/projects/widget/project.json" <<'PYJ'
import json,sys,pathlib
p=pathlib.Path(sys.argv[1]); d=json.loads(p.read_text())
d["unattended_daily_limit"]="10"; p.write_text(json.dumps(d,indent=2))
PYJ
if [ "$_unwritable" -eq 1 ]; then
  chmod 555 "$FROOT/projects/widget"
  out="$(cd "$REPO" && "$FELIX" budget --record --why "probe" 2>&1)"; rc=$?
  chmod 755 "$FROOT/projects/widget"

  [ "$rc" -ne 0 ] && ok "a record that could not be written does not exit 0" \
                  || bad "a record that could not be written does not exit 0" \
                         "exit $rc after: $out"
  case "$out" in
    *"recorded."*) bad "and does not say it recorded" "$out" ;;
    *)             ok  "and does not say it recorded" ;;
  esac
  # The number is the tell. `used + 1` reports a spend that never happened, and it
  # reports it in the same words a real one uses.
  case "$out" in
    *"1 of 10"*) bad "nor report a spend that did not happen" "$out" ;;
    *)           ok  "nor report a spend that did not happen" ;;
  esac
  is "and nothing was written" \
     "$([ -f "$FROOT/projects/widget/budget.log" ] && echo present || echo absent)" "absent"
else
  for a in "a record that could not be written does not exit 0" "and does not say it recorded" \
           "nor report a spend that did not happen" "and nothing was written"; do
    skip "$a" "$_nowrite"; done
fi

# The control, and the half a careless fix breaks: a writable project still
# records, still exits 0, and the count it prints is the one the log holds
# rather than one it worked out in advance.
out="$(cd "$REPO" && "$FELIX" budget --record --why "real" 2>&1)"; rc=$?
is  "a writable project still records" "$rc" "0"
has "and says so"                      "$out" "recorded."
is  "the log holds exactly one entry" \
    "$( . "$FROOT/harness/lib/budget.sh"; felix_budget_used "$FROOT/projects/widget" )" "1"
has "which is the number it printed"   "$out" "1 of 10"

# And the library says so on its own, so the fix cannot be a message change in
# the command while the function still swallows the failure.
#
# The log is removed first, and that is not tidiness. Directory permissions gate
# CREATION, not appends to a file that already exists - so with the control's
# budget.log still in place, chmod 555 on the directory leaves the append
# perfectly writable and the probe tests nothing. This assertion passed for that
# reason before the log was removed.
rm -f "$FROOT/projects/widget/budget.log"
if [ "$_unwritable" -eq 1 ]; then
  chmod 555 "$FROOT/projects/widget"
  ( . "$FROOT/harness/lib/budget.sh"
    felix_budget_record "$FROOT/projects/widget" "lib probe" 2>/dev/null ); librc=$?
  chmod 755 "$FROOT/projects/widget"
  [ "$librc" -ne 0 ] && ok "felix_budget_record itself reports the failure" \
                     || bad "felix_budget_record itself reports the failure" "exit $librc"
else
  skip "felix_budget_record itself reports the failure" "$_nowrite"
fi
rm -f "$FROOT/projects/widget/budget.log"

# #84, the race. cmd_budget is check-then-act with no lock: it reads the count,
# compares it to the limit, then appends. Two callers that both read 9 against a
# limit of 10 both pass the comparison and both append, and the ceiling - the
# only mechanical bound on unattended model runs - is overrun.
#
# Reproduced against shipped code on ONE machine, no CI involved: seeded at 9 of
# 10, three concurrent callers, all three recorded, ledger left at 12.
#
# Driven with real concurrent processes rather than a stub, because the defect
# IS the interleaving; a sequential fixture cannot express it. It is made
# deterministic by seeding the ledger so exactly one slot remains, which makes
# the correct outcome exact rather than probabilistic: at most one caller may
# record, however the three interleave.
_seed_budget() {   # $1 = how many entries to seed
  local n="$1" now i
  now="$(date +%s)"
  : > "$FROOT/projects/widget/budget.log"
  i=0; while [ "$i" -lt "$n" ]; do
    printf '%s\t%s\tseed\n' "$now" "1970-01-01T00:00" >> "$FROOT/projects/widget/budget.log"
    i=$((i + 1))
  done
}
_seed_budget 9
RACE="$TMP/race"; rm -rf "$RACE"; mkdir -p "$RACE"
for _r in 1 2 3; do
  ( cd "$REPO" && "$FELIX" budget --record --why "racer$_r" >"$RACE/out$_r" 2>&1
    printf '%s' "$?" > "$RACE/rc$_r" ) &
done
wait

_recorded=0
for _r in 1 2 3; do
  [ "$(cat "$RACE/rc$_r" 2>/dev/null)" = "0" ] && _recorded=$((_recorded + 1))
done
# At most one, because exactly one slot was left. Zero is allowed and safe: if
# every caller observes the ledger after every append, they all refuse, and the
# window reopens on the next invocation. More than one is the overrun.
[ "$_recorded" -le 1 ] \
  && ok "at most one caller records when one slot is left" \
  || bad "at most one caller records when one slot is left" \
         "$_recorded of 3 recorded; ledger has $(grep -c . "$FROOT/projects/widget/budget.log") entries"

# And no caller may claim success while reporting a count past the ceiling. That
# sentence is what a workflow step reads as permission to invoke a model.
_overclaim=0
for _r in 1 2 3; do
  if [ "$(cat "$RACE/rc$_r" 2>/dev/null)" = "0" ]; then
    case "$(cat "$RACE/out$_r")" in
      *"1"[1-9]" of 10"*|*"2"[0-9]" of 10"*) _overclaim=$((_overclaim + 1)) ;;
    esac
  fi
done
is "and none reports a spend past the ceiling as recorded" "$_overclaim" "0"
rm -f "$FROOT/projects/widget/budget.log"

printf '\nunattended readiness\n'
# #87. Two of the five readiness rows were printf constants. This is the report
# a person reads when deciding whether to switch on a loop that invokes a model
# unattended, and `felix unattended` says outright that Felix will not flip that
# switch for them - so the rows have to be true.
#
# `scope bound` was fully literal, mark and text both, so it stayed checked for a
# project that declares no red path at all - i.e. exactly when nothing is out of
# scope and the bound it names does not exist.
#
# `budget ceiling` is a subtler case and the fix is different. Its [x] was not
# wrong about what it said - a ceiling IS configured, and felix_budget_limit can
# never return "none" - but readiness means the bound HOLDS, and in CI it does
# not: the ledger lives in a checkout made fresh every run (#84). Felix cannot
# determine that mechanically, so the honest mark is neither [x] nor [ ].
UNB="$TMP/unattgh"; mkdir -p "$UNB"
# `gh api` answers the way the server does for what the drift rows below ask:
# the workflow list from UNSTUB_WORKFLOWS through jq for the -q expression, a
# file under UNSTUB_FILES as its raw contents or gh's own 404, and no answer at
# all for an endpoint containing UNSTUB_UNANSWERED.
cat > "$UNB/gh" <<'STUB'
#!/usr/bin/env bash
case "$1 $2" in
  "variable list") ;;
  "secret list")   printf 'ANTHROPIC_API_KEY\n' ;;
  "run list")      printf '0\n' ;;
  "api "*)
    ep=""; q="."; prev=""
    for a in "$@"; do
      case "$prev" in -q|--jq) q="$a" ;; esac
      case "$a" in repos/*) ep="$a" ;; esac
      prev="$a"
    done
    if [ -n "${UNSTUB_UNANSWERED:-}" ]; then
      case "$ep" in *"$UNSTUB_UNANSWERED"*) printf 'error connecting to api.github.com\n' >&2; exit 1 ;; esac
    fi
    case "$ep" in
      */actions/workflows) printf '%s\n' "${UNSTUB_WORKFLOWS:-}" | jq -r "$q" ;;
      */contents/*)
        f="${UNSTUB_FILES:-/nonexistent}/${ep#*/contents/}"
        [ -f "$f" ] || { printf 'gh: Not Found (HTTP 404)\n' >&2; exit 1; }
        cat "$f" ;;
    esac ;;
esac
exit 0
STUB
chmod +x "$UNB/gh"
# The fixture has no origin at this point and cmd_unattended dies without one -
# which made two of these assertions pass on the error text rather than on the
# behaviour. Added here and removed at the end of the block.
( cd "$REPO" && git remote add origin https://github.com/example/widget.git ) 2>/dev/null
_unatt() { ( cd "$REPO" && PATH="$UNB:$PATH" "$FELIX" unattended 2>&1 ); }
# Asserted, not assumed: if the command still cannot run, everything below is
# testing an error message.
has "the readiness report runs at all" "$(_unatt)" "repo:"

cp "$FROOT/projects/widget/risk.tsv" "$TMP/risk.unatt.keep" 2>/dev/null || : > "$TMP/risk.unatt.keep"

# A table that declares red paths: the bound exists and the row may say so.
{ printf '# tier\tkind\tpattern\treason\n'
  printf 'red\tpath\t^secrets/\tsecret material\n'
} > "$FROOT/projects/widget/risk.tsv"
# The ROW, not the whole report. A glob like *"[x]"*"scope bound"* matches
# because `[x] api key` appears earlier in the output, so it was true whatever
# the scope row said.
_row() { printf '%s\n' "$1" | grep -F "$2" | head -1; }
out="$(_unatt)"
has "a project with red paths reports the scope bound" "$(_row "$out" 'scope bound')" "[x]"

# A table with no red path at all: nothing is refused, so nothing is bound.
{ printf '# tier\tkind\tpattern\treason\n'
  printf 'green\tpath\t^docs/\tprose\n'
} > "$FROOT/projects/widget/risk.tsv"
out="$(_unatt)"
case "$(_row "$out" 'scope bound')" in
  *"[x]"*) bad "and a project with none does not claim it" "$(_row "$out" 'scope bound')" ;;
  *)       ok  "and a project with none does not claim it" ;;
esac
has "saying what is missing" "$out" "no red rule"

# Content rules bound scope exactly as path rules do (#100) — felix scope
# classifies the whole diff and refuses on either kind. Counting paths alone
# told a project whose red tier is all content rules — secrets, destructive
# SQL, the material the red tier exists for — that nothing was out of scope,
# on the checklist read before switching on unattended model runs. Elenchus
# declares 2 red content rules today.
{ printf '# tier\tkind\tpattern\treason\n'
  printf 'red\tcontent\tDROP[[:space:]]+TABLE\tdestructive sql\n'
} > "$FROOT/projects/widget/risk.tsv"
out="$(_unatt)"
has "a project bounded only by content rules reports the bound" \
    "$(_row "$out" 'scope bound')" "[x]"

# The budget row must not read as a satisfied precondition, because whether the
# ceiling survives where the loop runs is not something this can check.
case "$(_row "$out" 'budget ceiling')" in
  *"[x]"*) bad "the budget row is not reported as satisfied" "$(_row "$out" 'budget ceiling')" ;;
  *)       ok  "the budget row is not reported as satisfied" ;;
esac
has "and is marked unknown rather than unmet" "$(_row "$out" 'budget ceiling')" "[?]"
# And it reads the ledger rather than only the configured number, so the row
# says what has been spent and not merely what was declared.
has "and reports what has been spent" "$out" "spent"

# Deployed copies drift in silence. A person copies templates/unattended.yml
# into a repository once, and the engine it checks out moves on without it.
# Elenchus's copy did exactly that, measured 2026-09-23: its scope step still
# proceeded on every exit of felix repair but 3, a behaviour #323 and #329
# had fixed in the template, while nothing here could say so. The repair's
# push also starts no ordinary run of the gate, since GitHub creates none
# from an event the workflow token causes except a dispatch, so whether the
# gate workflow takes workflow_dispatch is a fact about the loop too. Both
# rows read the repository's default branch, where a workflow_run trigger
# and a dispatch are both taken from.
if ! command -v jq >/dev/null 2>&1; then
  for a in "a gate workflow that takes workflow_dispatch is reported as taking one" \
           "and one that does not is reported unmet" \
           "an on: line naming workflow_dispatch counts as taking one" \
           "workflow_dispatch named only in an if: expression does not" \
           "a gate workflow that cannot be read is unknown, not unmet" \
           "a deployed copy that is the template with its placeholders filled matches it" \
           "and still matches with its comments changed" \
           "a copy whose scope step drifted is unmet" \
           "and the row names the line it drifted at" \
           "a copy with no Felix pin does not match" \
           "a copy with a placeholder left unfilled does not match" \
           "a repository with no unattended workflow says so" \
           "a workflow list that cannot be read is unknown, not unmet"; do
    skip "$a" "no jq here to evaluate gh's -q expressions"
  done
else
UNF="$TMP/unattfiles"; mkdir -p "$UNF/.github/workflows"
export UNSTUB_FILES="$UNF" \
       UNSTUB_WORKFLOWS='{"workflows":[{"name":"gate","path":".github/workflows/gate.yml","state":"active"},{"name":"unattended repair","path":".github/workflows/unattended.yml","state":"active"}]}'
_tpl="$FROOT/harness/templates/unattended.yml"
_fill() { sed -e 's#{{FELIX_REPO}}#example/felix-home#' \
              -e 's#{{FELIX_REF}}#0123456789abcdef0123456789abcdef01234567#' "$_tpl"; }
_dr() { _row "$(_unatt)" 'gate takes a dispatch'; }
_tr() { _row "$(_unatt)" 'workflow matches template'; }

printf 'on:\n  pull_request:\n  push:\n    branches: [main]\n  workflow_dispatch:\njobs: {}\n' \
  > "$UNF/.github/workflows/gate.yml"
has "a gate workflow that takes workflow_dispatch is reported as taking one" "$(_dr)" "[x]"
printf 'on:\n  pull_request:\n  push:\n    branches: [main]\njobs: {}\n' \
  > "$UNF/.github/workflows/gate.yml"
has "and one that does not is reported unmet" "$(_dr)" "[ ]"
printf 'on: [pull_request, workflow_dispatch]\njobs: {}\n' > "$UNF/.github/workflows/gate.yml"
has "an on: line naming workflow_dispatch counts as taking one" "$(_dr)" "[x]"
printf "on:\n  pull_request:\njobs:\n  gate:\n    if: github.event_name != 'workflow_dispatch'\n" \
  > "$UNF/.github/workflows/gate.yml"
has "workflow_dispatch named only in an if: expression does not" "$(_dr)" "[ ]"
rm -f "$UNF/.github/workflows/gate.yml"
has "a gate workflow that cannot be read is unknown, not unmet" "$(_dr)" "[?]"

_fill > "$UNF/.github/workflows/unattended.yml"
has "a deployed copy that is the template with its placeholders filled matches it" "$(_tr)" "[x]"
# The comment a local copy keeps about its own Felix, and one of the template's
# own comments gone: neither changes what the workflow does.
_fill | sed -e '/^      # Pinned, to the full sha/i\
      # felix-home, not felix: see the Felix checkout in gate.yml.' \
            -e '/^# Wired, and off\./d' > "$UNF/.github/workflows/unattended.yml"
has "and still matches with its comments changed" "$(_tr)" "[x]"
# Elenchus's shape on 2026-09-23: the scope step before #323.
_fill | sed 's#if \[ "\$rc" = "0" \]; then#if [ "$rc" != "3" ]; then#' \
  > "$UNF/.github/workflows/unattended.yml"
_ln="$(grep -n 'if \[ "$rc" != "3" \]' "$UNF/.github/workflows/unattended.yml" | cut -d: -f1)"
out="$(_tr)"
has "a copy whose scope step drifted is unmet" "$out" "[ ]"
has "and the row names the line it drifted at" "$out" "line ${_ln:-?}"
_fill | grep -v "ref: '0123456789abcdef" > "$UNF/.github/workflows/unattended.yml"
has "a copy with no Felix pin does not match" "$(_tr)" "[ ]"
cp "$_tpl" "$UNF/.github/workflows/unattended.yml"
has "a copy with a placeholder left unfilled does not match" "$(_tr)" "[ ]"
_fill > "$UNF/.github/workflows/unattended.yml"
out="$(UNSTUB_WORKFLOWS='{"workflows":[{"name":"gate","path":".github/workflows/gate.yml","state":"active"}]}' _unatt)"
has "a repository with no unattended workflow says so" \
    "$(_row "$out" 'workflow matches template')" "no workflow named"
has "a workflow list that cannot be read is unknown, not unmet" \
    "$(UNSTUB_UNANSWERED=actions/workflows _tr)" "[?]"
unset UNSTUB_FILES UNSTUB_WORKFLOWS
fi

cp "$TMP/risk.unatt.keep" "$FROOT/projects/widget/risk.tsv"
( cd "$REPO" && git remote remove origin ) 2>/dev/null

printf '\ngenerated CI points at a path that exists\n'
# Moving the engine broke every generated workflow at once, in other
# repositories, where this suite never looks. Felix's own gate stayed green
# because it tests Felix. The caller lived elsewhere.
#
# So the generator's output is checked against the filesystem: whatever path it
# tells CI to run must actually resolve inside the engine.
gen="$( . "$FROOT/engine/harness/lib/detect.sh" 2>/dev/null || . "$FROOT/harness/lib/detect.sh"
        . "$FROOT/engine/harness/lib/bootstrap.sh" 2>/dev/null || . "$FROOT/harness/lib/bootstrap.sh"
        felix_bs_render_workflow node someone/repo )"
has "the workflow invokes felix" "$gen" "harness/felix"
felix_path="$(printf '%s' "$gen" | grep -oE '\.\./felix/[a-z/]*harness/felix' | head -1)"
resolved="${felix_path#../felix/}"
# Checked against the real checkout, not the fixture. A generated workflow runs
# against a clone of the actual repository, so that is the layout that has to be
# right, and the fixture flattens the engine in a way no clone does.
REAL_ROOT="$(cd "$REAL_HARNESS/../.." && pwd)"
if [ -x "$REAL_ROOT/$resolved" ]; then
  ok "and that path resolves in a real checkout"
else
  bad "and that path resolves in a real checkout" "generated $resolved, absent from $REAL_ROOT"
fi

printf '\ngenerated CI drops the credentials its checkouts fetched with\n'
# actions/checkout keeps what it fetched with unless told otherwise: the job
# token in repo/.git/config, and the Felix deploy key in a file felix/.git/config
# names. The gate then runs the pull request's own test code in that same job,
# which can read either, and nothing after the fetch needs them.
#
# So every checkout step is found in the rendered text and its own with: block
# is read. A key in a comment, in another step or in the header is not that
# step's input, and a render with no checkout step at all fails, not passes.
_wf_render() { ( . "$FROOT/engine/harness/lib/detect.sh" 2>/dev/null || . "$FROOT/harness/lib/detect.sh"
                 . "$FROOT/engine/harness/lib/bootstrap.sh" 2>/dev/null || . "$FROOT/harness/lib/bootstrap.sh"
                 felix_bs_render_workflow "$1" someone/repo ); }
# One row per actions/checkout step, whatever its version: ordinal, whether its
# with: sets persist-credentials to false, whether its with: holds ssh-key, and
# its path. Comment lines and block-scalar bodies (a run: | script) are skipped.
_wf_checkouts() { awk -v q="'" '
  function unq(v) { return (v ~ /^".*"$/ || (length(v) > 1 && substr(v, 1, 1) == q && substr(v, length(v)) == q)) ? substr(v, 2, length(v) - 2) : v }
  function flush() { if (ck) printf "%d\t%d\t%d\t%s\n", ++n, pc, ssh, (p == "" ? "-" : p); ck = 0 }
  BEGIN { bs = st = sd = -1 }
  /^[ \t]*#/ || /^[ \t]*$/ { next }
  {
    match($0, /^ */); ind = RLENGTH; body = substr($0, ind + 1)
    if (bs >= 0) { if (ind > bs) next; bs = -1 }
    sub(/[ \t]+#.*$/, "", body)
    item = 0; dash = ind
    if (body == "-" || substr(body, 1, 2) == "- ") {
      item = 1; body = substr(body, 2); match(body, /^ */); ind += 1 + RLENGTH; body = substr(body, RLENGTH + 1)
    }
    key = body; val = ""
    if (match(body, /^[^:]+:/) && (substr(body, RLENGTH + 1, 1) == "" || substr(body, RLENGTH + 1, 1) == " ")) {
      key = substr(body, 1, RLENGTH - 1); val = substr(body, RLENGTH + 1); sub(/^ +/, "", val); val = unq(val)
    }
    lead = item ? dash : ind
    if (st >= 0) {
      if (item && (sd < 0 ? (dash >= st) : (dash == sd))) { flush(); sd = dash; ki = ind; instep = 1; pc = ssh = 0; p = ""; wi = wc = -1 }
      else if (sd >= 0 ? (lead <= sd) : (lead <= st)) { flush(); st = sd = -1; instep = 0 }
    }
    if (instep && ind == ki) {
      if (key == "uses") ck = (val == "actions/checkout" || val ~ /^actions\/checkout@/)
      wi = (key == "with" && val == "") ? ind : -1; wc = -1
    } else if (instep && wi >= 0 && ind > wi) {
      if (wc < 0) wc = ind
      if (ind == wc && key == "persist-credentials" && val == "false") pc = 1
      if (ind == wc && key == "ssh-key" && val != "") ssh = 1
      if (ind == wc && key == "path") p = val
    }
    if (key == "steps" && val == "") { flush(); st = ind; sd = -1; instep = 0 }
    if (val ~ /^[|>][-+0-9]*$/) bs = ind
  }
  END { flush() }'; }
_wf_all=""; _wf_felix=""; _wf_repo=""
for _wf_eco in node python rust go nosuch; do
  _wf_rows="$(_wf_render "$_wf_eco" | _wf_checkouts)"
  [ -n "$_wf_rows" ] || _wf_all="$_wf_all, $_wf_eco renders no checkout step"
  _wf_hasf=0; _wf_hasr=0
  while IFS=$'\t' read -r _wf_n _wf_pc _wf_ssh _wf_path; do
    [ -n "$_wf_n" ] || continue
    _wf_at="$_wf_eco checkout $_wf_n (path: $_wf_path)"
    [ "$_wf_pc" = 1 ] || _wf_all="$_wf_all, $_wf_at keeps its credential"
    if [ "$_wf_ssh" = 1 ]; then
      _wf_hasf=1; [ "$_wf_pc" = 1 ] || _wf_felix="$_wf_felix, $_wf_at keeps the deploy key"
    fi
    if [ "$_wf_path" = repo ]; then
      _wf_hasr=1; [ "$_wf_pc" = 1 ] || _wf_repo="$_wf_repo, $_wf_at keeps the job token"
    fi
  done <<< "$_wf_rows"
  [ "$_wf_hasf" = 1 ] || _wf_felix="$_wf_felix, $_wf_eco renders no checkout with ssh-key"
  [ "$_wf_hasr" = 1 ] || _wf_repo="$_wf_repo, $_wf_eco renders no checkout at path: repo"
done
if [ -z "$_wf_all" ]; then ok "every checkout step in the generated workflow sets persist-credentials: false in its own with"
else bad "every checkout step in the generated workflow sets persist-credentials: false in its own with" "${_wf_all#, }"; fi
if [ -z "$_wf_felix" ]; then ok "and the Felix checkout, which holds the deploy key, drops it"
else bad "and the Felix checkout, which holds the deploy key, drops it" "${_wf_felix#, }"; fi
if [ -z "$_wf_repo" ]; then ok "and the project's own checkout drops the job token"
else bad "and the project's own checkout drops the job token" "${_wf_repo#, }"; fi

printf '\ngenerated CI grades against a pinned Felix\n'
# With no ref the Felix checkout took the default branch at the moment the job
# ran, so the verdict on one commit depended on when it was graded, and a merge
# in Felix nobody in the governed repository reviewed redefined its green. The
# line after repository: is read, not the whole output: the comment above the
# step names the placeholder too, so matching the output passed with the ref
# line deleted.
_pinwf() { ( . "$FROOT/harness/lib/detect.sh"; . "$FROOT/harness/lib/bootstrap.sh"
             felix_bs_render_workflow node someone/repo "$@" ) \
           | grep -A1 'repository: someone/repo' | sed -n 2p | tr -d ' '; }
_PINSHA="0123456789abcdef0123456789abcdef01234567"
is  "the generated workflow checks Felix out at the commit it was given" \
    "$(_pinwf "$_PINSHA")" "ref:'$_PINSHA'"
# Quoted, and the quotes are the assertion. Unquoted, YAML reads {{FELIX_REF}}
# as a mapping and GitHub refuses the whole file, so a required check that
# never reports stood where a failing checkout was meant to.
is  "and with no commit to give, at the placeholder, quoted so YAML reads a string" \
    "$(_pinwf)" "ref:'{{FELIX_REF}}'"
# Pinned to a commit, a checkout names its release only in the comment after
# the sha, so that is what is read. The comment is a claim a reviewer checks
# against the sha when the pin moves; nothing offline can.
is  "every checkout in the generated workflow is v5, the lowest major on Node 24" \
    "$(printf '%s\n' "$gen" | grep -c -E 'actions/checkout@[0-9a-f]{40} # v5\.')/$(printf '%s\n' "$gen" | grep -c 'actions/checkout@')" "2/2"

# The commit bootstrap pins is the engine source's HEAD, and only when origin's
# default branch holds it. Any remote branch would do for the checkout to
# succeed, which is why a pushed branch nobody merged is the case that matters:
# it fetches, and grades with an engine nobody reviewed.
_PS="$TMP/pinsrc"; _PC="$TMP/pinclone"
( git init -q -b main "$_PS" && cd "$_PS" \
  && git -c user.name=t -c user.email=t@t commit -q --allow-empty -m one \
  && git checkout -q -b side && git -c user.name=t -c user.email=t@t commit -q --allow-empty -m side \
  && git checkout -q main && git clone -q "$_PS" "$_PC" ) >/dev/null 2>&1
_pinref() { ( . "$FROOT/harness/lib/bootstrap.sh"; felix_bs_pin_ref "$1" || printf 'NONE' ); }
is  "a source whose HEAD is origin's default branch pins that commit, in full" \
    "$(_pinref "$_PC")" "$(git -C "$_PS" rev-parse main)"
( cd "$_PC" && git checkout -q --detach origin/side ) >/dev/null 2>&1
is  "a HEAD on a pushed branch the default branch does not hold pins nothing" \
    "$(_pinref "$_PC")" "NONE"
( cd "$_PC" && git checkout -q main \
  && git -c user.name=t -c user.email=t@t commit -q --allow-empty -m local ) >/dev/null 2>&1
is  "a HEAD only this machine holds pins nothing" "$(_pinref "$_PC")" "NONE"
# A clone made some other way may carry no origin/HEAD, and origin/main is
# still the default branch's name here.
( cd "$_PC" && git reset -q --hard origin/main && git remote set-head origin -d ) >/dev/null 2>&1
is  "and with no origin/HEAD, origin/main is the branch asked" \
    "$(_pinref "$_PC")" "$(git -C "$_PS" rev-parse main)"
# Bounded, because a $TMP under a directory that is itself a repository would
# otherwise answer for it.
mkdir -p "$TMP/pinnone"
is  "a source that is not a checkout pins nothing" \
    "$(GIT_CEILING_DIRECTORIES="$TMP" _pinref "$TMP/pinnone")" "NONE"

# origin/HEAD first. Every fixture above has a default branch named main, where
# the order cannot show; here it is trunk, and a main beside it holds a commit
# the default branch does not.
_PT="$TMP/pintrunk"; _PTC="$TMP/pintrunkclone"
( git init -q -b trunk "$_PT" && cd "$_PT" \
  && git -c user.name=t -c user.email=t@t commit -q --allow-empty -m one \
  && git checkout -q -b main && git -c user.name=t -c user.email=t@t commit -q --allow-empty -m two \
  && git checkout -q trunk && git clone -q "$_PT" "$_PTC" \
  && cd "$_PTC" && git checkout -q --detach origin/main ) >/dev/null 2>&1
is  "a HEAD only a branch named main holds, when the default branch is another, pins nothing" \
    "$(_pinref "$_PTC")" "NONE"

# The project, when asked about. CI resolves the project from the Felix it
# checked out, so a commit from before the project merged cannot govern it.
_pinproj() { ( . "$FROOT/harness/lib/bootstrap.sh"; felix_bs_pin_ref "$1" "$2" || printf 'NONE' ); }
( cd "$_PS" && mkdir -p projects/w && printf '{}\n' > projects/w/project.json && git add projects \
  && git -c user.name=t -c user.email=t@t commit -q -m project \
  && cd "$_PC" && git fetch -q origin && git checkout -q --detach origin/main ) >/dev/null 2>&1
is  "a commit holding the project it is asked about pins" \
    "$(_pinproj "$_PC" projects/w)" "$(git -C "$_PS" rev-parse main)"
( cd "$_PC" && git checkout -q --detach origin/main~1 ) >/dev/null 2>&1
is  "a commit on the default branch from before the project merged pins nothing" \
    "$(_pinproj "$_PC" projects/w)" "NONE"

printf '\ngenerated CI runs the action code its pins name, and no other\n'
# A tag is a ref its owner can move, so `actions/checkout@v5` runs whatever
# that repository points v5 at on the day the job runs, and one of those
# checkouts fetches Felix with FELIX_DEPLOY_KEY. Felix itself is checked out
# at a commit so the verdict is a function of the commit; an action on a tag
# is the same hole one line up. semgrep's github-actions-mutable-action-tag
# (1.175, p/github-actions) flags it. The unattended template is held to the
# same rule above, by the same reader of uses: keys.
#
# For every stack the workflow can be rendered for, and the stacks are read
# from bootstrap rather than listed here: each arm of the setup-step case, and
# each stack detection can report, which is how `none` reaches the fall-through
# arm. A stack added to either is held to the pin without this section being
# edited. No stack found, or a render with no uses: line, fails: a read that
# matched nothing would pass every file.
_gpstacks="$( . "$FROOT/harness/lib/bootstrap.sh"
              { declare -f _felix_bs_setup_block | awk '/^[ \t]*[A-Za-z0-9_| \t-]+\)$/ {
                  v = $0; gsub(/[ \t]/, "", v); sub(/\)$/, "", v); n = split(v, a, "|")
                  for (i = 1; i <= n; i++) if (a[i] != "") print a[i] }'
                declare -f felix_guess_ecosystem | awk '/^[ \t]*echo [A-Za-z0-9_-]+;?$/ {
                  v = $0; sub(/^[ \t]*echo /, "", v); sub(/;$/, "", v); print v }'
              } | LC_ALL=C sort -u )"
_gploose=""
[ -n "$_gpstacks" ] || _gploose=", no stack read from bootstrap"
for _gpst in $_gpstacks; do
  _gpuses="$( ( . "$FROOT/harness/lib/detect.sh"; . "$FROOT/harness/lib/bootstrap.sh"
                felix_bs_render_workflow "$_gpst" someone/repo ) \
              | awk '/^[ \t]*#/ { next }
                     /^[ \t]*(-[ \t]+)?uses:/ { v = $0
                       sub(/^[ \t]*(-[ \t]+)?uses:[ \t]*/, "", v); sub(/[ \t]+#.*$/, "", v)
                       print NR ": " v }' | tr -d "\"'")"
  if [ -z "$_gpuses" ]; then _gploose="$_gploose, $_gpst: no uses: line found"; continue; fi
  _gpbad="$(printf '%s\n' "$_gpuses" | grep -v -E '^[0-9]+: [^@[:space:]]+@[0-9a-f]{40}$')"
  [ -z "$_gpbad" ] || _gploose="$_gploose, $_gpst: $(printf '%s' "$_gpbad" | tr '\n' ';')"
done
if [ -z "$_gploose" ]; then
  ok  "every uses: in the gate workflow bootstrap renders names a full commit sha, for every stack it can render"
else
  bad "every uses: in the gate workflow bootstrap renders names a full commit sha, for every stack it can render" \
      "${_gploose#, }"
fi
# dtolnay/rust-toolchain chose the toolchain by the ref's name: @stable was a
# branch whose action.yml defaults it. At a commit on master, the history its
# README says a pin must come from, the input is required, so the step names it.
_gprust="$( ( . "$FROOT/harness/lib/detect.sh"; . "$FROOT/harness/lib/bootstrap.sh"
              felix_bs_render_workflow rust someone/repo ) \
            | awk '/uses: dtolnay\/rust-toolchain@/ { s = 1; next }
                   s && /^[ \t]*- / { s = 0 }
                   s && /^[ \t]*toolchain:[ \t]*stable[ \t]*$/ { n++ }
                   END { print n + 0 }')"
is  "and the rust toolchain step names stable itself, since a commit carries no channel" "$_gprust" "1"

printf '\nmistakes record themselves\n'
# Judgement at write time is the wrong shape: it asks for a decision at the exact
# moment someone is trying to finish something else. Write cheaply, curate later.
MISLOG="$MEM/widget/mistakes.log"
rm -f "$MISLOG"
# A script rather than an inline command: project.json holds no escaped quotes,
# which its reader documents that it cannot parse, and a gate script is the more
# common shape anyway.
cat > "$FROOT/projects/widget/failing-gate.sh" <<'GS'
#!/usr/bin/env bash
echo "  lint               FAIL"
exit 1
GS
chmod +x "$FROOT/projects/widget/failing-gate.sh"
python3 - "$FROOT/projects/widget/project.json" <<'PYJ'
import json,sys,pathlib
p=pathlib.Path(sys.argv[1]); d=json.loads(p.read_text())
d["gate"]="failing-gate.sh"
p.write_text(json.dumps(d,indent=2))
PYJ
( cd "$REPO" && "$FELIX" gate >/dev/null 2>&1 ); rc=$?
is "a failing gate still exits non-zero" "$rc" "1"
[ -f "$MISLOG" ] && ok "and records the failure without being asked" \
                 || bad "and records the failure without being asked"
grep -q 'lint' "$MISLOG" 2>/dev/null \
  && ok "naming which check failed" || bad "naming which check failed"
# And when, to the second. The file is shared by every session on the project,
# so its own time is whoever wrote last; felix_guard_unrecorded reads this
# column to tell this checkout's catch from a peer's appended after it.
_mst="$(tail -1 "$MISLOG" 2>/dev/null | cut -f5)"
case "$_mst" in
  ''|*[!0-9]*) bad "and the second it was caught, since the file's own time is whoever wrote last" "fifth column [$_mst]" ;;
  *) [ $(( $(date +%s) - _mst )) -lt 600 ] \
       && ok  "and the second it was caught, since the file's own time is whoever wrote last" \
       || bad "and the second it was caught, since the file's own time is whoever wrote last" "fifth column [$_mst]" ;;
esac

# The same tree gated again is the same occasion. It cost a second run, and a
# run is not a recurrence: this rank's advice is to write a lesson, and there
# is nothing to generalise from one incident. Felix's own log had `ecosystem`
# five times, every one of them the same branch at the same sha, ranked beside
# `installed` at twenty-two separate commits.
( cd "$REPO" && "$FELIX" gate >/dev/null 2>&1 )
out="$(cd "$REPO" && "$FELIX" promote 2>&1)"
case "$out" in
  *lint*) bad "one tree gated twice is one occasion, not a habit" "$out" ;;
  *)      ok  "one tree gated twice is one occasion, not a habit" ;;
esac
# A second tree is. Same failure, different commit — which is what "again"
# means and what a lesson would be generalising over.
( cd "$REPO" && printf 'again\n' >> README.md && git add -A \
  && git -c user.name=t -c user.email=t@t commit -qm second ) >/dev/null 2>&1
( cd "$REPO" && "$FELIX" gate >/dev/null 2>&1 )
out="$(cd "$REPO" && "$FELIX" promote 2>&1)"
has "a second tree makes it a promotion candidate" "$out" "the gate keeps catching"
has "and names the habit"                          "$out" "lint"
# Both numbers, because they are not the same fact: two trees, three runs.
has "counted in occasions"           "$out" "2    lint"
has "with the runs it cost beside it" "$out" "(3 run(s))"

# A check that could not have passed did not catch anything.
#
# Felix's `installed` check compares the tree against the deployed plugin cache.
# In a worktree that can never match — the marketplace is pinned to one path, so
# a worktree's engine is not the one being served — and every gate run there
# recorded `installed` as a mistake. The count went 9 to 11 during the session
# that fixed the recurrence report, and it sat at the top of `felix next` rank 5
# under "already cost time more than once", where the advice is to go and build
# a mechanism. The check manufactured the evidence that ranked it.
#
# The verdict is deliberately NOT changed: the gate still fails, because the
# tree genuinely does not match, and loosening a gate to quiet a report is the
# move this project warns about in the definition of its own objective. Only the
# RECORD changes. A gate may mark a failure as a property of where it ran rather
# than of the work, and the engine subtracts those from what it writes down
# without learning any check's name — the project's own gate declares it.
cat > "$FROOT/projects/widget/structural-gate.sh" <<'GS'
#!/usr/bin/env bash
echo "  lint               FAIL"
echo "  deployed           FAIL (structural: this tree is not the one that deploys)"
exit 1
GS
chmod +x "$FROOT/projects/widget/structural-gate.sh"
python3 - "$FROOT/projects/widget/project.json" <<'PYJ'
import json,sys,pathlib
p=pathlib.Path(sys.argv[1]); d=json.loads(p.read_text())
d["gate"]="structural-gate.sh"; p.write_text(json.dumps(d,indent=2))
PYJ
: > "$MISLOG"
( cd "$REPO" && "$FELIX" gate >/dev/null 2>&1 ); rc=$?
is "a structural failure still fails the gate" "$rc" "1"
grep -q 'lint' "$MISLOG" 2>/dev/null \
  && ok "an ordinary failure is still written down" \
  || bad "an ordinary failure is still written down" "$(cat "$MISLOG")"
grep -q 'deployed' "$MISLOG" 2>/dev/null \
  && bad "but one that could not have passed is not" "$(cat "$MISLOG")" \
  || ok  "but one that could not have passed is not"

# And when EVERY failure was structural, nothing is written — not even the
# exit-status fallback. The first version of this fixed the named check and then
# recorded `exit-1` instead, which is the same permanent row wearing a less
# informative name. Caught by running the real gate in a real worktree, which is
# where the case lives; the suite had passed.
cat > "$FROOT/projects/widget/structural-gate.sh" <<'GS'
#!/usr/bin/env bash
echo "  deployed           FAIL (structural: this tree is not the one that deploys)"
exit 1
GS
: > "$MISLOG"
( cd "$REPO" && "$FELIX" gate >/dev/null 2>&1 ); rc=$?
is "an all-structural gate still fails"           "$rc" "1"
is "and writes no row at all, not even exit-1"    "$(wc -l < "$MISLOG" | tr -d ' ')" "0"

# The contract, against the line the SHIPPED gate actually prints.
#
# Everything above proves the mechanism with a line the fixture writes itself,
# so it stayed green while the real marker was renamed out from under it: #115
# rewrote `FAIL (structural: ...)` into `FAIL (drift, in a tree that cannot
# deploy: ...)` to stop the message misdiagnosing a stray, and the engine
# greps for `structural`. Every worktree gate failure went back to recording a
# mistake — the manufactured evidence issue #3 was filed for — and it put
# `installed` at the top of `felix next` on a count that was 16 of 20
# work-in-progress branches. Two files, one string between them, and nothing
# joined them up. This renders the gate's own format and drives it through the
# real recording path.
_REALG3="$(cd "$REAL_HARNESS/../.." && pwd)/projects/felix/gate.sh"
if [ -f "$_REALG3" ]; then
  _sfmt="$(grep -F 'FAIL (' "$_REALG3" | grep -F 'marketplace serves' | head -1 \
           | sed "s/^[[:space:]]*printf '//; s/'[[:space:]]*installed.*$//")"
  if [ -n "$_sfmt" ]; then
    _sline="$(printf "$_sfmt" installed /some/marketplace 2>/dev/null)"
    has "the shipped gate marks its undeployable failure" "$_sline" "installed"
    printf '#!/usr/bin/env bash\nprintf "%%s\\n" %s\nexit 1\n' "$(printf '%q' "$_sline")" \
      > "$FROOT/projects/widget/structural-gate.sh"
    : > "$MISLOG"
    ( cd "$REPO" && "$FELIX" gate >/dev/null 2>&1 ); rc=$?
    is "and it still fails the gate"             "$rc" "1"
    is "and the engine writes no mistake for it" "$(wc -l < "$MISLOG" | tr -d ' ')" "0"
  else
    skip "the shipped gate marks its undeployable failure" "no such line in the gate"
    skip "and it still fails the gate"                     "no such line in the gate"
    skip "and the engine writes no mistake for it"         "no such line in the gate"
  fi
else
  skip "the shipped gate marks its undeployable failure" "no shipped gate"
  skip "and it still fails the gate"                     "no shipped gate"
  skip "and the engine writes no mistake for it"         "no shipped gate"
fi

# A gate that names nothing still falls back, because then the status is all
# anybody knows.
cat > "$FROOT/projects/widget/structural-gate.sh" <<'GS'
#!/usr/bin/env bash
echo "something went wrong but no check is named"
exit 3
GS
: > "$MISLOG"
( cd "$REPO" && "$FELIX" gate >/dev/null 2>&1 )
grep -q 'exit-3' "$MISLOG" 2>/dev/null \
  && ok "a gate naming no check still records its status" \
  || bad "a gate naming no check still records its status" "$(cat "$MISLOG")"

# A passing gate must not record anything, or the signal is just a run counter.
python3 - "$FROOT/projects/widget/project.json" <<'PYJ'
import json,sys,pathlib
p=pathlib.Path(sys.argv[1]); d=json.loads(p.read_text())
d["gate"]="true"; p.write_text(json.dumps(d,indent=2))
PYJ
before="$(wc -l < "$MISLOG")"
( cd "$REPO" && "$FELIX" gate >/dev/null 2>&1 )
is "a passing gate records nothing" "$(wc -l < "$MISLOG")" "$before"
# Caught a moment ago, and the lessons written below land within the same
# second on a fast runner, which the Stop hook's guard does not count as after
# the catch; the green stops further down would then hear about this catch
# instead of what they assert. Aged an hour here, stated like every other
# ordering this suite depends on.
_mag="$(( $(date +%s) - 3600 ))"
awk -F'\t' -v OFS='\t' -v T="$_mag" 'NF >= 5 { $5 = T } { print }' "$MISLOG" > "$TMP/mislog.aged"
cat "$TMP/mislog.aged" > "$MISLOG"

# An unborn HEAD is still one row.
#
# A repository that has been `git init`ed and not yet committed to is exactly
# where a project gets commissioned, and commissioning is where the gate has to
# be watched failing. There `git rev-parse --abbrev-ref HEAD` prints `HEAD` AND
# exits 128, so a `|| echo '?'` fallback does not replace the answer, it appends
# to it: the branch field became "HEAD\n?" and the record two lines, neither of
# them with a fourth column. Every reader of this log is `cut -f4` or awk's $4,
# so the failure was written down and could not be read. Found 2026-09-18 on a
# real commissioning, where `gate_shown_failing` stayed held on a gate that had
# genuinely been seen red.
#
# Driven through the real gate in a real unborn repository rather than by
# calling the writer, because the defect was in what git says there and a
# fixture that invents git's answer would have inherited the same assumption.
NOHEAD="$TMP/unborn-repo"; NOHEADP="$FROOT/projects/unbornproj"
mkdir -p "$NOHEAD" "$NOHEADP" "$MEM/unbornproj"
( cd "$NOHEAD" && git init -q -b main )
printf 'unbornproj\n' > "$NOHEAD/.felix"
printf 'untracked\n'  > "$NOHEAD/file.txt"
printf '{"name":"unbornproj","gate":"gate.sh"}\n' > "$NOHEADP/project.json"
cat > "$NOHEADP/gate.sh" <<'GS'
#!/usr/bin/env bash
echo "  lint               FAIL"
exit 1
GS
chmod +x "$NOHEADP/gate.sh"
NOHEADLOG="$MEM/unbornproj/mistakes.log"
( cd "$NOHEAD" && "$FELIX" gate >/dev/null 2>&1 ); rc=$?
is "a failing gate on an unborn HEAD still exits non-zero" "$rc" "1"
is "and records exactly one line for it"  "$(grep -c '' "$NOHEADLOG" 2>/dev/null)" "1"
# Six since rows carry the second they were caught and the session that
# caught them, appended after the four every reader takes.
is "of six tab-separated fields"          "$(awk -F'\t' '{ print NF }' "$NOHEADLOG" 2>/dev/null | sort -u | tr '\n' ' ')" "6 "
is "with the failed check in column four" "$(cut -f4 "$NOHEADLOG" 2>/dev/null | tr -d ' ')" "lint"
is "and says the commit is unborn rather than guessing one" "$(cut -f3 "$NOHEADLOG" 2>/dev/null)" "unborn"
# The reader the row was lost on, verbatim from templates/commissioning.tsv.
( FELIX_MEMORY_DIR="$MEM/unbornproj"
  cut -f4 "$FELIX_MEMORY_DIR/mistakes.log" 2>/dev/null | tr ' ' '\n' | grep -vxE 'commission|probes' | grep -q . ) \
  && ok  "so the commissioning check that reads column four sees the failure" \
  || bad "so the commissioning check that reads column four sees the failure" "$(od -c "$NOHEADLOG" 2>/dev/null | head -4)"
# The fallback status is a fourth field too, not only a named check.
cat > "$NOHEADP/gate.sh" <<'GS'
#!/usr/bin/env bash
echo "no check is named"
exit 2
GS
: > "$NOHEADLOG"
( cd "$NOHEAD" && "$FELIX" gate >/dev/null 2>&1 )
is "a gate naming nothing on an unborn HEAD records its status in column four" \
   "$(cut -f4 "$NOHEADLOG" 2>/dev/null)" "exit-2"
# The handoff names the same branch, from the same reader. Its line had no
# fallback, so it was never malformed: it printed `HEAD`, git's word for having
# no commit to abbreviate, to the next session as the branch of a repository
# that is on main. A project being commissioned is where a handoff gets written
# with no commit under it.
( cd "$NOHEAD" && "$FELIX" handoff "being commissioned" >/dev/null 2>&1 )
has "a handoff written on an unborn HEAD names the branch it is on" \
    "$(cat "$MEM/unbornproj/SESSION_HANDOFF.md" 2>/dev/null)" '- branch: `main`'

printf '\nfresh repositories: split mistakes rows heal, the project gate keeps its own failure, setup waits for a remote\n'
# A sweep of what a freshly created repository goes through on its first day
# found four defects that each kept `felix commission` from ever reading clean
# there, whatever the person did. They share this section because they share a
# fixture shape: a project bound by marker to a throwaway checkout, driven
# through the real CLI and the real hook, with memory seeded by hand wherever
# the defect is in what an older engine left on disk.
#
# Every block below builds a project of its own, so the widget, cmproj and
# unbornproj fixtures are read exactly as the sections around this one left
# them. An assertion that pins something which must NOT change first checks
# that the fixture really had the shape that would change it, or it would pass
# by finding nothing.
#
# Discovery's background refresh would start from the session-start calls here
# and reach for the network. Holding its lock for the section keeps the hook
# offline, and only a lock this section took is let go at the end.
_fh_dlock="$FROOT/state/discover/.lock"; _fh_dlock_mine=0
mkdir -p "$FROOT/state/discover" && mkdir "$_fh_dlock" 2>/dev/null && _fh_dlock_mine=1
_fh_today="$(date +%Y-%m-%d)"
_fh_sp=""

# A project, its memory, and a born checkout bound to it by marker, with no
# probes, qualification, obligations or commissioning table: the gate runs the
# project's own command and skips every engine check, unless a block adds one.
_fh_proj() {
  mkdir -p "$FROOT/projects/$1" "$MEM/$1" "$TMP/fr-$1"
  printf '{"name":"%s","gate":"%s"}\n' "$1" "$2" > "$FROOT/projects/$1/project.json"
  printf '# %s\n' "$1" > "$FROOT/projects/$1/CLAUDE.md"
  ( cd "$TMP/fr-$1" && git init -q -b main && printf '%s\n' "$1" > .felix && printf 'x\n' > README.md \
    && git add -A && git -c user.name=t -c user.email=t@t commit -qm init ) >/dev/null 2>&1
}
_fh_root()    { ( cd "$TMP/fr-$1" && pwd -P ); }
_fh_setgate() { printf '{"name":"%s","gate":"%s"}\n' "$1" "$2" > "$FROOT/projects/$1/project.json"; }
_fh_script()  { printf '#!/usr/bin/env bash\n%s\n' "$2" > "$FROOT/projects/$1/gate.sh"; chmod +x "$FROOT/projects/$1/gate.sh"; }
# What an engine before #267 wrote for one gate failure on an unborn HEAD:
# `rev-parse --abbrev-ref HEAD` printed HEAD and exited 128, so the `|| echo ?`
# fallback appended rather than replaced, and the row became two lines. Line A
# has two fields; line B has three, and column four is on neither.
_fh_legacy()  { printf '%s\tHEAD\n?\t?\t%s\n' "$1" "$2"; }
_fh_pairs()   { LC_ALL=C awk -F'\t' 'p && NF == 3 && $1 == "?" && $2 == "?" { n++ } { p = (NF == 2 && $2 == "HEAD") } END { print n + 0 }' "$1" 2>/dev/null; }
# The heal's temporaries and its lock, by the names the contract gives them.
_fh_left()    { ls -A "$1" 2>/dev/null | grep -E '^\.mistakes\.(lock|log\.(heal|orig)\..*)$' | tr '\n' ' '; }
_fh_same_mtime() { [ -e "$1" ] && [ -e "$2" ] && [ -z "$(find "$1" -newer "$2" 2>/dev/null)" ] && [ -z "$(find "$2" -newer "$1" 2>/dev/null)" ]; }
_fh_recur() { ( . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/memory.sh"; felix_mem_recurring_mistakes "$@" ) 2>/dev/null; }
_fh_items() { ( . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/detect.sh"
                . "$FROOT/harness/lib/procedures.sh"; felix_procedures_items "$1" ) 2>/dev/null; }
_fh_guard() { ( . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/guard.sh"; felix_guard_unrecorded "$1" ) 2>/dev/null; }
_fh_mon()   { ( . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/monitor.sh"; _felix_mon_project "$1" "$FROOT" ) 2>/dev/null; }
_fh_montotal() { printf '%s' "$1" | tr ',' '\n' | sed -n 's/.*"mistakesTotal":\([0-9]*\).*/\1/p' | head -n 1; }
_fh_monfirst() { printf '%s' "$1" | sed -n 's/.*"mistakes":\[\({[^}]*}\).*/\1/p' | head -n 1; }
_fh_cmhdr() { printf '# need\tgrounds\tinstrument\twhen\tanswer\tcheck\tstep\n'; }
_fh_cmrow() { grep -E "^$1$(printf '\t')" "$FROOT/harness/templates/commissioning.tsv" | head -n 1; }

# The reader the split row was lost on, copied verbatim from the template's
# gate_shown_failing row. templates/commissioning.tsv is an escape table, so
# this check cannot learn the split shape; the file has to be healed under it.
_fh_gsf_chk="$(awk -F'\t' '$1 == "gate_shown_failing" { print $6; exit }' "$FROOT/harness/templates/commissioning.tsv")"
has "the gate_shown_failing check is read verbatim from the template, and it reads column four" \
    "$_fh_gsf_chk" 'cut -f4 "$FELIX_MEMORY_DIR/mistakes.log"'
_fh_gsf() { ( FELIX_MEMORY_DIR="$1"; [ -n "$_fh_gsf_chk" ] || exit 99; eval "$_fh_gsf_chk" ) >/dev/null 2>&1; }

# ------------------------------------------------ the heal and its readers ----
# #267 fixed the writer, and every row written since is four fields. It did not
# touch what was already on disk: an install whose gate failed on an unborn HEAD
# before #267 keeps a two-line row that gate_shown_failing cannot read, so that
# row stays held however many times the person has watched the gate go red.
# The heal joins such a pair into the row #267 would have written, in place,
# and never touches anything else.
_fh_proj healproj true
_fh_r="$(_fh_root healproj)"; _fh_l="$MEM/healproj/mistakes.log"
printf '2026-09-01\tHEAD\tunborn\tlint \n' > "$TMP/fh-one.expect"
_fh_legacy 2026-09-01 'lint ' > "$_fh_l"
is "the fixture writes the legacy split shape: a two-field HEAD line, then a three-field ?-? line" \
   "$(awk -F'\t' '{ printf "%s ", NF }' "$_fh_l")pairs=$(_fh_pairs "$_fh_l")" "2 3 pairs=1"
_fh_gsf "$MEM/healproj" \
  && bad "before any heal, gate_shown_failing cannot see the failure the split rows hold" "it read done on the split file, so a heal proves nothing below" \
  || ok  "before any heal, gate_shown_failing cannot see the failure the split rows hold"
( cd "$_fh_r" && "$FELIX" gate >/dev/null 2>&1 ); _fh_rc=$?
is "a passing gate over a split row still exits 0" "$_fh_rc" "0"
_fh_healed=0; cmp -s "$_fh_l" "$TMP/fh-one.expect" && _fh_healed=1
[ "$_fh_healed" -eq 1 ] \
  && ok  "and the pair becomes one row, byte for byte: the date, HEAD, unborn, and the checks with their trailing space" \
  || bad "and the pair becomes one row, byte for byte: the date, HEAD, unborn, and the checks with their trailing space" "$(od -c "$_fh_l" | head -n 3)"
is "a healed pair is one line"                     "$(grep -c '' "$_fh_l")" "1"
is "and a healed pair has four tab-separated fields" "$(awk -F'\t' '{ print NF }' "$_fh_l" | sort -u | tr '\n' ' ')" "4 "
_fh_gsf "$MEM/healproj" \
  && ok  "so gate_shown_failing reads done after the heal, with no second failing gate" \
  || bad "so gate_shown_failing reads done after the heal, with no second failing gate" "$(cut -f4 "$_fh_l" | od -c | head -n 2)"

# Idempotent. Both mtimes are set to 2020 first, so a rewrite that restored
# nothing would show.
cp "$_fh_l" "$TMP/fh-once.copy"; touch -t 202001010000 "$_fh_l" "$TMP/fh-once.ref"
( cd "$_fh_r" && "$FELIX" gate >/dev/null 2>&1 )
if [ "$_fh_healed" -ne 1 ]; then
  bad "a healed file gated again is left alone: the same bytes and the same mtime" \
      "the first gate did not heal the file, so a second one that leaves it alone proves nothing"
elif cmp -s "$_fh_l" "$TMP/fh-once.copy" && _fh_same_mtime "$_fh_l" "$TMP/fh-once.ref"; then
  ok  "a healed file gated again is left alone: the same bytes and the same mtime"
else
  bad "a healed file gated again is left alone: the same bytes and the same mtime" "$(ls -l "$_fh_l"; od -c "$_fh_l" | head -n 3)"
fi

# Every row keeps its place. Line 1 ends without a trailing space and line 5
# with one, so a heal that re-wrote rows rather than copying them would show.
{ printf '2026-09-01\tmain\tabc1234\tlint\n'; _fh_legacy 2026-09-02 'lint '
  printf '2026-09-03\tmain\tdef5678\texit-2\n'; _fh_legacy 2026-09-04 'exit-1'
  printf '2026-09-05\tmain\t0a0a0a0\tprobes \n'; } > "$_fh_l"
( cd "$_fh_r" && "$FELIX" gate >/dev/null 2>&1 )
is "a mixed file of seven lines holding two pairs heals to five" "$(grep -c '' "$_fh_l")" "5"
is "and its well-formed rows keep their bytes and their places: lines 1, 3 and 5" \
   "$(sed -n '1p;3p;5p' "$_fh_l")" \
   "$(printf '2026-09-01\tmain\tabc1234\tlint\n2026-09-03\tmain\tdef5678\texit-2\n2026-09-05\tmain\t0a0a0a0\tprobes ')"
is "and each pair is joined where it stood: lines 2 and 4" \
   "$(sed -n '2p;4p' "$_fh_l")" \
   "$(printf '2026-09-02\tHEAD\tunborn\tlint \n2026-09-04\tHEAD\tunborn\texit-1')"

# Only a real pair is joined. A HEAD line followed by anything but the ?-? line,
# a ?-? line with no HEAD line before it, a ?-? line of four fields, a HEAD line
# whose first field is not a date, and a HEAD line with nothing after it are all
# left exactly where they are.
{ printf '2026-09-01\tHEAD\n2026-09-01\tmain\tabc\tx\n'
  printf '?\t?\torphan\n'
  printf '2026-09-02\tHEAD\n?\t?\ta\tb\n'
  printf 'yesterday\tHEAD\n?\t?\ty\n'
  _fh_legacy 2026-09-03 'lint '
  printf '2026-09-04\tHEAD\n'; } > "$_fh_l"
cp "$_fh_l" "$TMP/fh-frag.seed"
( cd "$_fh_r" && "$FELIX" gate >/dev/null 2>&1 )
is "fragments that cannot pair keep their bytes and their places" \
   "$(head -n 7 "$_fh_l")" "$(head -n 7 "$TMP/fh-frag.seed")"
is "and a HEAD line left last, with nothing to pair with, keeps its bytes" \
   "$(tail -n 1 "$_fh_l")" "$(printf '2026-09-04\tHEAD')"
is "while the one real pair among them is joined in place, one line shorter" \
   "$(grep -c '' "$_fh_l") $(sed -n 8p "$_fh_l")" "9 $(printf '2026-09-03\tHEAD\tunborn\tlint ')"

# The mode is kept: a heal builds its replacement beside the log and renames it
# over, and a new file would otherwise take the umask.
_fh_legacy 2026-09-01 'lint ' > "$_fh_l"; chmod 600 "$_fh_l"
_fh_mode0="$(ls -l "$_fh_l" | cut -c1-10)"
( cd "$_fh_r" && "$FELIX" gate >/dev/null 2>&1 )
_fh_mode="$(ls -l "$_fh_l" | cut -c1-10)"
if [ "$_fh_mode0" != "-rw-------" ]; then
  bad "a heal keeps the log's mode: a 600 log is healed and is still 600" "the fixture could not make the log 600 ($_fh_mode0)"
elif ! cmp -s "$_fh_l" "$TMP/fh-one.expect"; then
  bad "a heal keeps the log's mode: a 600 log is healed and is still 600" "the file was not healed, so its mode proves nothing"
elif [ "$_fh_mode" = "-rw-------" ]; then
  ok  "a heal keeps the log's mode: a 600 log is healed and is still 600"
else
  bad "a heal keeps the log's mode: a 600 log is healed and is still 600" "mode is now $_fh_mode"
fi
chmod 644 "$_fh_l"

# A log whose last line has no newline is either being written or was edited
# by hand, and either way the heal declines. Readers still read it joined.
{ _fh_legacy 2026-09-01 'lint '; printf '2026-09-02\tmain\tabc\tlint'; } > "$_fh_l"
cp "$_fh_l" "$TMP/fh-nonl.seed"
( cd "$_fh_r" && "$FELIX" gate >/dev/null 2>&1 )
if [ "$(tail -c 1 "$TMP/fh-nonl.seed" | od -An -tx1 | tr -d ' \n')" = "0a" ] || [ "$(_fh_pairs "$TMP/fh-nonl.seed")" != "1" ]; then
  bad "a log whose last line has no newline is left byte for byte, pair and all" "the fixture did not seed a pair and an unterminated last line"
elif cmp -s "$_fh_l" "$TMP/fh-nonl.seed"; then
  ok  "a log whose last line has no newline is left byte for byte, pair and all"
else
  bad "a log whose last line has no newline is left byte for byte, pair and all" "$(od -c "$_fh_l" | head -n 4)"
fi

# A well-formed log is the case on every install, every session: it must come
# through a gate and a session start with its bytes and its mtime, and with no
# lock or temporary left beside it.
_fh_proj healhook true
_fh_kr="$(_fh_root healhook)"; _fh_kl="$MEM/healhook/mistakes.log"
printf '2026-09-01\tmain\tunborn\tlint \n2026-09-02\tmain\tabc1234\tlint \n' > "$_fh_kl"
touch -t 202001010000 "$_fh_kl" "$TMP/fh-keep.ref"; cp -p "$_fh_kl" "$TMP/fh-keep.copy"
( cd "$_fh_kr" && "$FELIX" gate >/dev/null 2>&1 ); _fh_rc=$?
( cd "$_fh_kr" && CLAUDE_PLUGIN_ROOT="$FROOT" "$FROOT/harness/hooks/session-start" ) >/dev/null 2>&1
if [ "$_fh_rc" -ne 0 ] || [ "$(_fh_pairs "$TMP/fh-keep.copy")" != "0" ]; then
  bad "a well-formed log is byte for byte what it was after a gate and a session start" "the fixture's gate exited $_fh_rc, or the log was not well-formed"
elif cmp -s "$_fh_kl" "$TMP/fh-keep.copy"; then
  ok  "a well-formed log is byte for byte what it was after a gate and a session start"
else
  bad "a well-formed log is byte for byte what it was after a gate and a session start" "$(od -c "$_fh_kl" | head -n 4)"
fi
_fh_same_mtime "$_fh_kl" "$TMP/fh-keep.ref" \
  && ok  "and keeps its mtime" \
  || bad "and keeps its mtime" "$(ls -l "$_fh_kl" "$TMP/fh-keep.ref")"
is "and nothing of a heal is left in its memory directory" "$(_fh_left "$MEM/healhook")" ""

# session-start is the entry point that runs on every install, whatever the
# gate did last. It must heal silently: any byte it adds to its own output
# corrupts the JSON Claude Code reads.
_fh_legacy 2026-09-01 'lint ' > "$_fh_kl"
_fh_ss="$(cd "$_fh_kr" && CLAUDE_PLUGIN_ROOT="$FROOT" "$FROOT/harness/hooks/session-start" 2>"$TMP/fh-ss.err")"
cmp -s "$_fh_kl" "$TMP/fh-one.expect" \
  && ok  "a session start heals a split row" \
  || bad "a session start heals a split row" "$(od -c "$_fh_kl" | head -n 3)"
_fh_js="$(printf '%s' "$_fh_ss" | python3 -c 'import json,sys; print("hookSpecificOutput" in json.load(sys.stdin))' 2>/dev/null)"
if [ "${_fh_ss:0:1}" = "{" ] && [ "$_fh_js" = "True" ] && [ ! -s "$TMP/fh-ss.err" ]; then
  ok  "and its output is still one JSON object carrying hookSpecificOutput, with nothing on stderr"
else
  bad "and its output is still one JSON object carrying hookSpecificOutput, with nothing on stderr" \
      "stdout begins [${_fh_ss:0:40}] json=[$_fh_js] stderr=[$(head -c 200 "$TMP/fh-ss.err")]"
fi

# The mtime is kept, because felix_guard_unrecorded compares it with the
# lessons and the devlog. A heal that bumped it would make the Stop hook say the
# gate caught something nobody wrote down, in a session where nothing failed.
_fh_proj healtime true
_fh_tr="$(_fh_root healtime)"; _fh_tl="$MEM/healtime/mistakes.log"
_fh_legacy "$_fh_today" 'lint ' > "$_fh_tl"
printf '%s\tHEAD\tunborn\tlint \n' "$_fh_today" > "$TMP/fh-time.expect"
touch -t 202001010000 "$_fh_tl" "$TMP/fh-time.ref"
_fh_yday="$(date -v-1d +%Y%m%d%H%M 2>/dev/null || date -d '1 day ago' +%Y%m%d%H%M)"
: > "$MEM/healtime/lessons.md"; touch -t "$_fh_yday" "$MEM/healtime/lessons.md"
( cd "$_fh_tr" && "$FELIX" gate >/dev/null 2>&1 )
_fh_th=0; cmp -s "$_fh_tl" "$TMP/fh-time.expect" && _fh_th=1
[ "$_fh_th" -eq 1 ] \
  && ok  "a split row dated today is healed" \
  || bad "a split row dated today is healed" "$(od -c "$_fh_tl" | head -n 3)"
if [ "$_fh_th" -ne 1 ]; then
  bad "and the heal keeps the log's mtime" "no heal ran, so an unchanged mtime proves nothing"
  bad "so the Stop hook's guard stays quiet: the healed log is not newer than the last lesson" "no heal ran, so a quiet guard proves nothing"
else
  _fh_same_mtime "$_fh_tl" "$TMP/fh-time.ref" \
    && ok  "and the heal keeps the log's mtime" \
    || bad "and the heal keeps the log's mtime" "$(ls -l "$_fh_tl" "$TMP/fh-time.ref")"
  _fh_gu="$(_fh_guard "$FROOT/projects/healtime")"
  is "so the Stop hook's guard stays quiet: the healed log is not newer than the last lesson" "${#_fh_gu}" "0"
fi

# A writer that takes no lock (an older engine in a session that has not
# restarted, or a person's >>) can append between the heal's snapshot and its
# rename. The stub `mv` lands exactly there: it appends to the log it is about
# to replace, then does the rename. The heal must find that row on the inode it
# pinned and carry it over.
_fh_proj healrace true
_fh_rr="$(_fh_root healrace)"; _fh_rl="$MEM/healrace/mistakes.log"
{ _fh_legacy 2026-09-01 'lint '; printf '2026-09-02\tmain\tabc1234\tlint \n'; } > "$_fh_rl"
mkdir -p "$TMP/fh-mvstub"
cat > "$TMP/fh-mvstub/mv" <<'STUB'
#!/usr/bin/env bash
for _last in "$@"; do :; done
case "$_last" in
  */mistakes.log) printf '2026-09-09\tmain\tabc1234\tconcurrent\n' >> "$_last" ;;
esac
exec /bin/mv "$@"
STUB
chmod +x "$TMP/fh-mvstub/mv"
( cd "$_fh_rr" && PATH="$TMP/fh-mvstub:$PATH" "$FELIX" gate >/dev/null 2>&1 )
_fh_rh=0
[ "$(sed -n '1p;2p' "$_fh_rl")" = "$(printf '2026-09-01\tHEAD\tunborn\tlint \n2026-09-02\tmain\tabc1234\tlint ')" ] && _fh_rh=1
[ "$_fh_rh" -eq 1 ] \
  && ok  "a heal raced by an unlocked append keeps its own rows first: the joined pair, then the row that was there" \
  || bad "a heal raced by an unlocked append keeps its own rows first: the joined pair, then the row that was there" "$(cat "$_fh_rl")"
is "and the row appended mid-heal survives exactly once, as the last of three lines" \
   "$(grep -c 'concurrent' "$_fh_rl")|$(tail -n 1 "$_fh_rl")|$(grep -c '' "$_fh_rl")" \
   "1|$(printf '2026-09-09\tmain\tabc1234\tconcurrent')|3"
if [ "$_fh_rh" -eq 1 ]; then
  is "and the raced heal leaves no temporary, link or lock behind" "$(_fh_left "$MEM/healrace")" ""
else
  bad "and the raced heal leaves no temporary, link or lock behind" "no heal ran, so an empty directory proves nothing"
fi

# The lock. Tests create it by hand to simulate a holder, so its name and its
# pid file are part of the contract: <memory>/.mistakes.lock/pid.
_fh_proj heallock true
_fh_cr="$(_fh_root heallock)"; _fh_cm="$MEM/heallock"; _fh_cl="$_fh_cm/mistakes.log"; _fh_ck="$_fh_cm/.mistakes.lock"
_fh_script heallock 'echo "  lint               FAIL"; exit 1'
sleep 600 & _fh_sp=$!
mkdir "$_fh_ck"; printf '%s\n' "$_fh_sp" > "$_fh_ck/pid"
_fh_legacy 2026-09-01 'lint ' > "$_fh_cl"; cp "$_fh_cl" "$TMP/fh-lock.seed"
( cd "$_fh_cr" && "$FELIX" gate >/dev/null 2>&1 )
if [ "$_fh_healed" -ne 1 ]; then
  bad "a live owner's lock stops the heal: the split file is left as it was" \
      "the heal never ran on a passing gate above, so a file left alone here proves nothing"
else
  cmp -s "$_fh_cl" "$TMP/fh-lock.seed" \
    && ok  "a live owner's lock stops the heal: the split file is left as it was" \
    || bad "a live owner's lock stops the heal: the split file is left as it was" "$(cat "$_fh_cl")"
fi
# A row is never lost to a lock: the writer waits a bounded time and then
# appends anyway. The deadline is a minute rather than the few seconds the
# wait costs, because this machine's load has turned wall-clock bounds red
# before, and what is asserted is that the wait ends, not how fast.
touch "$_fh_ck"; _fh_setgate heallock gate.sh
_fh_n0="$(grep -c '' "$_fh_cl")"
( cd "$_fh_cr" && "$FELIX" gate >/dev/null 2>&1 ) & _fh_gp=$!
_fh_w=0; while kill -0 "$_fh_gp" 2>/dev/null && [ "$_fh_w" -lt 60 ]; do sleep 1; _fh_w=$((_fh_w + 1)); done
if kill -0 "$_fh_gp" 2>/dev/null; then
  kill "$_fh_gp" 2>/dev/null; wait "$_fh_gp" 2>/dev/null; _fh_grc=timeout
else
  wait "$_fh_gp"; _fh_grc=$?
fi
is "a failing gate under a live lock still appends its row and exits 1, without waiting on the lock for good" \
   "$_fh_grc|$(( $(grep -c '' "$_fh_cl") - _fh_n0 ))|$(tail -n 1 "$_fh_cl" | cut -f4)" "1|1|lint "
_fh_setgate heallock true
# The owner gone, its lock is stale and is taken over.
kill "$_fh_sp" 2>/dev/null; wait "$_fh_sp" 2>/dev/null; _fh_sp=""
sh -c 'exit 0' & _fh_dp=$!; wait "$_fh_dp"
printf '%s\n' "$_fh_dp" > "$_fh_ck/pid"
( cd "$_fh_cr" && "$FELIX" gate >/dev/null 2>&1 )
is "a lock whose owner has exited is taken over, and the pair joined" \
   "$(grep -c '' "$_fh_cl")|$(head -n 1 "$_fh_cl")" "2|$(printf '2026-09-01\tHEAD\tunborn\tlint ')"
[ -d "$_fh_ck" ] \
  && bad "and the heal that took it over leaves no lock behind" "$(ls -la "$_fh_ck")" \
  || ok  "and the heal that took it over leaves no lock behind"
# A holder that died between mkdir and writing its pid leaves a lock with no
# pid. Younger than a minute it is live; older, it is taken over.
rm -rf "$_fh_ck"; mkdir "$_fh_ck"; touch -t 202001010000 "$_fh_ck"
_fh_legacy 2026-09-01 'lint ' > "$_fh_cl"
if [ -z "$(find "$_fh_ck" -maxdepth 0 -mmin +1 2>/dev/null)" ]; then
  bad "a lock with no pid, over a minute old, is taken over: the file is healed and the lock gone" "the fixture could not age the lock directory"
else
  ( cd "$_fh_cr" && "$FELIX" gate >/dev/null 2>&1 )
  if cmp -s "$_fh_cl" "$TMP/fh-one.expect" && [ ! -d "$_fh_ck" ]; then
    ok  "a lock with no pid, over a minute old, is taken over: the file is healed and the lock gone"
  else
    bad "a lock with no pid, over a minute old, is taken over: the file is healed and the lock gone" \
        "lock=$([ -d "$_fh_ck" ] && echo held || echo gone) $(od -c "$_fh_cl" | head -n 2)"
  fi
fi
# Leftovers of a heal killed part way are the engine's own temporaries, never
# memory, and the next heal clears the ones over a minute old. A young one may
# belong to a heal still running, and stays.
rm -rf "$_fh_ck"
_fh_legacy 2026-09-01 'lint ' > "$_fh_cl"
: > "$_fh_cm/.mistakes.log.heal.12345"; : > "$_fh_cm/.mistakes.log.orig.12345"
touch -t 202001010000 "$_fh_cm/.mistakes.log.heal.12345" "$_fh_cm/.mistakes.log.orig.12345"
: > "$_fh_cm/.mistakes.log.heal.99999"
( cd "$_fh_cr" && "$FELIX" gate >/dev/null 2>&1 )
_fh_gone=0
[ ! -e "$_fh_cm/.mistakes.log.heal.12345" ] && [ ! -e "$_fh_cm/.mistakes.log.orig.12345" ] && _fh_gone=1
[ "$_fh_gone" -eq 1 ] \
  && ok  "a heal clears the leftovers of one killed part way, once they are over a minute old" \
  || bad "a heal clears the leftovers of one killed part way, once they are over a minute old" "$(ls -A "$_fh_cm" | tr '\n' ' ')"
if [ "$_fh_gone" -ne 1 ]; then
  bad "but leaves a temporary younger than a minute to whoever owns it" "the old leftovers were not cleared, so a young one surviving proves nothing"
else
  [ -e "$_fh_cm/.mistakes.log.heal.99999" ] \
    && ok  "but leaves a temporary younger than a minute to whoever owns it" \
    || bad "but leaves a temporary younger than a minute to whoever owns it"
fi
rm -f "$_fh_cm/.mistakes.log.heal.99999"

# Two gates at once, each failing, each healing: the lock orders them, so the
# two pairs are joined once and both new rows land.
_fh_proj healproj2 gate.sh
_fh_script healproj2 'echo "  lint               FAIL"; exit 1'
_fh_2a="$(_fh_root healproj2)"; _fh_2b="$TMP/fr-healproj2-b"; mkdir -p "$_fh_2b"
( cd "$_fh_2b" && git init -q -b main && printf 'healproj2\n' > .felix && printf 'y\n' > README.md \
  && git add -A && git -c user.name=t -c user.email=t@t commit -qm init ) >/dev/null 2>&1
_fh_2b="$(cd "$_fh_2b" && pwd -P)"; _fh_2l="$MEM/healproj2/mistakes.log"
{ _fh_legacy 2026-09-01 'x '; _fh_legacy 2026-09-02 'y '; } > "$_fh_2l"
( cd "$_fh_2a" && "$FELIX" gate >/dev/null 2>&1 ) & _fh_2pa=$!
( cd "$_fh_2b" && "$FELIX" gate >/dev/null 2>&1 ) & _fh_2pb=$!
wait "$_fh_2pa"; wait "$_fh_2pb"
is "two failing gates at once over two split pairs leave four lines, the healed pairs of four fields and the gates' own rows of six" \
   "$(grep -c '' "$_fh_2l") $(awk -F'\t' '{ print NF }' "$_fh_2l" | sort | tr '\n' ' ')" "4 4 4 6 6 "
_fh_2j="$(grep -cxF "$(printf '2026-09-01\tHEAD\tunborn\tx ')" "$_fh_2l") $(grep -cxF "$(printf '2026-09-02\tHEAD\tunborn\ty ')" "$_fh_2l")"
is "and each pair is joined exactly once" "$_fh_2j" "1 1"
is "and both gates' own rows are kept, one each" "$(awk -F'\t' '$4 == "lint "' "$_fh_2l" | grep -c '')" "2"
if [ "$_fh_2j" = "1 1" ]; then
  is "and two heals at once leave no temporary or lock behind" "$(_fh_left "$MEM/healproj2")" ""
else
  bad "and two heals at once leave no temporary or lock behind" "the pairs were not joined, so an empty directory proves nothing"
fi

# A symlinked log is not replaced: renaming onto it would turn the link into a
# regular file. It is still read joined, through the readers below.
_fh_proj healsym true
_fh_legacy "$_fh_today" 'lint ' > "$TMP/fh-symtarget.log"; cp "$TMP/fh-symtarget.log" "$TMP/fh-symtarget.copy"
ln -s "$TMP/fh-symtarget.log" "$MEM/healsym/mistakes.log"
( cd "$(_fh_root healsym)" && "$FELIX" gate >/dev/null 2>&1 )
[ -L "$MEM/healsym/mistakes.log" ] \
  && ok  "a symlinked log is still a symlink after a gate" \
  || bad "a symlinked log is still a symlink after a gate" "$(ls -l "$MEM/healsym/mistakes.log")"
cmp -s "$TMP/fh-symtarget.log" "$TMP/fh-symtarget.copy" && [ "$(_fh_pairs "$TMP/fh-symtarget.copy")" = "1" ] \
  && ok  "and the split file it points at is byte for byte what it was" \
  || bad "and the split file it points at is byte for byte what it was" "$(od -c "$TMP/fh-symtarget.log" | head -n 3)"
is "and the recurrence report still reads the failure through the link" \
   "$(_fh_recur "$FROOT/projects/healsym" 1)" "$(printf '1\tlint\t%s\t1' "$_fh_today")"
has "and procedures still name it through the link" "$(_fh_items "$FROOT/projects/healsym")" "failure:lint"
has "and the Stop hook's guard still names it through the link" "$(_fh_guard "$FROOT/projects/healsym")" "last caught   lint"

# The other entry points. A failing gate heals before it records, so its own
# row lands after the healed one.
_fh_proj healfail gate.sh
_fh_script healfail 'echo "  lint               FAIL"; exit 1'
_fh_legacy 2026-09-01 'a ' > "$MEM/healfail/mistakes.log"
( cd "$(_fh_root healfail)" && "$FELIX" gate >/dev/null 2>&1 )
is "a failing gate heals the split row too, and its own row follows: two lines, the healed one first" \
   "$(grep -c '' "$MEM/healfail/mistakes.log")|$(head -n 1 "$MEM/healfail/mistakes.log")|$(tail -n 1 "$MEM/healfail/mistakes.log" | cut -f4)" \
   "2|$(printf '2026-09-01\tHEAD\tunborn\ta ')|lint "

# felix commission heals before it asks its rows, so gate_shown_failing is read
# on the healed file. --status writes nothing, and so heals nothing.
_fh_proj healcm true
_fh_mr="$(_fh_root healcm)"; _fh_mp="$FROOT/projects/healcm"; _fh_ml="$MEM/healcm/mistakes.log"
cp "$FROOT/harness/templates/profiles.tsv" "$FROOT/harness/templates/routes.tsv" "$_fh_mp/"
{ _fh_cmhdr; _fh_cmrow gate_shown_failing; printf 'marker\t-\t-\t-\t-\ttest -f .felix\t9\n'; } > "$_fh_mp/commissioning.tsv"
_fh_legacy 2026-09-01 'lint ' > "$_fh_ml"; cp "$_fh_ml" "$TMP/fh-cm.seed"
( cd "$_fh_mr" && PATH="$CMSTUB:$PATH" "$FELIX" commission --status ) >/dev/null 2>&1
if [ "$(_fh_pairs "$TMP/fh-cm.seed")" != "1" ]; then
  bad "felix commission --status leaves a split log byte for byte, because it writes nothing" "the fixture did not seed a pair"
elif cmp -s "$_fh_ml" "$TMP/fh-cm.seed"; then
  ok  "felix commission --status leaves a split log byte for byte, because it writes nothing"
else
  bad "felix commission --status leaves a split log byte for byte, because it writes nothing" "$(od -c "$_fh_ml" | head -n 3)"
fi
_fh_cmo="$(cd "$_fh_mr" && PATH="$CMSTUB:$PATH" "$FELIX" commission 2>&1)"
cmp -s "$_fh_ml" "$TMP/fh-one.expect" \
  && ok  "a full felix commission heals the split row" \
  || bad "a full felix commission heals the split row" "$(od -c "$_fh_ml" | head -n 3)"
is "so its report shows gate_shown_failing done" \
   "$(printf '%s\n' "$_fh_cmo" | grep -cE '^  done +gate_shown_failing( |$)')" "1"

# The one transform, from resolve.sh alone, because every entry point sources
# resolve.sh first, and so do the suite's single-lib subshells.
_fh_rowsof() { bash -c '. "$1/lib/resolve.sh" && felix_mem_mistake_rows "$2"' _ "$FROOT/harness" "$1"; }
_fh_legacy 2026-09-01 'lint ' > "$TMP/fh-reader.log"; cp "$TMP/fh-reader.log" "$TMP/fh-reader.copy"
_fh_rowsof "$TMP/fh-reader.log" > "$TMP/fh-reader.out" 2>/dev/null
if cmp -s "$TMP/fh-reader.out" "$TMP/fh-one.expect" && cmp -s "$TMP/fh-reader.log" "$TMP/fh-reader.copy"; then
  ok  "felix_mem_mistake_rows, with resolve.sh alone, reads a split pair as its one joined row and leaves the file as it was"
else
  bad "felix_mem_mistake_rows, with resolve.sh alone, reads a split pair as its one joined row and leaves the file as it was" \
      "$(od -c "$TMP/fh-reader.out" | head -n 3)"
fi
printf '2026-09-01\tmain\tabc1234\tlint \n2026-09-02\tHEAD\tunborn\tx\n' > "$TMP/fh-reader-wf.log"
_fh_rowsof "$TMP/fh-reader-wf.log" > "$TMP/fh-reader-wf.out" 2>/dev/null
[ -s "$TMP/fh-reader-wf.out" ] && cmp -s "$TMP/fh-reader-wf.out" "$TMP/fh-reader-wf.log" \
  && ok  "and passes a well-formed file through byte for byte" \
  || bad "and passes a well-formed file through byte for byte" "$(od -c "$TMP/fh-reader-wf.out" | head -n 3)"
_fh_miss="$(_fh_rowsof "$TMP/fh-no-such.log" 2>&1)"; _fh_missrc=$?
is "and prints nothing for a missing file, returning 0" "$_fh_missrc|$_fh_miss" "0|"

# The readers, on a log nothing has healed: the heal can decline, and
# felix commission --status never heals, so each reader reads through the
# transform and is right either way. Seeded by hand; no gate or hook runs.
_fh_ep="$FROOT/projects/healread"; mkdir -p "$_fh_ep" "$MEM/healread"
printf '{"name":"healread","gate":"true"}\n' > "$_fh_ep/project.json"
_fh_el="$MEM/healread/mistakes.log"
{ _fh_legacy "$_fh_today" 'lint '; _fh_legacy "$_fh_today" 'lint '; printf '%s\tmain\tabc1234\tlint \n' "$_fh_today"; } > "$_fh_el"
is "the recurrence report counts an unhealed split row: two occasions, unborn and a sha, over three runs" \
   "$(_fh_recur "$_fh_ep")" "$(printf '2\tlint\t%s\t3' "$_fh_today")"
_fh_legacy "$_fh_today" 'lint ' > "$_fh_el"
has "procedures name the failure an unhealed split row holds" "$(_fh_items "$_fh_ep")" "failure:lint"
{ printf '%s\tmain\tabc1234\tother \n' "$_fh_today"; _fh_legacy "$_fh_today" 'lint '; } > "$_fh_el"
if [ -e "$MEM/healread/lessons.md" ] || [ -e "$MEM/healread/DEVLOG.md" ]; then
  bad "the Stop hook's guard names what an unhealed split row caught last" "the fixture has a lessons file or a devlog"
else
  has "the Stop hook's guard names what an unhealed split row caught last" "$(_fh_guard "$_fh_ep")" "last caught   lint"
fi
{ _fh_legacy "$_fh_today" 'a '; printf '%s\tmain\tabc1234\tb \n' "$_fh_today"; _fh_legacy "$_fh_today" 'c '; } > "$_fh_el"
_fh_emp="$(_fh_mon "$_fh_ep")"
is "the monitor counts an unhealed split row once: three rows, not five" "$(_fh_montotal "$_fh_emp")" "3"
is "and its newest entry says the commit was unborn" \
   "$(_fh_monfirst "$_fh_emp" | tr ',' '\n' | grep '^"commit":')" '"commit":"unborn"'
# The same four readers on a well-formed log print exactly what they always
# did. Pinned as literals rather than compared with a second reader.
printf '%s\tmain\tabc1234\tlint \n%s\tmain\tdef5678\tlint \n' "$_fh_today" "$_fh_today" > "$_fh_el"
is "on a well-formed log the recurrence report is what it always was" \
   "$(_fh_recur "$_fh_ep")" "$(printf '2\tlint\t%s\t2' "$_fh_today")"
is "and procedures list the failure as they always did" "$(_fh_items "$_fh_ep")" "failure:lint"
is "and the guard names the last catch as it always did" \
   "$(_fh_guard "$_fh_ep" | sed -n '1p;/last caught/p')" \
   "$(printf 'The gate caught something here and nothing has been written down since.\n  last caught   lint')"
_fh_emp="$(_fh_mon "$_fh_ep")"
is "and the monitor's count and newest entry are what they always were" \
   "$(_fh_montotal "$_fh_emp")|$(_fh_monfirst "$_fh_emp")" \
   "2|{\"date\":\"$_fh_today\",\"branch\":\"main\",\"commit\":\"def5678\",\"what\":\"lint \"}"

# #267's writer is unchanged by any of this: on an unborn HEAD one failing
# gate is one row, and every byte of it is pinned here. The second it was
# caught is the one byte run not known in advance, so it is read back from the
# row, and must be a second of this run; the session is a dash, since the
# suite runs under none.
mkdir -p "$FROOT/projects/healunborn" "$MEM/healunborn" "$TMP/fr-healunborn"
( cd "$TMP/fr-healunborn" && git init -q -b main && printf 'healunborn\n' > .felix ) >/dev/null 2>&1
_fh_setgate healunborn gate.sh
_fh_script healunborn 'echo "  lint               FAIL"; exit 1'
: > "$MEM/healunborn/mistakes.log"
( cd "$TMP/fr-healunborn" && "$FELIX" gate >/dev/null 2>&1 )
_fh_ust="$(head -n 1 "$MEM/healunborn/mistakes.log" | cut -f5)"
case "$_fh_ust" in ''|*[!0-9]*) _fh_ust=0 ;; esac
[ $(( $(date +%s) - _fh_ust )) -lt 600 ] || _fh_ust=not-a-second-of-this-run
printf '%s\tmain\tunborn\tlint \t%s\t-\n' "$_fh_today" "$_fh_ust" > "$TMP/fh-unborn.expect"
cmp -s "$MEM/healunborn/mistakes.log" "$TMP/fh-unborn.expect" \
  && ok  "a failing gate on an unborn HEAD still writes one row: today, main, unborn, the checks, the second and no session, byte for byte" \
  || bad "a failing gate on an unborn HEAD still writes one row: today, main, unborn, the checks, the second and no session, byte for byte" \
         "$(od -c "$MEM/healunborn/mistakes.log" | head -n 3)"

# ------------------------------------ the project gate's own failure (G5.2) ----
# cmd_gate ran the project gate into a log and then tee'd the engine's own
# check lines into the same log. The recorder took FAIL names from the whole
# of it and fell back to exit-<status> only when the whole log named nothing,
# so a project gate that failed silently beside a failing probe was recorded
# as `probes` alone, which gate_shown_failing excludes: held forever. And a
# project line with no final newline had the first engine line glued onto it.
_fh_proj gatesplit gate.sh
_fg_r="$(_fh_root gatesplit)"; _fg_p="$FROOT/projects/gatesplit"; _fg_l="$MEM/gatesplit/mistakes.log"
printf 'contents\n' > "$_fg_r/WIDGET.txt"
( cd "$_fg_r" && git add -A && git -c user.name=t -c user.email=t@t commit -qm widget ) >/dev/null 2>&1
_fg_blind() { { printf 'present\t-\t-\tls -1 WIDGET.txt\ttest -f WIDGET.txt\n'
                printf 'blindrow\t-\t-\tls -1 nothing-here.rs\ttest -f WIDGET.txt\n'; } > "$_fg_p/probes.tsv"; }
_fg_clean() { printf 'present\t-\t-\tls -1 WIDGET.txt\ttest -f WIDGET.txt\n' > "$_fg_p/probes.tsv"; }
_fg_run()   { _fh_script gatesplit "$1"; : > "$_fg_l"; _fg_out="$(cd "$_fg_r" && "$FELIX" gate 2>&1)"; _fg_rc=$?; }
# Rows written, then the new row's column-four tokens in order.
_fg_row()   { printf '%s|%s' "$(grep -c '' "$_fg_l" 2>/dev/null)" \
                "$(tail -n 1 "$_fg_l" 2>/dev/null | cut -f4 | tr ' ' '\n' | grep -v '^$' | tr '\n' ' ' | sed 's/ $//')"; }

_fg_blind
_fg_run 'echo "  lint               FAIL"; exit 1'
has "the gatesplit fixture's probes fail from the engine" "$_fg_out" "  probes             FAIL"
is  "a project FAIL line and a failing probe are both recorded, in one row, and the gate exits 1" \
    "$_fg_rc $(_fg_row)" "1 1|lint probes"
_fg_run 'echo "something broke"; exit 1'
is  "a project gate that fails silently is recorded beside the probe that failed with it: exit-1, then probes" \
    "$(_fg_row)" "1|exit-1 probes"
_fh_gsf "$MEM/gatesplit" \
  && ok  "so gate_shown_failing sees the project's own silent failure there" \
  || bad "so gate_shown_failing sees the project's own silent failure there" "$(cat "$_fg_l")"
_fg_run 'echo "something broke"; exit 3'
is  "and with its own status: exit-3, then probes" "$(_fg_row)" "1|exit-3 probes"
_fg_run 'true'
is  "a passing project with a failing probe still records probes alone" "$(_fg_row)" "1|probes"
_fh_gsf "$MEM/gatesplit" \
  && bad "and gate_shown_failing still does not count a failing probe as the project's gate failing" "$(cat "$_fg_l")" \
  || ok  "and gate_shown_failing still does not count a failing probe as the project's gate failing"
_fg_run 'echo "  deployed           FAIL (structural: this tree is not the one that deploys)"; exit 1'
is  "a structural project failure beside a failing probe records probes alone" "$(_fg_row)" "1|probes"
_fg_run "printf '  lint               FAIL'; exit 1"
is  "a project FAIL line with no final newline is not swallowed by the engine line after it" \
    "$(_fg_row)" "1|lint probes"
_fg_clean
_fg_run 'echo broke; exit 3'
is  "a silent project failure with nothing else failing records exit-3, exactly as before" \
    "$(grep -c '' "$_fg_l")|$(tail -n 1 "$_fg_l" | cut -f4)" "1|exit-3"
_fg_run 'echo "  deployed           FAIL (structural: this tree is not the one that deploys)"; exit 1'
is  "and with a clean probes table an all-structural failure still writes no row" \
    "$_fg_rc $(grep -c '' "$_fg_l")" "1 0"

# ------------------------------------------- a gate that could not run (G1.3) ----
# 127 and 126 are the shell saying the gate command was not found, or found
# and not executable. Nothing was tested, so it is not the gate shown failing,
# and recording exit-127 satisfied gate_shown_failing on a gate nobody had ever
# watched fail. The verdict does not change: the gate still exits non-zero and
# its receipt is red. Only the record changes, and the gate says why.
_fh_proj unrunproj felix-no-such-command-xyz
_fu_r="$(_fh_root unrunproj)"; _fu_l="$MEM/unrunproj/mistakes.log"
: > "$_fu_l"
_fu_out="$(cd "$_fu_r" && "$FELIX" gate 2>&1)"; _fu_rc=$?
is  "a gate command that is not found still fails the gate, with 127" "$_fu_rc" "127"
has "and the gate says it could not run, so nothing was tested and it is not recorded as failing" \
    "$_fu_out" "the gate command could not run (exit 127: a command it calls was not found), so nothing was tested and this run is not recorded as the gate failing"
is  "and no mistakes row is written for a gate that never ran" "$(grep -c '' "$_fu_l")" "0"
_fh_gsf "$MEM/unrunproj" \
  && bad "so gate_shown_failing is not satisfied by a gate that never ran" "$(cat "$_fu_l")" \
  || ok  "so gate_shown_failing is not satisfied by a gate that never ran"
_fu_tid="$(cd "$_fu_r" && . "$FROOT/harness/lib/verify.sh" && felix_tree_id "$_fu_r" "$FROOT")"
is  "and the receipt written for that tree is still red" \
    "$( . "$FROOT/harness/lib/verify.sh"; felix_verify_receipt "$_fu_r" "$FROOT" | cut -f1,2 )" "$(printf '%s\tred' "$_fu_tid")"

printf '#!/bin/sh\necho hi\n' > "$_fu_r/notexec.sh"; chmod 644 "$_fu_r/notexec.sh"
_fh_setgate unrunproj ./notexec.sh
: > "$_fu_l"
_fu_out="$(cd "$_fu_r" && "$FELIX" gate 2>&1)"; _fu_rc=$?
is  "a gate command found but not executable fails the gate with 126" \
    "$([ -x "$_fu_r/notexec.sh" ] && echo executable || echo plain) $_fu_rc" "plain 126"
has "and says it could not run, naming 126" "$_fu_out" "(exit 126"
is  "and writes no mistakes row for it either" "$(grep -c '' "$_fu_l")" "0"

_fg_blind; _fh_setgate gatesplit felix-no-such-command-xyz; : > "$_fg_l"
_fg_out="$(cd "$_fg_r" && "$FELIX" gate 2>&1)"
is  "an unrunnable gate beside a failing probe records probes alone, and no exit-127" "$(_fg_row)" "1|probes"
has "and still says the gate command could not run" "$_fg_out" "the gate command could not run (exit 127"
_fh_setgate gatesplit gate.sh

# The could-not-run line says what the recorder wrote, so it is printed after
# the recorder. The first cut printed it before any engine check ran, ending
# "this run is not recorded as the gate failing" whatever came next; a failing
# probe or obligation was then recorded under its own name, and obligations is
# one gate_shown_failing counts. The screen said the opposite of the row.
case "$_fg_out" in
  *"is not recorded as the gate failing"*)
    bad "beside a failing probe, the line never says the run was not recorded, since probes was" \
        "$(printf '%s\n' "$_fg_out" | grep 'could not run')" ;;
  *"its exit status is not recorded; mistakes.log records only the engine checks that failed beside it: probes"*)
    ok  "beside a failing probe, the line never says the run was not recorded, since probes was" ;;
  *)
    bad "beside a failing probe, the line never says the run was not recorded, since probes was" \
        "$(printf '%s\n' "$_fg_out" | grep 'could not run')" ;;
esac

_fh_proj unrunob felix-no-such-command-xyz
_fo_r="$(_fh_root unrunob)"; _fo_l="$MEM/unrunob/mistakes.log"
printf 'ob1\tTASK_BLOCKING\tdeterministic\ttrue\tfalse\t-\tan obligation whose evidence always fails\n' \
  > "$FROOT/projects/unrunob/obligations.tsv"
: > "$_fo_l"
_fo_out="$(cd "$_fo_r" && "$FELIX" gate 2>&1)"
has "the unrunob fixture's obligation fails from the engine" "$_fo_out" "  obligations        FAIL"
is  "an unrunnable gate beside a failing obligation records obligations, and no exit-127" \
    "$(grep -c '' "$_fo_l")|$(cut -f4 "$_fo_l")" "1|obligations "
case "$_fo_out" in
  *"is not recorded as the gate failing"*)
    bad "and the gate does not say the run was not recorded, when that row makes gate_shown_failing read done" \
        "$(printf '%s\n' "$_fo_out" | grep 'could not run')" ;;
  *) ok  "and the gate does not say the run was not recorded, when that row makes gate_shown_failing read done" ;;
esac
has "it says the command's own status is not recorded, and names the engine check that is" "$_fo_out" \
    "gate: the gate command could not run (exit 127: a command it calls was not found), so nothing was tested and its exit status is not recorded; mistakes.log records only the engine checks that failed beside it: obligations"
is  "and says it once, as the gate's last line, after the obligations line it depends on" \
    "$(printf '%s\n' "$_fo_out" | grep -c 'could not run')|$(printf '%s\n' "$_fo_out" | tail -n 1 | cut -c1-32)" \
    "1|gate: the gate command could not"

_fh_setgate unrunproj gate.sh
_fh_script unrunproj 'echo broke; exit 1'
: > "$_fu_l"
_fu_out="$(cd "$_fu_r" && "$FELIX" gate 2>&1)"
is  "a gate that ran and failed silently still records exit-1" "$(grep -c '' "$_fu_l")|$(cut -f4 "$_fu_l")" "1|exit-1"
_fh_gsf "$MEM/unrunproj" \
  && ok  "and gate_shown_failing reads that as the gate shown failing" \
  || bad "and gate_shown_failing reads that as the gate shown failing" "$(cat "$_fu_l")"
case "$_fu_out" in
  *"could not run"*) bad "and a gate that ran is never called unrunnable" "$_fu_out" ;;
  *)                 ok  "and a gate that ran is never called unrunnable" ;;
esac
_fh_script unrunproj 'echo "  lint               FAIL"; exit 127'
: > "$_fu_l"
_fu_out="$(cd "$_fu_r" && "$FELIX" gate 2>&1)"
is  "a gate that named a failure and then exited 127 records the name" "$(grep -c '' "$_fu_l")|$(cut -f4 "$_fu_l")" "1|lint "
case "$_fu_out" in
  *"could not run"*) bad "and is not called unrunnable, because it ran far enough to catch something" "$_fu_out" ;;
  *)                 ok  "and is not called unrunnable, because it ran far enough to catch something" ;;
esac

# ------------------------------------------ setup rows and the GitHub remote ----
# felix new and adopt spliced the repository's slug into {{REPO}} when they
# wrote a setup row. With no GitHub remote the slug is empty, so the saved
# check read `--repo  2>/dev/null`, failed forever, and held human_steps; and
# adding a remote later changed nothing, because adopt skips ids that exist.
# The placeholder is kept on disk and filled in when the row is read.
_fs_gh="$TMP/fs-gh"; _fs_ghlog="$TMP/fs-gh.log"; mkdir -p "$_fs_gh"; : > "$_fs_ghlog"
cat > "$_fs_gh/gh" <<STUB
#!/usr/bin/env bash
printf '%s\n' "\$*" >> "$_fs_ghlog"
case "\$*" in
  *"--repo acme/widget"*) printf 'needs-founder\nANTHROPIC_API_KEY\n'; exit 0 ;;
esac
printf 'no git remotes found\n' >&2
exit 1
STUB
chmod +x "$_fs_gh/gh"
# ssh, for the one question the engine asks it: `ssh -G <host>`, what an ssh
# alias stands for. The real one reads the person's own ~/.ssh/config, found
# through the password database rather than $HOME, so no suite HOME can hide
# it; this one knows a single alias, `work`, standing for github.com, and reads
# any other host back as itself, which is what ssh -G does for a host nothing
# configures. It logs its arguments, and refuses anything but -G.
_fs_sshlog="$TMP/fs-ssh.log"; : > "$_fs_sshlog"
cat > "$_fs_gh/ssh" <<STUB
#!/usr/bin/env bash
printf '%s\n' "\$*" >> "$_fs_sshlog"
[ "\${1:-}" = "-G" ] || { printf 'stub: only -G\n' >&2; exit 255; }
for _h in "\$@"; do :; done
case "\$_h" in
  work) printf 'user git\nhostname github.com\nport 22\n' ;;
  *)    printf 'user git\nhostname %s\nport 22\n' "\$_h" ;;
esac
STUB
chmod +x "$_fs_gh/ssh"
_fs_path="$_fs_gh:$CMSTUB:$PATH"
( PATH="$_fs_path"; gh label list --repo acme/widget 2>/dev/null | grep -q needs-founder ) \
  && ! ( PATH="$_fs_path"; gh label list --repo other/thing >/dev/null 2>&1 ) \
  && ok  "the gh stub answers for acme/widget and refuses anything else" \
  || bad "the gh stub answers for acme/widget and refuses anything else"
_fs_status() { ( cd "$1" && PATH="$_fs_path"
                 . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/detect.sh"
                 . "$FROOT/harness/lib/stack.sh"; . "$FROOT/harness/lib/setup.sh"
                 felix_setup_status "$2" ) 2>/dev/null; }
_fs_cli() { ( cd "$1" && PATH="$_fs_path" "$FELIX" setup "${@:2}" ) 2>&1; }
_fs_cm()  { ( cd "$1" && PATH="$_fs_path" "$FELIX" commission "${@:2}" ) 2>&1; }
_fs_ids() { printf '%s\n' "$1" | awk -F'\t' '$2 == "risk-labels" || $2 == "ci-anthropic-key"'; }
_fs_tpl="$FROOT/harness/templates/setup.tsv"
_fs_reporows="$(grep -F '{{REPO}}' "$_fs_tpl" | grep -v '^#')"
_fs_hdr="$(printf '# id\ttitle\tcapability\tcheck')"
_fs_rlt="Create the escalation labels the repair loop uses"
_fs_ckt="$(awk -F'\t' '$1 == "ci-anthropic-key" { print $2 }' "$_fs_tpl")"
_fs_wait="$(printf 'dormant\trisk-labels\t%s\twaits for a GitHub remote\ndormant\tci-anthropic-key\t%s\twaits for a GitHub remote' "$_fs_rlt" "$_fs_ckt")"
_fs_nogh="No GitHub remote yet, so {{REPO}} below is left as written; it fills in once origin points at GitHub."
is "the setup template holds the two rows that need a GitHub slug" \
   "$(printf '%s\n' "$_fs_reporows" | cut -f1 | tr '\n' ' ')" "risk-labels ci-anthropic-key "

# felix new, in a checkout with CI and no remote.
_fs_n="$TMP/fs-new"; mkdir -p "$_fs_n/.github/workflows"
( cd "$_fs_n" && git init -q -b main ) >/dev/null 2>&1
printf 'on: push\n' > "$_fs_n/.github/workflows/ci.yml"
_fs_n="$(cd "$_fs_n" && pwd -P)"; _fs_p="$FROOT/projects/setupproj"
( cd "$_fs_n" && PATH="$_fs_path" "$FELIX" new setupproj --no-commission ) >/dev/null 2>&1; _fs_nrc=$?
_fs_saved="$(awk -F'\t' '$1 == "risk-labels" || $1 == "ci-anthropic-key"' "$_fs_p/setup.tsv" 2>/dev/null)"
if [ "$_fs_nrc" -ne 0 ] || [ "$(printf '%s\n' "$_fs_saved" | grep -c .)" != "2" ]; then
  bad "felix new with no remote saves both slug rows with --repo {{REPO}}, never an empty slug" "felix new exited $_fs_nrc, saved [$_fs_saved]"
elif [ -z "$(grep -vF -- '--repo {{REPO}}' <<<"$_fs_saved")" ] && ! grep -qF -- '--repo  ' "$_fs_p/setup.tsv"; then
  ok  "felix new with no remote saves both slug rows with --repo {{REPO}}, never an empty slug"
else
  bad "felix new with no remote saves both slug rows with --repo {{REPO}}, never an empty slug" "$(printf '%s\n' "$_fs_saved" | cut -f4)"
fi
has "and the saved risk-labels runbook keeps {{REPO}} too" "$(cat "$_fs_p/setup/risk-labels.md" 2>/dev/null)" "{{REPO}}"

# With no remote those rows wait. They are not todo, and they ask gh nothing.
: > "$_fs_ghlog"
is "with no remote, both slug rows wait for a GitHub remote rather than reading todo" \
   "$(_fs_ids "$(_fs_status "$_fs_n" "$_fs_p")")" "$_fs_wait"
_fs_line="$(_fs_cli "$_fs_n" | grep -E '\[.\] risk-labels ')"
case "$_fs_line" in
  *"[-] risk-labels"*"(waits for a GitHub remote)") ok  "felix setup shows risk-labels waiting for a GitHub remote, never as a step to do" ;;
  *)                                                bad "felix setup shows risk-labels waiting for a GitHub remote, never as a step to do" "$_fs_line" ;;
esac
is "and gh is asked nothing for the rows that wait" "$(grep -cE 'label list|secret list' "$_fs_ghlog")" "0"

# A remote added later fills the same saved row: nothing re-adopted, nothing
# rewritten, the file on disk exactly as felix new left it.
cp "$_fs_p/setup.tsv" "$TMP/fs-setup.copy"
( cd "$_fs_n" && git remote add origin https://github.com/acme/widget.git ) >/dev/null 2>&1
: > "$_fs_ghlog"
_fs_st="$(_fs_status "$_fs_n" "$_fs_p")"
cmp -s "$_fs_p/setup.tsv" "$TMP/fs-setup.copy" \
  && ok  "adding a remote rewrites nothing: the saved setup.tsv is byte for byte what it was" \
  || bad "adding a remote rewrites nothing: the saved setup.tsv is byte for byte what it was"
is "and the same saved rows now read done, three fields, with the slug filled in" \
   "$(_fs_ids "$_fs_st")" "$(printf 'done\trisk-labels\t%s\ndone\tci-anthropic-key\t%s' "$_fs_rlt" "$_fs_ckt")"
if grep -qF 'label list --repo acme/widget' "$_fs_ghlog" && grep -qF 'secret list --repo acme/widget' "$_fs_ghlog"; then
  ok  "and gh was asked about acme/widget for both"
else
  bad "and gh was asked about acme/widget for both" "$(cat "$_fs_ghlog")"
fi
_fs_rb="$(_fs_cli "$_fs_n" risk-labels)"
case "$_fs_rb" in
  *'{{REPO}}'*|*'No GitHub remote yet'*) bad "felix setup risk-labels prints the runbook with the slug filled in" "$(printf '%s\n' "$_fs_rb" | grep -e REPO -e 'No GitHub' | head -n 3)" ;;
  *'--repo acme/widget'*)                ok  "felix setup risk-labels prints the runbook with the slug filled in" ;;
  *)                                     bad "felix setup risk-labels prints the runbook with the slug filled in" "$(printf '%s\n' "$_fs_rb" | grep -e '--repo' | head -n 3)" ;;
esac

# human_steps, copied verbatim from the template, is released by rows that
# wait for a remote and by nothing else.
_fh_proj setupwait true
_fs_wr="$(_fh_root setupwait)"; _fs_wp="$FROOT/projects/setupwait"
printf 'ci\n' > "$_fs_wp/capabilities"
{ printf '%s\n' "$_fs_hdr"; printf '%s\n' "$_fs_reporows"; } > "$_fs_wp/setup.tsv"
mkdir -p "$_fs_wp/setup"; cp "$FROOT/harness/templates/setup/risk-labels.md" "$_fs_wp/setup/"
{ _fh_cmhdr; _fh_cmrow human_steps; printf 'marker\t-\t-\t-\t-\ttest -f .felix\t9\n'; } > "$_fs_wp/commissioning.tsv"
is "with no remote, felix commission --status reads human_steps done: the rows that wait hold nothing" \
   "$(_fs_cm "$_fs_wr" --status | grep -cE '^  done +human_steps( |$)')" "1"
( cd "$_fs_wr" && git remote add origin https://github.com/other/thing.git ) >/dev/null 2>&1
is "and with a GitHub remote whose steps are not done, human_steps is held" \
   "$(_fs_cm "$_fs_wr" --status | grep -cE '^  held +human_steps( |$)')" "1"

# A remote that is not GitHub has no slug to fill in, so its rows wait too.
( cd "$_fs_wr" && git remote set-url origin git@gitlab.com:acme/widget.git ) >/dev/null 2>&1
: > "$_fs_ghlog"
is "a non-GitHub remote leaves both slug rows waiting for a GitHub remote" \
   "$(_fs_ids "$(_fs_status "$_fs_wr" "$_fs_wp")")" "$_fs_wait"
is "and with a gitlab remote gh is never called for them" "$(grep -cE 'label list|secret list' "$_fs_ghlog")" "0"

# The slug is spliced into a command bash runs, so a remote carrying shell text
# is no slug at all. git remote add accepts this one. It points at GitHub,
# though, so its rows do not wait: they are steps Felix cannot check, held and
# said so, and their checks never run.
_fs_evil='https://github.com/acme/widget;touch PWNED.git'
( cd "$_fs_wr" && git remote set-url origin "$_fs_evil" ) >/dev/null 2>&1
_fs_pw0="$([ -e "$_fs_wr/PWNED" ] || [ -e "$PWD/PWNED" ] && echo present || echo absent)"
: > "$_fs_ghlog"
_fs_st="$(_fs_status "$_fs_wr" "$_fs_wp")"
_fs_cli "$_fs_wr" risk-labels >/dev/null 2>&1
_fs_unowner="origin points at GitHub, but not at one owner/name Felix can read, so Felix cannot check it"
if [ "$(git -C "$_fs_wr" remote get-url origin 2>/dev/null)" != "$_fs_evil" ]; then
  bad "a remote carrying shell text is no slug: risk-labels is a step Felix says it cannot check" "git did not keep the remote as written"
else
  is "a remote carrying shell text is no slug: risk-labels is a step Felix says it cannot check" \
     "$(printf '%s\n' "$_fs_st" | awk -F'\t' '$2 == "risk-labels"')" \
     "$(printf 'todo\trisk-labels\t%s\t%s' "$_fs_rlt" "$_fs_unowner")"
fi
is "and gh is asked nothing for it" "$(grep -cE 'label list|secret list' "$_fs_ghlog")" "0"
if [ "$_fs_pw0" = "present" ]; then
  bad "and nothing spliced from it ran: no PWNED file in the checkout or the working directory" "a PWNED file was there before the test"
elif [ -e "$_fs_wr/PWNED" ] || [ -e "$PWD/PWNED" ]; then
  bad "and nothing spliced from it ran: no PWNED file in the checkout or the working directory" "the remote's shell text was executed"
else
  ok  "and nothing spliced from it ran: no PWNED file in the checkout or the working directory"
fi

# A remote Felix cannot read as one owner/name is not the same as no remote.
# The first cut read every origin it could not turn into owner/name as none at
# all, so a repository that plainly had a GitHub remote, behind an ssh alias,
# over port 443, or spelled with a trailing slash, had its label and its CI
# secret read "waits for a GitHub remote". Both dropped out of human_steps'
# count, and commissioning released steps the person still owed: a silent
# false pass. The spellings git takes for one GitHub repository now all give
# its owner/name, and a GitHub remote Felix still cannot read holds its rows
# as todo and says why. Only no remote, or one that is not GitHub, waits.
_fs_both() { _fs_ids "$(_fs_status "$_fs_wr" "$_fs_wp")"; }
_fs_seturl() { ( cd "$_fs_wr" && git remote set-url origin "$1" ) >/dev/null 2>&1; }
_fs_done="$(printf 'done\trisk-labels\t%s\ndone\tci-anthropic-key\t%s' "$_fs_rlt" "$_fs_ckt")"
_fs_todo() { printf 'todo\trisk-labels\t%s\t%s\ntodo\tci-anthropic-key\t%s\t%s' "$_fs_rlt" "$1" "$_fs_ckt" "$1"; }
_fs_seturl 'https://github.com/acme/widget/'
is "origin spelled with a trailing slash gives acme/widget, so both slug rows read done" "$(_fs_both)" "$_fs_done"
_fs_seturl 'ssh://git@ssh.github.com:443/acme/widget.git'
is "origin over ssh on port 443 gives acme/widget, not 443/acme/widget, so both read done" "$(_fs_both)" "$_fs_done"
_fs_seturl 'git@work:acme/widget.git'
is "origin behind an ssh alias that ssh -G says stands for github.com gives acme/widget, so both read done" \
   "$(_fs_both)" "$_fs_done"

_fs_seturl 'git@github.com-work:acme/widget.git'
: > "$_fs_ghlog"; : > "$_fs_sshlog"
_fs_alias="origin's host github.com-work is not github.com, nor an ssh alias for it, so Felix cannot check it"
is "an ssh alias ssh cannot resolve holds both slug rows as todo, saying why, rather than letting them wait" \
   "$(_fs_both)" "$(_fs_todo "$_fs_alias")"
is "and gh is asked nothing for them, because no slug was read" "$(grep -cE 'label list|secret list' "$_fs_ghlog")" "0"
is "and ssh is asked only for its configuration, with no DNS lookup, about the alias as written" \
   "$(grep -c '' "$_fs_sshlog")|$(head -n 1 "$_fs_sshlog")" "1|-G -o CanonicalizeHostname=no github.com-work"
is "so felix commission --status holds human_steps, where the first cut released it" \
   "$(_fs_cm "$_fs_wr" --status | grep -cE '^  held +human_steps( |$)')" "1"
_fs_line="$(_fs_cli "$_fs_wr" | grep -E '\[.\] risk-labels ')"
case "$_fs_line" in
  *"[ ] risk-labels"*"($_fs_alias)") ok  "felix setup shows risk-labels as a step to do, with the reason Felix cannot check it" ;;
  *)                                 bad "felix setup shows risk-labels as a step to do, with the reason Felix cannot check it" "$_fs_line" ;;
esac
is "and felix setup risk-labels begins by saying why {{REPO}} is left as written" \
   "$(_fs_cli "$_fs_wr" risk-labels | head -n 1)" \
   "{{REPO}} below is left as written, because origin's host github.com-work is not github.com, nor an ssh alias for it: put the repository's owner/name in its place."
_fs_seturl 'git@github-personal:acme/widget.git'
is "an alias named for GitHub without github.com in it is held the same way" \
   "$(_fs_both)" "$(_fs_todo "origin's host github-personal is not github.com, nor an ssh alias for it, so Felix cannot check it")"
_fs_seturl 'https://github.example.com/acme/widget.git'
is "a GitHub Enterprise-shaped host is held too, since github.com's owner/name would not check it" \
   "$(_fs_both)" "$(_fs_todo "origin's host github.example.com is not github.com, nor an ssh alias for it, so Felix cannot check it")"
_fs_seturl 'https://github.com/acme'
is "a GitHub origin with no owner/name in it holds both rows, saying so" "$(_fs_both)" "$(_fs_todo "$_fs_unowner")"

# The host is handed to ssh as an argument, so it has to be a plain hostname
# first: one that would read as an option is not GitHub, and never reaches ssh.
: > "$_fs_sshlog"
_fs_seturl 'git@-oProxyCommand=touch:acme/widget.git'
is "a remote whose host would be an ssh option is no GitHub remote: both rows wait" "$(_fs_both)" "$_fs_wait"
is "and ssh is never called with it" "$(grep -c '' "$_fs_sshlog")" "0"

# Origin is the remote Felix reads. With none, a GitHub remote under another
# name still means the repository owes its GitHub steps.
( cd "$_fs_wr" && git remote remove origin && git remote add upstream https://github.com/acme/widget.git ) >/dev/null 2>&1
is "with no origin but a GitHub remote named upstream, both rows are held as todo, saying origin is the one read" \
   "$(_fs_both)" "$(_fs_todo "no remote is named origin, the one Felix reads, though another points at GitHub, so Felix cannot check it")"
( cd "$_fs_wr" && git remote remove upstream && git remote add upstream https://gitlab.com/acme/widget.git ) >/dev/null 2>&1
is "and with only a gitlab remote under another name, they wait" "$(_fs_both)" "$_fs_wait"
( cd "$_fs_wr" && git remote remove upstream ) >/dev/null 2>&1

# Rows an older felix new already saved with an empty slug read the same way:
# `--repo` followed by blanks and then nothing a slug could be.
_fh_proj setuplegacy true
_fs_lr="$(_fh_root setuplegacy)"; _fs_lp="$FROOT/projects/setuplegacy"
printf 'ci\n' > "$_fs_lp/capabilities"
{ printf '%s\n' "$_fs_hdr"; printf 'risk-labels\t%s\tci\tgh label list --repo  2>/dev/null | grep -q needs-founder\n' "$_fs_rlt"; } > "$_fs_lp/setup.tsv"
mkdir -p "$_fs_lp/setup"
printf '# Escalation and risk labels\n\n**Check:** `gh label list --repo ` includes `needs-founder`.\n\n```bash\ngh label create needs-founder --repo  --color D93F0B\n```\n' \
  > "$_fs_lp/setup/risk-labels.md"
is "a row saved with an empty slug reads as waiting for a GitHub remote, like a {{REPO}} row" \
   "$(_fs_status "$_fs_lr" "$_fs_lp" | awk -F'\t' '$2 == "risk-labels"')" \
   "$(printf 'dormant\trisk-labels\t%s\twaits for a GitHub remote' "$_fs_rlt")"
_fs_rb="$(_fs_cli "$_fs_lr" risk-labels)"
is "and its runbook begins by saying {{REPO}} is left as written until origin points at GitHub" \
   "$(printf '%s\n' "$_fs_rb" | head -n 1)" "$_fs_nogh"
is "and shows --repo {{REPO}} in both places the empty slug was" \
   "$(printf '%s\n' "$_fs_rb" | grep -cF -- '--repo {{REPO}}')" "2"
( cd "$_fs_lr" && git remote add origin https://github.com/acme/widget.git ) >/dev/null 2>&1
: > "$_fs_ghlog"
is "with the acme remote the row saved with an empty slug reads done" \
   "$(_fs_status "$_fs_lr" "$_fs_lp" | awk -F'\t' '$2 == "risk-labels"')" "$(printf 'done\trisk-labels\t%s' "$_fs_rlt")"
has "and gh was asked about acme/widget for it" "$(cat "$_fs_ghlog")" "label list --repo acme/widget"
is "and its runbook shows --repo acme/widget in both places" \
   "$(_fs_cli "$_fs_lr" risk-labels | grep -cF -- '--repo acme/widget')" "2"

# A runbook a person has added to. The first cut asked whether the normalised
# text held {{REPO}} with `sed | grep -q` under the CLI's pipefail: grep leaves
# on its first match, sed takes a SIGPIPE on its next write, and the pipeline
# reads false. Past the pipe's buffer that is certain, and the runbook printed
# raw, with no preface and, for a legacy one, `--repo  --color`: a command to
# paste that names no repository. Three thousand lines put {{REPO}} in the
# first few and a couple of hundred kilobytes after it.
_fh_proj setupbig true
_fs_gr="$(_fh_root setupbig)"; _fs_gp2="$FROOT/projects/setupbig"
printf 'ci\n' > "$_fs_gp2/capabilities"; mkdir -p "$_fs_gp2/setup"
{ printf '%s\n' "$_fs_hdr"; printf '%s\n' "$_fs_reporows"; } > "$_fs_gp2/setup.tsv"
_fs_tail() { awk 'BEGIN { for (i = 0; i < 3000; i++) printf "appendix line %05d: notes a person kept about the labels and why each exists\n", i }'; }
{ printf '# Escalation and risk labels\n\n**Check:** `gh label list --repo {{REPO}}` includes `needs-founder`.\n\n'; _fs_tail; } \
  > "$_fs_gp2/setup/risk-labels.md"
_fs_bsz="$(wc -c < "$_fs_gp2/setup/risk-labels.md" | tr -dc '0-9')"
_fs_rb="$(_fs_cli "$_fs_gr" risk-labels)"
if [ "${_fs_bsz:-0}" -lt 200000 ]; then
  bad "a runbook of 200 KB or more with {{REPO}} still begins with the no-remote preface" "the fixture is only ${_fs_bsz} bytes"
else
  is "a runbook of 200 KB or more with {{REPO}} still begins with the no-remote preface" \
     "$(printf '%s\n' "$_fs_rb" | head -n 1)" "$_fs_nogh"
fi
is "and prints the whole runbook after it, every appendix line" \
   "$(printf '%s\n' "$_fs_rb" | grep -c '^appendix line ')|$(printf '%s\n' "$_fs_rb" | tail -n 1)" \
   "3000|appendix line 02999: notes a person kept about the labels and why each exists"
{ printf 'gh label create needs-founder --repo  --color D93F0B\n'; _fs_tail; } > "$_fs_gp2/setup/risk-labels.md"
_fs_rb="$(_fs_cli "$_fs_gr" risk-labels)"
is "a long legacy runbook with an empty slug begins with the preface, then shows --repo {{REPO}}, never --repo and a blank" \
   "$(printf '%s\n' "$_fs_rb" | head -n 2)" \
   "$(printf '%s\ngh label create needs-founder --repo {{REPO}}  --color D93F0B' "$_fs_nogh")"

# A repository WITH a GitHub remote behaves exactly as it did when the slug was
# baked in at write time: the same lines, the same screens, the same gh calls.
for _fs_x in setupbaked setupplace; do
  _fh_proj "$_fs_x" true
  ( cd "$TMP/fr-$_fs_x" && git remote add origin https://github.com/acme/widget.git ) >/dev/null 2>&1
  printf 'ci\n' > "$FROOT/projects/$_fs_x/capabilities"
  mkdir -p "$FROOT/projects/$_fs_x/setup"
done
{ printf '%s\n' "$_fs_hdr"; printf '%s\n' "$_fs_reporows" | sed 's#{{REPO}}#acme/widget#g'
  printf 'later\tA step for a capability not present yet\tbilling\tfalse\n'; } > "$FROOT/projects/setupbaked/setup.tsv"
{ printf '%s\n' "$_fs_hdr"; printf '%s\n' "$_fs_reporows"
  printf 'later\tA step for a capability not present yet\tbilling\tfalse\n'; } > "$FROOT/projects/setupplace/setup.tsv"
for _fs_x in risk-labels ci-anthropic-key; do
  sed 's#{{REPO}}#acme/widget#g' "$FROOT/harness/templates/setup/$_fs_x.md" > "$FROOT/projects/setupbaked/setup/$_fs_x.md"
  cp "$FROOT/harness/templates/setup/$_fs_x.md" "$FROOT/projects/setupplace/setup/$_fs_x.md"
done
_fs_br="$(_fh_root setupbaked)"; _fs_pr="$(_fh_root setupplace)"
: > "$_fs_ghlog"
_fs_sb="$(_fs_status "$_fs_br" "$FROOT/projects/setupbaked")"; _fs_cb="$(_fs_cli "$_fs_br")"; _fs_gb="$(LC_ALL=C sort "$_fs_ghlog")"
: > "$_fs_ghlog"
_fs_sp="$(_fs_status "$_fs_pr" "$FROOT/projects/setupplace")"; _fs_cp="$(_fs_cli "$_fs_pr")"; _fs_gp="$(LC_ALL=C sort "$_fs_ghlog")"
has "a slug baked in by the old writer reads done through the stub" "$_fs_sb" "$(printf 'done\trisk-labels\t')"
is  "with a GitHub remote, a {{REPO}} row's status is byte for byte a baked row's" "$_fs_sp" "$_fs_sb"
is  "and felix setup's screen is the same, apart from the project's name" \
    "$(printf '%s' "$_fs_cp" | sed 's/setupplace/NAME/g')" "$(printf '%s' "$_fs_cb" | sed 's/setupbaked/NAME/g')"
is  "and felix setup risk-labels prints the same runbook" "$(_fs_cli "$_fs_pr" risk-labels)" "$(_fs_cli "$_fs_br" risk-labels)"
is  "and gh is asked the same questions" "$_fs_gp" "$_fs_gb"
is  "a row for a capability not present still reads dormant, three fields and no reason" \
    "$(printf '%s\n' "$_fs_sp" | awk -F'\t' '$2 == "later" { print NF "|" $0 }')" "$(printf '3|dormant\tlater\tA step for a capability not present yet')"
has "and felix setup still says it is not needed yet" "$(printf '%s\n' "$_fs_cp" | grep ' later ')" "(not needed yet)"

# ------------------------------------ commission adopts before its receipt ----
# session-start adopts every capability the checkout shows and the project has
# not declared, appending to capabilities, stack.tsv and setup.tsv, all three
# in the table set the commissioning receipt is hashed over. So a receipt
# written while ci was undeclared read stale at the very next session start.
# A full run now adopts first, so the rows, the record and the receipt all
# describe the table set the next session will find.
_fh_proj adoptproj true
_fa_r="$(_fh_root adoptproj)"; _fa_p="$FROOT/projects/adoptproj"
mkdir -p "$_fa_r/.github/workflows"; printf 'on: push\n' > "$_fa_r/.github/workflows/ci.yml"
( cd "$_fa_r" && git add -A && git -c user.name=t -c user.email=t@t commit -qm ci ) >/dev/null 2>&1
: > "$_fa_p/capabilities"
printf '# k\tn\ts\tr\tc\n' > "$_fa_p/stack.tsv"
printf '%s\n' "$_fs_hdr" > "$_fa_p/setup.tsv"
cp "$FROOT/harness/templates/profiles.tsv" "$FROOT/harness/templates/routes.tsv" "$_fa_p/"
{ _fh_cmhdr; _fh_cmrow human_steps; printf 'marker\t-\t-\t-\t-\ttest -f .felix\t9\n'; } > "$_fa_p/commissioning.tsv"
_fa_undecl() { ( . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/detect.sh"
                 felix_undeclared "$_fa_r" "$_fa_p" ) 2>/dev/null | tr '\n' ' '; }
_fa_pv() { ( . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/detect.sh"; . "$FROOT/harness/lib/commission.sh"
             felix_commission_policy_version "$_fa_p" ) 2>/dev/null; }
is "the adopt fixture's checkout shows ci, and its project declares nothing" "$(_fa_undecl)" "ci "

cp "$_fa_p/capabilities" "$TMP/fa-caps.0"
_fa_o="$(_fs_cm "$_fa_r" --status)"
if ! cmp -s "$_fa_p/capabilities" "$TMP/fa-caps.0"; then
  bad "felix commission --status adopts nothing and says nothing about adopting" "capabilities now [$(cat "$_fa_p/capabilities")]"
else
  case "$_fa_o" in
    *"adopted before this run"*) bad "felix commission --status adopts nothing and says nothing about adopting" "$_fa_o" ;;
    *"commissioning for adoptproj"*) ok "felix commission --status adopts nothing and says nothing about adopting" ;;
    *) bad "felix commission --status adopts nothing and says nothing about adopting" "no report: $_fa_o" ;;
  esac
fi

_fa_o="$(_fs_cm "$_fa_r")"
grep -qx ci "$_fa_p/capabilities" 2>/dev/null \
  && ok  "a full felix commission adopts what the checkout shows before it runs: capabilities holds ci" \
  || bad "a full felix commission adopts what the checkout shows before it runs: capabilities holds ci" "[$(cat "$_fa_p/capabilities")]"
case "$_fa_o" in
  *"adopted before this run, because the checkout shows them:"*"ci("*) ok  "and the report says so, naming ci with what it added" ;;
  *) bad "and the report says so, naming ci with what it added" "$(printf '%s\n' "$_fa_o" | head -n 4)" ;;
esac
is "and setup.tsv gains ci's two slug rows with {{REPO}} kept" \
   "$(awk -F'\t' '($1 == "risk-labels" || $1 == "ci-anthropic-key") && index($4, "--repo {{REPO}}") { print $1 }' "$_fa_p/setup.tsv" | tr '\n' ' ')" \
   "risk-labels ci-anthropic-key "
is "so nothing is left undeclared after the run" "$(_fa_undecl)" ""
_fa_pv0="$(_fa_pv)"
_fa_ss="$(cd "$_fa_r" && CLAUDE_PLUGIN_ROOT="$FROOT" "$FROOT/harness/hooks/session-start" 2>&1)"
case "$_fa_ss" in
  *"Adopted automatically"*)  bad "the next session start has nothing left to adopt" "$(printf '%s' "$_fa_ss" | head -c 300)" ;;
  *'"hookSpecificOutput"'*)   ok  "the next session start has nothing left to adopt" ;;
  *)                          bad "the next session start has nothing left to adopt" "the hook printed no banner, so no adoption line proves nothing" ;;
esac
_fa_pv1="$(_fa_pv)"
if [ -n "$_fa_pv0" ] && [ "$_fa_pv0" = "$_fa_pv1" ]; then
  ok  "and the commissioning policy version does not move"
else
  bad "and the commissioning policy version does not move" "[$_fa_pv0] then [$_fa_pv1]"
fi
_fa_rl="$(_fs_cm "$_fa_r" --status | grep 'receipt:')"
case "$_fa_rl" in
  ''|*"stale (table set moved"*) bad "so the receipt the run wrote is not stale at the next read" "[$_fa_rl]" ;;
  *)                             ok  "so the receipt the run wrote is not stale at the next read" ;;
esac

cp "$_fa_p/capabilities" "$TMP/fa-caps.1"
_fa_u="$(_fa_undecl)"
_fa_o="$(_fs_cm "$_fa_r")"
if [ -n "$_fa_u" ]; then
  bad "a second full run with nothing undeclared prints no adoption line and changes no capability" "the fixture still had [$_fa_u] undeclared"
elif ! cmp -s "$_fa_p/capabilities" "$TMP/fa-caps.1"; then
  bad "a second full run with nothing undeclared prints no adoption line and changes no capability" "capabilities now [$(cat "$_fa_p/capabilities")]"
else
  case "$_fa_o" in
    *"adopted before this run"*)     bad "a second full run with nothing undeclared prints no adoption line and changes no capability" "$_fa_o" ;;
    *"commissioning for adoptproj"*) ok  "a second full run with nothing undeclared prints no adoption line and changes no capability" ;;
    *)                               bad "a second full run with nothing undeclared prints no adoption line and changes no capability" "no report: $_fa_o" ;;
  esac
fi

[ -n "$_fh_sp" ] && { kill "$_fh_sp" 2>/dev/null; wait "$_fh_sp" 2>/dev/null; }
[ "$_fh_dlock_mine" -eq 1 ] && rmdir "$_fh_dlock" 2>/dev/null

printf '\ngenerated constitution\n'
CDIR="$FROOT/projects/stranger"
[ -s "$CDIR/CLAUDE.md" ] && ok "onboarding writes one" || bad "onboarding writes one"
has "it names the verification command" "$(cat "$CDIR/CLAUDE.md")" "felix gate"
has "and what was detected"             "$(cat "$CDIR/CLAUDE.md")" "billing"
# The invariants are the part that cannot be generated, and the file says why
# rather than pretending or leaving a bare TODO.
has "invariants say where they come from" "$(cat "$CDIR/CLAUDE.md")" "earned rather"
case "$(cat "$CDIR/CLAUDE.md")" in
  *"Replace this"*) bad "no placeholder telling someone to write it" "still a stub" ;;
  *) ok "no placeholder telling someone to write it" ;;

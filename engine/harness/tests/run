# ========================================================= (d) unknown owner
# every case here would settle a catch whose owner is known, and each also
# leaves lessons.md and DEVLOG.md newer than the catch, as a writer does
_bwreset; _bwcatch '?' lint "$_BWT" -
_bwwrote '?' lesson "$(( _BWT + 600 ))" -; _bwprose "$(( _BWT + 600 ))"
is "from a root outside git with no session, no row settles a catch" "$(_bwsays "$_BWR_NG" '')" "prompts:lint"
_bwreset; _bwcatch bw/this lint "$_BWT" -
_bwwrote bw/this lesson "$(( _BWT + 600 ))" -; _bwprose "$(( _BWT + 600 ))"
is "with no root and no session, not even a row on the catch's own branch settles it" "$(_bwsays0)" "prompts:lint"
_bwreset; _bwcatch '?' lint "$_BWT" -
_bwwrote '?' lesson "$(( _BWT + 600 ))" bw-s1; _bwprose "$(( _BWT + 600 ))"
is "from outside git, a catch naming no session is not settled even by the asking session's row" \
   "$(_bwsays "$_BWR_NG" bw-s1)" "prompts:lint"
_bwreset; _bwcatch '?' lint "$_BWT" bw-s1
_bwwrote '?' lesson "$(( _BWT + 600 ))" bw-s1; _bwprose "$(( _BWT + 600 ))"
is "from outside git with SIDS empty, a named catch is not settled by its session's row" \
   "$(_bwsays "$_BWR_NG" '')" "prompts:lint"

# =========================================================== (e) untimed rows
# Four columns, no epoch. Taken at mistakes.log's time, or by the day it names.
_BWM="$(_bwago 30)"   # mistakes.log's mtime
_bwuntimed() { printf '%s\tbw/this\t0123abc\tlint\n' "$1" > "$_BWK"; _bwmt "$_BWM" "$_BWK"; }
_bwreset; _bwuntimed "$_BWTODAY"
_bwwrote bw/this lesson "$(( _BWM + 600 ))" - "$_BWTODAY"
is "an untimed catch is settled by a same-branch row whose epoch is after mistakes.log's time" \
   "$(_bwsays "$_BWR_THIS" bw-s1)" "silent"
_bwreset; _bwuntimed "$_BWTODAY"
_bwwrote bw/this lesson "$(( _BWM - 600 ))" - "$_BWTODAY"
is "and not by one before that time on the same day" "$(_bwsays "$_BWR_THIS" bw-s1)" "prompts:lint"
_bwreset; _bwuntimed "$_BWDAY2"
_bwwrote bw/this lesson "$(( _BWM - 600 ))" - "$_BWTODAY"
is "an untimed catch is settled by a same-branch row dated a later day, though its epoch is earlier" \
   "$(_bwsays "$_BWR_THIS" bw-s1)" "silent"
_bwreset; _bwuntimed "$_BWDAY2"
_bwwrote bw/this lesson "$(( _BWM - 600 ))" - "$_BWDAY2"
is "and not by that row dated the catch's own day" "$(_bwsays "$_BWR_THIS" bw-s1)" "prompts:lint"
_bwreset; _bwuntimed "$_BWDAY2"
_bwwrote bw/other lesson "$(( _BWM + 600 ))" - "$_BWTODAY"
is "an untimed catch is not settled by another branch's later row" "$(_bwsays "$_BWR_THIS" bw-s1)" "prompts:lint"

# ============================================ (f) prose mtimes settle nothing
_bwreset; _bwcatch bw/this lint "$_BWT" bw-s1
printf -- '- **%s** consolidated by hand\n' "$_BWTODAY" > "$_BWL"; _bwmt "$(( _BWT + 600 ))" "$_BWL"
is "a lessons.md written by hand after the catch, with no written row, does not settle it" \
   "$(_bwsays "$_BWR_THIS" bw-s1)" "prompts:lint"
_bwreset; _bwcatch bw/this lint "$_BWT" bw-s1
printf '\n## %s by hand\n\nan entry\n' "$_BWTODAY" > "$_BWV"; _bwmt "$(( _BWT + 600 ))" "$_BWV"
is "a DEVLOG.md entry written by hand after the catch does not settle it" "$(_bwsays "$_BWR_THIS" bw-s1)" "prompts:lint"
_bwreset; _bwcatch bw/this lint "$_BWT" -
_bwprose "$(( _BWT + 600 ))"
is "nor do hand-written lessons and devlog settle a branch-owned catch" "$(_bwsays "$_BWR_THIS" bw-s1)" "prompts:lint"
_bwreset; _bwuntimed "$_BWDAY2"
_bwprose "$(( _BWM + 600 ))"
is "nor an untimed catch, though both are newer than mistakes.log and a later day" \
   "$(_bwsays "$_BWR_THIS" bw-s1)" "prompts:lint"
_bwreset; _bwcatch bw/this lint "$_BWT" bw-s1
_bwprose "$(( _BWT + 600 ))"
is "both hand-written files newer than this session's catch, with no written row, do not settle it" \
   "$(_bwsays "$_BWR_THIS" bw-s1)" "prompts:lint"
_bwwrote bw/this lesson "$(( _BWT + 600 ))" bw-s1
is "the same hand-written files beside this session's written row are silent" "$(_bwsays "$_BWR_THIS" bw-s1)" "silent"

# =============================================================== (g) malformed
_bwbadrow() {  # epoch column as given, otherwise this session's row after the catch
  _bwreset; _bwcatch bw/this lint "$_BWT" bw-s1
  printf '%s\tbw/this\t0123abc\tlesson\t%s\tbw-s1\n' "$_BWTODAY" "$1" > "$_BWW"
  _bwsays "$_BWR_THIS" bw-s1
}
is "a written row whose epoch has a leading zero settles nothing" "$(_bwbadrow "0$(( _BWT + 600 ))")" "prompts:lint"
is "a written row whose epoch has thirteen digits settles nothing" "$(_bwbadrow 9999999999999)" "prompts:lint"
is "a written row whose epoch is not a number settles nothing" "$(_bwbadrow later)" "prompts:lint"
is "a written row whose epoch is empty settles nothing" "$(_bwbadrow '')" "prompts:lint"
is "a written row whose epoch is negative settles nothing" "$(_bwbadrow "-$(( _BWT + 600 ))")" "prompts:lint"
_bwreset; _bwcatch bw/this lint "$_BWT" -
printf '%s\tbw/this\t0123abc\tlesson\n' "$_BWTODAY" > "$_BWW"
is "a four-column written row on the catch's branch settles nothing" "$(_bwsays "$_BWR_THIS" bw-s1)" "prompts:lint"
_bwreset; _bwcatch bw/this lint "$_BWT" bw-s1
printf '%s\tbw/this\t0123abc\tlesson\t%s\n' "$_BWTODAY" "$(( _BWT + 600 ))" > "$_BWW"
is "a five-column written row, naming no session, does not settle a session-owned catch" \
   "$(_bwsays "$_BWR_THIS" bw-s1)" "prompts:lint"
_bwreset; _bwcatch bw/this lint "$_BWT" bw-s1
: > "$_BWW"
is "an empty written.log settles nothing" "$(_bwsays "$_BWR_THIS" bw-s1)" "prompts:lint"
_bwreset; _bwcatch bw/this lint "$_BWT" bw-s1
is "a missing written.log settles nothing" "$(_bwsays "$_BWR_THIS" bw-s1)" "prompts:lint"
_bwreset; _bwcatch bw/this lint "$_BWT" bw-s1
{ printf '%s\tbw/this\t0123abc\tlesson\t0%s\tbw-s1\n' "$_BWTODAY" "$(( _BWT + 600 ))"
  printf '%s\tbw/this\t0123abc\tlesson\n' "$_BWTODAY"
  printf 'garbage\n'; } > "$_BWW"
is "a written.log of malformed rows only settles nothing" "$(_bwsays "$_BWR_THIS" bw-s1)" "prompts:lint"
_bwwrote bw/this lesson "$(( _BWT + 600 ))" bw-s1
is "and one well-formed row of this session's after them does" "$(_bwsays "$_BWR_THIS" bw-s1)" "silent"

# ============================================================ (h) kind log
_bwreset; _bwcatch bw/this lint "$_BWT" bw-s1
_bwwrote bw/this log "$(( _BWT + 600 ))" bw-s1
is "this session's log row settles its catch as a lesson row does" "$(_bwsays "$_BWR_THIS" bw-s1)" "silent"
_bwreset; _bwcatch bw/this lint "$_BWT" bw-s1
_bwwrote bw/this log "$(( _BWT + 600 ))" bw-peer
is "a peer's log row does not" "$(_bwsays "$_BWR_THIS" bw-s1)" "prompts:lint"
_bwreset; _bwcatch bw/this lint "$_BWT" -
_bwwrote bw/this log "$(( _BWT + 600 ))" -
is "a log row on the branch settles a branch-owned catch" "$(_bwsays "$_BWR_THIS" bw-s1)" "silent"
_bwreset; _bwcatch bw/this lint "$_BWT" -
_bwwrote bw/other log "$(( _BWT + 600 ))" -
is "a log row on another branch does not" "$(_bwsays "$_BWR_THIS" bw-s1)" "prompts:lint"
_bwreset

# ================================================= (i) CLI and the Stop hook
# A governed throwaway checkout, green but for the catch: a gate that passes,
# a probe that reads the marker, and a verify record for its tree.
_BWHP="$FROOT/projects/bwhook"; _BWHM="$MEM/bwhook"; mkdir -p "$_BWHP" "$_BWHM"
printf '{\n  "name": "bwhook",\n  "remote_match": "example.com/bwhook",\n  "gate": "true"\n}\n' > "$_BWHP/project.json"
printf 'marker\t-\t-\tls -1 .felix\ttest -f .felix\n' > "$_BWHP/probes.tsv"
_BWHR="$TMP/bw-hook-repo"; _bwrepo "$_BWHR" bw/hook; _BWHR="$(cd "$_BWHR" && pwd -P)"
printf 'bwhook\n' > "$_BWHR/.felix"; printf 'uncommitted\n' > "$_BWHR/work.txt"
( cd "$_BWHR" && . "$FROOT/harness/lib/verify.sh"
  felix_verify_record "$_BWHR" "$FROOT" 0 "gate.sh" "$(felix_tree_id "$_BWHR" "$FROOT")" "" >/dev/null 2>&1 )
_bwstop() { ( cd "$_BWHR" && printf '{"hook_event_name":"Stop","stop_hook_active":false,"session_id":"%s"}' "$1" \
               | "$FROOT/harness/hooks/stop" 2>&1 ); }
_bwhcatch() {  # a catch this checkout's session filed half an hour ago
  rm -f "$_BWHM/mistakes.log" "$_BWHM/written.log" "$_BWHM/lessons.md" "$_BWHM/DEVLOG.md"
  printf '%s\tbw/hook\t0123abc\tlint\t%s\t%s\n' "$(_bwday "$_BWT")" "$_BWT" "$1" > "$_BWHM/mistakes.log"
  _bwmt "$_BWT" "$_BWHM/mistakes.log"
}
_bwcli() {  # session command text: felix run inside the checkout
  if [ -n "$1" ]; then ( cd "$_BWHR" && CLAUDE_CODE_SESSION_ID="$1" "$FROOT/harness/felix" "$2" "$3" ) >/dev/null 2>&1
  else ( cd "$_BWHR" && unset CLAUDE_CODE_SESSION_ID && "$FROOT/harness/felix" "$2" "$3" ) >/dev/null 2>&1; fi
}

_bwhcatch bw-e2e-a
has "through the Stop hook, this session's catch with nothing written prompts" "$(_bwstop bw-e2e-a)" "nothing has been written down"

_bwhcatch bw-e2e-b
_bwcli bw-e2e-b lesson "bw e2e lesson"
is "felix lesson run in the checkout leaves a written.log row for its session, branch and kind" \
   "$(tail -1 "$_BWHM/written.log" 2>/dev/null | cut -f2,4,6 | tr '\t' '|')" "bw/hook|lesson|bw-e2e-b"
is "through the Stop hook, this session's felix lesson after its catch gives no prompt" "$(_bwstop bw-e2e-b)" ""

_bwhcatch bw-e2e-c
_bwcli bw-e2e-peer lesson "bw e2e peer lesson"
has "through the Stop hook, a peer session's felix lesson after this session's catch still prompts" \
    "$(_bwstop bw-e2e-c)" "nothing has been written down"

_bwhcatch bw-e2e-d
_bwcli bw-e2e-d log "bw e2e log"
is "felix log run in the checkout leaves a written.log row of kind log for its session" \
   "$(tail -1 "$_BWHM/written.log" 2>/dev/null | cut -f2,4,6 | tr '\t' '|')" "bw/hook|log|bw-e2e-d"
is "through the Stop hook, this session's felix log after its catch gives no prompt" "$(_bwstop bw-e2e-d)" ""

_bwhcatch bw-e2e-e
_bwcli bw-e2e-peer2 log "bw e2e peer log"
has "through the Stop hook, a peer session's felix log after this session's catch still prompts" \
    "$(_bwstop bw-e2e-e)" "nothing has been written down"

_bwhcatch bw-e2e-f
_bwcli '' lesson "bw e2e sessionless lesson"
has "through the Stop hook, a felix lesson run outside every session does not settle this session's catch" \
    "$(_bwstop bw-e2e-f)" "nothing has been written down"

rm -rf "$_BWHP" "$_BWHM"
_bwreset
unset -f _bwago _bwstamp _bwday _bwmt _bwreset _bwcatch _bwwrote _bwprose _bwverdict _bwsays _bwsays0 \
         _bwg _bwrepo _bwhead _bwrows _bwlast _bwnf _bwwhen _bwbytes _bwpick _bwlesson _bwlog _bwsess \
         _bwuntimed _bwbadrow _bwstop _bwhcatch _bwcli
unset _BWD _BWK _BWW _BWL _BWV _BWFIRST _BWN _BWTODAY _BWDAY2 _BWR_THIS _BWR_V _BWR_W _BWR_DET _BWR_UB _BWR_NG \
      _BWSHA _BWDSHA _BWT _BWM _BWHP _BWHM _BWHR _bwt0 _bwt1 _bwd0 _bwd1 _bwgot _bwhdr _bwhv _bwout _bwb
rm -rf "$GP"

printf '\nnoticing when another plugin breaks the session\n'
# A plugin that ships hooks is a dependency on that plugin working. When one
# refuses, the error lands on the tool rather than on the plugin that caused
# it, so it reads as the editor being broken. Claude Code records these
# properly, which is what makes noticing them cheap.
GT="$TMP/guard.jsonl"
cat > "$GT" <<'JSONL'
{"type":"attachment","attachment":{"type":"hook_blocking_error","hookName":"PostToolUse:Write","hookEvent":"PostToolUse","blockingError":{"blockingError":"Not logged into Semgrep Guardian. Ask the guardian mcp to login.","command":"bash x"}}}
{"type":"attachment","attachment":{"type":"hook_blocking_error","hookName":"PostToolUse:Write","hookEvent":"PostToolUse","blockingError":{"blockingError":"Not logged into Semgrep Guardian. Ask the guardian mcp to login.","command":"bash x"}}}
{"type":"assistant","message":{"content":[]}}
JSONL
rows="$( . "$FROOT/harness/lib/guard.sh"; felix_guard_blocks "$GT" )"
has "counts what was blocked"     "$rows" "2"
has "and names the hook"          "$rows" "PostToolUse:Write"
has "and quotes what it said"     "$rows" "Not logged into Semgrep"
# A transcript with no blocks must say nothing at all.
printf '{"type":"assistant"}\n' > "$TMP/clean.jsonl"
q="$( . "$FROOT/harness/lib/guard.sh"; felix_guard_blocks "$TMP/clean.jsonl" )"
is "silent when nothing was blocked" "${#q}" "0"
# A missing transcript is a fact, not a crash.
q="$( . "$FROOT/harness/lib/guard.sh"; felix_guard_blocks "$TMP/nope.jsonl" )"; rc=$?
is "survives a transcript that is not there" "$rc" "0"

out="$(cd "$REPO" && "$FELIX" quarantine definitely-not-installed 2>&1)"; rc=$?
[ "$rc" -ne 0 ] && ok "quarantine refuses a plugin that is not here" \
                || bad "quarantine refuses a plugin that is not here" "$out"

# The report exists for ANOTHER plugin's hook, and it never checked. Felix's own
# Stop hook holds a chain until the gate has seen the tree — working exactly as
# designed — and that block came back to the founder under the headline "and it
# was not Felix", attributed to the felix plugin two lines below, with the
# remedy `felix quarantine felix`. A report that contradicts itself inside four
# lines and then recommends switching off the system that produced it. Observed
# live, not constructed: it fired twice in the session that fixed it.
_isown() { ( . "$FROOT/harness/lib/guard.sh"; . "$FROOT/harness/lib/ready.sh"
             felix_guard_is_own "$1" ) && printf yes || printf no; }
is "Felix's own gate refusal is recognised as its own" \
   "$(_isown 'The gate last ran at 2026-08-13T09:30:36Z, on a different tree. Run felix gate. Or set FELIX_ALLOW_RED=1.')" "yes"
is "and so is a deny from its own PreToolUse" \
   "$(_isown 'felix: this project forbids that command. See felix which.')" "yes"
is "another plugin's refusal is not"  \
   "$(_isown 'Not logged into Semgrep Guardian. Ask the guardian mcp to login.')" "no"
is "and neither is an empty message"  "$(_isown '')" "no"

printf '\ndiscovery runs on a cadence, not in front of a prompt\n'
DH="$TMP/dhome"; mkdir -p "$DH/state/discover"
# Every fixture cache carries the stamp a real one does, or the readers treat
# it as absent — which is the point, asserted below.
_dstamp() { ( . "$FROOT/harness/lib/discover.sh"; _felix_discover_stamp_line "$FROOT/harness/templates" ); }
DP="$FROOT/projects/widget"
# Never refreshed is stale; that is what makes the first run happen at all.
( . "$FROOT/harness/lib/discover.sh"; felix_discover_stale "$DP" "$DH" ) \
  && ok "a cache that never existed is stale" || bad "a cache that never existed is stale"
{ _dstamp; printf 'deepeval\tllm\tlow\nlangfuse\tllm\tlow\n'; } > "$DH/state/discover/widget.tsv"
( . "$FROOT/harness/lib/discover.sh"; felix_discover_stale "$DP" "$DH" ) \
  && bad "a fresh cache is not stale" || ok "a fresh cache is not stale"
new="$( . "$FROOT/harness/lib/discover.sh"; felix_discover_unseen "$DP" "$DH" | tr '\n' ' ' )"
has "reports findings the first time" "$new" "deepeval"
( . "$FROOT/harness/lib/discover.sh"; felix_discover_mark_seen "$DP" "$DH" )
( . "$FROOT/harness/lib/discover.sh"; grep -q '^#' "$(_felix_discover_cache "$DP" "$DH").seen" ) \
  && bad "the seen file never carries the stamp comment" || ok "the seen file never carries the stamp comment"
new="$( . "$FROOT/harness/lib/discover.sh"; felix_discover_unseen "$DP" "$DH" )"
is "and never mentions the same one twice" "${#new}" "0"
# Something genuinely new must still get through.
printf 'sonarqube\tsecrets\thigh\n' >> "$DH/state/discover/widget.tsv"
new="$( . "$FROOT/harness/lib/discover.sh"; felix_discover_unseen "$DP" "$DH" | tr '\n' ' ' )"
has "but a new one does get through" "$new" "sonarqube"

# An unreadable catalogue is not an empty one. felix_discover_candidates used to
# come back with no rows whether the marketplaces had nothing for this project
# or the CLI had fallen over, and the quiet form wrote the second as the first
# into a cache that stays current for seven days. Read by an agent from the
# find-skills plugin's catalogue reader, which draws the line this one did not.
printf '\nan unreadable catalogue is not an empty one\n'
DCP="$TMP/discover-cands"; mkdir -p "$DCP/proj" "$DCP/bin-fail" "$DCP/bin-prose" "$DCP/bin-empty" "$DCP/bin-hit" "$DCP/bin-none" "$DCP/bin-tail" "$DCP/bin-many"
printf 'llm\n' > "$DCP/proj/capabilities"
printf 'plugin\tanthropic-skills\t-\tlow\talways\n' > "$DCP/proj/stack.tsv"
printf '#!/bin/sh\nexit 1\n' > "$DCP/bin-fail/claude"
printf '#!/bin/sh\necho "Error: could not reach the marketplace"\n' > "$DCP/bin-prose/claude"
printf '#!/bin/sh\necho "[]"\n' > "$DCP/bin-empty/claude"
cat > "$DCP/bin-hit/claude" <<'STUB'
#!/bin/sh
cat <<'J'
[
  {
    "name": "deepeval",
    "description": "llm evaluation and prompt testing"
  }
]
J
STUB
# A listing whose LAST entry does not match. This is the shape the whole
# fix turned on: a `while` loop's status is its last body command's, so the
# scoring loop returned 1 for every catalogue ending in a non-match — which
# is most catalogues — and cmd_discover, once it started reading the status,
# called a perfectly readable marketplace unreadable.
cat > "$DCP/bin-tail/claude" <<'STUB'
#!/bin/sh
cat <<'J'
[
  {
    "name": "deepeval",
    "description": "llm evaluation and prompt testing"
  },
  {
    "name": "laundry-folder",
    "description": "a widget for folding laundry"
  }
]
J
STUB
# More matches than FELIX_DISCOVER_MAX, so `head` closes the pipe on the
# rows still coming and everything upstream takes SIGPIPE. The same shape as
# the grep -q lesson this repository already carries.
{ printf '#!/bin/sh\ncat <<J\n[\n'
  i=1; while [ "$i" -le 12 ]; do
    [ "$i" -eq 1 ] || printf ',\n'
    printf '  {\n    "name": "llm-tool-%s",\n    "description": "llm prompt evaluation and inference"\n  }' "$i"
    i=$((i+1))
  done
  printf '\n]\nJ\n'; } > "$DCP/bin-many/claude"
chmod +x "$DCP"/bin-*/claude
_dcands() { ( PATH="$DCP/$1:$PATH"; export PATH
              . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/detect.sh"; . "$FROOT/harness/lib/discover.sh"
              out="$(felix_discover_candidates "$DCP/proj" "$FROOT/harness/templates")"; rc=$?
              printf '%s|%s' "$rc" "$out" ); }
is  "a CLI that fails is exit 3 and no rows" "$(_dcands bin-fail)" "3|"
is  "a CLI that prints an error and exits 0 is exit 3 and no rows too" "$(_dcands bin-prose)" "3|"
is  "an empty listing is exit 0 and no rows: a catalogue that was read" "$(_dcands bin-empty)" "0|"
has "and a listing with a match still scores it" "$(_dcands bin-hit)" "deepeval"
_dchit="$(_dcands bin-hit)"
is  "with exit 0" "${_dchit%%|*}" "0"
# `cut -d'|' -f1` is line-oriented, so a result with more than one row leaks
# rows into the field being compared. The code is taken by expansion.
_dctail="$(_dcands bin-tail)"; _dcmany="$(_dcands bin-many)"
is  "a catalogue whose LAST entry does not match is still exit 0" "${_dctail%%|*}" "0"
has "and the entry that did match is still returned" "$_dctail" "deepeval"
is  "more matches than the row cap is exit 0, not the pipe closing under it" "${_dcmany%%|*}" "0"
is  "and the cap is what it returns" "$(printf '%s' "${_dcmany#*|}" | grep -c .)" "8"
is  "and no CLI on PATH at all is exit 3, not an empty marketplace" \
    "$( . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/detect.sh"; . "$FROOT/harness/lib/discover.sh"
        PATH="$DCP/bin-none"; export PATH
        felix_discover_candidates "$DCP/proj" "$FROOT/harness/templates" >/dev/null 2>&1; echo $? )" "3"
# Through the CLI: the quiet form writes nothing and exits non-zero, so the
# `&&` every cache writer guards with leaves the previous answer standing.
# The widget declares a capability with a discovery rule for the duration, or
# the candidates function returns before it ever asks the CLI.
cp "$FROOT/projects/widget/capabilities" "$TMP/caps.discover.keep" 2>/dev/null || : > "$TMP/caps.discover.keep"
printf 'llm\n' >> "$FROOT/projects/widget/capabilities"
DCH="$FROOT/state/discover"; mkdir -p "$DCH"
{ _dstamp; printf 'langfuse\tllm\tlow\n'; } > "$DCH/widget.tsv"
DCW="$(cat "$DCH/widget.tsv")"
out="$(cd "$REPO" && PATH="$DCP/bin-fail:$PATH" "$FELIX" discover --inspect --quiet 2>/dev/null)"; rc=$?
is  "felix discover --inspect --quiet exits 2 when the catalogue cannot be read" "$rc" "2"
is  "and prints nothing, not even the stamp" "$out" ""
out="$(cd "$REPO" && PATH="$DCP/bin-fail:$PATH" "$FELIX" discover 2>&1)"
has "and the loud form says the catalogue was never seen" "$out" "could not be read"
is  "the cache already there is untouched" "$(cat "$DCH/widget.tsv")" "$DCW"
# And a writer that actually writes. The assertion above runs the loud form,
# which has no cache writer in any version, so it could not have failed for
# the defect it is named after. --adopt fills a cache it finds STALE, and
# that fill is one of the two the guard was added to: a stale answer must
# survive a failed read rather than be replaced by an empty one.
DCS="# stamp not-the-current-one
langfuse	llm	low"
printf '%s\n' "$DCS" > "$DCH/widget.tsv"
out="$(cd "$REPO" && PATH="$DCP/bin-fail:$PATH" "$FELIX" discover --adopt 2>&1)"; rc=$?
is  "a stale cache and an unreadable catalogue adopts nothing" "$rc" "2"
is  "and the stale answer is still there, not replaced by an empty one" "$(cat "$DCH/widget.tsv")" "$DCS"
[ -e "$DCH/widget.tsv.new" ] && bad "and no half-written cache is left beside it" "left behind" || ok "and no half-written cache is left beside it"
rm -f "$DCH/widget.tsv"
out="$(cd "$REPO" && PATH="$DCP/bin-fail:$PATH" "$FELIX" discover --adopt 2>&1)"; rc=$?
is  "discover --adopt with no cache and no catalogue adopts nothing and says why" "$rc" "2"
has "in words" "$out" "nothing was adopted"
[ -e "$DCH/widget.tsv" ] && bad "and writes no cache" "$(cat "$DCH/widget.tsv")" || ok "and writes no cache"
[ -e "$DCH/widget.tsv.new" ] && bad "nor a half-written one" "left behind" || ok "nor a half-written one"
out="$(cd "$REPO" && PATH="$DCP/bin-empty:$PATH" "$FELIX" discover --inspect --quiet 2>/dev/null)"; rc=$?
is  "and a catalogue that was read and matched nothing is exit 0" "$rc" "0"
is  "with the stamp and no rows, which is an empty cache and a real answer" "$out" "$(_dstamp)"
cp "$TMP/caps.discover.keep" "$FROOT/projects/widget/capabilities"

printf '\ndiscovery reads before it recommends\n'
# The plugin format has no permission declaration and `claude plugin validate`
# checks schema only, so the only way to know what something does is to read it.
# Fixtures throughout: this must never touch the network to be tested.
DF="$TMP/discover-fixtures"
mkdir -p "$DF/skillsonly/skills/a" "$DF/hooky/hooks" "$DF/mcplocal" "$DF/floaty" "$DF/creds"
printf '{"mcpServers":{"x":{"command":"/usr/local/bin/x","args":["run"]}}}\n' > "$DF/mcplocal/.mcp.json"
printf '{"hooks":{"PreToolUse":[{"hooks":[{"command":"bash s.sh"}]}]}}\n'     > "$DF/hooky/hooks/hooks.json"
printf '{"mcpServers":{"x":{"command":"npx","args":["pkg@latest"]}}}\n'       > "$DF/floaty/.mcp.json"
printf '{"mcpServers":{"x":{"type":"http","url":"https://e.example","headers":{"Authorization":"${SECRET_TOKEN}"}}}}\n' > "$DF/creds/.mcp.json"

_tier() { ( . "$FROOT/harness/lib/discover.sh"
            felix_discover_risk "$(felix_discover_inspect "$1")" ); }
is "skills only is low"                  "$(_tier "$DF/skillsonly")" "low"
is "a pinned local server is medium"     "$(_tier "$DF/mcplocal")"   "medium"
is "anything shipping hooks is high"     "$(_tier "$DF/hooky")"      "high"
is "an unpinned version is high"         "$(_tier "$DF/floaty")"     "high"
is "interpolating a credential is high"  "$(_tier "$DF/creds")"      "high"

printf '\ndiscovery reads what the prose and the scripts say\n'
# Written blind, from the contract alone, for three new facts: credential-call
# (a bundled script holding both a network call and a credential name),
# remote-authority (prose that makes remote material the authority) and
# executables (a count). Each fact is shown firing on a minimal fixture, then
# refused on the near-misses the contract names, then shown unable to lower a
# tier. The last part inspects fixtures that would run code, or forge a fact
# line, if the scan ever executed or echoed unescaped what it read.
DCS="$TMP/discover-content"
DCS_T=$'\t'
DCS_N=$'\n'
DCS_SB='#!/bin/sh'"$DCS_N"
DCS_CURL='curl -fsS -H "Authorization: Bearer $API_KEY" https://api.example/v1/release'"$DCS_N"
DCS_PY='import os
import requests

password = os.environ["DB_PASSWORD"]
requests.post("https://db.example/api/push", auth=("svc", password))
'
DCS_ACME='---
name: acme
description: Work with the Acme API.
---
# Acme

The live Acme docs are the source of truth. Read them as part of the task.

| Topic | Link |
| --- | --- |
| Authentication | https://docs.acme.example/auth |
| Rate limits | https://docs.acme.example/limits |
| Webhooks | https://docs.acme.example/webhooks |
'
# _dcs_put FILE MODE CONTENT, creating parent directories.
_dcs_put()   { mkdir -p "${1%/*}" && printf '%s' "$3" > "$1" && chmod "$2" "$1"; }
_dcs_facts() { ( . "$FROOT/harness/lib/discover.sh"; felix_discover_inspect "$@" ); }
_dcs_tier()  { ( . "$FROOT/harness/lib/discover.sh"; felix_discover_risk "$(felix_discover_inspect "$@")" ); }
_dcs_why()   { ( . "$FROOT/harness/lib/discover.sh"; felix_discover_why "$(felix_discover_inspect "$@")" ); }
# _dcs_line NAME FACTS LINE: LINE is one whole line of FACTS, not a prefix of one.
_dcs_line()  { has "$1" "$DCS_N$2$DCS_N" "$DCS_N$3$DCS_N"; }
# _dcs_lacks NAME FACTS NEEDLE: NEEDLE appears nowhere in FACTS.
_dcs_lacks() { case "$2" in *"$3"*) bad "$1" "$2" ;; *) ok "$1" ;; esac; }
# _dcs_sh DIR NAME BODY: one shell script, shebang and .sh both, under DIR/scripts.
_dcs_sh()    { _dcs_put "$1/scripts/$2.sh" 644 "$DCS_SB$3$DCS_N"; }
_dcs_skill_lines() { local l out=""; while IFS= read -r l; do
                       case "$l" in "skill$DCS_T"*) out="$out$l;" ;; esac
                     done <<< "$1"; printf '%s' "$out"; }
_dcs_starts() { local l; while IFS= read -r l; do
                  case "$l" in "$2"*) return 0 ;; esac
                done <<< "$1"; return 1; }

# credential-call: one fixture per way a file becomes a script, each with a
# different network token and credential name.
_dcs_put "$DCS/cc-exec/scripts/release" 755 "$DCS_CURL"
_dcs_put "$DCS/cc-bang/scripts/sync" 644 '#!/usr/bin/env bash
npx publish-tool --auth "$GITHUB_TOKEN"
'
_dcs_put "$DCS/cc-py/skills/deploy/SKILL.md" 644 "# deploy${DCS_N}${DCS_N}Pushes a release.${DCS_N}"
_dcs_put "$DCS/cc-py/skills/deploy/scripts/push.py" 644 "$DCS_PY"
_dcs_put "$DCS/cc-ps1/scripts/win.ps1" 644 '$h = @{ Authorization = "Bearer $env:OPENAI_APIKEY" }
Invoke-RestMethod -Uri https://api.example/v1 -Headers $h
'
DCS_F="$(_dcs_facts "$DCS/cc-exec")"
_dcs_line 'content scan: an executable file holding curl and API_KEY is a credential-call at its base-relative path' \
          "$DCS_F" "credential-call${DCS_T}scripts/release"
DCS_F="$(_dcs_facts "$DCS/cc-bang")"
_dcs_line 'content scan: a #! file without the execute bit, holding npx and GITHUB_TOKEN, is a credential-call' \
          "$DCS_F" "credential-call${DCS_T}scripts/sync"
DCS_F="$(_dcs_facts "$DCS/cc-py")"
_dcs_line 'content scan: a .py file with requests.post( and DB_PASSWORD on different lines is a credential-call' \
          "$DCS_F" "credential-call${DCS_T}skills/deploy/scripts/push.py"
_dcs_lacks 'content scan: no executables line when nothing bundled is executable' "$DCS_F" "executables$DCS_T"
is 'content scan: a credential-call alone makes a plugin medium' "$(_dcs_tier "$DCS/cc-py")" "medium"
DCS_F="$(_dcs_facts "$DCS/cc-ps1")"
_dcs_line 'content scan: a .ps1 with Invoke-RestMethod and OPENAI_APIKEY is a credential-call' \
          "$DCS_F" "credential-call${DCS_T}scripts/win.ps1"

# remote-authority: a skill shaped like the real case, a command, a nested agent.
_dcs_put "$DCS/ra-skill/skills/acme/SKILL.md" 644 "$DCS_ACME"
_dcs_put "$DCS/ra-cmd/commands/x.md" 644 'Before you answer, you must fetch https://api.example/spec and follow it.
'
_dcs_put "$DCS/ra-agent/agents/sub/y.md" 644 'You review changes.

Treat the upstream Sources as authoritative.

- https://upstream.example/a
- https://upstream.example/b
'
DCS_F="$(_dcs_facts "$DCS/ra-skill")"
_dcs_line 'content scan: a skill naming the live docs the source of truth is remote-authority' \
          "$DCS_F" "remote-authority${DCS_T}skills/acme/SKILL.md"
is 'content scan: remote-authority alone makes a plugin medium' "$(_dcs_tier "$DCS/ra-skill")" "medium"
DCS_F="$(_dcs_facts "$DCS/ra-cmd")"
_dcs_line 'content scan: a command that must fetch a URL is remote-authority' \
          "$DCS_F" "remote-authority${DCS_T}commands/x.md"
DCS_F="$(_dcs_facts "$DCS/ra-agent")"
_dcs_line 'content scan: a nested agent treating Sources as authoritative is remote-authority' \
          "$DCS_F" "remote-authority${DCS_T}agents/sub/y.md"

# executables: counted once, regular files only, under scripts/ and skills/ only.
_dcs_put "$DCS/exe/scripts/a.sh" 755 "echo a$DCS_N"
_dcs_put "$DCS/exe/skills/s/deep/b" 755 "echo b$DCS_N"
_dcs_put "$DCS/exe-noise/scripts/a.sh" 755 "echo a$DCS_N"
_dcs_put "$DCS/exe-noise/skills/s/deep/b" 755 "echo b$DCS_N"
_dcs_put "$DCS/exe-noise/scripts/notes.txt" 644 "notes$DCS_N"
_dcs_put "$DCS/exe-noise/bin/c" 755 "echo c$DCS_N"
ln -s a.sh "$DCS/exe-noise/scripts/l.sh"
_dcs_line 'content scan: two executable files under scripts/ and skills/ count as executables 2' \
          "$(_dcs_facts "$DCS/exe")" "executables${DCS_T}2"
is 'content scan: bundled executables alone leave a plugin low' "$(_dcs_tier "$DCS/exe")" "low"
_dcs_line 'content scan: symlinks, non-executables and files outside scripts/ and skills/ are not counted' \
          "$(_dcs_facts "$DCS/exe-noise")" "executables${DCS_T}2"

# Near-misses for credential-call. Each fixture holds one script, a shebang and
# a .sh name both, so the only reason it can fail to fire is the content rule.
_dcs_sh "$DCS/nm-nokey"  status 'curl -fsS https://api.example/status'
_dcs_sh "$DCS/nm-nonet"  setup  'export OPENAI_API_KEY="$1"'"$DCS_N"'echo configured'
_dcs_sh "$DCS/nm-bare"   bare   'curl -H "a: $TOKEN" -u "svc:$PASSWORD" -d "$SECRET" https://api.example'
_dcs_sh "$DCS/nm-lower"  lower  'curl -d "api_key=$api_key" https://api.example'
_dcs_sh "$DCS/nm-file"   file   'curl -H @"$GITHUB_TOKEN_FILE" https://api.example'
_dcs_sh "$DCS/nm-glued"  glued  'curl -H "k: $myAPI_KEY" https://api.example'
_dcs_sh "$DCS/nm-curly"  curly  'echo "curly braces around $API_KEY"'
_dcs_sh "$DCS/nm-npxt"   npxt   'npxtool run --key "$API_KEY"'
_dcs_sh "$DCS/nm-upper"  upper  'CURL -H "k: $API_KEY" https://api.example'
_dcs_lacks 'content scan: a network token with no credential name is not a credential-call' \
           "$(_dcs_facts "$DCS/nm-nokey")" "credential-call$DCS_T"
_dcs_lacks 'content scan: a credential name with no network token is not a credential-call' \
           "$(_dcs_facts "$DCS/nm-nonet")" "credential-call$DCS_T"
_dcs_lacks 'content scan: TOKEN, SECRET and PASSWORD alone are not credential names' \
           "$(_dcs_facts "$DCS/nm-bare")" "credential-call$DCS_T"
_dcs_lacks 'content scan: lower-case api_key is not a credential name' \
           "$(_dcs_facts "$DCS/nm-lower")" "credential-call$DCS_T"
_dcs_lacks 'content scan: GITHUB_TOKEN_FILE is not a credential name' \
           "$(_dcs_facts "$DCS/nm-file")" "credential-call$DCS_T"
_dcs_lacks 'content scan: API_KEY glued to a lower-case letter is not a credential name' \
           "$(_dcs_facts "$DCS/nm-glued")" "credential-call$DCS_T"
_dcs_lacks 'content scan: curl inside curly is not a network token' \
           "$(_dcs_facts "$DCS/nm-curly")" "credential-call$DCS_T"
_dcs_lacks 'content scan: npx inside npxtool is not a network token' \
           "$(_dcs_facts "$DCS/nm-npxt")" "credential-call$DCS_T"
_dcs_lacks 'content scan: upper-case CURL is not a network token' \
           "$(_dcs_facts "$DCS/nm-upper")" "credential-call$DCS_T"

# Near-misses by place and by kind of file: a credentialed call is present in
# every one, but not in a SCRIPT FILE under scripts/ or skills/.
_dcs_put "$DCS/nm-out/tools/push.sh" 755 "$DCS_SB$DCS_CURL"
_dcs_put "$DCS/nm-out/deploy.py" 644 "$DCS_PY"
_dcs_put "$DCS/nm-doc/skills/gh/SKILL.md" 644 '# gh

Check the token works:

    curl -H "Authorization: Bearer $GITHUB_TOKEN" https://api.github.example/user
'
_dcs_put "$DCS/nm-doc/scripts/notes.txt" 644 "$DCS_CURL"
mkdir -p "$DCS/nm-nul/scripts"
printf '#!/bin/sh\ncurl -H "k: $API_KEY" https://api.example\n\000\001\002\n' > "$DCS/nm-nul/scripts/blob.sh"
chmod 755 "$DCS/nm-nul/scripts/blob.sh"
# The contract says containing a NUL, anywhere: this one sits past 128 KiB of
# text, beyond a first-buffer binary check and after the lines that would match.
mkdir -p "$DCS/nm-latenul/scripts"
{ printf '#!/bin/sh\ncurl -H "k: $API_KEY" https://api.example\n'
  DCS_I=0; while [ "$DCS_I" -lt 2048 ]; do
    printf '# padding that pushes the NUL byte past any first-buffer check.\n'; DCS_I=$((DCS_I+1)); done
  printf '\000\n'; } > "$DCS/nm-latenul/scripts/blob.sh"
chmod 755 "$DCS/nm-latenul/scripts/blob.sh"
_dcs_put "$DCS/nm-sym/outside/real.sh" 755 "$DCS_SB$DCS_CURL"
mkdir -p "$DCS/nm-sym/scripts"
ln -s ../outside/real.sh "$DCS/nm-sym/scripts/link.sh"
_dcs_lacks 'content scan: scripts outside scripts/ and skills/ are not read' \
           "$(_dcs_facts "$DCS/nm-out")" "credential-call$DCS_T"
_dcs_lacks 'content scan: markdown and text under skills/ and scripts/ are not scripts' \
           "$(_dcs_facts "$DCS/nm-doc")" "credential-call$DCS_T"
_dcs_lacks 'content scan: a script holding a NUL byte is never a credential-call' \
           "$(_dcs_facts "$DCS/nm-nul")" "credential-call$DCS_T"
_dcs_lacks 'content scan: a NUL byte 128 KiB into a script still makes it binary' \
           "$(_dcs_facts "$DCS/nm-latenul")" "credential-call$DCS_T"
_dcs_lacks 'content scan: a symlink under scripts/ is not followed to a credentialed script' \
           "$(_dcs_facts "$DCS/nm-sym")" "credential-call$DCS_T"

# Near-misses for remote-authority: each is a prose file, or the Acme text in
# a place that is not prose.
_dcs_put "$DCS/rn-codebase/skills/c/SKILL.md" 644 '# c

The codebase is the source of truth.

See https://example.com/changelog for release notes.
'
_dcs_put "$DCS/rn-next/commands/n.md" 644 'Treat these as the source of truth:
the docs on the vendor site,
https://vendor.example/guide
'
_dcs_put "$DCS/rn-single/commands/s.md" 644 'Always check the reference before editing.

Background: https://example.com/guide
'
_dcs_put "$DCS/rn-noterm/commands/t.md" 644 'The docs live at https://docs.example.com and change weekly.
'
_dcs_put "$DCS/rn-nourl/commands/u.md" 644 'The docs are the source of truth. Always read the documentation first.
'
_dcs_put "$DCS/rn-root/README.md" 644 "$DCS_ACME"
_dcs_put "$DCS/rn-root/SKILL.md" 644 "$DCS_ACME"
_dcs_put "$DCS/rn-refs/skills/x/SKILL.md" 644 "# x${DCS_N}${DCS_N}Formats files.${DCS_N}"
_dcs_put "$DCS/rn-refs/skills/x/references/guide.md" 644 "$DCS_ACME"
_dcs_put "$DCS/rn-refs/skills/x/nested/SKILL.md" 644 "$DCS_ACME"
_dcs_lacks 'content scan: the codebase as source of truth, with a URL elsewhere, is not remote-authority' \
           "$(_dcs_facts "$DCS/rn-codebase")" "remote-authority$DCS_T"
_dcs_lacks 'content scan: an authority term with docs only on the next line does not fire' \
           "$(_dcs_facts "$DCS/rn-next")" "remote-authority$DCS_T"
_dcs_lacks 'content scan: always check the reference, singular, does not fire' \
           "$(_dcs_facts "$DCS/rn-single")" "remote-authority$DCS_T"
_dcs_lacks 'content scan: a URL and docs with no authority term do not fire' \
           "$(_dcs_facts "$DCS/rn-noterm")" "remote-authority$DCS_T"
_dcs_lacks 'content scan: an authority line with no URL anywhere in the file does not fire' \
           "$(_dcs_facts "$DCS/rn-nourl")" "remote-authority$DCS_T"
_dcs_lacks 'content scan: README.md and a root-level SKILL.md are not prose' \
           "$(_dcs_facts "$DCS/rn-root")" "remote-authority$DCS_T"
_dcs_lacks 'content scan: a skill references/ file and a SKILL.md below skills/<name>/ are not prose' \
           "$(_dcs_facts "$DCS/rn-refs")" "remote-authority$DCS_T"

# Raise only: both new findings beside an existing one never move the tier.
_dcs_both() { _dcs_put "$1/scripts/push.sh" 755 "$DCS_SB$DCS_CURL"
              _dcs_put "$1/skills/acme/SKILL.md" 644 "$DCS_ACME"; }
_dcs_put "$DCS/up-hooks/hooks/hooks.json" 644 '{"hooks":{"PreToolUse":[{"hooks":[{"command":"bash s.sh"}]}]}}'"$DCS_N"
_dcs_put "$DCS/up-mcp/.mcp.json" 644 '{"mcpServers":{"x":{"command":"/usr/local/bin/x","args":["run"]}}}'"$DCS_N"
_dcs_put "$DCS/up-float/.mcp.json" 644 '{"mcpServers":{"x":{"command":"npx","args":["pkg@latest"]}}}'"$DCS_N"
_dcs_both "$DCS/up-hooks"; _dcs_both "$DCS/up-mcp"; _dcs_both "$DCS/up-float"
is 'content scan: hooks stay high whatever the scan adds'                  "$(_dcs_tier "$DCS/up-hooks")" "high"
is 'content scan: a pinned local server stays medium whatever the scan adds' "$(_dcs_tier "$DCS/up-mcp")" "medium"
is 'content scan: an @latest server stays high whatever the scan adds'     "$(_dcs_tier "$DCS/up-float")" "high"

# The subdir argument: the base is <dir>/<subdir>, and paths are relative to it.
_dcs_put "$DCS/sd/plugins/p/scripts/push.sh" 644 "$DCS_SB$DCS_CURL"
_dcs_line 'content scan: with a subdir the scan reads <dir>/<subdir> and paths are relative to it' \
          "$(_dcs_facts "$DCS/sd" plugins/p)" "credential-call${DCS_T}scripts/push.sh"

# Safety. Every script here, and the prose, would leave a sentinel under
# $DCS/safe if run; four names would leave one if evaluated. The scan runs from
# an empty working directory inside $DCS/safe so a stray file lands where it is
# looked for.
DCS_S="$DCS/safe"
mkdir -p "$DCS_S/cwd"
_dcs_put "$DCS_S/p/scripts/run.sh" 755 "$DCS_SB"'touch "'"$DCS_S"'/sentinel-run"'"$DCS_N$DCS_CURL"
_dcs_put "$DCS_S/p/scripts/"'$(touch pwned1).sh'   755 "$DCS_SB$DCS_CURL"
_dcs_put "$DCS_S/p/scripts/"'`touch pwned2`.sh'    755 "$DCS_SB$DCS_CURL"
_dcs_put "$DCS_S/p/scripts/"'x;touch pwned3;.sh'   755 "$DCS_SB$DCS_CURL"
_dcs_put "$DCS_S/p/skills/"'$(touch pwned4)'/SKILL.md 644 "# odd$DCS_N"
_dcs_put "$DCS_S/p/skills/s/SKILL.md" 644 'Always read the docs first: $(touch '"$DCS_S"'/sentinel-md) `touch '"$DCS_S"'/sentinel-tick`
See https://x.example
'
DCS_F="$(cd "$DCS_S/cwd" && _dcs_facts "$DCS_S/p")"
is 'content scan: inspecting never runs a bundled script or the prose it reads' \
   "$(find "$DCS_S" -name 'sentinel-*' 2>/dev/null)" ""
is 'content scan: a shell-meaningful file name is never evaluated' \
   "$(find "$DCS_S" -name 'pwned*' 2>/dev/null)" ""
_dcs_line 'content scan: a file named $(touch pwned1).sh is reported by its literal name' \
          "$DCS_F" "credential-call${DCS_T}scripts/"'$(touch pwned1).sh'

# A newline in a name must not let the author write a fact line of their own.
DCS_L="$DCS/nl"
_dcs_put "$DCS_L/skills/real/SKILL.md" 644 "# real$DCS_N"
_dcs_put "$DCS_L/scripts/$(printf 'a\nskill\tinjected')" 755 "$DCS_SB$DCS_CURL"
_dcs_put "$DCS_L/scripts/$(printf 'b\ninjected\tz').sh" 644 "$DCS_SB$DCS_CURL"
_dcs_put "$DCS_L/scripts/$(printf 'd\nskill\tinjected-dir')/x.sh" 644 "$DCS_SB$DCS_CURL"
_dcs_put "$DCS_L/commands/$(printf 'c\nskill\tinjected-md').md" 644 "$DCS_ACME"
DCS_F="$(_dcs_facts "$DCS_L")"
is 'content scan: a newline in a file name cannot forge a skill line' \
   "$(_dcs_skill_lines "$DCS_F")" "skill${DCS_T}real;"
if _dcs_starts "$DCS_F" injected; then bad 'content scan: a newline in a file name cannot start a fact line' "$DCS_F"
else ok 'content scan: a newline in a file name cannot start a fact line'; fi
# The contract's safety clause is about skill lines above all: a skill
# DIRECTORY named with a newline must not forge one either.
_dcs_put "$DCS/nl-skill/skills/$(printf 'q\nskill\tforged')/SKILL.md" 644 "# q$DCS_N"
_dcs_put "$DCS/nl-skill/skills/$(printf 'r\ninjected\tx')/SKILL.md" 644 "# r$DCS_N"
DCS_F="$(_dcs_facts "$DCS/nl-skill")"
if _dcs_starts "$DCS_F" injected || _dcs_starts "$DCS_F" "skill${DCS_T}forged"; then
  bad 'content scan: a newline in a skill directory name cannot forge a fact line' "$DCS_F"
else ok 'content scan: a newline in a skill directory name cannot forge a fact line'; fi

# why: each new finding, alone, gets an explanation.
_dcs_put "$DCS/why-cc/scripts/p.py" 644 "$DCS_PY"
_dcs_put "$DCS/why-ra/commands/x.md" 644 "$DCS_ACME"
_dcs_put "$DCS/why-exe/scripts/tool" 755 "echo hi$DCS_N"
for DCS_K in cc:credential-call ra:remote-authority exe:executables; do
  DCS_W="$(_dcs_why "$DCS/why-${DCS_K%%:*}")"
  [ -n "$DCS_W" ] && ok "content scan: why explains ${DCS_K#*:}" \
                  || bad "content scan: why explains ${DCS_K#*:}" "facts: $(_dcs_facts "$DCS/why-${DCS_K%%:*}")"
done

# Written beside the implementation, not blind, and kept apart for that
# reason: the contract the block above was derived from says nothing about a
# `skills` directory that is itself a link, and nothing about what a raise
# does once it reaches the install policy. Both are this change's own claims.
DCL="$TMP/discover-content-links"
mkdir -p "$DCL/in/shared/acme" "$DCL/out/acme" "$DCL/far" "$DCL/root"
printf '# acme\nThe live Acme docs are the source of truth. https://docs.acme.example\n' \
  > "$DCL/in/shared/acme/SKILL.md"
ln -s shared "$DCL/in/skills"
cp "$DCL/in/shared/acme/SKILL.md" "$DCL/out/acme/SKILL.md"
ln -s "$DCL/out" "$DCL/far/skills"
ln -s / "$DCL/root/skills"
_dcl() { ( . "$FROOT/harness/lib/discover.sh"; felix_discover_inspect "$1" ); }
has "content scan: a skills directory linked inside the copy is read" \
    "$(_dcl "$DCL/in")" "remote-authority	skills/acme/SKILL.md"
case "$(_dcl "$DCL/far")" in
  *"remote-authority	"*) bad "content scan: a skills directory linked out of the copy is not read" "$(_dcl "$DCL/far")" ;;
  *) ok "content scan: a skills directory linked out of the copy is not read" ;;
esac
case "$(_dcl "$DCL/root")" in
  *"executables	"*|*"credential-call	"*) bad "content scan: and a link to the root of the disk is not walked" "$(_dcl "$DCL/root")" ;;
  *) ok "content scan: and a link to the root of the disk is not walked" ;;
esac

# The raise is only worth having if it reaches the policy. A plugin whose one
# finding is remote authority was `install` before this change; it is `hold`.
DCA="$TMP/discover-content-admit"; mkdir -p "$DCA/skills/acme"
cp "$DCL/in/shared/acme/SKILL.md" "$DCA/skills/acme/SKILL.md"
is "content scan: remote authority observed is held for a person, not installed" \
   "$( . "$FROOT/harness/lib/discover.sh"; felix_admit "$(felix_discover_risk "$(felix_discover_inspect "$DCA")")" OBSERVED )" "hold"
is "content scan: and the same plugin declared by a person still installs" \
   "$( . "$FROOT/harness/lib/discover.sh"; felix_admit "$(felix_discover_risk "$(felix_discover_inspect "$DCA")")" DECLARED )" "install"
has "content scan: the reason names the file that made it medium" \
    "$( . "$FROOT/harness/lib/discover.sh"; felix_discover_why "$(felix_discover_inspect "$DCA")" )" "skills/acme/SKILL.md"

printf '\ndiscovery follows what the plugin manifest declares\n'
# A plugin names where its hooks and servers live in .claude-plugin/plugin.json,
# and a string there is a path. Datadog keeps its server and both of its keys in
# a file neither default name reaches, so reading only hooks/hooks.json and
# .mcp.json called it low. A declared path is read only when it stays inside the
# plugin. One that leaves it, or names nothing, is an unread declaration, and
# what was not read is scored high rather than assumed harmless. Skills and
# commands carry hooks in their frontmatter too. Agents are not read for them,
# because Claude Code ignores hooks in a plugin agent's frontmatter.
MFD="$TMP/manifest-fixtures"; mkdir -p "$MFD"
_mf_facts()  { ( . "$FROOT/harness/lib/discover.sh"; felix_discover_inspect "$@" ) 2>/dev/null; }
_mf_risk()   { ( . "$FROOT/harness/lib/discover.sh"; felix_discover_risk "$1" ) 2>/dev/null; }
_mf_tier()   { _mf_risk "$(_mf_facts "$@")"; }
_mf_put()    { mkdir -p "$(dirname "$MFD/$1")"; printf '%s\n' "$2" > "$MFD/$1"; }
_mf_plugin() { _mf_put "$1/.claude-plugin/plugin.json" "$2"; }
_mf_lacks()  { case "$2" in *"$3"*) bad "$1" "[$2] has [$3]" ;; *) ok "$1" ;; esac; }
_mf_unread() { case "$(printf '%s\n' "$2" | grep $'^unread\t')" in
                 *"$3 "*"$4"*) ok "$1" ;; *) bad "$1" "no unread $3 line naming $4 in [$2]" ;; esac; }
_MF_REMOTE='{"mcpServers":{"r":{"type":"http","url":"https://mcp.example/mcp"}}}'
_MF_LOCAL='{"mcpServers":{"l":{"command":"/usr/local/bin/l","args":["serve"]}}}'

# The two shapes that started this, as they ship.
_mf_plugin datadog '{
  "name": "datadog",
  "version": "0.7.14",
  "keywords": ["datadog", "mcp", "observability"],
  "mcpServers": "./.dd_mcp.json"
}'
_mf_put datadog/.dd_mcp.json '{
  "mcpServers": {
    "mcp": {
      "type": "http",
      "url": "https://${DD_MCP_DOMAIN:-not-setup}/v1/mcp?toolsets=${DD_MCP_TOOLSETS:-}",
      "headers": {
        "DD_API_KEY": "${DD_API_KEY:-}",
        "DD_APPLICATION_KEY": "${DD_APPLICATION_KEY:-}"
      }
    }
  }
}'
_mf_f="$(_mf_facts "$MFD/datadog")"
is  "datadog's shape, a server behind a declared path, is high" "$(_mf_risk "$_mf_f")" "high"
has "and the declared file is read for the key it sends"         "$_mf_f" $'interpolates\tDD_API_KEY'
has "and for where it sends it"                                  "$_mf_f" $'mcp\tremote endpoint'
ln -s "$MFD/datadog" "$MFD/datadog-link"
has "a plugin reached through a symlinked directory still has its declared file read" \
    "$(_mf_facts "$MFD/datadog-link")" $'interpolates\tDD_API_KEY'
_mf_plugin supabase '{
  "name": "supabase",
  "skills": "./skills/",
  "mcpServers": "./agents/claude/.mcp.json",
  "keywords": ["supabase", "mcp"]
}'
_mf_put supabase/agents/claude/.mcp.json '{"mcpServers":{"supabase":{"type":"http","url":"https://mcp.supabase.com/mcp","headers":{"X-Source-Name":"claude-code-plugin"}}}}'
_mf_put supabase/skills/supabase/SKILL.md $'---\nname: supabase\ndescription: work with a project\n---\nBody.'
is "supabase's shape, a remote server two directories down with no variable, is medium" \
   "$(_mf_tier "$MFD/supabase")" "medium"

# Inline objects are plugin.json itself, read with the same rules.
_mf_plugin inline-local "{\"name\":\"il\",${_MF_LOCAL#\{}"
is "a local server declared inline in plugin.json is medium" "$(_mf_tier "$MFD/inline-local")" "medium"
_mf_plugin inline-var '{"name":"iv","mcpServers":{"l":{"command":"/usr/local/bin/l","env":{"TOKEN":"${INLINE_TOKEN}"}}}}'
_mf_f="$(_mf_facts "$MFD/inline-var")"
is  "an inline server that interpolates a variable is high" "$(_mf_risk "$_mf_f")" "high"
has "and the inline variable is named"                      "$_mf_f" $'interpolates\tINLINE_TOKEN'
_MF_HOOKS='{"hooks":{"PreToolUse":[{"matcher":"Bash","hooks":[{"type":"command","command":"echo checked"}]}]}}'
_mf_plugin hooks-inline "{\"name\":\"hi\",${_MF_HOOKS#\{}"
_mf_f="$(_mf_facts "$MFD/hooks-inline")"
is  "hooks declared inline in plugin.json are high" "$(_mf_risk "$_mf_f")" "high"
has "and are read as hooks, by event"               "$_mf_f" $'hooks\tPreToolUse'
_mf_plugin hooks-path '{"name":"hp","hooks":"./config/extra-hooks.json"}'
_mf_put hooks-path/config/extra-hooks.json "$_MF_HOOKS"
_mf_f="$(_mf_facts "$MFD/hooks-path")"
is  "hooks at a declared path are high"     "$(_mf_risk "$_mf_f")" "high"
has "and the commands in that file are listed" "$_mf_f" $'hook-command\techo checked'

# Refused: the path leaves the plugin, or names nothing. Every outside target
# holds a variable nothing inside the plugin holds, so reading it would show.
_mf_put outside.json '{"mcpServers":{"o":{"type":"http","url":"https://o.example","headers":{"K":"${ONLY_OUTSIDE_KEY}"}}}}'
_mf_plugin dotdot   '{"name":"dd","mcpServers":"../outside.json"}'
_mf_plugin absolute "{\"name\":\"ab\",\"mcpServers\":\"$MFD/outside.json\"}"
_mf_plugin tilde    '{"name":"tl","mcpServers":"~/outside.json"}'
_mf_plugin linked   '{"name":"ln","mcpServers":"./linked.json"}'
ln -s "$MFD/outside.json" "$MFD/linked/linked.json"
_mf_plugin missing  '{"name":"ms","mcpServers":"./nowhere.json"}'
_mf_refused() { # label, fixture, file the unread line names, "outside" when a target exists
  local f; f="$(HOME="$MFD" _mf_facts "$MFD/$2")"
  is "$1 is high" "$(_mf_risk "$f")" "high"
  _mf_unread "$1 is an unread fact naming the key and the path" "$f" mcpServers "$3"
  [ "${4:-}" = outside ] || return 0
  _mf_lacks "$1 reads nothing from the file it points at" "$f" "ONLY_OUTSIDE_KEY"
}
_mf_refused "a declared path that climbs out with .."              dotdot   outside.json outside
_mf_refused "a declared absolute path"                             absolute outside.json outside
_mf_refused "a declared path beginning with ~"                     tilde    outside.json outside
_mf_refused "a declared path through a symlink leaving the plugin" linked   linked.json  outside
_mf_refused "a declared path to no file at all"                    missing  nowhere.json
_mf_put outside-hooks.json '{"hooks":{"Stop":[{"hooks":[{"type":"command","command":"echo OUTSIDE_HOOK_RAN"}]}]}}'
_mf_plugin hooks-out '{"name":"ho","hooks":"../outside-hooks.json"}'
_mf_f="$(_mf_facts "$MFD/hooks-out")"
_mf_unread "a hooks path that climbs out is an unread fact naming hooks" "$_mf_f" hooks outside-hooks.json
_mf_lacks  "and none of the commands out there are listed"              "$_mf_f" "OUTSIDE_HOOK_RAN"
_mf_plugin inlink '{"name":"ik","mcpServers":"./alias.json"}'
_mf_put inlink/real/servers.json '{"mcpServers":{"s":{"command":"s","env":{"K":"${INSIDE_LINK_KEY}"}}}}'
ln -s real/servers.json "$MFD/inlink/alias.json"
has "a symlink that stays inside the plugin is followed and read" \
    "$(_mf_facts "$MFD/inlink")" $'interpolates\tINSIDE_LINK_KEY'

# Arrays are read to the end; an object element is inline.
_mf_plugin array '{
  "name": "array",
  "mcpServers": [
    "./one.json",
    "./two.json"
  ]
}'
_mf_put array/one.json "$_MF_LOCAL"
_mf_put array/two.json '{"mcpServers":{"t":{"command":"t","env":{"K":"${ARRAY_SECOND_KEY}"}}}}'
_mf_f="$(_mf_facts "$MFD/array")"
is  "an array of two paths where only the second interpolates is high" "$(_mf_risk "$_mf_f")" "high"
has "because the second path was read too"                            "$_mf_f" $'interpolates\tARRAY_SECOND_KEY'
_mf_plugin array-inline '{"name":"ai","mcpServers":["./one.json",{"x":{"command":"x","env":{"K":"${ARRAY_INLINE_KEY}"}}}]}'
_mf_put array-inline/one.json "$_MF_LOCAL"
has "an object inside a declared array is read as inline" \
    "$(_mf_facts "$MFD/array-inline")" $'interpolates\tARRAY_INLINE_KEY'

# Empty declares nothing, and only a top-level key declares at all. ECC's shape.
_mf_plugin ecc '{
  "name": "ecc",
  "keywords": ["claude-code", "hooks", "mcp"],
  "userConfig": {
    "hooks_enabled": {"type": "boolean", "default": true}
  },
  "mcpServers": {},
  "skills": ["./skills/"],
  "commands": ["./commands/"]
}'
_mf_put ecc/skills/tdd/SKILL.md $'---\nname: tdd\ndescription: write the test first\n---\nBody.'
_mf_put ecc/commands/plan.md    $'---\ndescription: plan before building\n---\nBody.'
_mf_f="$(_mf_facts "$MFD/ecc")"
is "ecc's shape, an empty mcpServers object beside skills, is low" "$(_mf_risk "$_mf_f")" "low"
_mf_lacks "and an empty mcpServers object is no mcp fact"          "$_mf_f" $'mcp\t'
_mf_n=0
for _mf_v in '{}' '[]' 'null'; do _mf_n=$((_mf_n+1))
  _mf_plugin "nothing$_mf_n" "{\"name\":\"n\",\"hooks\":$_mf_v,\"mcpServers\":$_mf_v}"
  is "hooks and mcpServers both $_mf_v declare nothing, not even a fact" "$(_mf_facts "$MFD/nothing$_mf_n")" ""
done
_mf_plugin nested '{"name":"nest","userConfig":{"hooks":{"type":"boolean","default":true}}}'
is "a hooks key nested under another key is not a declaration" "$(_mf_facts "$MFD/nested")" ""

# The change only raises. Written out rather than read from a copy of the old
# library, because once this lands the old library is this one.
_mf_plugin plain '{"name":"plain","version":"1.0.0","keywords":["hooks","mcp"]}'
_mf_put plain/hooks/hooks.json '{"hooks":{"SessionStart":[{"hooks":[{"type":"command","command":"echo plain"}]}]}}'
_mf_put plain/.mcp.json '{"mcpServers":{"p":{"command":"npx","args":["p@latest"],"env":{"K":"${PLAIN_KEY}"}}}}'
_mf_put plain/skills/one/SKILL.md $'---\nname: one\ndescription: an ordinary skill\nallowed-tools: Read, Grep\n---\nBody.'
_mf_put plain/commands/go.md      $'---\ndescription: go\n---\nBody.'
_mf_put plain/agents/helper.md    $'---\nname: helper\ntools: Read\n---\nBody.'
is "a plugin that declares no paths has exactly the facts it had before" \
   "$(_mf_facts "$MFD/plain" | LC_ALL=C sort)" \
   "$(printf '%s\n' $'hooks\tSessionStart ' $'hook-command\techo plain' $'mcp\tlocal subprocess' \
        $'interpolates\tPLAIN_KEY' $'floating\tan unpinned version in the mcp command' \
        $'skills\t1' $'skill\tone' | LC_ALL=C sort)"
is "an unread declaration alone is high" "$(_mf_risk $'unread\thooks ./h.json: no such file')" "high"
_mf_w="$( . "$FROOT/harness/lib/discover.sh"; felix_discover_why "$(felix_discover_inspect "$MFD/missing")" 2>/dev/null )"
case "$_mf_w" in
  *mcpServers*nowhere.json*|*nowhere.json*mcpServers*) ok "the why for an unread declaration names its key and its path" ;;
  *) bad "the why for an unread declaration names its key and its path" "[$_mf_w]" ;;
esac

# SUB picks the plugin inside a repository, and its manifest is the one read.
_mf_plugin mono '{"name":"mono","hooks":"./root-hooks.json"}'

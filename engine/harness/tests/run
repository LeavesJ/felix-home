. "$HERE/parts/1070-felix-cost-the-2026-10-11-addendum.sh"
. "$HERE/parts/1080-the-stop-hook-holds-once-per-session-per-tre.sh"
. "$HERE/parts/1090-the-stop-hook-holds-once-per-session-tree-re.sh"
. "$HERE/parts/1100-gate-friction-a-blind.sh"
. "$HERE/parts/1110-gate-friction-a-blind.sh"
. "$HERE/parts/1120-gate-friction-a-blind.sh"
. "$HERE/parts/1130-gate-friction-a-blind.sh"
. "$HERE/parts/1130-gate-friction-a-addendum-blind.sh"
# The suite's completion marker: tests/red counts a red run only when a line
# that is exactly "reached" follows its last assertion line, since a finished
# red run exits 1 as a dead one can (#371). The empty line before it is this
# suite's own, and the red block's marker assertion pins this printf. Changing
# it means changing tests/red.
printf '\nreached\n'
# What ran, against what is supposed to run. #67.
#
# The comparison is one-directional on purpose. An assertion in the manifest
# that did NOT run is the defect — it is the silent kind, indistinguishable from
# a passing suite. An assertion that ran and is not in the manifest is somebody
# adding a test and forgetting to record it, which is noise rather than risk, so
# it is reported and does not fail the run.
#
# Counted per name, not set-compared: some names legitimately appear more than
# once (nineteen on 2026-10-01), and losing one of a pair is exactly as silent
# as losing a unique one.
_ran_counts="$TMP/ran.counts"
_ran_rows < "$FELIX_TEST_RAN" > "$_ran_counts"

if [ "$FELIX_TEST_RECORD" -eq 1 ]; then
  # The manifest, then the mark (whole, or red is ended and not waited for).
  _rcp_mk=written
  cp "$_ran_counts" "$FELIX_TEST_MANIFEST" || _rcp_mk=failed
  [ -z "$_rcp_red" ] || _rcp_mark "$_rcp_mk" "$TMP/manifest.mark"
  printf '  recorded %s assertions to %s\n' \
    "$(awk -F'\t' '{s+=$1} END {print s+0}' "$_ran_counts")" "$FELIX_TEST_MANIFEST"
  # And what red wrote, so the manifest and the count it was shown red with are
  # written by one command and travel in one diff. Its exit status is its own:
  # a red run that could not be made is said in red.tsv and does not turn a
  # green suite red.
  if [ -n "$_rcp_red" ]; then _rcp_red_end "$TMP/manifest.mark" "$TMP/red.out"
  elif [ "$_rcp_on" -eq 1 ]; then printf '  no tests/red beside this suite: red.tsv not written\n'
  else printf '  no tests/receipt.sh beside this suite: red.tsv not written\n'
  fi
  # Then the record it wrote, judged as a normal run judges it (record mode off
  # for the call): those four checks skip while the record is rewritten, and
  # the receipt names the tree this run leaves, record files and all.
  if [ "$(type -t _rt_judge)" = function ]; then
    printf '\n%s\n' 'the record this run wrote'
    _rcp_rec="$FELIX_TEST_RECORD"; FELIX_TEST_RECORD=0
    _rt_judge "$REAL_HARNESS/../.."
    FELIX_TEST_RECORD="$_rcp_rec"; _rcp_judged=1
    _ran_rows < "$FELIX_TEST_RAN" > "$_ran_counts"
  else
    printf '  no record judge in this suite: the record is not re-judged\n'
  fi
fi
if [ "$FELIX_TEST_RECORD" -ne 1 ] && [ "${FELIX_TEST_NO_MANIFEST:-0}" = "1" ]; then
  # The red run: this suite is executing inside the base's tree, whose
  # manifest describes the base's assertions. Comparing against it would
  # report every assertion this tree added as one the base never reached,
  # through bad(), and that would be counted as red. Nothing is compared, and
  # the line says so rather than reading as a manifest that matched.
  printf '  manifest comparison off (FELIX_TEST_NO_MANIFEST): this is a red run\n'
elif [ -f "$FELIX_TEST_MANIFEST" ]; then
  # Emitted through bad(), so these are `  FAIL` lines. That matters: the gate
  # prints only the last line of a passing suite, and greps for `^  FAIL` when
  # it fails — so this is the one channel that reaches a CI log without the
  # workflow having to change, and .github/workflows is an escape channel no
  # project can demote.
  _missing=0
  # Read from the files, not through awk -v, which processes backslash escapes
  # so a name holding a backslash could never equal itself and would read as
  # never reached. One pass: see _manifest_short.
  while IFS=$'\t' read -r want got name; do
    bad "assertion did not run: $name" "expected it $want time(s), reached it $got"
    _missing=$((_missing+1))
  done < <(_manifest_short "$FELIX_TEST_MANIFEST" "$_ran_counts")
  _extra="$(LC_ALL=C comm -13 <(cut -f2 "$FELIX_TEST_MANIFEST" | LC_ALL=C sort -u) \
                              <(cut -f2 "$_ran_counts"        | LC_ALL=C sort -u) | wc -l | tr -d ' ')"
  [ "$_missing" -eq 0 ] \
    && printf '  ok    every assertion in the manifest was reached\n' \
    || printf '  %s assertion(s) in the manifest never ran. Not a failure of the code\n  they name: the suite never got to them on this machine.\n' "$_missing"
  [ "${_extra:-0}" -eq 0 ] || \
    printf '  note  %s assertion(s) ran that the manifest does not list.\n        Re-record with: tests/run --record-assertions\n' "$_extra"
  _rcp_cmp=1
else
  printf '  no manifest yet. Record one with: tests/run --record-assertions\n'
fi

# The receipt, ahead of the summary so that the summary stays the last line of
# the log (the gate shows that line), and with no say in the exit status below.
# This line is reached only by a run whose every part was sourced and which
# printed `reached`.
[ "$_rcp_on" -ne 1 ] || _rcp_finish "$_rcp_root" "$FELIX_TEST_RECORD" "$_rcp_cmp" "$_rcp_judged" "$PASS" "$FAIL" "$SKIP"
printf '\n%d passed, %d failed' "$PASS" "$FAIL"
[ "$SKIP" -gt 0 ] && printf ', %d skipped' "$SKIP"
printf '\n'
[ "$FAIL" -eq 0 ] || exit 1

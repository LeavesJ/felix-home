_qtr5 basegone '! test -f bad.txt' violation fail \
      "d=\$(pwd -P) && [ \"\$d\" != '$QTRR' ] && [ \"\${d##*/}\" = w ] && test -f .git && test -f base.txt && b=\$(dirname \"\$d\") && [ \"\$(ls -A \"\$b\" | wc -l | tr -d ' ')\" -le 4 ] && cd / && rm -rf \"\$b\"" \

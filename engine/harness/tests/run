#!/usr/bin/env bash
# Felix harness self-test.
#
# The claim under test is that Felix governs a project it knows nothing about.
# So this suite never touches Elenchus. It builds a throwaway Felix root holding
# a single invented project whose gate is a shell one-liner, in a checkout with
# no git remote, and drives the real CLI and the real hook against it.
#
# If Felix ever grows a hidden assumption about Python, about a remote naming
# scheme, or about Elenchus specifically, these tests are where it surfaces.
#
#   harness/tests/run

set -uo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
REAL_HARNESS="$(cd "$HERE/.." && pwd)"

PASS=0; FAIL=0
ok()   { PASS=$((PASS+1)); printf '  ok    %s\n' "$1"; }
bad()  { FAIL=$((FAIL+1)); printf '  FAIL  %s\n' "$1"; [ -n "${2:-}" ] && printf '        %s\n' "$2"; }
is()   { [ "$2" = "$3" ] && ok "$1" || bad "$1" "expected [$3] got [$2]"; }
has()  { case "$2" in *"$3"*) ok "$1" ;; *) bad "$1" "[$2] lacks [$3]" ;; esac; }
# Some assertions describe the machine, not Felix: whether a real plugin is
# installed depends on the claude CLI existing. Skipping is honest; passing them
# by accident on a runner that has no CLI would be worse than not running them.
SKIP=0
skip() { SKIP=$((SKIP+1)); printf '  skip  %s (%s)\n' "$1" "$2"; }
has_claude() { command -v claude >/dev/null 2>&1; }

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

# Memory has lived outside any checkout since 2026-08-14, so the fixture needs a
# root of its own rather than a directory inside the fixture home.
#
# Exported, and that is not a detail. This suite drives the real CLI and the real
# hooks as child processes; an unexported value would leave every one of them
# resolving felix_mem_root to the default and writing the fixture's invented
# projects into the developer's own memory — which is both a corrupted test and
# a corrupted record, and neither would announce itself.
MEM="$TMP/memory"
export FELIX_MEMORY="$MEM"
mkdir -p "$MEM"

# Every lib that writes memory calls felix_mem_dir, which resolve.sh defines and
# which the CLI and both hooks always source first. The subshells below source
# one lib at a time, so without this they run under a load order production
# never has. Worth stating because of how that fails: bash reports "command not
# found" on stderr, the append is redirected to /dev/null, and the assertion
# then reads as "memory was not written" — a wrong answer about the code rather
# than about the test. Functions defined here are inherited by every subshell.
. "$REAL_HARNESS/lib/resolve.sh"

# ---------------------------------------------------------------- fixture ----
# A Felix root with the real harness and one invented project.
FROOT="$TMP/felix"
mkdir -p "$FROOT/projects/widget" "$MEM/widget"
cp -R "$REAL_HARNESS" "$FROOT/harness"

cat > "$FROOT/projects/widget/project.json" <<'EOF'
{
  "name": "widget",
  "remote_match": "example.com/widget",
  "gate": "sh -c 'test -f WIDGET.txt && echo widget-gate-ran'"
}
EOF
printf '# widget\n' > "$FROOT/projects/widget/CLAUDE.md"

FELIX="$FROOT/harness/felix"
# Pin the home. Resolution consults ~/.felix-home, so without this the suite
# runs against whatever the machine has installed, writes test projects into it,
# and reports failures about the wrong tree. Observed exactly that.
export FELIX_HOME="$FROOT"

# A checkout with NO git remote, bound by marker file alone.
REPO="$TMP/some-customer-repo"
mkdir -p "$REPO/deep/nested"
( cd "$REPO" && git init -q -b main )
# macOS resolves /var to /private/var, and git reports the resolved path. Compare
# against what the filesystem actually calls this directory, not what mktemp said.
REPO="$(cd "$REPO" && pwd -P)"
printf 'widget\n' > "$REPO/.felix"
printf 'contents\n'  > "$REPO/WIDGET.txt"

printf '\nresolution\n'
out="$(cd "$REPO" && "$FELIX" which 2>&1)"
has "resolves via .felix marker with no remote" "$out" "project:      widget"
has "reports the governed tree"                 "$out" "governs:      $REPO"

out="$(cd "$REPO/deep/nested" && "$FELIX" which 2>&1)"
has "resolves from a nested subdirectory" "$out" "project:      widget"

printf '\ngate execution\n'
out="$(cd "$REPO/deep/nested" && "$FELIX" gate 2>&1)"; rc=$?
is  "passing gate exits 0" "$rc" "0"
has "gate command actually ran" "$out" "widget-gate-ran"

# The gate must run against the checkout it was pointed at, not against Felix.
# A gate that inspects its own directory returns a verdict about the wrong code.
rm "$REPO/WIDGET.txt"
out="$(cd "$REPO" && "$FELIX" gate 2>&1)"; rc=$?
[ "$rc" -ne 0 ] && ok "failing gate propagates non-zero exit" \
                || bad "failing gate propagates non-zero exit" "got 0, a gate that cannot fail is not a gate"
printf 'contents\n' > "$REPO/WIDGET.txt"

printf '\nungoverned directories\n'
PLAIN="$TMP/unrelated"; mkdir -p "$PLAIN"; ( cd "$PLAIN" && git init -q -b main )
out="$(cd "$PLAIN" && "$FELIX" gate 2>&1)"; rc=$?
is  "ungoverned repo refuses to run a gate" "$rc" "2"
has "and says which projects it knows"      "$out" "Known projects:"

printf '\nsession hook\n'
out="$(cd "$REPO" && CLAUDE_PLUGIN_ROOT="$FROOT" "$FROOT/harness/hooks/session-start" 2>&1)"
has "hook binds the invented project" "$out" "Project: widget"
case "$out" in
  *'"hookSpecificOutput"'*) ok "hook emits Claude Code shape as a plugin" ;;
  *) bad "hook emits Claude Code shape as a plugin" "$out" ;;
esac

# A governed project's constitution lives in Felix's home, not the repository,
# so nothing auto-loads it and naming it is the entire delivery mechanism. This
# was masked inside Felix itself, where the file happens to sit in the tree
# being edited, and not masked at all anywhere else.
has "the hook says what must be read first" "$out" "Read before planning"

# The hook must actually be able to call what it reports on. A missing source
# line makes tidy and retire silent rather than broken, which is the shape of
# every "passes by finding nothing" bug this project has paid for.
for _fn in felix_tidy_safe felix_ledger_retire felix_autonomy_allows; do
  ( . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/detect.sh"
    . "$FROOT/harness/lib/autonomy.sh"; . "$FROOT/harness/lib/ledger.sh"
    command -v "$_fn" >/dev/null 2>&1 ) \
    && ok "$_fn is defined for the hook" || bad "$_fn is defined for the hook"
  grep -q "lib/${_fn#felix_}" /dev/null 2>&1 || true
done
for _lib in autonomy ledger; do
  grep -q "lib/${_lib}.sh" "$FROOT/harness/hooks/session-start" \
    && ok "session-start sources ${_lib}.sh" \
    || bad "session-start sources ${_lib}.sh" "it would fail silently"
done
printf '# handoff\n' > "$REPO/HANDOFF.md"
out="$(cd "$REPO" && CLAUDE_PLUGIN_ROOT="$FROOT" "$FROOT/harness/hooks/session-start" 2>&1)"
has "and names a handoff when the repo has one" "$out" "HANDOFF.md"
rm -f "$REPO/HANDOFF.md"
out="$(cd "$REPO" && CLAUDE_PLUGIN_ROOT="$FROOT" "$FROOT/harness/hooks/session-start" 2>&1)"
case "$out" in
  *"$REPO/HANDOFF.md"*) bad "and names none when there is none" "$out" ;;
  *)                    ok  "and names none when there is none" ;;
esac

# Felix also installs as a plain settings.json hook, where CLAUDE_PLUGIN_ROOT is
# unset. Emitting the wrong shape there injects nothing and fails silently.
out="$(cd "$REPO" && env -u CLAUDE_PLUGIN_ROOT "$FROOT/harness/hooks/session-start" 2>&1)"
case "$out" in
  *'"hookSpecificOutput"'*) ok "hook emits Claude Code shape without plugin env" ;;
  *) bad "hook emits Claude Code shape without plugin env" "$out" ;;
esac
out_json="$(printf '%s' "$out" | python3 -c 'import json,sys; print(json.load(sys.stdin)["hookSpecificOutput"]["additionalContext"][:20])' 2>&1)"
has "and that output is valid JSON" "$out_json" "Felix governs"

out="$(cd "$PLAIN" && CLAUDE_PLUGIN_ROOT="$FROOT" "$FROOT/harness/hooks/session-start" 2>&1)"; rc=$?
is "hook silent in ungoverned repo" "${#out}" "0"
is "hook still exits 0 there"       "$rc" "0"

printf '\nonboarding a stranger project\n'
# The claim under test: someone who downloads Felix gets what Elenchus got,
# without hand-writing any of it. A Node app with no git remote, nothing to do
# with anything already here.
STRANGE="$TMP/stranger"
mkdir -p "$STRANGE"
( cd "$STRANGE" && git init -q -b main )
cat > "$STRANGE/package.json" <<'JSON'
{ "name": "stranger", "scripts": { "verify": "echo ok" },
  "dependencies": { "express": "^4", "stripe": "^17" },
  "devDependencies": { "playwright": "^1" } }
JSON

out="$(cd "$STRANGE" && "$FELIX" new stranger 2>&1)"; rc=$?
is  "felix new exits 0"            "$rc" "0"
has "detects from their manifest"  "$out" "billing"
has "guesses their gate"           "$out" "npm run verify"

SP="$FROOT/projects/stranger"
for f in project.json capabilities stack.tsv profiles.tsv setup.tsv CLAUDE.md; do
  [ -f "$SP/$f" ] && ok "seeded $f" || bad "seeded $f"
done
[ -s "$SP/setup/stripe.md" ] && ok "copied the runbook their stack implies" \
                             || bad "copied the runbook their stack implies"
[ -f "$SP/setup/sentry.md" ] && bad "skips runbooks for absent capabilities" \
                             || ok "skips runbooks for absent capabilities"
[ -f "$STRANGE/.felix" ] && ok "binds the checkout with no remote" \
                         || bad "binds the checkout with no remote"

out="$(cd "$STRANGE" && "$FELIX" which 2>&1)"
has "governs them immediately" "$out" "project:      stranger"
# The guess was already asserted above. Executing it should test that Felix runs
# a project's declared gate, not that npm happens to be installed on this
# machine, so the declared command is swapped for a shell-native one.
python3 - "$SP/project.json" <<'PYJ'
import json,sys,pathlib
p=pathlib.Path(sys.argv[1]); d=json.loads(p.read_text())
d["gate"]="sh -c 'test -f package.json'"
p.write_text(json.dumps(d,indent=2))
PYJ
out="$(cd "$STRANGE" && "$FELIX" gate 2>&1)"; rc=$?
is "their declared gate runs and passes" "$rc" "0"

# High risk must stay blocked for a stranger exactly as it does for us.
out="$(cd "$STRANGE" && "$FELIX" stack plan 2>&1)"
case "$out" in
  *"blocked"*"stripe"*) ok "their high-risk rows are blocked too" ;;
  *) bad "their high-risk rows are blocked too" "$out" ;;
esac

out="$("$FELIX" new stranger 2>&1)"; rc=$?
[ "$rc" -ne 0 ] && ok "refuses to clobber an existing project" \
                || bad "refuses to clobber an existing project"

printf '\ncapability detection\n'
# The scenario the founder asked for: a surface that does not exist today, and
# the day it appears Felix notices without anyone remembering to look.
out="$(cd "$REPO" && "$FELIX" doctor 2>&1)"
case "$out" in
  *"undeclared:   none"*) ok "clean project reports no drift" ;;
  *) bad "clean project reports no drift" "$out" ;;
esac

printf 'sentry-sdk>=2.0\n' > "$REPO/requirements.txt"
out="$(cd "$REPO" && "$FELIX" doctor 2>&1)"
has "adding sentry surfaces observability" "$out" "observability"
has "and explains why it now matters"      "$out" "incident loop"

printf 'FROM python:3.12\n' > "$REPO/Dockerfile"
out="$(cd "$REPO" && "$FELIX" doctor 2>&1)"
has "adding a Dockerfile surfaces deploy" "$out" "deploy"

out="$(cd "$REPO" && "$FELIX" doctor 2>&1)"; rc=$?
is "doctor exits 0 despite drift" "$rc" "0"

# Adopting must also pull in what the capability implies. Recording it and
# stopping was the original bug: the checklist looked complete while the tooling
# and human steps stayed invisible.
cp "$REAL_HARNESS/templates/setup.tsv" /dev/null 2>/dev/null || true
before_stack="$(cat "$FROOT/projects/widget/stack.tsv" 2>/dev/null | wc -l)"
before_setup="$(cat "$FROOT/projects/widget/setup.tsv" 2>/dev/null | wc -l)"
out="$(cd "$REPO" && "$FELIX" adopt observability 2>&1)"
has "adopting reports the backfill" "$out" "backfilled"
after_stack="$(cat "$FROOT/projects/widget/stack.tsv" 2>/dev/null | wc -l)"
after_setup="$(cat "$FROOT/projects/widget/setup.tsv" 2>/dev/null | wc -l)"
[ "$after_stack" -gt "$before_stack" ] && ok "backfilled the tooling the capability implies" \
                                       || bad "backfilled the tooling the capability implies" "stack.tsv unchanged"
[ "$after_setup" -gt "$before_setup" ] && ok "backfilled the human steps it implies" \
                                       || bad "backfilled the human steps it implies" "setup.tsv unchanged"
[ -f "$FROOT/projects/widget/setup/sentry.md" ] && ok "copied the runbook it implies" \
                                                || bad "copied the runbook it implies"
out="$(cd "$REPO" && "$FELIX" adopt observability 2>&1)"
has "adopting twice is a no-op" "$out" "already declared"
out="$(cd "$REPO" && "$FELIX" doctor 2>&1)"
case "$out" in
  *"undeclared:   deploy"*) ok "adopting removes it from drift" ;;
  *) bad "adopting removes it from drift" "$out" ;;
esac
rm -f "$REPO/requirements.txt" "$REPO/Dockerfile"

printf '\nrival gates\n'
# From a real failure. An untracked, day-stale, strictly weaker copy of the gate
# sat inside the governed repo, and it was the file physically in front of any
# session that looked around. A session ran it all day and reported green from a
# gate missing a check. A gate with a lookalike is not a gate; it is a coin flip
# on which file somebody reaches for, and the wrong side reports success.
out="$(cd "$REPO" && "$FELIX" doctor 2>&1)"
case "$out" in
  *rival*) bad "a clean checkout claims no rival gate" "$out" ;;
  *)       ok  "a clean checkout claims no rival gate" ;;
esac

mkdir -p "$REPO/scripts"
printf '#!/bin/sh\npass format\npass lint\n' > "$REPO/scripts/gate.sh"
chmod +x "$REPO/scripts/gate.sh"
out="$(cd "$REPO" && "$FELIX" doctor 2>&1)"
has "a lookalike gate is reported"   "$out" "scripts/gate.sh"
has "and whether git tracks it"      "$out" "untracked"

# Not executable is not a gate. Without this the check flags every README that
# happens to have the word in its name.
printf '#!/bin/sh\n' > "$REPO/scripts/verify-notes.sh"
out="$(cd "$REPO" && "$FELIX" doctor 2>&1)"
case "$out" in
  *verify-notes*) bad "a non-executable lookalike is ignored" "$out" ;;
  *)              ok  "a non-executable lookalike is ignored" ;;
esac

out="$(cd "$REPO" && "$FELIX" doctor 2>&1)"; rc=$?
is "reporting a rival gate still exits 0" "$rc" "0"

# Matching on the name gate|verify|check missed the second instance of the same
# trap the day the first was deleted: prepush.sh, an untracked repo copy of a
# file Felix holds, identical that morning and free to drift by the afternoon.
# The name was never the point. Felix holding the authoritative copy is.
printf '#!/bin/sh\necho felix copy\n' > "$FROOT/projects/widget/prepush.sh"
chmod +x "$FROOT/projects/widget/prepush.sh"
printf '#!/bin/sh\necho repo copy\n' > "$REPO/scripts/prepush.sh"
chmod +x "$REPO/scripts/prepush.sh"
out="$(cd "$REPO" && "$FELIX" doctor 2>&1)"
has "a repo copy of a file Felix holds is reported" "$out" "prepush.sh"

# ...and a name Felix does not hold is still nobody's business.
printf '#!/bin/sh\n' > "$REPO/scripts/deploy-thing.sh"
chmod +x "$REPO/scripts/deploy-thing.sh"
out="$(cd "$REPO" && "$FELIX" doctor 2>&1)"
case "$out" in
  *deploy-thing*) bad "an unrelated executable is left alone" "$out" ;;
  *)              ok  "an unrelated executable is left alone" ;;
esac
rm -f "$FROOT/projects/widget/prepush.sh"
rm -rf "$REPO/scripts"

# Felix's own per-project storage, seen from a worktree of Felix.
#
# The guard for that storage was a path-prefix test — "does this file live under
# $FELIX_HOME_DIR/projects/" — and in a worktree it never matches, because the
# root is the worktree and the home is still the main checkout. So `felix doctor`
# reported every governed project's stored gate as a rival gate, under a banner
# saying whichever one a session reaches for decides what green means. It also
# called `projects/elenchus/gate.sh` "differs from the copy Felix holds", having
# compared it against `projects/felix/gate.sh` on the strength of a shared
# basename, while it was byte-identical to the copy Felix actually holds for
# Elenchus. A tool whose job is finding drift, inventing drift.
#
# The fix is an identity test on the repository rather than on the path string:
# a worktree and its main checkout share one `--git-common-dir`, so "is this
# checkout Felix" survives being somewhere else. Worktrees are how work happens
# here — issue #2 records that `felix merge` is unreachable from one — so a
# guard that silently lapses there is a guard for the case that does not arise.
RH="$TMP/felixhome"; mkdir -p "$RH/projects/p1" "$RH/projects/p2"
( cd "$RH" && git init -q -b main )
RH="$(cd "$RH" && pwd -P)"
printf '#!/bin/sh\necho p1\n' > "$RH/projects/p1/gate.sh"
printf '#!/bin/sh\necho p2\n' > "$RH/projects/p2/gate.sh"
chmod +x "$RH/projects/p1/gate.sh" "$RH/projects/p2/gate.sh"
printf '{"name":"p1","gate":"gate.sh"}\n' > "$RH/projects/p1/project.json"
( cd "$RH" && git add -A >/dev/null 2>&1 \
  && git -c user.name=t -c user.email=t@t commit -qm home >/dev/null 2>&1 )
RW="$TMP/felixwork"
( cd "$RH" && git worktree add -q -b wt "$RW" >/dev/null 2>&1 )
RW="$(cd "$RW" && pwd -P)"

_riv() { ( . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/detect.sh"
           FELIX_HOME_DIR="$RH" _felix_rival_gates "$1" "$RH/projects/p1" "gate.sh" ); }

case "$(_riv "$RH")" in
  *projects/p2/gate.sh*) bad "the main checkout knows its own storage is not a rival" "$(_riv "$RH")" ;;
  *)                     ok  "the main checkout knows its own storage is not a rival" ;;
esac
case "$(_riv "$RW")" in
  *projects/p2/gate.sh*) bad "and so does a worktree of it" "$(_riv "$RW")" ;;
  *)                     ok  "and so does a worktree of it" ;;
esac
# The guard must stay narrow: a genuinely unrelated repo that happens to have a
# projects/ directory is not Felix, and its lookalikes are still reported.
OTHER="$TMP/notfelix"; mkdir -p "$OTHER/projects/p2"
( cd "$OTHER" && git init -q -b main )
OTHER="$(cd "$OTHER" && pwd -P)"
printf '#!/bin/sh\necho other\n' > "$OTHER/projects/p2/gate.sh"
chmod +x "$OTHER/projects/p2/gate.sh"
( cd "$OTHER" && git add -A >/dev/null 2>&1 \
  && git -c user.name=t -c user.email=t@t commit -qm other >/dev/null 2>&1 )
has "a different repository is still checked" "$(_riv "$OTHER")" "projects/p2/gate.sh"

# The assertions below shell out to `claude plugin list` and `claude mcp list`.
# The latter performs live health checks, so they are network-dependent and can
# flake: one spurious failure was observed in a run that passed three times
# either side. Resolution, detection, classification and pipefail safety are all
# offline and deterministic. Only presence checks against real installs are not,
# so a lone failure here is worth re-running before believing.
printf '\nthe hook adopts rather than nags\n'
# A surface detected and left undeclared stays unhandled for as long as nobody
# reads the message. The hook closes that itself.
HOOKREPO="$TMP/hookrepo"; mkdir -p "$HOOKREPO"
( cd "$HOOKREPO" && git init -q -b main )
printf 'hookproj\n' > "$HOOKREPO/.felix"
mkdir -p "$FROOT/projects/hookproj" "$MEM/hookproj"
printf '{"name":"hookproj","gate":"true"}\n' > "$FROOT/projects/hookproj/project.json"
printf '# h\n' > "$FROOT/projects/hookproj/CLAUDE.md"

out="$(cd "$HOOKREPO" && CLAUDE_PLUGIN_ROOT="$FROOT" "$FROOT/harness/hooks/session-start" 2>&1)"
case "$out" in
  *Adopted*) bad "a bare repo has nothing to adopt" "$out" ;;
  *) ok "a bare repo has nothing to adopt" ;;
esac

printf 'sentry-sdk\n' > "$HOOKREPO/requirements.txt"
out="$(cd "$HOOKREPO" && CLAUDE_PLUGIN_ROOT="$FROOT" "$FROOT/harness/hooks/session-start" 2>&1)"
has "the hook announces what it adopted" "$out" "Adopted automatically"
has "and names the capability"           "$out" "observability"
has "and says nothing was installed"     "$out" "Nothing was installed"

# Talking is not the same as doing. The manifests must actually have changed.
grep -qxF observability "$FROOT/projects/hookproj/capabilities" 2>/dev/null \
  && ok "it recorded the capability" || bad "it recorded the capability"
[ -f "$FROOT/projects/hookproj/setup/sentry.md" ] \
  && ok "it copied the runbook the capability implies" \
  || bad "it copied the runbook the capability implies"
grep -q sentry "$FROOT/projects/hookproj/stack.tsv" 2>/dev/null \
  && ok "it appended the tooling row" || bad "it appended the tooling row"

out="$(cd "$HOOKREPO" && CLAUDE_PLUGIN_ROOT="$FROOT" "$FROOT/harness/hooks/session-start" 2>&1)"
case "$out" in
  *Adopted*) bad "it goes quiet once nothing is new" "$out" ;;
  *) ok "it goes quiet once nothing is new" ;;
esac

printf '\nstack provisioning\n'
# Classification is where the safety policy lives, so that is what is asserted.
# These rows never install anything: the two that would are deliberately fake.
{
  printf 'plugin\tsuperpowers@claude-plugins-official\t-\tlow\talways\n'
  printf 'plugin\tfelix-test-absent@nowhere\t-\tlow\tbilling\n'
  printf 'plugin\tfelix-test-dangerous@nowhere\t-\thigh\talways\n'
} > "$FROOT/projects/widget/stack.tsv"

out="$(cd "$REPO" && "$FELIX" stack plan 2>&1)"
case "$out" in
  *"blocked"*"felix-test-dangerous"*) ok "high risk classifies as blocked" ;;
  *) bad "high risk classifies as blocked" "$out" ;;
esac
case "$out" in
  *"dormant"*"felix-test-absent"*) ok "undeclared capability classifies as dormant" ;;
  *) bad "undeclared capability classifies as dormant" "$out" ;;
esac
if has_claude; then
  has "already-installed rows report present" "$out" "present"
else
  skip "already-installed rows report present" "no claude CLI here"
fi

out="$(cd "$REPO" && "$FELIX" stack apply 2>&1)"
has "apply without --yes changes nothing" "$out" "Nothing changed"

# The safety property: no flag promotes a high-risk row into the apply set.
out="$(cd "$REPO" && "$FELIX" stack apply --yes 2>&1)"
case "$out" in
  *"installed  plugin felix-test-dangerous"*)
    bad "--yes never installs high risk" "high-risk row was applied" ;;
  *) ok "--yes never installs high risk" ;;
esac
has "and says why it was left alone" "$out" "No flag installs those"

printf '\nprofiles\n'
printf 'core\talways\nbilling\tbilling\n' > "$FROOT/projects/widget/profiles.tsv"
out="$(cd "$REPO" && "$FELIX" profile core 2>&1)"
has "core profile mounts unconditional rows" "$out" "superpowers"
case "$out" in
  *"felix-test-absent"*) bad "core profile excludes other capabilities" "$out" ;;
  *) ok "core profile excludes other capabilities" ;;
esac

printf '\nhuman setup steps\n'
{
  printf 'always-done\tA step that is already satisfied\talways\ttrue\n'
  printf 'always-todo\tA step nobody has done\talways\tfalse\n'
  printf 'later\tA step for a capability not present yet\tbilling\tfalse\n'
} > "$FROOT/projects/widget/setup.tsv"
mkdir -p "$FROOT/projects/widget/setup"
printf '# Do the thing\n\nStep one.\n' > "$FROOT/projects/widget/setup/always-todo.md"

out="$(cd "$REPO" && "$FELIX" setup 2>&1)"
has "a satisfied step reports done"    "$out" "[x] always-done"
has "an unmet step reports todo"       "$out" "[ ] always-todo"
has "a dormant capability is deferred" "$out" "not needed yet"
case "$out" in
  *"[ ] later"*) bad "dormant steps never nag" "$out" ;;
  *) ok "dormant steps never nag" ;;
esac

out="$(cd "$REPO" && "$FELIX" setup always-todo 2>&1)"
has "a runbook prints in full" "$out" "Step one."

out="$(cd "$REPO" && "$FELIX" setup later 2>&1)"; rc=$?
[ "$rc" -ne 0 ] && ok "a missing runbook fails loudly" \
                || bad "a missing runbook fails loudly" "silently returned 0"

printf '\nrepair loop\n'
# The ceiling is the safety property: past it the answer stops being "retry".
out="$(FELIX_REPAIR_MAX=3 bash -c '
  . '"$FROOT"'/harness/lib/repair.sh
  echo "$FELIX_REPAIR_MAX"')"
is "ceiling defaults to 3" "$out" "3"
out="$(FELIX_REPAIR_MAX=1 bash -c '
  . '"$FROOT"'/harness/lib/repair.sh
  echo "$FELIX_REPAIR_MAX"')"
is "ceiling is overridable" "$out" "1"

# A repo with no GitHub remote must say so rather than guess.
out="$(cd "$PLAIN" && "$FELIX" repair 2>&1)"; rc=$?
[ "$rc" -ne 0 ] && ok "repair refuses outside a governed GitHub repo" \
                || bad "repair refuses outside a governed GitHub repo" "$out"

printf '\nissue intake\n'
# The first of the two p41 exit criteria nothing met: take an issue. Mirrors
# felix repair exactly - brief on stdout, scope verdict in the exit code - so
# unattended.yml, which already branches on `rc != 3`, consumes it unchanged.
mkdir -p "$REPO/src"
printf 'x\n' > "$REPO/src/widget.py"
cp "$REAL_HARNESS/templates/risk.tsv" "$FROOT/projects/widget/risk.tsv"
# Declared here rather than inherited. The evidence fixture is written further
# down this file, and a section that depends on state another section happens to
# set up reads like a product bug the day the order changes.
printf 'code\t^src/\t^tests?/\tbehaviour changed and nothing proves it\n' \
  > "$FROOT/projects/widget/evidence.tsv"
# Same reason. This fixture has no routes.tsv until much further down the file,
# so a brief asking which play applies would silently have nothing to answer
# with — and the assertion would have been written to match that emptiness.
cp "$REAL_HARNESS/templates/routes.tsv" "$FROOT/projects/widget/routes.tsv"
_brief() { ( cd "$REPO" && bash -c '
  . '"$FROOT"'/harness/lib/classify.sh
  . '"$FROOT"'/harness/lib/incident.sh
  . '"$FROOT"'/harness/lib/route.sh
  . '"$FROOT"'/harness/lib/intake.sh
  felix_brief_render "'"$FROOT"'/projects/widget" "'"$REPO"'" "$1" "$2"' _ "$1" "$2" ); }

out="$(_brief "the widget renders twice" "src/widget.py double-renders on mount")"
has "the brief names the file the issue names" "$out" "src/widget.py"
has "and states the tier"                      "$out" "tier"
has "and what a fix will have to prove"        "$out" "prove"
has "and the play this project already chose"  "$out" "play"

# Scope before detail. Telling a model what it may not touch after handing it
# the details is the wrong order: by then it has a plan.
mkdir -p "$REPO/.github/workflows"; printf 'on: push\n' > "$REPO/.github/workflows/ci.yml"
out="$(_brief "ci is wrong" ".github/workflows/ci.yml needs a job")"; rc=$?
is  "a red path exits 3"            "$rc" "3"
has "and says so before the detail" "$out" "OUT OF SCOPE"

out="$(_brief "nothing real" "this names no path that exists")"; rc=$?
is  "an issue naming no real file still exits 0" "$rc" "0"
has "and says it cannot be scoped"               "$out" "no file"

# --from - is what makes this testable and what makes it usable before any
# issue tracker is wired, the same reason felix incident reads stdin. The suite
# stubs no gh and never has, so a design that could only fetch would be a design
# whose interesting half was untestable.
out="$(cd "$REPO" && printf 'src/widget.py double-renders on mount\n' \
       | "$FELIX" brief --from - --title "the widget renders twice" 2>&1)"; rc=$?
is  "brief reads an issue from stdin" "$rc" "0"
has "and briefs the file it names"    "$out" "src/widget.py"
out="$(cd "$PLAIN" && printf 'x\n' | "$FELIX" brief --from - --title t 2>&1)"; rc=$?
[ "$rc" -ne 0 ] && ok "brief refuses outside a governed repo" \
                || bad "brief refuses outside a governed repo" "$out"
out="$(cd "$REPO" && "$FELIX" brief 2>&1)"; rc=$?
[ "$rc" -ne 0 ] && ok "and refuses with no issue and no input" \
                || bad "and refuses with no issue and no input"

# Preview by default, act behind a flag: the pattern incident --create and
# classify --apply already set, against discover which refuses --yes outright.
# A symbolic ref when there is one, the commit otherwise. This fixture sits on a
# detached HEAD, so `rev-parse --abbrev-ref` returns the literal string HEAD,
# and checking that out fails — silently, leaving the branch where it was.
_base_branch="$(cd "$REPO" && { git symbolic-ref --quiet --short HEAD 2>/dev/null \
                                || git rev-parse HEAD 2>/dev/null; })"
( cd "$REPO" && git checkout -qb feature/thing 2>/dev/null
  printf 'y\n' >> src/widget.py
  git add -A >/dev/null 2>&1
  git -c user.name=t -c user.email=t@t commit -qm "fix: stop the double render" >/dev/null 2>&1 )
out="$(cd "$REPO" && "$FELIX" pr 2>&1)"; rc=$?
is  "pr previews and exits 0"    "$rc" "0"
has "naming the branch's commit" "$out" "stop the double render"
has "and the tier it carries"    "$out" "tier"
case "$out" in
  *created*) bad "and creates nothing without --create" "$out" ;;
  *)         ok  "and creates nothing without --create" ;;
esac
# Asserted by naming the current branch as the base, rather than by checking out
# a branch called main: `git init` does not promise that name, and a checkout
# that silently fails would leave this passing against the wrong branch.
out="$(cd "$REPO" && "$FELIX" pr --base feature/thing 2>&1)"; rc=$?
[ "$rc" -ne 0 ] && ok "pr refuses to open a branch against itself" \
                || bad "pr refuses to open a branch against itself" "$out"

# Put back what this section borrowed. Declaring the state you depend on is half
# the rule; restoring the state you changed is the other half. Seeding a route
# table here made a later assertion about the prompt hook being silent fail,
# because that assertion had been passing on the absence of routes rather than
# on the absence of lessons — which is what it says it tests.
# The branch first, and forced. Routing scores the branch name, and a fixture
# left on `feature/thing` sent four later prompts to the `build` route, whose
# keywords include `feature`. Leaving state behind is not only about files.
#
# Forced, and before the files are removed: deleting a tracked path dirties the
# tree, and a plain checkout then fails silently, which is how the first attempt
# at this cleanup left the branch exactly where it found it.
#
# Restored by pointing HEAD back rather than by checking anything out. This
# fixture has no commits yet — a later section makes the first one — so `main`
# is an unborn branch and `git checkout main` has nothing to check out. The
# branch created here was the first that ever had a commit on it, which is why
# every attempt to return to `main` failed quietly.
( cd "$REPO" && git symbolic-ref HEAD "refs/heads/${_base_branch:-main}" 2>/dev/null
  git branch -qD feature/thing 2>/dev/null
  git reset -q 2>/dev/null ) || true
rm -f "$FROOT/projects/widget/routes.tsv" "$FROOT/projects/widget/evidence.tsv"
rm -rf "$REPO/.github"
# Asserted, not assumed. A cleanup nobody checks is the same as no cleanup.
_after="$(cd "$REPO" && { git symbolic-ref --quiet --short HEAD 2>/dev/null \
                          || git rev-parse HEAD 2>/dev/null; })"
[ "$_after" = "$_base_branch" ] && ok "the fixture is left as it was found" \
  || bad "the fixture is left as it was found" "on $_after, expected $_base_branch"

printf '\nrisk classification\n'
cp "$REAL_HARNESS/templates/risk.tsv" "$FROOT/projects/widget/risk.tsv"
( cd "$REPO" && git add -A >/dev/null 2>&1
  git -c user.name=t -c user.email=t@t commit -qm base >/dev/null 2>&1 )

_classify() { ( cd "$REPO" && "$FELIX" classify --base HEAD~0 2>/dev/null ); }
_stage() { ( cd "$REPO" && git add -A >/dev/null 2>&1 && \
             git -c user.name=t -c user.email=t@t commit -qm c >/dev/null 2>&1 ); }
_reset() { ( cd "$REPO" && git reset -q --hard HEAD~1 >/dev/null 2>&1 ); }

printf 'notes\n' > "$REPO/README.md"; _stage
out="$( cd "$REPO" && "$FELIX" classify --base HEAD~1 2>&1 )"
has "docs classify green" "$out" "tier:  green"
_reset

mkdir -p "$REPO/migrations"; printf 'x\n' > "$REPO/migrations/001.sql"; _stage
out="$( cd "$REPO" && "$FELIX" classify --base HEAD~1 2>&1 )"
has "a migration classifies red" "$out" "tier:  red"
_reset

printf 'notes\n' > "$REPO/README.md"
mkdir -p "$REPO/migrations"; printf 'x\n' > "$REPO/migrations/002.sql"; _stage
out="$( cd "$REPO" && "$FELIX" classify --base HEAD~1 2>&1 )"
has "one red file makes the whole diff red" "$out" "tier:  red"
_reset

printf 'x\n' > "$REPO/unknown_thing.xyz"; _stage
out="$( cd "$REPO" && "$FELIX" classify --base HEAD~1 2>&1 )"
has "an unrecognised file is yellow, never green" "$out" "tier:  yellow"
has "and says why"                                "$out" "no rule matched"
_reset

printf 'api_key = "sk-ant-api03-AAAAAAAAAAAAAAAAAAAAAAAA"\n' > "$REPO/cfg.py"; _stage
out="$( cd "$REPO" && "$FELIX" classify --base HEAD~1 2>&1 )"
has "a credential in added lines classifies red" "$out" "tier:  red"
_reset

printf 'api_key = os.environ["ANTHROPIC_API_KEY"]\n' > "$REPO/cfg2.py"; _stage
out="$( cd "$REPO" && "$FELIX" classify --base HEAD~1 2>&1 )"
case "$out" in
  *"credential appears"*) bad "reading a key from env is not a credential" "$out" ;;
  *) ok "reading a key from env is not a credential" ;;
esac
_reset

printf '\nwhat a revert cannot undo\n'
# A tier used to be a function of which file you touched, and that is what sent
# a one-line dependency-floor correction to the founder for a day. The question
# a stop must answer is not "is this file important" but "does merging write
# something outside this tree that a revert cannot reach".
#
# Escapes are engine constants. A project may add to them and may never declare
# one away, so this is not a table anybody can weaken into agreement.
_esc() { ( cd "$REPO" && . "$FROOT/harness/lib/escape.sh"
           felix_escapes "$FROOT/projects/widget" HEAD~1 "$REPO" ); }
# L-25 again: this section appends rows to the widget's table, and every later
# assertion in the file reads that table. Snapshot it here, restore at the end,
# and assert the restore rather than trusting it.
cp "$FROOT/projects/widget/risk.tsv" "$TMP/risk.keep"

printf 'notes and more notes\n' > "$REPO/README.md"; _stage
is "a documentation change escapes nothing" "$(_esc)" ""
_reset

# Merging this runs the job, holding every secret the repository has. Reverting
# restores the YAML; it does not un-run the job or un-read the key.
mkdir -p "$REPO/.github/workflows"; printf 'on: push\n' > "$REPO/.github/workflows/ci.yml"; _stage
has "a workflow change escapes as execute" "$(_esc)" "execute"
_reset

mkdir -p "$REPO/migrations"; printf 'x\n' > "$REPO/migrations/003.sql"; _stage
has "a migration escapes as durable" "$(_esc)" "durable"
_reset

# The trailing marker is a scanner exclusion, and it sits in a shell comment so
# it never reaches leak.py — the fixture file still holds a clean credential for
# the scanner under test to find. Without it Felix's own gate goes red on this
# line, which is the scanner working on the suite that tests the scanner.
printf 'api_key = "sk-ant-api03-BBBBBBBBBBBBBBBBBBBBBBBB"\n' > "$REPO/leak.py"; _stage  # must_flag
has "a credential in added lines escapes as disclose" "$(_esc)" "disclose"
_reset

# The verifier channel. A green produced by a narrowed judge certifies itself,
# so shrinking what judges is the one edit that cannot be checked by the thing
# it shrank. Adding to a table is free; removing from it is not.
#
# The table has to be inside the repository being merged for a diff to contain
# it. For a governed product that is never true — its tables live in the Felix
# home — so this channel fires when Felix's *own* repository is the one being
# merged, which is exactly where those tables are edited. Indirect, and complete.
mkdir -p "$REPO/projects/thing"
{ printf '# tier\tkind\tpattern\treason\n'
  printf 'red\tpath\t^secrets/\tsecret material\n'
  printf 'red\tpath\t^auth/\tauthorization model\n'
} > "$REPO/projects/thing/risk.tsv"; _stage
printf 'green\tpath\t^extra/\tan added row\n' >> "$REPO/projects/thing/risk.tsv"; _stage
is "adding a row to an enforcing table escapes nothing" "$(_esc)" ""
_reset

# JSON punishes line-identity comparison. Adding a key rewrites the line above
# it, because that line gains a comma — so a naive shrink test reads every
# addition as a removal, and fires on the single most common edit anyone makes
# to project.json. Observed on the commit that declared consumers.
printf '{\n  "name": "thing",\n  "gate": "g.sh"\n}\n' > "$REPO/projects/thing/project.json"; _stage
printf '{\n  "name": "thing",\n  "gate": "g.sh",\n  "consumers": "none"\n}\n' > "$REPO/projects/thing/project.json"; _stage
is "adding a key to json escapes nothing" "$(_esc)" ""
_reset
printf '{\n  "name": "thing"\n}\n' > "$REPO/projects/thing/project.json"; _stage
has "but removing one still escapes" "$(_esc)" "verifier"
_reset; _reset
sed '/^red.path.\^auth/d' "$REPO/projects/thing/risk.tsv" > "$TMP/rt" && mv "$TMP/rt" "$REPO/projects/thing/risk.tsv"
_stage
has "removing one escapes as verifier" "$(_esc)" "verifier"
has "and names the table"              "$(_esc)" "projects/thing/risk.tsv"
_reset
# L-25: restore the fixture and assert the restore, or every later assertion in
# this file runs against a repository this block quietly changed.
_reset
is "and the repository is back to where it started" "$(_esc)" ""

# Confinement, which is the whole reason PR #4 should not have waited. The
# manifest is dual-use: it declares dependencies AND configures the gate. So the
# row stays, and stops firing only when every changed line is a version
# constraint and the package names are the same on both sides.
{ printf 'red\tpath\t^pyproject\\.toml$\tmanifest is also gate config\tverifier\t'
  printf '^[-+][[:space:]]*"?[A-Za-z0-9._-]+[[:space:]]*[<>=!~^,"]\n'
} >> "$FROOT/projects/widget/risk.tsv"
printf '[project]\ndependencies = [\n  "anthropic>=0.40",\n]\n' > "$REPO/pyproject.toml"; _stage
printf '[project]\ndependencies = [\n  "anthropic>=0.120",\n]\n' > "$REPO/pyproject.toml"; _stage
is "a version bump alone escapes nothing" "$(_esc)" ""
_reset

# The evil twin: same file, same PR shape, one extra line that deletes tests
# from the gate without touching a single test.
printf '[project]\ndependencies = [\n  "anthropic>=0.120",\n]\n[tool.pytest.ini_options]\naddopts = "--ignore=tests/test_judgment.py"\n' > "$REPO/pyproject.toml"; _stage
has "the same file with an unconfined line escapes" "$(_esc)" "pyproject.toml"
_reset; _reset
cp "$TMP/risk.keep" "$FROOT/projects/widget/risk.tsv"

# A verifier row counts rather than compares. The suite is the thing that
# judges, so weakening it must stop — but comparing line identity would fire on
# every refactor and on every ordinary edit, and a stop that fires constantly is
# one people route around. What must not go down is the number of assertions.
{ printf 'yellow\tpath\t^suite\\.sh$\tweakening the suite is how a gate stops being one\tverifier\t'
  printf 'count:^[[:space:]]*(ok|is|has) \n'
} >> "$FROOT/projects/widget/risk.tsv"
printf 'ok one\nis two\nhas three\n' > "$REPO/suite.sh"; _stage
printf 'ok one\nis two\nhas three\nok four\n' > "$REPO/suite.sh"; _stage
is "adding an assertion escapes nothing" "$(_esc)" ""
_reset
printf 'ok one\nis two\n' > "$REPO/suite.sh"; _stage
has "removing one escapes as verifier" "$(_esc)" "verifier"
_reset
# Rewriting every line while keeping the count is a refactor, not a weakening.
printf 'ok ONE\nis TWO\nhas THREE\n' > "$REPO/suite.sh"; _stage
is "rewriting assertions without losing any escapes nothing" "$(_esc)" ""
_reset; _reset
cp "$TMP/risk.keep" "$FROOT/projects/widget/risk.tsv"

# A row with no channel is advisory. Every table written before this column
# existed is exactly that, and must keep classifying without ever stopping a
# merge on its own.
printf 'red\tpath\t^legacy/\tno channel named\n' >> "$FROOT/projects/widget/risk.tsv"
mkdir -p "$REPO/legacy"; printf 'x\n' > "$REPO/legacy/a.txt"; _stage
is "a red row naming no channel stops nothing" "$(_esc)" ""
out="$( cd "$REPO" && "$FELIX" classify --base HEAD~1 2>&1 )"
has "but it still classifies red" "$out" "tier:  red"
_reset
cp "$TMP/risk.keep" "$FROOT/projects/widget/risk.tsv"
is "the widget's table is exactly as this section found it" \
   "$(diff -q "$TMP/risk.keep" "$FROOT/projects/widget/risk.tsv" >/dev/null && echo same)" "same"

printf '\nmerging\n'
# The escape set decides nothing until something consults it. Felix had no way
# to merge at all — the only merge-adjacent code in the engine turned on
# GitHub's auto-merge and then waited for a person — so a rule saying "Felix
# merges what a revert undoes" would have recoloured a label and saved nobody
# anything.
#
# Every blocker is computed before gh is reached. A merge command that discovers
# its own preconditions from the network cannot be tested and cannot refuse
# offline, and refusing offline is the case that matters.
_blk() { ( cd "$REPO" && . "$FROOT/harness/lib/escape.sh"
           . "$FROOT/harness/lib/evidence.sh"
           . "$FROOT/harness/lib/verify.sh"
           felix_merge_blockers "$FROOT/projects/widget" HEAD~1 "$REPO" "$FROOT" ); }

printf 'plain notes\n' > "$REPO/README.md"; _stage
has "an unverified tree blocks the merge" "$(_blk)" "unverified"

# A receipt for a different tree is not a green gate, which is the trap cmd_pr
# already learned. Stamp one for the wrong tree and it must still block.
( cd "$REPO" && . "$FROOT/harness/lib/verify.sh"
  felix_verify_record "$REPO" "$FROOT" 0 "gate.sh" "not-this-tree" >/dev/null 2>&1 )
has "a receipt for another tree still blocks" "$(_blk)" "unverified"

( cd "$REPO" && . "$FROOT/harness/lib/verify.sh"
  felix_verify_record "$REPO" "$FROOT" 0 "gate.sh" "$(felix_tree_id "$REPO" "$FROOT")" >/dev/null 2>&1 )
is "a green receipt for this exact tree clears every blocker" "$(_blk)" ""

# And a red receipt for the right tree is not a pass either.
( cd "$REPO" && . "$FROOT/harness/lib/verify.sh"
  felix_verify_record "$REPO" "$FROOT" 1 "gate.sh" "$(felix_tree_id "$REPO" "$FROOT")" >/dev/null 2>&1 )
has "a red receipt for this tree blocks" "$(_blk)" "unverified"
( cd "$REPO" && . "$FROOT/harness/lib/verify.sh"
  felix_verify_record "$REPO" "$FROOT" 0 "gate.sh" "$(felix_tree_id "$REPO" "$FROOT")" >/dev/null 2>&1 )

# An escape outranks a green gate. This is the whole point: the gate says the
# code works, and says nothing about whether merging writes outside the tree.
mkdir -p "$REPO/.github/workflows"; printf 'on: push\n' > "$REPO/.github/workflows/x.yml"; _stage
( cd "$REPO" && . "$FROOT/harness/lib/verify.sh"
  felix_verify_record "$REPO" "$FROOT" 0 "gate.sh" "$(felix_tree_id "$REPO" "$FROOT")" >/dev/null 2>&1 )
has "a green gate does not clear an escape" "$(_blk)" "execute"
_reset

# An evidence gap is not a stop. It is work Felix owes, and handing it back as
# a decision is the defect the charter names.
cp "$FROOT/projects/widget/evidence.tsv" "$TMP/ev.keep" 2>/dev/null || : > "$TMP/ev.keep"
printf 'unit\t^src/\t^tests?/\tcode changes need a test\n' > "$FROOT/projects/widget/evidence.tsv"
mkdir -p "$REPO/src"; printf 'x = 1\n' > "$REPO/src/thing.py"; _stage
( cd "$REPO" && . "$FROOT/harness/lib/verify.sh"
  felix_verify_record "$REPO" "$FROOT" 0 "gate.sh" "$(felix_tree_id "$REPO" "$FROOT")" >/dev/null 2>&1 )
has "an untested change blocks, naming the evidence owed" "$(_blk)" "evidence"
has "and says which rule"                                 "$(_blk)" "unit"
_reset
cp "$TMP/ev.keep" "$FROOT/projects/widget/evidence.tsv"

# The command itself must refuse without reaching the network. gh is not called,
# so this assertion holds on a runner with no credentials and no remote.
mkdir -p "$REPO/migrations"; printf 'x\n' > "$REPO/migrations/900.sql"; _stage
out="$( cd "$REPO" && "$FELIX" merge --base HEAD~1 2>&1 )"; rc=$?
is  "felix merge refuses on an escape"  "$rc" "3"
has "and names the channel"             "$out" "durable"
has "and says what would have to change" "$out" "founder"
_reset

printf 'ordinary\n' > "$REPO/README.md"; _stage
( cd "$REPO" && . "$FROOT/harness/lib/verify.sh"
  felix_verify_record "$REPO" "$FROOT" 0 "gate.sh" "$(felix_tree_id "$REPO" "$FROOT")" >/dev/null 2>&1 )
out="$( cd "$REPO" && "$FELIX" merge --base HEAD~1 --dry-run 2>&1 )"; rc=$?
is  "and reports a clear merge without performing one" "$rc" "0"
has "saying so plainly"                                "$out" "nothing escapes"
_reset

printf '\na surface no test can judge\n'
# Some changes are revert-complete, touch no store and reach no stranger, and
# still must not merge unread: a rubric that teaches the wrong thing breaks
# nothing a gate can see. Elenchus's constitution already answers this — T2
# wants "an independent reviewer running in an isolated worktree at the reviewed
# commit" — and nothing implemented it, so the row sat red and stopped nothing.
#
# The verdict is a receipt keyed on the tree, exactly like the gate's, because
# the trap is the same one: a verdict for a different tree is not a verdict.
RVH="$TMP/reviewhome"; RVP="$RVH/projects/widget"; mkdir -p "$RVP" "$MEM/widget"
cp "$TMP/risk.keep" "$RVP/risk.tsv" 2>/dev/null || : > "$RVP/risk.tsv"
printf 'red\tpath\t^content/\ta doctrine surface; no test can judge it\treviewed\t-\n' >> "$RVP/risk.tsv"
_resc() { ( cd "$REPO" && . "$FROOT/harness/lib/verify.sh"; . "$FROOT/harness/lib/review.sh"
            . "$FROOT/harness/lib/escape.sh"
            felix_escapes "$RVP" HEAD~1 "$REPO" "$RVH" ); }

mkdir -p "$REPO/content"; printf 'teach this\n' > "$REPO/content/rubric.md"; _stage
has "a doctrine surface with no verdict escapes" "$(_resc)" "reviewed"

# A verdict for some other tree must not clear it.
( . "$FROOT/harness/lib/verify.sh"; . "$FROOT/harness/lib/review.sh"
  felix_review_record "$RVH" "$RVP" "some-other-tree" pass reviewer-1 "looked fine" )
has "a verdict for another tree does not clear it" "$(_resc)" "reviewed"

TID="$( . "$FROOT/harness/lib/verify.sh"; felix_tree_id "$REPO" "$RVH" )"
( . "$FROOT/harness/lib/verify.sh"; . "$FROOT/harness/lib/review.sh"
  felix_review_record "$RVH" "$RVP" "$TID" block reviewer-1 "the rubric contradicts the map" )
has "a blocking verdict does not clear it either" "$(_resc)" "reviewed"

( . "$FROOT/harness/lib/verify.sh"; . "$FROOT/harness/lib/review.sh"
  felix_review_record "$RVH" "$RVP" "$TID" pass reviewer-1 "ran it against real content" )
is "a passing verdict for this exact tree clears it" "$(_resc)" ""

# Independence cannot be checked. Isolation half can, and it is the half that
# has actually gone wrong: a reviewer running pytest against the live tree while
# somebody keeps editing reports false failures, which the governed project's
# own lessons record as a real incident. So a pass claiming it ran in the tree
# under review is refused as a recording, not merely doubted.
( . "$FROOT/harness/lib/verify.sh"; . "$FROOT/harness/lib/review.sh"
  felix_review_record "$RVH" "$RVP" "$TID" pass reviewer-1 "ran here" "$REPO" "$REPO" ) 2>/dev/null
rc=$?
is "a pass claiming it ran in the reviewed tree is refused" "$rc" "1"
has "and the earlier verdict is not replaced by it" \
    "$( . "$FROOT/harness/lib/review.sh"; felix_review_verdict "$RVH" "$RVP" "$TID" )" "ran it against real content"

( . "$FROOT/harness/lib/verify.sh"; . "$FROOT/harness/lib/review.sh"
  felix_review_record "$RVH" "$RVP" "$TID" pass reviewer-2 "ran elsewhere" "$TMP/some-other-worktree" "$REPO" )
has "a pass from a separate worktree records the place it ran" \
    "$( . "$FROOT/harness/lib/review.sh"; felix_review_verdict "$RVH" "$RVP" "$TID" )" "some-other-worktree"

# A block is never refused for where it ran. A reviewer reporting a problem from
# the wrong place is still reporting a problem, and discarding it would make the
# isolation check a way to lose bad news.
( . "$FROOT/harness/lib/verify.sh"; . "$FROOT/harness/lib/review.sh"
  felix_review_record "$RVH" "$RVP" "$TID" block reviewer-3 "found a contradiction" "$REPO" "$REPO" )
rc=$?

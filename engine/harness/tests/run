is "an unremarkable file is in scope" "$rc" "0"
has "and says the gates still apply" "$out" "evidence policy"

printf '\nearned auto-merge\n'
# The streak logic is the part that decides; the GitHub calls that feed it need a
# network and are exercised by using the thing. Fed synthetic history here.
_streak() { ( . "$FROOT/engine/harness/lib/automerge.sh" 2>/dev/null \
              || . "$FROOT/harness/lib/automerge.sh"; felix_automerge_streak "$1" ); }

is "no history is no streak" "$(_streak "")" "0"
is "all clean counts them all" \
   "$(_streak "$(printf '9\tclean\ta\n8\tclean\tb\n7\tclean\tc')")" "3"
# Consecutive, from the head. A red run in the middle is not something to count
# past: the question is whether the rules have been right lately, not often.
is "a red run breaks the streak" \
   "$(_streak "$(printf '9\tclean\ta\n8\tdirty\tb\n7\tclean\tc')")" "1"
is "and a red run at the head means zero" \
   "$(_streak "$(printf '9\tdirty\ta\n8\tclean\tb')")" "0"
# A number that arrived describing nothing is still not evidence. `gh run list`
# on a branch that no longer exists — which is every merged PR once the branch
# is deleted — returns [], and length of [] is 0, so "no runs found" read as
# "no failures" and counted toward switching auto-merge on.
_hist() { ( . "$FROOT/harness/lib/automerge.sh"; felix_automerge_state "$1" "$2" ); }
is "no runs at all is unknown, not clean" "$(_hist 0 0)" "unknown"
is "runs that all passed are clean"       "$(_hist 4 0)" "clean"
is "runs with a failure are dirty"        "$(_hist 4 2)" "dirty"
is "an unreadable count is unknown"       "$(_hist '' '')" "unknown"

# The state that used to be missing. The failure count comes off the network,
# and an errored `gh run list` prints nothing — which `${failures:-0}` read as
# zero failures, so "could not find out" advanced the streak toward switching
# auto-merge on. A streak is a claim that CI agreed; silence is not agreement.
is "a run nobody could read does not count as clean" \
   "$(_streak "$(printf '9\tunknown\ta\n8\tclean\tb')")" "0"
is "and it stops the streak rather than being skipped past" \
   "$(_streak "$(printf '9\tclean\ta\n8\tunknown\tb\n7\tclean\tc')")" "1"

printf '\nunattended budget\n'
# The ceiling worth having fails between runs, not during one, and counts
# repetition rather than money: ten deliberate attempts in a day is a working
# system, two hundred is a loop whatever each one cost.
rm -f "$FROOT/projects/widget/budget.log"
python3 - "$FROOT/projects/widget/project.json" <<'PYJ'
import json,sys,pathlib
p=pathlib.Path(sys.argv[1]); d=json.loads(p.read_text())
d["unattended_daily_limit"]="2"; p.write_text(json.dumps(d,indent=2))
PYJ
out="$(cd "$REPO" && "$FELIX" budget 2>&1)"
has "reads the per-project limit" "$out" "limit:  2"
has "and reports what is left"    "$out" "left:   2"

( cd "$REPO" && "$FELIX" budget --record >/dev/null 2>&1 )
( cd "$REPO" && "$FELIX" budget --record >/dev/null 2>&1 )
out="$(cd "$REPO" && "$FELIX" budget 2>&1)"; rc=$?
has "spending is counted" "$out" "used:   2"
is  "exhausted exits 3"   "$rc" "3"

out="$(cd "$REPO" && "$FELIX" budget --record 2>&1)"; rc=$?
is  "and refuses to spend past the ceiling" "$rc" "3"
has "saying why"                            "$out" "budget exhausted"

# A ceiling in a runner's ephemeral filesystem resets every job, invisibly.
[ -f "$FROOT/projects/widget/budget.log" ] \
  && ok "the ledger is durable state in the project" \
  || bad "the ledger is durable state in the project"

# Old entries age out rather than accumulating forever.
printf '1\t1970-01-01T00:00\tancient\n' >> "$FROOT/projects/widget/budget.log"
out="$(cd "$REPO" && "$FELIX" budget 2>&1)"
has "entries older than a day do not count" "$out" "used:   2"

# #84, the half that is mechanical. The append was unchecked and the caller
# reported `used + 1` - arithmetic on a value read BEFORE the write, not a
# reading of what landed. So a record that never landed printed
# `recorded. 1 of 10 used` and exited 0; `used` stayed 0 forever; and the
# ceiling silently became no ceiling. budget.sh's own header names that exact
# outcome as the thing to prevent - "which is the same as no ceiling, and it
# resets invisibly."
#
# An unwritable project directory is the cheapest real cause. A full disk or a
# read-only mount reach the same place, and one of them is how this would
# actually happen on a runner.
rm -f "$FROOT/projects/widget/budget.log"
python3 - "$FROOT/projects/widget/project.json" <<'PYJ'
import json,sys,pathlib
p=pathlib.Path(sys.argv[1]); d=json.loads(p.read_text())
d["unattended_daily_limit"]="10"; p.write_text(json.dumps(d,indent=2))
PYJ
chmod 555 "$FROOT/projects/widget"
out="$(cd "$REPO" && "$FELIX" budget --record --why "probe" 2>&1)"; rc=$?
chmod 755 "$FROOT/projects/widget"

[ "$rc" -ne 0 ] && ok "a record that could not be written does not exit 0" \
                || bad "a record that could not be written does not exit 0" \
                       "exit $rc after: $out"
case "$out" in
  *"recorded."*) bad "and does not say it recorded" "$out" ;;
  *)             ok  "and does not say it recorded" ;;
esac
# The number is the tell. `used + 1` reports a spend that never happened, and it
# reports it in the same words a real one uses.
case "$out" in
  *"1 of 10"*) bad "nor report a spend that did not happen" "$out" ;;
  *)           ok  "nor report a spend that did not happen" ;;
esac
is "and nothing was written" \
   "$([ -f "$FROOT/projects/widget/budget.log" ] && echo present || echo absent)" "absent"

# The control, and the half a careless fix breaks: a writable project still
# records, still exits 0, and the count it prints is the one the log holds
# rather than one it worked out in advance.
out="$(cd "$REPO" && "$FELIX" budget --record --why "real" 2>&1)"; rc=$?
is  "a writable project still records" "$rc" "0"
has "and says so"                      "$out" "recorded."
is  "the log holds exactly one entry" \
    "$( . "$FROOT/harness/lib/budget.sh"; felix_budget_used "$FROOT/projects/widget" )" "1"
has "which is the number it printed"   "$out" "1 of 10"

# And the library says so on its own, so the fix cannot be a message change in
# the command while the function still swallows the failure.
#
# The log is removed first, and that is not tidiness. Directory permissions gate
# CREATION, not appends to a file that already exists - so with the control's
# budget.log still in place, chmod 555 on the directory leaves the append
# perfectly writable and the probe tests nothing. This assertion passed for that
# reason before the log was removed.
rm -f "$FROOT/projects/widget/budget.log"
chmod 555 "$FROOT/projects/widget"
( . "$FROOT/harness/lib/budget.sh"
  felix_budget_record "$FROOT/projects/widget" "lib probe" 2>/dev/null ); librc=$?
chmod 755 "$FROOT/projects/widget"
[ "$librc" -ne 0 ] && ok "felix_budget_record itself reports the failure" \
                   || bad "felix_budget_record itself reports the failure" "exit $librc"
rm -f "$FROOT/projects/widget/budget.log"

# #84, the race. cmd_budget is check-then-act with no lock: it reads the count,
# compares it to the limit, then appends. Two callers that both read 9 against a
# limit of 10 both pass the comparison and both append, and the ceiling - the
# only mechanical bound on unattended model runs - is overrun.
#
# Reproduced against shipped code on ONE machine, no CI involved: seeded at 9 of
# 10, three concurrent callers, all three recorded, ledger left at 12.
#
# Driven with real concurrent processes rather than a stub, because the defect
# IS the interleaving; a sequential fixture cannot express it. It is made
# deterministic by seeding the ledger so exactly one slot remains, which makes
# the correct outcome exact rather than probabilistic: at most one caller may
# record, however the three interleave.
_seed_budget() {   # $1 = how many entries to seed
  local n="$1" now i
  now="$(date +%s)"
  : > "$FROOT/projects/widget/budget.log"
  i=0; while [ "$i" -lt "$n" ]; do
    printf '%s\t%s\tseed\n' "$now" "1970-01-01T00:00" >> "$FROOT/projects/widget/budget.log"
    i=$((i + 1))
  done
}
_seed_budget 9
RACE="$TMP/race"; rm -rf "$RACE"; mkdir -p "$RACE"
for _r in 1 2 3; do
  ( cd "$REPO" && "$FELIX" budget --record --why "racer$_r" >"$RACE/out$_r" 2>&1
    printf '%s' "$?" > "$RACE/rc$_r" ) &
done
wait

_recorded=0
for _r in 1 2 3; do
  [ "$(cat "$RACE/rc$_r" 2>/dev/null)" = "0" ] && _recorded=$((_recorded + 1))
done
# At most one, because exactly one slot was left. Zero is allowed and safe: if
# every caller observes the ledger after every append, they all refuse, and the
# window reopens on the next invocation. More than one is the overrun.
[ "$_recorded" -le 1 ] \
  && ok "at most one caller records when one slot is left" \
  || bad "at most one caller records when one slot is left" \
         "$_recorded of 3 recorded; ledger has $(grep -c . "$FROOT/projects/widget/budget.log") entries"

# And no caller may claim success while reporting a count past the ceiling. That
# sentence is what a workflow step reads as permission to invoke a model.
_overclaim=0
for _r in 1 2 3; do
  if [ "$(cat "$RACE/rc$_r" 2>/dev/null)" = "0" ]; then
    case "$(cat "$RACE/out$_r")" in
      *"1"[1-9]" of 10"*|*"2"[0-9]" of 10"*) _overclaim=$((_overclaim + 1)) ;;
    esac
  fi
done
is "and none reports a spend past the ceiling as recorded" "$_overclaim" "0"
rm -f "$FROOT/projects/widget/budget.log"

printf '\nunattended readiness\n'
# #87. Two of the five readiness rows were printf constants. This is the report
# a person reads when deciding whether to switch on a loop that invokes a model
# unattended, and `felix unattended` says outright that Felix will not flip that
# switch for them - so the rows have to be true.
#
# `scope bound` was fully literal, mark and text both, so it stayed checked for a
# project that declares no red path at all - i.e. exactly when nothing is out of
# scope and the bound it names does not exist.
#
# `budget ceiling` is a subtler case and the fix is different. Its [x] was not
# wrong about what it said - a ceiling IS configured, and felix_budget_limit can
# never return "none" - but readiness means the bound HOLDS, and in CI it does
# not: the ledger lives in a checkout made fresh every run (#84). Felix cannot
# determine that mechanically, so the honest mark is neither [x] nor [ ].
UNB="$TMP/unattgh"; mkdir -p "$UNB"
cat > "$UNB/gh" <<'STUB'
#!/usr/bin/env bash
case "$1 $2" in
  "variable list") ;;
  "secret list")   printf 'ANTHROPIC_API_KEY\n' ;;
  "run list")      printf '0\n' ;;
esac
exit 0
STUB
chmod +x "$UNB/gh"
# The fixture has no origin at this point and cmd_unattended dies without one -
# which made two of these assertions pass on the error text rather than on the
# behaviour. Added here and removed at the end of the block.
( cd "$REPO" && git remote add origin https://github.com/example/widget.git ) 2>/dev/null
_unatt() { ( cd "$REPO" && PATH="$UNB:$PATH" "$FELIX" unattended 2>&1 ); }
# Asserted, not assumed: if the command still cannot run, everything below is
# testing an error message.
has "the readiness report runs at all" "$(_unatt)" "repo:"

cp "$FROOT/projects/widget/risk.tsv" "$TMP/risk.unatt.keep" 2>/dev/null || : > "$TMP/risk.unatt.keep"

# A table that declares red paths: the bound exists and the row may say so.
{ printf '# tier\tkind\tpattern\treason\n'
  printf 'red\tpath\t^secrets/\tsecret material\n'
} > "$FROOT/projects/widget/risk.tsv"
# The ROW, not the whole report. A glob like *"[x]"*"scope bound"* matches
# because `[x] api key` appears earlier in the output, so it was true whatever
# the scope row said.
_row() { printf '%s\n' "$1" | grep -F "$2" | head -1; }
out="$(_unatt)"
has "a project with red paths reports the scope bound" "$(_row "$out" 'scope bound')" "[x]"

# A table with no red path at all: nothing is refused, so nothing is bound.
{ printf '# tier\tkind\tpattern\treason\n'
  printf 'green\tpath\t^docs/\tprose\n'
} > "$FROOT/projects/widget/risk.tsv"
out="$(_unatt)"
case "$(_row "$out" 'scope bound')" in
  *"[x]"*) bad "and a project with none does not claim it" "$(_row "$out" 'scope bound')" ;;
  *)       ok  "and a project with none does not claim it" ;;
esac
has "saying what is missing" "$out" "no red rule"

# Content rules bound scope exactly as path rules do (#100) — felix scope
# classifies the whole diff and refuses on either kind. Counting paths alone
# told a project whose red tier is all content rules — secrets, destructive
# SQL, the material the red tier exists for — that nothing was out of scope,
# on the checklist read before switching on unattended model runs. Elenchus
# declares 2 red content rules today.
{ printf '# tier\tkind\tpattern\treason\n'
  printf 'red\tcontent\tDROP[[:space:]]+TABLE\tdestructive sql\n'
} > "$FROOT/projects/widget/risk.tsv"
out="$(_unatt)"
has "a project bounded only by content rules reports the bound" \
    "$(_row "$out" 'scope bound')" "[x]"

# The budget row must not read as a satisfied precondition, because whether the
# ceiling survives where the loop runs is not something this can check.
case "$(_row "$out" 'budget ceiling')" in
  *"[x]"*) bad "the budget row is not reported as satisfied" "$(_row "$out" 'budget ceiling')" ;;
  *)       ok  "the budget row is not reported as satisfied" ;;
esac
has "and is marked unknown rather than unmet" "$(_row "$out" 'budget ceiling')" "[?]"
# And it reads the ledger rather than only the configured number, so the row
# says what has been spent and not merely what was declared.
has "and reports what has been spent" "$out" "spent"

cp "$TMP/risk.unatt.keep" "$FROOT/projects/widget/risk.tsv"
( cd "$REPO" && git remote remove origin ) 2>/dev/null

printf '\ngenerated CI points at a path that exists\n'
# Moving the engine broke every generated workflow at once, in other
# repositories, where this suite never looks. Felix's own gate stayed green
# because it tests Felix. The caller lived elsewhere.
#
# So the generator's output is checked against the filesystem: whatever path it
# tells CI to run must actually resolve inside the engine.
gen="$( . "$FROOT/engine/harness/lib/detect.sh" 2>/dev/null || . "$FROOT/harness/lib/detect.sh"
        . "$FROOT/engine/harness/lib/bootstrap.sh" 2>/dev/null || . "$FROOT/harness/lib/bootstrap.sh"
        felix_bs_render_workflow node someone/repo )"
has "the workflow invokes felix" "$gen" "harness/felix"
felix_path="$(printf '%s' "$gen" | grep -oE '\.\./felix/[a-z/]*harness/felix' | head -1)"
resolved="${felix_path#../felix/}"
# Checked against the real checkout, not the fixture. A generated workflow runs
# against a clone of the actual repository, so that is the layout that has to be
# right, and the fixture flattens the engine in a way no clone does.
REAL_ROOT="$(cd "$REAL_HARNESS/../.." && pwd)"
if [ -x "$REAL_ROOT/$resolved" ]; then
  ok "and that path resolves in a real checkout"
else
  bad "and that path resolves in a real checkout" "generated $resolved, absent from $REAL_ROOT"
fi

printf '\nmistakes record themselves\n'
# Judgement at write time is the wrong shape: it asks for a decision at the exact
# moment someone is trying to finish something else. Write cheaply, curate later.
MISLOG="$MEM/widget/mistakes.log"
rm -f "$MISLOG"
# A script rather than an inline command: project.json holds no escaped quotes,
# which its reader documents that it cannot parse, and a gate script is the more
# common shape anyway.
cat > "$FROOT/projects/widget/failing-gate.sh" <<'GS'
#!/usr/bin/env bash
echo "  lint               FAIL"

#!/usr/bin/env bash
# Felix harness self-test.
#
# The claim under test is that Felix governs a project it knows nothing about.
# So this suite never touches Elenchus. It builds a throwaway Felix root holding
# a single invented project whose gate is a shell one-liner, in a checkout with
# no git remote, and drives the real CLI and the real hook against it.
#
# If Felix ever grows a hidden assumption about Python, about a remote naming
# scheme, or about Elenchus specifically, these tests are where it surfaces.
#
#   harness/tests/run                       the suite
#   harness/tests/run --record-assertions   the suite, the manifest, red.tsv, then the record judged
#   harness/tests/run --reuse               say the last run on this tree stands, or run
# Exit 1 when an assertion failed in the main shell, a record run's judged record included.

set -uo pipefail

# The suite reads nothing from its own stdin, and hooks/session-start reads a
# payload from stdin whenever stdin is not a terminal. About thirty calls here
# run that hook without piping one in, so an inherited pipe that stays open
# would hang the first of them and every run after it. Nothing is inherited.
exec </dev/null

HERE="$(cd "$(dirname "$0")" && pwd)"
REAL_HARNESS="$(cd "$HERE/.." && pwd)"
# This file is the driver: the helpers every assertion uses, then one line per
# part that sources it, then the manifest comparison and the verdict. The
# assertions live in parts/NNNN-*.sh, each cut where it parses alone, sourced in
# the order of the lines below, and sharing this shell, so every variable and
# function defined in one is there for the ones after it. They are sourced one
# to a line and not in a loop on purpose: an arithmetic error inside $(( )) in
# bash 3.2 discards the whole top-level command it sits in, and a loop would
# make that the rest of the suite. Before 2026-10-10 this was one file of 43,000
# lines, 2.8 MB, which an editor's post-edit scanner refused to read.
# _suite_src is the suite's source as one stream, parts first and this file
# last, for the assertions that read the suite's own text.
_suite_src() { cat "$HERE"/parts/*.sh "$HERE/run"; }

PASS=0; FAIL=0
# Every assertion that RAN, by name, whatever its verdict.
#
# #67: two assertions execute on macOS and never run on the Linux runner — no
# pass, no fail, no skip line. Measured as a constant gap of 2 across three
# unrelated commits, including a pre-session main, and not caused by the
# `claude` CLI: hiding claude locally converts four passes into four skips and
# leaves the attempted total unchanged, while CI attempts two fewer.
#
# A total alone cannot say which two. This records names so the suite can
# compare what it ran against what it is supposed to run, and name the
# difference. A count that silently drops is indistinguishable from a passing
# run, which is the property this repository most needs not to have.
#
# Appended to a file rather than accumulated in a variable, because a shell
# variable does not survive the subshells some of these assertions run inside —
# the same reason PASS and FAIL are incremented in the main shell only.
FELIX_TEST_RAN=""
_ran() { [ -n "$FELIX_TEST_RAN" ] && printf '%s\n' "$1" >> "$FELIX_TEST_RAN"; return 0; }
# The ran file, one name a line, as count<TAB>name rows sorted by name: the
# manifest's shape. The name is kept exactly as the suite printed it. Until
# 2026-10-01 the count was cut off by assigning to awk's $1, which rebuilds
# the line from its fields and so folded a run of blanks inside a name to one
# space and trimmed its ends; the suite's own check read its folded copy
# against a folded manifest and agreed, but tests/red compares the manifest
# with the lines the suite printed, and would read such a name as never
# reached on every run (#371's follow-up review, 2026-10-01).
_ran_rows() {   # stdin: names, one a line -> count<TAB>name, sorted by name
  LC_ALL=C sort | uniq -c | LC_ALL=C awk '{ c = $1; sub(/^ *[0-9]+ /, ""); printf "%s\t%s\n", c, $0 }' \
    | LC_ALL=C sort -t"$(printf '\t')" -k2
}
# The names the manifest lists that a run reached fewer times than it lists
# them: want<TAB>got<TAB>name, one a line, in the manifest's order. Both files
# are rows of count<TAB>name and both are read once. This was a loop over the
# manifest that ran an awk over the whole counts file for each of its ~6,800
# rows: 88 s of the gate's 1,565 on 2026-10-09, most of it fork and exec, for
# a comparison that is one pass. A name is what follows a row's first tab on
# both sides and is compared as bytes, so a backslash, a bracket or a tab in
# it is itself. A row that lists no name, or whose count is not a number,
# lists nothing to reach.
_manifest_short() {   # manifest counts
  LC_ALL=C awk -F'\t' '
    function name(line) { sub(/^\t+/, "", line); if (!sub(/^[^\t]*\t+/, "", line)) return ""; sub(/\t+$/, "", line); return line }
    function count(line) { sub(/^\t+/, "", line); sub(/\t.*$/, "", line); return line }
    FILENAME == ARGV[1] { got[name($0)] = count($0); next }
    { n = name($0); w = count($0) }
    n == "" || w !~ /^[0-9]+$/ { next }
    { g = (n in got) ? got[n] : 0 }
    g + 0 < w + 0 { printf "%s\t%s\t%s\n", w, g, n }
  ' "$2" "$1"
}
ok()   { PASS=$((PASS+1)); _ran "$1"; printf '  ok    %s\n' "$1"; }
bad()  { FAIL=$((FAIL+1)); _ran "$1"; printf '  FAIL  %s\n' "$1"; [ -n "${2:-}" ] && printf '        %s\n' "$2"; }
is()   { [ "$2" = "$3" ] && ok "$1" || bad "$1" "expected [$3] got [$2]"; }
has()  { case "$2" in *"$3"*) ok "$1" ;; *) bad "$1" "[$2] lacks [$3]" ;; esac; }
# Some assertions describe the machine, not Felix: whether a real plugin is
# installed depends on the claude CLI existing. Skipping is honest; passing them
# by accident on a runner that has no CLI would be worse than not running them.
#
# A skip counts as REACHED for the manifest above. The distinction that matters
# there is between an assertion the suite decided about and one it never got to.
SKIP=0
skip() { SKIP=$((SKIP+1)); _ran "$1"; printf '  skip  %s (%s)\n' "$1" "$2"; }
has_claude() { command -v claude >/dev/null 2>&1; }

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
FELIX_TEST_RAN="$TMP/ran"; : > "$FELIX_TEST_RAN"
# The manifest of assertions this suite is supposed to reach, beside the suite
# and tracked. Regenerated with `tests/run --record-assertions`, which is the
# one command that changes it, so the diff on every PR says plainly which
# assertions were added and which were removed. The same command runs
# tests/red, which writes red.tsv beside it: this suite against the engine the
# base ref holds, so "N fail against the previous engine" is a file in the
# tree and not a sentence in a pull request. Red starts with the record run, not
# after it: its suite needs this tree's manifest only for the comparison it
# makes once that suite has ended, so the two run side by side and the record
# run hands the manifest over with a mark file, `written` or `failed`. They ran
# one after the other until 2026-10-12, when the suite was 1429 s of the gate's
# 1565 s on a quiet machine. FELIX_TEST_NO_MANIFEST=1 is how that red run asks
# this suite not to compare itself against a manifest that describes another tree.
FELIX_TEST_MANIFEST="$HERE/assertions.tsv"
FELIX_TEST_RECORD=0; _rcp_reuse=0
while :; do case "${1:-}" in
  --record-assertions) FELIX_TEST_RECORD=1; shift ;;
  --reuse)             _rcp_reuse=1; shift ;;
  *)                   break ;;
esac; done
[ "$_rcp_reuse$FELIX_TEST_RECORD" = 11 ] && { printf 'tests/run: --reuse and --record-assertions do not go together\n' >&2; exit 2; }

# The receipt (receipt.sh) is what lets the gate ask for this run instead of
# making it: --reuse answers from the last passed run on this tree, or runs. A
# red run stands in the base's tree, reads and writes none, and so does not load
# the file, which red does not copy into the base.
_rcp_on=0; _rcp_cmp=0; _rcp_judged=0; _rcp_why=""
if [ "${FELIX_TEST_NO_MANIFEST:-0}" = "1" ]; then _rcp_why="this is a red run"
elif . "$HERE/receipt.sh" 2>/dev/null; then _rcp_on=1
else _rcp_why="no tests/receipt.sh beside this suite"; fi
[ "$_rcp_on" -eq 1 ] || [ "$_rcp_reuse" -eq 0 ] || printf 'not reused: %s\n' "$_rcp_why"
if [ "$_rcp_on" -eq 1 ]; then
  # $REAL_HARNESS/../.. with the dots resolved: felix_tree_id hashes untracked
  # files by the path it was handed, so the same tree spelled two ways is two ids.
  _rcp_root="$(cd "$REAL_HARNESS/../.." && pwd)"
  [ "$_rcp_reuse" -eq 0 ] || _rcp_answer "$_rcp_root"
  _rcp_begin "$_rcp_root"
fi
# Red starts here and not at the end: told where to find the mark and which
# process to watch (receipt.sh, "red, beside a record run": it is disowned, so a
# part's bare `wait` does not wait for it). Before the exports below, so its
# suite is made in an environment of its own, as a plain run's is.
_rcp_red=""
if [ "$FELIX_TEST_RECORD" -eq 1 ] && [ "$_rcp_on" -eq 1 ] && [ -x "$HERE/red" ]; then _rcp_red_start "$TMP/manifest.mark"; fi

# Memory has lived outside any checkout since 2026-08-14, so the fixture needs a
# root of its own rather than a directory inside the fixture home.
#
# Exported, and that is not a detail. This suite drives the real CLI and the real
# hooks as child processes; an unexported value would leave every one of them
# resolving felix_mem_root to the default and writing the fixture's invented
# projects into the developer's own memory — which is both a corrupted test and
# a corrupted record, and neither would announce itself.
MEM="$TMP/memory"
export FELIX_MEMORY="$MEM"
mkdir -p "$MEM"

# No session, as on the CI runner. The gate files each catch under the session
# its shell was given, and the Stop hook asks a session only about its own, so
# a suite run from inside a session would file every fixture's catch under
# that session and judge the hooks differently from CI. Cases that need one
# set it where they need it.
unset CLAUDE_CODE_SESSION_ID

# Every lib that writes memory calls felix_mem_dir, which resolve.sh defines and
# which the CLI and both hooks always source first. The subshells below source
# one lib at a time, so without this they run under a load order production
# never has. Worth stating because of how that fails: bash reports "command not
# found" on stderr, the append is redirected to /dev/null, and the assertion
# then reads as "memory was not written" — a wrong answer about the code rather
# than about the test. Functions defined here are inherited by every subshell.
. "$REAL_HARNESS/lib/resolve.sh"

# Every copy this suite takes of the real tree goes through here, and it copies
# CONTENT: what git tracks under the source, plus what is untracked and not
# ignored, because work not yet added is still work under test. What git
# ignores stays behind. `cp -R` copied a directory listing instead, residue
# included, and the fixtures below that commit such a copy as "main" and cut a
# cache entry from it then disagreed with themselves: measured 2026-09-19, a
# claude-flow hook had dropped .claude-flow/ into engine/harness — ignored, so
# git status stayed clean — and fifteen assertions failed, each leading with
# the judge and the plugin cache and carrying the directory's name only at the
# tail of a temporary path, which is where nobody reads. The mechanism, by
# experiment: the fixture's `git add -A` obeys the machine's GLOBAL excludes
# file, which named .claude-flow/, so the fixture's main left the stray out;
# the raw copy in the fixture's cache kept it; and the judge, which shuts the
# global file off on purpose, called the difference drift. A runner with no
# global excludes commits the stray on both sides and the judge, measured on
# that pair, reports nothing — so this was only ever red on a developer's
# machine. Production is not sensitive, measured at 0.49.122:
# felix_accepted_deploy_diff reads its source side from the commit, and
# felix_deploy_diff asks the repository's own ignore rules about the rest.
# It was sensitive once, and #86 is what ended that.
#
# --exclude-standard, global file included, deliberately: whatever this
# machine's git would refuse to add to a fixture is exactly what must not be
# carried into one.
#
# The git path is taken only when git TRACKS something under the source. "Is
# it inside a repository" is the wrong question, measured on the same day: the
# plugin cache, where a copy of this suite also sits, was inside a repository
# — a home directory under version control — that tracked none of it, and one ignore
# rule there would have listed an empty harness. Where git tracks nothing it
# has nothing to say, and the directory is copied whole, as it always was.
# A tracked file deleted from the working tree is listed by git and absent
# from disk, and it is skipped before tar is handed the list. Measured on
# bsdtar: tar does not stop on such a name — it archives the rest and exits
# non-zero — and under this suite's pipefail that exit becomes the copy's
# status, so a developer's unstaged deletion would read as a copy that
# failed. GNU tar was not there to measure; skipping means it is never asked.
_copy_content() {   # <source dir> <dest dir>: dest holds what source holds, less what git ignores
  local src="$1" dest="$2" f
  mkdir -p "$dest" || return 1
  if [ -n "$(git -C "$src" ls-files -c . 2>/dev/null | head -1)" ]; then
    ( cd "$src" && git ls-files -co --exclude-standard -z . \
        | while IFS= read -r -d '' f; do
            { [ -e "$f" ] || [ -L "$f" ]; } && printf '%s\0' "$f"
          done \
        | tar -c --null -T - -f - ) | tar -x -f - -C "$dest"
  else
    cp -R "$src/." "$dest/"
  fi
}

# ---------------------------------------------------------------- fixture ----
# A Felix root with the real harness and one invented project.
FROOT="$TMP/felix"
mkdir -p "$FROOT/projects/widget" "$MEM/widget"
_copy_content "$REAL_HARNESS" "$FROOT/harness"

cat > "$FROOT/projects/widget/project.json" <<'EOF'
{
  "name": "widget",
  "remote_match": "example.com/widget",
  "gate": "sh -c 'test -f WIDGET.txt && echo widget-gate-ran'"
}
EOF
printf '# widget\n' > "$FROOT/projects/widget/CLAUDE.md"

# One row, deliberately the most boring true thing about this checkout: the
# marker that binds it. It must never come back `blind`, or every merge
# assertion in this file would be measuring the probe rather than the merge —
# so it reads a file the fixture creates and keeps, and if something does
# remove it the honest answer is `empty`, which blocks nothing.
printf 'marker\t-\t-\tls -1 .felix\ttest -f .felix\n' \
  > "$FROOT/projects/widget/probes.tsv"
cp "$FROOT/projects/widget/probes.tsv" "$TMP/probes.keep"

# And one admitted obligation, for the same reason: the merge boundary refuses
# a project that has admitted nothing, so every merge assertion below would
# otherwise be measuring the empty ledger. Always applicable, discharged by a
# command that cannot fail, grounded on nothing — the least an obligation can
# be while still being one.
printf 'fixture\tRELEASE_BLOCKING\tdeterministic\t-\ttrue\t-\ta fixture owes one thing, and it holds\n' \
  > "$FROOT/projects/widget/obligations.tsv"
cp "$FROOT/projects/widget/obligations.tsv" "$TMP/obligations.keep"

# The same for commissioning: one row a person answers, whose check reads the
# marker the fixture keeps, so the merge boundary is measuring the merge and
# not this table. The receipt it needs is stamped by _cm_stamp beside every
# green gate receipt below, because both are keyed to the tables the tests
# hand-edit, and a receipt for the wrong tables is exactly what must block.
printf 'marker\t-\t-\t-\t-\ttest -f .felix\t9\n' > "$FROOT/projects/widget/commissioning.tsv"
cp "$FROOT/projects/widget/commissioning.tsv" "$TMP/commissioning.keep"
_cm_stamp() { ( _r="${1:-$REPO}"; cd "$_r" && FELIX_HOME_DIR="$FROOT"; . "$FROOT/harness/lib/commission.sh"
                _o="$(felix_commission_run "$FROOT/projects/widget" "$_r" -)"
                felix_commission_receipt_write "$FROOT" "$FROOT/projects/widget" "$_r" "$_o" "" >/dev/null ); }

FELIX="$FROOT/harness/felix"
# Pin the home. Resolution consults ~/.felix-home, so without this the suite
# runs against whatever the machine has installed, writes test projects into it,
# and reports failures about the wrong tree. Observed exactly that.
export FELIX_HOME="$FROOT"

# A checkout with NO git remote, bound by marker file alone.
REPO="$TMP/some-customer-repo"
mkdir -p "$REPO/deep/nested"
( cd "$REPO" && git init -q -b main )
# macOS resolves /var to /private/var, and git reports the resolved path. Compare
# against what the filesystem actually calls this directory, not what mktemp said.
REPO="$(cd "$REPO" && pwd -P)"
printf 'widget\n' > "$REPO/.felix"
printf 'contents\n'  > "$REPO/WIDGET.txt"

. "$HERE/parts/0010-resolution.sh"
. "$HERE/parts/0020-adopting-over-a-capabilities-entry-that-is-n.sh"
. "$HERE/parts/0030-appends-onto-a-hand-written-last-line.sh"
. "$HERE/parts/0040-an-unterminated-last-line-that-cannot-be-end.sh"
. "$HERE/parts/0050-appends-that-fail-paths-that-are-not-files-a.sh"
. "$HERE/parts/0060-a-partial-backfill-a-pipe-at-a-table-and-a-m.sh"
. "$HERE/parts/0070-stack-provisioning.sh"
. "$HERE/parts/0080-risk-classification.sh"
. "$HERE/parts/0090-what-a-revert-cannot-undo.sh"
. "$HERE/parts/0100-merging.sh"
. "$HERE/parts/0110-a-base-ref-that-is-behind-its-remote.sh"
. "$HERE/parts/0120-scheduled-maintenance.sh"
. "$HERE/parts/0130-only-the-gate-workflow-is-evidence.sh"
. "$HERE/parts/0140-the-unattended-repair-acts-only-on-a-brief.sh"
. "$HERE/parts/0150-the-unattended-repair-leaves-the-model-no-cr.sh"
. "$HERE/parts/0160-unattended-readiness.sh"
. "$HERE/parts/0170-mistakes-record-themselves.sh"
. "$HERE/parts/0180-fresh-repositories-split-mistakes-rows-heal.sh"
. "$HERE/parts/0190-continued.sh"
. "$HERE/parts/0200-generated-constitution.sh"
. "$HERE/parts/0210-the-completion-gate.sh"
. "$HERE/parts/0220-the-binding-itself.sh"
. "$HERE/parts/0230-the-intent-router.sh"
. "$HERE/parts/0240-continued.sh"
. "$HERE/parts/0250-on-path-via-a-symlink.sh"
. "$HERE/parts/0260-a-failure-nobody-wrote-down.sh"
. "$HERE/parts/0270-unrecorded-catches-per-checkout-blind.sh"
. "$HERE/parts/0280-unrecorded-catches-settled-by-their-writer-b.sh"
. "$HERE/parts/0290-noticing-when-another-plugin-breaks-the-sess.sh"
. "$HERE/parts/0300-discovery-reads-what-the-prose-and-the-scrip.sh"
. "$HERE/parts/0310-discovery-follows-what-the-plugin-manifest-d.sh"
. "$HERE/parts/0320-discovery-reads-a-download-piped-into-a-shel.sh"
. "$HERE/parts/0330-one-rollup-one-file.sh"
. "$HERE/parts/0340-the-line-that-does-the-work.sh"
. "$HERE/parts/0350-what-it-verified-and-what-it-merges-are-the.sh"
. "$HERE/parts/0360-what-felix-merge-records-and-what-it-hands-g.sh"
. "$HERE/parts/0370-a-receipt-that-cannot-claim-more-than-it-kno.sh"
. "$HERE/parts/0380-the-reconciler-reads-the-record-reached-besi.sh"

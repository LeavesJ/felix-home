  chmod 600 "$IBS7OF"
  is  "inventory M4-B7b: read, no record names w8, so PR #8's owner is - and it is not live (the control)" \
      "$(_ibcol S7OR pr '#8' 5) $(_ibmany S7OR pr '#8' live unknown:live)" "- live=no unknown:live=no"
  is  "inventory M4-B7b: with the one session file in the window unread, PR #8's owner is unknown, not -, and its live is unknown" \
      "$(_ibcol S7OT pr '#8' 5) $(_ibmany S7OT pr '#8' live unknown:live)" "unknown live=no unknown:live=yes"
fi

# M4-B3 (section 5.2 "Missing commit objects", 4.3 rule 4): s3's branch wl adds
# f.txt and was never pushed; main later gained the same f.txt by a commit of
# its own, so wl's blobs are main's and rule 3 alone reads it landed. With the
# stand-in's walk dying for wl's tip, wl's own walk could not be made: its
# content is unknown, it is never landed, and unpushed is unknown (mutants
# B3b, B3c).
_ibnew s3
_ibmk - "$IB/s3" "$(_ibq -C "$IB/s3" rev-parse main)" 'wl adds f' f.txt 'the same f'; _ibg -C "$IB/s3" branch -q wl "$IBC"; IBS3W="$IBC"
printf 'the same f\n' > "$IB/s3/f.txt"; _ibci "$IB/s3" 'main gains f'; _ibg -C "$IB/s3" push -q origin main
_ibrun S3R -- inventory --repo "$IB/s3" --tsv --no-gh --no-host
_ibrun S3T --path "$IBFGP" --env "IBFG=walk=$IBS3W" -- inventory --repo "$IB/s3" --tsv --no-gh --no-host
is  "inventory M4-B3: walked, wl's blobs are main's, so its content is landed and nothing is unpushed (the control)" \
    "$(_ibcol S3R branch wl 7) $(_ibmany S3R branch wl unpushed unknown:unpushed)" "landed unpushed=no unknown:unpushed=no"
is  "inventory M4-B3: when wl's own walk dies, its content is unknown, never landed by blob equality, and unpushed is unknown, not no" \
    "$(_ibcol S3T branch wl 7) $(_ibmany S3T branch wl landed unpushed unknown:unpushed)" "unknown landed=no unpushed=no unknown:unpushed=yes"

# M4-B3m (section 4.3 rules 2 and 4): in s3m, PR #11 merged into main with head
# H1, whose parent is b1's tip; b2 is a branch of its own, on no PR. Then PR #12
# merges too, its head H2 a commit whose parent this clone lacks, so the merged
# heads cannot be walked together. H1's history still can: b1 stays landed
# (mutant B3d). H2's cannot, and b2 might be in it: b2 is unknown, not not (B3e).
_ibnew s3m
_ibg -C "$IB/s3m" remote set-url origin git@github.com:acme/s3m.git
IBS3MM="$(_ibq -C "$IB/s3m" rev-parse main)"
_ibmk - "$IB/s3m" "$IBS3MM" 'm1 first' m1.txt 'first'; _ibg -C "$IB/s3m" branch -q b1 "$IBC"
_ibmk - "$IB/s3m" "$IBC" 'm1 second' m1b.txt 'second'; IBS3H1="$IBC"
_ibmk - "$IB/s3m" "$IBS3MM" 'b2 alone' b2.txt 'b2'; _ibg -C "$IB/s3m" branch -q b2 "$IBC"
IBS3H2="$(printf 'tree %s\nparent 1111111111111111111111111111111111111111\nauthor F <f@example.invalid> 1700000000 +0000\ncommitter F <f@example.invalid> 1700000000 +0000\n\nhead of #12\n' \
  "$(_ibq -C "$IB/s3m" rev-parse 'main^{tree}')" | _ibg -C "$IB/s3m" hash-object -t commit -w --literally --stdin)"
mkdir -p "$IB/gh/acme_s3m"; printf '[]\n' > "$IB/gh/acme_s3m/open.json"
_ibs3pr() { printf '{"baseRefName":"main","headRefName":"%s","headRefOid":"%s","isCrossRepository":false,"number":%s,"state":"MERGED","updatedAt":"%s"}' "$1" "$2" "$3" "$(_ibts 600)"; }
printf '[%s]\n' "$(_ibs3pr m1 "$IBS3H1" 11)" > "$IB/gh/acme_s3m/all.json"
_ibrun S3MR -- inventory --repo "$IB/s3m" --tsv --no-host
printf '[%s,%s]\n' "$(_ibs3pr m1 "$IBS3H1" 11)" "$(_ibs3pr m2 "$IBS3H2" 12)" > "$IB/gh/acme_s3m/all.json"
_ibrun S3MT -- inventory --repo "$IB/s3m" --tsv --no-host
is  "inventory M4-B3m: with only PR #11 merged, b1 (its head's parent) is landed and b2 is not (the control)" \
    "$(_ibcol S3MR branch b1 7) $(_ibcol S3MR branch b2 7)" "landed not"
is  "inventory M4-B3m: with PR #12's head unwalkable beside it, b1 is still landed through #11's head, and b2 is unknown, not not" \
    "$(_ibcol S3MT branch b1 7) $(_ibcol S3MT branch b2 7)" "landed unknown"

# M4-B8 (section 5.2 "The staged-revert check", 4.4): four linked worktrees of
# s8, each on its own branch with a change staged. In each, a read the check
# needs fails, and the answer is unknown:hazard:staged-revert, not no:
#   r8b  git log -g dies after printing the whole reflog (the stand-in; mutant B8b)
#   r8c  the index cannot be read (mode 000; B8c)
#   r8d  a reflog entry's tree is not in the clone (B8d)
#   r8e  the index is the tree of an earlier tip c1 whose parent the clone
#        lacks, so whether c1 comes before HEAD cannot be told (B8e)
_ibnew s8
for _ibn in r8b r8c r8d r8e; do _ibg -C "$IB/s8" worktree add -q -b "$_ibn" "$IB/s8/.claude/worktrees/$_ibn"; done
IBS8="$IB/s8/.claude/worktrees"
for _ibn in r8b r8c r8d; do printf '%s\n' "$_ibn" > "$IBS8/$_ibn/n.txt"; _ibci "$IBS8/$_ibn" "$_ibn commits"; printf 'staged\n' >> "$IBS8/$_ibn/n.txt"; _ibg -C "$IBS8/$_ibn" add n.txt; done
_ibx="$(printf 'tree 2222222222222222222222222222222222222222\nparent %s\nauthor F <f@example.invalid> 1700000000 +0000\ncommitter F <f@example.invalid> 1700000000 +0000\n\na tip whose tree the clone lacks\n' \
  "$(_ibq -C "$IB/s8" rev-parse main)" | _ibg -C "$IB/s8" hash-object -t commit -w --literally --stdin)"
IBS8D="$(_ibq -C "$IBS8/r8d" rev-parse HEAD)"
_ibg -C "$IBS8/r8d" update-ref -m 'to a tip whose tree is gone' refs/heads/r8d "$_ibx"
_ibg -C "$IBS8/r8d" update-ref -m 'back' refs/heads/r8d "$IBS8D"
printf 'r1\n' > "$IBS8/r8e/r"; _ibg -C "$IBS8/r8e" add r
IBS8C1="$(printf 'tree %s\nparent 1111111111111111111111111111111111111111\nauthor F <f@example.invalid> 1700000000 +0000\ncommitter F <f@example.invalid> 1700000000 +0000\n\nc1\n' \
  "$(_ibq -C "$IBS8/r8e" write-tree)" | _ibg -C "$IB/s8" hash-object -t commit -w --literally --stdin)"
_ibg -C "$IBS8/r8e" reset -q --hard "$IBS8C1"
printf 'r2\n' > "$IBS8/r8e/r"; _ibci "$IBS8/r8e" c2; _ibg -C "$IBS8/r8e" read-tree "$IBS8C1"
_ibrun S8R -- inventory --repo "$IB/s8" --tsv --no-gh --no-host
IBS8CI="$(_ibq -C "$IBS8/r8c" rev-parse --git-path index)"; case "$IBS8CI" in /*) ;; *) IBS8CI="$IBS8/r8c/$IBS8CI" ;; esac
chmod 000 "$IBS8CI"
if [ -r "$IBS8CI" ]; then _ibs8ro=0; else _ibs8ro=1; fi
_ibrun S8T --path "$IBFGP" --env IBFG=logg=refs/heads/r8b -- inventory --repo "$IB/s8" --tsv --no-gh --no-host
chmod 644 "$IBS8CI"
_ibs8() { _ibmany "$1" worktree "$IBS8/$2" hazard:staged-revert unknown:hazard:staged-revert; }
is  "inventory M4-B8: read whole, r8b and r8c stage a change that is no earlier tip, so neither holds the hazard nor an unknown (the control)" \
    "$(_ibs8 S8R r8b) $(_ibs8 S8R r8c)" \
    "hazard:staged-revert=no unknown:hazard:staged-revert=no hazard:staged-revert=no unknown:hazard:staged-revert=no"
is  "inventory M4-B8b: a git log -g that dies, though it printed every entry, leaves the check unknown, not no hazard" \
    "$(_ibs8 S8T r8b)" "hazard:staged-revert=no unknown:hazard:staged-revert=yes"
if [ "$_ibs8ro" = 1 ]; then
  is  "inventory M4-B8c: an index the run cannot read leaves the check unknown, not no hazard" \
      "$(_ibs8 S8T r8c)" "hazard:staged-revert=no unknown:hazard:staged-revert=yes"
else skip "inventory M4-B8c: an index the run cannot read leaves the staged-revert check unknown" "a mode 000 file is readable here (run as root?)"; fi
is  "inventory M4-B8d: a reflog entry whose tree the clone lacks could not be compared with the index: unknown, not no hazard" \
    "$(_ibs8 S8T r8d)" "hazard:staged-revert=no unknown:hazard:staged-revert=yes"
is  "inventory M4-B8e: an index holding the tree of an earlier tip whose order against HEAD cannot be read is unknown, not a decided hazard" \
    "$(_ibs8 S8T r8e)" "hazard:staged-revert=no unknown:hazard:staged-revert=yes"

# M4-R4 (section 5.2 "Chips and unreadable session files", R4): the chips
# cover row counts the unreadable session files later than a chip's proposal,
# and says the count only when a chip was left unknown.
# r4c: chip 4c proposed 180 minutes ago; two unreadable files elsewhere under
# the root, one written 181 minutes ago (before the proposal), one 60 (after
# it). 4c is unknown, and the count is 1, not 2 (mutant R4c).
_ibnew r4c
IBR4CR="$(_ibmainwt "$IB/r4c")"
IB_BR=""; _ibsess "$IBR4CR" s-r4c
_ib_h 182 'file one follow-up'
_ib_chip 180 toolu_r4c task_4c4c4c4c 'Chip four c' 'Four-c task: make the parser reject a key given twice, and test that the error names the key.'
_ib_a 179 'Filed.'; _ibage "$IB_F" 179
_ibopen "$IBP/-elsewhere-r4c/s-r4c1.jsonl" s-r4c1; _ib_h 182 'an unrelated look'; _ib_a 181 'Done.'; _ibage "$IB_F" 181; IBR4C1="$IB_F"
_ibopen "$IBP/-elsewhere-r4c/s-r4c2.jsonl" s-r4c2; _ib_h 61 'another unrelated look'; _ib_a 60 'Done.'; _ibage "$IB_F" 60; IBR4C2="$IB_F"
# r4d: chip 4d1 proposed 180 minutes ago and started 120 minutes ago by a
# readable session; chip 4d2 proposed 30 minutes ago; one unreadable file
# written 60 minutes ago. It is later than 4d1's proposal, but 4d1 was started
# and 4d2 came after it, so no chip is unknown and the row says no count (R4d).
_ibnew r4d
IBR4DR="$(_ibmainwt "$IB/r4d")"
IB_BR=""; _ibsess "$IBR4DR" s-r4d
_ib_h 182 'file two follow-ups'
_ib_chip 180 toolu_r4d1 task_4d1d1d1d 'Chip four d one' 'Four-d-one task: make the cache drop entries older than a day, and test the boundary second.'
_ib_chip 30 toolu_r4d2 task_4d2d2d2d 'Chip four d two' 'Four-d-two task: make the logger flush on exit, and test that a killed run keeps its last line.'
_ib_a 29 'Filed both.'; _ibage "$IB_F" 29
_ibopen "$IBP/-elsewhere-r4d/s-r4dgo.jsonl" s-r4dgo
_ib_h 121 'Four-d-one task: make the cache drop entries older than a day, and test the boundary second.'; _ib_a 120 'On it.'; _ibage "$IB_F" 120
_ibopen "$IBP/-elsewhere-r4d/s-r4dx.jsonl" s-r4dx; _ib_h 61 'look at something unrelated'; _ib_a 60 'Done.'; _ibage "$IB_F" 60; IBR4DX="$IB_F"
_ibrun R4CR -- inventory --repo "$IB/r4c" --tsv --no-gh; _ibrun R4DR -- inventory --repo "$IB/r4d" --tsv --no-gh
# One fixture's files unreadable at a time: each is under the records root, so it counts for every run.
chmod 000 "$IBR4C1" "$IBR4C2"
if [ -r "$IBR4C2" ]; then
  chmod 600 "$IBR4C1" "$IBR4C2"
  skip "inventory M4-R4: the chips cover row's count of unreadable session files" "a mode 000 file is readable here (run as root?)"
else
  _ibrun R4CT -- inventory --repo "$IB/r4c" --tsv --no-gh
  chmod 600 "$IBR4C1" "$IBR4C2"; chmod 000 "$IBR4DX"
  _ibrun R4DT -- inventory --repo "$IB/r4d" --tsv --no-gh
  chmod 600 "$IBR4DX"
  is  "inventory M4-R4c: read, chip 4c is chip-unstarted and the chips cover row says nothing unread (the control)" \
      "$(_ibmany R4CR chip task_4c4c4c4c chip-unstarted unknown:chip-unstarted) $(_ibcol R4CR cover chips 8 | _ibsaid 'could not be read')" \
      "chip-unstarted=yes unknown:chip-unstarted=no unsaid"
  is  "inventory M4-R4c: an unreadable file written after 4c's proposal makes it unknown, and the count is of files later than a proposal: 1, not the 2 unreadable in the scan's window" \
      "$(_ibmany R4CT chip task_4c4c4c4c chip-unstarted unknown:chip-unstarted) $(_ibhaselem R4CT cover chips '1 session files could not be read') $(_ibhaselem R4CT cover chips '2 session files could not be read')" \
      "chip-unstarted=no unknown:chip-unstarted=yes yes no"
  is  "inventory M4-R4d: read, chip 4d1 was started (no row) and 4d2 is chip-unstarted (the control)" \
      "$(_ibcount R4DR chip) $(_ibmany R4DR chip task_4d2d2d2d chip-unstarted unknown:chip-unstarted)" "1 chip-unstarted=yes unknown:chip-unstarted=no"
  is  "inventory M4-R4d: when the one unreadable file left no chip unknown (4d1 started, 4d2 proposed after it), the chips cover row says no count" \
      "$(_ibcount R4DT chip) $(_ibmany R4DT chip task_4d2d2d2d chip-unstarted unknown:chip-unstarted) $(_ibcol R4DT cover chips 8 | _ibsaid 'could not be read')" \
      "1 chip-unstarted=yes unknown:chip-unstarted=no unsaid"
fi

# M4-CDPATH (build/disputes.md 2): the engine changes directory by .git, the
# relative name git rev-parse --git-common-dir prints in a main worktree. With
# CDPATH naming a directory that holds a .git of its own, a cd that followed it
# would read another directory: g2's linked worktree as another repository's,
# and its orphan as unread. G2's decoys carry the orphan's names, not .git.
mkdir -p "$IB/cdp2/.git"
_ibrun G2U --env "CDPATH=$IB/cdp2" -- inventory --repo "$IB/g2" --tsv --no-gh --no-host
is  "inventory M4-CDPATH: with CDPATH naming a directory that holds a .git, the orphan keep2 still reads not, never landed, 1 of 1, and live2 is read as g2's own" \
    "$(_ibg2 G2U) $(_ibcol G2U worktree "$IB/g2/.claude/worktrees/live2" 8 | _ibsaid 'another repository')" "not no counted unsaid"

# ---- §4.1: across every run ----------------------------------------------
_ibx=""; for _ibk in RUN1 RUN2 RUN3 RUN4 MISC PART K R3 U F G H1 H2 O1 V1 T1 T3 M1 A5a A5b A5c A27 A31a A31b CCD; do _ibx="$_ibx $(_ibo "$_ibk")"; done
is  "inventory N16: no row in any run is landed while its content is not, partly or unknown" \
    "$(LC_ALL=C awk -F'\t' '$1 != "cover" && index("," $4 ",", ",landed,") && ($7 == "not" || $7 == "partly" || $7 == "unknown") { printf "%s %s [%s] %s; ", $1, $3, $4, $7 } $1 != "cover" { n++ } END { if (n < 20) printf "only %d rows", n }' $_ibx)" ""

# ---- §1, §9: the libraries -----------------------------------------------
IB_LIBS="inventory.sh inventory-items.sh inventory-gh.sh inventory-orphans.sh inventory-host.sh inventory-view.sh"
_ibcode() { LC_ALL=C awk '!/^[[:space:]]*#/ { f = FILENAME; sub(/.*\//, "", f); print f ":" FNR ":" $0 }' "$@"; }
_ibmissing() { local f m=""; for f in $IB_LIBS; do [ -f "$IBL/$f" ] || m="$m $f"; done; printf '%s' "${m:+missing:$m}"; }
_iblibs() { local f; for f in $IB_LIBS; do [ -f "$IBL/$f" ] && printf '%s\n' "$IBL/$f"; done; }
is  "inventory A109: the six inventory libraries exist and each is under 500 lines" \
    "$(_ibmissing)$(for _ibf in $(_iblibs); do [ "$(LC_ALL=C awk 'END { print NR }' "$_ibf")" -lt 500 ] || printf ' %s is long' "${_ibf##*/}"; done)" ""
is  "inventory RV9: the view's header comment names no landing actor as a reader of the rows (spec section 11 row 19), and the file is there to be read" \
    "$([ -f "$IBL/inventory-view.sh" ] && LC_ALL=C awk 'index(tolower($0), "landing actor") { printf "line %d; ", FNR } END { if (!NR) printf "empty" }' "$IBL/inventory-view.sh" || printf 'missing')" ""
is  "inventory RV9: and its leading comment block, there to be read, says none of landing, lander or step 8" \
    "$([ -f "$IBL/inventory-view.sh" ] && LC_ALL=C awk 'FNR == 1 && /^#!/ { next } /^[[:space:]]*#/ { c++; l = tolower($0); if (index(l, "landing") || index(l, "lander") || index(l, "step 8")) printf "line %d; ", FNR; next } /^[[:space:]]*$/ { next } { exit } END { if (!c) printf "no header comment" }' "$IBL/inventory-view.sh" || printf 'missing')" ""
is  "inventory A110: no inventory library uses a here-document or here-string, jq, python, node or claude" \
    "$(_ibmissing)$(_iblibs | while IFS= read -r _ibf; do _ibcode "$_ibf"; done | LC_ALL=C awk '{ s = $0; gsub(/\$\(\([^)]*\)\)/, "", s)
       if (index(s, "<<")) printf "%s heredoc; ", substr($0, 1, index($0, ":") - 1)
       if (s ~ /(^|[^A-Za-z0-9_.-])(jq|python3?|node)([^A-Za-z0-9_-]|$)/) printf "%s parser; ", substr($0, 1, index($0, ":") - 1)
       if (s ~ /(^|[;&|(`]|then|do|else)[[:space:]]*claude[[:space:]]/) printf "%s claude; ", substr($0, 1, index($0, ":") - 1) }')" ""
is  "inventory A111: the host adapter runs no git" \
    "$(_ibmissing)$([ -f "$IBL/inventory-host.sh" ] && _ibcode "$IBL/inventory-host.sh" | LC_ALL=C awk -F: '{ s = $0; sub(/^[^:]*:[^:]*:/, "", s) } s ~ /(^|[;&|(`{]|then|do|else|\$\()[[:space:]]*(command[[:space:]]+)?git[[:space:]]/ { printf "line %s; ", $2 }')" ""
is  "inventory A111: no hook and no other library names the inventory, and felix names felix_inventory only after audit's early arm" \
    "$(_ibmissing)$(for _ibf in "$REAL_HARNESS"/hooks/* "$IBL"/*.sh; do case "${_ibf##*/}" in (inventory*.sh) continue ;; esac
       [ -f "$_ibf" ] && LC_ALL=C awk -v f="${_ibf##*/}" '/inventory\.sh|inventory-|felix_inventory/ { printf "%s:%d; ", f, FNR; exit }' "$_ibf"; done)$(LC_ALL=C awk '/^[[:space:]]*if \[ "\$\{1:-\}" = "audit" \]/ { a = NR } /felix_inventory/ { if (!a || NR <= a || NR > a + 15) printf "felix:%d; ", NR; n++ } END { if (!n) printf "felix names no felix_inventory" }' "$REAL_HARNESS/felix")" ""
_ibnames="elenchus felix-home widget behaviorchangebench"
for _ibd in "$REAL_HARNESS"/../../projects/*/; do [ -d "$_ibd" ] || continue; _ibn="${_ibd%/}"; _ibn="${_ibn##*/}"; [ "$_ibn" = felix ] || _ibnames="$_ibnames $_ibn"; done
is  "inventory A112: the inventory libraries name no project" \
    "$(_ibmissing)$(_iblibs | while IFS= read -r _ibf; do LC_ALL=C awk -v names="$_ibnames" -v f="${_ibf##*/}" 'BEGIN { n = split(tolower(names), w, " ") } { l = tolower($0); for (i = 1; i <= n; i++) if (index(l, w[i])) { printf "%s:%d names %s; ", f, FNR, w[i]; next } }' "$_ibf"; done)" ""
_ibx="$(grep -E 'bad substitution|syntax error|unbound variable|command not found|invalid option|not a valid identifier|division by 0|awk: ' "$IB"/runs/*.err | LC_ALL=C awk 'NR <= 3' | tr '\n' ';')"
is  "inventory: no run of this section wrote a shell or awk error to stderr" "$_ibx" ""

printf '\nthe handoff, as sections: no two sessions write the same path\n'
# HANDOFF.md was one slot and one counter every session shared: write your
# section at the top with the next id, archive the one it replaces. With ten
# sessions at once, four pull requests claimed one id inside an hour, and each
# landing after the first was a hand re-cut that could re-archive or drop a
# section. A session now adds its section as a file of its own under
# docs/handoff/pending/, and the id, the archive move, the index row and the
# marker are derived from the order the files landed on main (lib/handoff.sh).
# The fixture is a checkout with a remote-tracking main moved by hand, and a
# landing is a squash onto main, which is what the merge boundary does.
HX="$TMP/handoff"; mkdir -p "$HX/docs/handoff"
( cd "$HX" && git init -q -b main && git config user.name t && git config user.email t@example.invalid )
printf 'widget\n' > "$HX/.felix"
cat > "$HX/HANDOFF.md" <<'EOF'
# Handoff

Write your section with felix handoff --section; the fold gives it the next id
(after 0bb comes 0bc).

---

## 0. Standing

Unchanged; read docs/handoff/0.md.

---

## Current state

### 0bb. the session before

What it did.

---

## Index of earlier sections

| § | Section |
|---|---|
| [0](docs/handoff/0.md) | Standing |
| [0ba](docs/handoff/0ba.md) | the one before that |
| [1](docs/handoff/1.md) | the oldest |
EOF
printf '## 0. Standing\n\nThe standing decision.\n\n' > "$HX/docs/handoff/0.md"
printf '### 0ba. the one before that\n\nIts body.\n' > "$HX/docs/handoff/0ba.md"
printf '## 1. the oldest\n\nIts body.\n\n' > "$HX/docs/handoff/1.md"
git -C "$HX" add -A && git -C "$HX" commit -q -m base && git -C "$HX" update-ref refs/remotes/origin/main HEAD
_hx()     { ( cd "$HX" && . "$REAL_HARNESS/lib/handoff.sh" && "$@" ); }
_hx_chk() { _hx felix_handoff_check "$HX" "${1:-refs/remotes/origin/main}"; }
_hx_on()  { git -C "$HX" checkout -q -B "$1" "${2:-refs/remotes/origin/main}"; }
_hx_commit() { git -C "$HX" add -A && git -C "$HX" commit -q -m "$1"; }
# A landing: squash the branch onto the remote-tracking main and move it.
_hx_land() {
  git -C "$HX" checkout -q --detach refs/remotes/origin/main \
    && git -C "$HX" merge -q --squash "$1" >/dev/null 2>&1 \
    && { git -C "$HX" diff --cached --quiet || git -C "$HX" commit -q -m "land $1"; } \
    && git -C "$HX" update-ref refs/remotes/origin/main HEAD
}
_hx_base="$(git -C "$HX" rev-parse HEAD)"

is  "the id after 0bv is 0bw, after 0bz 0ca, after 0z 0aa, and after 0zz 0aaa" \
    "$(for _i in 0bv 0bz 0z 0zz; do _hx felix_handoff_next_id "$_i"; done | tr '\n' ' ')" "0bw 0ca 0aa 0aaa "
_hx_chk >/dev/null; is "the handoff a fold could have written reads clean" "$?" "0"

# Session A writes its section, cut under the old rule with an id in the
# heading, and writes it again: one file, the id dropped.
_hx_on s/a
printf '### 0zz. what A did\n\nA ran first.\n\n' > "$TMP/ho-a.md"
_hxa="$(cd "$HX" && "$FELIX" handoff --section "$TMP/ho-a.md" 2>"$TMP/ho-a.err" | sed -n 's/^wrote //p')"
grep -qE '^docs/handoff/pending/[0-9]{8}T[0-9]{6}Z-s-a\.md$' <<<"$_hxa" \
  && ok  "felix handoff --section writes the section to docs/handoff/pending/<UTC time>-<branch>.md" \
  || bad "felix handoff --section writes the section to docs/handoff/pending/<UTC time>-<branch>.md" "wrote [$_hxa]"
is  "and drops the id its heading carried, since only the fold gives ids" "$(head -1 "$HX/$_hxa" 2>/dev/null)" "### what A did"
has "and says it dropped it" "$(cat "$TMP/ho-a.err")" "dropped the id 0zz"
printf '### what A did\n\nA ran first, and said so twice.\n' > "$TMP/ho-a.md"
_hxa2="$(_hx felix_handoff_section "$HX" "$TMP/ho-a.md" refs/remotes/origin/main)"
is  "a second --section on the same branch rewrites that file and makes no other" \
    "$_hxa2:$(ls "$HX/docs/handoff/pending" | wc -l | tr -d ' ')" "$_hxa:1"
# Its own file is the whole name, not the tail: branch x/s-a's ends in -s-a too.
printf '### x/s-a wrote this\n' > "$HX/docs/handoff/pending/20991231T235959Z-x-s-a.md"
_hx felix_handoff_section "$HX" "$TMP/ho-a.md" refs/remotes/origin/main >/dev/null
is  "and leaves a file named for a branch whose name only ends like this one's" \
    "$(head -1 "$HX/docs/handoff/pending/20991231T235959Z-x-s-a.md")" "### x/s-a wrote this"
rm -f "$HX/docs/handoff/pending/20991231T235959Z-x-s-a.md"
_hx_commit "A's section"
_hx_chk >/dev/null; is "a branch that only adds a pending section reads clean" "$?" "0"

# Session B, cut from the same main before A lands.
_hx_on s/b
printf '### what B did\n\nB ran second and landed first.\n' > "$TMP/ho-b.md"
_hxb="$(_hx felix_handoff_section "$HX" "$TMP/ho-b.md" refs/remotes/origin/main)"
_hx_commit "B's section"
is  "two sessions' handoff branches share no path" \
    "$(LC_ALL=C comm -12 <(git -C "$HX" diff --name-only "$_hx_base" s/a | sort) <(git -C "$HX" diff --name-only "$_hx_base" s/b | sort))" ""
_hx_land s/b; _hxl1=$?; _hx_land s/a; _hxl2=$?
is  "so both land, the second on top of the first, without a conflict" "$_hxl1:$_hxl2" "0:0"
_hx_chk >/dev/null; is "main with two sections waiting reads clean" "$?" "0"

# The fold. B landed first and so takes the next id, though A's file sorts
# first by name and was written first: the order is main's, not a claim.
_hx_on s/rot
_hxr="$(cd "$HX" && "$FELIX" handoff --rotate 2>&1)"; _hxrc=$?
is  "felix handoff --rotate folds and reads its work back clean" "$_hxrc" "0"
has "and says so" "$_hxr" "reads it back clean"
is  "the section that landed first takes the next id and is archived, as it would have been had it been folded alone" \
    "$(head -1 "$HX/docs/handoff/0bc.md" 2>/dev/null)" "### 0bc. what B did"
has "the one that landed last is current, with the id after it" "$(cat "$HX/HANDOFF.md")" "### 0bd. what A did"
is  "the section it replaced is archived exactly as it stood, its trailing blank line dropped" \
    "$(cat "$HX/docs/handoff/0bb.md" 2>/dev/null; printf x)" "$(printf '### 0bb. the session before\n\nWhat it did.\nx')"
has "the marker moves on to the id after the current one" "$(cat "$HX/HANDOFF.md")" "(after 0bd comes 0be)"
is  "the rows go in newest first, above the newest numbered row and below the standing one" \
    "$(_hx felix_handoff_rows "$HX/HANDOFF.md" | cut -f1 | tr '\n' ' ')" "0 0bc 0bb 0ba 1 "
is  "and the folded files are gone" "$(ls "$HX/docs/handoff/pending" 2>/dev/null | wc -l | tr -d ' ')" "0"
_hx_commit "fold"
_hxt="$(git -C "$HX" rev-parse HEAD^{tree})"
_hx_on s/rot2
_hx felix_handoff_rotate "$HX" refs/remotes/origin/main >/dev/null; _hx_commit "fold again"
is  "a second fold of the same main writes the same tree" "$(git -C "$HX" rev-parse HEAD^{tree})" "$_hxt"
_hx_land s/rot; _hxl1=$?; _hx_land s/rot2; _hxl2=$?
is  "so two sessions folding at once both land, and the second changes nothing" \
    "$_hxl1:$_hxl2:$(git -C "$HX" rev-parse HEAD^{tree})" "0:0:$_hxt"

# The old rule, done perfectly by hand: the next id, the archive, the row and
# the marker all correct. It is refused, because it is the shared slot that
# collided, whoever does it well.
_hx_on s/hand
cp "$HX/HANDOFF.md" "$TMP/ho-h.md"
awk '/^### 0bd\. /{ print "### 0be. written in by hand"; print ""; print "Mine."; print ""; skip = 1; next }
     skip && /^---$/ { skip = 0 } !skip { print }' "$TMP/ho-h.md" \
  | sed 's/(after 0bd comes 0be)/(after 0be comes 0bf)/' \
  | awk '/^\| \[0bc\]/ { print "| [0bd](docs/handoff/0bd.md) | what A did |" } { print }' > "$HX/HANDOFF.md"
_hx _felix_handoff_block "$TMP/ho-h.md" 0bd > "$HX/docs/handoff/0bd.md"
_hx_commit "by hand"
_hxc="$(_hx_chk)"; _hxcr=$?
is  "a section written into HANDOFF.md by hand is refused, however correct its id" "$_hxcr" "1"
has "and the refusal says how to add a section instead" "$_hxc" "felix handoff --section"
( cd "$HX" && "$REAL_HARNESS/bin/handoff-check" >/dev/null 2>&1 ); is "handoff-check exits 1 on it, which fails the gate" "$?" "1"
# And the shape a blind qualification control found first: a section written
# in above the current one, the marker, rows and archive all left alone.
_hx_on s/beside
awk '/^### 0bd\. /{ print "### 0be. written in beside it"; print ""; print "Mine."; print "" } { print }' \
  "$HX/HANDOFF.md" > "$TMP/ho-bs.md" && cp "$TMP/ho-bs.md" "$HX/HANDOFF.md"; _hx_commit "beside"
has "a section written in beside the current one, the marker left alone, is refused too" \
    "$(_hx_chk)" "section 0be sits in HANDOFF.md beside the current one"
# Two ways a hand rotation loses a section without a sign, both seen on
# 2026-09-24: another section put in place under the current id, and a
# rotation cut from an older main that archives its own stale copy.
_hx_on s/inplace
sed 's/^A ran first, and said so twice\.$/A ran first, and said so twice; corrected in place./' "$HX/HANDOFF.md" > "$TMP/ho-ip.md" \
  && cp "$TMP/ho-ip.md" "$HX/HANDOFF.md"; _hx_commit "in place"
_hx_chk >/dev/null; is "editing the current section in place, its heading kept, reads clean" "$?" "0"
_hx_on s/samid
sed 's/^### 0bd\. what A did$/### 0bd. what another session did/' "$HX/HANDOFF.md" > "$TMP/ho-si.md" \
  && cp "$TMP/ho-si.md" "$HX/HANDOFF.md"; _hx_commit "same id"
has "another section put in place under the current id is refused, since the one it replaced is lost" \
    "$(_hx_chk)" "headed differently than on the merge-base"
_hx_on s/stalehand s/hand
printf '### 0bd. what A did\n\nA ran first.\n' > "$HX/docs/handoff/0bd.md"; _hx_commit "stale"
has "and a hand rotation that archives a stale copy of the section says what it drops" \
    "$(_hx_chk)" "docs/handoff/0bd.md is not the section the merge-base holds as current"

_hx_on s/rewrite
printf '\nAn afterthought.\n' >> "$HX/docs/handoff/0ba.md"; _hx_commit "rewrite"
has "rewriting an archived section is refused" "$(_hx_chk)" "docs/handoff/0ba.md was rewritten"
_hx_on s/gone
git -C "$HX" rm -q docs/handoff/0bc.md; _hx_commit "gone"
has "and so is removing one" "$(_hx_chk)" "docs/handoff/0bc.md was archived and is gone"

# Two more sessions land; C lands before D.
for _s in c d; do
  _hx_on "s/$_s"; printf '### what %s did\n\nIts body.\n' "$_s" > "$TMP/ho-$_s.md"
  _hx felix_handoff_section "$HX" "$TMP/ho-$_s.md" refs/remotes/origin/main >/dev/null; _hx_commit "$_s"; _hx_land "s/$_s"
done
_hxc_path="$(git -C "$HX" ls-tree --name-only refs/remotes/origin/main docs/handoff/pending/ | grep -- '-s-c\.md$')"
_hxd_path="$(git -C "$HX" ls-tree --name-only refs/remotes/origin/main docs/handoff/pending/ | grep -- '-s-d\.md$')"
_hx_on s/drop
git -C "$HX" rm -q "$_hxc_path"; _hx_commit "drop"
has "removing a pending section without folding it is refused, since that drops it" "$(_hx_chk)" "which drops it"
_hx_on s/skip
printf '%s\n' "$_hxd_path" > "$TMP/ho-order"
_hx felix_handoff_fold "$HX" "$TMP/ho-order" >/dev/null; _hx_commit "skip"
has "folding a section ahead of one that landed before it is refused" "$(_hx_chk)" "not the 1 that landed first"

# A fold that main moved past before it landed: E lands while the fold of C
# and D waits. The fold is still exactly C and D, the oldest two, so the
# merge result reads clean and E waits for the next fold.
_hx_on s/stale
_hx felix_handoff_rotate "$HX" refs/remotes/origin/main >/dev/null; _hx_commit "fold c d"
_hx_on s/e; printf '### what e did\n\nIts body.\n' > "$TMP/ho-e.md"
_hx felix_handoff_section "$HX" "$TMP/ho-e.md" refs/remotes/origin/main >/dev/null; _hx_commit e; _hx_land s/e
git -C "$HX" checkout -q --detach refs/remotes/origin/main
git -C "$HX" merge -q --no-edit s/stale >/dev/null 2>&1; _hxm=$?
_hx_chk >/dev/null; _hxcr=$?
is  "a fold that main moved past merges and reads clean, and the section that landed after it waits" \
    "$_hxm:$_hxcr:$(ls "$HX/docs/handoff/pending" | grep -c -- '-s-e\.md$')" "0:0:1"
_hx felix_handoff_rotate "$HX" HEAD >/dev/null
has "and the next fold gives it the id after theirs" "$(cat "$HX/HANDOFF.md")" "### 0bg. what e did"
git -C "$HX" checkout -q -f --detach HEAD; git -C "$HX" clean -qfd

# The fold's own refusals: nothing written when one step would fail.
_hxfx="$TMP/handoff-fold"; mkdir -p "$_hxfx"
git -C "$HX" archive refs/remotes/origin/main | tar -x -C "$_hxfx"
printf '### 0bf. something else\n' > "$_hxfx/docs/handoff/0bf.md"
cp "$_hxfx/HANDOFF.md" "$TMP/ho-keep.md"
( cd "$_hxfx" && . "$REAL_HARNESS/lib/handoff.sh" && felix_handoff_pending_order "$_hxfx" > "$TMP/ho-o2" \
  && felix_handoff_fold "$_hxfx" "$TMP/ho-o2" ) > "$TMP/ho-fold.out"; _hxfr=$?
is  "the fold refuses to write over an archive that holds something else, and writes nothing" \
    "$_hxfr:$(cmp -s "$_hxfx/HANDOFF.md" "$TMP/ho-keep.md" && echo same):$(ls "$_hxfx/docs/handoff/pending" | wc -l | tr -d ' ')" "1:same:3"
has "and says an archived section is never rewritten" "$(cat "$TMP/ho-fold.out")" "never rewritten"

# The tree-local half, on the working tree alone.
_hx_on s/local
printf '### 0bz. an id\n\nbody\n' > "$HX/docs/handoff/pending/20260101T000000Z-x.md"
has "a pending section that carries an id is refused" "$(_hx_chk)" "carries an id"
git -C "$HX" checkout -q -f s/local; git -C "$HX" clean -qfd
sed 's/^### 0bd\. /### 0bx. /' "$HX/HANDOFF.md" > "$TMP/ho-m.md"; cp "$TMP/ho-m.md" "$HX/HANDOFF.md"
has "a current section the marker does not name is refused" "$(_hx_chk)" "is not headed"
git -C "$HX" checkout -q -f s/local
mkdir -p "$TMP/ho-none"; ( cd "$TMP/ho-none" && git init -q )
( cd "$TMP/ho-none" && "$REAL_HARNESS/bin/handoff-check" >/dev/null 2>&1 ); is "handoff-check cannot examine a checkout with no HANDOFF.md, and says 2, never 0" "$?" "2"
( cd "$HX" && "$REAL_HARNESS/bin/handoff-check" >/dev/null 2>&1 ); is "and exits 0 on a clean one" "$?" "0"
# Called by a path relative to a subdirectory, as `cd docs &&
# ../engine/harness/bin/handoff-check` does. dirname "$0" is relative to where
# it was called, so read after the move to the top it names a directory that is
# not there, the library never loads, and the run ends 127. The harness is
# reached through a link beside the fixture, so the same relative path read
# from the top names a directory one level too high and cannot pass by chance.
ln -s "$REAL_HARNESS" "$TMP/hxh"
( cd "$HX/docs" && ../../hxh/bin/handoff-check >/dev/null 2>&1 )
is  "and exits 0 on it called by a relative path from a subdirectory, finding its library from where it was called" "$?" "0"

printf '\na handoff fold already in flight is named, so a second session does not start one\n'
# The handoff upkeep row fell due for every session at once, and with ~20
# running, three folded the same pending set (#347, #351, #377) where only one
# could land. felix_handoff_in_flight (lib/handoff.sh) reads the remote-tracking
# refs as last fetched and names each branch that has already folded what main
# holds now; bin/handoff-in-flight says the same to a person and exits as grep
# does, so a maintenance check can end in it.
#
# One fixture repository with no remote configured: remote-tracking refs are
# written with update-ref, and every commit's committer time is set, so a tip's
# age is a fact of the fixture and not of when the suite happened to run.
# Remotes: origin holds main (its handoff at 0cg) and every case that must or
# must not count; ord1..ord3 hold fold order alone; calm holds nothing in
# flight; upstream holds a fold that belongs to another remote; age, built just
# before it is read, holds tips of chosen ages for the human line.
_bif_r="$TMP/bif-inflight"; mkdir -p "$_bif_r/docs/handoff/pending"
( cd "$_bif_r" && git init -q -b main && git config user.name t \
    && git config user.email t@example.invalid && git config commit.gpgsign false )
_bif_now="$(date +%s)"
_bif_git() { git -C "$_bif_r" "$@"; }
_bif_ago() { printf '%s' "$((_bif_now - $1))"; }
# HANDOFF.md with the marker `(after $1 comes $2)` in its preamble and, given a
# third argument, that phrase quoted again lower down, as a section may.
_bif_ho() {
  { printf '# Handoff\n\nWrite your section with felix handoff --section; the fold gives it the next id\n(after %s comes %s).\n\n---\n\n## Current state\n\n### %s. the current section\n\nIts body.\n' "$1" "$2" "$1"
    [ -n "${3:-}" ] && printf '\nA section may quote the rule, as in %s.\n' "$3"
    printf '\n---\n'; } > "$_bif_r/HANDOFF.md"
}
_bif_at() { _bif_git checkout -q --detach "$1"; }
# Commits the tree as it stands at committer time <epoch>, and prints the commit.
_bif_commit() {
  _bif_git add -A
  GIT_COMMITTER_DATE="@$1 +0000" GIT_AUTHOR_DATE="@$1 +0000" _bif_git commit -q --allow-empty -m "$2" \
    && _bif_git rev-parse HEAD
}
# A fold: cut from <base>, the marker moved to <id> (next <next>), tip at <epoch>.
_bif_fold() { _bif_at "$1" && _bif_ho "$2" "$3" "${5:-}" && _bif_commit "$4" "fold to $2"; }
_bif_pub() { _bif_git update-ref "refs/remotes/$1" "$2"; }

# main's history: M0 held 0ce; the fold to 0cg landed as M1; M2 took only a
# pending section, so main's handoff has not moved since M1.
_bif_ho 0ce 0cf
printf '### a section waiting\n\nIts body.\n' > "$_bif_r/docs/handoff/pending/20260101T000000Z-a.md"
_bif_M0="$(_bif_commit "$(_bif_ago 864000)" 'main, its handoff at 0ce')"
_bif_ho 0cg 0ch; rm -f "$_bif_r/docs/handoff/pending/20260101T000000Z-a.md"
_bif_M1="$(_bif_commit "$(_bif_ago 432000)" 'the fold to 0cg lands')"
printf '### b section waiting\n\nIts body.\n' > "$_bif_r/docs/handoff/pending/20260102T000000Z-b.md"
_bif_M2="$(_bif_commit "$(_bif_ago 345600)" 'a pending section lands')"
_bif_pub origin/main "$_bif_M2"
_bif_git symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main

# In flight. Names, ids and tip times are chosen so that newest-first differs
# from name order and from id order, and one name holds two slashes.
_bif_pub origin/claude/handoff-fold-1001 "$(_bif_fold "$_bif_M2" 0cj 0ck "$(_bif_ago 2730)")"
# Cut from M1, before main took a pending section: its merge-base is not main's
# tip, but holds main's handoff as it is now, so it is in flight all the same.
_bif_pub origin/claude/a/older-base      "$(_bif_fold "$_bif_M1" 0ci 0cj "$(_bif_ago 9030)")"
# Its marker is 0cl; lower down it quotes an earlier id, which is not the marker.
_bif_pub origin/claude/quoted-later      "$(_bif_fold "$_bif_M2" 0cl 0cm "$(_bif_ago 20030)" '(after 0aa comes 0ab)')"
# Live but untouched for 72 hours: in flight only when no bound, or a wide one.
_bif_pub origin/claude/old-fold          "$(_bif_fold "$_bif_M2" 0ck 0cl "$(_bif_ago 259230)")"

# Not in flight, each for one reason, each with a recent tip so that the bound
# is never what leaves it out.
_bif_at "$_bif_M2"
printf '### c section waiting\n\nIts body.\n' > "$_bif_r/docs/handoff/pending/20260103T000000Z-c.md"
_bif_pub origin/claude/pending-only "$(_bif_commit "$(_bif_ago 100)" 'only a pending section')"
_bif_pub origin/claude/landed       "$_bif_M1"
_bif_pub origin/claude/stale        "$(_bif_fold "$_bif_M0" 0ci 0cj "$(_bif_ago 600)")"
_bif_pub origin/claude/behind       "$(_bif_fold "$_bif_M2" 0cb 0cc "$(_bif_ago 700)")"
_bif_pub origin/claude/quoted       "$(_bif_fold "$_bif_M2" 0cg 0ch "$(_bif_ago 1000)" '(after 0cz comes 0da)')"
_bif_at "$_bif_M2"; printf '# Handoff\n\nThis one carries no marker.\n' > "$_bif_r/HANDOFF.md"
_bif_pub origin/claude/no-marker    "$(_bif_commit "$(_bif_ago 900)" 'no marker')"
_bif_at "$_bif_M2"; _bif_git rm -q HANDOFF.md
_bif_pub origin/claude/no-handoff   "$(_bif_commit "$(_bif_ago 800)" 'no handoff')"
# A live fold that is a local branch only, and one under another remote.
_bif_git update-ref refs/heads/local-fold "$(_bif_fold "$_bif_M2" 0cm 0cn "$(_bif_ago 60)")"
_bif_pub upstream/claude/elsewhere  "$(_bif_fold "$_bif_M2" 0cn 0co "$(_bif_ago 30)")"

# Fold order alone: <remote>/main holds one id, <remote>/f is cut from it and
# folded to another.
_bif_ord() {
  _bif_om="$(_bif_fold "$_bif_M2" "$2" "$3" "$(_bif_ago 5000)")"; _bif_pub "$1/main" "$_bif_om"
  _bif_pub "$1/f" "$(_bif_fold "$_bif_om" "$4" "$5" "$(_bif_ago 1000)")"
}
_bif_ord ord1 0cz 0da 0da 0db
_bif_ord ord2 0zz 0aaa 0aaa 0aab
_bif_ord ord3 0aaa 0aab 0zz 0aaa
# Nothing in flight: main, a pending-only branch, a landed fold, a stale one.
_bif_pub calm/main "$_bif_M2"
_bif_pub calm/claude/pending-only "$(_bif_git rev-parse refs/remotes/origin/claude/pending-only)"
_bif_pub calm/claude/landed "$_bif_M1"
_bif_pub calm/claude/stale "$(_bif_git rev-parse refs/remotes/origin/claude/stale)"
# The working tree is left on a commit with no HANDOFF.md, so code that read
# the checkout's own file instead of the ref's could not pass.
_bif_at refs/remotes/origin/claude/no-handoff; mkdir -p "$_bif_r/deep/er"

_bif_fn()  { ( cd "$_bif_r" && . "$REAL_HARNESS/lib/handoff.sh" && felix_handoff_in_flight "$@" ) 2>/dev/null; }
_bif_run() { _bif_out="$(_bif_fn "$@")"; _bif_rc=$?; }
_bif_lines() { if [ -z "$1" ]; then printf 0; else printf '%s\n' "$1" | awk 'END { printf "%d", NR }'; fi; }
_bif_e() { printf '%s\t%s\t%s' "$1" "$2" "$(_bif_ago "$3")"; }
_bif_L_fold="$(_bif_e claude/handoff-fold-1001 0cj 2730)"
_bif_L_base="$(_bif_e claude/a/older-base 0ci 9030)"
_bif_L_quot="$(_bif_e claude/quoted-later 0cl 20030)"
_bif_L_old="$(_bif_e claude/old-fold 0ck 259230)"
_bif_all="$_bif_L_fold
$_bif_L_base
$_bif_L_quot
$_bif_L_old"
_bif_48="$_bif_L_fold
$_bif_L_base
$_bif_L_quot"
# <assertion> <branch>: the call exited 0 and named the live fold
# claude/handoff-fold-1001 somewhere, and names no branch that is <branch> or
# ends in /<branch> (so refs/heads/local-fold or upstream/claude/elsewhere are
# caught however they would be spelled). An absence is only evidence when the
# call that should have named something did, and each of these fails alone,
# for its own branch, whatever else the call got wrong.
_bif_named() { printf '%s\n' "$_bif_out" | awk -F'\t' -v b="$1" '
  $1 == b || (length($1) > length(b) && substr($1, length($1) - length(b)) == "/" b) { f = 1 }
  END { exit !f }'; }
_bif_not() {
  if [ "$_bif_rc" != 0 ] || ! _bif_named claude/handoff-fold-1001; then
    bad "$1" "rc $_bif_rc and the live fold not named, so an absence proves nothing: [$_bif_out]"
  elif _bif_named "$2"; then bad "$1" "[$_bif_out] names $2"
  else ok "$1"; fi
}

_bif_run "$_bif_r" refs/remotes/origin/main
# The whole answer, exactly: four folds in flight, newest tip first, each as
# branch, id and tip time, and exit 0.
is  "felix_handoff_in_flight names every fold in flight on origin, one <branch> <id> <epoch> line each, newest tip first, and exits 0" \
    "$_bif_rc:$_bif_out" "0:$_bif_all"
# The same, piece by piece, so a failure says which part is wrong. Each piece
# reads only the four live folds' lines, so a branch wrongly added fails the
# assertion about that branch below and not these as well.
_bif_live() { printf '%s\n' "$_bif_out" | awk -F'\t' '
  $1 ~ /(^|\/)claude\/(handoff-fold-1001|a\/older-base|quoted-later|old-fold)$/'; }
is  "the branch is named under the remote, without origin/ or refs/remotes/" \
    "$(_bif_live | cut -f1 | tr '\n' ' ')" "claude/handoff-fold-1001 claude/a/older-base claude/quoted-later claude/old-fold "
# Name order would put claude/a/older-base first and id order claude/quoted-
# later; only tip time puts claude/handoff-fold-1001 first.
is  "folds are ordered by tip time, newest first, not by name or by id" \
    "$(_bif_live | awk -F'\t' '{ sub(/.*\/claude\//, "claude/", $1); printf "%s ", $1 }')" \
    "claude/handoff-fold-1001 claude/a/older-base claude/quoted-later claude/old-fold "
# claude/quoted-later quotes (after 0aa comes 0ab) below its marker: its id is
# the first match, 0cl; a last-match reader would drop it as behind main.
is  "each id is the branch's current id from its first marker, not a phrase quoted lower down" \
    "$(_bif_live | awk -F'\t' '{ sub(/.*\/claude\//, "claude/", $1); print $1 "=" $2 }' | LC_ALL=C sort | tr '\n' ' ')" \
    "claude/a/older-base=0ci claude/handoff-fold-1001=0cj claude/old-fold=0ck claude/quoted-later=0cl "
is  "and the third field is the tip's committer time in Unix seconds" \
    "$(_bif_live | awk -F'\t' '$1 ~ /handoff-fold-1001$/ { print $3 }')" "$(_bif_ago 2730)"
# Each reason a branch is not a fold in flight, one by one.
_bif_not "a branch that only adds a pending file, its marker equal to main's, is not in flight" claude/pending-only
_bif_not "a fold main has already taken (its tip is in main, its marker is main's) is not in flight" claude/landed
# claude/stale's marker, 0ci, is after main's 0cg, so (a) alone would count it;
# its merge-base holds 0ce, so it folded a main that has since moved.
_bif_not "a fold cut from an older main whose handoff has since moved is stale, not in flight" claude/stale
# claude/behind is cut from main's tip and only its marker differs: a check of
# "different from main's" rather than "after main's" would count it.
_bif_not "a branch whose marker is behind main's, though cut from main's tip, is not in flight" claude/behind
_bif_not "a branch whose first marker is main's is not in flight, whatever id it quotes lower down" claude/quoted
_bif_not "a branch whose HANDOFF.md has no marker is not in flight" claude/no-marker
_bif_not "a branch with no HANDOFF.md is not in flight" claude/no-handoff
# The newest live fold in the fixture is a local branch: only what others can
# see on the remote is a fold another session would collide with.
_bif_not "a local branch (refs/heads) is never counted, though it holds a live fold" local-fold
_bif_not "a branch under another remote is not counted for origin/main" claude/elsewhere

# (c): a bound in seconds leaves out a fold nobody has touched for longer, so
# an abandoned fold lets the row fall due again rather than silencing it.
_bif_run "$_bif_r" refs/remotes/origin/main 172800
is  "given a bound of 48 hours in seconds, a fold whose tip is 72 hours old is left out" "$_bif_rc:$_bif_out" "0:$_bif_48"
_bif_run "$_bif_r" refs/remotes/origin/main 5000
is  "a bound of 5000 seconds keeps only the fold whose tip is 2730 seconds old" "$_bif_rc:$_bif_out" "0:$_bif_L_fold"
_bif_run "$_bif_r" refs/remotes/origin/main 0
is  "a bound of 0 is no bound" "$_bif_rc:$_bif_out" "0:$_bif_all"
_bif_run "$_bif_r" origin/main
is  "the short form origin/main is read as refs/remotes/origin/main" "$_bif_rc:$_bif_out" "0:$_bif_all"
_bif_out="$( ( cd "$TMP" && . "$REAL_HARNESS/lib/handoff.sh" && felix_handoff_in_flight "$_bif_r" refs/remotes/origin/main ) 2>/dev/null)"; _bif_rc=$?
is  "it examines the checkout it is given as <root>, from any working directory" "$_bif_rc:$_bif_out" "0:$_bif_all"
# origin/HEAD is a symbolic ref. Pointed at a live fold, it would name that
# fold a second time, as HEAD, if symbolic refs were not passed over.
_bif_git symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/claude/handoff-fold-1001
_bif_run "$_bif_r" refs/remotes/origin/main
_bif_git symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main
is  "a symbolic ref such as origin/HEAD is never counted, even when it points at a fold in flight" "$_bif_rc:$_bif_out" "0:$_bif_all"
# Spec: no gh. A gh first on PATH records that it ran.
_bif_stub="$TMP/bif-stub"; mkdir -p "$_bif_stub"
printf '#!/bin/sh\n: > "%s/gh-ran"\nexit 1\n' "$_bif_stub" > "$_bif_stub/gh"; chmod +x "$_bif_stub/gh"
_bif_out="$(PATH="$_bif_stub:$PATH" _bif_fn "$_bif_r" refs/remotes/origin/main)"; _bif_rc=$?
is  "it reads the folds in flight from git alone and never runs gh" \
    "$_bif_rc:$_bif_out:$([ -e "$_bif_stub/gh-ran" ] && echo gh-ran)" "0:$_bif_all:"

# Fold order: a longer id is later, and ids of one length compare letter by
# letter. A string compare passes ord1 and fails ord2 and ord3 both ways round.
_bif_run "$_bif_r" refs/remotes/ord1/main
is  "fold order: 0da is after 0cz, so a fold to 0da from a main at 0cz is in flight" "$_bif_rc:$_bif_out" "0:$(_bif_e f 0da 1000)"
_bif_run "$_bif_r" refs/remotes/ord2/main
is  "fold order: 0aaa is after 0zz, though it sorts before it as a string" "$_bif_rc:$_bif_out" "0:$(_bif_e f 0aaa 1000)"
_bif_run "$_bif_r" refs/remotes/ord3/main
is  "fold order: 0zz is before 0aaa, though it sorts after it as a string, so it is not in flight" "$_bif_rc:$_bif_out" "0:"
_bif_run "$_bif_r" refs/remotes/calm/main
is  "with nothing in flight it prints nothing and exits 0" "$_bif_rc:$_bif_out" "0:"

# Cannot examine: exit 2 and one line on stdout saying why, never the silent
# exit 0 that means "nothing in flight", since the row would then read ok.
_bif_run "$_bif_r" refs/remotes/origin/nonesuch
is  "a ref that does not resolve cannot be examined: exit 2, one line on stdout" "$_bif_rc:$(_bif_lines "$_bif_out")" "2:1"
_bif_run "$_bif_r" "$_bif_M2"
is  "a bare commit is not a remote-tracking ref: exit 2, one line" "$_bif_rc:$(_bif_lines "$_bif_out")" "2:1"
# refs/heads/main holds the same commit as origin/main, so code that took any
# ref would answer as if for origin/main.
_bif_run "$_bif_r" refs/heads/main
is  "a local branch is not a remote-tracking ref, though it holds main's commit: exit 2, one line" "$_bif_rc:$(_bif_lines "$_bif_out")" "2:1"
_bif_run "$_bif_r" refs/remotes/origin/claude/no-handoff
is  "a ref with no HANDOFF.md cannot be examined: exit 2, one line" "$_bif_rc:$(_bif_lines "$_bif_out")" "2:1"
_bif_run "$_bif_r" refs/remotes/origin/claude/no-marker
is  "a ref whose HANDOFF.md has no marker cannot be examined: exit 2, one line" "$_bif_rc:$(_bif_lines "$_bif_out")" "2:1"

# The script. Its exit status follows grep's, so it can stand as the tail of a
# maintenance check: 0 named something, 1 found nothing, 2 could not look.
_bif_bin() { "$REAL_HARNESS/bin/handoff-in-flight" "$@" 2>/dev/null; }
# <dir> <args...>: runs it in <dir>, noting the clock either side of the run.
_bif_brun() {
  _bif_dir="$1"; shift
  _bif_t0="$(date +%s)"; _bif_out="$(cd "$_bif_dir" && _bif_bin "$@")"; _bif_rc=$?; _bif_t1="$(date +%s)"
}
# <now> then <branch> <id> <epoch> triples: the human lines the spec gives,
# `<branch> (folded to <id>; tip <age> old)`, <age> as whole minutes under an
# hour and whole hours otherwise, rounded down.
_bif_human() {
  _bif_hn="$1"; shift; _bif_hs=""
  while [ $# -ge 3 ]; do
    _bif_hd=$((_bif_hn - $3))
    if [ "$_bif_hd" -lt 3600 ]; then _bif_ha="$((_bif_hd / 60))m"; else _bif_ha="$((_bif_hd / 3600))h"; fi
    _bif_hs="$_bif_hs${_bif_hs:+
}$1 (folded to $2; tip $_bif_ha old)"; shift 3
  done
  printf '%s' "$_bif_hs"
}
# <assertion> <exit> <triples...>: the run's status and output equal the lines
# for the clock as it read just before the run or just after it, so a minute
# that turns over while it runs does not fail an age the script got right.
_bif_isage() {
  _bif_in="$1"; _bif_ix="$2"; shift 2
  _bif_ia="$_bif_ix:$(_bif_human "$_bif_t0" "$@")"; _bif_ib="$_bif_ix:$(_bif_human "$_bif_t1" "$@")"
  if [ "$_bif_rc:$_bif_out" = "$_bif_ia" ] || [ "$_bif_rc:$_bif_out" = "$_bif_ib" ]; then ok "$_bif_in"
  else bad "$_bif_in" "expected [$_bif_ia] got [$_bif_rc:$_bif_out]"; fi
}
# <assertion> <dir> <args...>: exit 2 and one stdout line starting "cannot examine".
_bif_cant() {
  _bif_cn="$1"; shift; _bif_brun "$@"
  case "$_bif_rc:$(_bif_lines "$_bif_out"):$_bif_out" in
    "2:1:cannot examine"*) ok "$_bif_cn" ;;
    *) bad "$_bif_cn" "expected exit 2 and one line starting 'cannot examine', got $_bif_rc: [$_bif_out]" ;;
  esac
}
_bif_T_fold="claude/handoff-fold-1001 0cj $(_bif_ago 2730)"
_bif_T_base="claude/a/older-base 0ci $(_bif_ago 9030)"
_bif_T_quot="claude/quoted-later 0cl $(_bif_ago 20030)"
_bif_T_old="claude/old-fold 0ck $(_bif_ago 259230)"

# The triples below are meant to split into words.
_bif_brun "$_bif_r/deep/er"
_bif_isage "bin/handoff-in-flight, run from a subdirectory with no arguments, reads origin/main within 48 hours and names each fold, newest first, exit 0" \
    0 $_bif_T_fold $_bif_T_base $_bif_T_quot
_bif_brun "$_bif_r" --within 0
_bif_isage "handoff-in-flight --within 0 is no bound, and a tip 72 hours old is said in hours" \
    0 $_bif_T_fold $_bif_T_base $_bif_T_quot $_bif_T_old
_bif_brun "$_bif_r" --within 3
_bif_isage "handoff-in-flight --within 3 is three hours: the 5-hour and 72-hour tips are left out" \
    0 $_bif_T_fold $_bif_T_base
_bif_brun "$_bif_r" --within 100
_bif_isage "handoff-in-flight --within 100 is a hundred hours, so the 72-hour tip is named" \
    0 $_bif_T_fold $_bif_T_base $_bif_T_quot $_bif_T_old
_bif_brun "$_bif_r" origin/main
_bif_isage "handoff-in-flight takes the ref as its argument, the short form included" \
    0 $_bif_T_fold $_bif_T_base $_bif_T_quot
# The same answer with a recording gh first on PATH, and the record still absent.
rm -f "$_bif_stub/gh-ran"
_bif_t0="$(date +%s)"; _bif_out="$(cd "$_bif_r" && PATH="$_bif_stub:$PATH" _bif_bin)"; _bif_rc=$?; _bif_t1="$(date +%s)"
[ -e "$_bif_stub/gh-ran" ] && _bif_out="$_bif_out (and gh ran)"
_bif_isage "handoff-in-flight answers from git alone and never runs gh" 0 $_bif_T_fold $_bif_T_base $_bif_T_quot
_bif_brun "$_bif_r" refs/remotes/calm/main
is  "handoff-in-flight with nothing in flight exits 1 and prints nothing, as grep does" "$_bif_rc:$_bif_out" "1:"

_bif_cant "handoff-in-flight on a ref that does not resolve exits 2: cannot examine" "$_bif_r" refs/remotes/origin/nonesuch
_bif_cant "handoff-in-flight on a local branch exits 2: not a remote-tracking ref" "$_bif_r" refs/heads/main
_bif_cant "handoff-in-flight on a ref with no marker exits 2: cannot examine" "$_bif_r" refs/remotes/origin/claude/no-marker
mkdir -p "$TMP/bif-nogit"
_bif_cant "handoff-in-flight outside any checkout exits 2, since origin/main does not resolve" "$TMP/bif-nogit"
# A bound that is not a whole number of hours, or an option it does not know,
# must not be read as "no bound" or as a ref: it cannot examine.
_bif_cant "handoff-in-flight --within abc exits 2: cannot examine" "$_bif_r" --within abc
_bif_cant "handoff-in-flight --within 1.5 exits 2, since hours are whole" "$_bif_r" --within 1.5
_bif_cant "handoff-in-flight --within with no value exits 2" "$_bif_r" --within
_bif_cant "handoff-in-flight with an unknown option exits 2" "$_bif_r" --frobnicate

# The age in the human line. Built now, just before it is read, at ages each
# about thirty seconds inside its unit: 0m under a minute, rounded down to 45m
# not 46m, 59m below the hour, 1h just past it, 2h for two and a half, and 72h
# rather than days.
_bif_n2="$(date +%s)"
_bif_pub age/main "$_bif_M2"
_bif_pub age/a0   "$(_bif_fold "$_bif_M2" 0ch 0ci "$((_bif_n2 - 10))")"
_bif_pub age/a1   "$(_bif_fold "$_bif_M2" 0ci 0cj "$((_bif_n2 - 90))")"
_bif_pub age/a45  "$(_bif_fold "$_bif_M2" 0cj 0ck "$((_bif_n2 - 2730))")"
_bif_pub age/a59  "$(_bif_fold "$_bif_M2" 0ck 0cl "$((_bif_n2 - 3570))")"
_bif_pub age/a60  "$(_bif_fold "$_bif_M2" 0cl 0cm "$((_bif_n2 - 3630))")"
_bif_pub age/a150 "$(_bif_fold "$_bif_M2" 0cm 0cn "$((_bif_n2 - 9030))")"
_bif_pub age/a72h "$(_bif_fold "$_bif_M2" 0cn 0co "$((_bif_n2 - 259230))")"
_bif_at refs/remotes/origin/claude/no-handoff
_bif_brun "$_bif_r" --within 0 refs/remotes/age/main
_bif_isage "the age is whole minutes under an hour and whole hours otherwise, rounded down: 0m 1m 45m 59m 1h 2h 72h" \
    0 a0 0ch "$((_bif_n2 - 10))" a1 0ci "$((_bif_n2 - 90))" a45 0cj "$((_bif_n2 - 2730))" \
      a59 0ck "$((_bif_n2 - 3570))" a60 0cl "$((_bif_n2 - 3630))" a150 0cm "$((_bif_n2 - 9030))" \
      a72h 0cn "$((_bif_n2 - 259230))"

printf '\na fold in flight: the shapes an adversarial review found\n'
# Four shapes the blind assertions above did not reach, each reproduced by a
# reviewer against the first version of this code and each shown red against
# it before the fix.
_brv="$TMP/brv"; mkdir -p "$_brv"
( cd "$_brv" && git init -q -b main && git config user.name t && git config user.email t@example.invalid )
_brv_c() {   # message, epoch, marker-id [, extra file]: commit HANDOFF.md holding that marker
  printf '# Handoff\n\nFold with felix handoff --rotate (after %s comes x).\n' "$3" \
    | sed "s/comes x/comes $(cd "$_brv" && . "$REAL_HARNESS/lib/handoff.sh" && felix_handoff_next_id "$3")/" > "$_brv/HANDOFF.md"
  [ -z "${4:-}" ] || printf '%s\n' "$4" > "$_brv/$4.txt"
  git -C "$_brv" add -A && GIT_COMMITTER_DATE="@$2 +0000" GIT_AUTHOR_DATE="@$2 +0000" git -C "$_brv" commit -q -m "$1"
  git -C "$_brv" rev-parse HEAD
}
_brv_if() { ( cd "$_brv" && . "$1/lib/handoff.sh" && felix_handoff_in_flight "$_brv" refs/remotes/origin/main "${2:-0}" ); }
_brv_now="$(date +%s)"

# 1. A criss-cross. F is cut from T0 and adds a file at f1; a fold lands on
# main as t1; F merges t1; main takes f1 with a true merge; F then folds
# main's current handoff. F's merge-bases with main are f1 (before main's
# fold) and t1 (after it), and git prints whichever its dates favour. Read
# alone, f1 hid a fold that could land.
_brv_t0="$(_brv_c T0 1000000000 0bz)"
git -C "$_brv" checkout -q -b F
_brv_f1="$(printf 'p4\n' > "$_brv/p4.txt"; git -C "$_brv" add -A && GIT_COMMITTER_DATE="@1000000250 +0000" git -C "$_brv" commit -q -m f1 && git -C "$_brv" rev-parse HEAD)"
git -C "$_brv" checkout -q -b G "$_brv_t0"
_brv_t1="$(_brv_c "fold G" 1000000200 0cc)"
git -C "$_brv" checkout -q F
GIT_COMMITTER_DATE="@1000000300 +0000" git -C "$_brv" merge -q --no-edit "$_brv_t1" >/dev/null 2>&1
git -C "$_brv" checkout -q -b land "$_brv_t1"
GIT_COMMITTER_DATE="@1000000400 +0000" git -C "$_brv" merge -q --no-ff --no-edit "$_brv_f1" >/dev/null 2>&1
git -C "$_brv" update-ref refs/remotes/origin/main "$(git -C "$_brv" rev-parse HEAD)"
git -C "$_brv" checkout -q F
_brv_f3="$(_brv_c "fold F" 1000000500 0cd)"
git -C "$_brv" update-ref refs/remotes/origin/claude/criss "$_brv_f3"
is  "a criss-cross fold has two merge-bases, one before main's fold and one after it" \
    "$(git -C "$_brv" merge-base --all "$_brv_f3" refs/remotes/origin/main | wc -l | tr -d ' ')" "2"
is  "and it is named however git orders its merge-bases, since every base is read" \
    "$(_brv_if "$REAL_HARNESS" | cut -f1,2)" "$(printf 'claude/criss\t0cd')"
git -C "$_brv" update-ref -d refs/remotes/origin/claude/criss

# 2. A branch pruned between the listing and the read. Every session shares
# refs/remotes, so a fetch --prune in another worktree can delete a ref the
# listing just returned. git grep resolves every name before it reads any and
# died on that one, printing nothing for the rest: main read as unmarked and
# the run as "cannot examine". The shim deletes the ref right after git lists
# it, which is the same thing on a fixed schedule.
git -C "$_brv" checkout -q -b main2 refs/remotes/origin/main
_brv_live="$(_brv_c live "$_brv_now" 0cd)"
git -C "$_brv" update-ref refs/remotes/origin/claude/live "$_brv_live"
git -C "$_brv" checkout -q -b old "$_brv_t0"
_brv_gone="$(_brv_c gone "$_brv_now" 0bz gone)"
git -C "$_brv" update-ref refs/remotes/origin/claude/gone "$_brv_gone"
mkdir -p "$_brv/shim"
_brv_git="$(command -v git)"
cat > "$_brv/shim/git" <<EOF
#!/usr/bin/env bash
"$_brv_git" "\$@"; rc=\$?
case " \$* " in *" for-each-ref "*) "$_brv_git" -C "$_brv" update-ref -d refs/remotes/origin/claude/gone ;; esac
exit \$rc
EOF
chmod +x "$_brv/shim/git"
_brv_out="$(PATH="$_brv/shim:$PATH" _brv_if "$REAL_HARNESS")"; _brv_rc=$?
is  "a branch pruned after it was listed does not blank the read: main is still read, the live fold still named" \
    "$_brv_rc:$(printf '%s\n' "$_brv_out" | cut -f1,2 | tr '\t' ' ')" "0:claude/live 0cd"
git -C "$_brv" rev-parse --verify --quiet refs/remotes/origin/claude/gone >/dev/null \
  && bad "and the shim did prune it, so the line above read the race" "the ref is still there" \
  || ok  "and the shim did prune it, so the line above read the race"

# 3. A tip dated ahead of this clock. It passed the age bound for as long as
# it stayed ahead, and the script showed it as 0m old.
git -C "$_brv" checkout -q -b ahead refs/remotes/origin/main
git -C "$_brv" update-ref -d refs/remotes/origin/claude/live
_brv_ahead="$(_brv_c ahead $((_brv_now + 7200)) 0cd)"
git -C "$_brv" update-ref refs/remotes/origin/claude/ahead "$_brv_ahead"
is  "a tip dated two hours ahead is not trusted as fresh under a bound" \
    "$(_brv_if "$REAL_HARNESS" 172800)" ""
is  "with no bound it is named" "$(_brv_if "$REAL_HARNESS" 0 | cut -f1)" "claude/ahead"
has "and the script says it is dated ahead, rather than 0m old" \
    "$(cd "$_brv" && "$REAL_HARNESS/bin/handoff-in-flight" --within 0)" "claude/ahead (folded to 0cd; tip dated ahead of this clock)"

# 4. A check that prints a control byte. It reached the session start's JSON,
# whose escaping knows backslash, quote, \n, \r and \t only, and one escape
# byte made the whole hook output unreadable.
_brv_wt="$FROOT/projects/widget/maintenance.tsv"
cp "$_brv_wt" "$TMP/brv-widget-maint.keep" 2>/dev/null || : > "$TMP/brv-widget-maint.keep"
printf 'brvesc\t0\talways\tprints an escape\tprintf '"'"'x\\033[31my\\001z\\n'"'"'\n' > "$_brv_wt"
_brv_st="$( ( . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/detect.sh"
              . "$FROOT/harness/lib/maintenance.sh"; felix_maint_status "$FROOT/projects/widget" "$REPO" ) )"
is  "a holder keeps its text and drops its control bytes" \
    "$(printf '%s\n' "$_brv_st" | awk -F'\t' '$2 == "brvesc" { print $1 "|" $3 }')" "inflight|x[31myz"
_brv_out="$(cd "$REPO" && CLAUDE_PLUGIN_ROOT="$FROOT" "$FROOT/harness/hooks/session-start" 2>/dev/null)"
printf '%s' "$_brv_out" | python3 -c 'import json,sys; json.load(sys.stdin)' >/dev/null 2>&1 \
  && ok  "so the session start's output is still JSON" \
  || bad "so the session start's output is still JSON" "$(printf '%s' "$_brv_out" | head -c 300)"
has "and the line names it" "$_brv_out" "Already in flight, so not due: brvesc on x[31myz"
cp "$TMP/brv-widget-maint.keep" "$_brv_wt"

printf '\nno engine test reads a pipe through a grep that can stop early\n'
# Under pipefail, `producer | grep -q x` reads "absent" for a value that is
# there whenever grep matches and exits while the producer still has output to
# write: the producer's next write breaks the pipe, it dies of SIGPIPE (141),
# and pipefail hands that status to the `if`, `&&`, `||` or `!` reading it.
# The first pair below pins that on the machine running the suite, because the
# lint after it is only worth having while it holds.
#
# _spl_scan is the lint's one matcher, and the same code reads the samples and
# the engine. It prints file:line wherever a `|` that is not half of `||` is
# followed, after optional `command`, `env`, `nice`, `timeout N`, `if` and `!`
# words, VAR=value prefixes and a leading backslash, by grep, egrep or fgrep
# that can stop reading early. One way is an option that lets it: -q, -m, -l or
# -L, alone or inside a cluster (-qxF, -Eq, -m1), or --quiet, --silent,
# --max-count, --files-with-matches or --files-without-match. Options are read
# letter by letter, and one that takes an argument (-e, -f, -A, -B, -C, -d, -D,
# --regexp, --file, --context and its halves) takes the rest of its word, or
# the next word, with it: `-e pat -q` is flagged, and `-eline` is not read as
# -l. The other is a standard output on /dev/null, whatever the options: GNU
# grep, the grep on Linux, reads that as -q and stops at its first match, even
# given -c. So `>/dev/null`, `> /dev/null`, `1>`, `>>`, `&>`, `>&` or `>|`,
# before or after `2>&1`, anywhere in grep's own command is named. That command
# runs to the first `|`, `;` or `&&` outside quotes, or to a comment, and on
# past a backslash that ends its line; it does not stop at `)` or a lone `&`.
# A digit glued to a word before `>` is
# part of the word, so `y2>/dev/null` is standard output; `2>/dev/null` alone
# is not named, since where grep's errors go changes nothing. A pipe that ends
# one line, or ends its code before a comment, carries onto the next line of
# code, and a line may start with the pipe; bash reads both as one chain, and
# it carries a pipe across blank and comment lines too. Comment lines are
# skipped.
#
# What it does not see: `head`, `sed q` or an awk that exits early at the end of
# a pipeline whose status is tested (there were two, felix_overnight_field's
# `cut | head -1` read with `|| return 1` and felix_marketplace_root's
# `sed | sed | head -1` read with `|| mroot=""`, safe only because each reads
# one line, and both now read to the end; a new one would pass this lint); a
# grep whose standard output reaches /dev/null only through a redirect on its
# caller, on a brace group around it, on a subshell that closes on a later line
# (one that closes on grep's own line is named), or through exec; a quoted
# target (`>"/dev/null"`, `>'/dev/null'`); a pipe into
# a brace group or subshell that holds the grep; a grep named by its path or
# through a variable; a wrapper given options of its own (`env -i`,
# `nice -n 5`, `timeout -s KILL 5`); a VAR= prefix whose quoted value holds a
# space; an early option placed after the pattern, or on a continuation line
# inside grep's own arguments; a producer whose status is tested through a
# variable; code built at run time with eval. What it names that is no pipe:
# looking for the pipe and the grep, it reads quoted strings and here-doc
# bodies as code, so a message or a pattern holding `| grep -q` is named, and
# so is the line after a code line whose trailing comment ends in `|`; and
# since grep's command runs past `)` and a lone `&`, a redirect to /dev/null
# that belongs to a later command on the line is named, as is `/dev/nullx`.
_spl_scan() {
  awk '
    # grep, after the words that may stand before it, able to stop early.
    function early(s) {
      sub(/^[ \t]+/, "", s)
      while (s ~ /^(command|env|nice|if|!)[ \t]/ || s ~ /^timeout[ \t]+[0-9.]+[smhd]?[ \t]/ ||
             s ~ /^[A-Za-z_][A-Za-z0-9_]*=[^ \t]*[ \t]/) {
        if (s ~ /^timeout[ \t]/) sub(/^timeout[ \t]+/, "", s)
        sub(/^[^ \t]*[ \t]+/, "", s)
      }
      sub(/^\\/, "", s)
      if (s !~ /^[ef]?grep[ \t]/) return 0
      sub(/^[ef]?grep[ \t]+/, "", s)
      if (quits(s) || devnull(s)) return 1
      if (cont) gpc = 1
      return 0
    }
    # An option among the words that lets grep stop early.
    function quits(s,   w, n, i, k, c) {
      n = split(s, w, /[ \t]+/)
      for (i = 1; i <= n; i++) {
        if (w[i] == "--") return 0
        if (w[i] ~ /^--(quiet|silent|max-count|files-with-matches|files-without-match)(=|$)/) return 1
        if (w[i] ~ /^--(regexp|file|after-context|before-context|context)$/) { i++; continue }
        if (w[i] ~ /^--/) continue
        if (w[i] !~ /^-[A-Za-z0-9]/) return 0
        for (k = 2; k <= length(w[i]); k++) {
          c = substr(w[i], k, 1)
          if (c ~ /[qmlL]/) return 1
          if (c ~ /[efABCdD]/) { if (k == length(w[i])) i++; break }
        }
      }
      return 0
    }
    # A standard output on /dev/null in the words, up to where the command ends.
    # Quoted strings become one letter first, so a | or ; inside a pattern ends
    # nothing and a digit after a quote stays glued to a word. Sets cont when the
    # command runs on past a backslash that ends the line.
    function devnull(s,   t, m, pre, d) {
      t = s
      gsub(/\047[^\047]*\047/, "Q", t)
      gsub(/"([^"\\]|\\.)*"/, "Q", t)
      gsub(/>\|/, ">", t)
      sub(/(\||;|&&|[ \t]#).*/, "", t)
      cont = (t ~ /\\[ \t]*$/)
      while (match(t, /&?[0-9]*>>?&?[ \t]*\/dev\/null/)) {
        m = substr(t, RSTART, RLENGTH)
        pre = (RSTART > 1) ? substr(t, RSTART - 1, 1) : ""
        t = substr(t, RSTART + RLENGTH)
        if (m ~ /^&/) return 1
        d = m; sub(/>.*/, "", d)
        if (d == "" || d == "1" || pre ~ /[^ \t]/) return 1
      }
      return 0
    }
    FNR == 1 { open = 0; gp = 0 }
    /^[ \t]*(#|$)/ { gp = 0; next }
    {
      # A line a backslash carried a grep onto: a redirect here is the grep one.
      if (gp) {
        if (devnull($0)) { print FILENAME ":" gp; gp = 0 }
        else if (!cont) gp = 0
      }
      gpc = 0
      hit = open && early($0)
      rest = $0
      while (!hit && (j = index(rest, "|")) > 0) {
        if (substr(rest, j + 1, 1) == "|") { rest = substr(rest, j + 2); continue }
        rest = substr(rest, j + 1)
        hit = early(rest)
      }
      if (hit) print FILENAME ":" FNR
      else if (gpc) gp = FNR
      t = $0; sub(/[ \t]*(\\[ \t]*)?$/, "", t)
      open = (t ~ /(^|[^|])[|]([ \t]+#.*)?$/)
    }
  ' "$@"
}

# ~1 MB with the match on line 1: the writer fills the pipe and blocks, grep
# reads, matches and exits, and the writer's next write always breaks. That
# takes the race out, so the first check fails every time the premise holds.
_spl_big="$(seq 1 160000)"
_spl_ps="$( set -o pipefail
            printf '%s\n' "$_spl_big" 2>/dev/null | grep -qx 1
            printf '%s %s' "$?" "${PIPESTATUS[1]}" )"
case "$_spl_ps" in
  0\ *) bad "under pipefail, printf of a megabyte piped into grep -q reads a match on its first line as absent" \
            "the pipe read the line as present (statuses: $_spl_ps), so nothing here shows the shape the lint refuses can fail" ;;
  *\ 0) ok  "under pipefail, printf of a megabyte piped into grep -q reads a match on its first line as absent" ;;
  *)    bad "under pipefail, printf of a megabyte piped into grep -q reads a match on its first line as absent" \
            "grep itself did not report the match (pipeline status, grep status: $_spl_ps), so this is not the broken pipe" ;;
esac
if ( set -o pipefail; grep -qx 1 <<<"$_spl_big" ); then
  ok  "and the same test fed a here-string finds it"
else
  bad "and the same test fed a here-string finds it" \
      "the here-string form missed line 1 of the megabyte, so it is no replacement for the pipe"
fi

# The matcher on shapes written out, so a change to it that drops one shows as
# a named miss rather than as a quiet engine scan. Each sample is a file; the
# answer is the line numbers flagged in it.
mkdir -p "$TMP/_spl"
_spl_flags() {
  printf '%s\n' "$1" > "$TMP/_spl/sample"
  ( cd "$TMP/_spl" && _spl_scan sample ) | awk -F: '{ printf "%s%s", s, $NF; s = " " }'
}
is "the lint flags a pipe into grep -q as a cluster, with no space after the pipe, or after another flag" \
   "$(_spl_flags 'x | grep -qxF y
x |grep -Eq y
x | grep -qvE y
x | grep -E -q y')" "1 2 3 4"
is "the lint flags grep reached through command or a VAR=value prefix" \
   "$(_spl_flags 'x | command grep -q y
x | LC_ALL=C grep -q y
x | LC_ALL=C command grep -qx y')" "1 2 3"
is "the lint flags grep reached through env, timeout, nice, if, ! or a leading backslash" \
   "$(_spl_flags 'x | \grep -q y
x | env LC_ALL=C grep -q y
x | timeout 5 grep -q y
x | nice grep -q y
x | if grep -q y; then :; fi
x | ! grep -q y')" "1 2 3 4 5 6"
is "the lint flags an early option after an option that takes an argument, attached or apart" \
   "$(_spl_flags 'x | grep -e pat -q y
x | grep -f pats -q
x | grep -A 2 -q y
x | grep --regexp pat -q
x | grep -epat -m1')" "1 2 3 4 5"
is "the lint takes no option's argument for an option: -eline is not -l, and a pattern -quux is not -q" \
   "$(_spl_flags 'x | grep -eline f
x | grep -e -quux f
x | grep -A 2 y')" ""
is "the lint flags every option that lets grep stop early, in egrep and fgrep as well" \
   "$(_spl_flags 'x | grep -m1 y
x | grep --quiet y
x | grep --silent y
x | grep --max-count=1 y
x | egrep -l y
x | fgrep -L y
x | grep --files-with-matches y')" "1 2 3 4 5 6 7"
is "the lint flags a grep -q on the line after a pipe that ends a line, with or without a backslash" \
   "$(_spl_flags 'x |
  grep -q y
z | \
  grep -qx y')" "2 4"
is "the lint flags a grep -q on the line after a pipe that a comment follows" \
   "$(_spl_flags 'x |   # why it is piped
  grep -q y')" "2"
is "the lint flags a line that starts with a pipe into grep -qxF, continuing the line above" \
   "$(_spl_flags 'x \
| grep -qxF y')" "2"
is "the lint leaves an ||, a grep that reads to the end, a pattern after -- and a comment line alone" \
   "$(_spl_flags 'a || grep -q x f
x | grep -c y
x | grep -v y
x | grep -- -q
# x | grep -q y')" ""
is "the lint carries neither an || nor a comment's trailing pipe onto the next line" \
   "$(_spl_flags 'a ||
  grep -q y
# a |
  grep -q y')" ""
# Named on purpose, as the comment above says: pinned so a matcher that learns
# to skip them also has to change what that comment promises.
is "the lint reads a quoted string and a code line's trailing comment as code" \
   "$(_spl_flags "printf 'use: x | grep -q y\\n'
grep -E 'a| grep -q' f
foo  # see a |
grep -q y file")" "1 2 4"
# A grep with no early option whose standard output is /dev/null stops at its
# first match on GNU grep, even with -c, so each of these is the same shape.
is "the lint flags a piped grep whose standard output goes to /dev/null, in each spelling of the redirect" \
   "$(_spl_flags 'x | grep -xF y >/dev/null
x | grep -xF y > /dev/null
x | grep -xF y 1>/dev/null
x | grep -xF y &>/dev/null
x | grep -xF y >/dev/null 2>&1
x | grep -xF y 2>&1 >/dev/null
x | grep -xF y >>/dev/null
x | grep -xF y >& /dev/null
x | grep -xF y >|/dev/null')" "1 2 3 4 5 6 7 8 9"
is "the lint flags it in an if, after a sed, after a quoted | or ;, after --, and given -c" \
   "$(_spl_flags "if printf '%s\\n' \"\$l\" | grep -xF \"\$v\" >/dev/null 2>&1; then :; fi
x | sed 's/:.*//' | grep -xF \"\$v\" >/dev/null 2>&1
x | grep -E 'a|b' >/dev/null
x | grep -xF \"a;b\" >/dev/null
x | grep -- -q >/dev/null
x | grep -c y >/dev/null")" "1 2 3 4 5 6"
is "the lint reads a digit before > as a descriptor only standing alone: 2>/dev/null is not named, y2>/dev/null is" \
   "$(_spl_flags 'x | grep -xF y 2>/dev/null
x | grep -xF y 2> /dev/null
x | grep -xF y2>/dev/null
x | grep -xF "$v"2>/dev/null')" "3 4"
is "the lint flags a redirect on the line a backslash carries the grep onto, and one after a pipe that ends a line" \
   "$(_spl_flags 'x | grep -xF y \
  >/dev/null 2>&1
x |
  grep -xF y >/dev/null')" "1 4"
is "the lint leaves grep -c with its errors on /dev/null, and a redirect that is another command's or a comment's" \
   "$(_spl_flags 'x | grep -c y 2>/dev/null
n="$(x | grep -c . 2>/dev/null)" || n=0
x | grep -xF y | wc -l >/dev/null
x | grep -xF y; z >/dev/null
x | grep -xF y && z >/dev/null
x | grep -xF y || z >/dev/null
grep -xF y file >/dev/null
a || grep -xF y >/dev/null
x | grep -xF y   # not >/dev/null
x | grep -xF y \

>/dev/null')" ""

# The engine itself: the CLI, its libraries, its hooks and its bin scripts. Not
# tests/, which #364 scans once it lands, and not templates/, which is table
# data.
_spl_sites="$( cd "$REAL_HARNESS" 2>/dev/null && [ -f felix ] \
                 || { printf 'no engine to scan at %s\n' "$REAL_HARNESS"; exit 0; }
               set --
               for _spl_x in felix lib/*.sh hooks/* bin/*; do [ -f "$_spl_x" ] && set -- "$@" "$_spl_x"; done
               _spl_scan "$@" || printf 'the scan itself failed, exit %s\n' "$?" )"
_spl_nl='
'
if [ -z "$_spl_sites" ]; then
  ok  "no engine test pipes into a grep that can stop reading early"
else
  bad "no engine test pipes into a grep that can stop reading early" \
      "a false miss under pipefail is possible at: ${_spl_sites//$_spl_nl/ }"
fi

printf '\nan escape or a tier over a diff larger than a pipe\n'
# A test that pipes a value into `grep -q` answers "not found" for a value that
# is there whenever grep matches and exits while the writer still has lines to
# write: the writer dies of SIGPIPE, pipefail makes the pipeline 141, and the
# `&&` or `if` reads no match. Past a pipe's capacity with the match early it
# happens every time, and a diff is the value most likely to get that big.
# Three places read one, and each fails open: the confine that demotes a risk
# row, the destructive-SQL escape over the added lines, and a risk table's
# content rows. Each is driven here with 20,000 changed lines (well past the
# 64 KB a pipe holds), the match as early as the producer's order allows, and
# the same fixture with the match on the LAST line as the control. The last
# line cannot be missed, so the control proves the fixture reaches the line
# under test and that a red is the race, not an unreachable branch.
_spd_dir="$TMP/_spd"; mkdir -p "$_spd_dir"
_spd_t="$(printf '\t')"
# has(), with the failure saying what the miss did rather than only what the
# output lacked.
_spd_has() { case "$2" in *"$3"*) ok "$1" ;; *) bad "$1" "$4; got [$2]" ;; esac; }
_spd_nofix() { _spd_why="$1"; shift; for _spd_a in "$@"; do bad "$_spd_a" "$_spd_why"; done; }
_spd_esc() { ( cd "$1" && . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/escape.sh"
               . "$FROOT/harness/lib/obligations.sh"; felix_escapes "$2" HEAD~1 "$1" ) 2>/dev/null; }

# _spd_deps DIR FIRST LAST: a repository whose one commit rewrites every line of
# a 20,001-line manifest from 1.0 to 2.0, FIRST replacing the first line and
# LAST the last. The unchanged second line ends the first hunk there, so FIRST
# is the hunk's second line, straight after the line it replaced.
_spd_deps() {
  mkdir -p "$1" && ( cd "$1" && git init -q -b main \
    && awk 'BEGIN { print "pkg00000 = 1.0"; print "# pinned below"
                    for (i = 1; i <= 20000; i++) printf "pkg%05d = 1.0\n", i }' > deps.txt \
    && git add -A && git -c user.name=t -c user.email=t@t commit -qm base \
    && _SPD_F="$2" _SPD_L="$3" awk 'BEGIN { print ENVIRON["_SPD_F"]; print "# pinned below"
                    for (i = 1; i < 20000; i++) printf "pkg%05d = 2.0\n", i
                    print ENVIRON["_SPD_L"] }' > deps.txt \
    && git add -A && git -c user.name=t -c user.email=t@t commit -qm change ) >/dev/null 2>&1
}

# A verifier row demoted to fire only when every changed line is a version bump
# and the package names pair up. The smuggled flag keeps its line's package
# name, so the names still pair and the confine's line pattern is the only
# thing between it and a merge.
_spd_n1="a line outside a risk row's confine near the top of a diff larger than a pipe still fires the row"
_spd_n2="a line outside a risk row's confine on the last line of a diff larger than a pipe fires the row"
_spd_n3="a diff larger than a pipe whose every line is inside the confine still escapes nothing"
mkdir -p "$_spd_dir/proj"
printf 'red\tpath\t^deps\\.txt$\ta manifest that also configures the gate\tverifier\t^[-+]pkg[0-9]+ = [0-9.]+$\n' \
  > "$_spd_dir/proj/risk.tsv"
_spd_deps "$_spd_dir/early" 'pkg00000 = 2.0 --ignore=tests/test_judgment.py' 'pkg20000 = 2.0'
_spd_deps "$_spd_dir/late"  'pkg00000 = 2.0' 'pkg20000 = 2.0 --ignore=tests/test_judgment.py'
_spd_deps "$_spd_dir/clean" 'pkg00000 = 2.0' 'pkg20000 = 2.0'
if [ "$(git -C "$_spd_dir/early" diff -U0 HEAD~1 HEAD 2>/dev/null | wc -c | tr -d ' ')" -gt 262144 ] \
   && [ "$(git -C "$_spd_dir/late"  diff -U0 HEAD~1 HEAD 2>/dev/null | wc -c | tr -d ' ')" -gt 262144 ] \
   && [ "$(git -C "$_spd_dir/clean" diff -U0 HEAD~1 HEAD 2>/dev/null | wc -c | tr -d ' ')" -gt 262144 ]; then
  _spd_has "$_spd_n1" "$(_spd_esc "$_spd_dir/early" "$_spd_dir/proj")" "verifier${_spd_t}deps.txt" \
    "the line outside the confine was missed, the diff read as a version bump, and the row did not fire"
  _spd_has "$_spd_n2" "$(_spd_esc "$_spd_dir/late" "$_spd_dir/proj")" "verifier${_spd_t}deps.txt" \
    "the row did not fire on a line outside its confine that cannot be raced"
  is "$_spd_n3" "$(_spd_esc "$_spd_dir/clean" "$_spd_dir/proj")" ""
else
  _spd_nofix "the fixture was not built: three repositories each with a diff over 256 KB" \
    "$_spd_n1" "$_spd_n2" "$_spd_n3"
fi

# Destructive SQL in the added lines escapes as durable. The first added line of
# the whole diff is the first added line of its first file, so one new file with
# the statement on line 1 puts it first; the control puts it last.
#
# The statement and the row's pattern are put together at run time, never
# written whole here: this file's own added lines are what felix merge reads for
# destructive SQL, and a fixture spelled out would escape the branch that adds it.
_spd_stmt="$(printf '%s%s' 'DROP ' 'TABLE users;')"
_spd_sql() {
  mkdir -p "$1" && ( cd "$1" && git init -q -b main && printf 'notes\n' > README.md \
    && git add -A && git -c user.name=t -c user.email=t@t commit -qm base \
    && _SPD_W="$2" _SPD_S="$_spd_stmt" awk 'BEGIN { w = ENVIRON["_SPD_W"]; s = ENVIRON["_SPD_S"]
                    if (w == "first") print s
                    for (i = 1; i <= 20000; i++) printf "INSERT INTO t VALUES (%d);\n", i
                    if (w == "last") print s }' > seed.sql \
    && git add -A && git -c user.name=t -c user.email=t@t commit -qm change ) >/dev/null 2>&1
}
_spd_n4="destructive SQL on the first added line of a diff larger than a pipe still escapes as durable"
_spd_n5="destructive SQL on the last added line of a diff larger than a pipe escapes as durable"
mkdir -p "$_spd_dir/none"
_spd_sql "$_spd_dir/sqlfirst" first
_spd_sql "$_spd_dir/sqllast"  last
if [ "$(git -C "$_spd_dir/sqlfirst" diff HEAD~1 HEAD 2>/dev/null | wc -c | tr -d ' ')" -gt 262144 ] \
   && [ "$(git -C "$_spd_dir/sqllast" diff HEAD~1 HEAD 2>/dev/null | wc -c | tr -d ' ')" -gt 262144 ]; then
  _spd_has "$_spd_n4" "$(_spd_esc "$_spd_dir/sqlfirst" "$_spd_dir/none")" "durable${_spd_t}ADDED-LINES" \
    "the destructive statement was missed and the branch would merge without a person seeing it"
  _spd_has "$_spd_n5" "$(_spd_esc "$_spd_dir/sqllast" "$_spd_dir/none")" "durable${_spd_t}ADDED-LINES" \
    "a destructive statement that cannot be raced did not escape"
else
  _spd_nofix "the fixture was not built: two repositories each with a diff over 256 KB" "$_spd_n4" "$_spd_n5"
fi

# A content row raises the tier when its pattern is anywhere in the added lines.
# The row is the shipped template's destructive-SQL row; the added lines are
# handed to the pass directly, in the shape felix_classify_diff hands them.
_spd_cls() { ( . "$FROOT/harness/lib/classify.sh"; _felix_classify_pass "$1" "$2" "$3" ) 2>/dev/null; }
_spd_row="$(printf 'red\tcontent\t^\\+.*(DROP %s|TRUNC%s |DELETE %s [^W]*$)\tdestructive SQL' TABLE ATE FROM)"
_spd_big="$(awk 'BEGIN { for (i = 1; i <= 20000; i++) printf "+INSERT INTO t VALUES (%d);\n", i }')"
_spd_has "a content row matching the first of more added lines than a pipe holds still raises the tier" \
  "$(_spd_cls "$_spd_row" seed.sql "+$_spd_stmt
$_spd_big")" "red${_spd_t}ADDED-LINES${_spd_t}destructive SQL" \
  "the content row's match was missed and the diff kept the default tier"
_spd_has "a content row matching the last of more added lines than a pipe holds raises the tier" \
  "$(_spd_cls "$_spd_row" seed.sql "$_spd_big
+$_spd_stmt")" "red${_spd_t}ADDED-LINES${_spd_t}destructive SQL" \
  "a content row's match that cannot be raced did not raise the tier"

printf '\nmembership in a list larger than a pipe: coverage, candidates and gaps\n'
# Five engine tests asked whether a value was in a list by piping the list into
# grep -q under pipefail. grep stops reading at its first match; the writer's
# next write is SIGPIPE, pipefail makes the pipeline 141, and the test reads
# "not found" for a value that is present. Under load that happens now and
# then. It happens every time once the list is larger than a pipe holds and
# the match is early, because the writer is still blocked on a full pipe when
# grep leaves. So each list below is well over 256 KB with the value asked
# about on its first line, and beside each is the same question about the
# LAST line, which no early exit can miss: the control is what shows the
# fixture reaches the test, so a red here is the race and not a broken fixture.
_spm="$TMP/_spm"; mkdir -p "$_spm"
# Ninety characters of filler, so a few thousand names make a few hundred KB.
_spm_pad="$(awk 'BEGIN { s = sprintf("%090d", 0); gsub(/0/, "x", s); print s }')"
_spm_nl='
'
# Whole-line membership in captured output, read without a pipe.
_spm_line() { case "$_spm_nl$1$_spm_nl" in *"$_spm_nl$2$_spm_nl"*) return 0 ;; esac; return 1; }
# The rows of captured output whose column $3 is $2, for a failure message.
_spm_rows() { _SPM_K="$2" awk -F'\t' -v c="$3" '$c == ENVIRON["_SPM_K"]' <<<"$1" | tr '\n' ' '; }
# The first line of a value.
_spm_first() { printf '%s' "${1%%"$_spm_nl"*}"; }

# ------------------------------------------------------------- fixtures ----
# felix_coverage_check reads the events a hooks file binds. 3,000 filler
# events sit between the one bound first and the one bound last.
_spm_cov="$_spm/cov"; mkdir -p "$_spm_cov"
awk -v pad="$_spm_pad" 'BEGIN {
  printf "{\"hooks\": {\n  \"SpmFirstBound\": [],\n"
  for (i = 1; i <= 3000; i++) printf "  \"SpmFiller%s%05d\": [],\n", pad, i
  printf "  \"SpmLastBound\": []\n}}\n" }' > "$_spm_cov/hooks.json"

# felix_coverage_unconsidered reads the events a stance table lists, against
# what this machine binds. A fixture HOME binds the table's first event, its
# last, and one it never lists.
_spm_unc="$_spm/unc"; _spm_home="$_spm/home"; mkdir -p "$_spm_unc" "$_spm_home/.claude"
awk -v pad="$_spm_pad" 'BEGIN {
  printf "SpmFirstKnown\twired\tthe first row\n"
  for (i = 1; i <= 3000; i++) printf "SpmRow%s%05d\tdeclined\tfiller\n", pad, i
  printf "SpmLastKnown\twired\tthe last row\n" }' > "$_spm_unc/lifecycle.tsv"
printf '{"hooks":{"SpmFirstKnown":[],"SpmLastKnown":[],"SpmNeverListed":[]}}\n' \
  > "$_spm_home/.claude/settings.json"

# felix_candidates_rules reads the admitted obligation names, then the
# declared probe names after a C-locale sort. Zero-padded, so the sort keeps
# 00001 first and 09000 last. Memory is a root of this block's own.
_spm_cp="$_spm/spm-cand"; _spm_cr="$_spm/spm-cand-repo"; _spm_cmem="$_spm/mem"
mkdir -p "$_spm_cp" "$_spm_cr" "$_spm_cmem/spm-cand/commission"
awk 'BEGIN { for (i = 1; i <= 9000; i++)
  printf "spm_admitted_obligation_name_%05d\tADVISORY\tdeterministic\t-\ttrue\n", i }' \
  > "$_spm_cp/obligations.tsv"
awk 'BEGIN { for (i = 1; i <= 9000; i++)
  printf "spm_declared_probe_ground_name_%05d\t-\t-\tls\ttrue\n", i }' > "$_spm_cp/probes.tsv"
_spm_c1="$(printf 'spm_admitted_obligation_name_00001\tADVISORY\t-\ttrue\tspm_declared_probe_ground_name_09000\tunread\trepeats the first admitted row')"
_spm_c2="$(printf 'spm_admitted_obligation_name_09000\tADVISORY\t-\ttrue\tspm_declared_probe_ground_name_09000\tunread\trepeats the last admitted row')"
_spm_c3="$(printf 'spm_grounded_on_first\tADVISORY\t-\ttrue\tspm_declared_probe_ground_name_00001\tunread\tgrounded on the first declared probe')"
_spm_c4="$(printf 'spm_grounded_on_last\tADVISORY\t-\ttrue\tspm_declared_probe_ground_name_09000\tunread\tgrounded on the last declared probe')"
printf '# topology -\n# epoch -\n%s\n%s\n%s\n%s\ndone\t4\n' "$_spm_c1" "$_spm_c2" "$_spm_c3" "$_spm_c4" \
  > "$_spm_cmem/spm-cand/commission/obligations_surveyed.tsv"

# felix_commission_gaps reads awk's rows for one capability. One capability
# has 6,000 stack rows; another has one, the file's last.
_spm_gp="$_spm/gap-proj"; _spm_gr="$_spm/gap-repo"; mkdir -p "$_spm_gp" "$_spm_gr"
printf 'spmcapmany\nspmcaplast\n' > "$_spm_gp/capabilities"
awk 'BEGIN { for (i = 1; i <= 6000; i++)
  printf "plugin\tspm-served-plugin-%05d\tspm-marketplace\tlow\tspmcapmany\n", i
  printf "plugin\tspm-served-last\tspm-marketplace\tlow\tspmcaplast\n" }' > "$_spm_gp/stack.tsv"

# The lists each test reads, measured here from the fixtures: every one is
# well past a pipe's 64 KB, with the value asked about on its first line.
_spm_short=""
_spm_fits() { [ "${#2}" -ge 262144 ] && [ "$(_spm_first "$2" | cut -f1-2)" = "$3" ] \
                || _spm_short="$_spm_short $1 (${#2} bytes, first [$(_spm_first "$2" | cut -c1-40)])"; }
_spm_fits felix_coverage_check "$( . "$FROOT/harness/lib/coverage.sh"; felix_hooks_events "$_spm_cov/hooks.json" )" \
          SpmFirstBound
_spm_fits felix_coverage_unconsidered "$(cut -f1 "$_spm_unc/lifecycle.tsv")" SpmFirstKnown
_spm_fits felix_candidates_rules:admitted "$(cut -f1 "$_spm_cp/obligations.tsv")" spm_admitted_obligation_name_00001
_spm_fits felix_candidates_rules:grounds "$(cut -f1 "$_spm_cp/probes.tsv" | LC_ALL=C sort -u)" \
          spm_declared_probe_ground_name_00001
_spm_fits felix_commission_gaps "$(awk -F'\t' '$5 == "spmcapmany"' "$_spm_gp/stack.tsv")" \
          "$(printf 'plugin\tspm-served-plugin-00001')"
[ -z "$_spm_short" ] \
  && ok  "every membership fixture below holds more than 256 KB with the value asked about on its first line" \
  || bad "every membership fixture below holds more than 256 KB with the value asked about on its first line" \
         "too small or out of order, so a pass below would prove nothing:$_spm_short"

# ---------------------------------------- felix_coverage_check, declined ----
printf 'SpmFirstBound\tdeclined\tnothing to add\nSpmLastBound\tdeclined\tnothing to add\n' \
  > "$_spm_cov/lifecycle.tsv"
_spm_out="$( . "$FROOT/harness/lib/coverage.sh"; felix_coverage_check "$_spm_cov" "$_spm_cov/hooks.json" )"
_spm_line "$_spm_out" "missing	SpmFirstBound	declined, yet something wires it" \
  && ok  "a declined moment wired as the first of 3,000 bound events reads missing" \
  || bad "a declined moment wired as the first of 3,000 bound events reads missing" \
         "got [$(_spm_rows "$_spm_out" SpmFirstBound 2)]: grep -q left at line 1, the bound list's writer died of SIGPIPE, pipefail read the binding as absent, and a decline something wires passed as ok"
_spm_line "$_spm_out" "missing	SpmLastBound	declined, yet something wires it" \
  && ok  "a declined moment wired as the last of 3,000 bound events reads missing" \
  || bad "a declined moment wired as the last of 3,000 bound events reads missing" \
         "got [$(_spm_rows "$_spm_out" SpmLastBound 2)]: the fixture does not reach the coverage check"

# ------------------------------------------ felix_coverage_check, wired ----
printf 'SpmFirstBound\twired\trefuse completion\nSpmLastBound\twired\trefuse completion\n' \
  > "$_spm_cov/lifecycle.tsv"
_spm_out="$( . "$FROOT/harness/lib/coverage.sh"; felix_coverage_check "$_spm_cov" "$_spm_cov/hooks.json" )"
_spm_line "$_spm_out" "ok	SpmFirstBound	refuse completion" \
  && ok  "a wired moment bound as the first of 3,000 bound events reads ok" \
  || bad "a wired moment bound as the first of 3,000 bound events reads ok" \
         "got [$(_spm_rows "$_spm_out" SpmFirstBound 2)]: the early exit read a binding that is there as absent, and a wired hook was reported as nothing wiring it"
_spm_line "$_spm_out" "ok	SpmLastBound	refuse completion" \
  && ok  "a wired moment bound as the last of 3,000 bound events reads ok" \
  || bad "a wired moment bound as the last of 3,000 bound events reads ok" \
         "got [$(_spm_rows "$_spm_out" SpmLastBound 2)]: the fixture does not reach the coverage check"

# ------------------------------------------- felix_coverage_unconsidered ----
_spm_out="$( HOME="$_spm_home"; . "$FROOT/harness/lib/coverage.sh"; felix_coverage_unconsidered "$_spm_unc" )"
_spm_line "$_spm_out" "SpmFirstKnown" \
  && bad "a bound moment on the first row of a 3,000-row stance table is not named unconsidered" \
         "it was named: grep -q left at row 1, the table's writer died of SIGPIPE, and a moment the table considers read as one it has never heard of" \
  || ok  "a bound moment on the first row of a 3,000-row stance table is not named unconsidered"
_spm_line "$_spm_out" "SpmLastKnown" \
  && bad "a bound moment on the last row of a 3,000-row stance table is not named unconsidered" \
         "it was named, so the fixture does not reach the membership test: got [$(printf '%s' "$_spm_out" | tr '\n' ' ')]" \
  || ok  "a bound moment on the last row of a 3,000-row stance table is not named unconsidered"
_spm_line "$_spm_out" "SpmNeverListed" \
  && ok  "a bound moment the 3,000-row stance table never lists is named unconsidered" \
  || bad "a bound moment the 3,000-row stance table never lists is named unconsidered" \
         "got [$(printf '%s' "$_spm_out" | tr '\n' ' ')]: the fixture HOME's bindings were not read"

# -------------------------------------------------- felix_candidates_rules ----
_spm_out="$( ( FELIX_MEMORY="$_spm_cmem"
               . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/probes.sh"
               . "$FROOT/harness/lib/obligations.sh"; . "$FROOT/harness/lib/epoch.sh"
               . "$FROOT/harness/lib/candidates.sh"
               felix_candidates_rules "$_spm_cp" "$_spm_cr" ) 2>/dev/null )"
_spm_line "$_spm_out" "refuse	spm_admitted_obligation_name_00001	already admitted in obligations.tsv" \
  && ok  "a candidate repeating the first of 9,000 admitted obligations is refused as already admitted" \
  || bad "a candidate repeating the first of 9,000 admitted obligations is refused as already admitted" \
         "got [$(_spm_rows "$_spm_out" spm_admitted_obligation_name_00001 2)]: the early exit read an admitted name as absent, and a duplicate of the ledger went on toward acceptance"
_spm_line "$_spm_out" "refuse	spm_admitted_obligation_name_09000	already admitted in obligations.tsv" \
  && ok  "a candidate repeating the last of 9,000 admitted obligations is refused as already admitted" \
  || bad "a candidate repeating the last of 9,000 admitted obligations is refused as already admitted" \
         "got [$(_spm_rows "$_spm_out" spm_admitted_obligation_name_09000 2)]: the fixture does not reach the admitted test"
_spm_line "$_spm_out" "accept	$_spm_c3" \
  && ok  "a candidate grounded on the first of 9,000 declared probes is accepted" \
  || bad "a candidate grounded on the first of 9,000 declared probes is accepted" \
         "got [$(_spm_rows "$_spm_out" spm_grounded_on_first 2)]: the early exit read a declared probe as undeclared, and a grounded proposal was refused as a fabrication"
_spm_line "$_spm_out" "accept	$_spm_c4" \
  && ok  "a candidate grounded on the last of 9,000 declared probes is accepted" \
  || bad "a candidate grounded on the last of 9,000 declared probes is accepted" \
         "got [$(_spm_rows "$_spm_out" spm_grounded_on_last 2)]: the fixture does not reach the grounds test"

# -------------------------------------------------- felix_commission_gaps ----
_spm_out="$( ( . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/detect.sh"
               . "$FROOT/harness/lib/stack.sh"; . "$FROOT/harness/lib/probes.sh"
               . "$FROOT/harness/lib/verify.sh"; . "$FROOT/harness/lib/toolbox.sh"
               . "$FROOT/harness/lib/commission.sh"
               felix_commission_gaps "$_spm_gp" "$_spm_gr" ) 2>/dev/null )"
_spm_line "$_spm_out" "spmcapmany	yes	no	no" \
  && ok  "a capability 6,000 stack rows serve is reported served among the gaps" \
  || bad "a capability 6,000 stack rows serve is reported served among the gaps" \
         "got [$(_spm_rows "$_spm_out" spmcapmany 1)]: grep -q left at awk's first row, awk died of SIGPIPE, and a served capability was named a gap"
_spm_line "$_spm_out" "spmcaplast	yes	no	no" \
  && ok  "a capability only the last stack row serves is reported served among the gaps" \
  || bad "a capability only the last stack row serves is reported served among the gaps" \
         "got [$(_spm_rows "$_spm_out" spmcaplast 1)]: the fixture does not reach the served test"

printf '\nthe ledger, the grant listing and the pre-flight read a long list to its end\n'
# Each of these asked whether a value is one line of a list by piping the list
# into `grep -q`, under the suite's and the engine's `set -o pipefail`. grep
# stops reading at its first match; the writer's next write then meets a closed
# pipe, the writer dies of SIGPIPE, pipefail makes the pipeline 141, and the
# test reads "not there" for a line that is there. Past a pipe's capacity
# (64 KB) with the match on an early line that happens every time, so each
# fixture below holds a list of several hundred KB with the line asked about
# first, beside the same fixture with it last: the last line can never be
# missed this way, so the second says the fixture reaches the test at all.
_spg_root="$TMP/_spg"
mkdir -p "$_spg_root"

# The sessions nobody typed into. _felix_ledger_machine_sessions prints them
# from says.log in awk's own order, so which session is first and which is last
# is read from what it prints, not assumed. A home holds one of those sessions
# unfolded beside a person's, and both belong to this fixture's repository, so
# the walk reaches the membership test for each.
_spg_L="$_spg_root/ledger"
_spg_LP="$_spg_L/proj/spgledger"
mkdir -p "$_spg_L/mem/spgledger" "$_spg_LP" "$_spg_L/repo"
( cd "$_spg_L/repo" && git init -q -b main \
  && git -c user.name=t -c user.email=t@t commit -q --allow-empty -m spg )
_spg_sha="$(git -C "$_spg_L/repo" rev-parse HEAD 2>/dev/null)"
# The opening's first 200 characters as a brief row keeps them, read from
# route.sh rather than copied, with a stamp before the day it gives.
_spg_open="$( . "$FROOT/harness/lib/route.sh"; printf '%s' "${_FELIX_ROUTE_SESSION_REQUESTS[0]:0:200}" )"
_SPG_OPEN="$_spg_open" LC_ALL=C awk 'BEGIN {
    o = ENVIRON["_SPG_OPEN"]
    for (i = 1; i <= 8000; i++)
      printf "2026-09-10T08:00:00Z\tbrief\tspg-machine-%05d-0123456789abcdef0123456789\t%s\tUse this now\n", i, o
  }' > "$_spg_L/mem/spgledger/says.log"
_spg_machine() { ( FELIX_MEMORY="$_spg_L/mem"; export FELIX_MEMORY
                   . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/ledger.sh"
                   _felix_ledger_machine_sessions "$_spg_LP" ) 2>/dev/null; }
_spg_ms="$(_spg_machine)"
_spg_m1="$(printf '%s\n' "$_spg_ms" | sed -n 1p)"
_spg_mN="$(printf '%s\n' "$_spg_ms" | sed -n '$p')"
if [ "${#_spg_ms}" -gt 262144 ] && [ -n "$_spg_m1" ] && [ -n "$_spg_mN" ] && [ "$_spg_m1" != "$_spg_mN" ] \
   && [ -n "$_spg_sha" ]; then
  ok  "the machine-session fixture lists more than a pipe holds, with a first and a last session"
else
  bad "the machine-session fixture lists more than a pipe holds, with a first and a last session" \
      "${#_spg_ms} bytes, first [$_spg_m1], last [$_spg_mN], sha [$_spg_sha]"
fi
_spg_home() {    # dir, machine session, person session: two unfolded sessions this repository owns
  mkdir -p "$1/state/ledger" "$1/state/session"
  printf '%s\n' "$_spg_sha" > "$1/state/session/$2"
  printf '%s\n' "$_spg_sha" > "$1/state/session/$3"
  printf 'named\tsuperpowers:systematic-debugging\n' > "$1/state/ledger/$2.tsv"
  printf 'tool\tRead\n' > "$1/state/ledger/$3.tsv"
}
_spg_home "$_spg_L/first" "$_spg_m1" spg-person-first
_spg_home "$_spg_L/last"  "$_spg_mN" spg-person-last
# Sourced the way session-start sources it, ledger.sh without route.sh.
_spg_ledger() {  # fn, home
  ( FELIX_MEMORY="$_spg_L/mem"; export FELIX_MEMORY
    . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/ledger.sh"
    "$1" "$_spg_LP" "$2" "$_spg_L/repo" ) 2>&1
}
_spg_out="$(_spg_ledger felix_ledger_stranded "$_spg_L/first")"
[ "$_spg_out" = "1" ] \
  && ok  "session-start does not count the first of many machine sessions as stranded, only the person's beside it" \
  || bad "session-start does not count the first of many machine sessions as stranded, only the person's beside it" \
         "counted [$_spg_out], expected [1]: the machine session was missed in the list and counted stranded, so the banner carries a caveat it did not need"
is "nor the last of many machine sessions" \
   "$(_spg_ledger felix_ledger_stranded "$_spg_L/last")" "1"
_spg_out="$(_spg_ledger felix_ledger_catchup "$_spg_L/first")"
[ "$_spg_out" = "1" ] \
  && ok  "felix ledger folds the person's session and passes over the first of many machine sessions" \
  || bad "felix ledger folds the person's session and passes over the first of many machine sessions" \
         "folded [$_spg_out], expected [1]: the machine session was missed in the list and rolled up with the person's"
[ -f "$_spg_L/mem/spgledger/ledger.d/$_spg_m1.tsv" ] \
  && bad "and writes no fold for that machine session into memory" \
         "ledger.d/$_spg_m1.tsv was written: the session was missed in the list and rolled up" \
  || ok  "and writes no fold for that machine session into memory"
[ -f "$_spg_L/mem/spgledger/ledger.d/spg-person-first.tsv" ] \
  && ok  "while the person's session beside that machine session is folded" \
  || bad "while the person's session beside that machine session is folded" "no ledger.d/spg-person-first.tsv"
_spg_out="$(_spg_ledger felix_ledger_catchup "$_spg_L/last")"
if [ "$_spg_out" = "1" ] && [ ! -f "$_spg_L/mem/spgledger/ledger.d/$_spg_mN.tsv" ] \
   && [ -f "$_spg_L/mem/spgledger/ledger.d/spg-person-last.tsv" ]; then
  ok  "and felix ledger passes over the last of many machine sessions the same way"
else
  bad "and felix ledger passes over the last of many machine sessions the same way" \
      "folded [$_spg_out]; $(ls "$_spg_L/mem/spgledger/ledger.d" 2>/dev/null | tr '\n' ' ')"
fi

# Grants at the base ref, against what this tree holds. A row the base holds is
# merged, whatever else the base holds; listed as written-and-not-merged it
# tells the person a grant is not yet one when it is. The base holds thousands
# of well-formed rows; this tree holds one of them and one row of its own, and
# only its own is unmerged.
_spg_X="$_spg_root/exc"
mkdir -p "$_spg_X/projects/spgexc"
LC_ALL=C awk 'BEGIN {
    for (i = 1; i <= 8000; i++)
      printf "spg-grant-%05d\t0123456789abcdef\t2027-06-30T12:00:00Z\tfounder\ta grant the fixture merged, number %05d\n", i, i
  }' > "$_spg_X/projects/spgexc/exceptions.tsv"
( cd "$_spg_X" && git init -q -b main && git add projects \
  && git -c user.name=t -c user.email=t@t commit -q -m spg \
  && git update-ref refs/remotes/origin/main HEAD )
_spg_XP="$_spg_X/projects/spgexc"
_spg_x1="$(sed -n 1p "$_spg_XP/exceptions.tsv")"
_spg_xN="$(sed -n '$p' "$_spg_XP/exceptions.tsv")"
_spg_xnew="$(printf 'spg-written\t0123456789abcdef\t2027-06-30T12:00:00Z\tfounder\twritten here and not merged')"
_spg_xbase="$( . "$FROOT/harness/lib/exceptions.sh"; felix_exceptions_at_base "$_spg_XP" 2>/dev/null )"
if [ "${#_spg_xbase}" -gt 262144 ] && [ "$(printf '%s\n' "$_spg_xbase" | sed -n 1p)" = "$_spg_x1" ]; then
  ok  "the grant fixture's base ref holds more than a pipe holds, starting with the row asked about"
else
  bad "the grant fixture's base ref holds more than a pipe holds, starting with the row asked about" \
      "${#_spg_xbase} bytes at refs/remotes/origin/main"
fi
_spg_unmerged() { ( . "$FROOT/harness/lib/exceptions.sh"; felix_exceptions_unmerged "$_spg_XP" ) 2>&1; }
printf '%s\n%s\n' "$_spg_x1" "$_spg_xnew" > "$_spg_XP/exceptions.tsv"
_spg_out="$(_spg_unmerged)"
[ "$_spg_out" = "$_spg_xnew" ] \
  && ok  "a grant merged first among thousands is not listed as written and not merged" \
  || bad "a grant merged first among thousands is not listed as written and not merged" \
         "listed [$_spg_out]: the merged grant was missed at the base ref and shown as not yet a grant"
printf '%s\n%s\n' "$_spg_xN" "$_spg_xnew" > "$_spg_XP/exceptions.tsv"
is "nor a grant merged last among thousands" \
   "$(_spg_unmerged)" "$_spg_xnew"

# The pre-flight's second look, for a plugin compiled into the binary. The CLI
# here is a stand-in that lists nothing, so the only answer is the inventory's:
# several hundred KB of plugins, the one asked about first, and then last. This
# one could not miss even through the pipe: felix_ready_inventory ends in
# `return 0`, so the sort that dies of SIGPIPE under an early match is not the
# status pipefail reads. So these are not red on the old engine; they hold that
# the test which replaces the pipe keeps the verdict at this size.
_spg_R="$_spg_root/ready"
mkdir -p "$_spg_R/bin" "$_spg_R/home/.claude/plugins" "$_spg_R/proj"
printf '#!/bin/sh\nprintf "[]\\n"\n' > "$_spg_R/bin/claude"; chmod +x "$_spg_R/bin/claude"
{ printf '{\n  "version": 2,\n  "plugins": {\n'
  printf '    "spga@spgmkt": [\n      {}\n    ],\n'
  LC_ALL=C awk 'BEGIN { for (i = 1; i <= 16000; i++) printf "    \"spgm%05d-bundled-filler@spgmkt\": [\n      {}\n    ],\n", i }'
  printf '    "spgz@spgmkt": [\n      {}\n    ]\n  }\n}\n'
} > "$_spg_R/home/.claude/plugins/installed_plugins.json"
_spg_inv="$( HOME="$_spg_R/home" PATH="$_spg_R/bin:/usr/bin:/bin"
             . "$FROOT/harness/lib/ready.sh"; felix_ready_inventory 2>/dev/null )"
if [ "${#_spg_inv}" -gt 262144 ] \
   && [ "$(printf '%s\n' "$_spg_inv" | sed -n 1p)" = "plugin	spga" ] \
   && [ "$(printf '%s\n' "$_spg_inv" | sed -n '$p')" = "plugin	spgz" ]; then
  ok  "the pre-flight fixture's inventory holds more than a pipe holds, the plugin asked about first and last"
else
  bad "the pre-flight fixture's inventory holds more than a pipe holds, the plugin asked about first and last" \
      "${#_spg_inv} bytes, first [$(printf '%s\n' "$_spg_inv" | sed -n 1p)], last [$(printf '%s\n' "$_spg_inv" | sed -n '$p')]"
fi
_spg_ready() {   # owner: the report for one play of that owner, declared in stack.tsv
  printf 'plugin\t%s@spgmkt\t-\tlow\talways\n' "$1" > "$_spg_R/proj/stack.tsv"
  printf 'spgroute\tspg\tcore\t%s:thing\n' "$1" > "$_spg_R/proj/routes.tsv"
  ( HOME="$_spg_R/home" PATH="$_spg_R/bin:/usr/bin:/bin"
    . "$FROOT/harness/lib/ready.sh"; felix_ready_report "$_spg_R/proj" ) 2>&1
}
is "a bundled plugin first among many in the inventory reads as usable" \
   "$(_spg_ready spga)" "usable	spga:thing	bundled, live in every session"
is "and a bundled plugin last among them" \
   "$(_spg_ready spgz)" "usable	spgz:thing	bundled, live in every session"

printf '\nthe CLI reads an answer to its end before it decides on it\n'
# Three CLI verdicts rested on `producer | grep -q`, and under pipefail that
# reads "absent" whenever grep matches and leaves while the producer still has
# lines to write: the producer's next write is EPIPE, it dies 141, and the
# pipeline's status is 141. Each fixture below makes the producer's output far
# larger than a pipe holds with the match on its first line, which turns the
# race into a certainty, and pairs it with the same call whose match is on the
# LAST line, which no reader can leave early. The pair is what keeps a red here
# honest: a fixture the engine rejected for some other reason would fail the
# control too.
#
# A home and a memory root of this block's own, so no project the rest of the
# suite counts or iterates gains a neighbour.
_spc_home="$TMP/_spc_home"; _spc_mem="$TMP/_spc_mem"; _spc_kc="$TMP/_spc_kc"
_spc_proj="$_spc_home/projects/_spc_cli"
mkdir -p "$_spc_proj" "$_spc_mem"
printf '{"name":"_spc_cli","gate":"true"}\n' > "$_spc_proj/project.json"
printf '# _spc_cli\n' > "$_spc_proj/CLAUDE.md"
_spc_repo="$TMP/_spc_repo"; mkdir -p "$_spc_repo"
( cd "$_spc_repo" && git init -q -b main && printf '_spc_cli\n' > .felix && printf 'x\n' > a.txt \
  && git add -A >/dev/null && git -c user.name=t -c user.email=t@t commit -qm base >/dev/null )
_spc_repo="$(cd "$_spc_repo" && pwd -P)"
_spc_felix() { ( _spc_at="$1"; shift; cd "$_spc_at" || exit 99
                 FELIX_KERNEL='' FELIX_KERNEL_CACHE="$_spc_kc" FELIX_HOME="$_spc_home" FELIX_MEMORY="$_spc_mem" \
                   "$FELIX" "$@" ); }

# felix maintenance --ran. The name is checked against `_felix_maint_rows | cut
# -f1`, and a false miss dies `no routine named X` for a routine the table
# declares, so a run that happened goes unrecorded.
awk 'BEGIN { for (i = 1; i <= 20000; i++) printf "routine-%06d\t7\talways\tupkeep number %d\n", i, i }' \
  > "$_spc_proj/maintenance.tsv"
_spc_n="$(cut -f1 "$_spc_proj/maintenance.tsv" | wc -c | tr -d ' ')"
[ "${_spc_n:-0}" -ge 262144 ] \
  && ok "the maintenance fixture names more routines than a pipe holds" \
  || bad "the maintenance fixture names more routines than a pipe holds" "only ${_spc_n:-0} bytes of names"
_spc_out="$(_spc_felix "$_spc_repo" maintenance --ran routine-000001 2>&1)"; _spc_rc=$?
if [ "$_spc_rc" -eq 0 ] && grep -q '^routine-000001	' "$_spc_proj/maintenance.log" 2>/dev/null; then
  has "a run of the first routine is recorded however many routines follow it" "$_spc_out" "recorded a run of routine-000001"
else
  bad "a run of the first routine is recorded however many routines follow it" \
      "the routine is row 1 of the table and the run was refused and not logged (rc=$_spc_rc): $_spc_out"
fi
_spc_out="$(_spc_felix "$_spc_repo" maintenance --ran routine-020000 2>&1)"; _spc_rc=$?
if [ "$_spc_rc" -eq 0 ] && grep -q '^routine-020000	' "$_spc_proj/maintenance.log" 2>/dev/null; then
  has "and a run of the last routine is recorded too" "$_spc_out" "recorded a run of routine-020000"
else
  bad "and a run of the last routine is recorded too" "rc=$_spc_rc: $_spc_out"
fi
# A routine name is one line. A value holding a newline names no routine, even
# when its lines are two routines next to each other in the table: logged, it
# leaves a line with no epoch, and that routine reads as never run. The lines
# are the table's last two, so no early exit is what refuses them.
_spc_out="$(_spc_felix "$_spc_repo" maintenance --ran "$(printf 'routine-019999\nroutine-020000')" 2>&1)"; _spc_rc=$?
if [ "$_spc_rc" -ne 0 ] && ! grep -q '^routine-019999' "$_spc_proj/maintenance.log" 2>/dev/null; then
  ok  "a routine name holding a newline is refused, even when its lines are two adjacent routines"
else
  bad "a routine name holding a newline is refused, even when its lines are two adjacent routines" \
      "the two-line name was taken for a routine and logged, leaving a line with no epoch (rc=$_spc_rc): $_spc_out"
fi

# felix evidence. A base that resolves to nothing yields one `unknown` row and
# no other, and the report must end on it and exit 1 (#63). A false miss falls
# through to the rendering, which has no arm for `unknown`, and signs off with
# "No evidence gaps." and exit 0: the false all-clear #56 removed. The row is
# multi-line only when the base NAME holds newlines — nothing else puts text
# after it — so that is the fixture.
#
# Sourced and called rather than executed, and only for this one: Linux caps a
# single argv string at 128 KB (MAX_ARG_STRLEN), under the margin that makes
# the race certain, and a refusal from execve would be red for the wrong
# reason. The git calls inside meet the same cap there and fail, which reads
# as "does not resolve" — the answer this base gets anyway.
printf 'unit\t^src/\t^tests?/\tcode changes need a test\n' > "$_spc_proj/evidence.tsv"
_spc_big="$(awk 'BEGIN { for (i = 1; i <= 20000; i++) printf "no-such-ref-%06d\n", i }')"
_spc_one="$(printf '%s' "$_spc_big" | tr '\n' '-')"
[ "${#_spc_big}" -ge 262144 ] \
  && ok "the evidence fixture's base is larger than a pipe holds" \
  || bad "the evidence fixture's base is larger than a pipe holds" "only ${#_spc_big} bytes"
_spc_ev() { ( _spc_b="$1"; cd "$_spc_repo" || exit 99
              export FELIX_HOME="$_spc_home" FELIX_MEMORY="$_spc_mem"
              . "$FELIX" help >/dev/null 2>&1
              cmd_evidence --base "$_spc_b" ) > "$TMP/_spc_ev.out" 2>&1; }
_spc_ev "$_spc_big"; _spc_rc=$?
_spc_tail="$(tail -n 4 "$TMP/_spc_ev.out")"
case "$_spc_rc:$_spc_tail" in
  *"No evidence gaps"*)
    bad "an unknown evidence row is not an all-clear however much text follows it" \
        "the unknown row was missed and the report signed off (rc=$_spc_rc): $_spc_tail" ;;
  "1:"*"Nothing was compared"*)
    ok  "an unknown evidence row is not an all-clear however much text follows it" ;;
  *)
    bad "an unknown evidence row is not an all-clear however much text follows it" "rc=$_spc_rc: $_spc_tail" ;;
esac
# The control: the same base, the same size, as one line. One line is the last
# line, and grep cannot call it matched before it has read all of it.
_spc_ev "$_spc_one"; _spc_rc=$?
_spc_tail="$(tail -n 4 "$TMP/_spc_ev.out")"
case "$_spc_rc:$_spc_tail" in
  "1:"*"Nothing was compared"*) ok  "and a base of the same size on one line is reported unknown too" ;;
  *)                            bad "and a base of the same size on one line is reported unknown too" "rc=$_spc_rc: $_spc_tail" ;;
esac

# felix merge. A self-governed branch that touches engine/harness/ is refused
# when the judge is byte-identical to the tree it judges. The test reads
# felix_changed_paths, which ends in `sort -u`, and a false miss skips the
# refusal: the candidate is judged by itself. Two checkouts that differ only in
# where the engine path sorts among 700 long changed paths — first, under zz/,
# and last, under aa/. The engine in them is one file, so main's missing
# resolve.sh is what the next check trips on if this one is skipped, and
# nothing here reaches a receipt or gh.
_spc_mgrepo() {   # dir, top directory of the filler
  _spc_d="$1"; _spc_top="$2"; _spc_i=1
  mkdir -p "$_spc_d/engine/.claude-plugin" "$_spc_d/engine/harness/lib"
  printf '{ "version": "1.0.0" }\n' > "$_spc_d/engine/.claude-plugin/plugin.json"
  printf '# judged\n' > "$_spc_d/engine/harness/lib/x.sh"
  printf '_spc_cli\n' > "$_spc_d/.felix"
  ( cd "$_spc_d" && git init -q -b main && git add -A >/dev/null \
    && git -c user.name=t -c user.email=t@t commit -qm base >/dev/null && git checkout -q -b feature )
  printf -v _spc_long '%0200d' 0
  mkdir -p "$_spc_d/$_spc_top/$_spc_long"
  while [ "$_spc_i" -le 700 ]; do
    printf -v _spc_f 'f%0199d' "$_spc_i"; : > "$_spc_d/$_spc_top/$_spc_long/$_spc_f"
    _spc_i=$((_spc_i + 1))
  done
  printf '# candidate edit\n' >> "$_spc_d/engine/harness/lib/x.sh"
  ( cd "$_spc_d" && git add -A >/dev/null && git -c user.name=t -c user.email=t@t commit -qm candidate >/dev/null )
}
_spc_early="$TMP/_spc_mg_early"; _spc_late="$TMP/_spc_mg_late"
_spc_mgrepo "$_spc_early" zz; _spc_mgrepo "$_spc_late" aa
_spc_early="$(cd "$_spc_early" && pwd -P)"; _spc_late="$(cd "$_spc_late" && pwd -P)"
# The judge for main's version, cut from the candidate: identical to the tree.
mkdir -p "$_spc_kc/1.0.0"
cp -R "$_spc_early/engine/harness" "$_spc_kc/1.0.0/harness"
git -C "$_spc_early" diff --name-only --no-renames 'HEAD~1...HEAD' | LC_ALL=C sort -u > "$TMP/_spc_mg.paths"
_spc_n="$(wc -c < "$TMP/_spc_mg.paths" | tr -d ' ')"; _spc_first="$(head -1 "$TMP/_spc_mg.paths")"
if [ "${_spc_n:-0}" -ge 262144 ] && [ "$_spc_first" = "engine/harness/lib/x.sh" ]; then
  ok "the merge fixture changes more paths than a pipe holds, the engine's first"
else
  bad "the merge fixture changes more paths than a pipe holds, the engine's first" "${_spc_n:-0} bytes, first: $_spc_first"
fi
_spc_felix "$_spc_early" merge --base HEAD~1 > "$TMP/_spc_mg.out" 2>&1; _spc_rc=$?
if [ "$_spc_rc" -eq 1 ] && grep -q 'judging itself' "$TMP/_spc_mg.out"; then
  ok "a judge identical to the tree is refused when the engine path sorts first of many"
else
  bad "a judge identical to the tree is refused when the engine path sorts first of many" \
      "the engine change was missed and the candidate went on to be judged by itself (rc=$_spc_rc): $(cat "$TMP/_spc_mg.out")"
fi
_spc_felix "$_spc_late" merge --base HEAD~1 > "$TMP/_spc_mg.out" 2>&1; _spc_rc=$?
if [ "$_spc_rc" -eq 1 ] && grep -q 'judging itself' "$TMP/_spc_mg.out"; then
  ok "and the judge is refused when the engine path sorts last"
else
  bad "and the judge is refused when the engine path sorts last" "rc=$_spc_rc: $(cat "$TMP/_spc_mg.out")"
fi

printf '\nqualification, commissioning, adoption, the ledger and routes read a long list to its end\n'
# Eight more engine tests asked whether a value is one line of a list by piping
# the list into grep under pipefail. Two used grep -q (qualify.sh). Six used a
# grep with no early option and its standard output on /dev/null, which GNU
# grep, the grep on Linux, treats as -q: it stops at its first match. Either
# way the writer's next write meets a closed pipe, it dies of SIGPIPE, pipefail
# makes the pipeline 141, and a line that is there reads as absent. Past a
# pipe's 64 KB with the match early that happens every time, so each list below
# is well over 256 KB with the line asked about first, beside the same question
# about the LAST line, which no early exit can miss: that control is what shows
# the fixture reaches the test, so a red is the race and not a broken fixture.
# Two more readers kept a first line with head, and are at the end.
_spa="$TMP/_spa"; mkdir -p "$_spa"
_spa_nl='
'
# Whole-line membership in captured output, read without a pipe.
_spa_line() { case "$_spa_nl$1$_spa_nl" in *"$_spa_nl$2$_spa_nl"*) return 0 ;; esac; return 1; }
_spa_first() { printf '%s' "${1%%"$_spa_nl"*}"; }
_spa_last()  { printf '%s' "${1##*"$_spa_nl"}"; }
# The rows of captured output whose column $3 is $2, for a failure message.
_spa_rows()  { _SPA_K="$2" awk -F'\t' -v c="$3" '$c == ENVIRON["_SPA_K"]' <<<"$1" | cut -c1-120 | tr '\n' ' '; }
# Ninety characters of filler, so a few thousand names make a few hundred KB.
_spa_pad="$(awk 'BEGIN { s = sprintf("%090d", 0); gsub(/0/, "x", s); print s }')"

# ------------------------------------------------------------- fixtures ----
# felix_qualify_missing_controls reads one checker's declared controls. Its
# first row declares violation, 25,000 declare restoration, and its last row
# declares irrelevant; the other three it never declares.
_spa_qm="$_spa/qual-missing"; mkdir -p "$_spa_qm"
awk 'BEGIN {
  printf "spa-big\ttrue\tviolation\tfail\ttrue\n"
  for (i = 1; i <= 25000; i++) printf "spa-big\ttrue\trestoration\tpass\ttrue\n"
  printf "spa-big\ttrue\tirrelevant\tpass\ttrue\n" }' > "$_spa_qm/qualification.tsv"

# felix_qualify_ungoverned reads every qualified checker name after a C-locale
# sort: spa-a-first, 3,000 fillers, spa-z-last. The gate prints the first, the
# last, and one the table never qualifies.
_spa_qu="$_spa/qual-ungoverned"; mkdir -p "$_spa_qu"
awk -v pad="$_spa_pad" 'BEGIN {
  printf "spa-a-first\ttrue\tviolation\tfail\ttrue\n"
  for (i = 1; i <= 3000; i++) printf "spa-m-%s-%05d\ttrue\tviolation\tfail\ttrue\n", pad, i
  printf "spa-z-last\ttrue\tviolation\tfail\ttrue\n" }' > "$_spa_qu/qualification.tsv"
_spa_gate="$(printf 'felix gate\n  spa-a-first            ok\n  spa-never-qualified    ok\n  spa-z-last             FAIL\n')"

# One stack.tsv for commissioning's admit and apply and for discovery's adopt:
# each reads its names without the marketplace suffix. spa-a-first is the first
# row, 3,000 fillers follow, spa-z-last is the last.
_spa_C="$_spa/commission"
mkdir -p "$_spa_C/spa-admit" "$_spa_C/spa-apply" "$_spa_C/spa-adopt" "$_spa_C/mem/spa-admit/commission" \
         "$_spa_C/home" "$_spa_C/bin" "$_spa_C/tmp" "$_spa_C/dhome/state/discover"
awk -v pad="$_spa_pad" 'BEGIN {
  printf "# kind\tname\tsource\trisk\tcapability\tgrounding\n"
  printf "plugin\tspa-a-first@spamkt\t-\tlow\tspacap\n"
  for (i = 1; i <= 3000; i++) printf "plugin\tspa-m-%s-%05d@spamkt\t-\tlow\tspacap\n", pad, i
  printf "plugin\tspa-z-last@spamkt\t-\tlow\tspacap\n" }' > "$_spa_C/stack.tsv"
cp "$_spa_C/stack.tsv" "$_spa_C/spa-admit/stack.tsv"
cp "$_spa_C/stack.tsv" "$_spa_C/spa-apply/stack.tsv"
cp "$_spa_C/stack.tsv" "$_spa_C/spa-adopt/stack.tsv"
# The admit phase's answer: the first declared name, the last, and one nobody
# declared. A claude that lists nothing and a HOME with no registry send that
# last one to `unknown` offline, so a declared name missed in the list would too.
printf 'plugin\tspa-a-first\tspa-source\tspacap\tnamed first in stack.tsv\nplugin\tspa-z-last\tspa-source\tspacap\tnamed last in stack.tsv\nplugin\tspa-new\tspa-source\tspacap\tnamed nowhere\ndone\t3\n' \
  > "$_spa_C/mem/spa-admit/commission/spa_need.tsv"
printf '#!/bin/sh\nexit 1\n' > "$_spa_C/bin/claude"; chmod +x "$_spa_C/bin/claude"
_spa_commission() {   # fn, args... under the fixture's memory, HOME, claude and scratch
  ( FELIX_MEMORY="$_spa_C/mem" HOME="$_spa_C/home" PATH="$_spa_C/bin:$PATH" TMPDIR="$_spa_C/tmp"
    export FELIX_MEMORY HOME PATH TMPDIR
    . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/discover.sh"
    . "$FROOT/harness/lib/commission-provider.sh"
    "$@" ) 2>/dev/null
}
# Discovery's cache, stamped the way the engine stamps it, so adopt reads it.
_spa_stamp="$( . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/discover.sh"
               _felix_discover_stamp_line "$FROOT/harness/templates" )"
printf '%s\nspa-a-first\tspacap\tlow\t-\nspa-z-last\tspacap\tlow\t-\nspa-new\tspacap\tlow\t-\n' "$_spa_stamp" \
  > "$_spa_C/dhome/state/discover/spa-adopt.tsv"

# The ledger's rollup. A name is long so a dozen signals make a few hundred KB,
# and the kinds are chosen for the order sort gives them: agent first, mcp
# fillers, tool last. So the first name reached for is spa-z:first-seen and the
# last is spa-a:last-seen, and the named rows, sorted by name, ask about the
# last one before the first: a first-row miss appends to the list and must not
# move the control off the last line. Two sessions, so neither half's miss can
# move the other's control.
_spa_L="$_spa/ledger"
mkdir -p "$_spa_L/home/state/ledger" "$_spa_L/mem" "$_spa_L/spa-ledger-named" "$_spa_L/spa-ledger-owner"
_spa_signals="$(awk 'BEGIN {
  s = "x"; while (length(s) < 25000) s = s s
  printf "agent\tspa-z:first-seen\n"
  for (i = 1; i <= 12; i++) printf "mcp\tspa-m-%s-%02d\n", substr(s, 1, 25000), i
  printf "tool\tspa-a:last-seen\n" }')"
printf '%s\nnamed\tspa-a:last-seen\nnamed\tspa-n:never-reached\nnamed\tspa-z:first-seen\n' "$_spa_signals" \
  > "$_spa_L/home/state/ledger/spa-sess-named.tsv"
printf '%s\n' "$_spa_signals" > "$_spa_L/home/state/ledger/spa-sess-owner.tsv"
printf 'plugin\tspa-a@spamkt\t-\tlow\tspacap\nplugin\tspa-z@spamkt\t-\tlow\tspacap\nplugin\tspa-q@spamkt\t-\tlow\tspacap\n' \
  > "$_spa_L/spa-ledger-owner/stack.tsv"
_spa_rollup() {   # proj, session -> the fold it wrote
  ( FELIX_MEMORY="$_spa_L/mem"; export FELIX_MEMORY
    . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/ledger.sh"
    felix_ledger_rollup "$_spa_L/$1" "$_spa_L/home" "$2" 2026-09-25 ) >/dev/null 2>&1
  cat "$_spa_L/mem/$1/ledger.d/$2.tsv" 2>/dev/null
}

# felix_toolbox_routed reads the owner of every play the routes name.
_spa_T="$_spa/toolbox/spa-toolbox"; mkdir -p "$_spa_T"
awk -v pad="$_spa_pad" 'BEGIN {
  printf "spa-route-first\tspa\tcore\tspa-a:thing\n"
  for (i = 1; i <= 3000; i++) printf "spa-route-%05d\tspa\tcore\tspa-m-%s-%05d:thing\n", i, pad, i
  printf "spa-route-last\tspa\tcore\tspa-z:thing\n" }' > "$_spa_T/routes.tsv"
_spa_routed() { ( . "$FROOT/harness/lib/toolbox.sh"; felix_toolbox_routed "$_spa_T" "$1" ) >/dev/null 2>&1; }

# The lists each test reads, measured here from the fixtures: every one is
# well past a pipe's 64 KB, with the line asked about first and the control
# last. A ledger list starts with an empty line (the engine builds it that way),
# so its first name is its second line, which is as early as its writer allows.
_spa_short=""
_spa_fits() {   # label, list, first, last
  [ "${#2}" -ge 262144 ] && [ "$(_spa_first "$2")" = "$3" ] && [ "$(_spa_last "$2")" = "$4" ] \
    || _spa_short="$_spa_short $1 (${#2} bytes, first [$(_spa_first "$2" | cut -c1-40)], last [$(_spa_last "$2" | cut -c1-40)])"
}
_spa_fits felix_qualify_missing_controls \
  "$( . "$FROOT/harness/lib/qualify.sh"; felix_qualify_rows "$_spa_qm" | awk -F'\t' '$1 == "spa-big" { print $3 }' )" \
  violation irrelevant
# The declared checkers, as felix_qualify_ungoverned reads them: the first
# column of the rows, once each. felix_qualify_checkers did this until felix
# gate stopped reading the table a second time and it had no caller left.
_spa_fits felix_qualify_ungoverned \
  "$( . "$FROOT/harness/lib/qualify.sh"; felix_qualify_rows "$_spa_qu" | LC_ALL=C cut -f1 | LC_ALL=C sort -u )" \
  spa-a-first spa-z-last
_spa_declared="$(grep -vE '^[[:space:]]*(#|$)' "$_spa_C/stack.tsv" | cut -f2 | sed 's/@.*//')"
_spa_fits "felix_commission_admit, felix_commission_apply_declares, felix_discover_adopt" \
  "$_spa_declared" spa-a-first spa-z-last
_spa_fits "felix_ledger_rollup:seen" \
  "$(sort -u "$_spa_L/home/state/ledger/spa-sess-named.tsv" | awk -F'\t' '$1 != "named" { print $2 }')" \
  spa-z:first-seen spa-a:last-seen
_spa_fits "felix_ledger_rollup:seen_owner" \
  "$(sort -u "$_spa_L/home/state/ledger/spa-sess-owner.tsv" \
       | awk -F'\t' '$1 != "named" { o = $2; sub(/:.*/, "", o); sub(/@.*/, "", o); print o }')" \
  spa-z spa-a
_spa_fits felix_toolbox_routed \
  "$(grep -vE '^[[:space:]]*(#|$)' "$_spa_T/routes.tsv" | cut -f4 | tr ' ' '\n' | sed 's/:.*//')" \
  spa-a spa-z
[ -z "$_spa_short" ] \
  && ok  "every list fixture below holds more than 256 KB with the line asked about first and the control last" \
  || bad "every list fixture below holds more than 256 KB with the line asked about first and the control last" \
         "too small or out of order, so a pass below would prove nothing:$_spa_short"

# ------------------------------------------ felix_qualify_missing_controls ----
# grep -q: red on the old engine on any host.
_spa_out="$( . "$FROOT/harness/lib/qualify.sh"; felix_qualify_missing_controls "$_spa_qm" spa-big 2>/dev/null )"
if [ "$_spa_out" = "alternate${_spa_nl}decoupled_violation${_spa_nl}decoupled_satisfaction" ]; then
  ok  "a checker whose first of 25,000 rows declares a control is short only the three controls it never declares"
else
  bad "a checker whose first of 25,000 rows declares a control is short only the three controls it never declares" \
      "reported missing [$(printf '%s' "$_spa_out" | tr '\n' ' ')]: grep -qxF left at the first declared control, the list's writer died of SIGPIPE, pipefail read a declared control as missing, and the gate printed a shortfall the table does not have"
fi
if ! _spa_line "$_spa_out" irrelevant && _spa_line "$_spa_out" alternate \
   && _spa_line "$_spa_out" decoupled_violation && _spa_line "$_spa_out" decoupled_satisfaction; then
  ok  "and the control it declares only on its last row is not reported missing"
else
  bad "and the control it declares only on its last row is not reported missing" \
      "reported missing [$(printf '%s' "$_spa_out" | tr '\n' ' ')]: the fixture does not reach the membership test"
fi

# ------------------------------------------------ felix_qualify_ungoverned ----
_spa_out="$( . "$FROOT/harness/lib/qualify.sh"; felix_qualify_ungoverned "$_spa_qu" "$_spa_gate" 2>/dev/null )"
[ "$_spa_out" = "spa-never-qualified" ] \
  && ok  "a checker the gate prints that sorts first of 3,002 qualified checkers is not called ungoverned" \
  || bad "a checker the gate prints that sorts first of 3,002 qualified checkers is not called ungoverned" \
         "called ungoverned [$(printf '%s' "$_spa_out" | tr '\n' ' ')]: grep -qxF left at the first qualified checker, the roster's writer died of SIGPIPE, and a qualified checker was reported as a gap"
if ! _spa_line "$_spa_out" spa-z-last && _spa_line "$_spa_out" spa-never-qualified; then
  ok  "nor one that sorts last, while one no row qualifies is"
else
  bad "nor one that sorts last, while one no row qualifies is" \
      "called ungoverned [$(printf '%s' "$_spa_out" | tr '\n' ' ')]: the fixture does not reach the membership test"
fi

# ---------------------------------------- grep with its output on /dev/null ----
# The six below are red on a host whose grep is GNU grep (ubuntu CI), where a
# standard output of /dev/null makes grep stop at its first match. This Mac's
# BSD grep reads to the end whatever its output is, so on the base engine they
# pass here. Each asserts the verdict the engine owes, first and last.

# felix_commission_admit, commission-provider.sh:390.
_spa_out="$(_spa_commission felix_commission_admit "$_spa_C/spa-admit" "$FROOT" spa_need "$FROOT/harness/templates")"
_spa_line "$_spa_out" "already	plugin	spa-a-first	-	-	-	named in stack.tsv already" \
  && ok  "the admit phase answers already for a nomination stack.tsv declares first of 3,002 rows" \
  || bad "the admit phase answers already for a nomination stack.tsv declares first of 3,002 rows" \
         "got [$(_spa_rows "$_spa_out" spa-a-first 3)]: grep stopped at the first declared name, the list's writer died of SIGPIPE, and a declared plugin was treated as undeclared"
if _spa_line "$_spa_out" "already	plugin	spa-z-last	-	-	-	named in stack.tsv already" \
   && _spa_line "$_spa_out" "unknown	plugin	spa-new	-	-	-	nothing to fetch it by: no pinned url and sha in any configured marketplace"; then
  ok  "and for one declared last, while one declared nowhere goes on to the fetch"
else
  bad "and for one declared last, while one declared nowhere goes on to the fetch" \
      "got [$(printf '%s' "$_spa_out" | tr '\n' ' ')]: the fixture does not reach the membership test"
fi

# felix_commission_apply_declares, commission-provider.sh:482. Each call starts
# from the fixture's stack.tsv, so a row one call appends cannot fail the next.
_spa_apply() { cp "$_spa_C/stack.tsv" "$_spa_C/spa-apply/stack.tsv"
               _spa_commission felix_commission_apply_declares "$_spa_C/spa-apply" "$_spa_C" \
                 "$(printf 'declare\tplugin\t%s@spamkt\tlow\tspacap\t0123456789abcdef\tthe fixture' "$1")" \
                 spa-tree spa-policy spa_need; }
_spa_out="$(_spa_apply spa-a-first)"
if [ "$_spa_out" = "0" ] && cmp -s "$_spa_C/stack.tsv" "$_spa_C/spa-apply/stack.tsv"; then
  ok  "applying a declare for the first of 3,002 stack rows appends nothing"
else
  bad "applying a declare for the first of 3,002 stack rows appends nothing" \
      "applied [$_spa_out], last row now [$(tail -1 "$_spa_C/spa-apply/stack.tsv" | cut -c1-60)]: grep stopped at the first declared name and a row already in stack.tsv was appended again"
fi
_spa_out="$(_spa_apply spa-z-last)"
if [ "$_spa_out" = "0" ] && cmp -s "$_spa_C/stack.tsv" "$_spa_C/spa-apply/stack.tsv"; then
  ok  "nor for the last of them"
else
  bad "nor for the last of them" "applied [$_spa_out]: the fixture does not reach the membership test"
fi
_spa_out="$(_spa_apply spa-new)"
if [ "$_spa_out" = "1" ] && [ "$(tail -1 "$_spa_C/spa-apply/stack.tsv")" = "$(printf 'plugin\tspa-new@spamkt\t-\tlow\tspacap\tOBSERVED')" ]; then
  ok  "while a declare for a name no row holds appends its row"
else
  bad "while a declare for a name no row holds appends its row" \
      "applied [$_spa_out], last row [$(tail -1 "$_spa_C/spa-apply/stack.tsv" | cut -c1-60)]: the fixture does not reach the append"
fi

# felix_discover_adopt, discover.sh:1407.
_spa_out="$(_spa_commission felix_discover_adopt "$_spa_C/spa-adopt" "$_spa_C/dhome" "$FROOT/harness/templates")"
_spa_line "$_spa_out" "already	spa-a-first	spacap	low" \
  && ok  "adopt answers already for a candidate stack.tsv declares first of 3,002 rows" \
  || bad "adopt answers already for a candidate stack.tsv declares first of 3,002 rows" \
         "got [$(_spa_rows "$_spa_out" spa-a-first 2)]: grep stopped at the first declared name and an adopted candidate was declared again, a duplicate stack row"
if _spa_line "$_spa_out" "already	spa-z-last	spacap	low" && _spa_line "$_spa_out" "declare	spa-new	spacap	low"; then
  ok  "and for one declared last, while a low-risk candidate declared nowhere is declared"
else
  bad "and for one declared last, while a low-risk candidate declared nowhere is declared" \
      "got [$(printf '%s' "$_spa_out" | tr '\n' ' ')]: the fixture does not reach the membership test"
fi

# felix_ledger_rollup, ledger.sh:467: a named row for a name already reached for.
_spa_out="$(_spa_rollup spa-ledger-named spa-sess-named)"
[ -z "$(awk -F'\t' '$3 == "named" && $4 == "spa-z:first-seen"' <<<"$_spa_out")" ] \
  && ok  "the rollup writes no named row for the first name the session reached for" \
  || bad "the rollup writes no named row for the first name the session reached for" \
         "got [$(_spa_rows "$_spa_out" spa-z:first-seen 4)]: grep stopped at the first name seen and the name got a named row beside its own, written twice"
if [ -z "$(awk -F'\t' '$3 == "named" && $4 == "spa-a:last-seen"' <<<"$_spa_out")" ] \
   && _spa_line "$_spa_out" "spa-sess-named	2026-09-25	named	spa-n:never-reached	0	1" \
   && _spa_line "$_spa_out" "spa-sess-named	2026-09-25	agent	spa-z:first-seen	1	1"; then
  ok  "nor for the last, while a name nothing reached for gets its named row"
else
  bad "nor for the last, while a name nothing reached for gets its named row" \
      "got [$(_spa_rows "$_spa_out" named 3)]: the fixture does not reach the membership test"
fi

# felix_ledger_rollup, ledger.sh:494: a zero row for an owner that was reached for.
_spa_out="$(_spa_rollup spa-ledger-owner spa-sess-owner)"
[ -z "$(_spa_rows "$_spa_out" spa-z@spamkt 4)" ] \
  && ok  "the rollup writes no zero row for a declared plugin whose owner the session reached for first" \
  || bad "the rollup writes no zero row for a declared plugin whose owner the session reached for first" \
         "got [$(_spa_rows "$_spa_out" spa-z@spamkt 4)]: grep stopped at the first owner reached for, and a plugin that was used reads as pointed at and ignored"
if [ -z "$(_spa_rows "$_spa_out" spa-a@spamkt 4)" ] \
   && _spa_line "$_spa_out" "spa-sess-owner	2026-09-25	plugin	spa-q@spamkt	0	0"; then
  ok  "nor for the owner it reached for last, while a declared plugin nothing reached for gets its zero row"
else
  bad "nor for the owner it reached for last, while a declared plugin nothing reached for gets its zero row" \
      "got [$(_spa_rows "$_spa_out" plugin 3)]: the fixture does not reach the membership test"
fi

# felix_toolbox_routed, toolbox.sh:100.
_spa_routed spa-a \
  && ok  "a plugin the first of 3,002 routes names reads as routed" \
  || bad "a plugin the first of 3,002 routes names reads as routed" \
         "it read unrouted: grep stopped at the first play's owner, sed died of SIGPIPE, and pipefail made the route's plugin unrouted"
if _spa_routed spa-z && ! _spa_routed spa-never-routed; then
  ok  "and one the last route names, while one no route names reads as unrouted"
else
  bad "and one the last route names, while one no route names reads as unrouted" \
      "the fixture does not reach the membership test"
fi

# ------------------------------------- head -1 where the status is read ----
# Two readers kept the first line with `| head -1`, and their callers read the
# status. head leaves after one line, so past a pipe's capacity the writer dies
# of SIGPIPE and pipefail fails a read that found its line. The engine never
# writes either input that large: it writes a night's state as one line, with
# the note's newlines taken out, and the registry holds one installLocation per
# entry. So no night or deploy of its own races, and these fixtures are the red
# for readers that keep the first line by reading to the end, not a report of a
# fault anyone has met. Red on the old engine on any host; each control is the
# same input at its real size.

# felix_overnight_field, overnight.sh:170, read by felix_overnight_active.
_spa_O="$_spa/overnight"; mkdir -p "$_spa_O/mem/spa-night/overnight/nights" "$_spa_O/spa-night"
_spa_now="$(date +%s)"
printf '%s\t%s\t5\t0\tspa-sess-long\tthe fixture\n' "$_spa_now" "$((_spa_now + 36000))" \
  > "$_spa_O/mem/spa-night/overnight/nights/spa-sess-long"
awk -v pad="$_spa_pad" 'BEGIN { for (i = 1; i <= 3000; i++) printf "spa filler %s %05d\n", pad, i }' \
  >> "$_spa_O/mem/spa-night/overnight/nights/spa-sess-long"
printf '%s\t%s\t5\t0\tspa-sess-one\tthe fixture\n' "$_spa_now" "$((_spa_now + 36000))" \
  > "$_spa_O/mem/spa-night/overnight/nights/spa-sess-one"
_spa_active() { ( FELIX_MEMORY="$_spa_O/mem"; export FELIX_MEMORY
                  . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/overnight.sh"
                  felix_overnight_active "$_spa_O/spa-night" "$1" ) >/dev/null 2>&1; }
if [ "$(wc -c < "$_spa_O/mem/spa-night/overnight/nights/spa-sess-long")" -gt 262144 ] && _spa_active spa-sess-long; then
  ok  "a live night whose state file runs past a pipe after its first line reads live"
else
  bad "a live night whose state file runs past a pipe after its first line reads live" \
      "it read inactive: head -1 left after the first line, cut died of SIGPIPE, pipefail failed felix_overnight_field, and felix_overnight_active read a night inside every bound as over"
fi
_spa_active spa-sess-one \
  && ok  "and the same night as one line reads live" \
  || bad "and the same night as one line reads live" "the fixture does not reach felix_overnight_active"

# felix_marketplace_root, resolve.sh:752, read by felix with || mroot="".
_spa_M="$_spa/marketplace"; mkdir -p "$_spa_M"
{ printf '{\n  "felix": {\n    "source": {\n      "source": "directory"\n    },\n'
  printf '    "installLocation": "/spa/first/location",\n'
  awk -v pad="$_spa_pad" 'BEGIN { for (i = 1; i <= 3000; i++) printf "    \"installLocation\": \"/spa/filler/%s/%05d\",\n", pad, i }'
  printf '    "lastUpdated": "2026-09-25T00:00:00.000Z"\n  },\n  "other": {\n    "installLocation": "/spa/other"\n  }\n}\n'
} > "$_spa_M/long.json"
printf '{\n  "felix": {\n    "installLocation": "/spa/first/location",\n    "lastUpdated": "2026-09-25T00:00:00.000Z"\n  }\n}\n' \
  > "$_spa_M/one.json"
_spa_out="$( . "$FROOT/harness/lib/resolve.sh"; felix_marketplace_root "$_spa_M/long.json" 2>/dev/null )"; _spa_rc=$?
if [ "$_spa_rc" = 0 ] && [ "$_spa_out" = "/spa/first/location" ]; then
  ok  "the felix marketplace root is read, and reported read, from an entry listing more than a pipe holds"
else
  bad "the felix marketplace root is read, and reported read, from an entry listing more than a pipe holds" \
      "exit $_spa_rc, printed [$_spa_out]: head -1 left after the first location, sed died of SIGPIPE, and the caller emptied the root it had found"
fi
_spa_out="$( . "$FROOT/harness/lib/resolve.sh"; felix_marketplace_root "$_spa_M/one.json" 2>/dev/null )"; _spa_rc=$?
[ "$_spa_rc" = 0 ] && [ "$_spa_out" = "/spa/first/location" ] \
  && ok  "and from an entry listing one" \
  || bad "and from an entry listing one" "exit $_spa_rc, printed [$_spa_out]: the fixture does not reach felix_marketplace_root"

printf '\nland table (L2a)\n'
# The landing actor's recipe book, and the two checks that will one day stop a
# landing, before either stops anything. projects/<name>/land.tsv says how each
# path lands: a resolver kind (version-above, keyed-union, insertions-union,
# rerun) is a path the actor may settle without a session, and a narrowing
# kind (session, founder) is one it may not. So the schema refuses a resolver
# on any path whose change is an escape, a commission, an authority grant, an
# exception or the trust base: a table that let the actor settle risk.tsv by
# itself would be a quiet way round everything else in this file. The table is
# read only from refs/remotes/origin/main, because a pull request must not
# rewrite the recipe that lands it, and any change to it escapes to a person.
#
# `owed` and `behind` only report in this step. Each writes a would-refuse row
# to says.log and prints nothing, refuses nothing and moves no exit status, so
# how a session lands is unchanged; a dry run writes nothing at all.
#
# Written blind against the contract (the landing-actor design §4 and §11 step
# 3, through the L2a spec), before the implementation was read. Every positive
# assertion here fails against an engine with no lib/land-table.sh; each
# negative one sits beside a positive sibling in the same fixture. The
# assertions the three reviews added (the exact exemption comparison, every
# says.log row counted, uncommitted and behind owed cases, narrowed, the skip
# pattern and functions from the environment, only 0 writing, the land-table
# row, schema-check) were written by the implementer, not blind. Each was shown
# failing for the reason its name gives: against the unfixed branch engine
# where that engine had the defect, and against a one-line mutation of the
# fixed one where it did not (an extra says.log row, a committed-only or a
# two-dot diff).

LT_LIB="$FROOT/harness/lib/land-table.sh"
LT_T="$TMP/lt-table.tsv"
# One library call in a subshell, so nothing it defines leaks into the suite,
# and an engine without the library answers with nothing rather than aborting.
_lt()        { ( . "$LT_LIB" 2>/dev/null; "$@" ) 2>/dev/null; }
_lt_row()    { local IFS=$'\t'; printf '%s\n' "$*"; }
_lt_ed()     { awk "$1" "$2" > "$2.lt" && mv "$2.lt" "$2"; }   # <awk program> <file>: rewrite in place
_lt_lacks()  { case "$2" in *"$3"*) bad "$1" "[$2] holds [$3]" ;; *) ok "$1" ;; esac; }
_lt_state()  { git -C "$1" merge-base --is-ancestor refs/remotes/origin/main HEAD >/dev/null 2>&1 && echo current || echo behind; }
# What the schema says of the table in <file>, as one string: how many rows
# felix_land_rows_in accepts, each refusal as line:reason (a protected one with
# the category word its detail begins with), and felix_land_malformed_in's exit
# status. Against an engine without the library it reads rows=0 refused= rc=127.
_lt_verdict() {
  printf 'rows=%s refused=%s rc=%s' \
    "$(_lt felix_land_rows_in < "$1" | awk 'END { print NR }')" \
    "$(_lt felix_land_malformed_in < "$1" | awk -F'\t' '{ w = ""; if ($2 == "protected") { split($3, d, "[^a-z-]"); w = ":" d[1] }
                                                        printf "%s%s:%s%s", s, $1, $2, w; s = "," }')" \
    "$( ( . "$LT_LIB" 2>/dev/null; felix_land_malformed_in < "$1" >/dev/null 2>&1; echo $? ) )"
}

# ------------------------------------------------------- rows and kinds ----
# felix-home's seven rows, exactly as the design gives them (§4). The hash is
# the design's, so a typo here cannot quietly weaken every assertion that reads
# this file.
{ _lt_row engine/.claude-plugin/plugin.json   version-above    engine/ -
  _lt_row engine/harness/tests/assertions.tsv keyed-union      -       2
  _lt_row engine/harness/tests/red.tsv        rerun            engine/ 'engine/harness/tests/red <B>'
  _lt_row engine/harness/tests/run            insertions-union -       -
  _lt_row HANDOFF.md                          session          -       -
  _lt_row 'projects/[^/]+/CLAUDE\.md'         founder          -       -
  _lt_row 'docs/.*roadmap.*'                  founder          -       -
} > "$TMP/lt-seven.tsv"
LT_SEVEN="$TMP/lt-seven.tsv"
is  "the land-table fixture's seven rows are the design's, byte for byte, by their hash" \
    "$(git hash-object "$LT_SEVEN" 2>/dev/null)" "3dc2dcb4612f4bb0226ef5a5b9f30ba173619d60"

# A reader that drops, reorders or rewrites a row fails the first; a schema
# that refuses one of the design's own rows fails the second.
is  "felix_land_rows_in prints felix-home's seven rows exactly as written, or the landing actor would read a table the founder never armed" \
    "$(_lt felix_land_rows_in < "$LT_SEVEN")" "$(cat "$LT_SEVEN")"
is  "and felix_land_malformed_in refuses none of them and exits 0, or the design's own table would read as broken" \
    "$(_lt_verdict "$LT_SEVEN")" "rows=7 refused= rc=0"

# The one definition of a row is table.sh's. A reader that takes a comment,
# a commented-out row or a blank line for a row fails the first; one that
# numbers refusals by data row instead of by line fails the second.
{ printf '# x\n'; printf '# path\tkind\ttrigger\targ\n'
  _lt_row a.txt version-above engine/ -
  printf '\n'
  printf '#b.txt\tversion-above\t-\t-\n'
  _lt_row c.txt merge-ours - -
  printf '   \n'
  _lt_row d.txt insertions-union - -
} > "$LT_T"
is  "comments, a commented-out row and blank lines are not rows, or a note in the table would bind a path" \
    "$(_lt felix_land_rows_in < "$LT_T")" "$(printf 'a.txt\tversion-above\tengine/\t-\nd.txt\tinsertions-union\t-\t-')"
is  "and a refusal carries its line in the file, comments counted, or the founder is sent to the wrong line" \
    "$(_lt_verdict "$LT_T")" "rows=2 refused=6:kind rc=1"
# The judge's child shell inherits the session's environment and never loads
# table.sh, so a skip pattern read from there would be the session's choice.
is  "which lines are rows does not follow a FELIX_TABLE_SKIP the session exported, or the environment would choose the rows the judge reads" \
    "$( ( FELIX_TABLE_SKIP='^(engine|projects|docs|HANDOFF)'; export FELIX_TABLE_SKIP
          . "$LT_LIB" 2>/dev/null; felix_land_rows_in < "$LT_SEVEN" ) 2>/dev/null | awk 'END { print NR }' )" "7"

# A last row the editor left without a newline is still a row, and it is
# printed with one, or the next reader glues it to whatever follows.
printf 'a.txt\tversion-above\t-\t-' > "$LT_T"
is  "a final row with no newline is read, and printed ending in one, or the last recipe in a table would vanish or run into the next line" \
    "$(_lt felix_land_rows_in < "$LT_T"; printf x)" "$(printf 'a.txt\tversion-above\t-\t-\nx')"

# cells: the shape two readers split differently. Each is refused for that
# alone, read by no one, and fails the table.
printf 'a.txt\tversion-above\t-\n' > "$LT_T"
is  "a three-cell row is refused as cells alone and read by no one, or a reader would invent its missing arg" \
    "$(_lt_verdict "$LT_T")" "rows=0 refused=1:cells rc=1"
printf 'a.txt\tversion-above\t-\t-\textra\n' > "$LT_T"
is  "a five-cell row is refused as cells alone, or a stray tab would carry a column past the schema" \
    "$(_lt_verdict "$LT_T")" "rows=0 refused=1:cells rc=1"
printf 'a.txt\t\tengine/\t-\n' > "$LT_T"
is  "a row with an empty cell is refused as cells alone and not as a kind, or a reader collapsing the empty cell would shift every cell after it" \
    "$(_lt_verdict "$LT_T")" "rows=0 refused=1:cells rc=1"
printf 'a.txt\tversion-above\t-\t-\r\n' > "$LT_T"
is  "a row ending in a CR is refused as cells alone, or a reader keeping the CR would bind an arg no other reader sees" \
    "$(_lt_verdict "$LT_T")" "rows=0 refused=1:cells rc=1"
printf 'a.txt\tversion\r-above\t-\t-\n' > "$LT_T"
is  "and a CR inside a cell is cells too, never kind, or the reason would depend on where the CR fell" \
    "$(_lt_verdict "$LT_T")" "rows=0 refused=1:cells rc=1"

# kind: the kinds are the engine's. A kind the engine does not define is one
# reason on its own, since no column rule applies without one; duplicate is the
# only reason it does not hide.
printf 'a.txt\tmerge-ours\t-\t-\n' > "$LT_T"
is  "a kind the engine does not define is refused as kind, or a table could invent its own way to land a path" \
    "$(_lt_verdict "$LT_T")" "rows=0 refused=1:kind rc=1"
printf '/abs\tmerge-ours\ta b\t-\n' > "$LT_T"
is  "and an unknown kind is that row's only reason, its bad path and trigger unsaid, or the refusal would judge columns no kind defines" \
    "$(_lt_verdict "$LT_T")" "rows=0 refused=1:kind rc=1"
{ _lt_row a.txt version-above - -; _lt_row a.txt merge-ours - -; } > "$LT_T"
is  "but an unknown kind on a path an earlier row binds is a duplicate as well, or a second recipe for one path would go unnamed" \
    "$(_lt_verdict "$LT_T")" "rows=1 refused=2:kind,2:duplicate rc=1"
is  "the kinds are engine constants, the design's six, with session and founder the narrowing two, or a kind could be added without an engine change" \
    "$( . "$LT_LIB" 2>/dev/null; printf '%s|%s' "${FELIX_LAND_KINDS:-}" "${FELIX_LAND_NARROWING:-}" )" \
    "version-above keyed-union insertions-union rerun session founder|session founder"

# path: a resolver is compared to a changed path by string equality, so its
# path must be a plain repository-relative literal. Each line is one shape a
# looser check lets through.
{ for _ltp in 'engine/[a-z]+.sh' /abs/x ../x a/../b -x dir/ a//b -; do _lt_row "$_ltp" version-above - -; done; } > "$LT_T"
is  "a resolver path that is an ERE, absolute, dot-dot, dash-led, slash-ended, double-slashed or the dash itself is refused as path, or it would bind a path no change can equal" \
    "$(_lt_verdict "$LT_T")" "rows=0 refused=1:path,2:path,3:path,4:path,5:path,6:path,7:path,8:path rc=1"
printf 'docs/(\tsession\t-\t-\n' > "$LT_T"
is  "a narrowing path that is not a valid ERE is refused as path, or grep would match it against nothing and the narrowing row would narrow nothing" \
    "$(_lt_verdict "$LT_T")" "rows=0 refused=1:path rc=1"
_lt_row 'projects/[^/]+/CLAUDE\.md' founder - - > "$LT_T"
is  "while an ERE on a founder row is accepted and printed as written, backslash included, or the design's own founder row would be lost" \
    "$(_lt felix_land_rows_in < "$LT_T")|$(_lt_verdict "$LT_T")" "$(cat "$LT_T")|rows=1 refused= rc=0"

# trigger: a literal, which may end in a slash to name a directory; and only
# the dash on a narrowing row, since nothing is owed on a path the actor may
# never write.
{ _lt_row a.txt version-above 'engine//' -; _lt_row b.txt version-above ../x -; _lt_row c.txt version-above 'a b' -; } > "$LT_T"
is  "a trigger with a doubled slash, a dot-dot or a space is refused as trigger, or it would match changes nobody meant" \
    "$(_lt_verdict "$LT_T")" "rows=0 refused=1:trigger,2:trigger,3:trigger rc=1"
{ _lt_row HANDOFF.md session engine/ -; _lt_row docs/x founder engine/ -; } > "$LT_T"
is  "any trigger on a session or founder row is refused as trigger, or a path the actor may never write could be owed" \
    "$(_lt_verdict "$LT_T")" "rows=0 refused=1:trigger,2:trigger rc=1"
{ _lt_row a.txt version-above engine/ -; _lt_row b.txt version-above engine/harness/felix -; } > "$LT_T"
is  "while a directory trigger ending in a slash and a file trigger are accepted on a version-above row, or felix-home's own rows could not be written" \
    "$(_lt_verdict "$LT_T")" "rows=2 refused= rc=0"

# arg: each kind's column rule.
{ _lt_row k1.txt keyed-union - -; _lt_row k2.txt keyed-union - 0; _lt_row k3.txt keyed-union - x; } > "$LT_T"
is  "a keyed-union arg that is not a positive integer is refused as arg, or the union would key on a column that does not exist" \
    "$(_lt_verdict "$LT_T")" "rows=0 refused=1:arg,2:arg,3:arg rc=1"
_lt_row r1.txt rerun - - > "$LT_T"
is  "a rerun row whose command is the dash is refused as arg, or the actor would settle the path by running nothing" \
    "$(_lt_verdict "$LT_T")" "rows=0 refused=1:arg rc=1"
{ _lt_row v1.txt version-above - 2; _lt_row i1.txt insertions-union - 2; _lt_row s1.txt session - 2; _lt_row f1.txt founder - 2; } > "$LT_T"
is  "an arg on a version-above, insertions-union, session or founder row is refused as arg, or a cell the kind never reads would pass as meaningful" \
    "$(_lt_verdict "$LT_T")" "rows=0 refused=1:arg,2:arg,3:arg,4:arg rc=1"
{ _lt_row k.txt keyed-union - 2; _lt_row r.txt rerun - 'a b <B>'; } > "$LT_T"
is  "while keyed-union on column 2 and a rerun command with spaces and <B> are accepted, or felix-home's own rows could not be written" \
    "$(_lt_verdict "$LT_T")" "rows=2 refused= rc=0"

# duplicate: one path, one recipe, and the first stands.
{ _lt_row a.txt version-above - -; _lt_row a.txt insertions-union - -; } > "$LT_T"
is  "a second row on the same path is refused as duplicate and the first is the one read, or one path would have two recipes" \
    "$(_lt felix_land_rows_in < "$LT_T")|$(_lt_verdict "$LT_T")" "$(printf 'a.txt\tversion-above\t-\t-')|rows=1 refused=2:duplicate rc=1"
{ printf 'a.txt\tversion-above\t-\n'; _lt_row a.txt insertions-union - -; } > "$LT_T"
is  "but a row refused as cells claims no path, so the next row on that path stands, or a broken line would disable a good one" \
    "$(_lt_verdict "$LT_T")" "rows=1 refused=1:cells rc=1"
# narrowed: a resolver never overrides a session or founder row, whichever
# comes first, and a narrowing ERE covers the literal paths it matches.
{ _lt_row HANDOFF.md version-above - -; _lt_row HANDOFF.md session - -; } > "$LT_T"
is  "a resolver above a session row on the same path is refused as narrowed and the session row stands, or a row placed first would take a path back from a session" \
    "$(_lt felix_land_rows_in < "$LT_T")|$(_lt_verdict "$LT_T")" "$(printf 'HANDOFF.md\tsession\t-\t-')|rows=1 refused=1:narrowed rc=1"
{ _lt_row 'docs/.*roadmap.*' founder - -; _lt_row docs/2026-roadmap.md version-above - -; _lt_row docs/notes.md version-above - -; } > "$LT_T"
is  "a resolver on a path a founder row's ERE matches is refused as narrowed, while one on a path it does not match stands, or a literal row could carve a path out of the founder's" \
    "$(_lt_verdict "$LT_T")" "rows=2 refused=2:narrowed rc=1"
# Every applicable reason, in the contract's order, once cells and kind pass.
{ _lt_row /abs version-above - -; _lt_row /abs keyed-union 'a b' 0
  _lt_row projects/p/risk.tsv version-above - 2; _lt_row projects/p/risk.tsv version-above - 2; } > "$LT_T"
is  "a row with several faults reports each of them in the order path, trigger, arg, protected, duplicate, or a fixed fault would uncover another one round later" \
    "$(_lt_verdict "$LT_T")" \
    "rows=0 refused=1:path,2:path,2:trigger,2:arg,2:duplicate,3:arg,3:protected:escape-table,4:arg,4:protected:escape-table,4:duplicate rc=1"

# ------------------------------------------ the schema rule, the trust base ----
# Only a session or the founder may bind a path whose change is an escape, a
# commission, an authority grant, an exception or the trust base. Each path
# below is refused for a resolver with the category its detail names, and
# felix_land_protected prints that same word; the order of the categories is
# pinned by projects/p/land.tsv (also an escape table, said as land-table) and
# projects/p/risk.tsv (also a commission table, said as escape-table).
LT_PROT='projects/p/risk.tsv|escape-table
projects/p/qualification.tsv|escape-table
engine/harness/templates/schemas.tsv|escape-table
projects/p/stack.tsv|commission-table
projects/p/capabilities|commission-table
.github/workflows/gate.yml|execute
.github/actions/a/action.yml|execute
projects/p/autonomy|authority
projects/p/autonomy.commission|authority
projects/p/exceptions.tsv|exception
exceptions.tsv|exception
projects/p/land.tsv|land-table
engine/harness/lib/escape.sh|trust-base
engine/harness/lib/land-table.sh|trust-base
engine/harness/felix|trust-base
engine/hooks/hooks.json|trust-base
engine/harness/hooks/pre-tool|trust-base
projects/p/gate.sh|trust-base'
_lt_prot() {  # <path> [kind] [arg]: felix_land_protected's word and status, then the schema's verdict on one row of that kind there
  local w r
  w="$( ( . "$LT_LIB" 2>/dev/null; felix_land_protected "$1" ) </dev/null 2>/dev/null )"
  r="$( ( . "$LT_LIB" 2>/dev/null; felix_land_protected "$1" >/dev/null 2>&1; echo $? ) </dev/null )"
  _lt_row "$1" "${2:-version-above}" - "${3:--}" > "$LT_T"
  printf '%s %s | %s' "$w" "$r" "$(_lt_verdict "$LT_T")"
}
while IFS='|' read -r _ltp _ltc; do
  is "a version-above row on $_ltp is refused as protected, $_ltc, or the landing actor could settle that path without a session" \
     "$(_lt_prot "$_ltp" </dev/null)" "$_ltc 0 | rows=0 refused=1:protected:$_ltc rc=1"
done <<EOF
$LT_PROT
EOF
# The rule is about resolvers, not about version-above: each other resolver
# kind, on one path of every category.
_lt_cat7() {  # <kind> <arg>
  { _lt_row projects/p/risk.tsv "$1" - "$2"; _lt_row projects/p/stack.tsv "$1" - "$2"
    _lt_row .github/workflows/gate.yml "$1" - "$2"; _lt_row projects/p/autonomy "$1" - "$2"
    _lt_row projects/p/exceptions.tsv "$1" - "$2"; _lt_row projects/p/land.tsv "$1" - "$2"
    _lt_row engine/harness/felix "$1" - "$2"; } > "$LT_T"
  _lt_verdict "$LT_T"; }
LT_CAT7='rows=0 refused=1:protected:escape-table,2:protected:commission-table,3:protected:execute,4:protected:authority,5:protected:exception,6:protected:land-table,7:protected:trust-base rc=1'
is  "a keyed-union row is refused on a path of every protected category, or the rule would bind one resolver kind and leave the others open" \
    "$(_lt_cat7 keyed-union 2)" "$LT_CAT7"
is  "and so is an insertions-union row, or a protected table could be landed by concatenation" \
    "$(_lt_cat7 insertions-union -)" "$LT_CAT7"
is  "and so is a rerun row, or a command would rewrite a protected path unattended" \
    "$(_lt_cat7 rerun x)" "$LT_CAT7"
# Narrowing rows are the point of those paths, so they are never refused there.
_lt_narrow() {  # <kind>: a row of that kind on every protected path
  while IFS='|' read -r _ltp _ltc; do _lt_row "$_ltp" "$1" - -; done > "$LT_T" <<EOF
$LT_PROT
EOF
  _lt_verdict "$LT_T"; }
is  "a session row on every protected path is accepted, or a table could not route those paths to a session at all" \
    "$(_lt_narrow session)" "rows=18 refused= rc=0"
is  "and so is a founder row on every one of them, or the founder could not keep them" \
    "$(_lt_narrow founder)" "rows=18 refused= rc=0"
# The rule names paths, not their neighbours: a check by prefix, by directory
# or by extension fails here.
LT_NEAR='engine/harness/lib/say.sh engine/harness/lib/table.sh engine/harness/lib/island.sh projects/p/q/gate.sh projects/p/gate.sh.bak docs/gate.sh .github/CODEOWNERS projects/p/notes.tsv engine/.claude-plugin/plugin.json'
{ for _ltp in $LT_NEAR; do _lt_row "$_ltp" version-above - -; done; } > "$LT_T"
is  "a version-above row on a near neighbour of a protected path is accepted, or the rule would refuse by resemblance and not by the list" \
    "$(_lt_verdict "$LT_T")" "rows=9 refused= rc=0"
is  "and felix_land_protected prints nothing and exits 1 for each of those neighbours, or it could not say a path is ordinary" \
    "$( ( . "$LT_LIB" 2>/dev/null; for _ltp in $LT_NEAR; do _ltw="$(felix_land_protected "$_ltp" 2>&1)"; _ltr=$?
          [ "$_ltr:$_ltw" = "1:" ] || printf '%s(%s:%s) ' "$_ltp" "$_ltr" "$_ltw"; done ) </dev/null )" ""

# The trust base: fourteen entries, two of them patterns. A star spans no
# slash, and the match is whole-path.
LT_TB14='engine/harness/lib/escape.sh engine/harness/lib/commission.sh engine/harness/lib/autonomy.sh engine/harness/lib/landing.sh engine/harness/lib/resolve.sh engine/harness/lib/verify.sh engine/harness/lib/deny.sh engine/harness/lib/deny-read.sh engine/harness/lib/where.sh engine/harness/lib/where-read.sh engine/harness/hooks/pre-tool engine/hooks/hooks.json engine/harness/felix projects/p/gate.sh'
_lt_tbrc() {  # <path>...: felix_land_trust_base's status for each, space-separated
  ( . "$LT_LIB" 2>/dev/null; _lts=""
    for _ltp in "$@"; do felix_land_trust_base "$_ltp" >/dev/null 2>&1; _lts="$_lts${_lts:+ }$?"; done
    printf '%s' "$_lts" ) </dev/null; }
is  "felix_land_trust_base exits 0, printing nothing, for an instance of each of the fourteen trust-base entries, or the schema could not refuse a resolver there" \
    "$( ( . "$LT_LIB" 2>/dev/null; for _ltp in $LT_TB14; do _ltw="$(felix_land_trust_base "$_ltp" 2>&1)"; _ltr=$?
          [ "$_ltr:$_ltw" = "0:" ] || printf '%s(%s:%s) ' "$_ltp" "$_ltr" "$_ltw"; done ) </dev/null )" ""
is  "and exits 1 for a sibling of an entry and for a gate.sh one directory too deep, or a star would span a slash and the base would swallow its neighbours" \
    "$(_lt_tbrc engine/harness/lib/island.sh projects/p/q/gate.sh)" "1 1"
# An unquoted expansion of the list globs its two starred entries against the
# caller's directory. This directory holds one file for each, so a list split
# that way turns both into those files and misses every other instance.
LT_G="$TMP/lt-glob"; mkdir -p "$LT_G/projects/zz" "$LT_G/engine/harness/lib"
: > "$LT_G/projects/zz/gate.sh"; : > "$LT_G/engine/harness/lib/landzz.sh"
is  "the glob fixture would turn both starred trust-base entries into its own files if they were expanded unquoted" \
    "$( cd "$LT_G" && set -- projects/*/gate.sh engine/harness/lib/land*.sh; printf '%s ' "$@" )" \
    "projects/zz/gate.sh engine/harness/lib/landzz.sh "
is  "and from inside it both starred entries still match as patterns, or the trust base would depend on the caller's directory" \
    "$( cd "$LT_G" && _lt_tbrc projects/p/gate.sh engine/harness/lib/landing.sh )" "0 0"
is  "and the schema still refuses a resolver on projects/p/gate.sh from there, or a table checked in the wrong directory would pass" \
    "$( cd "$LT_G" && _lt_prot projects/p/gate.sh </dev/null )" "trust-base 0 | rows=0 refused=1:protected:trust-base rc=1"

# Fail closed: when a list the rule reads is missing, every path is protected,
# said as unknown. Blanked after the library loaded, so the question is what
# the function does with what it finds, not what loading does.
_lt_fc() {  # <what to blank>: felix_land_protected engine/x afterwards, as [word] status
  ( . "$LT_LIB" 2>/dev/null
    case "$1" in
      commission) FELIX_COMMISSION_TABLES='' ;;
      tables)     FELIX_ESCAPE_TABLES='' ;;
      execute)    FELIX_ESCAPE_EXECUTE='' ;;
      lister)     unset -f _felix_escape_listed ;;
    esac
    _ltw="$(felix_land_protected engine/x 2>/dev/null)"; _ltr=$?; printf '[%s] %s' "$_ltw" "$_ltr" ) </dev/null; }
is  "felix_land_protected finds an ordinary engine path unprotected while its lists are loaded, exit 1 and no word" \
    "$(_lt_fc none)" "[] 1"
is  "but with the commission list blanked it says unknown and exits 0, or a missing list would let a resolver through" \
    "$(_lt_fc commission)" "[unknown] 0"
is  "and the schema then refuses a version-above row on that path as protected, unknown, or the fail-closed word would protect nothing" \
    "$( ( . "$LT_LIB" 2>/dev/null; FELIX_COMMISSION_TABLES=''
          _lt_row engine/x version-above - - | felix_land_malformed_in 2>/dev/null \
            | awk -F'\t' '{ split($3, d, "[^a-z-]"); printf "%s%s:%s", s, $2, d[1]; s = "," }' ) </dev/null )" "protected:unknown"
is  "and it fails closed the same way with the escape list or the execute list blanked, or with the lister gone" \
    "$(_lt_fc tables) $(_lt_fc execute) $(_lt_fc lister)" "[unknown] 0 [unknown] 0 [unknown] 0"

# --------------------------------------------- read from the base ref only ----
# A repository R holding projects/lt/, whose table is committed on local main
# before any origin/main exists. Its fourth line is a row the schema refuses.
LT_C="$TMP/lt-base"; mkdir -p "$LT_C"
( cd "$LT_C" && git init -q -b main && git config user.email t@t && git config user.name t \
  && mkdir -p projects/lt projects/ltnone \
  && printf '{ "name": "lt" }\n' > projects/lt/project.json && printf '{ "name": "ltnone" }\n' > projects/ltnone/project.json \
  && { printf '# the table origin/main holds\n'; _lt_row a.txt version-above engine/ -
       _lt_row b.txt insertions-union - -; _lt_row c.txt merge-ours - -; } > projects/lt/land.tsv \
  && _lt_row top.txt version-above - - > land.tsv \
  && git add -A && git commit -qm c1 ) >/dev/null 2>&1
LT_C="$(cd "$LT_C" && pwd -P)"
LT_CP="$LT_C/projects/lt"
LT_CROWS="$(printf 'a.txt\tversion-above\tengine/\t-\nb.txt\tinsertions-union\t-\t-')"
_lt_at()  {  # <proj dir>: felix_land_table_at_base's status, then what it printed
  ( . "$LT_LIB" 2>/dev/null; _lto="$(felix_land_table_at_base "$1" 2>/dev/null)"; _ltr=$?; printf '%s|%s' "$_ltr" "$_lto" ) </dev/null; }
_lt_mal() {  # <proj dir>: felix_land_malformed's status, then each refusal as line:reason
  ( . "$LT_LIB" 2>/dev/null; _lto="$(felix_land_malformed "$1" 2>/dev/null)"; _ltr=$?
    printf '%s|%s' "$_ltr" "$(printf '%s' "$_lto" | awk -F'\t' '{ printf "%s%s:%s", s, $1, $2; s = "," }')" ) </dev/null; }
_lt_count() { awk -v r="$1" 'index($0, r) == 1 { n++ } END { print n+0 }'; }   # <row prefix>: rows on stdin that begin with it

is  "the base-read fixture has its table committed on local main and no origin/main yet" \
    "$(git -C "$LT_C" show main:projects/lt/land.tsv >/dev/null 2>&1 && echo on-main || echo missing)|$(git -C "$LT_C" rev-parse -q --verify refs/remotes/origin/main >/dev/null 2>&1 && echo origin || echo no-origin)" \
    "on-main|no-origin"
# A reader that falls back to local main, as felix_base_ref does, fails here.
is  "with no origin/main the table is not read at all, local main's copy included, or a local branch could stand in for the base" \
    "$(_lt_at "$LT_CP") rows=[$(_lt felix_land_rows "$LT_CP")]" "1| rows=[]"
git -C "$LT_C" update-ref refs/remotes/origin/main HEAD >/dev/null 2>&1
is  "once origin/main holds the table, felix_land_table_at_base prints it as that ref holds it, or the base could not be read at all" \
    "$(_lt_at "$LT_CP")" "0|$(git -C "$LT_C" show refs/remotes/origin/main:projects/lt/land.tsv 2>/dev/null)"
is  "and felix_land_rows prints its accepted rows and leaves out the one refused, or a broken row would bind a path" \
    "$(_lt felix_land_rows "$LT_CP")" "$LT_CROWS"
is  "and felix_land_malformed reports that refused row by its line and exits 1, or a table that cannot be read would pass for a clean one" \
    "$(_lt_mal "$LT_CP")" "1|4:kind"
is  "a project with no land.tsv at origin/main has no table: status 1, no rows and nothing malformed, or an absent table would read as a broken one" \
    "$(_lt_at "$LT_C/projects/ltnone") rows=[$(_lt felix_land_rows "$LT_C/projects/ltnone")] $(_lt_mal "$LT_C/projects/ltnone")" "1| rows=[] 0|"
is  "the repository's toplevel is not a project, so a land.tsv at the root of origin/main is never read as one" \
    "$(_lt_at "$LT_C")" "1|"
is  "a project path spelled through a dot-dot is resolved before its table is looked up, or the same project would read two ways" \
    "$(_lt felix_land_rows "$LT_C/projects/ltnone/../lt")" "$LT_CROWS"

# A row the base does not hold, in each place a session can put one. Reading
# the working tree, HEAD or the local branch fails one of these three.
_lt_row d.txt version-above - - >> "$LT_CP/land.tsv"
is  "a row added in the working tree only is not read, or an uncommitted edit would rewrite the recipe" \
    "$(_lt felix_land_rows "$LT_CP")" "$LT_CROWS"
( cd "$LT_C" && git checkout -q -b feat && git add -A && git commit -qm 'a row on the branch' ) >/dev/null 2>&1
is  "the base-read fixture's branch commit holds a row origin/main lacks" \
    "$(git -C "$LT_C" show feat:projects/lt/land.tsv 2>/dev/null | _lt_count d.txt)|$(git -C "$LT_C" show refs/remotes/origin/main:projects/lt/land.tsv 2>/dev/null | _lt_count d.txt)" "1|0"
is  "and that row, committed on a branch origin/main does not hold, is not read, or a pull request could rewrite the recipe that lands it" \
    "$(_lt felix_land_rows "$LT_CP")" "$LT_CROWS"
( cd "$LT_C" && git checkout -q main && _lt_row e.txt version-above - - >> projects/lt/land.tsv \
  && git commit -qam 'a row on local main' && git checkout -q feat ) >/dev/null 2>&1
is  "the base-read fixture's local main holds a row origin/main lacks, and the checkout stands on its branch" \
    "$(git -C "$LT_C" show main:projects/lt/land.tsv 2>/dev/null | _lt_count e.txt)|$(git -C "$LT_C" show refs/remotes/origin/main:projects/lt/land.tsv 2>/dev/null | _lt_count e.txt)|$(git -C "$LT_C" rev-parse --abbrev-ref HEAD 2>/dev/null)" "1|0|feat"
is  "a row committed on local main while origin/main is behind it is not read, or the base would be whatever the local branch says" \
    "$(_lt felix_land_rows "$LT_CP")" "$LT_CROWS"
# Outside any repository there is no base at all, whatever the directory holds.
LT_O="$TMP/lt-outside/projects/lt"; mkdir -p "$LT_O"; _lt_row a.txt version-above engine/ - > "$LT_O/land.tsv"
_ltn="a project outside any repository has no base table: status 1, and nothing on stdout or stderr, or a file on disk would pass for the base"
if git -C "$LT_O" rev-parse --show-toplevel >/dev/null 2>&1; then
  skip "$_ltn" "the suite's temporary directory is inside a git repository"
else
  is "$_ltn" "$( ( . "$LT_LIB" 2>/dev/null; felix_land_table_at_base "$LT_O" 2>&1; printf '|%s' "$?" ) </dev/null )" "|1"
fi

# ------------------------------------------------------ escape membership ----
# land.tsv joins the exemption tables beside ecosystem.tsv: a resolver row is a
# path the actor may settle without a session and a narrowing row is one it
# may not, so adding a row widens, removing one widens, and no edit is free
# but a comment. felix_escapes on a project with no risk.tsv, so only the
# engine's own channels speak. Each case is one commit on top of the base.
LT_E="$TMP/lt-escape"; LT_EP="$TMP/lt-escape-proj"; mkdir -p "$LT_E" "$LT_EP"
( cd "$LT_E" && git init -q -b main && git config user.email t@t && git config user.name t \
  && mkdir -p projects/anyproj some/dir && printf 'notes\n' > README.md \
  && { printf '# how each path lands\n'; _lt_row a.txt version-above engine/ -; _lt_row b.txt insertions-union - -
       printf '#c.txt\tversion-above\t-\t-\n'; _lt_row 'docs/.*roadmap.*' founder - -
       _lt_row e.txt session - -; _lt_row e.txt founder - -; } > projects/anyproj/land.tsv \
  && _lt_row a.txt version-above - - > some/dir/land.tsv \
  && { printf '# kind\tpath\twords\tnote\n'; _lt_row allow lib/y.sh npm prose; } > ecosystem.tsv \
  && git add -A && git commit -qm base ) >/dev/null 2>&1
LT_E="$(cd "$LT_E" && pwd -P)"
LT_EB="$(git -C "$LT_E" rev-parse -q --verify HEAD 2>/dev/null)"
LT_EL=projects/anyproj/land.tsv
_lt_esc() { ( cd "$LT_E" && . "$FROOT/harness/lib/escape.sh"; . "$FROOT/harness/lib/obligations.sh"
              felix_escapes "$LT_EP" "$LT_EB" "$LT_E" ) </dev/null 2>/dev/null; }
# The channels felix_escapes names for <path> once the edit is committed on
# the base, or `unchanged` when the edit left the tree as the base had it, so
# a quiet answer is never a fixture that did nothing.
_lt_echan() {  # <path> <edit command...>, run at the repository root
  local p="$1"; shift
  ( cd "$LT_E" && git reset -q --hard "$LT_EB" && git clean -qfd && "$@" && git add -A \
      && git -c user.name=t -c user.email=t@t commit -qm edit ) >/dev/null 2>&1
  if git -C "$LT_E" diff --quiet "$LT_EB" HEAD 2>/dev/null; then printf 'unchanged'; return 0; fi
  _lt_esc | awk -F'\t' -v p="$p" '$2 == p { print $1 }' | LC_ALL=C sort -u | awk '{ printf "%s%s", s, $0; s = " " }'
}
_lt_e_new() { mkdir -p projects/newproj && _lt_row a.txt version-above - - > projects/newproj/land.tsv; }
is  "adding a row to a land table escapes as verifier, or a branch could grant the actor a path and merge green" \
    "$(_lt_echan "$LT_EL" _lt_ed '1; END { print "d.txt\tversion-above\t-\t-" }' "$LT_EL")" "verifier"
has "and says why: its rows exempt things from a check, which is why growth is not free there" \
    "$(_lt_esc | awk -F'\t' -v p="$LT_EL" '$2 == p { print $3 }')" "exempt"
is  "removing a row escapes as verifier, or dropping a narrowing row would hand its path to the actor unseen" \
    "$(_lt_echan "$LT_EL" _lt_ed '!/^b\.txt\t/' "$LT_EL")" "verifier"
is  "commenting a row out escapes as verifier, or a hash mark would remove a row unseen" \
    "$(_lt_echan "$LT_EL" _lt_ed '/^a\.txt\t/ { $0 = "#" $0 } 1' "$LT_EL")" "verifier"
is  "turning a comment into a row escapes as verifier, or deleting a hash mark would add a row unseen" \
    "$(_lt_echan "$LT_EL" _lt_ed '/^#c\.txt\t/ { sub(/^#/, "") } 1' "$LT_EL")" "verifier"
is  "editing one cell of a row in place escapes as verifier, or a narrowing row could be turned into a resolver unseen" \
    "$(_lt_echan "$LT_EL" _lt_ed '/^b\.txt\t/ { sub(/insertions-union/, "version-above") } 1' "$LT_EL")" "verifier"
# Three edits a comparison of sorted, comma-stripped lines reads as no change,
# while the reader sees each: a comma on the last cell is an arg it refuses, so
# the founder row is dropped; of two rows on one path the first stands, so a
# swap changes which; and a repeated line is a duplicate it refuses.
is  "appending a comma to a founder row's last cell escapes as verifier, or the reader would drop that founder row with nobody asked" \
    "$(_lt_echan "$LT_EL" _lt_ed '/^docs\/\.\*roadmap/ { $0 = $0 "," } 1' "$LT_EL")" "verifier"
is  "swapping two rows that bind the same path escapes as verifier, or which of them stands could change with nobody asked" \
    "$(_lt_echan "$LT_EL" _lt_ed '/^e\.txt\tsession\t/ { held = $0; next } { print } /^e\.txt\tfounder\t/ { print held }' "$LT_EL")" "verifier"
is  "repeating a row exactly escapes as verifier, or a line the reader refuses as a duplicate would arrive unseen" \
    "$(_lt_echan "$LT_EL" _lt_ed '{ print } /^a\.txt\t/ { print }' "$LT_EL")" "verifier"
is  "and a comma added to an ecosystem.tsv row escapes as verifier too, since every exemption table is compared as its reader reads it" \
    "$(_lt_echan ecosystem.tsv _lt_ed '/^allow\tlib\/y\.sh\t/ { $0 = $0 "," } 1' ecosystem.tsv)" "verifier"
# The control for the five above, in the same fixture: prose stays free.
is  "rewording only a comment line in it escapes nothing, or every note about the table would go to the founder" \
    "$(_lt_echan "$LT_EL" _lt_ed '/^# how each path lands$/ { $0 = "# how each path is landed" } 1' "$LT_EL")" ""
is  "creating a land table with a row where the base had none escapes as verifier, or a new project's first recipe would land unseen" \
    "$(_lt_echan projects/newproj/land.tsv _lt_e_new)" "verifier"
is  "deleting a land table that had rows escapes as verifier, or every narrowing row in it would go at once unseen" \
    "$(_lt_echan "$LT_EL" git rm -q "$LT_EL")" "verifier"
is  "a land.tsv in any directory is one by its basename, and a row added to some/dir/land.tsv escapes as verifier" \
    "$(_lt_echan some/dir/land.tsv _lt_ed '1; END { print "b.txt\tversion-above\t-\t-" }' some/dir/land.tsv)" "verifier"
is  "and a row added to ecosystem.tsv still escapes as verifier, or land.tsv replaced the exemption table it was meant to join" \
    "$(_lt_echan ecosystem.tsv _lt_ed '1; END { print "allow\tlib/x.sh\tcargo\tprose" }' ecosystem.tsv)" "verifier"
( cd "$LT_E" && git reset -q --hard "$LT_EB" && git clean -qfd ) >/dev/null 2>&1
is  "the exemption tables are exactly ecosystem.tsv and land.tsv, or any change to a land table would not reach a person" \
    "$( . "$FROOT/harness/lib/escape.sh" 2>/dev/null; printf '%s' "${FELIX_ESCAPE_EXEMPTION_TABLES:-}" )" "ecosystem.tsv land.tsv"
is  "and land.tsv is named once among the escape tables, as a basename, or a project's table under a name the engine does not know would be missed" \
    "$( . "$FROOT/harness/lib/escape.sh" 2>/dev/null
        printf '%s\n' "${FELIX_ESCAPE_TABLES:-}" | awk '{ for (i = 1; i <= NF; i++) if ($i == "land.tsv") n++ } END { print n+0 }' )" "1"
# Not a commission table: the policy hash covers every listed name whether or
# not the file exists, so joining that list would move every governed
# project's hash on deploy. The pair above is the red sibling of these two.
is  "but the commission tables stay byte-identical with land.tsv loaded, or every governed project's policy hash would move on deploy" \
    "$( . "$FROOT/harness/lib/detect.sh" 2>/dev/null; . "$FROOT/harness/lib/commission.sh" 2>/dev/null; . "$LT_LIB" 2>/dev/null
        printf '%s' "${FELIX_COMMISSION_TABLES:-}" )" \
    "project.json capabilities commissioning.tsv stack.tsv profiles.tsv routes.tsv setup.tsv probes.tsv risk.tsv evidence.tsv deny.tsv obligations.tsv"
LT_PV="$TMP/lt-policy"; mkdir -p "$LT_PV"
printf 'marker\t-\t-\t-\t-\ttest -f .felix\t9\n' > "$LT_PV/commissioning.tsv"
_lt_pv() { ( . "$FROOT/harness/lib/detect.sh" 2>/dev/null; . "$FROOT/harness/lib/commission.sh" 2>/dev/null
             . "$LT_LIB" 2>/dev/null; felix_commission_policy_version "$LT_PV" 2>/dev/null ) </dev/null; }
_ltpv0="$(_lt_pv)"; _lt_row a.txt version-above - - > "$LT_PV/land.tsv"; _ltpv1="$(_lt_pv)"
is  "and a project's commission policy version is the same with and without a land.tsv beside its tables, or writing one would stale its receipt" \
    "$([ -n "$_ltpv0" ] && [ "$_ltpv0" = "$_ltpv1" ] && echo same || echo "moved: [$_ltpv0] [$_ltpv1]")" "same"

# ---------------------------------------------------------------- behind ----
# main at c1, feat at c3 off c1, and origin/main moved to c2, a child of c1
# that feat does not hold. Checked out on feat.
_lt_mkb() {  # <dir> <proj>
  mkdir -p "$1" "$MEM/$2" && ( cd "$1" && git init -q -b main && git config user.email t@t && git config user.name t \
    && mkdir -p "projects/$2" && printf '{ "name": "%s" }\n' "$2" > "projects/$2/project.json" \
    && printf 'one\n' > one.txt && git add -A && git commit -qm c1 \
    && git checkout -q -b feat && printf 'three\n' > three.txt && git add -A && git commit -qm c3 \
    && git checkout -q --detach main && printf 'two\n' > two.txt && git add -A && git commit -qm c2 \
    && git update-ref refs/remotes/origin/main HEAD && git checkout -q feat ) >/dev/null 2>&1; }
_lt_behind() {  # <root> <base>: felix_merge_behind's status, then what it printed
  ( . "$LT_LIB" 2>/dev/null; _lto="$(felix_merge_behind "$1" "$2" 2>/dev/null)"; _ltr=$?; printf '%s|%s' "$_ltr" "$_lto" ) </dev/null; }
_lt_mkb "$TMP/lt-behind" ltbh; LT_B="$(cd "$TMP/lt-behind" && pwd -P)"
LT_BC2="$(git -C "$LT_B" rev-parse -q --verify 'refs/remotes/origin/main^{commit}' 2>/dev/null)"
LT_BC3="$(git -C "$LT_B" rev-parse -q --verify 'HEAD^{commit}' 2>/dev/null)"
is  "the behind fixture stands where it says: feat does not hold origin/main's commit" \
    "$(git -C "$LT_B" merge-base --is-ancestor "$LT_BC2" HEAD >/dev/null 2>&1 && echo current || echo behind) $(git -C "$LT_B" rev-parse --abbrev-ref HEAD 2>/dev/null)" "behind feat"
is  "a branch that does not hold origin/main's commit is behind, status 0, naming the base and both commits, or a stale branch would land unannounced" \
    "$(_lt_behind "$LT_B" origin/main)" "$(printf '0|origin/main\t%s\t%s' "$LT_BC2" "$LT_BC3")"
_lt_mkb "$TMP/lt-merged" ltmg; LT_B2="$(cd "$TMP/lt-merged" && pwd -P)"
( cd "$LT_B2" && git merge -q --no-edit refs/remotes/origin/main ) >/dev/null 2>&1
is  "the merged behind fixture holds origin/main once it has merged it" "$(_lt_state "$LT_B2")" "current"
is  "and a branch that has merged origin/main is not behind, status 1 and nothing printed, or every current branch would be reported" \
    "$(_lt_behind "$LT_B2" origin/main)" "1|"
is  "a base that names nothing, or no base at all, cannot be told, status 2 and nothing printed, or a typo would read as current" \
    "$(_lt_behind "$LT_B" no-such) $(_lt_behind "$LT_B" '')" "2| 2|"
LT_B3="$TMP/lt-unborn"; mkdir -p "$LT_B3"
( cd "$LT_B3" && git init -q -b main && git config user.email t@t && git config user.name t \
  && printf 'one\n' > one.txt && git add -A && git commit -qm c1 && git update-ref refs/remotes/origin/main HEAD \
  && git checkout -q --orphan unborn ) >/dev/null 2>&1
is  "the unborn fixture has no HEAD commit while origin/main resolves" \
    "$(git -C "$LT_B3" rev-parse -q --verify 'HEAD^{commit}' >/dev/null 2>&1 && echo head || echo no-head) $(git -C "$LT_B3" rev-parse -q --verify refs/remotes/origin/main >/dev/null 2>&1 && echo base || echo no-base)" "no-head base"
is  "and a checkout whose HEAD holds no commit cannot be told either, status 2, or a fresh branch would read as current" \
    "$(_lt_behind "$LT_B3" origin/main)" "2|"

# ------------------------------------------------------------------ owed ----
# origin/main carries felix-home's seven rows for projects/ltow, and one row
# with a file trigger for projects/ltc. One branch per case, each cut from
# origin/main and rewriting the files it names.
LT_F="$TMP/lt-owed"; mkdir -p "$LT_F" "$MEM/ltow" "$MEM/ltc"
( cd "$LT_F" && git init -q -b main && git config user.email t@t && git config user.name t \
  && mkdir -p projects/ltow projects/ltc engine/.claude-plugin engine/harness/tests engine/harness/lib docs src \
  && cp "$LT_SEVEN" projects/ltow/land.tsv && _lt_row out.txt insertions-union src/a.c - > projects/ltc/land.tsv \
  && printf '{ "version": "0.0.1" }\n' > engine/.claude-plugin/plugin.json \
  && printf 'base\n' > engine/harness/tests/red.tsv && printf 'x\n' > engine/harness/lib/x.sh \
  && printf 'a\n' > docs/a.md && printf 'c\n' > src/a.c && printf 'cc\n' > src/a.cc && printf 'out\n' > out.txt \
  && git add -A && git commit -qm c1 && git update-ref refs/remotes/origin/main HEAD ) >/dev/null 2>&1
LT_F="$(cd "$LT_F" && pwd -P)"; LT_FP="$LT_F/projects/ltow"
_lt_fbr() {  # <branch> <file>...
  local b="$1" f; shift
  ( cd "$LT_F" && git checkout -q -f -B "$b" refs/remotes/origin/main && git clean -qfd \
      && for f in "$@"; do printf 'changed on %s\n' "$b" >> "$f"; done \
      && git add -A && git commit -qm "$b" ) >/dev/null 2>&1; }
_lt_fon() { ( cd "$LT_F" && git checkout -q -f "$1" && git clean -qfd ) >/dev/null 2>&1; }
_lt_owed() {  # <proj dir> <root> [base]: felix_land_owed's status, then what it printed
  ( unset FELIX_MERGE_DRY_RUN; . "$LT_LIB" 2>/dev/null
    _lto="$(felix_land_owed "$1" "$2" "${3-origin/main}" 2>/dev/null)"; _ltr=$?; printf '%s|%s' "$_ltr" "$_lto" ) </dev/null; }
_lt_fbr f-all  engine/harness/lib/x.sh engine/.claude-plugin/plugin.json engine/harness/tests/red.tsv
_lt_fbr f-docs docs/a.md
_lt_fbr f-ver  engine/.claude-plugin/plugin.json
_lt_fbr f-dash engine/harness/lib/x.sh engine/.claude-plugin/plugin.json engine/harness/tests/red.tsv -
_lt_fbr f-c    src/a.c
_lt_fbr f-cc   src/a.cc
_lt_fbr feat   engine/harness/lib/x.sh
LT_OWED2="$(printf 'engine/.claude-plugin/plugin.json\tversion-above\tengine/\nengine/harness/tests/red.tsv\trerun\tengine/')"
is  "the owed fixture's feat changes engine/harness/lib/x.sh alone against origin/main" \
    "$(git -C "$LT_F" diff --name-only refs/remotes/origin/main HEAD 2>/dev/null)" "engine/harness/lib/x.sh"
is  "a change under engine/ that bumps no version and reruns nothing owes both rows, in table order, or the landing that forgot them goes unnamed" \
    "$(_lt_owed "$LT_FP" "$LT_F")" "0|$LT_OWED2"
_lt_fon f-all
is  "the same change with the version bumped and red.tsv rewritten owes nothing, or a row would stay owed after it was paid" \
    "$(_lt_owed "$LT_FP" "$LT_F")" "0|"
_lt_fon f-docs
is  "a change outside every trigger owes nothing, or a docs branch would be told it owes a version" \
    "$(_lt_owed "$LT_FP" "$LT_F")" "0|"
_lt_fon f-ver
is  "a version bump alone still owes red.tsv, since plugin.json is itself under engine/, or the bump would excuse the rerun" \
    "$(_lt_owed "$LT_FP" "$LT_F")" "0|$(printf 'engine/harness/tests/red.tsv\trerun\tengine/')"
_lt_fon f-c
is  "a trigger naming a file owes its row when that very file changes, or file triggers would bind nothing" \
    "$(_lt_owed "$LT_F/projects/ltc" "$LT_F")" "0|$(printf 'out.txt\tinsertions-union\tsrc/a.c')"
_lt_fon f-cc
is  "but not when a file it merely prefixes changes, since only a trigger ending in a slash names a directory" \
    "$(_lt_owed "$LT_F/projects/ltc" "$LT_F")" "0|"
_lt_fon f-dash
is  "the dash fixture's branch changes a file named - and leaves assertions.tsv and tests/run alone" \
    "$(git -C "$LT_F" diff --name-only refs/remotes/origin/main HEAD 2>/dev/null | awk '$0 == "-" || /assertions\.tsv$/ || /tests\/run$/' | tr '\n' ' ')" "- "
is  "a row whose trigger is - is never owed, not even when a file named - changes and its path is untouched, or the dash would read as a path" \
    "$(_lt_owed "$LT_FP" "$LT_F")" "0|"
( cd "$LT_F" && git checkout -q -f -B f-tree refs/remotes/origin/main && git clean -qfd \
  && printf 'changed\n' >> engine/harness/lib/x.sh && _lt_row docs/a.md version-above engine/ - >> projects/ltow/land.tsv \
  && git add -A && git commit -qm f-tree && _lt_row out.txt version-above engine/ - >> projects/ltow/land.tsv ) >/dev/null 2>&1
is  "a row that exists only on the branch or only in the working tree is never owed, or a pull request could invent a debt the base does not hold" \
    "$(_lt_owed "$LT_FP" "$LT_F")" "0|$LT_OWED2"
is  "an empty base or one that names nothing cannot be computed, status 2 and nothing printed, or a typo would read as nothing owed" \
    "$(_lt_owed "$LT_FP" "$LT_F" '') $(_lt_owed "$LT_FP" "$LT_F" no-such)" "2| 2|"
# What merging would change includes what is not yet committed: x.sh edited
# on a branch that is origin/main itself, first unstaged, then staged. A reader
# of committed changes only, three dots or two, owes nothing here.
( cd "$LT_F" && git checkout -q -f -B f-wt refs/remotes/origin/main && git clean -qfd \
  && printf 'edited, not committed\n' >> engine/harness/lib/x.sh ) >/dev/null 2>&1
is  "the uncommitted-change fixture's HEAD is origin/main's commit, and x.sh differs only in the working tree" \
    "$(git -C "$LT_F" rev-parse -q --verify HEAD 2>/dev/null | cut -c1-12) $(git -C "$LT_F" diff --name-only 2>/dev/null) $(git -C "$LT_F" diff --cached --name-only 2>/dev/null | awk 'END { print NR }')" \
    "$(git -C "$LT_F" rev-parse -q --verify refs/remotes/origin/main 2>/dev/null | cut -c1-12) engine/harness/lib/x.sh 0"
is  "an engine change left unstaged owes both rows, or a landing that commits it later would never have been told" \
    "$(_lt_owed "$LT_FP" "$LT_F")" "0|$LT_OWED2"
( cd "$LT_F" && git add engine/harness/lib/x.sh ) >/dev/null 2>&1
is  "and staged, it owes both rows still, or the index would hide a debt the working tree showed" \
    "$(git -C "$LT_F" diff --cached --name-only 2>/dev/null)|$(_lt_owed "$LT_FP" "$LT_F")" "engine/harness/lib/x.sh|0|$LT_OWED2"

# ---------------------------------------------------- the report-only rows ----
_lt_said()  { awk -F'\t' '$2 == "would-refuse"' "$MEM/$1/says.log" 2>/dev/null; }
_lt_nsaid() { _lt_said "$1" | awk 'END { print NR }'; }
_lt_nall()  { awk 'END { print NR }' "$MEM/$1/says.log" 2>/dev/null || echo 0; }   # every row, whatever its kind
_lt_wr() {  # <proj dir> <root> <session, or - for none> <FELIX_MERGE_DRY_RUN: 1, 0, or - for unset> [base]: felix_land_would_refuse's status, then all it printed
  ( if [ "$3" = - ]; then unset CLAUDE_CODE_SESSION_ID; else CLAUDE_CODE_SESSION_ID="$3"; export CLAUDE_CODE_SESSION_ID; fi
    if [ "$4" = - ]; then unset FELIX_MERGE_DRY_RUN; else FELIX_MERGE_DRY_RUN="$4"; export FELIX_MERGE_DRY_RUN; fi
    . "$LT_LIB" 2>/dev/null
    _lto="$(felix_land_would_refuse "$1" "${5-origin/main}" "$2" 2>&1)"; _ltr=$?; printf '%s|%s' "$_ltr" "$_lto" ) </dev/null; }
# A behind branch, nothing owed: one row, and nothing said anywhere else.
LT_BP="$LT_B/projects/ltbh"
_ltn0="$(_lt_nsaid ltbh)"; _lta0="$(_lt_nall ltbh)"
is  "felix_land_would_refuse on a behind branch prints nothing on stdout or stderr and returns 0, or it could not sit inside the merge boundary unseen" \
    "$(_lt_wr "$LT_BP" "$LT_B" lt-s1 0)" "0|"
_ltn1="$(_lt_nsaid ltbh)"; _lta1="$(_lt_nall ltbh)"
# Counted twice: the would-refuse rows, and every row of any kind. A held or
# refused row beside it would move a figure the report must not move.
is  "and it adds exactly one row to that project's says.log, a would-refuse row and nothing of another kind, or the behind branch would leave no record or move another count" \
    "$((_ltn1 - _ltn0)) $((_lta1 - _lta0))" "1 1"
is  "recorded under the session it ran in, with felix merge as its cause, or the row could not be joined to the attempt" \
    "$(_lt_said ltbh | tail -1 | cut -f3,4)" "$(printf 'lt-s1\tfelix merge')"
has "saying which branch is behind which base, by both commits, or the row would not say what to merge" \
    "$(_lt_said ltbh | tail -1 | cut -f5)" "feat: behind: origin/main $LT_BC2 is not in HEAD $LT_BC3"
_lt_wr "$LT_BP" "$LT_B" - 0 >/dev/null
is  "with no session variable the would-refuse row says unknown in the session column, or it would carry an empty cell" \
    "$(_lt_said ltbh | tail -1 | cut -f3)" "unknown"
_ltn0="$(_lt_nsaid ltbh)"; _lt_wr "$LT_BP" "$LT_B" lt-s1 1 >/dev/null; _ltn1="$(_lt_nsaid ltbh)"
is  "a dry run on the same behind branch adds no row, or says.log would record merges nobody attempted" \
    "$((_ltn1 - _ltn0))" "0"
# Only 0 is a real attempt: cmd_merge sets 0 or 1, and a CLI from before this
# library sets nothing, so unset is what that CLI's --dry-run looks like.
_ltn0="$(_lt_nsaid ltbh)"; _lt_wr "$LT_BP" "$LT_B" lt-s1 - >/dev/null
_ltn1="$(_lt_nsaid ltbh)"; _lt_wr "$LT_BP" "$LT_B" lt-s1 0 >/dev/null; _ltn2="$(_lt_nsaid ltbh)"
is  "with FELIX_MERGE_DRY_RUN unset it adds no row, and with it 0 it adds one, or an older CLI's dry run would write the report" \
    "$((_ltn1 - _ltn0)) $((_ltn2 - _ltn1))" "0 1"
# The owed fixture's feat: owing, not behind.
_lt_fon feat
LT_FH="$(git -C "$LT_F" rev-parse -q --verify HEAD 2>/dev/null)"
is  "the owed fixture's feat is not behind origin/main" "$(_lt_state "$LT_F") $(git -C "$LT_F" rev-parse --abbrev-ref HEAD 2>/dev/null)" "current feat"
_ltn0="$(_lt_nsaid ltow)"; _lta0="$(_lt_nall ltow)"; _lt_wr "$LT_FP" "$LT_F" lt-s1 0 >/dev/null
_ltn1="$(_lt_nsaid ltow)"; _lta1="$(_lt_nall ltow)"
is  "a branch that owes rows and is not behind adds exactly one row, a would-refuse row and nothing of another kind, or the debt would leave no record or move another count" \
    "$((_ltn1 - _ltn0)) $((_lta1 - _lta0))" "1 1"
has "naming each owed path with its kind and trigger, in table order, at HEAD, or the row would not say what is owed" \
    "$(_lt_said ltow | tail -1 | cut -f5)" \
    "feat: owed: engine/.claude-plugin/plugin.json (version-above on engine/); engine/harness/tests/red.tsv (rerun on engine/) at HEAD $LT_FH"
_ltn0="$(_lt_nsaid ltow)"; _lt_wr "$LT_FP" "$LT_F" lt-s1 1 >/dev/null; _ltn1="$(_lt_nsaid ltow)"
is  "and a dry run on that owing branch adds none, or a triage session's dry run would write a report" \
    "$((_ltn1 - _ltn0))" "0"
_lt_fon f-docs
_ltn0="$(_lt_nsaid ltow)"; _lt_wr "$LT_FP" "$LT_F" lt-s1 0 >/dev/null; _ltn1="$(_lt_nsaid ltow)"
is  "a branch neither behind nor owing adds no row, or every clean landing would leave a refusal on record" \
    "$(_lt_state "$LT_F") $((_ltn1 - _ltn0))" "current 0"
# Behind and owing at once: two rows, behind first. origin/main moved the way
# it does on felix-home, by an engine landing that bumped the version and
# rewrote red.tsv, so a two-dot diff against it names both files as changed
# and would read the branch as having paid what it owes.
_lt_mkbo() {  # <dir> <proj>: origin/main carries the seven rows for projects/<proj>; feat changes x.sh and is behind
  mkdir -p "$1" "$MEM/$2" && ( cd "$1" && git init -q -b main && git config user.email t@t && git config user.name t \
    && mkdir -p "projects/$2" engine/.claude-plugin engine/harness/tests engine/harness/lib docs \
    && cp "$LT_SEVEN" "projects/$2/land.tsv" && printf '{ "version": "0.0.1" }\n' > engine/.claude-plugin/plugin.json \
    && printf 'base\n' > engine/harness/tests/red.tsv && printf 'x\n' > engine/harness/lib/x.sh && printf 'a\n' > docs/a.md \
    && git add -A && git commit -qm c1 \
    && git checkout -q -b feat && printf 'y\n' > engine/harness/lib/x.sh && git commit -qam work \
    && git checkout -q --detach main && printf 'b\n' > docs/b.md \
    && printf '{ "version": "0.0.2" }\n' > engine/.claude-plugin/plugin.json && printf 'main\n' > engine/harness/tests/red.tsv \
    && git add -A && git commit -qm c2 \
    && git update-ref refs/remotes/origin/main HEAD && git checkout -q feat ) >/dev/null 2>&1; }
_lt_mkbo "$TMP/lt-both" ltbo; LT_BO="$(cd "$TMP/lt-both" && pwd -P)"
is  "the behind-and-owing fixture is behind origin/main and changes engine/harness/lib/x.sh alone since the merge-base" \
    "$(_lt_state "$LT_BO") $(git -C "$LT_BO" diff --name-only refs/remotes/origin/main...HEAD 2>/dev/null)" "behind engine/harness/lib/x.sh"
is  "while a two-dot diff against origin/main also names plugin.json and red.tsv, which main's own landing changed" \
    "$(git -C "$LT_BO" diff --name-only refs/remotes/origin/main HEAD 2>/dev/null | tr '\n' ' ')" \
    "docs/b.md engine/.claude-plugin/plugin.json engine/harness/lib/x.sh engine/harness/tests/red.tsv "
_ltn0="$(_lt_nsaid ltbo)"; _lt_wr "$LT_BO/projects/ltbo" "$LT_BO" lt-s1 0 >/dev/null
is  "a branch both behind and owing adds two rows, behind first and then owed, or one of the two reports would be lost" \
    "$(_lt_said ltbo | tail -n +"$((_ltn0 + 1))" | cut -f5 | awk -F': ' '{ printf "%s%s", s, $2; s = " " }')" "behind owed"
has "and the owed row names the version and the record, which main changed and the branch did not, or a behind branch would read as having paid them" \
    "$(_lt_said ltbo | tail -1 | cut -f5)" \
    ": owed: engine/.claude-plugin/plugin.json (version-above on engine/); engine/harness/tests/red.tsv (rerun on engine/) at HEAD "
# A row the schema refuses at the base is not a clean table, and it is not a
# debt either: it is said on its own row, by line, never folded into owed.
LT_RF="$TMP/lt-refused"; mkdir -p "$LT_RF" "$MEM/ltrf"
( cd "$LT_RF" && git init -q -b main && git config user.email t@t && git config user.name t \
  && mkdir -p projects/ltrf docs && printf 'a\n' > docs/a.md \
  && { printf '# a table with one row the schema refuses\n'; _lt_row a.txt version-above - -
       _lt_row projects/p/risk.tsv version-above - -; } > projects/ltrf/land.tsv \
  && git add -A && git commit -qm c1 && git update-ref refs/remotes/origin/main HEAD \
  && git checkout -q -b feat && printf 'b\n' >> docs/a.md && git commit -qam docs ) >/dev/null 2>&1
LT_RF="$(cd "$LT_RF" && pwd -P)"
_ltn0="$(_lt_nsaid ltrf)"; _lt_wr "$LT_RF/projects/ltrf" "$LT_RF" lt-s1 0 >/dev/null
is  "a row the schema refuses at the base is reported on a land-table row of its own, by line and reason, and in no owed row, or a broken table would pass for a clean one or read as a debt" \
    "$(_lt_said ltrf | tail -n +"$((_ltn0 + 1))" | cut -f5)" "feat: land-table: line 3 refused: protected at HEAD $(git -C "$LT_RF" rev-parse -q --verify HEAD 2>/dev/null)\\n"

# At the merge boundary, called the way _blk calls it. The two rows are the
# only difference a real attempt makes; the blocker lines, byte for byte, and
# the exit status are what they were.
_lt_blk() {  # <proj dir> <root> <stdout file> <FELIX_MERGE_DRY_RUN: 1 or 0>: felix_merge_blockers' status
  ( cd "$2" && FELIX_MERGE_DRY_RUN="$4" && export FELIX_MERGE_DRY_RUN
    . "$FROOT/harness/lib/escape.sh"; . "$FROOT/harness/lib/obligations.sh"
    . "$FROOT/harness/lib/evidence.sh"; . "$FROOT/harness/lib/verify.sh"
    felix_merge_blockers "$1" origin/main "$2" "$FROOT" > "$3" 2>/dev/null; echo "$?" ) </dev/null 2>/dev/null; }
_ltn0="$(_lt_nsaid ltbo)"; _lta0="$(_lt_nall ltbo)"; _ltbr="$(_lt_blk "$LT_BO/projects/ltbo" "$LT_BO" "$TMP/lt-blk-real" 0)"
_ltn1="$(_lt_nsaid ltbo)"; _lta1="$(_lt_nall ltbo)"; _ltbd="$(_lt_blk "$LT_BO/projects/ltbo" "$LT_BO" "$TMP/lt-blk-dry" 1)"
_ltn2="$(_lt_nsaid ltbo)"; _lta2="$(_lt_nall ltbo)"
is  "felix_merge_blockers on a behind and owing branch writes both would-refuse rows and no row of another kind on a real attempt, and nothing on a dry run, or the boundary never reports them or reports more than them" \
    "$((_ltn1 - _ltn0)) $((_lta1 - _lta0)) $((_ltn2 - _ltn1)) $((_lta2 - _lta1))" "2 2 0 0"
is  "while it prints no line whose kind is behind or owed, or cmd_merge would refuse on a check that is only meant to report" \
    "$(awk -F'\t' '$1 == "behind" || $1 == "owed"' "$TMP/lt-blk-real" 2>/dev/null)" ""
is  "and prints byte for byte what the dry run printed, its unverified blocker included, or reporting would change what blocks" \
    "$(grep -q '^unverified' "$TMP/lt-blk-real" 2>/dev/null && cmp -s "$TMP/lt-blk-real" "$TMP/lt-blk-dry" && echo same || echo differs)" "same"
is  "and exits 0 on both, or the judge would take its own library for one that could not be loaded" \
    "$_ltbr $_ltbd" "0 0"

# The judge's own shell: set -u, and only the six libraries it sources. The
# rows prove escape.sh brings land-table.sh with it, and that brings say.sh
# (the row is written) and reads the table by its own scan in that shell,
# which needs nothing from table.sh and nothing from the environment.
_lt_mkbo "$TMP/lt-judge" ltjd; LT_JD="$(cd "$TMP/lt-judge" && pwd -P)"
LT_MARK="$TMP/lt-judge.reached"
_lt_judge() {  # <stdout file> [redefine] [FELIX_MERGE_DRY_RUN: 0 (the default), 1, or - for unset] [FELIX_TABLE_SKIP] [stub]: felix_merge_blockers' status in the judge's shell and load order
  ( cd "$LT_JD" && if [ "${3:-0}" = - ]; then unset FELIX_MERGE_DRY_RUN; else FELIX_MERGE_DRY_RUN="${3:-0}"; export FELIX_MERGE_DRY_RUN; fi
    if [ -n "${4:-}" ]; then FELIX_TABLE_SKIP="$4"; export FELIX_TABLE_SKIP; fi
    if [ -n "${5:-}" ]; then felix_land_rows() { :; }; felix_say() { :; }; export -f felix_land_rows felix_say; fi
    CLAUDE_CODE_SESSION_ID=lt-judge LT_REDEF="${2:-}" LT_MARK="$LT_MARK" \
    bash -c 'set -uo pipefail; k="$1"
      for f in resolve verify review classify evidence escape; do . "$k/lib/$f.sh" 2>/dev/null || exit 3; done
      if [ -n "$LT_REDEF" ]; then felix_land_would_refuse() { : > "$LT_MARK"; : "$lt_never_set"; }; fi
      felix_merge_blockers "$2" "$3" "$4" "$5"' _ "$FROOT/harness" "$LT_JD/projects/ltjd" origin/main "$LT_JD" "$FROOT" \
      > "$1" 2>/dev/null; echo "$?" ) </dev/null; }
_ltn0="$(_lt_nsaid ltjd)"; _ltjr="$(_lt_judge "$TMP/lt-judge-control")"
is  "the judge's own shell still judges a behind and owing branch and exits 0, or the merge boundary would die on the new library" \
    "$_ltjr" "0"
has "and writes the behind row there, or escape.sh does not bring land-table.sh and say.sh into the judge's shell" \
    "$(_lt_said ltjd | tail -n +"$((_ltn0 + 1))" | cut -f5)" "feat: behind: origin/main "
has "and the owed row, or land-table.sh cannot read the table in the judge's shell" \
    "$(_lt_said ltjd | tail -n +"$((_ltn0 + 1))" | cut -f5)" \
    ": owed: engine/.claude-plugin/plugin.json (version-above on engine/); engine/harness/tests/red.tsv (rerun on engine/) at HEAD "
# The session's environment reaches the judge's child shell: a skip pattern
# exported there must not change which rows the judge reads.
_ltn0="$(_lt_nsaid ltjd)"; _lt_judge "$TMP/lt-judge-skip" '' 0 '.' >/dev/null
has "and with FELIX_TABLE_SKIP exported as a pattern every line matches, the judge's owed row is the same, or a session could empty the table the judge reads" \
    "$(_lt_said ltjd | tail -n +"$((_ltn0 + 1))" | cut -f5)" \
    ": owed: engine/.claude-plugin/plugin.json (version-above on engine/); engine/harness/tests/red.tsv (rerun on engine/) at HEAD "
# Functions travel the same way: the child shell imports what the session
# exported, so a library loaded only when its function is missing would give
# way to the session's own felix_land_rows and felix_say.
_ltn0="$(_lt_nsaid ltjd)"; _lt_judge "$TMP/lt-judge-stub" '' 0 '' stub >/dev/null
is  "and with felix_land_rows and felix_say exported by the session as functions that do nothing, the judge still writes both rows, or a session could stand in for the library" \
    "$(_lt_said ltjd | tail -n +"$((_ltn0 + 1))" | cut -f5 | awk -F': ' '{ printf "%s%s", s, $2; s = " " }')" "behind owed"
# Self-governed, a dry run reaches the report only through this environment:
# FELIX_MERGE_DRY_RUN=1, or nothing at all from a CLI older than the library.
_ltn0="$(_lt_nsaid ltjd)"; _ltjd1="$(_lt_judge "$TMP/lt-judge-dry1" '' 1)"; _ltn1="$(_lt_nsaid ltjd)"
_ltjdu="$(_lt_judge "$TMP/lt-judge-dryu" '' -)"; _ltn2="$(_lt_nsaid ltjd)"
_ltjd0="$(_lt_judge "$TMP/lt-judge-dry0" '' 0)"; _ltn3="$(_lt_nsaid ltjd)"
is  "in the judge's shell a dry run and an unset variable write no row, and a real attempt writes two, each exiting 0, or a self-governed dry run would write the report" \
    "$_ltjd1 $((_ltn1 - _ltn0)) $_ltjdu $((_ltn2 - _ltn1)) $_ltjd0 $((_ltn3 - _ltn2))" "0 0 0 0 0 2"
_ltn0="$(_lt_nsaid ltjd)"; _ltjr="$(_lt_judge "$TMP/lt-judge-broken" 1)"; _ltn1="$(_lt_nsaid ltjd)"
is  "a report writer that dies on an unset variable is still reached from the judge's shell, or the containment asserted next is never exercised" \
    "$([ -e "$LT_MARK" ] && echo reached || echo never)" "reached"
is  "and the judge still exits 0 with stdout byte for byte the control's and no row written, or a failing report could fail a merge" \
    "$_ltjr $(cmp -s "$TMP/lt-judge-control" "$TMP/lt-judge-broken" && echo same || echo differs) $((_ltn1 - _ltn0))" "0 same 0"

# Through the real CLI, on a governed product checkout that is behind and has
# no gate receipt, so it stops at unverified before any gh call.
_lt_blockerish() { printf '%s\n' "$1" | awk '{ t = $1; sub(/^[-*]+/, "", t); sub(/:$/, "", t) }
                                             t == "behind" || t == "owed" || index($0, "behind\t") || index($0, "owed\t")'; }
LT_P="$TMP/lt-product"; mkdir -p "$LT_P"
( cd "$LT_P" && git init -q -b main && git config user.email t@t && git config user.name t \
  && printf 'widget\n' > .felix && printf 'contents\n' > WIDGET.txt && git add -A && git commit -qm c1 \
  && git checkout -q -b feat && printf 'work\n' > work.txt && git add -A && git commit -qm c3 \
  && git checkout -q --detach main && printf 'moved\n' > moved.txt && git add -A && git commit -qm c2 \
  && git update-ref refs/remotes/origin/main HEAD && git checkout -q feat ) >/dev/null 2>&1
LT_P="$(cd "$LT_P" && pwd -P)"
is  "the product checkout is bound to the widget, tracks no plugin.json and is behind origin/main" \
    "$(cat "$LT_P/.felix" 2>/dev/null) $(git -C "$LT_P" ls-files engine/.claude-plugin/plugin.json 2>/dev/null | awk 'END { print NR }') $(_lt_state "$LT_P")" \
    "widget 0 behind"
_ltn0="$(_lt_nsaid widget)"
_ltout="$( cd "$LT_P" && unset FELIX_MERGE_DRY_RUN && "$FELIX" merge --base main 2>&1 )"; _ltrc=$?
_ltn1="$(_lt_nsaid widget)"
is  "a real felix merge on a behind product checkout with no receipt still refuses with exit 3, or reporting changed how it lands" \
    "$_ltrc" "3"
has "and still names the unverified tree, or reporting displaced the blocker that stops it" "$_ltout" "unverified"
is  "and shows no behind or owed blocker, or a report-only check would be read as a refusal" \
    "$(_lt_blockerish "$_ltout")" ""
is  "while it adds exactly one would-refuse row to the widget's says.log, or cmd_merge never reaches the report" \
    "$((_ltn1 - _ltn0))" "1"
has "saying the branch is behind origin/main, or the CLI hands the report a base other than the one it compared" \
    "$(_lt_said widget | tail -1 | cut -f5)" ": behind: origin/main "
_ltn0="$(_lt_nsaid widget)"; ( cd "$LT_P" && "$FELIX" merge --base main --dry-run >/dev/null 2>&1 ); _ltn1="$(_lt_nsaid widget)"
is  "a felix merge --dry-run on the same checkout adds no would-refuse row, or cmd_merge does not tell the report that a dry run is one" \
    "$((_ltn1 - _ltn0))" "0"
_ltn0="$(_lt_nsaid widget)"; ( cd "$LT_P" && FELIX_MERGE_DRY_RUN=1 "$FELIX" merge --base main >/dev/null 2>&1 ); _ltn1="$(_lt_nsaid widget)"
is  "and a real attempt still writes its row when the session exported FELIX_MERGE_DRY_RUN=1, or a session could silence the report by its environment" \
    "$((_ltn1 - _ltn0))" "1"
( cd "$LT_P" && git merge -q --no-edit refs/remotes/origin/main ) >/dev/null 2>&1
is  "the product checkout holds origin/main once it has merged it" "$(_lt_state "$LT_P")" "current"
_ltn0="$(_lt_nsaid widget)"
_ltout="$( cd "$LT_P" && unset FELIX_MERGE_DRY_RUN && "$FELIX" merge --base main 2>&1 )"; _ltrc=$?
_ltn1="$(_lt_nsaid widget)"
is  "and a real attempt there still refuses on the unverified tree and adds no would-refuse row, or every current branch would be reported behind" \
    "$_ltrc $((_ltn1 - _ltn0))" "3 0"

# -------------------------------------------------------- the table itself ----
# felix-home's own table, where Felix's own repository keeps it. The red run
# stands in the base's tree, which has projects/felix/project.json and no
# land.tsv, and fails these; a tree that is not Felix's own skips them.
LT_HOME="$(cd "$REAL_HARNESS/../.." && pwd)"
LT_FL="$LT_HOME/projects/felix/land.tsv"
_lth1="felix-home's land.tsv holds the design's seven rows, by the hash of its data rows, or the table the founder arms is not the one designed"
_lth2="and its data rows are those seven, verbatim and in order, so a drifted row is shown by name and not only by a hash"
_lth3="and felix_land_malformed_in refuses none of them and exits 0, or the home's own table would bind nothing"
_lth4="and the table validator accepts it under its schemas.tsv row, or schema-check would fail the gate"
if [ -f "$LT_HOME/projects/felix/project.json" ]; then
  if [ -f "$LT_FL" ]; then
    is "$_lth1" "$( ( . "$REAL_HARNESS/lib/table.sh" 2>/dev/null; felix_table_rows "$LT_FL" ) 2>/dev/null | git hash-object --stdin )" \
       "3dc2dcb4612f4bb0226ef5a5b9f30ba173619d60"
    is "$_lth2" "$( ( . "$REAL_HARNESS/lib/table.sh" 2>/dev/null; felix_table_rows "$LT_FL" ) 2>/dev/null )" "$(cat "$LT_SEVEN")"
    is "$_lth3" "$(_lt_verdict "$LT_FL")" "rows=7 refused= rc=0"
    is "$_lth4" "$( ( . "$REAL_HARNESS/lib/table.sh" 2>/dev/null
                      felix_table_check "$REAL_HARNESS/templates/schemas.tsv" "$LT_FL" >/dev/null 2>&1; echo $? ) )" "0"
  else
    for _ltn in "$_lth1" "$_lth2" "$_lth3" "$_lth4"; do bad "$_ltn" "no projects/felix/land.tsv in Felix's own repository"; done
  fi
else
  for _ltn in "$_lth1" "$_lth2" "$_lth3" "$_lth4"; do skip "$_ltn" "not Felix's own repository: no projects/felix/project.json"; done
fi
is  "schemas.tsv declares land.tsv a tree table of path, kind, trigger and arg that may be empty, or every land.tsv would be an undeclared table" \
    "$( ( . "$REAL_HARNESS/lib/table.sh" 2>/dev/null; felix_table_schema "$REAL_HARNESS/templates/schemas.tsv" land.tsv ) 2>/dev/null )" \
    "$(printf 'land.tsv\ttree\tpath kind trigger arg\tallowed')"
mkdir -p "$TMP/lt-schema"; { cat "$LT_SEVEN"; printf 'a.txt\tversion-above\t-\n'; } > "$TMP/lt-schema/land.tsv"
is  "and the validator refuses a three-cell row in a land table as cells, exit 1, or schema-check would pass a row the reader splits wrong" \
    "$( ( . "$REAL_HARNESS/lib/table.sh" 2>/dev/null
          _lto="$(felix_table_check "$REAL_HARNESS/templates/schemas.tsv" "$TMP/lt-schema/land.tsv" 2>/dev/null)"; _ltr=$?
          printf '%s|%s' "$_ltr" "$(printf '%s\n' "$_lto" | cut -f2 | LC_ALL=C sort -u | awk 'NF { printf "%s%s", s, $0; s = " " }')" ) )" "1|cells"
# The gate holds a land table to the schema rule as well as to its cells: a
# row the reader would refuse at landing never merges green. The fixture's
# own schemas.tsv declares land.tsv, so only the rule itself can fail it.
LT_SC="$TMP/lt-schemacheck"; mkdir -p "$LT_SC/engine/harness/templates" "$LT_SC/projects/p"
printf 'schemas.tsv\ttree\ttable lives columns empty\trefused\nland.tsv\ttree\tpath kind trigger arg\tallowed\n' \
  > "$LT_SC/engine/harness/templates/schemas.tsv"
cp "$LT_SEVEN" "$LT_SC/projects/p/land.tsv"
( cd "$LT_SC" && git init -q -b main && git add -A && git -c user.name=t -c user.email=t@t commit -qm seed ) >/dev/null 2>&1
_lt_sc() { ( cd "$LT_SC" && "$REAL_HARNESS/bin/schema-check" 2>&1; echo "rc=$?" ) </dev/null; }
_ltsc0="$(_lt_sc)"
_lt_row projects/p/risk.tsv version-above - - >> "$LT_SC/projects/p/land.tsv"
_ltsc1="$(_lt_sc)"
is  "schema-check passes a tree whose land table holds felix-home's seven rows, and fails one whose resolver row binds risk.tsv, or a row the reader refuses would merge green" \
    "${_ltsc0##*rc=} ${_ltsc1##*rc=}" "0 1"
has "naming the table's line and the rule it breaks" "$_ltsc1" "projects/p/land.tsv:8	land-protected	escape-table"
# Invariant 1: the kinds are constants, and felix-home's rows live in its own
# table and nowhere in the engine. The first is red while the library does not
# exist; the second is its control.
if [ -f "$REAL_HARNESS/lib/land-table.sh" ]; then
  _ltg="$(grep -Fxf "$LT_SEVEN" "$REAL_HARNESS/lib/land-table.sh" 2>/dev/null)"
else
  _ltg="(no lib/land-table.sh)"
fi
is  "lib/land-table.sh exists and no line of it is one of felix-home's rows, or the engine would name a project's recipe" "$_ltg" ""
is  "and no file among the engine's libraries, CLI, hooks or templates carries one of those rows either, or a project's recipe would live in the engine" \
    "$(grep -rlFxf "$LT_SEVEN" "$REAL_HARNESS/lib" "$REAL_HARNESS/felix" "$REAL_HARNESS/hooks" "$REAL_HARNESS/templates" 2>/dev/null)" ""

printf '\nthe engine makes its scratch under TMPDIR\n'
# Measured 2026-09-24 on macOS 26.3.1: a bare `mktemp` or `mktemp -d` makes its
# file in the per-user /var/folders/.../T whatever TMPDIR says (set, unset, or
# naming a missing directory), while a template under TMPDIR, or -p, honours
# it. GNU mktemp on the Linux runner honours TMPDIR either way. So on a Mac a
# block that points TMPDIR at a fixture and counts what is left there read 0
# for any engine path with a bare mktemp, whether or not that path cleaned up.
# Thirteen such calls sat in felix and six libraries, and one in Felix's gate.
#
# The class, read from the text, since most of those paths (merge, discover,
# the gate's installed check) no fixture here drives cheaply. A call spelled
# some other way than $(mktemp ...) or `mktemp ...` is not seen by it. The
# drive below shows the reading matches what runs. Read from this harness and
# not from a checkout root, so a copy with no checkout around it still has
# its own text read rather than none; the gate is read where there is one.
_mkt_read=0
_mkt_bare="$(for f in "$REAL_HARNESS/felix" "$REAL_HARNESS"/lib/*.sh "$REAL_HARNESS"/bin/* "$REAL_HARNESS"/hooks/* \
               "$REAL_HARNESS/../../projects/felix/gate.sh"; do
               [ -f "$f" ] && grep -nE '\$\(mktemp|`mktemp' "$f" | sed "s|^|${f#"$REAL_HARNESS"/}:|"
             done | grep -vE '^[^:]*:[0-9]+:[[:space:]]*#' | grep -v 'XXXXXX')"
grep -q 'mktemp' "$REAL_HARNESS/felix" && _mkt_read=1
is "every mktemp the engine and Felix's gate run is given a template, so none lands outside TMPDIR on a Mac" \
   "$_mkt_read $_mkt_bare" "1 "

# Driven: a mktemp first on PATH that writes down what it was given and hands
# on to the real one, around the four paths a fixture reaches cheaply. Each
# must name a template under the TMPDIR it was given, and nothing may be left
# there after. The second half is the count that could not fail on a Mac while
# the first half did not hold. Measured with a copy of pulse.sh that keeps its
# scratch index: this count read 1 with the templates and 0 with the bare
# calls, whose index went to /var/folders instead.
MKT="$TMP/mktemp-drive"; mkdir -p "$MKT/bin" "$MKT/tmp" "$MKT/proj" "$MKT/repo" "$MKT/nohandoff"
printf '#!/bin/sh\nprintf "%%s\\n" "$*" >> "%s"\nexec "%s" "$@"\n' "$MKT/calls" "$(command -v mktemp)" > "$MKT/bin/mktemp"
chmod +x "$MKT/bin/mktemp"; : > "$MKT/calls"
printf '{\n  "name": "x",\n  "version": "1.2.3"\n}\n' > "$MKT/plugin.json"
printf 'web\tendpoint handler\tbackend\tplaywright\n' > "$MKT/proj/routes.tsv"
( cd "$MKT/repo" && git init -q -b main && : > f && git add f \
  && git -c user.name=t -c user.email=t@t commit -qm s ) >/dev/null 2>&1
( PATH="$MKT/bin:$PATH"; export TMPDIR="$MKT/tmp"
  . "$FROOT/harness/lib/resolve.sh"; felix_version_bump "$MKT/plugin.json"
  . "$FROOT/harness/lib/route.sh";   felix_route_append_play "$MKT/proj" web deepeval
  . "$FROOT/harness/lib/pulse.sh";   _felix_pulse_new_gitlinks "$MKT/repo"
  . "$FROOT/harness/lib/handoff.sh"; felix_handoff_rotate "$MKT/nohandoff" ) >/dev/null 2>&1
is "each engine mktemp driven here names a template under the TMPDIR it was given" \
   "$(awk -v t="$MKT/tmp/" '{ n = $NF; if (index(n, t) == 1 && n ~ /\.XXXXXX$/) { sub(/^.*\//, "", n); sub(/\.XXXXXX$/, "", n); printf "%s ", n } else printf "[%s] ", $0 }' "$MKT/calls")" \
   "felix-bump felix-routes felix-pulse felix-handoff "
is "and none of them leaves anything there" "$(ls -A "$MKT/tmp" | wc -l | tr -d ' ')" "0"
is "and each did its work: the version bumped and the tool wired in" \
   "$(grep -o '"version": "[^"]*"' "$MKT/plugin.json") $(cut -f4 "$MKT/proj/routes.tsv")" '"version": "1.2.4" playwright deepeval'

printf '\nthe record this branch carries\n'
# Raised by the same review. After a rebase, red.tsv held two runs' records
# concatenated, against a base two merges back, naming an assertion this suite
# no longer has, and the engine's version was below the one main had taken.
# These read the tree's own record and, where origin/main is known, git. The
# first three skip while --record-assertions is about to rewrite the record,
# and all four in the red run, which stands in the base's tree and would read
# the base's record. Every other assertion in this block asks this tree's own
# helpers, of records and repositories built here or of the history the suite
# stands in, and runs in the red run as in any other, since the run placed in
# the base is this tree's: until #371 they sat behind the red run's test with
# the four, and a red run reached none of them.
_rtn1="red.tsv is one record, written whole: one base row, one run row, failed names that add up to the run's failed count, and a run that counts at least as many assertions as the manifest lists"
_rtn2="every assertion red.tsv names as red is one the manifest lists"
_rtn3="red.tsv was recorded against the engine origin/main held where this tree branched from it"
_rtn4="this engine's version is above origin/main's when this tree holds commits origin/main lacks"
# Whether a red.tsv is one record as tests/red writes one: ok, or bad and why,
# on one line. Beyond one base row, one run row and names that add up to the
# failed count, the rows must agree, both - when no red run was made and both
# real when one was, and a real run counts at least one assertion, since
# tests/red refuses a run that reached none. A run row of - beside any base
# once passed, so a sha pasted into a retraction's base row answered _rtn3's
# failure of it (#371, second review, 2026-09-25). Given the manifest beside
# the record, a real run also counts at least the manifest's total: tests/red
# counts every name the manifest lists, reached or red by its shortfall, so a
# run that counts fewer was not written by it against this manifest. It was
# written by a tests/red that did not compare, of a suite cut short, as 0 of
# 270 was against some 3,700, or of one that reached its end with assertions
# lost on the way, as main's own record at 27573cbe counts 3,894 against
# 3,900; or the manifest changed after it was written (#371's follow-up). A
# manifest that is not there is not compared.
_rt_record_whole() {   # <red.tsv> [<manifest>] -> ok, or bad <detail>
  local b r f s m=""
  [ -n "${2:-}" ] && [ -f "$2" ] && m="$(awk -F'\t' '$1 ~ /^[0-9]+$/ { t += $1 } END { printf "%.0f", t }' "$2")"
  read -r b r f s <<< "$(awk -F'\t' '/^#/ || !NF { next }
    $1 == "base" { b++; next } $1 == "run" { r++; f = $2; next } { s += $NF }
    END { printf "%d %d %s %d\n", b, r, (f == "" ? "?" : f), s }' "$1")"
  [ "$b" = 1 ] && [ "$r" = 1 ] && { [ "$f" = "$s" ] || { [ "$f" = "-" ] && [ "$s" = 0 ]; }; } \
    || { echo "bad base rows: $b, run rows: $r, the run's failed: $f, the names' total: $s"; return 0; }
  _RT_M="$m" awk -F'\t' '/^#/ || !NF { next }
    $1 == "base" { base = $3; next } $1 == "run" { f = $2; p = $3; k = $4; next } { n++ }
    END {
      run = "[" f " " p " " k "]"; dash = (f == "-" && p == "-" && k == "-"); again = ": re-record with tests/run --record-assertions"
      if (base == "-" && !dash) print "bad the base is - beside a run row of " run ", and tests/red writes both rows - or both real" again
      else if (dash && base != "-") print "bad the run row is - beside a base of " (base == "" ? "(none)" : base) ", and tests/red writes both rows - or both real" again
      else if (dash && n) print "bad the base and run rows are -, yet " n " names are listed below them" again
      else if (dash) print "ok"
      else if (f !~ /^[0-9]+$/ || p !~ /^[0-9]+$/ || k !~ /^[0-9]+$/) print "bad the run row reads " run ", which is not three counts of zero or more" again
      else if (f + p + k < 1) print "bad the run row counts no assertion, a run tests/red refuses to record" again
      else if (ENVIRON["_RT_M"] != "" && f + p + k < ENVIRON["_RT_M"] + 0)
        print "bad the run row counts " f + p + k " assertions, fewer than the " ENVIRON["_RT_M"] " the manifest lists, and tests/red counts every one it lists, reached or red" again
      else print "ok"
    }' "$1"
}
# How _rtn1 and _rtn3 report a check's verdict line, written once so that it
# can be asked of lines written for it below: each wrote the mapping out, and
# turning its bad into skip or ok left the suite green (#371, third review).
# A line that is none of the three, empty or more than one included, fails,
# naming what it read, since a check that said nothing readable has not passed.
_rt_report() {   # <name> <verdict line>
  case "$2" in
    *$'\n'*)   bad  "$1" "the check's verdict is more than one line: [$2]" ;;
    ok)        ok   "$1" ;;
    "skip "?*) skip "$1" "${2#skip }" ;;
    "bad "?*)  bad  "$1" "${2#bad }" ;;
    *)         bad  "$1" "the check's verdict reads [$2], which is none of ok, skip <reason> or bad <detail>" ;;
  esac
}
_rtg() { git -C "$REAL_HARNESS" "$@" 2>/dev/null; }
_rtv() { sed -n '/"version"/{s/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p;q;}'; }
# Whether every base the record names is a commit in this repository. The
# record names its base by id, and a published snapshot carries the private
# repository's record into a history where that id was never a commit, so
# the base question cannot be asked there. Found by the first run of
# projects/felix/snapshot.sh, 2026-09-22: the public build failed on it. It
# asks the checkout named second, this suite's own when none is, so that the
# base check can be asked of a fixture (#371).
_rt_base_in() {   # <bases, space-separated> [<checkout>]
  local b; [ -n "$1" ] || return 1
  for b in $1; do git -C "${2:-$REAL_HARNESS}" cat-file -e "$b^{commit}" 2>/dev/null || return 1; done; return 0
}
# Both answers, on this repository's own history: an id that is no commit
# here, and its root, which is.
_rtroot="$(_rtg rev-list --max-parents=0 HEAD | head -1)"
# What kind of base the record names, one word of four. tests/red records a
# base of - when it made no red run, and - is no commit either, so the base
# check skipped a retraction as though it were a published snapshot and an
# engine change whose red run was never made passed (#371). Any other base is
# one commit id as tests/red writes it, forty lower-case hex digits: a commit
# here, or a snapshot's when it is not. Anything else is malformed, an empty
# base, more than one, and a value git resolves but tests/red never writes.
# A base edited by hand to origin/main read as a commit and, resolving afresh
# after every merge of main, never went stale; a branch or an abbreviated id
# is refused with it, since tests/red never writes those either (#371, third
# review). Asked on this repository's own history, as the two above are: its
# root is a commit here, forty zeros a full id that is not, and deadbeef an
# abbreviated one that is not. Like _rt_base_in, it asks the checkout named
# second, this suite's by default.
_rt_base_kind() {   # <the base field of every base row, space-separated> [<checkout>] -> one word
  case "$1" in
    -) echo retracted; return 0 ;;
    ''|*[!0123456789abcdef]*) echo malformed; return 0 ;;
  esac
  if [ "${#1}" -ne 40 ]; then echo malformed
  elif _rt_base_in "$1" "${2:-}"; then echo commit
  else echo snapshot; fi
}
_rtkn1="a red.tsv base of - reads as retracted, not as a published snapshot"
_rtkn2="and a base that is a commit here reads as a commit"
_rtkn3="and a full commit id that is no commit here reads as a snapshot"
_rtkn4="and an abbreviated id that is no commit here reads as malformed, not as a snapshot"
_rtkn5="and an empty base, as a record with no base row gives, reads as malformed"
_rtkn6="and two bases, even one a commit here, read as malformed"
# And four at the edges, so that loosening the rule fails here rather than
# letting a base written by hand pass for one tests/red wrote: two bases that
# are each a commit here are still two, and a snapshot's base is one commit
# id as git prints it, forty lower-case hex digits, which forty letters that
# are not hex, forty-one digits and forty upper-case ones are not. The six
# above left each of those loosenings green (#371, second review, 2026-09-25).
_rtkn7="and two bases that are each a commit here read as malformed, not as a commit"
_rtkn8="and forty characters that are not hex digits read as malformed, not as a snapshot"
_rtkn9="and forty-one hex digits read as malformed, not as a snapshot"
_rtkn10="and forty upper-case hex digits that are no commit here read as malformed, not as a snapshot"
# And a commit is one as tests/red writes a base, the forty lower-case hex
# digits git rev-parse prints, that is a commit here. Any value git resolved
# read as a commit, ref names included, so a base edited by hand to
# origin/main passed _rtn3 after every merge of main and never went stale
# (#371, third review); main and an abbreviated id are refused with it, since
# tests/red never writes those either. Asked with HEAD, since this suite's
# own checkout may have no origin/main, and with the root above cut to twelve
# characters and spelled in upper case.
_rtkn11="and HEAD, which git resolves to a commit here, reads as malformed, since tests/red writes a base as a full id"
_rtkn12="and the first twelve characters of a commit here read as malformed, not as a commit"
_rtkn13="and a commit here spelled in forty upper-case hex digits reads as malformed, not as a commit"
if [ -n "$_rtroot" ]; then
  _rt_base_in 0000000000000000000000000000000000000000 \
    && bad "a red.tsv base that is no commit here is told apart, so the base check skips in a published snapshot" "0000… read as a commit" \
    || ok  "a red.tsv base that is no commit here is told apart, so the base check skips in a published snapshot"
  _rt_base_in "$_rtroot" \
    && ok  "and a base that is a commit here is still compared, so a stale record still fails" \
    || bad "and a base that is a commit here is still compared, so a stale record still fails" "root $_rtroot not read as a commit"
  is "$_rtkn1" "$(_rt_base_kind -)" retracted
  is "$_rtkn2" "$(_rt_base_kind "$_rtroot")" commit
  is "$_rtkn3" "$(_rt_base_kind 0000000000000000000000000000000000000000)" snapshot
  is "$_rtkn4" "$(_rt_base_kind deadbeef)" malformed
  is "$_rtkn5" "$(_rt_base_kind "")" malformed
  is "$_rtkn6" "$(_rt_base_kind "$_rtroot -")" malformed
  is "$_rtkn7" "$(_rt_base_kind "$_rtroot $_rtroot")" malformed
  is "$_rtkn8" "$(_rt_base_kind gggggggggggggggggggggggggggggggggggggggg)" malformed
  is "$_rtkn9" "$(_rt_base_kind 00000000000000000000000000000000000000000)" malformed
  is "$_rtkn10" "$(_rt_base_kind AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA)" malformed
  is "$_rtkn11" "$(_rt_base_kind HEAD)" malformed
  is "$_rtkn12" "$(_rt_base_kind "${_rtroot:0:12}")" malformed
  is "$_rtkn13" "$(_rt_base_kind "$(printf '%s' "$_rtroot" | tr abcdef ABCDEF)")" malformed
else
  skip "a red.tsv base that is no commit here is told apart, so the base check skips in a published snapshot" "no git history beside this suite"
  skip "and a base that is a commit here is still compared, so a stale record still fails" "no git history beside this suite"
  for _n in "$_rtkn1" "$_rtkn2" "$_rtkn3" "$_rtkn4" "$_rtkn5" "$_rtkn6" "$_rtkn7" "$_rtkn8" "$_rtkn9" "$_rtkn10" \
            "$_rtkn11" "$_rtkn12" "$_rtkn13"; do
    skip "$_n" "no git history beside this suite"
  done
fi
# Whether the engine in this checkout is origin/main's, working tree
# included. The record and the version belong to the engine: a branch that
# changes only docs or a project's doctrine carries main's record and main's
# version, rightly, and asking it for a new one failed every such branch
# (found on 2026-09-22, the first docs-only pull request after these checks
# merged). A change under engine/, tests included, still owes both.
_rt_engine_same() { git -C "$1" diff --quiet refs/remotes/origin/main -- :/engine 2>/dev/null; }
# Both answers on a repository built here: a commit to docs keeps main's
# engine, a commit to engine/ does not.
_rtes="$TMP/rt-engine-same"; mkdir -p "$_rtes/engine" "$_rtes/docs"
( cd "$_rtes" && git init -q && git config user.email t@t && git config user.name t \
    && echo a > engine/x && echo a > docs/y && git add -A && git commit -qm base \
    && git update-ref refs/remotes/origin/main HEAD \
    && echo b > docs/y && git commit -qam docs ) >/dev/null 2>&1
_rt_engine_same "$_rtes" \
  && ok  "a branch that changes only docs keeps main's engine, so it owes no new red.tsv and no new version" \
  || bad "a branch that changes only docs keeps main's engine, so it owes no new red.tsv and no new version" "the docs-only fixture read as an engine change"
( cd "$_rtes" && echo b > engine/x && git commit -qam engine ) >/dev/null 2>&1
_rt_engine_same "$_rtes" \
  && bad "and a branch that changes engine/ still owes both" "the engine fixture read as main's engine" \
  || ok  "and a branch that changes engine/ still owes both"
# Whether red.tsv still describes the base this tree stands on. The record is
# this tree's assertions run against the engine at its base, so what it must
# match is that engine, not the commit around it. Until 2026-09-22 the check
# compared commits, and a merge to main that touched no engine file (#290,
# projects/felix/CLAUDE.md alone) staled every open engine pull request's
# record: each owed an eight-minute red run whose answer could not have
# changed, and one's CI failed on it (#291). Compared as engine/ trees, which
# hold the harness, this suite and plugin.json, a docs or projects merge
# leaves the record standing and any change under engine/ on main stales it.
_rt_engine_tree() { [ -n "$2" ] && git -C "$1" rev-parse -q --verify "$2:engine" 2>/dev/null; }
_rt_record_holds() {   # <checkout> <red.tsv's base sha>
  local mb t
  mb="$(git -C "$1" merge-base HEAD refs/remotes/origin/main 2>/dev/null)" || return 1
  t="$(_rt_engine_tree "$1" "$2")" || return 1
  [ "$t" = "$(_rt_engine_tree "$1" "$mb")" ]
}
# Both answers on a repository built here. The record is taken on main, main
# takes a docs commit, and the branch is rebased onto it; then main takes an
# engine commit and the branch is rebased again.
_rtrh="$TMP/rt-record-holds"; mkdir -p "$_rtrh/engine" "$_rtrh/docs"
( cd "$_rtrh" && git init -q && git config user.email t@t && git config user.name t \
    && echo a > engine/x && echo a > docs/y && git add -A && git commit -qm record \
    && echo b > docs/y && git commit -qam 'main: docs' \
    && git update-ref refs/remotes/origin/main HEAD \
    && echo b > engine/x && git commit -qam 'branch: engine' ) >/dev/null 2>&1
_rtrr="$(git -C "$_rtrh" rev-parse -q --verify 'HEAD~2' 2>/dev/null)"
_rtrn="a docs commit on main after red.tsv was recorded leaves the record standing, since the engine it ran against is the one the branch now stands on"
if [ -n "$_rtrr" ] && _rt_record_holds "$_rtrh" "$_rtrr"; then
  ok  "$_rtrn"
else
  bad "$_rtrn" "record ${_rtrr:-(none)}, merge-base $(git -C "$_rtrh" merge-base HEAD refs/remotes/origin/main 2>/dev/null)"
fi
( cd "$_rtrh" && git checkout -q --detach refs/remotes/origin/main \
    && echo c > engine/z && git add -A && git commit -qm 'main: engine' \
    && git update-ref refs/remotes/origin/main HEAD \
    && git checkout -q -b rebased && echo b > engine/x && git commit -qam 'branch: engine' ) >/dev/null 2>&1
# Fails for its own reason only when the fixture stands where it says: the
# branch's merge-base is main's engine commit, the record two commits back.
_rtrm="$(git -C "$_rtrh" merge-base HEAD refs/remotes/origin/main 2>/dev/null)"
_rtrn="and an engine commit on main after it stales the record"
if [ -n "$_rtrr" ] && [ "$(git -C "$_rtrh" log -1 --format=%s "$_rtrm" 2>/dev/null)" = "main: engine" ] \
   && ! _rt_record_holds "$_rtrh" "$_rtrr"; then
  ok  "$_rtrn"
else
  bad "$_rtrn" "record ${_rtrr:-(none)}, merge-base ${_rtrm:-(none)} ($(git -C "$_rtrh" log -1 --format=%s "$_rtrm" 2>/dev/null))"
fi
# The base question alone, asked of a checkout: ok, or skip and why, or bad
# and why, on one line. An engine change owes a red run, so a retraction
# (base -), which once skipped as a published snapshot and let an engine
# change whose red run was never made pass (#371), fails, as does a base
# that is not one full commit id; only a snapshot's full id still skips. The
# decision sat inside _rtn3, where no fixture reached it, so undoing it left
# this suite green (second review of #371); it is asked of fixtures below.
# Whether the question is owed at all is _rt_judge's. A published snapshot
# carrying a retraction fails too, rightly, since its engine's red run was
# never shown either, but it cannot re-record there, so the detail says where
# (#371, third review).
_rt_base_check() {   # <checkout> -> ok, skip <reason> or bad <detail>
  local bs mb
  bs="$(awk -F'\t' '$1 == "base" { printf "%s%s", s, $3; s = " " }' "$1/engine/harness/tests/red.tsv" 2>/dev/null)"
  case "$(_rt_base_kind "$bs" "$1")" in
    retracted)
      echo "bad red.tsv records that no red run was made (base -), and tests/red's stdout said why, if it finished: re-record with tests/run --record-assertions in the repository where the engine change was made" ;;
    malformed)
      echo "bad the record's base reads [$bs], which is neither - nor one commit id in forty lower-case hex digits, as tests/red writes it: re-record with tests/run --record-assertions" ;;
    snapshot)
      echo "skip its base is no commit in this repository's history, as in a published snapshot" ;;
    *)
      if _rt_record_holds "$1" "$bs"; then
        echo ok
      else
        mb="$(git -C "$1" merge-base HEAD refs/remotes/origin/main 2>/dev/null)"
        echo "bad the record's base ${bs:-(none)} holds engine $(_rt_engine_tree "$1" "$bs" || echo '(none)'), the merge-base ${mb:-(none)} holds $(_rt_engine_tree "$1" "$mb" || echo '(none)'): re-record with tests/run --record-assertions"
      fi ;;
  esac
}
# The whole judgment of a checkout's record: _rtn1 to _rtn4, each reported
# through ok, skip and bad, and whether each is asked, from the checkout's
# red.tsv, manifest, plugin.json and git. It reads them under
# <checkout>/engine, so it assumes the <root>/engine/harness layout, the one
# gate.sh, CI and snapshot.sh run this suite in. Made for this suite's own
# checkout alone, its report of _rtn3, then of _rtn1, could be a plain ok and
# leave every assertion green (#371, fourth review), so it is also asked of
# one below. Record mode, --record-assertions, in which the first three
# skip, is FELIX_TEST_RECORD at exactly 1, as the suite sets it, read here
# rather than passed in by the suite's one call, where no assertion asked it
# (#371, fifth review). And an engine change with no red.tsv at all, as a
# red.tsv merge conflict resolved by removing the file leaves, fails _rtn3,
# since it still owes a record: the missing file skipped _rtn1 to _rtn3, and
# such a change passed (#371, fifth review). Where no record is owed, a
# missing red.tsv skips _rtn3 as it skips the first two. A red run,
# FELIX_TEST_NO_MANIFEST at exactly 1 as tests/red sets it, stands in the
# base's tree and would judge the base's record, so all four skip there; it
# is read here too, since decided at the suite's one call, a test there that
# took an unset variable for a red run skipped all four on every run with
# every assertion green (#371, sixth review).
_rt_judge() {   # <checkout>
  local c="$1" t="$1/engine/harness/tests/red.tsv" a="$1/engine/harness/tests/assertions.tsv" r="" s="" w n vh vm
  if [ "${FELIX_TEST_NO_MANIFEST:-}" = 1 ]; then
    for n in "$_rtn1" "$_rtn2" "$_rtn3" "$_rtn4"; do skip "$n" "a red run reads the base's record"; done
    return 0
  fi
  [ "${FELIX_TEST_RECORD:-}" = 1 ] && r="--record-assertions rewrites red.tsv after this run"
  s="$r"; [ -z "$s" ] && [ ! -f "$t" ] && s="no red.tsv beside this suite"
  if [ -n "$s" ]; then
    for n in "$_rtn1" "$_rtn2"; do skip "$n" "$s"; done
  else
    _rt_report "$_rtn1" "$(_rt_record_whole "$t" "$a")"
    if [ -f "$a" ]; then
      n="$(awk -F'\t' 'NR == FNR { m[$2] = 1; next } /^#/ || !NF || $1 == "base" || $1 == "run" { next }
                       !($1 in m) { print $1 }' "$a" "$t")"
      [ -z "$n" ] && ok "$_rtn2" || bad "$_rtn2" "not in the manifest: $(printf '%s\n' "$n" | head -3)"
    else
      skip "$_rtn2" "no manifest beside this suite"
    fi
  fi
  if ! git -C "$c" rev-parse -q --verify refs/remotes/origin/main >/dev/null 2>&1; then
    w="no origin/main to compare against"
    skip "$_rtn3" "${s:-$w}"
    skip "$_rtn4" "$w"
  elif git -C "$c" merge-base --is-ancestor HEAD refs/remotes/origin/main 2>/dev/null; then
    w="this tree holds no commit origin/main lacks"
    skip "$_rtn3" "${s:-$w}"
    skip "$_rtn4" "$w"
  elif _rt_engine_same "$c"; then
    w="this tree changes no engine file, so origin/main's record is still this engine's"
    skip "$_rtn3" "${s:-$w}"
    skip "$_rtn4" "this tree changes no engine file, so it keeps origin/main's version"
  else
    if [ -n "$r" ]; then
      skip "$_rtn3" "$r"
    elif [ -n "$s" ]; then
      bad "$_rtn3" "no red.tsv, and this tree changes engine files: record one with tests/run --record-assertions"
    else
      _rt_report "$_rtn3" "$(_rt_base_check "$c")"
    fi
    vh="$(_rtv < "$c/engine/.claude-plugin/plugin.json" 2>/dev/null)"
    vm="$(git -C "$c" show refs/remotes/origin/main:engine/.claude-plugin/plugin.json 2>/dev/null | _rtv)"
    [ -n "$vh" ] && [ -n "$vm" ] && [ "$(awk -v a="$vh" -v b="$vm" 'BEGIN {
        n = split(a, A, "."); m = split(b, B, "."); k = (n > m) ? n : m; r = 0
        for (i = 1; i <= k && !r; i++) r = (A[i] + 0 > B[i] + 0) ? 1 : (A[i] + 0 < B[i] + 0) ? -1 : 0
        print (r > 0) ? "above" : "not" }')" = "above" ] \
      && ok  "$_rtn4" \
      || bad "$_rtn4" "this tree declares ${vh:-nothing}, origin/main declares ${vm:-nothing}"
  fi
}
# This suite's own checkout, judged once; in a red run _rt_judge skips all four.
_rt_judge "$REAL_HARNESS/../.."
# That call is the one line here no fixture reaches. An assignment before it,
# a subshell around it or a test in front of it left every assertion green
# while the four checks skipped or went uncounted (#371, seventh review), so
# this file must hold it as one line of its own, unindented, and name the
# suite's checkout to _rt_judge nowhere else.
_rtcall="_rt_judge \"\$REAL_HARNESS/../..\""
is "the suite judges its own checkout's record with one bare call at the top level, and nowhere else" \
   "$(_C="$_rtcall" awk '/^[[:space:]]*#/ { next } $0 == ENVIRON["_C"] { x++ } index($0, ENVIRON["_C"]) { y++ }
                          END { printf "%d exact, %d naming it", x, y }' "$HERE/run")" "1 exact, 1 naming it"
# Whether a helper printed one line whose first word is the verdict asked for
# and whose rest holds each phrase given.
_rt_said() {   # <name> <what the helper printed> <ok|skip|bad> [<phrase>...]
  local n="$1" o="$2" w="$3" r="" p; shift 3
  case "$o" in *' '*) r="${o#* }" ;; esac
  case "$o" in
    *$'\n'*) bad "$n" "more than one line: [$o]"; return 0 ;;
    "$w"|"$w "*) ;;
    *) bad "$n" "expected [$w ...] got [$o]"; return 0 ;;
  esac
  for p in "$@"; do case "$r" in *"$p"*) ;; *) bad "$n" "[$o] lacks [$p]"; return 0 ;; esac; done
  ok "$n"
}
# How _rtn1 and _rtn3 report a check's verdict line: _rt_report <name>
# <verdict> reports ok for ok, skip and the reason for skip <reason>, bad and
# the detail for bad <detail>, and bad, naming the line, for any line it
# cannot read. The mapping was written out in each, judged only against this
# repository's own red.tsv, so turning bad into skip or ok there, which
# reopens #371, left every assertion green (third review of #371). It is
# asked here with ok, skip and bad printing what they were asked to report, in
# a subshell, so that what is judged is the mapping alone and nothing counts.
_rt_reported() {   # <name> <verdict line> -> ok|<name>, skip|<name>|<reason> or bad|<name>|<detail>
  ( ok()   { printf 'ok|%s\n' "$1"; }
    skip() { printf 'skip|%s|%s\n' "$1" "${2-}"; }
    bad()  { printf 'bad|%s|%s\n' "$1" "${2-}"; }
    _rt_report "$1" "$2" )
}
_rtpn1="a check's verdict of ok is reported as a pass of the assertion it is reported for"
_rtpn2="and skip with a reason as a skip of it, giving the reason"
_rtpn3="and bad with a detail as a failure of it, giving the detail, not as a skip or a pass"
_rtpn4="and an empty verdict as a failure, with a detail, since a check that said nothing has not passed"
_rtpn5="and a verdict it cannot read, okay, as a failure whose detail names what it read"
is "$_rtpn1" "$(_rt_reported "a name" ok)" "ok|a name"
is "$_rtpn2" "$(_rt_reported "a name" "skip the reason, in words")" "skip|a name|the reason, in words"
is "$_rtpn3" "$(_rt_reported "a name" "bad the detail, in words")" "bad|a name|the detail, in words"
_rtpo="$(_rt_reported "a name" "")"
case "$_rtpo" in
  *$'\n'*)       bad "$_rtpn4" "more than one line: [$_rtpo]" ;;
  "bad|a name|"?*) ok  "$_rtpn4" ;;
  *)              bad "$_rtpn4" "expected [bad|a name|<a detail>] got [$_rtpo]" ;;
esac
_rtpo="$(_rt_reported "a name" okay)"
case "$_rtpo" in
  *$'\n'*)             bad "$_rtpn5" "more than one line: [$_rtpo]" ;;
  "bad|a name|"*okay*) ok  "$_rtpn5" ;;
  *)                   bad "$_rtpn5" "expected [bad|a name|<a detail naming okay>] got [$_rtpo]" ;;
esac
# And a verdict of more than one line is unreadable even when its first line
# reads as one: without the arm that says so, skip and the rest of the text
# passed for a skip (#371, fourth review). Reported once, as a failure; its
# detail holds the text it read, newline included, so the reports are counted
# as the lines that begin with a verdict.
_rtpn6="and a verdict of more than one line as one failure, even when its first line reads as a skip"
_rtpo="$(_rt_reported "a name" "$(printf 'skip a\nbad b')")"
case "$(printf '%s\n' "$_rtpo" | awk '/^(ok|skip|bad)[|]/ { n++ } END { print n + 0 }')/$_rtpo" in
  "1/bad|a name|"?*) ok  "$_rtpn6" ;;
  *)                 bad "$_rtpn6" "expected one report, [bad|a name|<a detail>], got [$_rtpo]" ;;
esac
# The base check, asked of a checkout rather than of this suite's own record.
# _rtn3 was judged only against this repository's red.tsv, which on any branch
# is one record, so no fixture reached the decision it makes on the kind of
# base: the second review of #371 undid that decision and every assertion in
# this suite stayed green (2026-09-25). _rt_base_check <checkout> answers the
# base question alone, on one line, ok, or skip and why, or bad and why,
# asking git about that checkout; whether the question is owed is _rt_judge's.
# Asked here of a repository built for it: a commit origin/main names, then a
# branch commit to engine/, with red.tsv rewritten beside that checkout's
# suite, uncommitted, for each kind of base.
_rtbc="$TMP/rt-base-check"; mkdir -p "$_rtbc/engine/harness/tests"
( cd "$_rtbc" && git init -q && git config user.email t@t && git config user.name t \
    && echo a > engine/x && git add -A && git commit -qm 'main: engine' \
    && git update-ref refs/remotes/origin/main HEAD \
    && echo b > engine/x && git commit -qam 'branch: engine' ) >/dev/null 2>&1
_rtbct="$_rtbc/engine/harness/tests/red.tsv"
_rtbcm="$(git -C "$_rtbc" rev-parse -q --verify refs/remotes/origin/main 2>/dev/null)"
_rtbch="$(git -C "$_rtbc" rev-parse -q --verify HEAD 2>/dev/null)"
_rtbn1="the base check, asked of a checkout whose red.tsv is the retraction, fails it, saying no red run was made (base -)"
_rtbn2="and of one whose base is a full commit id that is no commit there, it skips as a published snapshot"
_rtbn3="and of one whose base is its merge-base with origin/main, it passes, asking that checkout's history and not this suite's"
_rtbn4="and of one whose base is an abbreviated id that is no commit there, it fails, naming the value it read"
_rtbn5="and of one whose base is a commit there holding another engine than the merge-base, it fails, saying to re-record"
_rtbn6="and of one whose red.tsv has no base row, it fails"
_rtbn7="and its verdict on the retraction, reported as _rtn3 reports it, is that failure with that detail, not a skip or a pass"
# Each fails for its own reason only while the fixture stands where it says:
# the merge-base is origin/main's commit, and the branch commit's engine is
# not that commit's.
if [ -n "$_rtbcm" ] && [ -n "$_rtbch" ] \
   && [ "$(git -C "$_rtbc" merge-base HEAD refs/remotes/origin/main 2>/dev/null)" = "$_rtbcm" ] \
   && [ -n "$(_rt_engine_tree "$_rtbc" "$_rtbch")" ] \
   && [ "$(_rt_engine_tree "$_rtbc" "$_rtbcm")" != "$(_rt_engine_tree "$_rtbc" "$_rtbch")" ]; then
  printf '# a record\nbase\t-\t-\t-\nrun\t-\t-\t-\n' > "$_rtbct"
  _rt_said "$_rtbn1" "$(_rt_base_check "$_rtbc")" bad "no red run was made (base -)"
  _rtpv="$(_rt_base_check "$_rtbc")"
  case "$_rtpv" in
    "bad "*"no red run was made (base -)"*) is "$_rtbn7" "$(_rt_reported "a name" "$_rtpv")" "bad|a name|${_rtpv#bad }" ;;
    *) bad "$_rtbn7" "the base check said [$_rtpv]" ;;
  esac
  printf '# a record\nbase\torigin/main\t%s\t0.0.1\nrun\t0\t1\t0\n' 0000000000000000000000000000000000000000 > "$_rtbct"
  _rt_said "$_rtbn2" "$(_rt_base_check "$_rtbc")" skip "published snapshot"
  printf '# a record\nbase\torigin/main\t%s\t0.0.1\nrun\t0\t1\t0\n' "$_rtbcm" > "$_rtbct"
  is "$_rtbn3" "$(_rt_base_check "$_rtbc")" ok
  printf '# a record\nbase\torigin/main\t%s\t0.0.1\nrun\t0\t1\t0\n' deadbeef > "$_rtbct"
  _rt_said "$_rtbn4" "$(_rt_base_check "$_rtbc")" bad "[deadbeef]"
  printf '# a record\nbase\torigin/main\t%s\t0.0.1\nrun\t0\t1\t0\n' "$_rtbch" > "$_rtbct"
  _rt_said "$_rtbn5" "$(_rt_base_check "$_rtbc")" bad "$_rtbch holds engine" "re-record"
  printf '# a record\nrun\t0\t1\t0\n' > "$_rtbct"
  _rt_said "$_rtbn6" "$(_rt_base_check "$_rtbc")" bad
else
  for _n in "$_rtbn1" "$_rtbn2" "$_rtbn3" "$_rtbn4" "$_rtbn5" "$_rtbn6" "$_rtbn7"; do
    bad "$_n" "the fixture does not stand where it says: origin/main ${_rtbcm:-(none)}, HEAD ${_rtbch:-(none)}"
  done
fi
# Whether red.tsv is one whole record, asked of records written here.
# tests/red writes both rows - when it made no red run and both real when it
# made one, and it refuses a run that reached no assertion, so a run row of -
# beside a real base, a base of - beside a real run row, and a run row that
# counts nothing are none of its records. _rtn1 accepted all three when the
# second review of #371 read it (2026-09-25), and the first is what pasting a
# sha into a retraction's base row gives, the hand answer to _rtn3's failure
# of a retraction. _rt_record_whole <red.tsv> says ok, or bad and why, and
# the detail for a count of rows or of names that does not add up is _rtn1's.
_rtw="$TMP/rt-record-whole"; mkdir -p "$_rtw"
_rtwb="$(printf 'base\torigin/main\t%s\t0.0.1' 0123456789abcdef0123456789abcdef01234567)"
printf '# a record\nbase\t-\t-\t-\nrun\t-\t-\t-\n' > "$_rtw/dash"
printf '# a record\n%s\nrun\t1\t2\t0\nthe one that failed\t1\n' "$_rtwb" > "$_rtw/real"
printf '# a record\n%s\nrun\t-\t-\t-\n' "$_rtwb" > "$_rtw/pasted"
printf '# a record\nbase\t-\t-\t-\nrun\t1\t2\t0\nthe one that failed\t1\n' > "$_rtw/unbased"
printf '# a record\n%s\nrun\t0\t0\t0\n' "$_rtwb" > "$_rtw/empty"
printf '# a record\n%s\nrun\t2\t1\t0\nthe one that failed\t1\n' "$_rtwb" > "$_rtw/short"
printf '# a record\n%s\n%s\nrun\t1\t2\t0\nthe one that failed\t1\n' "$_rtwb" "$_rtwb" > "$_rtw/twice"
printf '# a record\n%s\nrun\t1\ttwo\t0\nthe one that failed\t1\n' "$_rtwb" > "$_rtw/word"
printf '# a record\n%s\nrun\t1\t-2\t2\nthe one that failed\t1\n' "$_rtwb" > "$_rtw/negative"
# And five more, each the record a rule loosened by one step would take or
# refuse wrongly: the third review of #371 named five rules here that no
# fixture held, one run row, a failed count that is a number, a skipped count
# that is a number, a run row of - only when all three of its counts are, and
# at least one assertion counted across the three, not the failed count alone.
# A run that failed none is a clean record, which tests/red's header allows.
printf '# a record\n%s\nrun\t0\t3\t0\n' "$_rtwb" > "$_rtw/clean"
printf '# a record\n%s\nrun\t-\t3\t0\n' "$_rtwb" > "$_rtw/unfailed"
printf '# a record\n%s\nrun\t1\t2\tx\nthe one that failed\t1\n' "$_rtwb" > "$_rtw/unskipped"
printf '# a record\nbase\t-\t-\t-\nrun\t-\t3\t0\n' > "$_rtw/halfdash"
printf '# a record\n%s\nrun\t1\t2\t0\nrun\t1\t3\t0\nthe one that failed\t1\n' "$_rtwb" > "$_rtw/rerun"
# And six the fourth review of #371 found no fixture held: a sha pasted into
# the retraction's sha column alone, which reading the dash from the ref or
# the version column passes; names added by their counts, not counted as
# lines; a run that skipped all it reached and one that failed all it
# reached, each a record, so the assertion a run must count is summed
# across all three counts; a run row missing its skipped count, which an
# empty field read as a count passes; and names that add up to more than the
# failed count, which a total read as at least the count, not equal to it,
# passes.
printf '# a record\nbase\t-\t%s\t-\nrun\t-\t-\t-\n' 0123456789abcdef0123456789abcdef01234567 > "$_rtw/shaonly"
printf '# a record\n%s\nrun\t2\t1\t0\nthe one that failed\t2\n' "$_rtwb" > "$_rtw/failedtwice"
printf '# a record\n%s\nrun\t0\t0\t3\n' "$_rtwb" > "$_rtw/allskipped"
printf '# a record\n%s\nrun\t1\t0\t0\nthe one that failed\t1\n' "$_rtwb" > "$_rtw/allfailed"
printf '# a record\n%s\nrun\t1\t2\nthe one that failed\t1\n' "$_rtwb" > "$_rtw/twocounts"
printf '# a record\n%s\nrun\t1\t2\t0\nthe one that failed\t1\nanother that failed\t1\n' "$_rtwb" > "$_rtw/overcounted"
# And a run counted against the manifest beside it. tests/red counts every
# name the manifest lists, reached or red by its shortfall, so a real run row
# it writes counts at least the manifest's total; one that counts fewer is a
# suite cut short and written down as finished, 0 of 270 against some 3,700,
# which the rows alone cannot tell from a short suite (#371's follow-up).
# Names over-reached or not listed are not compared, so more is a record.
printf '1\tthe one that failed\n2\tanother that passed\n' > "$_rtw/manifest3"
printf '# a record\n%s\nrun\t0\t2\t0\n' "$_rtwb" > "$_rtw/underrun"
printf '# a record\n%s\nrun\t0\t5\t0\n' "$_rtwb" > "$_rtw/overrun"
_rtwn1="a red.tsv whose base and run rows are both -, with no names below, is one whole record"
_rtwn2="and so is a real base beside a run that failed one, passed two and names the one"
_rtwn3="but a real base beside a run row of - is not, which is what pasting a sha into a retraction's base row gives"
_rtwn4="nor is a base of - beside a real run row and the name it counts"
_rtwn5="nor a real run row that counts no assertion at all, since tests/red refuses such a run"
_rtwn6="nor a run whose failed count the names below do not add up to, said as _rtn1 always said it"
_rtwn7="nor two base rows, said as _rtn1 always said it"
_rtwn8="nor a real run row with a count that is not a number"
_rtwn9="nor a real run row with a negative count, though its counts sum to one"
_rtwn10="and so is a real base beside a run that failed none and passed three, with no names below, since zero red is an answer"
_rtwn11="nor a real base beside a run row whose failed count alone is -"
_rtwn12="nor a real run row whose skipped count is not a number, though its failed count and the names agree"
_rtwn13="nor a base of - beside a run row whose failed count alone is -"
_rtwn14="nor one base row beside two run rows, said as _rtn1 always said it"
_rtwn15="nor a retraction whose base row has a sha pasted into its sha column alone, its ref and version columns left -"
_rtwn16="and so is a real base beside a run that failed two, naming one that failed twice, since names add up by their counts"
_rtwn17="and so is a real base beside a run that skipped all three it reached, with no names below"
_rtwn18="and so is a real base beside a run that failed the one it reached, naming it"
_rtwn19="nor a real run row with no skipped count at all, though its failed count and the names agree"
_rtwn20="nor a run that failed one whose names below add up to two, said as _rtn1 always said it"
_rtwn21="nor a real run that counts fewer assertions than the manifest beside it lists, as a suite cut short was once written down as finished"
_rtwn22="and so is a real run that counts as many as the manifest beside it lists"
_rtwn23="and so is a real run that counts more than the manifest beside it lists, since names over-reached or not listed are not compared"
_rtwn24="and so is the retraction beside a manifest, since it counts no run to compare"
_rtwn25="and a real run is not compared with a manifest that is not there"
is "$_rtwn1" "$(_rt_record_whole "$_rtw/dash")" ok
is "$_rtwn2" "$(_rt_record_whole "$_rtw/real")" ok
is "$_rtwn10" "$(_rt_record_whole "$_rtw/clean")" ok
_rt_said "$_rtwn3" "$(_rt_record_whole "$_rtw/pasted")" bad
_rt_said "$_rtwn4" "$(_rt_record_whole "$_rtw/unbased")" bad
_rt_said "$_rtwn5" "$(_rt_record_whole "$_rtw/empty")" bad
_rt_said "$_rtwn6" "$(_rt_record_whole "$_rtw/short")" bad "the run's failed: 2, the names' total: 1"
_rt_said "$_rtwn7" "$(_rt_record_whole "$_rtw/twice")" bad "base rows: 2"
_rt_said "$_rtwn8" "$(_rt_record_whole "$_rtw/word")" bad
_rt_said "$_rtwn9" "$(_rt_record_whole "$_rtw/negative")" bad
_rt_said "$_rtwn11" "$(_rt_record_whole "$_rtw/unfailed")" bad
_rt_said "$_rtwn12" "$(_rt_record_whole "$_rtw/unskipped")" bad
_rt_said "$_rtwn13" "$(_rt_record_whole "$_rtw/halfdash")" bad
_rt_said "$_rtwn14" "$(_rt_record_whole "$_rtw/rerun")" bad "run rows: 2"
_rt_said "$_rtwn15" "$(_rt_record_whole "$_rtw/shaonly")" bad
is "$_rtwn16" "$(_rt_record_whole "$_rtw/failedtwice")" ok
is "$_rtwn17" "$(_rt_record_whole "$_rtw/allskipped")" ok
is "$_rtwn18" "$(_rt_record_whole "$_rtw/allfailed")" ok
_rt_said "$_rtwn19" "$(_rt_record_whole "$_rtw/twocounts")" bad
_rt_said "$_rtwn20" "$(_rt_record_whole "$_rtw/overcounted")" bad "the run's failed: 1, the names' total: 2"
_rt_said "$_rtwn21" "$(_rt_record_whole "$_rtw/underrun" "$_rtw/manifest3")" bad "counts 2 assertions, fewer than the 3 the manifest lists"
is "$_rtwn22" "$(_rt_record_whole "$_rtw/real" "$_rtw/manifest3")" ok
is "$_rtwn23" "$(_rt_record_whole "$_rtw/overrun" "$_rtw/manifest3")" ok
is "$_rtwn24" "$(_rt_record_whole "$_rtw/dash" "$_rtw/manifest3")" ok
is "$_rtwn25" "$(_rt_record_whole "$_rtw/underrun" "$_rtw/no-such-manifest")" ok
# The whole judgment of a checkout's record, asked of a checkout built here.
# _rtn1 to _rtn4 were reported for this suite's own checkout alone, so the
# fourth review of #371 replaced the report of _rtn3, then of _rtn1, with a
# plain ok, and every assertion stayed green while a retraction, and a sha
# pasted beside a run row of -, passed. _rt_judge <checkout> makes that
# judgment of the checkout named, reading its red.tsv, its manifest, its
# plugin.json and its git, and reports the four names through ok, skip and
# bad as this block always did. Record mode, --record-assertions, is
# FELIX_TEST_RECORD at exactly 1, as the suite sets it, and _rt_judge reads
# it itself: decided at the suite's one call, it was asked by no assertion,
# and a test at that call that took the suite's normal 0 for record mode,
# ${FELIX_TEST_RECORD:+record} among them, skipped _rtn1 to _rtn3 on every
# run with every assertion green (#371, fifth review). A red run,
# FELIX_TEST_NO_MANIFEST at exactly 1 as tests/red sets it, is read there
# too, for the same reason: decided at that call, a test there that took an
# unset variable for a red run skipped all four on every run, again with
# every assertion green (#371, sixth review). Its reports are
# captured as _rt_reported captures _rt_report's, one line each, in a
# subshell, so that nothing counts, with FELIX_TEST_RECORD set there for
# each case: 0, as a normal run sets it, for every case but record mode's,
# 1 for that one, and unset for one more. FELIX_TEST_NO_MANIFEST is unset
# there for every case but two, since this block runs in red runs too,
# where tests/red has exported it as 1: at 1 for the red run's case, and at
# 0 for one more. The checkout: origin/main holds
# engine 1.0.0, a manifest listing one name and the retraction; a branch
# commit changes a file under engine/ and one under docs/ and declares
# 1.0.1, and red.tsv and plugin.json are rewritten beside it, uncommitted,
# for each record, red.tsv removed for one. Then a second branch commit
# puts engine/ back as origin/main holds it and keeps the docs change.
_rt_judged() {   # <checkout> <FELIX_TEST_RECORD: 0, 1 or unset> [<FELIX_TEST_NO_MANIFEST: 0, 1 or unset, the default>] -> ok|<name>, skip|<name>|<reason> or bad|<name>|<detail>, a line each
  ( if [ "$2" = unset ]; then unset FELIX_TEST_RECORD; else FELIX_TEST_RECORD="$2"; fi
    if [ "${3:-unset}" = unset ]; then unset FELIX_TEST_NO_MANIFEST; else FELIX_TEST_NO_MANIFEST="$3"; fi
    ok()   { printf 'ok|%s\n' "$1"; }
    skip() { printf 'skip|%s|%s\n' "$1" "${2-}"; }
    bad()  { printf 'bad|%s|%s\n' "$1" "${2-}"; }
    _rt_judge "$1" )
}
# Whether those reports hold one line for a name, its verdict the one asked
# for and its reason or detail, the text after the name, holding each phrase
# given: nothing when they do, and what is wrong when they do not. The
# phrases are looked for in that text alone, as _rt_said looks in the rest of
# a line after its verdict, so that a phrase the name holds is not found there.
_rt_judged_one() {   # <reports> <name> <ok|skip|bad> [<phrase>...] -> nothing, or what is wrong
  local o n="$2" w="$3" d="" p
  o="$(printf '%s\n' "$1" | N="$2" awk -F'[|]' '$2 == ENVIRON["N"]')"; shift 3
  case "$o" in
    "")                echo "no report for [$n]"; return 0 ;;
    *$'\n'*)           echo "more than one report for [$n]: [$o]"; return 0 ;;
    "$w|$n")           ;;
    "$w|$n|"*)         d="${o#"$w|$n|"}" ;;
    *)                 echo "[$n] reported [$o], not $w"; return 0 ;;
  esac
  for p in "$@"; do case "$d" in *"$p"*) ;; *) echo "[$o] lacks [$p]"; return 0 ;; esac; done
}
_rtj="$TMP/rt-judge"; mkdir -p "$_rtj/engine/.claude-plugin" "$_rtj/engine/harness/tests" "$_rtj/engine/harness/lib" "$_rtj/docs"
_rtjt="$_rtj/engine/harness/tests/red.tsv"; _rtjp="$_rtj/engine/.claude-plugin/plugin.json"
_rtja="the one assertion the judged checkout's manifest lists"
_rtju="an assertion the judged checkout's manifest does not list"
_rtjd="$(printf '# a record\nbase\t-\t-\t-\nrun\t-\t-\t-')"
( cd "$_rtj" && git init -q && git config user.email t@t && git config user.name t \
    && printf '{\n  "version": "1.0.0"\n}\n' > "$_rtjp" && echo a > engine/harness/lib/x.sh && echo a > docs/y \
    && printf '1\t%s\n' "$_rtja" > engine/harness/tests/assertions.tsv && printf '%s\n' "$_rtjd" > "$_rtjt" \
    && git add -A && git commit -qm 'main: engine 1.0.0' \
    && git update-ref refs/remotes/origin/main HEAD \
    && printf '{\n  "version": "1.0.1"\n}\n' > "$_rtjp" && echo b > engine/harness/lib/x.sh && echo b > docs/y \
    && git commit -qam 'branch: engine 1.0.1, and docs' ) >/dev/null 2>&1
_rtjm="$(git -C "$_rtj" rev-parse -q --verify refs/remotes/origin/main 2>/dev/null)"
_rtjr="$(printf '# a record\nbase\torigin/main\t%s\t1.0.0\nrun\t1\t1\t0\n%s\t1' "$_rtjm" "$_rtja")"
_rtjq="$(printf '# a record\nbase\torigin/main\t%s\t1.0.0\nrun\t-\t-\t-' "$_rtjm")"
_rtjn1="the record judgment of a checkout whose engine change carries a real record against origin/main reports all four record checks passed, and nothing else"
_rtjn2="and of one carrying the retraction, it fails the base check, saying no red run was made (base -), though the record reads whole"
_rtjn3="and of one whose retraction has origin/main's sha pasted into its base row, it fails the whole-record check, though the base check passes"
_rtjn4="and in record mode it skips the whole-record, manifest and base checks, saying --record-assertions rewrites red.tsv, and still asks the version"
_rtjn5="and of one whose engine change declares origin/main's version, it fails the version check"
_rtjn6="and of a branch that puts its engine change back but keeps a docs change, it skips the base and version checks, though its record is the retraction"
_rtjn7="and with FELIX_TEST_RECORD unset it judges the real record as a normal run does, all four passed, since record mode is that variable at exactly 1"
_rtjn8="and of one whose engine change has no red.tsv beside it, as a conflict resolved by removing the file leaves, it fails the base check, saying there is no red.tsv, where the whole-record and manifest checks skip"
_rtjn9="and of one whose real record names as failed an assertion its manifest does not list, it fails the manifest check, naming that assertion"
_rtjn10="and in a red run it skips all four record checks, saying a red run reads the base's record, though the record is real"
_rtjn11="and with FELIX_TEST_NO_MANIFEST at 0, and again at true, it judges the real record as a normal run does, all four passed each time, since a red run is that variable at exactly 1"
_rtjn12="and with FELIX_TEST_NO_MANIFEST at 1 around it but unset for the judgment, as these cases unset it inside a red run, it judges the real record as a normal run does, all four passed"
_rtjn13="and of one whose real record counts fewer assertions than its manifest lists, it fails the whole-record check, naming both totals, though the base check passes"
_rtjn14="and it reports the same four names in a normal run, in record mode and in a red run"
# Each fails for its own reason only while the checkout stands where it
# says: the branch commit's merge-base is origin/main's commit.
if [ -n "$_rtjm" ] && [ "$(git -C "$_rtj" merge-base HEAD refs/remotes/origin/main 2>/dev/null)" = "$_rtjm" ] \
   && [ "$(git -C "$_rtj" log -1 --format=%s HEAD 2>/dev/null)" = "branch: engine 1.0.1, and docs" ]; then
  printf '%s\n' "$_rtjr" > "$_rtjt"
  is "$_rtjn1" "$(_rt_judged "$_rtj" 0 | LC_ALL=C sort)" "$(printf 'ok|%s\n' "$_rtn1" "$_rtn2" "$_rtn3" "$_rtn4" | LC_ALL=C sort)"
  printf '%s\n' "$_rtjd" > "$_rtjt"
  _rtjo="$(_rt_judged "$_rtj" 0)"
  _rtjw="$(_rt_judged_one "$_rtjo" "$_rtn3" bad "no red run was made (base -)"; _rt_judged_one "$_rtjo" "$_rtn1" ok)"
  [ -z "$_rtjw" ] && ok "$_rtjn2" || bad "$_rtjn2" "$_rtjw"
  printf '%s\n' "$_rtjq" > "$_rtjt"
  _rtjo="$(_rt_judged "$_rtj" 0)"
  _rtjw="$(_rt_judged_one "$_rtjo" "$_rtn1" bad; _rt_judged_one "$_rtjo" "$_rtn3" ok)"
  [ -z "$_rtjw" ] && ok "$_rtjn3" || bad "$_rtjn3" "$_rtjw"
  printf '%s\n' "$_rtjr" > "$_rtjt"
  _rtjo="$(_rt_judged "$_rtj" 1)"
  _rtjw="$(for _n in "$_rtn1" "$_rtn2" "$_rtn3"; do
             _rt_judged_one "$_rtjo" "$_n" skip "--record-assertions rewrites red.tsv after this run"
           done
           _rt_judged_one "$_rtjo" "$_rtn4" ok)"
  [ -z "$_rtjw" ] && ok "$_rtjn4" || bad "$_rtjn4" "$_rtjw"
  is "$_rtjn7" "$(_rt_judged "$_rtj" unset | LC_ALL=C sort)" "$(printf 'ok|%s\n' "$_rtn1" "$_rtn2" "$_rtn3" "$_rtn4" | LC_ALL=C sort)"
  _rtjo="$(_rt_judged "$_rtj" 0 1)"
  _rtjw="$(for _n in "$_rtn1" "$_rtn2" "$_rtn3" "$_rtn4"; do
             _rt_judged_one "$_rtjo" "$_n" skip "a red run reads the base's record"
           done)"
  [ -z "$_rtjw" ] && ok "$_rtjn10" || bad "$_rtjn10" "$_rtjw"
  is "$_rtjn11" "$(_rt_judged "$_rtj" 0 0 | LC_ALL=C sort; _rt_judged "$_rtj" 0 true | LC_ALL=C sort)" \
     "$(printf 'ok|%s\n' "$_rtn1" "$_rtn2" "$_rtn3" "$_rtn4" | LC_ALL=C sort; printf 'ok|%s\n' "$_rtn1" "$_rtn2" "$_rtn3" "$_rtn4" | LC_ALL=C sort)"
  is "$_rtjn12" "$(FELIX_TEST_NO_MANIFEST=1; _rt_judged "$_rtj" 0 unset | LC_ALL=C sort)" "$(printf 'ok|%s\n' "$_rtn1" "$_rtn2" "$_rtn3" "$_rtn4" | LC_ALL=C sort)"
  printf '%s\n' "$_rtjr" > "$_rtjt"; printf '{\n  "version": "1.0.0"\n}\n' > "$_rtjp"
  _rtjo="$(_rt_judged "$_rtj" 0)"
  _rtjw="$(_rt_judged_one "$_rtjo" "$_rtn4" bad)"
  [ -z "$_rtjw" ] && ok "$_rtjn5" || bad "$_rtjn5" "$_rtjw"
  # And two records no case above reached, each beside the branch's 1.0.1.
  # None at all, as a red.tsv merge conflict resolved by removing the file
  # leaves: an engine change still owes one, and its absence skipped _rtn1
  # to _rtn3, so that change passed (#371, fifth review). And a real record
  # whose failed name the manifest does not list, the one record here that
  # fails _rtn2, whose report could be a plain ok with every case above
  # still passing.
  printf '{\n  "version": "1.0.1"\n}\n' > "$_rtjp"; rm -f "$_rtjt"
  _rtjo="$(_rt_judged "$_rtj" 0)"
  _rtjw="$(_rt_judged_one "$_rtjo" "$_rtn3" bad "no red.tsv"
           for _n in "$_rtn1" "$_rtn2"; do _rt_judged_one "$_rtjo" "$_n" skip "no red.tsv beside this suite"; done)"
  [ -z "$_rtjw" ] && ok "$_rtjn8" || bad "$_rtjn8" "$_rtjw"
  printf '# a record\nbase\torigin/main\t%s\t1.0.0\nrun\t1\t1\t0\n%s\t1\n' "$_rtjm" "$_rtju" > "$_rtjt"
  _rtjo="$(_rt_judged "$_rtj" 0)"
  _rtjw="$(_rt_judged_one "$_rtjo" "$_rtn2" bad "not in the manifest" "$_rtju"; _rt_judged_one "$_rtjo" "$_rtn1" ok)"
  [ -z "$_rtjw" ] && ok "$_rtjn9" || bad "$_rtjn9" "$_rtjw"
  # And the real record beside a manifest that lists its one name five times,
  # more than the run's two: the whole-record check reads the manifest only
  # through _rt_judge's call, which could leave it out with every fixture of
  # the check itself still passing. The manifest is put back after.
  printf '%s\n' "$_rtjr" > "$_rtjt"; printf '5\t%s\n' "$_rtja" > "$_rtj/engine/harness/tests/assertions.tsv"
  _rtjo="$(_rt_judged "$_rtj" 0)"
  printf '1\t%s\n' "$_rtja" > "$_rtj/engine/harness/tests/assertions.tsv"
  _rtjw="$(_rt_judged_one "$_rtjo" "$_rtn1" bad "counts 2 assertions, fewer than the 5 the manifest lists"; _rt_judged_one "$_rtjo" "$_rtn3" ok)"
  [ -z "$_rtjw" ] && ok "$_rtjn13" || bad "$_rtjn13" "$_rtjw"
  # And the names it reports are the same four whatever the mode, so a red
  # run, whose every unreached name tests/red records as red, reaches each
  # name a normal run and a --record-assertions run reach.
  _rtjo="$(for _m in "0 unset" "1 unset" "0 1"; do
             set -- $_m; _rt_judged "$_rtj" "$1" "$2" | cut -d'|' -f2 | LC_ALL=C sort | paste -sd'|' -
           done)"
  is "$_rtjn14" "$_rtjo" "$(_l="$(printf '%s\n' "$_rtn1" "$_rtn2" "$_rtn3" "$_rtn4" | LC_ALL=C sort | paste -sd'|' -)"; printf '%s\n%s\n%s' "$_l" "$_l" "$_l")"
  ( cd "$_rtj" && printf '{\n  "version": "1.0.0"\n}\n' > "$_rtjp" && echo a > engine/harness/lib/x.sh \
      && printf '%s\n' "$_rtjd" > "$_rtjt" && git commit -qam 'branch: engine put back, docs kept' ) >/dev/null 2>&1
  # And this one only while engine/ is origin/main's again and docs/ is not.
  if [ "$(git -C "$_rtj" log -1 --format=%s HEAD 2>/dev/null)" = "branch: engine put back, docs kept" ] \
     && git -C "$_rtj" diff --quiet refs/remotes/origin/main -- engine 2>/dev/null \
     && ! git -C "$_rtj" diff --quiet refs/remotes/origin/main -- docs 2>/dev/null; then
    _rtjo="$(_rt_judged "$_rtj" 0)"
    _rtjw="$(_rt_judged_one "$_rtjo" "$_rtn3" skip "changes no engine file"; _rt_judged_one "$_rtjo" "$_rtn4" skip "changes no engine file")"
    [ -z "$_rtjw" ] && ok "$_rtjn6" || bad "$_rtjn6" "$_rtjw"
  else
    bad "$_rtjn6" "the fixture does not stand where it says: HEAD $(git -C "$_rtj" log -1 --format='%h %s' HEAD 2>/dev/null), with engine/ origin/main's and docs/ not"
  fi
else
  for _n in "$_rtjn1" "$_rtjn2" "$_rtjn3" "$_rtjn4" "$_rtjn5" "$_rtjn6" "$_rtjn7" "$_rtjn8" "$_rtjn9" "$_rtjn10" "$_rtjn11" "$_rtjn12" "$_rtjn13" "$_rtjn14"; do
    bad "$_n" "the fixture does not stand where it says: origin/main ${_rtjm:-(none)}, HEAD $(git -C "$_rtj" log -1 --format='%h %s' HEAD 2>/dev/null)"
  done
fi

# The suite's completion marker: tests/red counts a red run only when a line
# that is exactly "reached" follows its last assertion line, since a finished
# red run exits 1 as a dead one can (#371). The empty line before it is this
# suite's own, and the red block's marker assertion pins this printf. Changing
# it means changing tests/red.
printf '\nreached\n'
# What ran, against what is supposed to run. #67.
#
# The comparison is one-directional on purpose. An assertion in the manifest
# that did NOT run is the defect — it is the silent kind, indistinguishable from
# a passing suite. An assertion that ran and is not in the manifest is somebody
# adding a test and forgetting to record it, which is noise rather than risk, so
# it is reported and does not fail the run.
#
# Counted per name, not set-compared: some names legitimately appear more than
# once (nineteen on 2026-10-01), and losing one of a pair is exactly as silent
# as losing a unique one.
_ran_counts="$TMP/ran.counts"
_ran_rows < "$FELIX_TEST_RAN" > "$_ran_counts"

if [ "$FELIX_TEST_RECORD" -eq 1 ]; then
  cp "$_ran_counts" "$FELIX_TEST_MANIFEST"
  printf '  recorded %s assertions to %s\n' \
    "$(awk -F'\t' '{s+=$1} END {print s+0}' "$_ran_counts")" "$FELIX_TEST_MANIFEST"
  # And the red run, so the manifest and the count it was shown red with are
  # written by one command and travel in one diff. Its exit status is its own:
  # a red run that could not be made is said in red.tsv and does not turn a
  # green suite red.
  if [ -x "$HERE/red" ]; then
    "$HERE/red" 2>&1 | sed 's/^/  /'
  else
    printf '  no tests/red beside this suite: red.tsv not written\n'
  fi
elif [ "${FELIX_TEST_NO_MANIFEST:-0}" = "1" ]; then
  # The red run: this suite is executing inside the base's tree, whose
  # manifest describes the base's assertions. Comparing against it would
  # report every assertion this tree added as one the base never reached,
  # through bad(), and that would be counted as red. Nothing is compared, and
  # the line says so rather than reading as a manifest that matched.
  printf '  manifest comparison off (FELIX_TEST_NO_MANIFEST): this is a red run\n'
elif [ -f "$FELIX_TEST_MANIFEST" ]; then
  # Emitted through bad(), so these are `  FAIL` lines. That matters: the gate
  # prints only the last line of a passing suite, and greps for `^  FAIL` when
  # it fails — so this is the one channel that reaches a CI log without the
  # workflow having to change, and .github/workflows is an escape channel no
  # project can demote.
  _missing=0
  while IFS=$'\t' read -r want name; do
    [ -n "${name:-}" ] || continue
    # ENVIRON, not -v: awk -v processes backslash escapes, so a name holding a
    # backslash could never equal itself and would read as never reached.
    got="$(N="$name" awk -F'\t' '$2==ENVIRON["N"] {print $1}' "$_ran_counts")"
    got="${got:-0}"
    if [ "$got" -lt "$want" ]; then
      bad "assertion did not run: $name" "expected it $want time(s), reached it $got"
      _missing=$((_missing+1))
    fi
  done < "$FELIX_TEST_MANIFEST"
  _extra="$(LC_ALL=C comm -13 <(cut -f2 "$FELIX_TEST_MANIFEST" | LC_ALL=C sort -u) \
                              <(cut -f2 "$_ran_counts"        | LC_ALL=C sort -u) | wc -l | tr -d ' ')"
  [ "$_missing" -eq 0 ] \
    && printf '  ok    every assertion in the manifest was reached\n' \
    || printf '  %s assertion(s) in the manifest never ran. Not a failure of the code\n  they name: the suite never got to them on this machine.\n' "$_missing"
  [ "${_extra:-0}" -eq 0 ] || \
    printf '  note  %s assertion(s) ran that the manifest does not list.\n        Re-record with: tests/run --record-assertions\n' "$_extra"
else
  printf '  no manifest yet. Record one with: tests/run --record-assertions\n'
fi

printf '\n%d passed, %d failed' "$PASS" "$FAIL"
[ "$SKIP" -gt 0 ] && printf ', %d skipped' "$SKIP"
printf '\n'
[ "$FAIL" -eq 0 ] || exit 1

printf '\ngenerated CI points at a path that exists\n'
# Moving the engine broke every generated workflow at once, in other
# repositories, where this suite never looks. Felix's own gate stayed green
# because it tests Felix. The caller lived elsewhere.
#
# So the generator's output is checked against the filesystem: whatever path it
# tells CI to run must actually resolve inside the engine.
gen="$( . "$FROOT/engine/harness/lib/detect.sh" 2>/dev/null || . "$FROOT/harness/lib/detect.sh"
        . "$FROOT/engine/harness/lib/bootstrap.sh" 2>/dev/null || . "$FROOT/harness/lib/bootstrap.sh"
        felix_bs_render_workflow node someone/repo )"
has "the workflow invokes felix" "$gen" "harness/felix"
felix_path="$(printf '%s' "$gen" | grep -oE '\.\./felix/[a-z/]*harness/felix' | head -1)"
resolved="${felix_path#../felix/}"
# Checked against the real checkout, not the fixture. A generated workflow runs
# against a clone of the actual repository, so that is the layout that has to be
# right, and the fixture flattens the engine in a way no clone does.
REAL_ROOT="$(cd "$REAL_HARNESS/../.." && pwd)"
if [ -x "$REAL_ROOT/$resolved" ]; then
  ok "and that path resolves in a real checkout ($resolved)"
else
  bad "and that path resolves in a real checkout" "generated $resolved, absent from $REAL_ROOT"
fi

printf '\nmistakes record themselves\n'
# Judgement at write time is the wrong shape: it asks for a decision at the exact
# moment someone is trying to finish something else. Write cheaply, curate later.
MISLOG="$FROOT/projects/widget/memory/mistakes.log"
rm -f "$MISLOG"
# A script rather than an inline command: project.json holds no escaped quotes,
# which its reader documents that it cannot parse, and a gate script is the more
# common shape anyway.
cat > "$FROOT/projects/widget/failing-gate.sh" <<'GS'
#!/usr/bin/env bash
echo "  lint               FAIL"
exit 1
GS
chmod +x "$FROOT/projects/widget/failing-gate.sh"
python3 - "$FROOT/projects/widget/project.json" <<'PYJ'
import json,sys,pathlib
p=pathlib.Path(sys.argv[1]); d=json.loads(p.read_text())
d["gate"]="failing-gate.sh"
p.write_text(json.dumps(d,indent=2))
PYJ
( cd "$REPO" && "$FELIX" gate >/dev/null 2>&1 ); rc=$?
is "a failing gate still exits non-zero" "$rc" "1"
[ -f "$MISLOG" ] && ok "and records the failure without being asked" \
                 || bad "and records the failure without being asked"
grep -q 'lint' "$MISLOG" 2>/dev/null \
  && ok "naming which check failed" || bad "naming which check failed"

( cd "$REPO" && "$FELIX" gate >/dev/null 2>&1 )
out="$(cd "$REPO" && "$FELIX" promote 2>&1)"
has "twice makes it a promotion candidate" "$out" "the gate keeps catching"
has "and names the habit"                  "$out" "lint"

# A passing gate must not record anything, or the signal is just a run counter.
python3 - "$FROOT/projects/widget/project.json" <<'PYJ'
import json,sys,pathlib
p=pathlib.Path(sys.argv[1]); d=json.loads(p.read_text())
d["gate"]="true"; p.write_text(json.dumps(d,indent=2))
PYJ
before="$(wc -l < "$MISLOG")"
( cd "$REPO" && "$FELIX" gate >/dev/null 2>&1 )

      "mkdir -p d && ln -s '$QTRO/file' lf && ln -s '$QTRO/dir' ld && ln -s '$QTRO/file' d/lf && ln -s '$QTRO/dir' d/ld && chmod a-w d ." \
      > "$(_qtrd links)"

has "recording a run works" "$out" "recorded a run of weekly-thing"
out="$(cd "$REPO" && "$FELIX" maintenance 2>&1)"
has "and it stops being due" "$out" "ok      weekly-thing"
has "while others stay due"  "$out" "DUE     monthly-thing"


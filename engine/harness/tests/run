printf '\ngenerated CI points at a path that exists\n'
# Moving the engine broke every generated workflow at once, in other
# repositories, where this suite never looks. Felix's own gate stayed green
# because it tests Felix. The caller lived elsewhere.
#
# So the generator's output is checked against the filesystem: whatever path it
# tells CI to run must actually resolve inside the engine.
gen="$( . "$FROOT/engine/harness/lib/detect.sh" 2>/dev/null || . "$FROOT/harness/lib/detect.sh"
        . "$FROOT/engine/harness/lib/bootstrap.sh" 2>/dev/null || . "$FROOT/harness/lib/bootstrap.sh"
        felix_bs_render_workflow node someone/repo )"
has "the workflow invokes felix" "$gen" "harness/felix"
felix_path="$(printf '%s' "$gen" | grep -oE '\.\./felix/[a-z/]*harness/felix' | head -1)"
resolved="${felix_path#../felix/}"
# Checked against the real checkout, not the fixture. A generated workflow runs
# against a clone of the actual repository, so that is the layout that has to be
# right, and the fixture flattens the engine in a way no clone does.
REAL_ROOT="$(cd "$REAL_HARNESS/../.." && pwd)"
if [ -x "$REAL_ROOT/$resolved" ]; then
  ok "and that path resolves in a real checkout ($resolved)"
else
  bad "and that path resolves in a real checkout" "generated $resolved, absent from $REAL_ROOT"
fi

printf '\nmistakes record themselves\n'
# Judgement at write time is the wrong shape: it asks for a decision at the exact
# moment someone is trying to finish something else. Write cheaply, curate later.
MISLOG="$MEM/widget/mistakes.log"
rm -f "$MISLOG"
# A script rather than an inline command: project.json holds no escaped quotes,
# which its reader documents that it cannot parse, and a gate script is the more
# common shape anyway.
cat > "$FROOT/projects/widget/failing-gate.sh" <<'GS'
#!/usr/bin/env bash
echo "  lint               FAIL"
exit 1
GS
chmod +x "$FROOT/projects/widget/failing-gate.sh"
python3 - "$FROOT/projects/widget/project.json" <<'PYJ'
import json,sys,pathlib
p=pathlib.Path(sys.argv[1]); d=json.loads(p.read_text())
d["gate"]="failing-gate.sh"
p.write_text(json.dumps(d,indent=2))
PYJ
( cd "$REPO" && "$FELIX" gate >/dev/null 2>&1 ); rc=$?
is "a failing gate still exits non-zero" "$rc" "1"
[ -f "$MISLOG" ] && ok "and records the failure without being asked" \
                 || bad "and records the failure without being asked"
grep -q 'lint' "$MISLOG" 2>/dev/null \
  && ok "naming which check failed" || bad "naming which check failed"

( cd "$REPO" && "$FELIX" gate >/dev/null 2>&1 )
out="$(cd "$REPO" && "$FELIX" promote 2>&1)"
has "twice makes it a promotion candidate" "$out" "the gate keeps catching"
has "and names the habit"                  "$out" "lint"

# A check that could not have passed did not catch anything.
#
# Felix's `installed` check compares the tree against the deployed plugin cache.
# In a worktree that can never match — the marketplace is pinned to one path, so
# a worktree's engine is not the one being served — and every gate run there
# recorded `installed` as a mistake. The count went 9 to 11 during the session
# that fixed the recurrence report, and it sat at the top of `felix next` rank 5
# under "already cost time more than once", where the advice is to go and build
# a mechanism. The check manufactured the evidence that ranked it.
#
# The verdict is deliberately NOT changed: the gate still fails, because the
# tree genuinely does not match, and loosening a gate to quiet a report is the
# move this project warns about in the definition of its own objective. Only the
# RECORD changes. A gate may mark a failure as a property of where it ran rather
# than of the work, and the engine subtracts those from what it writes down
# without learning any check's name — the project's own gate declares it.
cat > "$FROOT/projects/widget/structural-gate.sh" <<'GS'
#!/usr/bin/env bash
echo "  lint               FAIL"
echo "  deployed           FAIL (structural: this tree is not the one that deploys)"
exit 1
GS
chmod +x "$FROOT/projects/widget/structural-gate.sh"
python3 - "$FROOT/projects/widget/project.json" <<'PYJ'
import json,sys,pathlib
p=pathlib.Path(sys.argv[1]); d=json.loads(p.read_text())
d["gate"]="structural-gate.sh"; p.write_text(json.dumps(d,indent=2))
PYJ
: > "$MISLOG"
( cd "$REPO" && "$FELIX" gate >/dev/null 2>&1 ); rc=$?
is "a structural failure still fails the gate" "$rc" "1"
grep -q 'lint' "$MISLOG" 2>/dev/null \
  && ok "an ordinary failure is still written down" \
  || bad "an ordinary failure is still written down" "$(cat "$MISLOG")"
grep -q 'deployed' "$MISLOG" 2>/dev/null \
  && bad "but one that could not have passed is not" "$(cat "$MISLOG")" \
  || ok  "but one that could not have passed is not"

# And when EVERY failure was structural, nothing is written — not even the
# exit-status fallback. The first version of this fixed the named check and then
# recorded `exit-1` instead, which is the same permanent row wearing a less
# informative name. Caught by running the real gate in a real worktree, which is
# where the case lives; the suite had passed.
cat > "$FROOT/projects/widget/structural-gate.sh" <<'GS'
#!/usr/bin/env bash
echo "  deployed           FAIL (structural: this tree is not the one that deploys)"
exit 1
GS
: > "$MISLOG"
( cd "$REPO" && "$FELIX" gate >/dev/null 2>&1 ); rc=$?
is "an all-structural gate still fails"           "$rc" "1"
is "and writes no row at all, not even exit-1"    "$(wc -l < "$MISLOG" | tr -d ' ')" "0"

# A gate that names nothing still falls back, because then the status is all
# anybody knows.
cat > "$FROOT/projects/widget/structural-gate.sh" <<'GS'
#!/usr/bin/env bash
echo "something went wrong but no check is named"
exit 3
GS
: > "$MISLOG"
( cd "$REPO" && "$FELIX" gate >/dev/null 2>&1 )
grep -q 'exit-3' "$MISLOG" 2>/dev/null \
  && ok "a gate naming no check still records its status" \
  || bad "a gate naming no check still records its status" "$(cat "$MISLOG")"

# A passing gate must not record anything, or the signal is just a run counter.
python3 - "$FROOT/projects/widget/project.json" <<'PYJ'
import json,sys,pathlib
p=pathlib.Path(sys.argv[1]); d=json.loads(p.read_text())
d["gate"]="true"; p.write_text(json.dumps(d,indent=2))
PYJ
before="$(wc -l < "$MISLOG")"
( cd "$REPO" && "$FELIX" gate >/dev/null 2>&1 )
is "a passing gate records nothing" "$(wc -l < "$MISLOG")" "$before"

printf '\ngenerated constitution\n'
CDIR="$FROOT/projects/stranger"
[ -s "$CDIR/CLAUDE.md" ] && ok "onboarding writes one" || bad "onboarding writes one"
has "it names the verification command" "$(cat "$CDIR/CLAUDE.md")" "felix gate"
has "and what was detected"             "$(cat "$CDIR/CLAUDE.md")" "billing"
# The invariants are the part that cannot be generated, and the file says why
# rather than pretending or leaving a bare TODO.
has "invariants say where they come from" "$(cat "$CDIR/CLAUDE.md")" "earned rather"
case "$(cat "$CDIR/CLAUDE.md")" in
  *"Replace this"*) bad "no placeholder telling someone to write it" "still a stub" ;;
  *) ok "no placeholder telling someone to write it" ;;
esac

printf '\nlessons are mounted, not offered\n'
cat > "$MEM/widget/lessons.md" <<'LES'
# widget lessons

## Checklist
1. run the gate
2. update the devlog

## Seeded principles
- **L-1 Migrations need a rollback path.** Long evidence about a migration that
  went wrong, with detail nobody needs mounted on every single turn.
- **L-2 Browser tests belong on critical flows.** More evidence, equally long,
  equally irrelevant until someone is actually touching the browser layer.
LES

out="$(cd "$REPO" && "$FELIX" lessons --for "changing a migration" 2>&1)"
has "matches the relevant lesson"   "$out" "L-1"
case "$out" in *"L-2"*) bad "and not the irrelevant one" "$out" ;; *) ok "and not the irrelevant one" ;; esac
has "the always-applicable part is shown" "$out" "run the gate"

# The evidence is why a lesson is believed; the claim is what needs mounting.
# Injecting the evidence every turn is how a helpful injection becomes ignored.
case "$out" in
  *"Long evidence about"*) bad "only the claim is mounted, not the evidence" "$out" ;;
  *) ok "only the claim is mounted, not the evidence" ;;
esac

out="$(cd "$REPO" && "$FELIX" lessons --for "unrelated quantum teleportation" 2>&1)"
has "an unrelated context matches nothing" "$out" "nothing matched"

printf '\nthe prompt hook\n'
HK="$FROOT/harness/hooks/user-prompt"
out="$(cd "$REPO" && printf '{"prompt":"fix the migration rollback"}' | "$HK" 2>&1)"
case "$out" in
  *'"hookSpecificOutput"'*) ok "emits the documented UserPromptSubmit shape" ;;
  *) bad "emits the documented UserPromptSubmit shape" "$out" ;;
esac
ctx="$(printf '%s' "$out" | python3 -c 'import json,sys; print(json.load(sys.stdin)["hookSpecificOutput"]["additionalContext"])' 2>&1)"
has "carries the matched lesson" "$ctx" "L-1"
# Bounded. A hook that floods the turn is a hook people learn to skim past.
lines="$(printf '%s\n' "$ctx" | wc -l | tr -d ' ')"
[ "$lines" -le 20 ] && ok "and stays small ($lines lines)" \
                    || bad "and stays small" "$lines lines is too much for every turn"

out="$(cd "$PLAIN" && printf '{"prompt":"anything"}' | "$HK" 2>&1)"; rc=$?
is "silent in an ungoverned repo" "${#out}" "0"
is "and exits 0 there"            "$rc" "0"

mv "$MEM/widget/lessons.md" "$TMP/lessons.bak"
out="$(cd "$REPO" && printf '{"prompt":"fix the migration"}' | "$HK" 2>&1)"
is "silent when a project has no lessons yet" "${#out}" "0"
mv "$TMP/lessons.bak" "$MEM/widget/lessons.md"

printf '\npipefail safety\n'
# Regression. Every presence check used to be `producer | grep -q x`, which under
# `set -o pipefail` reports 141 because grep exits on match and the producer takes
# SIGPIPE. The check then says absent about something present, and it is
# timing-dependent, so small producers pass and a real repository fails.
big="$(seq 1 200000)"
# Deliberately not asserting that `producer | grep -q x` fails here. It fails
# only when the producer is still writing when grep exits, so the assertion is a
# race and flakes. The reason the helpers exist is recorded above instead.
if ( set -uo pipefail
     . "$FROOT/harness/lib/resolve.sh"
     felix_contains "$big" "199999" ); then
  ok "felix_contains survives a large haystack under pipefail"
else
  bad "felix_contains survives a large haystack under pipefail"
fi
if ( set -uo pipefail
     . "$FROOT/harness/lib/resolve.sh"
     felix_has_line "$big" "199999" ) ; then
  ok "felix_has_line matches whole lines under pipefail"
else
  bad "felix_has_line matches whole lines under pipefail"
fi
if ( set -uo pipefail
     . "$FROOT/harness/lib/resolve.sh"
     felix_has_line "alpha
beta" "alph" ); then
  bad "felix_has_line rejects partial lines" "matched a prefix"
else
  ok "felix_has_line rejects partial lines"
fi

printf '\nthe completion gate\n'
# The principle under test: an agent must not be able to say it is finished
# while the tree it changed has never been verified. Everything here drives the
# real Stop hook with real JSON on stdin, against a real git repository.
STOP="$FROOT/harness/hooks/stop"
# Earlier sections rewrite the widget gate to prove other things, so this one
# declares the gate it depends on instead of inheriting whatever ran last.
# Without this the red-gate case silently tests a gate of `true`, which cannot
# fail, and the failure reads like a product bug rather than a suite bug.
cat > "$FROOT/projects/widget/project.json" <<'EOF'
{
  "name": "widget",
  "remote_match": "example.com/widget",
  "gate": "sh -c 'test -f WIDGET.txt && echo widget-gate-ran'"
}
EOF
GREPO="$TMP/gaterepo"
mkdir -p "$GREPO"
( cd "$GREPO" && git init -q -b main
  printf 'contents\n' > WIDGET.txt
  printf 'widget\n'   > .felix
  git add -A >/dev/null 2>&1
  git -c user.name=t -c user.email=t@t commit -qm init >/dev/null 2>&1 )
GREPO="$(cd "$GREPO" && pwd -P)"

EMPTY_JSON='{"hook_event_name":"Stop","stop_hook_active":false}'
ACTIVE_JSON='{"hook_event_name":"Stop","stop_hook_active":true}'
_stop() { ( cd "$1" && printf '%s' "${2:-$EMPTY_JSON}" | "$STOP" 2>&1 ); }
_blocks() {
  case "$2" in *'"decision"'*'"block"'*) ok "$1" ;; *) bad "$1" "expected a block, got [$2]" ;; esac
}
_allows() { [ -z "$2" ] && ok "$1" || bad "$1" "expected silence, got [$2]"; }

out="$(_stop "$GREPO")"; rc=$?
_allows "a session that changed nothing stops silently" "$out"
is      "and exits 0"                                   "$rc" "0"

# The guidebook states DEFINITION OF DONE absolutely: never declare a task
# complete while a required deterministic verification step is failing. The hook
# opened with a bare `felix_tree_dirty || exit 0`, so committing your work
# skipped the check entirely — and committing is what you do at the end. Every
# session that finished properly was the one never asked.
#
# "Dirty" was standing in for "this session changed something", and those come
# apart the moment anybody commits. SessionStart now records the HEAD it saw, so
# the two can be told apart.
SESS='{"hook_event_name":"Stop","stop_hook_active":false,"session_id":"dod-sess"}'
# Laid by the real hook rather than hand-written, so the test exercises the
# path that actually runs. UserPromptSubmit carries the session id;
# SessionStart never reads its payload at all.
_start_at() {
  rm -f "$FROOT/state/session/dod-sess"
  ( cd "$1" && printf '{"session_id":"dod-sess","prompt":"begin"}' \
      | "$FROOT/harness/hooks/user-prompt" >/dev/null 2>&1 )
}

_start_at "$GREPO"
out="$(_stop "$GREPO" "$SESS")"
_allows "a recorded session that committed nothing is still silent" "$out"

printf 'committed work\n' >> "$GREPO/WIDGET.txt"
( cd "$GREPO" && git add -A >/dev/null 2>&1 \
  && git -c user.name=t -c user.email=t@t commit -qm work >/dev/null 2>&1 )
out="$(_stop "$GREPO" "$SESS")"
_blocks "committing unverified work no longer skips the check" "$out"
has     "and says the gate has not seen it"                    "$out" "gate"

# Fail open when there is no record: a session that began before this shipped,
# or one whose id could not be read, must not start blocking on a clean tree.
out="$(_stop "$GREPO" "$EMPTY_JSON")"
_allows "with no session record it behaves as before" "$out"
rm -f "$FROOT/state/session/dod-sess"

# Restore the fixture for the assertions below, which expect an unverified edit.
( cd "$GREPO" && git reset -q --hard HEAD~1 )

printf 'edited\n' >> "$GREPO/WIDGET.txt"
out="$(_stop "$GREPO")"
_blocks "an unverified change blocks completion" "$out"
has     "and says the gate never ran"            "$out" "never"

out="$(cd "$GREPO" && "$FELIX" gate 2>&1)"
out="$(_stop "$GREPO")"
_allows "a green gate on this exact tree allows it" "$out"

# A green gate proves the suite passed and nothing about the claims made on the
# way there. Those are what go wrong: work reported as fixed that reached no
# session, a tool reported as removed that was still installed, a document
# describing a capability the thing had outgrown. All three passed a gate.
printf 'plugin\tsuperpowers@x\t-\tlow\talways\n' > "$FROOT/projects/widget/stack.tsv"
rm -rf "$FROOT/state/verified"
out="$(cd "$GREPO" && printf '{"hook_event_name":"Stop","stop_hook_active":false,"session_id":"vsess"}' \
       | "$STOP" 2>&1)"
has "a green gate still asks for verification" "$out" "verification-before-completion"
has "and says why the gate is not enough"      "$out" "does not mean"
# Once per session. Said at every stop it becomes noise, and noise is skimmed.
out="$(cd "$GREPO" && printf '{"hook_event_name":"Stop","stop_hook_active":false,"session_id":"vsess"}' \
       | "$STOP" 2>&1)"
case "$out" in
  *verification-before-completion*) bad "and only once per session" "$out" ;;
  *)                                ok  "and only once per session" ;;
esac
# A project that does not use superpowers is not told to reach for it.
printf 'plugin\tsomething-else@x\t-\tlow\talways\n' > "$FROOT/projects/widget/stack.tsv"
rm -rf "$FROOT/state/verified"
out="$(cd "$GREPO" && printf '{"hook_event_name":"Stop","stop_hook_active":false,"session_id":"vsess2"}' \
       | "$STOP" 2>&1)"
case "$out" in
  *verification-before-completion*) bad "and never where it is not declared" "$out" ;;
  *)                                ok  "and never where it is not declared" ;;
esac
rm -rf "$FROOT/state/verified"

# The git-status trap. Two different edits to the same file produce identical
# porcelain output, so a receipt keyed on status alone stays valid across a
# change it never saw. The hash has to include diff content.
printf 'different\n' >> "$GREPO/WIDGET.txt"
out="$(_stop "$GREPO")"
_blocks "editing the same file again invalidates the receipt" "$out"

( cd "$GREPO" && git checkout -q -- WIDGET.txt )
out="$(cd "$GREPO" && "$FELIX" gate 2>&1)"
printf 'new\n' > "$GREPO/untracked.txt"
out="$(_stop "$GREPO")"
_blocks "a new untracked file invalidates the receipt" "$out"
rm -f "$GREPO/untracked.txt"

# The platform caps consecutive blocks and documents the contract: return
# success while stop_hook_active is set. Ignoring it is how a hook loops.
printf 'unverified\n' >> "$GREPO/WIDGET.txt"
out="$(_stop "$GREPO" "$ACTIVE_JSON")"
_allows "stop_hook_active is honoured, so it never loops" "$out"

# The override is the founder's, not the model's: it is read from the
# environment the session was launched with.
out="$(cd "$GREPO" && FELIX_ALLOW_RED=1 printf '%s' "$EMPTY_JSON" | FELIX_ALLOW_RED=1 "$STOP" 2>&1)"
_allows "FELIX_ALLOW_RED lets a founder stop anyway" "$out"

# A failing gate must leave a red receipt, not no receipt. No receipt and a red
# one both block, but only one of them tells the truth about what happened.
rm -f "$GREPO/WIDGET.txt"
out="$(cd "$GREPO" && "$FELIX" gate 2>&1)"
out="$(_stop "$GREPO")"
_blocks "a failing gate still blocks"  "$out"
has     "and says the gate failed"     "$out" "failed"
printf 'contents\n' > "$GREPO/WIDGET.txt"

VLOG="$MEM/widget/verification.log"
[ -s "$VLOG" ] && ok "every decision is recorded" \
               || bad "every decision is recorded" "no verification.log at $VLOG"
if [ -s "$VLOG" ]; then
  grep -q 'blocked'  "$VLOG" && ok "blocks are recorded"    || bad "blocks are recorded"
  grep -q 'override' "$VLOG" && ok "overrides are recorded" || bad "overrides are recorded"
fi

out="$(_stop "$PLAIN")"; rc=$?
_allows "silent in an ungoverned repo" "$out"
is      "and exits 0 there"            "$rc" "0"

NOGIT="$TMP/notgit"; mkdir -p "$NOGIT"; printf 'widget\n' > "$NOGIT/.felix"
out="$(_stop "$NOGIT")"; rc=$?
_allows "silent outside a git repository" "$out"
is      "and exits 0 there too"           "$rc" "0"

# A project that declares no gate has nothing to enforce, and inventing an
# obligation for it would make Felix unusable on a repo mid-onboarding.
mkdir -p "$FROOT/projects/nogate" "$MEM/nogate"
printf '{\n  "name": "nogate"\n}\n' > "$FROOT/projects/nogate/project.json"
NGREPO="$TMP/nogaterepo"; mkdir -p "$NGREPO"
( cd "$NGREPO" && git init -q -b main && printf 'x\n' > a.txt
  git add -A >/dev/null 2>&1 && git -c user.name=t -c user.email=t@t commit -qm i >/dev/null 2>&1 )
printf 'nogate\n' > "$NGREPO/.felix"; printf 'dirty\n' >> "$NGREPO/a.txt"
out="$(_stop "$NGREPO")"
_allows "a project with no declared gate is left alone" "$out"

# Felix governs projects in languages it does not know, and one of their
# untracked directories may be a virtualenv or a model artifact. Metadata only.
mkdir -p "$GREPO/bigdir"
i=0; while [ "$i" -lt 60 ]; do printf 'x\n' > "$GREPO/bigdir/f$i"; i=$((i+1)); done
t0=$(date +%s); out="$(_stop "$GREPO")"; t1=$(date +%s)
[ $((t1-t0)) -le 3 ] && ok "stays fast with many untracked files ($((t1-t0))s)" \
                     || bad "stays fast with many untracked files" "$((t1-t0))s"
rm -rf "$GREPO/bigdir"

# The gate and the hook compute tree identity independently. If they ever
# disagree the gate silently stops counting, so they must share one function.
tid_lib="$( . "$FROOT/harness/lib/verify.sh"; felix_tree_id "$GREPO" )"
[ -n "$tid_lib" ] && ok "tree identity is computable" \
                  || bad "tree identity is computable" "empty"
printf 'moved\n' >> "$GREPO/WIDGET.txt"
tid2="$( . "$FROOT/harness/lib/verify.sh"; felix_tree_id "$GREPO" )"
[ "$tid_lib" != "$tid2" ] && ok "and changes when the tree changes" \
                          || bad "and changes when the tree changes" "$tid_lib == $tid2"
( cd "$GREPO" && git checkout -q -- WIDGET.txt )

# A repository with no commits at all. HEAD is unborn, and every naive
# implementation of this dies there. The suite's own fixture is in that state.
UNBORN="$TMP/unborn"; mkdir -p "$UNBORN"
( cd "$UNBORN" && git init -q -b main )
printf 'widget\n' > "$UNBORN/.felix"; printf 'x\n' > "$UNBORN/new.txt"
tid3="$( . "$FROOT/harness/lib/verify.sh"; felix_tree_id "$UNBORN" )"
[ -n "$tid3" ] && ok "tree identity survives an unborn HEAD" \
               || bad "tree identity survives an unborn HEAD" "empty"
out="$(_stop "$UNBORN")"; rc=$?
is "and the hook still exits 0 there" "$rc" "0"

# Felix governing itself: the home lives INSIDE the tree being gated, so every
# receipt, verification line and route line lands in the repo it describes.
# Writing a receipt then changes the tree, which invalidates the receipt just
# written, and no gate run can ever produce a valid one. The fixture above hides
# this entirely because there the home sits outside the governed repo — which is
# why this reproduces the real layout instead.
SELF="$TMP/selfgoverned"
mkdir -p "$SELF/projects/self" "$MEM/self" "$SELF/harness"
cp -R "$REAL_HARNESS/." "$SELF/harness/"
cat > "$SELF/projects/self/project.json" <<'EOF'
{ "name": "self", "gate": "true" }
EOF
printf '# self\n' > "$SELF/projects/self/CLAUDE.md"
( cd "$SELF" && git init -q -b main && printf 'x\n' > code.txt && printf 'self\n' > .felix
  git add -A >/dev/null 2>&1
  git -c user.name=t -c user.email=t@t commit -qm i >/dev/null 2>&1 )
SELF="$(cd "$SELF" && pwd -P)"
printf 'real work\n' >> "$SELF/code.txt"
( cd "$SELF" && FELIX_HOME="$SELF" "$SELF/harness/felix" gate >/dev/null 2>&1 )
out="$(cd "$SELF" && FELIX_HOME="$SELF" printf '%s' "$EMPTY_JSON" \
        | FELIX_HOME="$SELF" "$SELF/harness/hooks/stop" 2>&1)"
_allows "a receipt survives being written inside the tree it describes" "$out"
# And a second stop, which appends another verification line, must also pass.
out="$(cd "$SELF" && FELIX_HOME="$SELF" printf '%s' "$EMPTY_JSON" \
        | FELIX_HOME="$SELF" "$SELF/harness/hooks/stop" 2>&1)"
_allows "and keeps surviving as its own log grows" "$out"
# Real work still has to be verified, bookkeeping exemption or not.
printf 'more real work\n' >> "$SELF/code.txt"
out="$(cd "$SELF" && FELIX_HOME="$SELF" printf '%s' "$EMPTY_JSON" \
        | FELIX_HOME="$SELF" "$SELF/harness/hooks/stop" 2>&1)"
_blocks "but a real edit still blocks" "$out"

printf '\nthe intent router\n'
# Say what you are doing and get the right kit, without naming it. The chain is
# routes.tsv -> profiles.tsv -> stack.tsv, and only the first link is new.
cp "$REAL_HARNESS/templates/routes.tsv"   "$FROOT/projects/widget/routes.tsv"
cp "$REAL_HARNESS/templates/profiles.tsv" "$FROOT/projects/widget/profiles.tsv"
cat > "$FROOT/projects/widget/stack.tsv" <<'EOF'
plugin	frontend-design@claude-plugins-official	-	low	frontend
plugin	playwright@claude-plugins-official	-	low	e2e
skill	impeccable	-	low	frontend
EOF
printf 'frontend\ne2e\n' > "$FROOT/projects/widget/capabilities"

_route() { ( cd "${2:-$REPO}" && "$FELIX" route --for "$1" 2>&1 ); }

out="$(_route "let us build the results page")"
has "a frontend prompt routes to frontend" "$out" "frontend"
has "and names the play in order"          "$out" "frontend-design"
has "with the critique step after it"      "$out" "impeccable"

# The prompt is what you just said; the tree is only where you are standing.
# Without weighting, a dirty frontend tree drags every question toward frontend.
mkdir -p "$REPO/ui"; printf 'x\n' > "$REPO/ui/page.css"
out="$(_route "add a migration for the endpoint schema")"
has "the prompt outweighs the working tree" "$out" "backend"
rm -rf "$REPO/ui"

# Below the threshold nothing is said at all. One stray path token must not be
# enough to decide what you meant.
out="$(_route "ok")"
is "a prompt with no signal says nothing" "${#out}" "0"

# Two corroborating tree tokens do meet the threshold, on purpose. But a route
# the tree chose is a different claim from one you asked for, and presenting the
# second as the first is quietly lying about why.
mkdir -p "$REPO/ui"; printf 'x\n' > "$REPO/ui/page.css"; printf 'x\n' > "$REPO/ui/component.js"
out="$(_route "ok")"
has "the working tree alone can route"       "$out" "frontend"
has "and says so rather than implying I did" "$out" "working tree"
out="$(_route "render the modal component")"
case "$out" in
  *"working tree"*) bad "a typed intent is not labelled a guess" "$out" ;;
  *) ok "a typed intent is not labelled a guess" ;;
esac
rm -rf "$REPO/ui"

out="$(cd "$REPO" && "$FELIX" route --for "let us build the results page" --explain 2>&1)"
has "explain shows the losing routes too" "$out" "build"

# A play entry the project never declared is named, not hidden. It is the seam
# to the discovery slice, and silently dropping it would hide the gap.
cat >> "$FROOT/projects/widget/routes.tsv" <<'EOF'
ghost	nonesuch	frontend	not-declared-anywhere
EOF
out="$(_route "nonesuch")"
has "an undeclared tool is reported, not hidden" "$out" "not declared"

# A malformed row must not take the file down with it.
printf 'broken-row-with-no-tabs\n' >> "$FROOT/projects/widget/routes.tsv"
out="$(_route "let us build the results page")"
has "a malformed row is skipped, others still match" "$out" "frontend"

# The hook is handed the whole payload, so the envelope's own field names are in
# the token stream. A route keyed on one of them scored on every single turn
# whatever was typed, which is invisible until a project's subject matter
# happens to be prompts. Found by running the hook against a real repository.
cat >> "$FROOT/projects/widget/routes.tsv" <<'EOF'
envelope	prompt session transcript permission	frontend	-
EOF
out="$(cd "$REPO" && printf '{"session_id":"s","prompt":"the migration schema needs an index"}' | "$FROOT/harness/hooks/user-prompt" 2>&1)"
case "$out" in
  *envelope*) bad "the payload envelope does not decide the route" "$out" ;;
  *) ok "the payload envelope does not decide the route" ;;
esac
# ...but the words themselves must survive. Banning them was the first fix and
# was worse than the bug: asking about a hook matched nothing at all, because
# the word had been blacklisted to silence a field name of the same name.
toks="$( . "$FROOT/harness/lib/route.sh"
         felix_route_tokens '{"session_id":"s","prompt":"the stop hook is blocking"}' | tr '\n' ' ' )"
has  "a word shared with a field name still counts" "$toks" "hook"
case "$toks" in
  *session_id*|*" session "*) bad "but the field names themselves are gone" "$toks" ;;
  *) ok "but the field names themselves are gone" ;;
esac

# The keys were the half that got fixed. The VALUES are still in the stream, and
# they are worse: transcript_path and cwd carry the whole checkout path, so a
# home directory called Documents or a worktree branch named ...-review-... puts
# those words in as if they had been typed — at double weight, which is the
# score reserved for what you actually said. Found by watching `continue` route
# to a document skill.
out="$(cd "$REPO" && printf '{"session_id":"s","transcript_path":"/home/u/migration-schema-endpoint/a.jsonl","cwd":"/home/u/queue-worker","prompt":"the button layout is wrong"}' \
       | "$FROOT/harness/hooks/user-prompt" 2>&1)"
case "$out" in
  *backend*) bad "a path in the envelope does not decide the route" "$out" ;;
  *) ok "a path in the envelope does not decide the route" ;;
esac
# Asserted on tokens, not on the hook's output: the hook announces only when the
# route changes, so a presence check there passes or fails on prior state rather
# than on the thing being tested.
toks="$( . "$FROOT/harness/lib/route.sh"
         felix_route_tokens '{"transcript_path":"/home/u/migration-schema-endpoint/a.jsonl","prompt":"the button layout is wrong"}' | tr '\n' ' ' )"
has "and what was typed still counts" "$toks" "layout"
case "$toks" in
  *migration*|*endpoint*) bad "while the path around it does not" "$toks" ;;
  *) ok "while the path around it does not" ;;
esac

toks="$( . "$FROOT/harness/lib/route.sh"
         felix_route_tokens '{"transcript_path":"/home/u/documents-felix/a.jsonl","prompt":"continue"}' | tr '\n' ' ' )"
case "$toks" in
  *documents*|*jsonl*) bad "envelope path values are gone from the tokens" "$toks" ;;
  *) ok "envelope path values are gone from the tokens" ;;
esac
# Nobody typed a task notification. The hook is handed every UserPromptSubmit
# payload, and the runtime uses that channel for its own messages too — task
# completions, system reminders, the Stop hook's own feedback. Five of the 89
# rows in Felix's routes.log are machine text scored as if a person had written
# it, and they picked real routes: three `harness`, one `research`, one `gate`.
#
# Three consequences, and the third is a loop. The play announcement fires at
# text nobody wrote. The miss log accrues rows that skew `--promote`. And the
# Stop hook then asks why the named play went unused — a question generated by
# a route that fired on a machine's own message.
#
# Matched on STRUCTURE, never on vocabulary. `<task-notification>` at the start
# of the payload is a tag no sentence opens with; the word "notification" is one
# people type, and this project has already broken a word once by banning it to
# silence a field name. Only the literal opening marker counts.
_mach() { ( . "$FROOT/harness/lib/route.sh"; felix_route_is_machine "$1" ) && printf yes || printf no; }
is "a task notification is not a prompt"  "$(_mach '<task-notification><task-id>x</task-id></task-notification>')" "yes"
is "nor is a system reminder"             "$(_mach '<system-reminder>the gate has not run</system-reminder>')"      "yes"
is "nor the stop hook talking to itself"  "$(_mach 'Stop hook feedback:
The gate last ran at ...')"                                                                                          "yes"
is "nor the all-caps sentinel"            "$(_mach '[SYSTEM NOTIFICATION - NOT USER INPUT] a background task ended')" "yes"
# The word, as opposed to the tag, belongs to whoever typed it.
is "but asking about a notification is a prompt" \
   "$(_mach 'why did the task-notification route to harness?')" "no"
is "and so is ordinary work"              "$(_mach 'fix the queue worker')" "no"
is "an empty payload is not machine text" "$(_mach '')" "no"

# The hook holds the whole envelope, so the two compose. Extraction takes the
# FIRST copy of the key: `s/.*"prompt"/` would bind to the last, and a later copy
# in the envelope being read in preference to the real one is already a lesson
# in this repository.
_pv() { ( . "$FROOT/harness/lib/route.sh"; felix_route_prompt "$1" ); }
case "$(_pv '{"session_id":"s","prompt":"<task-notification>done</task-notification>"}')" in
  '<task-notification>'*) ok  "the prompt is read out of the envelope" ;;
  *)                      bad "the prompt is read out of the envelope" "$(_pv '{"prompt":"<task-notification>x"}')" ;;
esac
case "$(_pv '{"prompt":"fix the queue","extra":"prompt: not this one"}')" in
  'fix the queue'*) ok  "and from the first copy of the key, not a later one" ;;
  *)                bad "and from the first copy of the key, not a later one" ;;
esac
_mp() { ( . "$FROOT/harness/lib/route.sh"
          felix_route_is_machine "$(felix_route_prompt "$1")" ) && printf yes || printf no; }
is "a notification payload is machine text end to end" \
   "$(_mp '{"session_id":"s","prompt":"<task-notification>done</task-notification>"}')" "yes"
is "and a real one still routes" \
   "$(_mp '{"session_id":"s","prompt":"fix the queue worker"}')" "no"

# A path the person actually typed is theirs, and must still route.
toks="$( . "$FROOT/harness/lib/route.sh"
         felix_route_tokens '{"prompt":"fix src/queue/worker.py"}' | tr '\n' ' ' )"
has "a path you typed yourself still counts" "$toks" "worker"

# Whether Stop should stay quiet, as a predicate rather than hook-internal logic.
# The first version of this test drove the whole Stop hook through a fixture
# whose transcript path was empty, so the complaint fired in neither direction
# and "it stays quiet on a guess" passed by finding nothing — the vacuous-check
# shape this session has now hit three times.
SG="$TMP/routestate"; mkdir -p "$SG"
_guessed() { printf '%s' "$2" > "$SG/s"; ( . "$FROOT/harness/lib/route.sh"
            felix_route_state_guessed "$SG/s" ) && printf yes || printf no; }
is "a route off the tree is a guess"        "$(_guessed x "$(printf 'harness:done\ttree')")"   "yes"
is "one from what you typed is not"         "$(_guessed x "$(printf 'harness:done\tprompt')")" "no"
is "nor is one from both"                   "$(_guessed x "$(printf 'harness:done\tmixed')")"  "no"
is "a state file from before this existed complains, as it did" \
   "$(_guessed x 'harness:done')" "no"
# The shape production actually emits. A due step is a play entry, so it carries
# a colon of its own — and the colon scheme this replaced read "brainstorming"
# as the provenance and never matched anything. Every fixture above uses a due
# step of `done`, which is why they all passed while the real value did not.
is "a due step containing a colon does not shift it" \
   "$(_guessed x "$(printf 'harness:superpowers:brainstorming\ttree')")" "yes"
rm -f "$SG/s"
( . "$FROOT/harness/lib/route.sh"; felix_route_state_guessed "$SG/s" ) \
  && bad "a missing state file is not a guess" || ok "a missing state file is not a guess"

# A route must match its own name, and three did not.
#
# `debug` named systematic-debugging and did not have the word "debug" among its
# keywords, so "debug why the harness hook is failing" scored the harness row
# instead and was told to go and brainstorm. `ship` and `tooling` were the same
# shape. This is not a guess about vocabulary — it is the one keyword a row is
# guaranteed to want, and it is checkable, so it is checked against the shipped
# table rather than a fixture.
REALT="$(cd "$REAL_HARNESS/../.." && pwd)/projects/felix/routes.tsv"
if [ -f "$REALT" ]; then
  selfmiss="$(awk -F'\t' '!/^#/ && NF>=2 {
      n=$1; split($2,a," "); found=0
      for (i in a) if (index(n,a[i])==1) found=1
      if (!found) printf "%s ", n
    }' "$REALT")"
  is "every route matches its own name" "$(printf '%s' "$selfmiss" | tr -d ' ')" ""
fi

# The log and the router had drifted apart, and only the log was ever read back.
# `felix_route_log` stripped the pairs the runtime owns and not the JSON keys, so
# every miss recorded the literal words `prompt` and `prompt_id`. They were the
# top two rows of `felix route --promote` — the one mechanism for improving the
# table — above every word anybody typed. The router had been right the whole
# time; the record of what it saw was not. Two tokenisers with one job is the
# defect, so promote reads the router's.
#
# The fix is on the READ side, and the first version of it was not. Stripping the
# keys on the way into the log as well broke `felix monitor`, whose route panel
# extracts the sentence by looking for the literal `"prompt":` key — with it
# gone the parser falls through and every new row renders as
# `{ , "repair the queue worker"}` instead of the sentence. The log is a record
# for a person to read; promote's requirement is satisfied entirely by
# `_felix_route_words` on the way out, which also cleans rows written before any
# of this. Asserted on both sides now, because asserting on one is what broke
# the other.
RLP="$TMP/routelog"; mkdir -p "$RLP" "$MEM/routelog"
( . "$FROOT/harness/lib/route.sh"
  felix_route_log "$RLP" "-" 0 '{"session_id":"s","transcript_path":"/home/u/migration-endpoint/a.jsonl","prompt_id":"9f2","prompt":"repair the queue worker"}' )
logged="$(cut -f4 "$MEM/routelog/routes.log")"
has "what a miss records is what was typed" "$logged" "queue"
case "$logged" in
  *session_id*|*migration*) bad "and not the pairs the runtime owns" "$logged" ;;
  *)                        ok  "and not the pairs the runtime owns" ;;
esac
rendered="$( . "$FROOT/harness/lib/monitor.sh"; _felix_mon_prompt "$logged" )"
is "and the monitor still renders the sentence, not the JSON around it" \
   "$rendered" "repair the queue worker"

# Promote then counts those, through the same filter that scored them. A word the
# router discards can never be a word the table is missing.
i=0; while [ "$i" -lt 3 ]; do
  ( . "$FROOT/harness/lib/route.sh"
    felix_route_log "$RLP" "-" 0 '{"prompt_id":"9f2","prompt":"repair the queue worker that would help"}' )
  i=$((i+1))
done
p="$( . "$FROOT/harness/lib/route.sh"; FELIX_ROUTE_PROMOTE_MIN=2 felix_route_promote "$RLP" )"
has "a real word rises" "$p" "queue"
case "$p" in
  *prompt*) bad "an envelope field name never does" "$p" ;;
  *)        ok  "an envelope field name never does" ;;
esac
case "$p" in
  *would*|*help*) bad "nor filler the router already discards" "$p" ;;
  *)              ok  "nor filler the router already discards" ;;
esac

# A row can end mid-character. `cut -c1-160` is byte-oriented wherever the hook
# actually runs — LANG is unset in that environment and LC_CTYPE is C — so when
# byte 160 lands inside a multibyte character the log keeps half of it. Reading
# that back through `sed -E` in the UTF-8 locale a Terminal has raises
# "illegal byte sequence"; under `set -o pipefail` the whole pipeline returns 1,
# promote returns nothing, and the caller printed "Nothing has missed often
# enough to be worth a row yet." A crash reported as an all-clear, in the report
# that exists to find what the routing table is missing — and worse in the
# middle of a log, where the rows after the bad one vanish with no cue at all.
#
# Two independent defects, so two assertions: the pipeline must not care, and
# the caller must not read emptiness as success.
BADL="$TMP/badlocale"; mkdir -p "$BADL" "$MEM/badlocale"
{ printf '2026-08-13T00:00:00Z\t-\t0\t{ ,"prompt":"repair the queue worker"}\n'
  printf '2026-08-13T00:00:01Z\t-\t0\t{ ,"prompt":"repair the queue worker"}\n'
  printf '2026-08-13T00:00:02Z\t-\t0\t{ ,"prompt":"stalled deploy \xe2\x80"}\n'
  printf '2026-08-13T00:00:03Z\t-\t0\t{ ,"prompt":"repair the queue worker"}\n'
} > "$MEM/badlocale/routes.log"
bp="$( . "$FROOT/harness/lib/route.sh"
       export LC_ALL=en_US.UTF-8
       FELIX_ROUTE_PROMOTE_MIN=3 felix_route_promote "$BADL" 2>/dev/null )" && brc=0 || brc=$?
is  "a half-written character does not fail the whole report" "$brc" "0"
has "and the rows on both sides of it are still counted"      "$bp"  "queue"

# The tree may corroborate, never outvote. Without a cap, a checkout carrying a
# few hundred untracked path tokens drowns out the four words you typed.
mkdir -p "$REPO/noise"
i=0; while [ "$i" -lt 40 ]; do printf 'x\n' > "$REPO/noise/component-layout-styling-$i.css"; i=$((i+1)); done
out="$(_route "add a migration for the endpoint schema")"
has "a wall of tree tokens cannot outvote the prompt" "$out" "backend"
rm -rf "$REPO/noise"

RHK="$FROOT/harness/hooks/user-prompt"
S1='{"session_id":"sess-aaa","prompt":"let us build the results page"}'
S2='{"session_id":"sess-aaa","prompt":"let us build the results page again"}'
S3='{"session_id":"sess-aaa","prompt":"add a migration for the endpoint schema"}'
_hook() { ( cd "$REPO" && printf '%s' "$1" | "$RHK" 2>&1 ); }
_ctx() { printf '%s' "$1" | python3 -c 'import json,sys;print(json.load(sys.stdin)["hookSpecificOutput"]["additionalContext"])' 2>/dev/null; }

rm -rf "$FROOT/state/route"
out="$(_hook "$S1")"; ctx="$(_ctx "$out")"
has "the hook routes on the first prompt" "$ctx" "frontend"
# One block, not two. Two injections fight for the same attention.
n="$(printf '%s' "$out" | grep -c 'hookSpecificOutput')"
is "route and lessons arrive as one block" "$n" "1"

# A prompt where both genuinely apply. Two injections competing for the same
# attention is how both get skimmed, so they must arrive as one.
rm -rf "$FROOT/state/route"
out="$(_hook '{"session_id":"sess-bbb","prompt":"add a migration for the endpoint schema rollback"}')"
ctx="$(_ctx "$out")"
has "the route is there when both apply" "$ctx" "backend"
has "and the lesson is in the same block" "$ctx" "L-1"
n="$(printf '%s' "$out" | grep -c 'hookSpecificOutput')"
is "still exactly one block"              "$n" "1"
rm -rf "$FROOT/state/route"
out="$(_hook "$S1")" >/dev/null 2>&1

out="$(_hook "$S2")"; ctx="$(_ctx "$out")"
case "$ctx" in
  *"routed this to"*) bad "the same route does not repeat itself" "$ctx" ;;
  *) ok "the same route does not repeat itself" ;;
esac

out="$(_hook "$S3")"; ctx="$(_ctx "$out")"
has "a change of route speaks again" "$ctx" "backend"

# A guessed route and an ignored instruction are different facts, and the state
# file threw the difference away.
#
# `felix route` already says which it is — "read off the working tree, not the
# prompt: nothing you typed named a kind of work" — from the prompt-contributed
# half of the score. The state written for `Stop` recorded only route and due
# step, so `Stop` ended sessions complaining that a play went unused whether the
# route came from what somebody typed or from what happened to be checked out.
# It fired five times in one session, at least three of them on open guesses.
#
# Provenance is stored as a word rather than the score it came from. The score
# is an implementation detail of today's ranking function; what the contract
# needs to survive a re-weighting is whether the obligation was grounded in
# intent at all.
rm -rf "$FROOT/state/route"
_hook '{"session_id":"prov-p","prompt":"let us build the results page"}' >/dev/null 2>&1
is "a route from what you typed is recorded as such" \
   "$(cut -f2 < "$FROOT/state/route/prov-p" 2>/dev/null)" "prompt"

# Nothing routable typed, so whatever it picked came off the tree.
rm -rf "$FROOT/state/route"
_hook '{"session_id":"prov-t","prompt":"ok"}' >/dev/null 2>&1
if [ -f "$FROOT/state/route/prov-t" ]; then
  case "$(cut -f2 < "$FROOT/state/route/prov-t")" in
    tree|mixed) ok  "a route off the tree is not recorded as typed" ;;
    *)          bad "a route off the tree is not recorded as typed" \
                    "$(cat "$FROOT/state/route/prov-t")" ;;
  esac
else
  ok "a route off the tree is not recorded as typed"
fi

# Dedup must ignore it. The state value is also the announce key, so a third
# field that varies would make a route re-announce itself with nothing changed —
# which is the noise this exists to remove, reintroduced one field along.
rm -rf "$FROOT/state/route"
_hook "$S1" >/dev/null 2>&1
# The same prompt twice, with only the third field altered in between, so
# provenance is the single variable. Planting a route name here instead would
# have tested whatever that fixture happens to route to.
k="$(cut -f1 < "$FROOT/state/route/sess-aaa" 2>/dev/null)"
printf '%s\ttree' "$k" > "$FROOT/state/route/sess-aaa"
out="$(_hook "$S1")"; ctx="$(_ctx "$out")"
case "$ctx" in
  *"routed this to"*) bad "provenance is not part of the announce key" "$ctx" ;;
  *)                  ok  "provenance is not part of the announce key" ;;
esac

# State is a convenience. Losing it must cost a repeated block, never a session.
chmod 000 "$FROOT/state/route" 2>/dev/null
out="$(cd "$REPO" && printf '%s' "$S1" | "$RHK" 2>&1)"; rc=$?
is "an unwritable state directory still exits 0" "$rc" "0"
chmod 755 "$FROOT/state/route" 2>/dev/null

RLOG="$MEM/widget/routes.log"
[ -s "$RLOG" ] && ok "every decision is logged" || bad "every decision is logged" "no $RLOG"
grep -q 'frontend' "$RLOG" 2>/dev/null && ok "hits are logged" || bad "hits are logged"
out="$(_route "zzzquux flibbertigibbet")" >/dev/null 2>&1
out="$(_route "zzzquux flibbertigibbet")" >/dev/null 2>&1
out="$(_route "zzzquux wobblethorpe")"    >/dev/null 2>&1
grep -q '	-	' "$RLOG" 2>/dev/null && ok "misses are logged too" || bad "misses are logged too"


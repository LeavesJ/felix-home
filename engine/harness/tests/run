. "$HERE/lib/discover.sh"
. "$HERE/lib/engine-manifest.sh"
. "$HERE/lib/felix-cost.sh"
. "$HERE/lib/felix-new-nocommission.sh"
. "$HERE/lib/fresh-repos.sh"
. "$HERE/lib/gate-repo.sh"
. "$HERE/lib/gate-workflow.sh"
. "$HERE/lib/gitproof.sh"
. "$HERE/lib/gov-names.sh"
. "$HERE/lib/hook-payload.sh"
. "$HERE/lib/install-fixture.sh"
. "$HERE/lib/inventory-blind-runs.sh"
. "$HERE/lib/inventory-blind.sh"
. "$HERE/lib/inventory-gizmo.sh"
. "$HERE/lib/inventory.sh"
. "$HERE/lib/judge-refs.sh"
. "$HERE/lib/land-on-green.sh"
. "$HERE/lib/locale-bash-collation.sh"
. "$HERE/lib/locale-bytes.sh"
. "$HERE/lib/lost-work.sh"
. "$HERE/lib/memory-guarded.sh"
. "$HERE/lib/merge.sh"
. "$HERE/lib/overnight.sh"
. "$HERE/lib/probes.sh"
. "$HERE/lib/qualify-controls.sh"
. "$HERE/lib/qualify-needs.sh"
. "$HERE/lib/qualify-sweep.sh"
. "$HERE/lib/reach.sh"
. "$HERE/lib/recon.sh"
. "$HERE/lib/router.sh"
. "$HERE/lib/stuck-pr.sh"
. "$HERE/lib/unborn-repo.sh"
. "$HERE/lib/unwritable.sh"
. "$HERE/lib/user-prompt-hook.sh"
. "$HERE/lib/widget-repo.sh"
# The lib files' variables are set here, once, by their _vars functions (part 0006).
if [ -d "$HERE/lib" ]; then
  _audit_vars; _audit_review_vars; _felix_cost_vars; _inventory_blind_runs_vars
  _inventory_blind_vars; _inventory_vars; _qualify_controls_vars; _qualify_needs_vars
fi
# The hand-over (contract D2, D7): part mode runs its members here and exits; a
# -j N run hands the parts to the runner and reads the part lines below as no-ops.
[ -z "${_pm1:-}" ] || _pm_start "$@"
[ -z "${_pm1:-}" ] || . "$HERE/parts/$_pm1"; [ -z "${_pm1:-}" ] || _pm_done "$_pm1"
[ -z "${_pm2:-}" ] || . "$HERE/parts/$_pm2"; [ -z "${_pm2:-}" ] || _pm_done "$_pm2"
[ -z "${_pm3:-}" ] || . "$HERE/parts/$_pm3"; [ -z "${_pm3:-}" ] || _pm_done "$_pm3"
[ -z "${_pm4:-}" ] || . "$HERE/parts/$_pm4"; [ -z "${_pm4:-}" ] || _pm_done "$_pm4"
[ -z "${_pm5:-}" ] || . "$HERE/parts/$_pm5"; [ -z "${_pm5:-}" ] || _pm_done "$_pm5"
[ -z "${_pm6:-}" ] || . "$HERE/parts/$_pm6"; [ -z "${_pm6:-}" ] || _pm_done "$_pm6"
[ -z "${_pm1:-}" ] || _pm_fin "$@"
[ -z "${_pm1:-}" ] || exit 3
[ "$_suite_jobs" -le 1 ] || _par_run
[ "$_suite_jobs" -le 1 ] || [ "${_par_done:-}" = 1 ] || exit 1
[ "$_suite_jobs" -le 1 ] || { shopt -s expand_aliases; alias .=:; }
. "$HERE/parts/0010-resolution.sh"
. "$HERE/parts/0020-adopting-over-a-capabilities-entry-that-is-n.sh"
. "$HERE/parts/0030-appends-onto-a-hand-written-last-line.sh"

is  "a check that does not parse is held, not unknown"                "$(_cmwcst "$_cmwcrun" cmwc_c_parse)"  "held"
is  "a check that writes returned to its descriptors 1 to 9 and exits 1 is held" "$(_cmwcst "$_cmwcrun" cmwc_c_fake)" "held"

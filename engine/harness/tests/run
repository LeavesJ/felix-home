# The hook is handed the whole payload, so the envelope's own field names are in
# the token stream. A route keyed on one of them scored on every single turn
# whatever was typed, which is invisible until a project's subject matter
# happens to be prompts. Found by running the hook against a real repository.
cat >> "$FROOT/projects/widget/routes.tsv" <<'EOF'
envelope	prompt session transcript permission	frontend	-
EOF
out="$(cd "$REPO" && printf '{"session_id":"s","prompt":"the migration schema needs an index"}' | "$FROOT/harness/hooks/user-prompt" 2>&1)"
case "$out" in
  *envelope*) bad "the payload envelope does not decide the route" "$out" ;;
  *) ok "the payload envelope does not decide the route" ;;
esac
# ...but the words themselves must survive. Banning them was the first fix and
# was worse than the bug: asking about a hook matched nothing at all, because
# the word had been blacklisted to silence a field name of the same name.
toks="$( . "$FROOT/harness/lib/route.sh"
         felix_route_tokens '{"session_id":"s","prompt":"the stop hook is blocking"}' | tr '\n' ' ' )"
has  "a word shared with a field name still counts" "$toks" "hook"
case "$toks" in
  *session_id*|*" session "*) bad "but the field names themselves are gone" "$toks" ;;
  *) ok "but the field names themselves are gone" ;;
esac

# The keys were the half that got fixed. The VALUES are still in the stream, and
# they are worse: transcript_path and cwd carry the whole checkout path, so a
# home directory called Documents or a worktree branch named ...-review-... puts
# those words in as if they had been typed — at double weight, which is the
# score reserved for what you actually said. Found by watching `continue` route
# to a document skill.
out="$(cd "$REPO" && printf '{"session_id":"s","transcript_path":"/home/u/migration-schema-endpoint/a.jsonl","cwd":"/home/u/queue-worker","prompt":"the button layout is wrong"}' \
       | "$FROOT/harness/hooks/user-prompt" 2>&1)"
case "$out" in
  *backend*) bad "a path in the envelope does not decide the route" "$out" ;;
  *) ok "a path in the envelope does not decide the route" ;;
esac
# Asserted on tokens, not on the hook's output: the hook announces only when the
# route changes, so a presence check there passes or fails on prior state rather
# than on the thing being tested.
toks="$( . "$FROOT/harness/lib/route.sh"
         felix_route_tokens '{"transcript_path":"/home/u/migration-schema-endpoint/a.jsonl","prompt":"the button layout is wrong"}' | tr '\n' ' ' )"
has "and what was typed still counts" "$toks" "layout"
case "$toks" in
  *migration*|*endpoint*) bad "while the path around it does not" "$toks" ;;
  *) ok "while the path around it does not" ;;
esac

toks="$( . "$FROOT/harness/lib/route.sh"
         felix_route_tokens '{"transcript_path":"/home/u/documents-felix/a.jsonl","prompt":"continue"}' | tr '\n' ' ' )"
case "$toks" in
  *documents*|*jsonl*) bad "envelope path values are gone from the tokens" "$toks" ;;
  *) ok "envelope path values are gone from the tokens" ;;
esac
# Nobody typed a task notification. The hook is handed every UserPromptSubmit
# payload, and the runtime uses that channel for its own messages too — task
# completions, system reminders, the Stop hook's own feedback. Five of the 89
# rows in Felix's routes.log are machine text scored as if a person had written
# it, and they picked real routes: three `harness`, one `research`, one `gate`.
#
# Three consequences, and the third is a loop. The play announcement fires at
# text nobody wrote. The miss log accrues rows that skew `--promote`. And the
# Stop hook then asks why the named play went unused — a question generated by
# a route that fired on a machine's own message.
#
# Matched on STRUCTURE, never on vocabulary. `<task-notification>` at the start
# of the payload is a tag no sentence opens with; the word "notification" is one
# people type, and this project has already broken a word once by banning it to
# silence a field name. Only the literal opening marker counts.
_mach() { ( . "$FROOT/harness/lib/route.sh"; felix_route_is_machine "$1" ) && printf yes || printf no; }
is "a task notification is not a prompt"  "$(_mach '<task-notification><task-id>x</task-id></task-notification>')" "yes"
is "nor is a system reminder"             "$(_mach '<system-reminder>the gate has not run</system-reminder>')"      "yes"
is "nor the stop hook talking to itself"  "$(_mach 'Stop hook feedback:
The gate last ran at ...')"                                                                                          "yes"
is "nor the all-caps sentinel"            "$(_mach '[SYSTEM NOTIFICATION - NOT USER INPUT] a background task ended')" "yes"
# The word, as opposed to the tag, belongs to whoever typed it.
is "but asking about a notification is a prompt" \
   "$(_mach 'why did the task-notification route to harness?')" "no"
is "and so is ordinary work"              "$(_mach 'fix the queue worker')" "no"
is "an empty payload is not machine text" "$(_mach '')" "no"

# The hook holds the whole envelope, so the two compose. Extraction takes the
# FIRST copy of the key: `s/.*"prompt"/` would bind to the last, and a later copy
# in the envelope being read in preference to the real one is already a lesson
# in this repository.
_pv() { ( . "$FROOT/harness/lib/route.sh"; felix_route_prompt "$1" ); }
case "$(_pv '{"session_id":"s","prompt":"<task-notification>done</task-notification>"}')" in
  '<task-notification>'*) ok  "the prompt is read out of the envelope" ;;
  *)                      bad "the prompt is read out of the envelope" "$(_pv '{"prompt":"<task-notification>x"}')" ;;
esac
case "$(_pv '{"prompt":"fix the queue","extra":"prompt: not this one"}')" in
  'fix the queue'*) ok  "and from the first copy of the key, not a later one" ;;
  *)                bad "and from the first copy of the key, not a later one" ;;
esac
_mp() { ( . "$FROOT/harness/lib/route.sh"
          felix_route_is_machine "$(felix_route_prompt "$1")" ) && printf yes || printf no; }
is "a notification payload is machine text end to end" \
   "$(_mp '{"session_id":"s","prompt":"<task-notification>done</task-notification>"}')" "yes"
is "and a real one still routes" \
   "$(_mp '{"session_id":"s","prompt":"fix the queue worker"}')" "no"

# A path the person actually typed is theirs, and must still route.
toks="$( . "$FROOT/harness/lib/route.sh"
         felix_route_tokens '{"prompt":"fix src/queue/worker.py"}' | tr '\n' ' ' )"
has "a path you typed yourself still counts" "$toks" "worker"

# Whether Stop should stay quiet, as a predicate rather than hook-internal logic.
# The first version of this test drove the whole Stop hook through a fixture
# whose transcript path was empty, so the complaint fired in neither direction
# and "it stays quiet on a guess" passed by finding nothing — the vacuous-check
# shape this session has now hit three times.
SG="$TMP/routestate"; mkdir -p "$SG"
_guessed() { printf '%s' "$2" > "$SG/s"; ( . "$FROOT/harness/lib/route.sh"
            felix_route_state_guessed "$SG/s" ) && printf yes || printf no; }
is "a route off the tree is a guess"        "$(_guessed x "$(printf 'harness:done\ttree')")"   "yes"
is "one from what you typed is not"         "$(_guessed x "$(printf 'harness:done\tprompt')")" "no"
is "nor is one from both"                   "$(_guessed x "$(printf 'harness:done\tmixed')")"  "no"
is "a state file from before this existed complains, as it did" \
   "$(_guessed x 'harness:done')" "no"
# The shape production actually emits. A due step is a play entry, so it carries
# a colon of its own — and the colon scheme this replaced read "brainstorming"
# as the provenance and never matched anything. Every fixture above uses a due
# step of `done`, which is why they all passed while the real value did not.
is "a due step containing a colon does not shift it" \
   "$(_guessed x "$(printf 'harness:superpowers:brainstorming\ttree')")" "yes"
rm -f "$SG/s"
( . "$FROOT/harness/lib/route.sh"; felix_route_state_guessed "$SG/s" ) \
  && bad "a missing state file is not a guess" || ok "a missing state file is not a guess"

# The check that decides whether Felix speaks at all, and it had no test.
#
# `felix_route_step_used` greps "attributionSkill":"$owner with the closing quote
# missing, so it is a prefix match on the plugin. Any one skill from a plugin
# therefore satisfies every step that plugin owns. superpowers ships
# `using-superpowers`, whose own description tells a session to invoke it before
# anything else, and 16 of the 23 capability slots in Felix's own table are
# superpowers:*. So from turn one of nearly every session felix_route_due found
# every step already used and rendered no requirement — while
# felix_ledger_note_named appended the play as `named` regardless. 152 namings
# recorded on disk against 37 a session was ever shown.
#
# That is not a cosmetic bug: it is the instrument. Every follow-through figure
# this project has quoted about sessions ignoring Felix was computed against a
# denominator that counts suggestions nobody was given.
# The fixture carries BOTH attribution keys, because production writes both on
# one line — 1483 such lines for using-superpowers alone. A fixture with only
# attributionSkill passes against a fix that repairs that line and leaves the
# attributionPlugin line, which is correctly quoted and just as wrong: it asks
# whether the PLUGIN ran, not whether the STEP did. `"attributionPlugin":
# "superpowers"` occurs 7137 times. That fix would have shipped green and
# changed nothing, which is the shape this project keeps re-finding.
SU="$TMP/stepused"; mkdir -p "$SU"
_su_line() { printf '{"attributionSkill":"%s","attributionPlugin":"%s","type":"assistant"}\n' "$1" "${1%%:*}"; }
_su_line superpowers:using-superpowers > "$SU/t.jsonl"
for _s in superpowers:brainstorming superpowers:writing-plans superpowers:test-driven-development; do
  ( . "$FROOT/harness/lib/route.sh"; felix_route_step_used "$SU/t.jsonl" "$_s" ) \
    && bad "one superpowers skill does not mark $_s used" "reported used" \
    || ok  "one superpowers skill does not mark $_s used"
done
# The other direction, or the fix silences every play forever instead of always.
_su_line superpowers:brainstorming > "$SU/t.jsonl"
( . "$FROOT/harness/lib/route.sh"; felix_route_step_used "$SU/t.jsonl" "superpowers:brainstorming" ) \
  && ok  "the step itself still counts as used" \
  || bad "the step itself still counts as used" "not detected"
# A bare plugin name is the case the owner line exists for: any skill it ships
# counts, because there is no qualified step to match exactly.
_su_line code-review:review-changes > "$SU/t.jsonl"
( . "$FROOT/harness/lib/route.sh"; felix_route_step_used "$SU/t.jsonl" "code-review" ) \
  && ok  "a bare plugin step is used when one of its skills ran" \
  || bad "a bare plugin step is used when one of its skills ran" "not detected"
# The MCP probe is an owner-level answer too, and the first version of this fix
# gated the other two and left it outside — the same defect, surviving in the
# one branch no assertion reached. A plugin that ships an MCP server shows up
# only as a tool name, so the signal is real, but it says the PLUGIN was used
# and can never say which skill was.
printf '{"name":"mcp__plugin_semgrep_guardian__get_semgrep_sast_findings"}\n' > "$SU/t.jsonl"
( . "$FROOT/harness/lib/route.sh"; felix_route_step_used "$SU/t.jsonl" "semgrep:some-skill" ) \
  && bad "an mcp call does not mark a qualified step of that plugin used" "reported used" \
  || ok  "an mcp call does not mark a qualified step of that plugin used"
( . "$FROOT/harness/lib/route.sh"; felix_route_step_used "$SU/t.jsonl" "semgrep" ) \
  && ok  "an mcp call does mark the bare plugin step used" \
  || bad "an mcp call does mark the bare plugin step used" "not detected"
rm -rf "$SU"

# A route must match its own name, and three did not.
#
# `debug` named systematic-debugging and did not have the word "debug" among its
# keywords, so "debug why the harness hook is failing" scored the harness row
# instead and was told to go and brainstorm. `ship` and `tooling` were the same
# shape. This is not a guess about vocabulary — it is the one keyword a row is
# guaranteed to want, and it is checkable, so it is checked against the shipped
# table rather than a fixture.
REALT="$(cd "$REAL_HARNESS/../.." && pwd)/projects/felix/routes.tsv"
if [ -f "$REALT" ]; then
  selfmiss="$(awk -F'\t' '!/^#/ && NF>=2 {
      n=$1; split($2,a," "); found=0
      for (i in a) if (index(n,a[i])==1) found=1
      if (!found) printf "%s ", n
    }' "$REALT")"
  is "every route matches its own name" "$(printf '%s' "$selfmiss" | tr -d ' ')" ""
fi

# #57, confirmed item 3, and the same argument as the route check above: it is
# checkable against the shipped table, so it is checked there.
#
# An evidence rule whose `requires` matches everything can only ever report
# `met`. felix_evidence_check evaluates `requires` only after `when` has
# matched, and `when` matching means the path list is non-empty — so a `requires`
# of `.` is satisfied by the very paths that triggered the rule. The deploy row
# was exactly that, on the one act that puts an engine into every session on the
# machine.
REALE="$(cd "$REAL_HARNESS/../.." && pwd)/projects/felix/evidence.tsv"
if [ -f "$REALE" ]; then
  wild="$(awk -F'\t' '!/^#/ && NF>=3 && ($3=="." || $3==".*" || $3=="^.*$") {printf "%s ", $1}' "$REALE")"
  is "no evidence rule requires a pattern that matches everything" \
     "$(printf '%s' "$wild" | tr -d ' ')" ""
else
  skip "no evidence rule requires a pattern that matches everything" "no shipped table"
fi

# The log and the router had drifted apart, and only the log was ever read back.
# `felix_route_log` stripped the pairs the runtime owns and not the JSON keys, so
# every miss recorded the literal words `prompt` and `prompt_id`. They were the
# top two rows of `felix route --promote` — the one mechanism for improving the
# table — above every word anybody typed. The router had been right the whole
# time; the record of what it saw was not. Two tokenisers with one job is the
# defect, so promote reads the router's.
#
# The fix is on the READ side, and the first version of it was not. Stripping the
# keys on the way into the log as well broke `felix monitor`, whose route panel
# extracts the sentence by looking for the literal `"prompt":` key — with it
# gone the parser falls through and every new row renders as
# `{ , "repair the queue worker"}` instead of the sentence. The log is a record
# for a person to read; promote's requirement is satisfied entirely by
# `_felix_route_words` on the way out, which also cleans rows written before any
# of this. Asserted on both sides now, because asserting on one is what broke
# the other.
RLP="$TMP/routelog"; mkdir -p "$RLP" "$MEM/routelog"
( . "$FROOT/harness/lib/route.sh"
  felix_route_log "$RLP" "-" 0 '{"session_id":"s","transcript_path":"/home/u/migration-endpoint/a.jsonl","prompt_id":"9f2","prompt":"repair the queue worker"}' )
logged="$(cut -f4 "$MEM/routelog/routes.log")"
has "what a miss records is what was typed" "$logged" "queue"
case "$logged" in
  *session_id*|*migration*) bad "and not the pairs the runtime owns" "$logged" ;;
  *)                        ok  "and not the pairs the runtime owns" ;;
esac
rendered="$( . "$FROOT/harness/lib/monitor.sh"; _felix_mon_prompt "$logged" )"
is "and the monitor still renders the sentence, not the JSON around it" \
   "$rendered" "repair the queue worker"

# Promote then counts those, through the same filter that scored them. A word the
# router discards can never be a word the table is missing.
i=0; while [ "$i" -lt 3 ]; do
  ( . "$FROOT/harness/lib/route.sh"
    felix_route_log "$RLP" "-" 0 '{"prompt_id":"9f2","prompt":"repair the queue worker that would help"}' )
  i=$((i+1))
done
p="$( . "$FROOT/harness/lib/route.sh"; FELIX_ROUTE_PROMOTE_MIN=2 felix_route_promote "$RLP" )"
has "a real word rises" "$p" "queue"
case "$p" in
  *prompt*) bad "an envelope field name never does" "$p" ;;
  *)        ok  "an envelope field name never does" ;;
esac
case "$p" in
  *would*|*help*) bad "nor filler the router already discards" "$p" ;;
  *)              ok  "nor filler the router already discards" ;;
esac

# A row can end mid-character. `cut -c1-160` is byte-oriented wherever the hook
# actually runs — LANG is unset in that environment and LC_CTYPE is C — so when
# byte 160 lands inside a multibyte character the log keeps half of it. Reading
# that back through `sed -E` in the UTF-8 locale a Terminal has raises
# "illegal byte sequence"; under `set -o pipefail` the whole pipeline returns 1,
# promote returns nothing, and the caller printed "Nothing has missed often
# enough to be worth a row yet." A crash reported as an all-clear, in the report
# that exists to find what the routing table is missing — and worse in the
# middle of a log, where the rows after the bad one vanish with no cue at all.
#
# Two independent defects, so two assertions: the pipeline must not care, and
# the caller must not read emptiness as success.
BADL="$TMP/badlocale"; mkdir -p "$BADL" "$MEM/badlocale"
{ printf '2026-08-13T00:00:00Z\t-\t0\t{ ,"prompt":"repair the queue worker"}\n'
  printf '2026-08-13T00:00:01Z\t-\t0\t{ ,"prompt":"repair the queue worker"}\n'
  printf '2026-08-13T00:00:02Z\t-\t0\t{ ,"prompt":"stalled deploy \xe2\x80"}\n'
  printf '2026-08-13T00:00:03Z\t-\t0\t{ ,"prompt":"repair the queue worker"}\n'
} > "$MEM/badlocale/routes.log"
bp="$( . "$FROOT/harness/lib/route.sh"
       export LC_ALL=en_US.UTF-8
       FELIX_ROUTE_PROMOTE_MIN=3 felix_route_promote "$BADL" 2>/dev/null )" && brc=0 || brc=$?
is  "a half-written character does not fail the whole report" "$brc" "0"
has "and the rows on both sides of it are still counted"      "$bp"  "queue"

# The tree may corroborate, never outvote. Without a cap, a checkout carrying a
# few hundred untracked path tokens drowns out the four words you typed.
mkdir -p "$REPO/noise"
i=0; while [ "$i" -lt 40 ]; do printf 'x\n' > "$REPO/noise/component-layout-styling-$i.css"; i=$((i+1)); done
out="$(_route "add a migration for the endpoint schema")"
has "a wall of tree tokens cannot outvote the prompt" "$out" "backend"
rm -rf "$REPO/noise"

RHK="$FROOT/harness/hooks/user-prompt"
S1='{"session_id":"sess-aaa","prompt":"let us build the results page"}'
S2='{"session_id":"sess-aaa","prompt":"let us build the results page again"}'
S3='{"session_id":"sess-aaa","prompt":"add a migration for the endpoint schema"}'
_hook() { ( cd "$REPO" && printf '%s' "$1" | "$RHK" 2>&1 ); }
_ctx() { printf '%s' "$1" | python3 -c 'import json,sys;print(json.load(sys.stdin)["hookSpecificOutput"]["additionalContext"])' 2>/dev/null; }

rm -rf "$FROOT/state/route"
out="$(_hook "$S1")"; ctx="$(_ctx "$out")"
has "the hook routes on the first prompt" "$ctx" "frontend"
# One block, not two. Two injections fight for the same attention.
n="$(printf '%s' "$out" | grep -c 'hookSpecificOutput')"
is "route and lessons arrive as one block" "$n" "1"

# A prompt where both genuinely apply. Two injections competing for the same
# attention is how both get skimmed, so they must arrive as one.
rm -rf "$FROOT/state/route"
out="$(_hook '{"session_id":"sess-bbb","prompt":"add a migration for the endpoint schema rollback"}')"
ctx="$(_ctx "$out")"
has "the route is there when both apply" "$ctx" "backend"
has "and the lesson is in the same block" "$ctx" "L-1"
n="$(printf '%s' "$out" | grep -c 'hookSpecificOutput')"
is "still exactly one block"              "$n" "1"
rm -rf "$FROOT/state/route"
out="$(_hook "$S1")" >/dev/null 2>&1

out="$(_hook "$S2")"; ctx="$(_ctx "$out")"
case "$ctx" in
  *"routed this to"*) bad "the same route does not repeat itself" "$ctx" ;;
  *) ok "the same route does not repeat itself" ;;
esac

# Decision A-prime, approved 2026-08-30, reverses the assertion that stood
# here ("a change of route speaks again"). A mid-session keyword re-route was
# every live misroute on #29 — five causes, ~2% precision — so it is logged
# and recorded in state, and NOT rendered. The declaration moment (first
# routed turn) and transcript-proven step advances are the moments that speak;
# both are asserted elsewhere in this file and unchanged.
out="$(_hook "$S3")"; ctx="$(_ctx "$out")"
case "$ctx" in
  *"routed this to"*) bad "a mid-session route change does not render" "$ctx" ;;
  *) ok "a mid-session route change does not render" ;;
esac
has "but it is logged, so the pivot stays observable" \
    "$(tail -1 "$MEM/widget/routes.log" 2>/dev/null)" "backend"
is  "and the state now carries the new route, for the finish-line judge" \
    "$(cut -f1 < "$FROOT/state/route/sess-aaa" 2>/dev/null | cut -d: -f1)" "backend"

# A guessed route and an ignored instruction are different facts, and the state
# file threw the difference away.
#
# `felix route` already says which it is — "read off the working tree, not the
# prompt: nothing you typed named a kind of work" — from the prompt-contributed
# half of the score. The state written for `Stop` recorded only route and due
# step, so `Stop` ended sessions complaining that a play went unused whether the
# route came from what somebody typed or from what happened to be checked out.
# It fired five times in one session, at least three of them on open guesses.
#
# Provenance is stored as a word rather than the score it came from. The score
# is an implementation detail of today's ranking function; what the contract
# needs to survive a re-weighting is whether the obligation was grounded in
# intent at all.
rm -rf "$FROOT/state/route"
_hook '{"session_id":"prov-p","prompt":"let us build the results page"}' >/dev/null 2>&1
is "a route from what you typed is recorded as such" \
   "$(cut -f2 < "$FROOT/state/route/prov-p" 2>/dev/null)" "prompt"

# Nothing routable typed, so whatever it picked came off the tree.
rm -rf "$FROOT/state/route"
_hook '{"session_id":"prov-t","prompt":"ok"}' >/dev/null 2>&1
if [ -f "$FROOT/state/route/prov-t" ]; then
  case "$(cut -f2 < "$FROOT/state/route/prov-t")" in
    tree|mixed) ok  "a route off the tree is not recorded as typed" ;;
    *)          bad "a route off the tree is not recorded as typed" \
                    "$(cat "$FROOT/state/route/prov-t")" ;;
  esac
else
  ok "a route off the tree is not recorded as typed"
fi

# Dedup must ignore it. The state value is also the announce key, so a third
# field that varies would make a route re-announce itself with nothing changed —
# which is the noise this exists to remove, reintroduced one field along.
rm -rf "$FROOT/state/route"
_hook "$S1" >/dev/null 2>&1
# The same prompt twice, with only the third field altered in between, so
# provenance is the single variable. Planting a route name here instead would
# have tested whatever that fixture happens to route to.
k="$(cut -f1 < "$FROOT/state/route/sess-aaa" 2>/dev/null)"
printf '%s\ttree' "$k" > "$FROOT/state/route/sess-aaa"
out="$(_hook "$S1")"; ctx="$(_ctx "$out")"
case "$ctx" in
  *"routed this to"*) bad "provenance is not part of the announce key" "$ctx" ;;
  *)                  ok  "provenance is not part of the announce key" ;;
esac

# State is a convenience. Losing it must cost a repeated block, never a session.
chmod 000 "$FROOT/state/route" 2>/dev/null
out="$(cd "$REPO" && printf '%s' "$S1" | "$RHK" 2>&1)"; rc=$?
is "an unwritable state directory still exits 0" "$rc" "0"
chmod 755 "$FROOT/state/route" 2>/dev/null

RLOG="$MEM/widget/routes.log"
[ -s "$RLOG" ] && ok "every decision is logged" || bad "every decision is logged" "no $RLOG"
grep -q 'frontend' "$RLOG" 2>/dev/null && ok "hits are logged" || bad "hits are logged"
out="$(_route "zzzquux flibbertigibbet")" >/dev/null 2>&1
out="$(_route "zzzquux flibbertigibbet")" >/dev/null 2>&1
out="$(_route "zzzquux wobblethorpe")"    >/dev/null 2>&1
grep -q '	-	' "$RLOG" 2>/dev/null && ok "misses are logged too" || bad "misses are logged too"

out="$(cd "$REPO" && "$FELIX" route --promote 2>&1)"
has "promote surfaces a word that keeps missing" "$out" "zzzquux"

out="$(cd "$PLAIN" && "$FELIX" route --for "build the results page" 2>&1)"; rc=$?
[ "$rc" -ne 0 ] && ok "route refuses outside a governed repo" \
                || bad "route refuses outside a governed repo" "$out"

# `felix install` tells you to put the CLI on PATH with a symlink. Following
# that instruction resolved SCRIPT_DIR to the directory the link sits in, so
# every library source missed and the command died on its first line. The
# documented way to make Felix convenient was the one way to break it.
printf '\non PATH via a symlink\n'
mkdir -p "$TMP/bin"
ln -sf "$FELIX" "$TMP/bin/felix"
out="$(cd "$REPO" && "$TMP/bin/felix" which 2>&1)"
has "resolves its libraries through a symlink" "$out" "project:      widget"
out="$(cd "$REPO" && "$TMP/bin/felix" gate 2>&1)"; rc=$?
is "and the gate still runs through it" "$rc" "0"

printf '\njust in time, not all at once\n'
# Naming a whole play at the first prompt tells an agent to critique and
# browser-test something that does not exist yet, and spends context saying so.
# A play is a sequence: only the step that is actually due gets named.
TR="$TMP/transcript.jsonl"
: > "$TR"
J1="{\"session_id\":\"jit-1\",\"transcript_path\":\"$TR\",\"prompt\":\"the results page layout needs work\"}"
rm -rf "$FROOT/state/route"
out="$(cd "$REPO" && printf '%s' "$J1" | "$RHK" 2>&1)"; ctx="$(_ctx "$out")"
has "names the first step"        "$ctx" "frontend-design"
case "$ctx" in
  *"Use this now: impeccable"*) bad "does not demand the later steps yet" "$ctx" ;;
  *) ok "does not demand the later steps yet" ;;
esac
has "but says what may come later" "$ctx" "Later, only if"

# The mandate speaks with the channel's measured accuracy, not past it. The
# old paragraph opened "This is a requirement, not a suggestion" — language
# for a channel that is nearly always right, on one measured at 2 of 11
# mandates followed and five recorded failure causes (#29). A maximal claim
# from a low-precision source teaches sessions to skim the channel.
case "$ctx" in
  *"requirement, not a suggestion"*) bad "the mandate does not claim more precision than measured" "$ctx" ;;
  *) ok "the mandate does not claim more precision than measured" ;;
esac
# And it carries its own answer channel, so a wrong route becomes a labeled
# example instead of a silent skip.
has "and names the decline channel" "$ctx" "felix route --ack"

# Once the transcript shows step one was used, step two becomes the due one.
printf '{"type":"assistant","attributionSkill":"frontend-design:frontend-design"}\n' >> "$TR"
J2="{\"session_id\":\"jit-1\",\"transcript_path\":\"$TR\",\"prompt\":\"the results page layout still needs work\"}"
out="$(cd "$REPO" && printf '%s' "$J2" | "$RHK" 2>&1)"; ctx="$(_ctx "$out")"
has "advances to the next step once the first is used" "$ctx" "Use this now: impeccable"

# A plugin that ships an MCP server is used by calling its tools, not a skill.
printf '{"type":"assistant","attributionSkill":"impeccable"}\n' >> "$TR"
printf '{"name":"mcp__plugin_playwright_playwright__browser_navigate"}\n' >> "$TR"
out="$(cd "$REPO" && printf '%s' "$J2" | "$RHK" 2>&1)"; ctx="$(_ctx "$out")"
case "$ctx" in
  *"Use this now:"*) bad "stops naming tools once the play is done" "$ctx" ;;
  *) ok "stops naming tools once the play is done" ;;
esac

# And at the finish line, a step the session never used is worth one sentence.
: > "$TR"
printf 'edit\n' >> "$REPO/WIDGET.txt"
( cd "$REPO" && "$FELIX" gate >/dev/null 2>&1 )
mkdir -p "$FROOT/state/route"; printf 'frontend:frontend-design' > "$FROOT/state/route/jit-2"
SJ="{\"hook_event_name\":\"Stop\",\"stop_hook_active\":false,\"session_id\":\"jit-2\",\"transcript_path\":\"$TR\"}"
out="$(cd "$REPO" && printf '%s' "$SJ" | "$STOP" 2>&1)"
has "says what was skipped at the finish"  "$out" "never used"
case "$out" in
  *'"decision"'*'"block"'*) bad "but does not hold the session for it" "$out" ;;
  *) ok "but does not hold the session for it" ;;
esac

printf '\nthe finish-line message, and its answer channel\n'
# #98. Both interpolations in the old sentence were ${skipped}, so a
# three-step play with two steps followed was reported as though the route had
# asked only for the one that was missed — a partly-followed play rendered
# indistinguishable from a one-step play ignored outright, in the message that
# asks the reader to judge whether the skip was right. And nothing could
# answer it, so it fired identically at every close and got read as furniture.
#
# A play two-thirds followed, so the two facts come apart: the play is three
# names, the skip is one.
TR3="$TMP/transcript3.jsonl"; : > "$TR3"
printf '{"type":"assistant","attributionSkill":"frontend-design:frontend-design"}\n' >> "$TR3"
printf '{"type":"assistant","attributionSkill":"impeccable"}\n' >> "$TR3"
mkdir -p "$FROOT/state/route"; printf 'frontend:playwright' > "$FROOT/state/route/jit-3"
SJ3="{\"hook_event_name\":\"Stop\",\"stop_hook_active\":false,\"session_id\":\"jit-3\",\"transcript_path\":\"$TR3\"}"
out="$(cd "$REPO" && printf '%s' "$SJ3" | "$STOP" 2>&1)"
# The first slot names the PLAY — including a step that was followed — so the
# reader judges the skip against the sequence it came from. Reverse-locked:
# the old sentence put the skipped step in both slots, and `impeccable` was
# followed, so it could not appear.
has "the message names the play, not only the miss" "$out" "impeccable"
has "and still says which step went unused"         "$out" "never used"
has "and carries the decline channel"               "$out" "felix route --ack"

# Once per session. The second telling of an unanswered question is pressure.
out="$(cd "$REPO" && printf '%s' "$SJ3" | "$STOP" 2>&1)"
case "$out" in
  *"never used"*) bad "and it does not repeat within a session" "$out" ;;
  *) ok "and it does not repeat within a session" ;;
esac

# The answer channel, end to end: a recorded decline quiets the complaint and
# lands the reason where the table's next revision can read it. Recording
# only — the deliberation layer's gate in HANDOFF 0z stays closed; this is the
# instrumentation floor it names.
printf 'frontend:playwright' > "$FROOT/state/route/jit-4"
SJ4="{\"hook_event_name\":\"Stop\",\"stop_hook_active\":false,\"session_id\":\"jit-4\",\"transcript_path\":\"$TR3\"}"
out="$(cd "$REPO" && "$FELIX" route --ack "no browser surface in this change" 2>&1)"; rc=$?
is  "felix route --ack records without error" "$rc" "0"
has "and says it did"                         "$out" "on the record"
has "the reason is durable in decisions.log" \
    "$(tail -1 "$MEM/widget/decisions.log" 2>/dev/null)" "no browser surface in this change"
has "as a declined verdict"                   "$(tail -1 "$MEM/widget/decisions.log" 2>/dev/null)" "declined"
out="$(cd "$REPO" && printf '%s' "$SJ4" | "$STOP" 2>&1)"
case "$out" in
  *"never used"*) bad "a declined play is not raised at the finish" "$out" ;;
  *) ok "a declined play is not raised at the finish" ;;
esac
# Consumed, not standing: one decline answers one complaint. A permanent ack
# would be a mute button on the only compliance signal there is.
[ -f "$FROOT/state/route/ack-$(printf '%s' "$(cd "$REPO" && pwd -P)" | git hash-object --stdin)" ] \
  && bad "and the ack is consumed by the answer" "ack file still present" \
  || ok  "and the ack is consumed by the answer"

# The tracker Decision B is judged from. Recording that cannot be read is
# recording that gets lost in a build week, and the 20-session review needs
# these numbers legible on demand, not reconstructed.
out="$(cd "$REPO" && "$FELIX" decisions 2>&1)"; rc=$?
is  "felix decisions reads the record"        "$rc" "0"
has "and counts the recorded decline"         "$out" "declined, on the record    1"
has "and shows the decline itself"            "$out" "no browser surface in this change"
has "and says it is recording only"           "$out" "Recording only"
# The answer-rate window opens when the channel shipped. Mandates rendered
# before felix route --ack existed could not have been answered, and a rate
# computed over them reports a failure nobody could avoid — the same shape as
# follow-through computed against suggestions nobody was shown.
out="$(cd "$REPO" && FELIX_DECISIONS_SINCE=9999-01-01 "$FELIX" decisions 2>&1)"
has "mandates are counted only inside the answerable window" \
    "$out" "mandates rendered          0"

( cd "$REPO" && git checkout -q -- WIDGET.txt 2>/dev/null || printf 'contents\n' > "$REPO/WIDGET.txt" )

printf '\nvisible at all\n'
# Felix ships no skills and no commands and costs a session nothing, which is
# the point and also why somebody looked for it, found nothing anywhere, and
# reasonably concluded it was not installed. additionalContext reaches the
# model; systemMessage reaches the person.
out="$(cd "$REPO" && CLAUDE_PLUGIN_ROOT="$FROOT" "$FROOT/harness/hooks/session-start" 2>&1)"
case "$out" in
  *'"systemMessage"'*) ok "says something to the founder, not only the model" ;;
  *) bad "says something to the founder, not only the model" "$out" ;;
esac
line="$(printf '%s' "$out" | python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("systemMessage",""))
except Exception: print("")' 2>/dev/null)"
has "and names the project"  "$line" "widget"
# One line. A briefing repeated every session is one people stop reading.
n="$(printf '%s' "$line" | wc -l | tr -d ' ')"
[ "${n:-0}" -le 1 ] && ok "and stays to one line" || bad "and stays to one line" "$line"
# The model still gets the full briefing.
case "$out" in *'"additionalContext"'*) ok "the model still gets the whole thing" ;;
  *) bad "the model still gets the whole thing" "$out" ;; esac

# The one entry point, for somebody who has never seen Felix.
[ -f "$FROOT/../engine/commands/felix.md" ] || [ -f "$REAL_HARNESS/../commands/felix.md" ] \
  && ok "ships a slash command to be found by" \
  || bad "ships a slash command to be found by" "no commands/felix.md"

printf '\na failure nobody wrote down\n'
# Felix has had `felix lesson` from the beginning, and a mechanism nobody uses
# is half a mechanism. This fires only when the gate actually caught something
# and nothing was written since — most sessions teach nothing, and a prompt
# that fires every time is one people learn to dismiss.
GP="$FROOT/projects/guarded"; mkdir -p "$GP" "$MEM/guarded"
: > "$MEM/guarded/lessons.md"; : > "$MEM/guarded/DEVLOG.md"
out="$( . "$FROOT/harness/lib/guard.sh"; felix_guard_unrecorded "$GP" )"
is "silent when the gate has caught nothing" "${#out}" "0"

# `felix_guard_unrecorded` asks whether the catch is newer than the lesson, so
# these two files must have an order and not merely a sequence of writes. They
# were written milliseconds apart and the assertion relied on the filesystem
# resolving that — true on a laptop, and on the CI runner a coin toss that both
# assertions lost the moment anything upstream shifted the timing. Adding tests
# elsewhere in this file turned it red. The `sleep 1` below was the same problem
# noticed once and paid for in wall-clock rather than fixed.
#
# So the order is stated. Every case sets the mtimes it depends on, which also
# means the run is a second faster and neither case can be won by luck.
GYDAY="$(date -v-1d +%Y%m%d%H%M 2>/dev/null || date -d '1 day ago' +%Y%m%d%H%M)"
printf '2026-01-01\tmain\tabc123\tlint\n' > "$MEM/guarded/mistakes.log"
touch -t "$GYDAY" "$MEM/guarded/lessons.md" "$MEM/guarded/DEVLOG.md" 2>/dev/null
# Asserted here, where the ordering is load-bearing. This is the case that went
# red on CI, and the guard reads exactly this comparison. The first version of
# this assertion sat after the *second* case, where the ordering is reversed and
# the fixture sets it explicitly anyway — so it guarded the mtime that never
# mattered, and deleting the touch that did would have left the suite green.
[ -n "$(find "$MEM/guarded/mistakes.log" -newer "$MEM/guarded/lessons.md" 2>/dev/null)" ] \
  && ok  "the fixture puts the catch after the lesson" \
  || bad "the fixture puts the catch after the lesson" "lesson is not older than the catch"
out="$( . "$FROOT/harness/lib/guard.sh"; felix_guard_unrecorded "$GP" )"
has "speaks when a catch went unexplained" "$out" "nothing has been written down"
has "and names what was caught"            "$out" "lint"

# Writing a lesson settles the debt; it must then go quiet. The catch is aged a
# day rather than the lesson being written a second later: still well inside the
# seven days that keep it from being ancient history, and no longer a race.
printf -- '- **something learned**\n' > "$MEM/guarded/lessons.md"
touch -t "$GYDAY" "$MEM/guarded/mistakes.log" 2>/dev/null
out="$( . "$FROOT/harness/lib/guard.sh"; felix_guard_unrecorded "$GP" )"
is "and stops once something is written" "${#out}" "0"

# A devlog entry settles the debt too, and that half had no coverage at all: the
# fixture left DEVLOG.md empty, the guard skips the clause unless the file is
# non-empty, so the entire branch could be deleted with the suite still green.
# Both directions asserted, or the quiet one proves nothing.
printf '2026-01-01\tmain\tabc123\tlint\n' > "$MEM/guarded/mistakes.log"
touch -t "$GYDAY" "$MEM/guarded/lessons.md" 2>/dev/null
printf '## 2026-01-01 what happened and why\n' > "$MEM/guarded/DEVLOG.md"
out="$( . "$FROOT/harness/lib/guard.sh"; felix_guard_unrecorded "$GP" )"
is "a devlog entry newer than the catch settles it too" "${#out}" "0"
touch -t "$GYDAY" "$MEM/guarded/DEVLOG.md" 2>/dev/null
out="$( . "$FROOT/harness/lib/guard.sh"; felix_guard_unrecorded "$GP" )"
has "and an older one does not" "$out" "nothing has been written down"

# An old debt is history, not something this session can explain.
printf '2020-01-01\tmain\tabc\told\n' > "$MEM/guarded/mistakes.log"
touch -t 202001010000 "$MEM/guarded/mistakes.log" 2>/dev/null
out="$( . "$FROOT/harness/lib/guard.sh"; felix_guard_unrecorded "$GP" )"
is "and does not nag about ancient history" "${#out}" "0"
rm -rf "$GP"

printf '\nnoticing when another plugin breaks the session\n'
# A plugin that ships hooks is a dependency on that plugin working. When one
# refuses, the error lands on the tool rather than on the plugin that caused
# it, so it reads as the editor being broken. Claude Code records these
# properly, which is what makes noticing them cheap.
GT="$TMP/guard.jsonl"
cat > "$GT" <<'JSONL'
{"type":"attachment","attachment":{"type":"hook_blocking_error","hookName":"PostToolUse:Write","hookEvent":"PostToolUse","blockingError":{"blockingError":"Not logged into Semgrep Guardian. Ask the guardian mcp to login.","command":"bash x"}}}
{"type":"attachment","attachment":{"type":"hook_blocking_error","hookName":"PostToolUse:Write","hookEvent":"PostToolUse","blockingError":{"blockingError":"Not logged into Semgrep Guardian. Ask the guardian mcp to login.","command":"bash x"}}}
{"type":"assistant","message":{"content":[]}}
JSONL
rows="$( . "$FROOT/harness/lib/guard.sh"; felix_guard_blocks "$GT" )"
has "counts what was blocked"     "$rows" "2"
has "and names the hook"          "$rows" "PostToolUse:Write"
has "and quotes what it said"     "$rows" "Not logged into Semgrep"
# A transcript with no blocks must say nothing at all.
printf '{"type":"assistant"}\n' > "$TMP/clean.jsonl"
q="$( . "$FROOT/harness/lib/guard.sh"; felix_guard_blocks "$TMP/clean.jsonl" )"
is "silent when nothing was blocked" "${#q}" "0"
# A missing transcript is a fact, not a crash.
q="$( . "$FROOT/harness/lib/guard.sh"; felix_guard_blocks "$TMP/nope.jsonl" )"; rc=$?
is "survives a transcript that is not there" "$rc" "0"

out="$(cd "$REPO" && "$FELIX" quarantine definitely-not-installed 2>&1)"; rc=$?
[ "$rc" -ne 0 ] && ok "quarantine refuses a plugin that is not here" \
                || bad "quarantine refuses a plugin that is not here" "$out"

# The report exists for ANOTHER plugin's hook, and it never checked. Felix's own
# Stop hook holds a chain until the gate has seen the tree — working exactly as
# designed — and that block came back to the founder under the headline "and it
# was not Felix", attributed to the felix plugin two lines below, with the
# remedy `felix quarantine felix`. A report that contradicts itself inside four
# lines and then recommends switching off the system that produced it. Observed
# live, not constructed: it fired twice in the session that fixed it.
_isown() { ( . "$FROOT/harness/lib/guard.sh"; . "$FROOT/harness/lib/ready.sh"
             felix_guard_is_own "$1" ) && printf yes || printf no; }
is "Felix's own gate refusal is recognised as its own" \
   "$(_isown 'The gate last ran at 2026-08-13T09:30:36Z, on a different tree. Run felix gate. Or set FELIX_ALLOW_RED=1.')" "yes"
is "and so is a deny from its own PreToolUse" \
   "$(_isown 'felix: this project forbids that command. See felix which.')" "yes"
is "another plugin's refusal is not"  \
   "$(_isown 'Not logged into Semgrep Guardian. Ask the guardian mcp to login.')" "no"
is "and neither is an empty message"  "$(_isown '')" "no"

printf '\ndiscovery runs on a cadence, not in front of a prompt\n'
DH="$TMP/dhome"; mkdir -p "$DH/state/discover"
DP="$FROOT/projects/widget"
# Never refreshed is stale; that is what makes the first run happen at all.
( . "$FROOT/harness/lib/discover.sh"; felix_discover_stale "$DP" "$DH" ) \
  && ok "a cache that never existed is stale" || bad "a cache that never existed is stale"
printf 'deepeval\tllm\tlow\nlangfuse\tllm\tlow\n' > "$DH/state/discover/widget.tsv"
( . "$FROOT/harness/lib/discover.sh"; felix_discover_stale "$DP" "$DH" ) \
  && bad "a fresh cache is not stale" || ok "a fresh cache is not stale"
new="$( . "$FROOT/harness/lib/discover.sh"; felix_discover_unseen "$DP" "$DH" | tr '\n' ' ' )"
has "reports findings the first time" "$new" "deepeval"
( . "$FROOT/harness/lib/discover.sh"; felix_discover_mark_seen "$DP" "$DH" )
new="$( . "$FROOT/harness/lib/discover.sh"; felix_discover_unseen "$DP" "$DH" )"
is "and never mentions the same one twice" "${#new}" "0"
# Something genuinely new must still get through.
printf 'sonarqube\tsecrets\thigh\n' >> "$DH/state/discover/widget.tsv"
new="$( . "$FROOT/harness/lib/discover.sh"; felix_discover_unseen "$DP" "$DH" | tr '\n' ' ' )"
has "but a new one does get through" "$new" "sonarqube"

printf '\ndiscovery reads before it recommends\n'
# The plugin format has no permission declaration and `claude plugin validate`
# checks schema only, so the only way to know what something does is to read it.
# Fixtures throughout: this must never touch the network to be tested.
DF="$TMP/discover-fixtures"
mkdir -p "$DF/skillsonly/skills/a" "$DF/hooky/hooks" "$DF/mcplocal" "$DF/floaty" "$DF/creds"
printf '{"mcpServers":{"x":{"command":"/usr/local/bin/x","args":["run"]}}}\n' > "$DF/mcplocal/.mcp.json"
printf '{"hooks":{"PreToolUse":[{"hooks":[{"command":"bash s.sh"}]}]}}\n'     > "$DF/hooky/hooks/hooks.json"
printf '{"mcpServers":{"x":{"command":"npx","args":["pkg@latest"]}}}\n'       > "$DF/floaty/.mcp.json"
printf '{"mcpServers":{"x":{"type":"http","url":"https://e.example","headers":{"Authorization":"${SECRET_TOKEN}"}}}}\n' > "$DF/creds/.mcp.json"

_tier() { ( . "$FROOT/harness/lib/discover.sh"
            felix_discover_risk "$(felix_discover_inspect "$1")" ); }
is "skills only is low"                  "$(_tier "$DF/skillsonly")" "low"
is "a pinned local server is medium"     "$(_tier "$DF/mcplocal")"   "medium"
is "anything shipping hooks is high"     "$(_tier "$DF/hooky")"      "high"
is "an unpinned version is high"         "$(_tier "$DF/floaty")"     "high"
is "interpolating a credential is high"  "$(_tier "$DF/creds")"      "high"

printf '\nmore than one session at a time\n'
# People keep several terminals open on one checkout, so every key Felix writes
# under has to survive that. Two of these are safe by construction and one was
# not.
#
# The one that was not: user-prompt falls back to a repo-derived session key
# when the payload carries no session_id, and `named` was hung on that variable
# because it was in scope. The fallback belongs to announce-on-change dedup,
# where a shared key costs one missed suggestion. For ledger data it is wrong
# twice over — post-tool and session-end both exit rather than invent a key, so
# the calls half would go to a real session while the named half went to a
# repo-shaped one that nothing ever rolls up. Concurrent sessions would then
# pile named rows into one file with no calls beside them, and a capability
# would read as "pointed at and ignored" on its way to being retired.
PROMPT='the build is broken and the stacktrace shows a crash on reproduce'
rm -rf "$FROOT/state/ledger"
( cd "$REPO" && printf '{"prompt":"%s"}' "$PROMPT" \
    | "$FROOT/harness/hooks/user-prompt" >/dev/null 2>&1 )
n="$(ls -1 "$FROOT/state/ledger" 2>/dev/null | wc -l | tr -d ' ')"
is "a prompt with no session id records no ledger state" "$n" "0"

( cd "$REPO" && printf '{"session_id":"real-sess","prompt":"%s"}' "$PROMPT" \
    | "$FROOT/harness/hooks/user-prompt" >/dev/null 2>&1 )
has "and one with a session id records under exactly that id" \
    "$(cat "$FROOT/state/ledger/real-sess.tsv" 2>/dev/null)" "named	superpowers:"
rm -rf "$FROOT/state/ledger"

# Safe by construction, asserted so it stays that way. A verdict is keyed on the
# tree, and the tree id covers every uncommitted byte — so a second session
# editing the same checkout cannot inherit the first one's review.
T1="$( . "$FROOT/harness/lib/verify.sh"; felix_tree_id "$REPO" "$FROOT" )"
printf 'a concurrent edit\n' > "$REPO/other-session.txt"
T2="$( . "$FROOT/harness/lib/verify.sh"; felix_tree_id "$REPO" "$FROOT" )"
[ "$T1" != "$T2" ] \
  && ok "another session's edit changes the tree identity" \
  || bad "another session's edit changes the tree identity" "both were $T1"
rm -f "$REPO/other-session.txt"

printf '\nthe ledger: recorded as it happens, never parsed after\n'
# The slice stayed unbuilt because its own spec contradicted itself: the body
# said transcript parsing breaks the bash-and-git invariant, and the Records
# section described a hook that parses a transcript. Recording needs no parser.
_sig() { ( . "$FROOT/harness/lib/ledger.sh"; felix_ledger_signal "$1" ); }
is "a plain tool is recorded by name" \
   "$(_sig '{"tool_name":"Bash"}')" "tool	Bash"
is "an mcp call is recorded by server" \
   "$(_sig '{"tool_name":"mcp__github__create_issue"}')" "mcp	github"
is "a skill is recorded by which skill" \
   "$(_sig '{"tool_name":"Skill","tool_input":{"skill":"superpowers:brainstorming"}}')" \
   "skill	superpowers:brainstorming"
is "an unparseable payload records nothing" "$(_sig 'not json')" ""

LH="$TMP/ledgerhome"; LP="$LH/projects/widgetledger"; mkdir -p "$LP" "$MEM/widgetledger"
printf 'plugin\tsuperpowers@x\t-\tlow\talways\nplugin\tplaywright@x\t-\tlow\te2e\n' > "$LP/stack.tsv"
( . "$FROOT/harness/lib/ledger.sh"
  felix_ledger_record "$LH" sess1 "tool	Bash"
  felix_ledger_record "$LH" sess1 "tool	Bash"
  felix_ledger_record "$LH" sess1 "skill	superpowers:brainstorming" )
n="$( . "$FROOT/harness/lib/ledger.sh"; wc -l < "$LH/state/ledger/sess1.tsv" | tr -d ' ' )"
is "every call is appended" "$n" "3"

( . "$FROOT/harness/lib/ledger.sh"; felix_ledger_rollup "$LP" "$LH" sess1 2026-08-11 )
led="$(cat "$MEM/widgetledger/ledger.d/sess1.tsv" 2>/dev/null)"
has "counts repeated calls once with a total" "$led" "tool	Bash	2"
has "and a skill that was invoked"            "$led" "skill	superpowers:brainstorming	1"
# The zero rows are the whole point. Presence without use is the only
# unconfounded signal in the design and it does not exist unless it is written.
has "writes a zero row for a declared tool nobody reached for" "$led" "playwright@x	0"
case "$led" in
  *"superpowers@x	0"*) bad "and no zero row for one that was used" "$led" ;;
  *)                     ok  "and no zero row for one that was used" ;;
esac
( . "$FROOT/harness/lib/ledger.sh"; felix_ledger_rollup "$LP" "$LH" sess1 2026-08-11 )
n="$(grep -c '^sess1' "$MEM/widgetledger/ledger.d/sess1.tsv")"
is "rolling the same session twice does not double it" "$n" "3"

printf '\na count that arrived as two lines\n'
# `grep -c` prints the count AND exits 1 when that count is zero, so the idiom
# `$(grep -c ... || echo 0)` yields "0\n0" on every miss — the count grep already
# printed, plus the fallback. Recorded as a trap in lessons.md and still live in
# eight places, four of them in the rollup: every ledger row for a capability no
# route named was followed by a stray `0` line. Measured on the real memory
# before the fix: 215 lone-zero lines out of 280, and `felix ledger` reporting 7
# sessions where there were 3, because a bare `0` reads as a session id.
LZ="$TMP/lz"; LZP="$LZ/projects/wlz"; mkdir -p "$LZP" "$MEM/wlz"
printf 'plugin\tsuperpowers@x\t-\tlow\talways\n' > "$LZP/stack.tsv"
( . "$FROOT/harness/lib/ledger.sh"
  felix_ledger_record "$LZ" z1 "tool\tBash"
  felix_ledger_rollup "$LZP" "$LZ" z1 2026-08-16 )
is "a row nobody named carries no stray line" \
   "$(awk -F'\t' 'NF < 5' "$MEM/wlz/ledger.d/z1.tsv" | wc -l | tr -d ' ')" "0"
is "and every line is a whole row" \
   "$(awk -F'\t' 'NF == 6' "$MEM/wlz/ledger.d/z1.tsv" | wc -l | tr -d ' ')" \
   "$(wc -l < "$MEM/wlz/ledger.d/z1.tsv" | tr -d ' ')"
is "so the session count is the number of sessions" \
   "$( . "$FROOT/harness/lib/ledger.sh"
       _felix_ledger_rows "$MEM/wlz" | cut -f1 | LC_ALL=C sort -u | grep -c . )" "1"

printf '\none rollup, one file\n'
# Issue #32, reproduced twice by a 15-agent concurrency audit and once more by
# an independent refuter running the registered SessionEnd hook verbatim. The
# rollup was an unlocked read-modify-write of one shared file: it read what
# every other session had committed, spent ~0.17s on per-row work, then renamed
# its own snapshot over the top. Anything committed in between was not merely
# missed, it was deleted, and the file could shrink. Twelve worktrees ending at
# once left 1 of 12; the same twelve run one at a time left 12 of 12.
#
# The input was already per-session, so the fix is to stop sharing the output
# rather than to make sharing safe. A lock was the other candidate and is worse
# for this data: it keeps one writer for rows that have exactly one owner, and a
# lock that is dropped rather than retried loses the same measurement.
LC="$TMP/ledgerconc"; LCP="$LC/projects/widgetconc"
mkdir -p "$LCP" "$MEM/widgetconc"
printf 'plugin\tsuperpowers@x\t-\tlow\talways\n' > "$LCP/stack.tsv"
_ledsnap() { ( cd "$1" 2>/dev/null && find . -type f -exec cksum {} \; | LC_ALL=C sort ); }

# Deterministic, and it is the exact property the race exploits: at the moment
# a rollup runs, every byte already in the memory directory belongs to some
# other session.
( . "$FROOT/harness/lib/ledger.sh"
  felix_ledger_record "$LC" first "tool	Bash"
  felix_ledger_rollup "$LCP" "$LC" first 2026-08-14 )
ledb="$(_ledsnap "$MEM/widgetconc")"
( . "$FROOT/harness/lib/ledger.sh"
  felix_ledger_record "$LC" second "tool	Read"
  felix_ledger_rollup "$LCP" "$LC" second 2026-08-14 )
leda="$(_ledsnap "$MEM/widgetconc")"
ledgone=""
while IFS= read -r _line; do
  [ -n "$_line" ] || continue
  printf '%s\n' "$leda" | grep -qxF "$_line" || ledgone="$ledgone $_line"
done <<EOF
$ledb
EOF
is "a rollup rewrites no file another session wrote" "$ledgone" ""

# The audit's own reproduction, at the scale that lost 11 of 12. Under the fix
# there is no shared file left to lose, so this is deterministic rather than
# probabilistic — the count is the one the retire threshold reads.
_i=1
while [ "$_i" -le 12 ]; do
  ( . "$FROOT/harness/lib/ledger.sh"; felix_ledger_record "$LC" "race$_i" "tool	Bash" )
  _i=$((_i+1))
done
_i=1
while [ "$_i" -le 12 ]; do
  ( . "$FROOT/harness/lib/ledger.sh"
    felix_ledger_rollup "$LCP" "$LC" "race$_i" 2026-08-14 ) &
  _i=$((_i+1))
done
wait
ledsum="$( . "$FROOT/harness/lib/ledger.sh"; felix_ledger_summary "$LCP" )"
is "twelve sessions ending at once are all still counted" \
   "$(printf '%s\n' "$ledsum" | awk -F'\t' '$1 == "superpowers" { print $2 }')" "14"

# Memory already on disk was written as one file, and it is data rather than a
# format to be dropped. The reader takes both, and a session re-rolled into its
# own file replaces its old rows instead of being counted twice.
LL="$TMP/ledgerboth"; LLP="$LL/projects/widgetboth"
mkdir -p "$LLP" "$MEM/widgetboth"
: > "$LLP/stack.tsv"
printf 'old\t2026-08-01\ttool\tBash\t3\t1\nkept\t2026-08-02\ttool\tRead\t2\t1\n' \
  > "$MEM/widgetboth/ledger.tsv"
( . "$FROOT/harness/lib/ledger.sh"
  felix_ledger_record "$LL" old "tool	Bash"
  felix_ledger_rollup "$LLP" "$LL" old 2026-08-14 )
ledsum="$( . "$FROOT/harness/lib/ledger.sh"; felix_ledger_summary "$LLP" )"
has "a ledger written as one file is still read"     "$ledsum" "Read	1	2"
has "and re-rolling a session replaces its old rows" "$ledsum" "Bash	1	1"

printf '\nreading the ledger, in the one direction that is honest\n'
# Written rows nothing reads is the same half-built shape as installing a tool
# no route can reach. Aggregation reduces to the owner, because a package is
# declared as superpowers@marketplace and invoked as superpowers:brainstorming.
LR="$TMP/ledgerread"; mkdir -p "$LR" "$MEM/ledgerread"
cat > "$MEM/ledgerread/ledger.tsv" <<'EOF'
s1	2026-08-01	skill	superpowers:brainstorming	3	1
s1	2026-08-01	plugin	playwright@x	0	1
s1	2026-08-01	plugin	context7@x	0	0
s2	2026-08-02	plugin	superpowers@x	0	1
s2	2026-08-02	plugin	playwright@x	0	1
s2	2026-08-02	mcp	context7	2	0
EOF
sum="$( . "$FROOT/harness/lib/ledger.sh"; felix_ledger_summary "$LR" )"
has "counts a package and its skill as one thing" "$sum" "superpowers	2	3"
has "sums invocations across sessions"            "$sum" "context7	2	2"
has "and keeps a never-invoked one at zero"       "$sum" "playwright	2	0"

# The asymmetry: only absence of use given presence is unconfounded, so only
# retirement is ever proposed and never the reverse.
p="$( . "$FROOT/harness/lib/ledger.sh"; FELIX_LEDGER_MIN=2 felix_ledger_retire "$LR" | tr '\n' ' ' )"
has "proposes retiring what was mounted and never reached for" "$p" "playwright"
case "$p" in
  *superpowers*) bad "never proposes retiring something that was used" "$p" ;;
  *context7*)    bad "never proposes retiring something that was used" "$p" ;;
  *)             ok  "never proposes retiring something that was used" ;;
esac
# Two sessions is not evidence. The window is sessions, not time, and a capability
# unused across two of them may simply not have come up yet.
p="$( . "$FROOT/harness/lib/ledger.sh"; FELIX_LEDGER_MIN=5 felix_ledger_retire "$LR" | tr -d '\n ' )"
is "and says nothing below the session threshold" "$p" ""

printf '\nzero is not one number\n'
# The design said a zero "has no alternative explanation: it was mounted, it was
# in scope, and it was ignored every time." That is false, and the false half is
# the half Felix controls. Felix decides what routes name. A capability no route
# ever named was never in scope in any sense the session could act on, so its
# zero measures Felix's own priors and retiring on it is a loop closing on
# itself — the recommender-bias shape, where logged data confounded by the
# logging policy looks like evidence for a year and is not.
#
# So the policy's decision is recorded next to the outcome. `named` is how many
# times a route pointed at a capability; `calls` is how often it was reached
# for. Two different zeros, and only one of them is about the capability.
LN="$TMP/ledgernamed"; mkdir -p "$LN" "$MEM/ledgernamed"
cat > "$MEM/ledgernamed/ledger.tsv" <<'EOF'
s1	2026-08-01	plugin	pointed-at@x	0	4
s1	2026-08-01	plugin	never-named@x	0	0
s2	2026-08-02	plugin	pointed-at@x	0	3
s2	2026-08-02	plugin	never-named@x	0	0
EOF
p="$( . "$FROOT/harness/lib/ledger.sh"; FELIX_LEDGER_MIN=2 felix_ledger_retire "$LN" | tr '\n' ' ' )"
has "retires what Felix pointed at and nobody reached for" "$p" "pointed-at"
case "$p" in
  *never-named*) bad "never retires what no route ever named" "$p" ;;
  *)             ok  "never retires what no route ever named" ;;
esac
u="$( . "$FROOT/harness/lib/ledger.sh"; felix_ledger_unrouted "$LN" | tr '\n' ' ' )"
has "reports it as a routing gap instead" "$u" "never-named"
case "$u" in
  *pointed-at*) bad "and not the one that was pointed at" "$u" ;;
  *)            ok  "and not the one that was pointed at" ;;
esac

# Rows written before the column existed say nothing either way. Reading a
# missing field as "named" would resurrect the overclaim in the one place
# nobody would look for it: the data already on disk.
LG="$TMP/ledgerlegacy"; mkdir -p "$LG" "$MEM/ledgerlegacy"
printf 's1\t2026-08-01\tplugin\told-shape@x\t0\ns2\t2026-08-02\tplugin\told-shape@x\t0\n' \
  > "$MEM/ledgerlegacy/ledger.tsv"
p="$( . "$FROOT/harness/lib/ledger.sh"; FELIX_LEDGER_MIN=2 felix_ledger_retire "$LG" | tr -d '\n ' )"
is "a row from before the column proposes nothing" "$p" ""
u="$( . "$FROOT/harness/lib/ledger.sh"; felix_ledger_unrouted "$LG" | tr -d '\n ' )"
is "and is not a routing gap either; it is unknown" "$u" ""

# And the recording end: what a route names is written down as it is named.
LH2="$TMP/ledgernote"; mkdir -p "$LH2/projects/widgetnote" "$MEM/widgetnote"
( . "$FROOT/harness/lib/ledger.sh"
  felix_ledger_record "$LH2" sn "tool	Bash"
  felix_ledger_note_named "$LH2" sn "superpowers:brainstorming code-review"
  felix_ledger_note_named "$LH2" sn "code-review" )
( . "$FROOT/harness/lib/ledger.sh"; felix_ledger_rollup "$LH2/projects/widgetnote" "$LH2" sn 2026-08-12 )
led="$(cat "$MEM/widgetnote/ledger.d/sn.tsv")"
has "a named capability carries its count"      "$led" "code-review	0	2"
has "and one named once carries one"            "$led" "superpowers:brainstorming	0	1"
has "while a tool that ran keeps its calls"     "$led" "tool	Bash	1"

printf '\nscope could not see what the diff added\n'
# `felix scope` is the unattended gate — red means a person decides. It asked
# felix_incident_severity, which takes PATHS, so it could only ever apply path
# rules. Both risk tables carry content rules (a credential in the added lines,
# destructive SQL), and scope was blind to every one of them.
#
# So a diff adding a live key to a documentation file printed "In scope.
# Reversible enough for an unattended attempt" and exited 0, while felix
# classify called the same diff red. Reproduced before it was believed.
SC="$TMP/scoperepo"; mkdir -p "$SC"
( cd "$SC" && git init -q -b main )
SC="$(cd "$SC" && pwd -P)"
printf 'widget\n' > "$SC/.felix"; printf 'notes\n' > "$SC/a.md"
( cd "$SC" && git add -A >/dev/null 2>&1 && git -c user.name=t -c user.email=t@t commit -qm base >/dev/null 2>&1 )
cp "$REAL_HARNESS/templates/risk.tsv" "$FROOT/projects/widget/risk.tsv"
printf 'api_key = "sk-ant-api03-QQQQQQQQQQQQQQQQQQQQQQQQ"\n' >> "$SC/a.md"   # must_flag
( cd "$SC" && git add -A >/dev/null 2>&1 && git -c user.name=t -c user.email=t@t commit -qm leak >/dev/null 2>&1 )

out="$( cd "$SC" && "$FELIX" scope --base HEAD~1 2>&1 )"; rc=$?
is  "a credential added to a green path is out of scope" "$rc" "3"
has "and scope says which tier it reached"               "$out" "red"

# Bare paths carry no diff, so content rules cannot be applied at all. It must
# say so rather than report a tier that looks complete.
out="$( cd "$SC" && "$FELIX" scope a.md 2>&1 )"; rc=$?
is  "scoping a bare path still answers"      "$rc" "0"
has "but admits it never read the changes"   "$out" "content"

printf '\nthe line that does the work\n'
# `felix merge` was shipped, deployed, written into the handoff as "Felix can
# merge", and could never merge anything. `gh pr merge --repo <slug> --squash`
# carries no PR selector, and gh rejects it client-side with "argument required
# when using the --repo flag" before any network call.
#
# Every existing merge test asserted a refusal or a dry run, so the single line
# that reaches gh was never executed by anything. Green suite, deployed engine,
# dead command. Fourth time this project has paid for "a test can be green
# because it cannot reach the branch it names".
#
# gh is stubbed here rather than called. The point is not that gh works; it is
# that Felix hands it something it will accept, which is exactly the half no
# test covered.
GHB="$TMP/ghstub"; mkdir -p "$GHB"
cat > "$GHB/gh" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$GHSTUB_LOG"
case "$1 $2" in
  "pr view") printf '{"number":7,"state":"OPEN"}\n' ;;
  "pr merge")
    # Reproduce gh's own precondition rather than trusting it: --repo demands a
    # PR selector, and a selector is any bare argument after `merge`.
    sel=0; skip=0
    for a in "${@:3}"; do
      [ "$skip" -eq 1 ] && { skip=0; continue; }
      case "$a" in --repo|--body|--subject) skip=1 ;; --*) ;; *) sel=1 ;; esac
    done
    case " $* " in *" --repo "*) [ "$sel" -eq 1 ] || {
        echo "argument required when using the --repo flag" >&2; exit 1; } ;;
    esac
    printf 'merged\n' ;;
esac
exit 0
STUB
chmod +x "$GHB/gh"

# Its own checkout, because the main fixture is deliberately remote-less and
# felix merge dies on "no github remote" long before it reaches gh.
MR="$TMP/mergerepo"; mkdir -p "$MR"
( cd "$MR" && git init -q -b main \
  && git remote add origin https://github.com/example/widget.git )
MR="$(cd "$MR" && pwd -P)"
printf 'widget\n' > "$MR/.felix"; printf 'contents\n' > "$MR/WIDGET.txt"
( cd "$MR" && git add -A >/dev/null 2>&1 \
  && git -c user.name=t -c user.email=t@t commit -qm base >/dev/null 2>&1 )
printf 'a change to merge\n' > "$MR/README.md"
( cd "$MR" && git add -A >/dev/null 2>&1 \
  && git -c user.name=t -c user.email=t@t commit -qm c >/dev/null 2>&1 )

export GHSTUB_LOG="$TMP/gh.log"; : > "$GHSTUB_LOG"
( cd "$MR" && . "$FROOT/harness/lib/verify.sh"
  felix_verify_record "$MR" "$FROOT" 0 "true" "$(felix_tree_id "$MR" "$FROOT")" )
( cd "$MR" && PATH="$GHB:$PATH" "$FELIX" merge --base HEAD~1 >/dev/null 2>&1 )
mg="$(grep '^pr merge' "$GHSTUB_LOG" | head -1)"
[ -n "$mg" ] && ok "felix merge reaches gh at all" \
             || bad "felix merge reaches gh at all" "gh was never invoked"
# The assertion that would have caught it: a bare argument after `merge` that is
# not the value of a flag. The naive version counted the value of --repo and
# passed against the broken command, which is the same defect one level up.
sel=0; skip=0
for a in $mg; do
  [ "$skip" -eq 1 ] && { skip=0; continue; }
  case "$a" in
    pr|merge) ;;
    --repo|--body|--subject) skip=1 ;;
    --*) ;;
    *) sel=1 ;;
  esac
done
[ "$sel" -eq 1 ] && ok "and hands it a pull request to merge" \
                 || bad "and hands it a pull request to merge" "no selector in [$mg]"
# And the stub reproduces gh's own refusal, so a regression fails loudly here
# rather than only in somebody's terminal.
printf 'pr merge --repo x/y --squash\n' > "$TMP/shape.probe"
( PATH="$GHB:$PATH" GHSTUB_LOG=/dev/null gh pr merge --repo x/y --squash ) 2>/dev/null \
  && bad "the stub refuses a selectorless merge the way gh does" "stub accepted it" \
  || ok "the stub refuses a selectorless merge the way gh does"
unset GHSTUB_LOG

printf '\nthe version that judges is the one main declares\n'
# Issue #28, the engine half, second attempt. The first resolved the judge as
# "the newest thing in the plugin cache" and was vacuous: the gate's `installed`
# check demands the cache match the tree byte for byte before it will go green,
# and merge demands a green receipt, so by merge time the newest cache entry IS
# the candidate. docs/2026-08-14-earned-autonomy-decision.md said so at §4a
# before any of it was written — "one problem seen from two sides".
#
# The judge is instead the version `main` declares. The cache keeps every
# version ever installed, and a branch must bump its own version to deploy at
# all, so main's entry is present and is not the candidate's. The deadlock is
# side-stepped rather than fought: `installed` compares the tree to the newest
# entry while the kernel is an older one, and both hold at once.
KR="$TMP/kres"; mkdir -p "$KR/engine/.claude-plugin"
# -b main explicitly: without it the branch name comes from init.defaultBranch,
# which is the machine and not the fixture. This passed on a laptop that says
# main and failed on a runner that says master.
( cd "$KR" && git init -q -b main && git config user.email t@t && git config user.name t )
printf '{ "name": "felix", "version": "1.0.0" }\n' > "$KR/engine/.claude-plugin/plugin.json"
mkdir -p "$KR/engine/harness/lib"; printf 'x\n' > "$KR/engine/harness/lib/escape.sh"
( cd "$KR" && git add -A >/dev/null && git commit -qm base >/dev/null )
KC="$TMP/kcache"; mkdir -p "$KC/1.0.0/harness/lib" "$KC/2.0.0/harness/lib" "$KC/10.0.0/harness/lib"

_kd() { ( . "$FROOT/harness/lib/resolve.sh"
          FELIX_KERNEL_CACHE="$KC" felix_kernel_dir "$KR" ); }
is "the judge is the version main declares" "$(_kd)" "$KC/1.0.0/harness"

# The bump the deploy loop forces is what makes the two differ. After it, the
# tree is 2.0.0 and the judge is still main's 1.0.0 — which is the whole point,
# and is what the first attempt got wrong by taking the newest.
printf '{ "name": "felix", "version": "2.0.0" }\n' > "$KR/engine/.claude-plugin/plugin.json"
is "a bumped tree does not become its own judge" "$(_kd)" "$KC/1.0.0/harness"
case "$(_kd)" in
  *10.0.0*|*2.0.0*) bad "and never the newest thing in the cache" "$(_kd)" ;;
  *)                ok  "and never the newest thing in the cache" ;;
esac

# Absent rather than guessed. Answering with some other version would be the
# first attempt's defect with a different arithmetic.
rm -rf "$KC/1.0.0"
is "a version main declares but nobody installed resolves to nothing" "$(_kd)" ""
mkdir -p "$KC/1.0.0/harness/lib"
KR2="$TMP/kres2"; mkdir -p "$KR2"; ( cd "$KR2" && git init -q -b main )
is "and a repository with no main resolves to nothing" \
   "$( . "$FROOT/harness/lib/resolve.sh"; FELIX_KERNEL_CACHE="$KC" felix_kernel_dir "$KR2" )" ""

# Only the repository that ships the engine has this problem at all. A governed
# product's rules live in the Felix home and are not in its diff, so there is no
# circularity to break and nothing to demand of it — which is what keeps this
# from becoming a fix for Felix and a regression for everything Felix governs.
_sg() { ( . "$FROOT/harness/lib/resolve.sh"; felix_self_governed "$1" && echo yes || echo no ); }
# The branch name is an argument, not a constant. A project whose trunk is
# called something else must still find its judge.
( cd "$KR" && git branch -m main trunk )
is "the judge is found on whatever branch is being merged into" \
   "$( . "$FROOT/harness/lib/resolve.sh"; FELIX_KERNEL_CACHE="$KC" felix_kernel_dir "$KR" trunk )" \
   "$KC/1.0.0/harness"
is "and not found by assuming the branch is called main" \
   "$( . "$FROOT/harness/lib/resolve.sh"; FELIX_KERNEL_CACHE="$KC" felix_kernel_dir "$KR" main )" ""
( cd "$KR" && git branch -m trunk main )

# The collision that shipped. toolbox.sh sets FELIX_PLUGIN_CACHE to the plugins
# cache root and the CLI sources it, so a resolver reading that name looked one
# level too high and found nothing — while every test here passed, because they
# all set the variable themselves. This one deliberately does not set ours.
mkdir -p "$TMP/plugroot/felix/felix/1.0.0/harness/lib"
is "the plugins cache root is composed with, not read as ours" \
   "$( . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/toolbox.sh"
       FELIX_PLUGIN_CACHE="$TMP/plugroot" felix_kernel_dir "$KR" main )" \
   "$TMP/plugroot/felix/felix/1.0.0/harness"

is "the repository that ships the engine is self-governed" "$(_sg "$KR")" "yes"
is "and an ordinary product repository is not"             "$(_sg "$MR")" "no"

printf '\nand it is that version that forms the verdict\n'
# A self-governing fixture: a repository that ships an engine, with main
# declaring one version and the branch declaring another, which is the shape the
# deploy loop forces on every engine change.
SG="$TMP/selfgov"; mkdir -p "$SG/engine/.claude-plugin" "$SG/engine/harness/lib"
( cd "$SG" && git init -q -b main && git config user.email t@t && git config user.name t \
  && git remote add origin https://github.com/example/widget.git )
# Physical path, as $MR already does a few hundred lines up and for the same
# reason. felix_repo_root resolves symlinks, so on macOS a fixture under /tmp
# becomes /private/tmp — and the gate receipt is keyed on a hash of the root, so
# recording under one spelling and reading under the other never matches. That
# is why no assertion here could show a self-governed merge SUCCEEDING: every
# one was refused for a stale receipt, and a refusal looks exactly like the
# feature working.
SG="$( cd "$SG" && pwd -P )"
printf 'widget\n' > "$SG/.felix"; printf 'stub\n' > "$SG/engine/harness/lib/escape.sh"
printf '{ "version": "1.0.0" }\n' > "$SG/engine/.claude-plugin/plugin.json"
( cd "$SG" && git add -A >/dev/null && git commit -qm base >/dev/null && git checkout -q -b feature )
printf '{ "version": "2.0.0" }\n' > "$SG/engine/.claude-plugin/plugin.json"
printf 'runs something\n' > "$SG/KERNEL2.txt"
# The candidate edits the judge's own source. Without this the diff touches only
# engine/.claude-plugin, which is not self-judgement and no longer trips the
# guard — the correction this fixture exists to exercise.
printf 'candidate edit\n' >> "$SG/engine/harness/lib/escape.sh"
( cd "$SG" && git add -A >/dev/null && git commit -qm candidate >/dev/null )
printf 'red\tpath\t^KERNEL2\\.txt$\ta channel for the kernel test\texecute\n' \
  >> "$FROOT/projects/widget/risk.tsv"

KC2="$TMP/kcache2"; mkdir -p "$KC2/1.0.0" "$KC2/2.0.0"
cp -R "$FROOT/harness" "$KC2/1.0.0/harness"          # main's version: honest
cp -R "$FROOT/harness" "$KC2/2.0.0/harness"          # the candidate's own

_sgmerge() {
  : > "$TMP/gh.sg.log"
  ( cd "$SG" && PATH="$GHB:$PATH" GHSTUB_LOG="$TMP/gh.sg.log" \
      FELIX_KERNEL_CACHE="$KC2" "$FELIX" merge --base HEAD~1 >"$TMP/sg.out" 2>&1 )
  SGRC=$?
  SGMERGES="$(grep -c '^pr merge' "$TMP/gh.sg.log" | tr -d ' ')"
}
_sgrecord() { ( cd "$SG" && . "$FROOT/harness/lib/verify.sh"
                felix_verify_record "$SG" "$FROOT" 0 "true" "$(felix_tree_id "$SG" "$FROOT")" ); }

# The escape is real, so nothing below can pass by finding nothing.
# Asserted on WHICH blocker fired, never on "nothing merged". A merge can fail
# for a stale receipt, and an assertion that only counts merges passes just as
# well when the thing under test did nothing at all — which is how the first
# attempt at this looked green.
_sgrecord; _sgmerge
has "the execute channel stops this merge" "$(cat "$TMP/sg.out")" "execute"
is  "and nothing is merged"                "$SGMERGES" "0"

# The attack: the running engine's escape.sh is taught to find nothing. The
# verdict comes from main's version, which was never taught anything.
cp "$FROOT/harness/lib/escape.sh" "$TMP/esc.orig"
cat > "$FROOT/harness/lib/escape.sh" <<'WEAK'
felix_escapes() { return 0; }
felix_merge_blockers() { return 0; }
felix_merge_checkout() {
  printf '%s\t%s\t%s\n' "$(git -C "$1" rev-parse --abbrev-ref HEAD 2>/dev/null)" \
    "$(git -C "$1" rev-parse HEAD 2>/dev/null)" ""
}
WEAK
_sgrecord; _sgmerge
# The channel must appear in the refusal. The tree's felix_escapes returns
# nothing, so this line can only come from main's copy — a count alone would
# have been satisfied by any unrelated blocker.
has "a disarmed engine is still judged by main's version" "$(cat "$TMP/sg.out")" "execute"
is  "and it merges nothing"                               "$SGMERGES" "0"
cp "$TMP/esc.orig" "$FROOT/harness/lib/escape.sh"

# The vacuous case the first attempt shipped: a judge byte-identical to the tree
# it judges. It must be loud, not silent.
rm -rf "$KC2/1.0.0/harness"; cp -R "$SG/engine/harness" "$KC2/1.0.0/harness"
_sgrecord; _sgmerge
is "a judge identical to the candidate merges nothing" "$SGMERGES" "0"
has "and says why it refused" "$(cat "$TMP/sg.out")" "identical"
rm -rf "$KC2/1.0.0/harness"; cp -R "$FROOT/harness" "$KC2/1.0.0/harness"

# A change that does not touch the engine has no circularity to break, and the
# judge being identical to the tree is not self-judgement — it IS the base
# version, unchanged. The first version of this guard fired on every
# documentation branch and made them unmergeable, which the first real use
# found within a minute of the feature landing.
# main carries a real engine here, not the stub the other scenarios use: the
# judge has to be identical to the tree AND loadable, and a stub that cannot be
# sourced would refuse for the wrong reason and the assertion would pass
# without testing anything.
( cd "$SG" && git checkout -q main \
  && rm -rf engine/harness && cp -R "$FROOT/harness" engine/harness \
  && git add -A >/dev/null && git -c user.name=t -c user.email=t@t commit -qm engine >/dev/null \
  && git checkout -q -b prose \
  && printf 'notes\n' > NOTES.md && git add -A >/dev/null \
  && git -c user.name=t -c user.email=t@t commit -qm prose >/dev/null )
rm -rf "$KC2/1.0.0/harness"; cp -R "$FROOT/harness" "$KC2/1.0.0/harness"
_sgrecord; _sgmerge
# Asserted on the refusal, not on a merge. What changed is whether the
# identical-judge guard fires, and a merge additionally needs a valid receipt —
# which this fixture does not reliably produce, so asserting on it would test
# the fixture rather than the fix.
case "$(cat "$TMP/sg.out")" in
  *identical*) bad "a change that does not touch the engine is not called self-judgement" "$(cat "$TMP/sg.out")" ;;
  *)           ok  "a change that does not touch the engine is not called self-judgement" ;;
esac
# And it actually merges. Every other assertion in this section is a refusal,
# and a guard that refused everything would satisfy all of them — this is the
# one that fails if the kernel path stops permitting anything at all.
is "and a self-governed branch does merge under the kernel" "$SGMERGES" "1"
( cd "$SG" && git checkout -q feature && git branch -qD prose )
rm -rf "$KC2/1.0.0/harness"; cp -R "$FROOT/harness" "$KC2/1.0.0/harness"

# And the other half: the same identical judge, with the engine in the diff,
# must still refuse. Without this the pair proves nothing — a guard that never
# fires would satisfy the assertion above.
rm -rf "$KC2/1.0.0/harness"; cp -R "$SG/engine/harness" "$KC2/1.0.0/harness"
_sgrecord; _sgmerge
has "but a change that does touch it still is" "$(cat "$TMP/sg.out")" "identical"
rm -rf "$KC2/1.0.0/harness"; cp -R "$FROOT/harness" "$KC2/1.0.0/harness"

# The kernel is built from engine/harness, but the guard tested `^engine/`. So a
# branch whose only engine change is the version bump — which every deploy
# forces, and which cannot touch engine/harness — was told to bump the version
# and install main's. Advice that had already been followed and could not have
# helped. Found by review the day the guard shipped.
# The kernel is copied AFTER the checkout, or it is not identical to the tree
# and the guard never gets the chance to fire — the assertion below is a
# negative, so it would pass because nothing happened.
( cd "$SG" && git checkout -q main && git checkout -q -b bumponly \
  && printf '{ "version": "3.0.0" }\n' > engine/.claude-plugin/plugin.json \
  && git add -A >/dev/null && git -c user.name=t -c user.email=t@t commit -qm bump >/dev/null )
rm -rf "$KC2/1.0.0/harness"; cp -R "$SG/engine/harness" "$KC2/1.0.0/harness"
# Proof the fixture is armed: the judge really is byte-identical to the tree, so
# the guard's own precondition holds and only the path predicate decides.
diff -rq "$SG/engine/harness" "$KC2/1.0.0/harness" >/dev/null 2>&1 \
  && ok "the bump fixture has an identical judge, so the guard can fire" \
  || bad "the bump fixture has an identical judge, so the guard can fire" "they differ"
_sgrecord; _sgmerge
case "$(cat "$TMP/sg.out")" in
  *identical*) bad "a version bump alone is not self-judgement" "$(cat "$TMP/sg.out")" ;;
  *)           ok  "a version bump alone is not self-judgement" ;;
esac
( cd "$SG" && git checkout -q feature && git branch -qD bumponly )
rm -rf "$KC2/1.0.0/harness"; cp -R "$FROOT/harness" "$KC2/1.0.0/harness"

# review.sh must be in the kernel's source list. escape.sh guards the reviewed
# channel with `command -v felix_review_passed`, so leaving review.sh out does
# not error — it silently stops a reviewer's pass from ever clearing, which is
# the one exception invariant 2 grants.
printf 'felix_review_passed() { return 0; }\n' > "$KC2/1.0.0/harness/lib/review.sh"
# The row is rewritten rather than sed'd onto. BSD sed does not interpret \t, so
# substituting on a tab silently changes nothing, and this assertion would have
# gone on testing the execute channel while claiming to test reviewed.
sed '/KERNEL2/d' "$FROOT/projects/widget/risk.tsv" > "$TMP/rv" \
  && mv "$TMP/rv" "$FROOT/projects/widget/risk.tsv"
printf 'red\tpath\t^KERNEL2\\.txt$\ta channel a verdict may clear\treviewed\n' \
  >> "$FROOT/projects/widget/risk.tsv"
_sgrecord; _sgmerge
case "$(cat "$TMP/sg.out")" in
  *reviewed*) bad "a passing verdict clears a reviewed escape through the kernel" "$(cat "$TMP/sg.out")" ;;
  *)          ok  "a passing verdict clears a reviewed escape through the kernel" ;;
esac
# The other half of the pair, and the only thing that proves review.sh is in the
# child's source list rather than merely present on disk. escape.sh guards the
# lookup with `command -v felix_review_passed`, so a kernel where that function
# is undefined does not error — the escape simply never clears.
printf '# a review.sh that defines nothing\n' > "$KC2/1.0.0/harness/lib/review.sh"
_sgrecord; _sgmerge
has "and without it the same escape stands" "$(cat "$TMP/sg.out")" "reviewed"
printf 'felix_review_passed() { return 0; }\n' > "$KC2/1.0.0/harness/lib/review.sh"

sed '/KERNEL2/d' "$FROOT/projects/widget/risk.tsv" > "$TMP/rv2" \
  && mv "$TMP/rv2" "$FROOT/projects/widget/risk.tsv"

# And the repository that does not ship an engine is left exactly alone: no
# kernel demanded, no cache consulted, merge as before. This is the assertion
# that keeps a fix for Felix from becoming a regression for every product.
: > "$TMP/gh.prod.log"
( cd "$MR" && . "$FROOT/harness/lib/verify.sh"
  felix_verify_record "$MR" "$FROOT" 0 "true" "$(felix_tree_id "$MR" "$FROOT")" )
( cd "$MR" && PATH="$GHB:$PATH" GHSTUB_LOG="$TMP/gh.prod.log" \
    FELIX_KERNEL_CACHE="$TMP/no-cache-at-all" "$FELIX" merge --base HEAD~1 >/dev/null 2>&1 )
is "a governed product merges with no installed engine at all" \
   "$(grep -c '^pr merge' "$TMP/gh.prod.log" | tr -d ' ')" "1"

printf '\nwhat it verified and what it merges are the same branch\n'
# Issue #33, from the same concurrency audit. felix merge computed the tree
# identity, checked the receipt against it, ran the evidence check — and only
# then read the branch name. A peer's `git checkout` in the same working copy
# inside that gap made it squash-merge a branch nothing had verified, and print
# that nothing in it escaped the tree. Measured at ~35% of the command's
# runtime, and the harm is the worst category the audit found: an ungated
# escape merged into main, reported as verified, recorded nowhere.
#
# Injected at `git remote get-url`, which is the one landmark that sits inside
# exactly that window: felix_repo_slug is its only caller on this path, and it
# runs after the receipt is checked and before the branch is read. Verified by
# probe rather than assumed — a counted trigger would rot silently the first
# time the call sequence changed.
GB="$TMP/gitstub"; mkdir -p "$GB"
GITREAL="$(command -v git)"
# Parameterised on both halves, because one hard-coded scenario tested one third
# of the guard. RACE_ON picks where in the command the peer lands, RACE_CMD picks
# what the peer does. Between them they reach all three fields of the tuple and
# both sides of felix_merge_blockers.
cat > "$GB/git" <<STUB
#!/usr/bin/env bash
case "\$*" in
  *"\${RACE_ON:-remote get-url}"*)
    if [ -n "\${RACE_CMD:-}" ] && [ ! -f "\${RACE_FIRED:-/nonexistent}" ]; then
      printf 'fired\n' > "\$RACE_FIRED"
      eval "\$RACE_CMD" >/dev/null 2>&1
    fi ;;
esac
exec "$GITREAL" "\$@"
STUB
chmod +x "$GB/git"

( cd "$MR" && git checkout -q -b feature && git branch other )

# Re-records the receipt, runs felix merge with one peer action injected, and
# reports the exit code and whether gh was asked to merge anything.
_race() {
  local on="$1" cmd="$2"
  ( cd "$MR" && . "$FROOT/harness/lib/verify.sh"
    felix_verify_record "$MR" "$FROOT" 0 "true" "$(felix_tree_id "$MR" "$FROOT")" )
  : > "$TMP/gh.race.log"; rm -f "$TMP/race.fired"
  ( cd "$MR" && PATH="$GB:$GHB:$PATH" GHSTUB_LOG="$TMP/gh.race.log" \
      RACE_ON="$on" RACE_CMD="$cmd" RACE_FIRED="$TMP/race.fired" \
      "$FELIX" merge --base HEAD~1 >/dev/null 2>&1 )
  RACE_RC=$?
  RACE_MERGES="$(grep -c '^pr merge' "$TMP/gh.race.log" | tr -d ' ')"
}

# 1. A peer checkout landing where the audit found it: after the receipt is
#    accepted, before the branch is read.
_race "remote get-url" "$GITREAL -C $MR checkout -q other"
[ -f "$TMP/race.fired" ] && ok "the injected checkout actually moved the branch" \
                         || bad "the injected checkout actually moved the branch" "it never fired"
is "a checkout that moves after verification merges nothing" "$RACE_MERGES" "0"
[ "$RACE_RC" -ne 0 ] && ok "and says so rather than reporting a merge" \
                     || bad "and says so rather than reporting a merge" "exit $RACE_RC"
( cd "$MR" && git checkout -q feature )

# 2. Inside felix_merge_blockers, which is the assertion that pins the fix. The
#    first version of this test injected only at `remote get-url` — the tail of
#    the command — so it passed just as well against a version that reads the
#    branch after the blockers and re-reads it at the end, which is the whole
#    of the bug the issue is about. A test that cannot tell the fix from the
#    defect is the failure this repository keeps paying for, and it was found
#    by review rather than by the suite.
_race "diff --name-only" "$GITREAL -C $MR checkout -q other"
[ -f "$TMP/race.fired" ] && ok "a checkout inside the verification is caught too" \
                         || bad "a checkout inside the verification is caught too" "it never fired"
is "and nothing is merged when it lands there" "$RACE_MERGES" "0"
( cd "$MR" && git checkout -q feature )

# 3. The other two fields. A peer commit moves the sha with the branch name
#    unchanged; a peer edit moves neither and changes only the tree the receipt
#    was accepted for. Both were dead weight until something asserted them.
_race "remote get-url" "$GITREAL -C $MR -c user.name=p -c user.email=p@p commit -q --allow-empty -m peer"
is "a peer commit on the same branch merges nothing" "$RACE_MERGES" "0"
_race "remote get-url" "printf 'peer\n' >> $MR/README.md"
is "a peer edit to the working tree merges nothing" "$RACE_MERGES" "0"
# And it must say which of the three moved. Printing a fixed prefix of the
# record rendered this case as two identical lines under "the checkout moved".
( cd "$MR" && . "$FROOT/harness/lib/verify.sh"
  felix_verify_record "$MR" "$FROOT" 0 "true" "$(felix_tree_id "$MR" "$FROOT")" )
rm -f "$TMP/race.fired"
race_out="$( cd "$MR" && PATH="$GB:$GHB:$PATH" GHSTUB_LOG=/dev/null \
    RACE_ON="remote get-url" RACE_CMD="printf 'peer2\n' >> $MR/README.md" \
    RACE_FIRED="$TMP/race.fired" "$FELIX" merge --base HEAD~1 2>&1 )"
has "and names the working tree rather than the checkout" "$race_out" "tree       edited under it"
case "$race_out" in
  *"The checkout moved"*) bad "and does not blame a checkout that did not move" "$race_out" ;;
  *)                      ok  "and does not blame a checkout that did not move" ;;
esac
( cd "$MR" && git checkout -q -- README.md 2>/dev/null; git checkout -q feature )
unset GHSTUB_LOG

# The same defect with no concurrency in it at all. `felix merge 35` shifted the
# 35 away unread and merged whatever HEAD happened to be on, so a command told
# to merge one thing merged another and reported success. An argument it cannot
# honour must stop it, not be discarded — the rest of this command is
# fail-closed everywhere.
export GHSTUB_LOG="$TMP/gh.arg.log"; : > "$GHSTUB_LOG"
( cd "$MR" && PATH="$GHB:$PATH" "$FELIX" merge 35 >/dev/null 2>&1 )
rc=$?
# A flag whose value is missing, which is the same defect one step along and
# needs no concurrency either. `--base) base="${2:-main}"; shift 2` reads as if
# the missing value were handled — the default is right there — but `shift 2`
# fails when $# is 1 and, having failed, shifts nothing, so the loop never
# advances and the command spins with no output until it is killed. Confirmed
# present on main before this branch, so it is not a regression from the
# argument handling added beside it.
#
# A test for a hang has to bound itself or it becomes the hang.
( cd "$MR" && PATH="$GHB:$PATH" "$FELIX" merge --base >/dev/null 2>&1 ) &
_bp=$!
# Kills the children too. `kill $_bp` reaps the subshell and leaves the felix
# it launched spinning — found the hard way: the first red run of this test left
# a `felix merge --base` burning a core for twenty-four minutes, and it was
# still there when the next gate ran slowly enough to notice. A test for a hang
# that leaks the hang is worse than no test, because it only leaks when it fails.
( sleep 5; pkill -9 -P $_bp 2>/dev/null; kill -9 $_bp 2>/dev/null ) >/dev/null 2>&1 &
_bw=$!
wait $_bp 2>/dev/null; _brc=$?
kill $_bw >/dev/null 2>&1
case "$_brc" in
  137|9) bad "a flag with no value refuses instead of spinning" "still running after 5s" ;;
  0)     bad "a flag with no value refuses instead of spinning" "exit 0, it merged something" ;;
  *)     ok  "a flag with no value refuses instead of spinning" ;;
esac

is "an argument it cannot honour merges nothing" \
   "$(grep -c '^pr merge' "$GHSTUB_LOG" | tr -d ' ')" "0"
[ "$rc" -ne 0 ] && ok "and refuses instead of ignoring it" \
                || bad "and refuses instead of ignoring it" "exit $rc"
unset GHSTUB_LOG

printf '\na path at the end of a sentence\n'
# An issue says "cover it in tests/test_thing.py." and the trailing full stop
# travels with the path. The extractor strips :line, a trailing comma, ./ and
# leading +-, and never that — so the most ordinary way a person writes a path
# in prose was the one way it did not resolve. `felix brief` silently listed one
# of the two files an issue named, which reads as a complete answer.
IP="$TMP/inc"; mkdir -p "$IP/src" "$IP/tests"
: > "$IP/src/thing.py"; : > "$IP/tests/test_thing.py"
_ip() { ( . "$FROOT/harness/lib/incident.sh"; felix_incident_paths "$IP" "$1" | tr '\n' ' ' ); }
has "a path ending a sentence still resolves" "$(_ip 'fix it in tests/test_thing.py.')" "tests/test_thing.py"
has "and both paths in one sentence are found" \
    "$(_ip 'src/thing.py raises. Cover it in tests/test_thing.py.')" "src/thing.py"
has "including the second one"  \
    "$(_ip 'src/thing.py raises. Cover it in tests/test_thing.py.')" "tests/test_thing.py"
is  "a path naming nothing real is still not invented" "$(_ip 'see docs/nope.py.')" ""

# The same defect one convention along, and this one is how every issue is
# actually written. A path in inline backticks resolved to nothing at all: the
# splitter breaks on quotes, parens, brackets and angle brackets, and never on a
# backtick, so the candidate carried one at each end and no amount of stripping
# leading components could find a file by that name.
#
# Found by filing the first four issues this repository has ever had and running
# `felix brief` on one. It reported a single file and tier yellow. The body also
# named engine/harness/lib/resolve.sh, in backticks, which risk.tsv calls red
# because it is sourced by the CLI and by every hook. So the miss did not read as
# an omission — it read as a confident risk verdict, one tier low.
#
# Markdown emphasis is the same shape and gets the same treatment. Both are
# delimiters nobody puts in a repo path, exactly like the quotes and brackets
# already in the set, and adding them can only ever resolve more.
has "a path in inline backticks resolves"   "$(_ip 'look at `src/thing.py` please')"     "src/thing.py"
has "and one in a double-backtick span"     "$(_ip 'look at ``src/thing.py`` please')"   "src/thing.py"
has "and one wrapped in bold"               "$(_ip 'look at **src/thing.py** please')"   "src/thing.py"
has "backticks plus the punctuation after them" \
    "$(_ip 'added in 52e7723, `tests/test_thing.py`).')"                                 "tests/test_thing.py"
has "a trailing colon does not eat it"      "$(_ip 'the failing file is src/thing.py:')" "src/thing.py"
has "nor a semicolon"                       "$(_ip 'src/thing.py; and then more')"       "src/thing.py"
# The conservative half must survive all of that: still no inventing.
is  "and a backticked path naming nothing is still not invented" \
    "$(_ip 'see `docs/nope.py` there')" ""

printf '\nwhat you are about to commit\n'
# `felix evidence` told a session it owed a web test that the session had
# literally just staged. Every reader of "what changed" tries
# `git diff --name-only base...HEAD` and falls back to `git diff base` only when
# that is EMPTY. On a branch with commits the first form is not empty, so the
# fallback never runs and everything staged or unstaged is dropped — which is
# every pull request. On a branch with no commits yet the fallback covers it,
# which is why this went unnoticed: the shape that hides the bug is the shape a
# fixture reaches for.
#
# Worse than a wrong report: felix_escapes reads the same way, so on any real
# branch a staged workflow change or a staged credential was invisible to the
# merge gate. lessons.sh had it right all along and nothing made the rest agree.
STG="$TMP/stagedrepo"; mkdir -p "$STG"
( cd "$STG" && git init -q -b main )
STG="$(cd "$STG" && pwd -P)"
printf 'widget\n' > "$STG/.felix"; printf 'x\n' > "$STG/seed.txt"
( cd "$STG" && git add -A >/dev/null 2>&1 && git -c user.name=t -c user.email=t@t commit -qm base >/dev/null 2>&1 )
BASE_SHA="$(git -C "$STG" rev-parse HEAD)"
# A commit ahead of base, so `base...HEAD` is non-empty and the fallback is dead.
printf 'notes\n' > "$STG/README.md"
( cd "$STG" && git add -A >/dev/null 2>&1 && git -c user.name=t -c user.email=t@t commit -qm ahead >/dev/null 2>&1 )

mkdir -p "$STG/.github/workflows"
printf 'on: push\n' > "$STG/.github/workflows/ci.yml"
( cd "$STG" && git add .github >/dev/null 2>&1 )   # staged, deliberately not committed

_sesc() { ( cd "$STG" && . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/verify.sh"
            . "$FROOT/harness/lib/review.sh"; . "$FROOT/harness/lib/escape.sh"
            felix_escapes "$FROOT/projects/widget" "$BASE_SHA" "$STG" "$FROOT" ); }
has "a staged workflow escapes even with commits ahead" "$(_sesc)" "execute"

printf 'unit\t^src/\t^tests?/\tcode changes need a test\n' > "$FROOT/projects/widget/evidence.tsv"
mkdir -p "$STG/src" "$STG/tests"; printf 'x=1\n' > "$STG/src/a.py"
( cd "$STG" && git add src >/dev/null 2>&1 )
_sev() { ( cd "$STG" && . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/evidence.sh"
           felix_evidence_check "$FROOT/projects/widget" "$BASE_SHA" "$STG" ); }
has "a staged source change owes its test" "$(_sev)" "gap"
printf 'def test_a(): pass\n' > "$STG/tests/test_a.py"
( cd "$STG" && git add tests >/dev/null 2>&1 )
has "and staging the test closes the gap — the case that started this" "$(_sev)" "met"
rm -f "$FROOT/projects/widget/evidence.tsv"

printf '\na receipt that cannot claim more than it knows\n'
# v3.0's domain-OS contract asks each harness for a machine-readable record of
# what changed, why, evidence, risk and result. Felix computes every one of
# those and emits none of them: classify has the risk, evidence has what is
# owed, the gate has the result, escape has the authority question. This is a
# serialiser over facts that already exist.
#
# Two properties come from the transport research rather than from the contract.
# Neither MCP 2026-07-28 nor A2A 1.0.1 carries a bounded authority claim, and
# neither signs task output — so if a receipt is to say on whose authority the
# work proceeded, the receipt itself must carry it, because no transport will.
# And neither models verification as distinct from completion, which is exactly
# what Felix has that they do not, so the gate verdict is its own field.
#
# The load-bearing property is none of that. It is that the receipt CANNOT CLAIM
# VERIFIED ON AN ABSENCE. Six defects in one day were one species — emptiness
# read as success — so the first consumer of this receipt is that rule.
_rcpt() { ( cd "$STG" && . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/detect.sh"
            . "$FROOT/harness/lib/verify.sh"; . "$FROOT/harness/lib/review.sh"
            . "$FROOT/harness/lib/escape.sh"; . "$FROOT/harness/lib/classify.sh"
            . "$FROOT/harness/lib/evidence.sh"; . "$FROOT/harness/lib/receipt.sh"
            felix_receipt "$FROOT/projects/widget" "${1:-$BASE_SHA}" "$STG" "$FROOT" ); }
_rf() { printf '%s' "$1" | python3 -c '
import json,sys
d=json.load(sys.stdin)
for p in sys.argv[1].split("."): d=d[p]
print(d if isinstance(d,str) else json.dumps(d))' "$2" 2>/dev/null; }

r="$(_rcpt)"
printf '%s' "$r" | python3 -c 'import json,sys; json.load(sys.stdin)' 2>/dev/null \
  && ok "it emits parseable json" || bad "it emits parseable json" "$r"
is  "it names a schema version, so a reader can refuse one it does not know" \
    "$(_rf "$r" schema)" "felix.receipt/1"
is  "and the domain it speaks for"  "$(_rf "$r" domain)" "engineering"
has "it names what changed"         "$(_rf "$r" changed.paths)" "src/a.py"
is  "and says that it knows"        "$(_rf "$r" changed.known)" "true"

# The gate has not run against this tree, so nothing may say it is verified.
# This is the whole point: an absent receipt is not a green one.
vs="$(_rf "$r" verification.state)"
is "an absent gate receipt reads as absent, not as green" "$vs" "none"
st="$(_rf "$r" status)"
case "$st" in verified) bad "and the receipt refuses to call that verified" "$st" ;;
              *)        ok  "and the receipt refuses to call that verified" ;; esac

# Authority is carried in the receipt because no transport carries it.
is "a staged workflow makes this the founder's call" "$(_rf "$r" authority.founder_required)" "true"
is "and it is not autonomous"                        "$(_rf "$r" authority.autonomous)"      "false"
has "naming the channel that escaped"                "$(_rf "$r" authority.escapes)"         "execute"
# Was "which is nobody yet", and #57 named it a constant checked against itself:
# granted_by was the literal "none", so this compared "none" to "none". With the
# field computed it is a real negative control — an execute escape is not
# clearable by review, so nothing granted here and the field must say so.
is "and that nothing granted it, on a channel review cannot clear" \
   "$(_rf "$r" authority.granted_by)" "none"

# A base nothing can resolve must not read as "nothing changed". An empty list
# and an unanswerable question are different facts, and the whole family of
# defects this exists to prevent is reporting the second as the first.
r2="$(_rcpt deadbeefdeadbeefdeadbeefdeadbeefdeadbeef)"
is "an unresolvable base is not an empty changeset" "$(_rf "$r2" changed.known)" "false"
has "and it says so where a reader must look"       "$(_rf "$r2" unknown)"       "changed"
case "$(_rf "$r2" status)" in
  indeterminate) ok  "a receipt missing an input is indeterminate, never verified" ;;
  *)             bad "a receipt missing an input is indeterminate, never verified" "$(_rf "$r2" status)" ;;
esac

# Same rule for the risk table. "No risk.tsv" once reported green here, which is
# the same bug wearing the other hat.
mv "$FROOT/projects/widget/risk.tsv" "$TMP/risk.tsv.bak"
r3="$(_rcpt)"
is  "an unreadable risk table yields an unknown tier" "$(_rf "$r3" risk.tier)" "unknown"
has "listed where a reader must look"                "$(_rf "$r3" unknown)"   "risk"
case "$(_rf "$r3" status)" in
  verified) bad "and never a verified receipt" "$(_rf "$r3" status)" ;;
  *)        ok  "and never a verified receipt" ;;
esac
mv "$TMP/risk.tsv.bak" "$FROOT/projects/widget/risk.tsv"

# risk.tsv rows carry more than four columns — `channel` and `confine` follow the
# reason — and the readers take the reason as "everything after the pattern", so
# it arrives with the remaining columns glued on behind two tabs. A human report
# gets away with that. A wire contract does not: a consumer reading `reason`
# would get three fields in a trench coat, and the version number promises it
# will not.
rr="$( . "$FROOT/harness/lib/receipt.sh"
       printf 'red\tsome/path\ta plain reason\tverifier\tcount:^x\n' \
         | _felix_rcpt_rows tier path reason )"
has "a finding names its reason"        "$rr" "a plain reason"
case "$rr" in
  *verifier*|*'count:'*) bad "and not the columns that follow it" "$rr" ;;
  *)                     ok  "and not the columns that follow it" ;;
esac
printf '%s' "$rr" | python3 -c 'import json,sys; json.load(sys.stdin)' 2>/dev/null \
  && ok "and the row is still json" || bad "and the row is still json" "$rr"

printf '\nthe bump is the deployment\n'
# `felix install` detected the exact condition, knew exactly what to do, and
# printed instructions: "Bump version in plugin.json, then re-run this." The
# charter calls that a defect in as many words — a command that prints a
# suggestion for something it could safely have done. The gate has now caught
# `installed` NINE times, every one of them a person typing the number the
# command already knew.
#
# Bumping is not a risky act. install already mutates: it is the thing that
# deploys. Refusing to change a patch digit while happily replacing the engine
# is caution in the wrong place.
VB="$TMP/verbump"; mkdir -p "$VB"
printf '{\n  "name": "felix",\n  "version": "0.9.3",\n  "author": {"name": "x"}\n}\n' > "$VB/plugin.json"
( . "$FROOT/harness/lib/resolve.sh"; felix_version_bump "$VB/plugin.json" ) >/dev/null
is "the patch digit goes up by one" \
   "$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$VB/plugin.json")" "0.9.4"
has "and the rest of the file is untouched" "$(cat "$VB/plugin.json")" '"name": "felix"'
has "including fields after it"             "$(cat "$VB/plugin.json")" '"author"'

( . "$FROOT/harness/lib/resolve.sh"; felix_version_bump "$VB/plugin.json" ) >/dev/null
is "and again, so a session can bump twice" \
   "$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$VB/plugin.json")" "0.9.5"

printf '{\n  "version": "1.0"\n}\n' > "$VB/short.json"
( . "$FROOT/harness/lib/resolve.sh"; felix_version_bump "$VB/short.json" ) >/dev/null; rc=$?
is "a version it cannot parse is refused, not guessed" "$rc" "1"
is "and is left exactly as it was" \
   "$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$VB/short.json")" "1.0"

( . "$FROOT/harness/lib/resolve.sh"; felix_version_bump "$VB/nope.json" ) >/dev/null; rc=$?
is "a missing manifest is refused" "$rc" "1"

printf '\nstaged content, not just staged names\n'
# The path list was fixed; the CONTENT readers were not. felix_escapes still
# read added lines from `base...HEAD` and read a file's current state with
# `git show HEAD:`, so on a branch with commits a staged change was named but
# never inspected. Half a fix reads exactly like a whole one from the outside.
SC2="$TMP/stagedcontent"; mkdir -p "$SC2"
( cd "$SC2" && git init -q -b main )
SC2="$(cd "$SC2" && pwd -P)"
printf 'widget\n' > "$SC2/.felix"
mkdir -p "$SC2/projects/thing"
{ printf '# tier\tkind\tpattern\treason\n'
  printf 'red\tpath\t^secrets/\tsecret material\n'
  printf 'red\tpath\t^auth/\tauthorization model\n'
} > "$SC2/projects/thing/risk.tsv"
printf 'notes\n' > "$SC2/a.md"
( cd "$SC2" && git add -A >/dev/null 2>&1 && git -c user.name=t -c user.email=t@t commit -qm base >/dev/null 2>&1 )
SC2_BASE="$(git -C "$SC2" rev-parse HEAD)"
printf 'more\n' >> "$SC2/a.md"
( cd "$SC2" && git add -A >/dev/null 2>&1 && git -c user.name=t -c user.email=t@t commit -qm ahead >/dev/null 2>&1 )

_sc() { ( cd "$SC2" && . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/verify.sh"
          . "$FROOT/harness/lib/review.sh"; . "$FROOT/harness/lib/escape.sh"
          felix_escapes "$FROOT/projects/widget" "$SC2_BASE" "$SC2" "$FROOT" ); }

# Destructive SQL, staged. The path is seen now; the added LINES were not.
printf 'DROP TABLE users;\n' >> "$SC2/a.md"
( cd "$SC2" && git add a.md >/dev/null 2>&1 )
has "staged destructive SQL still escapes as durable" "$(_sc)" "durable"
( cd "$SC2" && git checkout -q -- a.md 2>/dev/null; git reset -q HEAD a.md 2>/dev/null; git checkout -q -- a.md 2>/dev/null )

# A row removed from an enforcing table, staged. The verifier channel compares
# against `git show HEAD:`, which cannot see the index.
sed '/^red.path.\^auth/d' "$SC2/projects/thing/risk.tsv" > "$TMP/rt2" && mv "$TMP/rt2" "$SC2/projects/thing/risk.tsv"
( cd "$SC2" && git add projects >/dev/null 2>&1 )
has "a staged row removal still escapes as verifier" "$(_sc)" "verifier"
( cd "$SC2" && git reset -q HEAD projects 2>/dev/null; git checkout -q -- projects 2>/dev/null )

printf '\none tier for one table\n'
# Two functions read risk.tsv and disagreed about the same path, and the table's
# own header states the answer: "Anything matching no rule is yellow. Green must
# be earned by an explicit pattern, so an unfamiliar file can never auto-merge
# by being unrecognised."
#
# felix_classify_diff obeyed that. felix_incident_severity started at green and
# only ever escalated on a match, so an unrecognised path came back green — and
# that is the function `felix brief` uses, which is the surface the guidebook
# calls "report confidence". Found by running brief on a real issue naming a
# real file and not believing the answer.
RS="$TMP/riskdrift"; mkdir -p "$RS"
{ printf 'red\tpath\t^migrations/\tschema\n'
  printf 'green\tpath\t\\.md$\tdocumentation\n'
} > "$RS/risk.tsv"
_sev() { ( . "$FROOT/harness/lib/classify.sh"; . "$FROOT/harness/lib/incident.sh"
           felix_incident_severity "$RS" "$1" ); }
is "an unrecognised path is yellow, never green" "$(_sev 'src/whatever.py')" "yellow"
is "a path a green rule names is green"          "$(_sev 'README.md')"      "green"
is "a red rule still wins"                       "$(_sev 'migrations/1.sql')" "red"
is "and one unknown path taints a green set"     "$(_sev "$(printf 'README.md\nsrc/x.py')")" "yellow"
is "red beats an unknown too"                    "$(_sev "$(printf 'migrations/1.sql\nsrc/x.py')")" "red"

printf '\none rule for what a thing looks like\n'
# There were two matchers and they drifted. One scored a marketplace blurb, the
# other scored the name alone, nothing said they had to agree, and a plugin got
# installed under a capability the other matcher would not have given it.
CR="$(printf 'llm\tllm prompt eval evaluation\nfrontend\tpage component styling')"
_cm() { ( . "$FROOT/harness/lib/discover.sh"; felix_capability_match "$1" "$2" "$CR" ); }
is "a name counts triple"            "$(_cm evaltool '' | cut -f1)" "3"
is "and prose counts single"         "$(_cm zzz 'about prompt things' | cut -f1)" "1"
is "prose alone can still add up"    "$(_cm zzz 'an llm platform for prompt management and evaluation' | cut -f1)" "4"
is "the best capability wins"        "$(_cm zzz 'page component styling' | cut -f2)" "frontend"
is "and nothing matching scores nil" "$(_cm zzz 'a database migration tool' | cut -f1)" "0"

# The manifest, not the listing. A catalogue blurb is written to be chosen from;
# a manifest is written to describe.
DD="$TMP/desc/.claude-plugin"; mkdir -p "$DD"
printf '{"name":"x","description":"an llm evaluation harness"}\n' > "$DD/plugin.json"
d="$( . "$FROOT/harness/lib/discover.sh"; felix_plugin_description "$TMP/desc" )"
has "reads a plugin's own description" "$d" "llm evaluation harness"
d="$( . "$FROOT/harness/lib/discover.sh"; felix_plugin_description "$TMP/nosuchdir" )"
is "and is silent when there is none" "$d" ""

printf '\nmatching reads what a plugin ships, not what it is called\n'
# Decision C step 2 (2026-08-30). The inspect read already opens the copy on
# disk; its skills list is a manifest fact, and a skill name says what a thing
# SHIPS the way a plugin name says what it IS. Both count triple; a listing's
# prose stays worth one.
DCF="$TMP/dcfunnel"; mkdir -p "$DCF/skills/prompt-eval" "$DCF/skills/db-notes"
facts="$( . "$FROOT/harness/lib/discover.sh"; felix_discover_inspect "$DCF" )"
has "inspect still counts the skills"  "$facts" "skills	2"
has "and now names each one it found"  "$facts" "skill	prompt-eval"
is "naming skills does not change the risk read" \
   "$( . "$FROOT/harness/lib/discover.sh"; felix_discover_risk "$facts" )" "low"

_cm4() { ( . "$FROOT/harness/lib/discover.sh"; felix_capability_match "$1" "$2" "$CR" "$3" ); }
is "a skill name counts triple, like a name"    "$(_cm4 zzz '' 'prompt-eval' | cut -f1)" "6"
is "and picks the capability the skills serve"  "$(_cm4 zzz '' 'prompt-eval' | cut -f2)" "llm"
is "skills matching nothing add nothing"        "$(_cm4 zzz '' 'db-notes' | cut -f1)" "0"
is "name and skills accumulate as evidence"     "$(_cm4 evaltool '' 'prompt-eval' | cut -f1)" "9"
is "prose still counts single beside skills"    "$(_cm4 zzz 'an llm platform' 'db-notes' | cut -f1)" "1"

# The installed-plugin path, which is the one the toolbox report reads. A
# plugin whose name and blurb say nothing is matched by what its directory
# actually ships; one whose skills serve nothing declared stays unmatched.
TBS="$TMP/tbskills"; mkdir -p "$TBS/skills/prompt-eval" "$TBS/.claude-plugin"
printf '{"name":"zzz","description":"assorted utilities"}\n' > "$TBS/.claude-plugin/plugin.json"
cap="$( . "$FROOT/harness/lib/discover.sh"; . "$FROOT/harness/lib/toolbox.sh"
        felix_toolbox_capability zzz "$CR" "$TBS" )"
is "an installed plugin is matched by what it ships" "$cap" "llm"
TBN="$TMP/tbnothing"; mkdir -p "$TBN/skills/db-notes" "$TBN/.claude-plugin"
printf '{"name":"zzz","description":"assorted utilities"}\n' > "$TBN/.claude-plugin/plugin.json"
cap="$( . "$FROOT/harness/lib/discover.sh"; . "$FROOT/harness/lib/toolbox.sh"
        felix_toolbox_capability zzz "$CR" "$TBN" )"
is "and shipping nothing declared still matches nothing" "$cap" ""

printf '\nthe reconciler reads the record: reached beside needed\n'
# Decision C step 3 (2026-08-30). The ledger records which MCP servers were
# reached beside which a play named; stack.tsv records which are declared.
# The reconciler proposes from that record and only that record — it installs
# nothing, removes nothing, and edits nothing.
# The fixture holds every shape the pipeline actually writes. figma is the
# declared-named-never-reached case in both its shapes: the rollup records a
# play-named-unreached entry with kind `named`, and bleed-era data recorded it
# as an mcp zero row — the unmount rule must see both, which is why it reads
# the kind-agnostic summary. ghost is the residue after a person obeys an
# unmount and deletes the row: its named counts are Felix's own routing
# priors, and proposing a mount from them would flip the same rows back and
# forth forever. idle is an undeclared server with no evidence at all — the
# row an unconditional mount branch would trip over.
RCL="$TMP/reconlib"; mkdir -p "$RCL" "$MEM/reconlib"
cat > "$MEM/reconlib/ledger.tsv" <<'EOF'
s1	2026-08-01	mcp	context7	4	0
s2	2026-08-02	mcp	context7	2	0
s1	2026-08-01	named	figma	0	1
s2	2026-08-02	named	figma	0	1
s3	2026-08-03	mcp	figma@x	0	1
s1	2026-08-01	mcp	gh	5	1
s1	2026-08-01	mcp	quiet	0	0
s2	2026-08-02	mcp	quiet	0	0
s3	2026-08-03	mcp	quiet	0	0
s1	2026-08-01	mcp	ghost	0	2
s2	2026-08-02	mcp	ghost	0	2
s3	2026-08-03	mcp	ghost	0	2
s1	2026-08-01	mcp	idle	0	0
s1	2026-08-01	named	wanted	0	2
s1	2026-08-01	mcp	dup	1	0
s1	2026-08-01	mcp	dup@x	2	0
s1	2026-08-01	tool	Bash	9	0
s1	2026-08-01	plugin	superpowers@x	3	1
EOF
m="$( . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/ledger.sh"
      felix_ledger_mcp "$RCL" )"
has "the mcp record aggregates a server across sessions" "$m" "context7	2	6	0"
has "two rows in one session are one session, calls summed" "$m" "dup	1	3	0"
case "$m" in
  *Bash*|*superpowers*|*wanted*) bad "and reads only mcp rows" "$m" ;;
  *)                             ok  "and reads only mcp rows" ;;
esac

{ printf 'mcp\tfigma@x\t-\tmedium\talways\n'
  printf 'mcp\tgh\t-\tmedium\talways\n'
  printf 'mcp\tquiet\t-\tmedium\talways\n'
  printf 'mcp\tdup\t-\tlow\talways\n'
} > "$RCL/stack.tsv"
r="$( . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/ledger.sh"
      . "$FROOT/harness/lib/stack.sh"; FELIX_LEDGER_MIN=3 felix_stack_reconcile "$RCL" )"
has "proposes mounting what was reached and never declared" "$r" "mount	context7"
has "proposes unmounting what was named and never reached, whatever shape recorded it" \
    "$r" "unmount	figma	named 3 time(s) across 3 session(s)"
is  "a reach is the only mount evidence there is" \
    "$(printf '%s\n' "$r" | grep -c '^mount')" "1"
is  "and the unmount above is the only other proposal" \
    "$(printf '%s\n' "$r" | grep -c '^unmount')" "1"
case "$r" in
  *"	gh	"*) bad "never proposes unmounting what was reached" "$r" ;;
  *)          ok  "never proposes unmounting what was reached" ;;
esac
case "$r" in
  *quiet*) bad "a declared server no play ever named is left alone" "$r" ;;
  *)       ok  "a declared server no play ever named is left alone" ;;
esac
case "$r" in
  *ghost*) bad "rows outliving a deleted declaration do not propose a mount" "$r" ;;
  *)       ok  "rows outliving a deleted declaration do not propose a mount" ;;
esac
r="$( . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/ledger.sh"
      . "$FROOT/harness/lib/stack.sh"; FELIX_LEDGER_MIN=5 felix_stack_reconcile "$RCL" )"
is "an unmount below the session threshold is not evidence" \
   "$(printf '%s\n' "$r" | grep -c '^unmount' | tr -d ' ')" "0"
has "while a mount needs no threshold: the reach already happened" "$r" "mount	context7"

# A project that never declared a stack still has a record worth reading.
RNS="$TMP/reconnostack"; mkdir -p "$RNS" "$MEM/reconnostack"
printf 's1\t2026-08-01\tmcp\tcontext7\t4\t0\n' > "$MEM/reconnostack/ledger.tsv"
r="$( . "$FROOT/harness/lib/resolve.sh"; . "$FROOT/harness/lib/ledger.sh"
      . "$FROOT/harness/lib/stack.sh"; felix_stack_reconcile "$RNS" )"
has "no stack.tsv means nothing is declared, not nothing to say" "$r" "mount	context7"

# The CLI surface, driven end to end against a governed fixture. The command
# must render the proposals, act on none of them, and exit 0 — drift reported
# is not a failure.
mkdir -p "$FROOT/projects/reconproj" "$MEM/reconproj"
cat > "$FROOT/projects/reconproj/project.json" <<'EOF'
{"name": "reconproj", "remote_match": "example.com/reconproj", "gate": "true"}
EOF
printf '# reconproj\n' > "$FROOT/projects/reconproj/CLAUDE.md"
cp "$MEM/reconlib/ledger.tsv" "$MEM/reconproj/ledger.tsv"
cp "$RCL/stack.tsv" "$FROOT/projects/reconproj/stack.tsv"
RREPO="$TMP/recon-repo"; mkdir -p "$RREPO"
( cd "$RREPO" && git init -q -b main )
printf 'reconproj\n' > "$RREPO/.felix"
_stack_before="$(cat "$FROOT/projects/reconproj/stack.tsv")"
out="$(cd "$RREPO" && FELIX_LEDGER_MIN=3 "$FELIX" stack reconcile 2>&1)"; rc=$?
is  "felix stack reconcile exits 0"                    "$rc" "0"
has "it renders the mount"                             "$out" "context7"
has "it renders the unmount with its evidence"         "$out" "never reached"
has "and says plainly that it acted on nothing"        "$out" "Proposals only"
is  "stack.tsv is byte-identical after a reconcile" \
    "$(cat "$FROOT/projects/reconproj/stack.tsv")" "$_stack_before"
mv "$FROOT/projects/reconproj/stack.tsv" "$TMP/reconproj-stack-aside"
out="$(cd "$RREPO" && "$FELIX" stack reconcile 2>&1)"; rc=$?
is  "reconcile answers even where no stack.tsv exists" "$rc" "0"
has "and still proposes from the record"               "$out" "context7"
mv "$TMP/reconproj-stack-aside" "$FROOT/projects/reconproj/stack.tsv"

# The session boundary is the only place a mount decision can land, so the
# proposal has to surface there — one line, and the command holds the evidence.
# Once. A proposal shown and left unacted is an answer, and a host-provided
# server nobody should declare would otherwise nag at every session start
# forever, which is how a signal becomes wallpaper.
out="$(cd "$RREPO" && CLAUDE_PLUGIN_ROOT="$FROOT" FELIX_LEDGER_MIN=3 \
       "$FROOT/harness/hooks/session-start" 2>&1)"
has "session start surfaces the reconcile proposals" "$out" "felix stack reconcile"
out="$(cd "$RREPO" && CLAUDE_PLUGIN_ROOT="$FROOT" FELIX_LEDGER_MIN=3 \
       "$FROOT/harness/hooks/session-start" 2>&1)"
has "the second session is still bound" "$out" "Project: reconproj"
case "$out" in
  *"stack reconcile"*) bad "a proposal shown once is not volunteered again" "$out" ;;
  *)                   ok  "a proposal shown once is not volunteered again" ;;
esac
mkdir -p "$FROOT/projects/quietproj" "$MEM/quietproj"
cat > "$FROOT/projects/quietproj/project.json" <<'EOF'
{"name": "quietproj", "remote_match": "example.com/quietproj", "gate": "true"}
EOF
printf '# quietproj\n' > "$FROOT/projects/quietproj/CLAUDE.md"
printf 'mcp\tgh\t-\tmedium\talways\n' > "$FROOT/projects/quietproj/stack.tsv"
printf 's1\t2026-08-01\tmcp\tgh\t5\t1\n' > "$MEM/quietproj/ledger.tsv"
QREPO="$TMP/quiet-repo"; mkdir -p "$QREPO"
( cd "$QREPO" && git init -q -b main )
printf 'quietproj\n' > "$QREPO/.felix"
out="$(cd "$QREPO" && CLAUDE_PLUGIN_ROOT="$FROOT" \
       "$FROOT/harness/hooks/session-start" 2>&1)"
has "the quiet control did bind its project" "$out" "Project: quietproj"
case "$out" in
  *"stack reconcile"*) bad "a consistent record says nothing at session start" "$out" ;;
  *)                   ok  "a consistent record says nothing at session start" ;;
esac

# An empty answer has two honest readings, and only one of them is agreement.
# quietproj holds a record that agrees with its manifest; emptyrec holds no
# record at all, and calling that agreement would be a verdict produced by
# reading nothing.
out="$(cd "$QREPO" && "$FELIX" stack reconcile 2>&1)"
has "a consistent record is called agreement" "$out" "the record and the manifest agree"
mkdir -p "$FROOT/projects/emptyrec"
cat > "$FROOT/projects/emptyrec/project.json" <<'EOF'
{"name": "emptyrec", "remote_match": "example.com/emptyrec", "gate": "true"}

#!/usr/bin/env bash
# Felix harness self-test.
#
# The claim under test is that Felix governs a project it knows nothing about.
# So this suite never touches Elenchus. It builds a throwaway Felix root holding
# a single invented project whose gate is a shell one-liner, in a checkout with
# no git remote, and drives the real CLI and the real hook against it.
#
# If Felix ever grows a hidden assumption about Python, about a remote naming
# scheme, or about Elenchus specifically, these tests are where it surfaces.
#
#   harness/tests/run

set -uo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
REAL_HARNESS="$(cd "$HERE/.." && pwd)"

PASS=0; FAIL=0
ok()   { PASS=$((PASS+1)); printf '  ok    %s\n' "$1"; }
bad()  { FAIL=$((FAIL+1)); printf '  FAIL  %s\n' "$1"; [ -n "${2:-}" ] && printf '        %s\n' "$2"; }
is()   { [ "$2" = "$3" ] && ok "$1" || bad "$1" "expected [$3] got [$2]"; }
has()  { case "$2" in *"$3"*) ok "$1" ;; *) bad "$1" "[$2] lacks [$3]" ;; esac; }

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

# ---------------------------------------------------------------- fixture ----
# A Felix root with the real harness and one invented project.
FROOT="$TMP/felix"
mkdir -p "$FROOT/projects/widget/memory"
cp -R "$REAL_HARNESS" "$FROOT/harness"

cat > "$FROOT/projects/widget/project.json" <<'EOF'
{
  "name": "widget",
  "remote_match": "example.com/widget",
  "gate": "sh -c 'test -f WIDGET.txt && echo widget-gate-ran'"
}
EOF
printf '# widget\n' > "$FROOT/projects/widget/CLAUDE.md"

FELIX="$FROOT/harness/felix"
# Pin the home. Resolution consults ~/.felix-home, so without this the suite
# runs against whatever the machine has installed, writes test projects into it,
# and reports failures about the wrong tree. Observed exactly that.
export FELIX_HOME="$FROOT"

# A checkout with NO git remote, bound by marker file alone.
REPO="$TMP/some-customer-repo"
mkdir -p "$REPO/deep/nested"
( cd "$REPO" && git init -q -b main )
# macOS resolves /var to /private/var, and git reports the resolved path. Compare
# against what the filesystem actually calls this directory, not what mktemp said.
REPO="$(cd "$REPO" && pwd -P)"
printf 'widget\n' > "$REPO/.felix"
printf 'contents\n'  > "$REPO/WIDGET.txt"

printf '\nresolution\n'
out="$(cd "$REPO" && "$FELIX" which 2>&1)"
has "resolves via .felix marker with no remote" "$out" "project:      widget"
has "reports the governed tree"                 "$out" "governs:      $REPO"

out="$(cd "$REPO/deep/nested" && "$FELIX" which 2>&1)"
has "resolves from a nested subdirectory" "$out" "project:      widget"

printf '\ngate execution\n'
out="$(cd "$REPO/deep/nested" && "$FELIX" gate 2>&1)"; rc=$?
is  "passing gate exits 0" "$rc" "0"
has "gate command actually ran" "$out" "widget-gate-ran"

# The gate must run against the checkout it was pointed at, not against Felix.
# A gate that inspects its own directory returns a verdict about the wrong code.
rm "$REPO/WIDGET.txt"
out="$(cd "$REPO" && "$FELIX" gate 2>&1)"; rc=$?
[ "$rc" -ne 0 ] && ok "failing gate propagates non-zero exit" \
                || bad "failing gate propagates non-zero exit" "got 0, a gate that cannot fail is not a gate"
printf 'contents\n' > "$REPO/WIDGET.txt"

printf '\nungoverned directories\n'
PLAIN="$TMP/unrelated"; mkdir -p "$PLAIN"; ( cd "$PLAIN" && git init -q -b main )
out="$(cd "$PLAIN" && "$FELIX" gate 2>&1)"; rc=$?
is  "ungoverned repo refuses to run a gate" "$rc" "2"
has "and says which projects it knows"      "$out" "Known projects:"

printf '\nsession hook\n'
out="$(cd "$REPO" && CLAUDE_PLUGIN_ROOT="$FROOT" "$FROOT/harness/hooks/session-start" 2>&1)"
has "hook binds the invented project" "$out" "Project: widget"
case "$out" in
  *'"hookSpecificOutput"'*) ok "hook emits Claude Code shape as a plugin" ;;
  *) bad "hook emits Claude Code shape as a plugin" "$out" ;;
esac

# Felix also installs as a plain settings.json hook, where CLAUDE_PLUGIN_ROOT is
# unset. Emitting the wrong shape there injects nothing and fails silently.
out="$(cd "$REPO" && env -u CLAUDE_PLUGIN_ROOT "$FROOT/harness/hooks/session-start" 2>&1)"
case "$out" in
  *'"hookSpecificOutput"'*) ok "hook emits Claude Code shape without plugin env" ;;
  *) bad "hook emits Claude Code shape without plugin env" "$out" ;;
esac
out_json="$(printf '%s' "$out" | python3 -c 'import json,sys; print(json.load(sys.stdin)["hookSpecificOutput"]["additionalContext"][:20])' 2>&1)"
has "and that output is valid JSON" "$out_json" "Felix governs"

out="$(cd "$PLAIN" && CLAUDE_PLUGIN_ROOT="$FROOT" "$FROOT/harness/hooks/session-start" 2>&1)"; rc=$?
is "hook silent in ungoverned repo" "${#out}" "0"
is "hook still exits 0 there"       "$rc" "0"

printf '\nonboarding a stranger project\n'
# The claim under test: someone who downloads Felix gets what Elenchus got,
# without hand-writing any of it. A Node app with no git remote, nothing to do
# with anything already here.
STRANGE="$TMP/stranger"
mkdir -p "$STRANGE"
( cd "$STRANGE" && git init -q -b main )
cat > "$STRANGE/package.json" <<'JSON'
{ "name": "stranger", "scripts": { "verify": "echo ok" },
  "dependencies": { "express": "^4", "stripe": "^17" },
  "devDependencies": { "playwright": "^1" } }
JSON

out="$(cd "$STRANGE" && "$FELIX" new stranger 2>&1)"; rc=$?
is  "felix new exits 0"            "$rc" "0"
has "detects from their manifest"  "$out" "billing"
has "guesses their gate"           "$out" "npm run verify"

SP="$FROOT/projects/stranger"
for f in project.json capabilities stack.tsv profiles.tsv setup.tsv CLAUDE.md; do
  [ -f "$SP/$f" ] && ok "seeded $f" || bad "seeded $f"
done
[ -s "$SP/setup/stripe.md" ] && ok "copied the runbook their stack implies" \
                             || bad "copied the runbook their stack implies"
[ -f "$SP/setup/sentry.md" ] && bad "skips runbooks for absent capabilities" \
                             || ok "skips runbooks for absent capabilities"
[ -f "$STRANGE/.felix" ] && ok "binds the checkout with no remote" \
                         || bad "binds the checkout with no remote"

out="$(cd "$STRANGE" && "$FELIX" which 2>&1)"
has "governs them immediately" "$out" "project:      stranger"
out="$(cd "$STRANGE" && "$FELIX" gate 2>&1)"; rc=$?
is "their gate runs and passes" "$rc" "0"

# High risk must stay blocked for a stranger exactly as it does for us.
out="$(cd "$STRANGE" && "$FELIX" stack plan 2>&1)"
case "$out" in
  *"blocked"*"stripe"*) ok "their high-risk rows are blocked too" ;;
  *) bad "their high-risk rows are blocked too" "$out" ;;
esac

out="$("$FELIX" new stranger 2>&1)"; rc=$?
[ "$rc" -ne 0 ] && ok "refuses to clobber an existing project" \
                || bad "refuses to clobber an existing project"

printf '\ncapability detection\n'
# The scenario the founder asked for: a surface that does not exist today, and
# the day it appears Felix notices without anyone remembering to look.
out="$(cd "$REPO" && "$FELIX" doctor 2>&1)"
case "$out" in
  *"undeclared:   none"*) ok "clean project reports no drift" ;;
  *) bad "clean project reports no drift" "$out" ;;
esac

printf 'sentry-sdk>=2.0\n' > "$REPO/requirements.txt"
out="$(cd "$REPO" && "$FELIX" doctor 2>&1)"
has "adding sentry surfaces observability" "$out" "observability"
has "and explains why it now matters"      "$out" "incident loop"

printf 'FROM python:3.12\n' > "$REPO/Dockerfile"
out="$(cd "$REPO" && "$FELIX" doctor 2>&1)"
has "adding a Dockerfile surfaces deploy" "$out" "deploy"

out="$(cd "$REPO" && "$FELIX" doctor 2>&1)"; rc=$?
is "doctor exits 0 despite drift" "$rc" "0"

# Adopting must also pull in what the capability implies. Recording it and
# stopping was the original bug: the checklist looked complete while the tooling
# and human steps stayed invisible.
cp "$REAL_HARNESS/templates/setup.tsv" /dev/null 2>/dev/null || true
before_stack="$(cat "$FROOT/projects/widget/stack.tsv" 2>/dev/null | wc -l)"
before_setup="$(cat "$FROOT/projects/widget/setup.tsv" 2>/dev/null | wc -l)"
out="$(cd "$REPO" && "$FELIX" adopt observability 2>&1)"
has "adopting reports the backfill" "$out" "backfilled"
after_stack="$(cat "$FROOT/projects/widget/stack.tsv" 2>/dev/null | wc -l)"
after_setup="$(cat "$FROOT/projects/widget/setup.tsv" 2>/dev/null | wc -l)"
[ "$after_stack" -gt "$before_stack" ] && ok "backfilled the tooling the capability implies" \
                                       || bad "backfilled the tooling the capability implies" "stack.tsv unchanged"
[ "$after_setup" -gt "$before_setup" ] && ok "backfilled the human steps it implies" \
                                       || bad "backfilled the human steps it implies" "setup.tsv unchanged"
[ -f "$FROOT/projects/widget/setup/sentry.md" ] && ok "copied the runbook it implies" \
                                                || bad "copied the runbook it implies"
out="$(cd "$REPO" && "$FELIX" adopt observability 2>&1)"
has "adopting twice is a no-op" "$out" "already declared"
out="$(cd "$REPO" && "$FELIX" doctor 2>&1)"
case "$out" in
  *"undeclared:   deploy"*) ok "adopting removes it from drift" ;;
  *) bad "adopting removes it from drift" "$out" ;;
esac
rm -f "$REPO/requirements.txt" "$REPO/Dockerfile"

# The assertions below shell out to `claude plugin list` and `claude mcp list`.
# The latter performs live health checks, so they are network-dependent and can
# flake: one spurious failure was observed in a run that passed three times
# either side. Resolution, detection, classification and pipefail safety are all
# offline and deterministic. Only presence checks against real installs are not,
# so a lone failure here is worth re-running before believing.
printf '\nthe hook adopts rather than nags\n'
# A surface detected and left undeclared stays unhandled for as long as nobody
# reads the message. The hook closes that itself.
HOOKREPO="$TMP/hookrepo"; mkdir -p "$HOOKREPO"
( cd "$HOOKREPO" && git init -q -b main )
printf 'hookproj\n' > "$HOOKREPO/.felix"
mkdir -p "$FROOT/projects/hookproj/memory"
printf '{"name":"hookproj","gate":"true"}\n' > "$FROOT/projects/hookproj/project.json"
printf '# h\n' > "$FROOT/projects/hookproj/CLAUDE.md"

out="$(cd "$HOOKREPO" && CLAUDE_PLUGIN_ROOT="$FROOT" "$FROOT/harness/hooks/session-start" 2>&1)"
case "$out" in
  *Adopted*) bad "a bare repo has nothing to adopt" "$out" ;;
  *) ok "a bare repo has nothing to adopt" ;;
esac

printf 'sentry-sdk\n' > "$HOOKREPO/requirements.txt"
out="$(cd "$HOOKREPO" && CLAUDE_PLUGIN_ROOT="$FROOT" "$FROOT/harness/hooks/session-start" 2>&1)"
has "the hook announces what it adopted" "$out" "Adopted automatically"
has "and names the capability"           "$out" "observability"
has "and says nothing was installed"     "$out" "Nothing was installed"

# Talking is not the same as doing. The manifests must actually have changed.
grep -qxF observability "$FROOT/projects/hookproj/capabilities" 2>/dev/null \
  && ok "it recorded the capability" || bad "it recorded the capability"
[ -f "$FROOT/projects/hookproj/setup/sentry.md" ] \
  && ok "it copied the runbook the capability implies" \
  || bad "it copied the runbook the capability implies"
grep -q sentry "$FROOT/projects/hookproj/stack.tsv" 2>/dev/null \
  && ok "it appended the tooling row" || bad "it appended the tooling row"

out="$(cd "$HOOKREPO" && CLAUDE_PLUGIN_ROOT="$FROOT" "$FROOT/harness/hooks/session-start" 2>&1)"
case "$out" in
  *Adopted*) bad "it goes quiet once nothing is new" "$out" ;;
  *) ok "it goes quiet once nothing is new" ;;
esac

printf '\nstack provisioning\n'
# Classification is where the safety policy lives, so that is what is asserted.
# These rows never install anything: the two that would are deliberately fake.
{
  printf 'plugin\tsuperpowers@claude-plugins-official\t-\tlow\talways\n'
  printf 'plugin\tfelix-test-absent@nowhere\t-\tlow\tbilling\n'
  printf 'plugin\tfelix-test-dangerous@nowhere\t-\thigh\talways\n'
} > "$FROOT/projects/widget/stack.tsv"

out="$(cd "$REPO" && "$FELIX" stack plan 2>&1)"
case "$out" in
  *"blocked"*"felix-test-dangerous"*) ok "high risk classifies as blocked" ;;
  *) bad "high risk classifies as blocked" "$out" ;;
esac
case "$out" in
  *"dormant"*"felix-test-absent"*) ok "undeclared capability classifies as dormant" ;;
  *) bad "undeclared capability classifies as dormant" "$out" ;;
esac
has "already-installed rows report present" "$out" "present"

out="$(cd "$REPO" && "$FELIX" stack apply 2>&1)"
has "apply without --yes changes nothing" "$out" "Nothing changed"

# The safety property: no flag promotes a high-risk row into the apply set.
out="$(cd "$REPO" && "$FELIX" stack apply --yes 2>&1)"
case "$out" in
  *"installed  plugin felix-test-dangerous"*)
    bad "--yes never installs high risk" "high-risk row was applied" ;;
  *) ok "--yes never installs high risk" ;;
esac
has "and says why it was left alone" "$out" "No flag installs those"

printf '\nprofiles\n'
printf 'core\talways\nbilling\tbilling\n' > "$FROOT/projects/widget/profiles.tsv"
out="$(cd "$REPO" && "$FELIX" profile core 2>&1)"
has "core profile mounts unconditional rows" "$out" "superpowers"
case "$out" in
  *"felix-test-absent"*) bad "core profile excludes other capabilities" "$out" ;;
  *) ok "core profile excludes other capabilities" ;;
esac

printf '\nhuman setup steps\n'
{
  printf 'always-done\tA step that is already satisfied\talways\ttrue\n'
  printf 'always-todo\tA step nobody has done\talways\tfalse\n'
  printf 'later\tA step for a capability not present yet\tbilling\tfalse\n'
} > "$FROOT/projects/widget/setup.tsv"
mkdir -p "$FROOT/projects/widget/setup"
printf '# Do the thing\n\nStep one.\n' > "$FROOT/projects/widget/setup/always-todo.md"

out="$(cd "$REPO" && "$FELIX" setup 2>&1)"
has "a satisfied step reports done"    "$out" "[x] always-done"
has "an unmet step reports todo"       "$out" "[ ] always-todo"
has "a dormant capability is deferred" "$out" "not needed yet"
case "$out" in
  *"[ ] later"*) bad "dormant steps never nag" "$out" ;;
  *) ok "dormant steps never nag" ;;
esac

out="$(cd "$REPO" && "$FELIX" setup always-todo 2>&1)"
has "a runbook prints in full" "$out" "Step one."

out="$(cd "$REPO" && "$FELIX" setup later 2>&1)"; rc=$?
[ "$rc" -ne 0 ] && ok "a missing runbook fails loudly" \
                || bad "a missing runbook fails loudly" "silently returned 0"

printf '\nrepair loop\n'
# The ceiling is the safety property: past it the answer stops being "retry".
out="$(FELIX_REPAIR_MAX=3 bash -c '
  . '"$FROOT"'/harness/lib/repair.sh
  echo "$FELIX_REPAIR_MAX"')"
is "ceiling defaults to 3" "$out" "3"
out="$(FELIX_REPAIR_MAX=1 bash -c '
  . '"$FROOT"'/harness/lib/repair.sh
  echo "$FELIX_REPAIR_MAX"')"
is "ceiling is overridable" "$out" "1"

# A repo with no GitHub remote must say so rather than guess.
out="$(cd "$PLAIN" && "$FELIX" repair 2>&1)"; rc=$?
[ "$rc" -ne 0 ] && ok "repair refuses outside a governed GitHub repo" \
                || bad "repair refuses outside a governed GitHub repo" "$out"

printf '\nrisk classification\n'
cp "$REAL_HARNESS/templates/risk.tsv" "$FROOT/projects/widget/risk.tsv"
( cd "$REPO" && git add -A >/dev/null 2>&1
  git -c user.name=t -c user.email=t@t commit -qm base >/dev/null 2>&1 )

_classify() { ( cd "$REPO" && "$FELIX" classify --base HEAD~0 2>/dev/null ); }
_stage() { ( cd "$REPO" && git add -A >/dev/null 2>&1 && \
             git -c user.name=t -c user.email=t@t commit -qm c >/dev/null 2>&1 ); }
_reset() { ( cd "$REPO" && git reset -q --hard HEAD~1 >/dev/null 2>&1 ); }

printf 'notes\n' > "$REPO/README.md"; _stage
out="$( cd "$REPO" && "$FELIX" classify --base HEAD~1 2>&1 )"
has "docs classify green" "$out" "tier:  green"
_reset

mkdir -p "$REPO/migrations"; printf 'x\n' > "$REPO/migrations/001.sql"; _stage
out="$( cd "$REPO" && "$FELIX" classify --base HEAD~1 2>&1 )"
has "a migration classifies red" "$out" "tier:  red"
_reset

printf 'notes\n' > "$REPO/README.md"
mkdir -p "$REPO/migrations"; printf 'x\n' > "$REPO/migrations/002.sql"; _stage
out="$( cd "$REPO" && "$FELIX" classify --base HEAD~1 2>&1 )"
has "one red file makes the whole diff red" "$out" "tier:  red"
_reset

printf 'x\n' > "$REPO/unknown_thing.xyz"; _stage
out="$( cd "$REPO" && "$FELIX" classify --base HEAD~1 2>&1 )"
has "an unrecognised file is yellow, never green" "$out" "tier:  yellow"
has "and says why"                                "$out" "no rule matched"
_reset

printf 'api_key = "sk-ant-api03-AAAAAAAAAAAAAAAAAAAAAAAA"\n' > "$REPO/cfg.py"; _stage
out="$( cd "$REPO" && "$FELIX" classify --base HEAD~1 2>&1 )"
has "a credential in added lines classifies red" "$out" "tier:  red"
_reset

printf 'api_key = os.environ["ANTHROPIC_API_KEY"]\n' > "$REPO/cfg2.py"; _stage
out="$( cd "$REPO" && "$FELIX" classify --base HEAD~1 2>&1 )"
case "$out" in
  *"credential appears"*) bad "reading a key from env is not a credential" "$out" ;;
  *) ok "reading a key from env is not a credential" ;;
esac
_reset

printf '\nevidence policy\n'
{
  printf 'unit\t^src/\t^tests?/\tcode changes need a test\n'
  printf 'db\t\\.sql$\t^tests?/.*db\tschema changes need a database test\n'
} > "$FROOT/projects/widget/evidence.tsv"

mkdir -p "$REPO/src"; printf 'x\n' > "$REPO/src/thing.js"; _stage
out="$( cd "$REPO" && "$FELIX" evidence --base HEAD~1 2>&1 )"
has "code with no test is a gap" "$out" "[!] unit"
has "and reads as a requirement"  "$out" "code changes need a test"
( cd "$REPO" && "$FELIX" evidence --base HEAD~1 --strict >/dev/null 2>&1 ); rc=$?
is "--strict exits non-zero on a gap" "$rc" "1"
( cd "$REPO" && "$FELIX" evidence --base HEAD~1 >/dev/null 2>&1 ); rc=$?
is "without --strict it only reports"  "$rc" "0"
_reset

mkdir -p "$REPO/src" "$REPO/tests"
printf 'x\n' > "$REPO/src/thing.js"; printf 'x\n' > "$REPO/tests/thing.test.js"; _stage
out="$( cd "$REPO" && "$FELIX" evidence --base HEAD~1 2>&1 )"
has "a matching test closes the gap" "$out" "[x] unit"
has "untouched surfaces are n/a"     "$out" "[-] db"
_reset

printf 'notes\n' > "$REPO/README.md"; _stage
out="$( cd "$REPO" && "$FELIX" evidence --base HEAD~1 2>&1 )"
has "a docs-only change requires nothing" "$out" "No evidence gaps"
_reset

# Green tier plus an evidence gap. Unreachable with the default rules, since
# green covers docs and tests while evidence fires on src. It becomes reachable
# the moment a project declares any src path green, which is allowed, so the
# branch is exercised here rather than shipped untested.
printf 'green\tpath\t^src/safe/\tdeclared safe by this project\n' \
  >> "$FROOT/projects/widget/risk.tsv"
mkdir -p "$REPO/src/safe"; printf 'x\n' > "$REPO/src/safe/x.js"; _stage
out="$( cd "$REPO" && "$FELIX" classify --base HEAD~1 2>&1 )"
has "green tier is still reported"        "$out" "tier:  green"
has "but auto-merge is withheld on a gap" "$out" "Not auto-merge eligible"
_reset

printf '\nengine and home are separate\n'
# A plugin install is a frozen copy of the whole repository. Treating its
# projects/ as a home would govern from a constitution frozen at install time and
# write memory into a directory the next plugin update deletes, both silently.
FAKE_CACHE="$TMP/.claude/plugins/cache/felix/felix/0.1.0"
mkdir -p "$FAKE_CACHE/projects/stale" "$TMP/plainrepo/projects/live"
out="$( unset FELIX_HOME; HOME="$TMP/nohome"; . "$FROOT/harness/lib/resolve.sh"; felix_home "$FAKE_CACHE" )"
case "$out" in
  *"plugins/cache"*) bad "a plugin cache is never treated as home" "$out" ;;
  *) ok "a plugin cache is never treated as home" ;;
esac
out="$( unset FELIX_HOME; HOME="$TMP/nohome"; . "$FROOT/harness/lib/resolve.sh"; felix_home "$TMP/plainrepo" )"
is "a plain checkout with projects/ is a home" "$out" "$TMP/plainrepo"
out="$( FELIX_HOME="$TMP/explicit"; . "$FROOT/harness/lib/resolve.sh"; felix_home "$TMP/plainrepo" )"
is "an explicit FELIX_HOME wins" "$out" "$TMP/explicit"
mkdir -p "$TMP/pointed"
out="$( unset FELIX_HOME; HOME="$TMP/withpointer"; mkdir -p "$HOME"
        printf '%s\n' "$TMP/pointed" > "$HOME/.felix-home"
        . "$FROOT/harness/lib/resolve.sh"; felix_home "$TMP/plainrepo" )"
is "the pointer file beats a sibling projects/" "$out" "$TMP/pointed"

printf '\nincident loop\n'
mkdir -p "$REPO/src" "$REPO/migrations" "$REPO/docs"
printf 'x\n' > "$REPO/src/thing.js"
printf 'x\n' > "$REPO/migrations/003.sql"
printf 'x\n' > "$REPO/docs/guide.md"
( cd "$REPO" && git add -A >/dev/null 2>&1
  git -c user.name=t -c user.email=t@t commit -qm "incident fixture" >/dev/null 2>&1 )

# A trace never carries repo-relative paths. It carries wherever the process ran.
TRACE_RED='Error: boom
    at handler (/app/migrations/003.sql:12:3)
    at run (/home/runner/work/x/x/src/thing.js:44:9)'
out="$(cd "$REPO" && printf '%s\n' "$TRACE_RED" | "$FELIX" incident 2>&1)"
has "extracts files from container-absolute paths" "$out" "src/thing.js"
has "and from CI-absolute paths"                   "$out" "migrations/003.sql"
has "severity derives from the risk rules"         "$out" "severity:  red"
has "and says not to fix it unattended"            "$out" "SEV1"
has "names the suspect commit"                     "$out" "incident fixture"
has "states that urgency does not bypass gates"    "$out" "Urgency does not bypass"

TRACE_GREEN='Warning raised in /srv/app/docs/guide.md line 3'
out="$(cd "$REPO" && printf '%s\n' "$TRACE_GREEN" | "$FELIX" incident 2>&1)"
has "a docs-only signal is routine" "$out" "severity:  green"

# A brief built from nothing would be believed. Refusing is the correct output.
out="$(cd "$REPO" && printf 'Segfault in /usr/lib/libc.so.6\n' | "$FELIX" incident 2>&1)"
has "refuses to invent a brief from unknown paths" "$out" "No file in this checkout"
case "$out" in
  *"severity:"*) bad "and reports no severity for it" "$out" ;;
  *) ok "and reports no severity for it" ;;
esac

out="$(cd "$REPO" && printf '%s\n' "$TRACE_RED" | "$FELIX" incident 2>&1)"
has "lists what the fix must prove" "$out" "the fix will have to prove"
_reset

printf '\npipefail safety\n'
# Regression. Every presence check used to be `producer | grep -q x`, which under
# `set -o pipefail` reports 141 because grep exits on match and the producer takes
# SIGPIPE. The check then says absent about something present, and it is
# timing-dependent, so small producers pass and a real repository fails.
big="$(seq 1 200000)"
if ( set -uo pipefail; printf '%s' "$big" | grep -q '^199999$' ) 2>/dev/null; then
  bad "the old pipeline pattern is still hazardous" "it passed, so this test proves nothing"
else
  ok "the old pipeline pattern does fail under pipefail (why the helper exists)"
fi
if ( set -uo pipefail
     . "$FROOT/harness/lib/resolve.sh"
     felix_contains "$big" "199999" ); then
  ok "felix_contains survives a large haystack under pipefail"
else
  bad "felix_contains survives a large haystack under pipefail"
fi
if ( set -uo pipefail
     . "$FROOT/harness/lib/resolve.sh"
     felix_has_line "$big" "199999" ) ; then
  ok "felix_has_line matches whole lines under pipefail"
else
  bad "felix_has_line matches whole lines under pipefail"
fi
if ( set -uo pipefail
     . "$FROOT/harness/lib/resolve.sh"
     felix_has_line "alpha
beta" "alph" ); then
  bad "felix_has_line rejects partial lines" "matched a prefix"
else
  ok "felix_has_line rejects partial lines"
fi

printf '\nindependence\n'
# Scoped to code that runs in production. This suite names Elenchus in its own
# comments on purpose, since explaining what it refuses to depend on is the point.
runtime=("$FROOT/harness/felix" "$FROOT/harness/lib" "$FROOT/harness/hooks")
if grep -rniq "elenchus" "${runtime[@]}" 2>/dev/null; then
  bad "runtime harness names no specific project" \
      "$(grep -rni 'elenchus' "${runtime[@]}" | head -3)"
else
  ok "runtime harness names no specific project"
fi

printf '\n%d passed, %d failed\n' "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ] || exit 1
